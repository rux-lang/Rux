// What the filesystem says about a file, and what it will not say. Every claim is checked against something the
// test itself just did -- a file of known length, a directory it made, a timestamp it wrote -- and the fields
// the running system cannot answer are checked to be reported as unanswerable rather than quietly zero.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Slice };
import Io::{ IoError, IoErrorKind, WriteAll, Writer };
import Path::{ OsString, Path };
import Storage::{ CapabilitiesOfSystem, DeleteDirectory, DeleteFile, File, FileKind, MakeDirectory, Metadata,
                  MetadataOf, OpenOptions, Permissions, SetPermissions, SetTimes };
import Text::TextError;
import Time::Timestamp;

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: string) -> Slice<char8> {
    return Slice<char8> { data: text.data, length: text.length };
}

func PathOf(allocator: Allocator, text: string, holder: *var OsString) -> Path {
    var textError = TextError::None;
    *holder = OsString::FromText(allocator, text, @textError);
    Assert(textError == TextError::None, "the name converts");
    return Path::FromView((*holder).View());
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    var error = IoError::Ok();
    let able = CapabilitiesOfSystem();

    var dirHolder = OsString(allocator);
    let dir = PathOf(allocator, "Bin/StorageMeta.tmp", @dirHolder);
    var fileHolder = OsString(allocator);
    let file = PathOf(allocator, "Bin/StorageMeta.tmp/f.txt", @fileHolder);

    DeleteFile(allocator, file);
    DeleteDirectory(allocator, dir);
    Assert(MakeDirectory(allocator, dir).IsOk(), "the scratch directory is made");

    // A file of known length reports that length and calls itself a file.
    var written = File::Open(allocator, file, OpenOptions::Writing(), @error);
    Assert(written.IsOpen() && error.IsOk(), "the file opens for writing");
    var sink: Writer = written.Stream();
    Assert(WriteAll(sink, TextBytes("0123456789")).IsOk(), "ten bytes are written");
    let openMetadata = written.Metadata(@error);
    Assert(error.IsOk(), "the open handle describes itself");
    Assert(openMetadata.kind == FileKind::File, "as a file");
    Assert(openMetadata.size == 10u64, "of the length just written");
    Assert(written.Close().IsOk(), "and closes");

    // The same answers through the path.
    let byPath = MetadataOf(allocator, file, true, @error);
    Assert(error.IsOk(), "the path describes the same file");
    Assert(byPath.kind == FileKind::File && byPath.size == 10u64, "identically");
    Assert(byPath.linkCount >= 1u64, "with at least the one name it was made under");

    // A directory is a directory, and asking about a name that is not there is NotFound.
    let dirMetadata = MetadataOf(allocator, dir, true, @error);
    Assert(error.IsOk() && dirMetadata.kind == FileKind::Directory, "a directory reports as one");
    var missingHolder = OsString(allocator);
    let missing = PathOf(allocator, "Bin/StorageMeta.tmp/nothing.txt", @missingHolder);
    MetadataOf(allocator, missing, true, @error);
    Assert(error.kind == IoErrorKind::NotFound, "and a missing name is NotFound");

    // Creation time is present exactly where the system claims it is.
    Assert(byPath.hasCreated == able.creationTime, "creation time is reported present exactly when it is real");

    // Timestamps written are timestamps read back. A whole second is used because filesystems differ in the
    // fraction they keep, and the second is what every one of them stores.
    let moment = Timestamp::FromUnixSeconds(1000000000);
    Assert(SetTimes(allocator, file, moment, moment, true).IsOk(), "the times are set");
    let retimed = MetadataOf(allocator, file, true, @error);
    Assert(error.IsOk(), "the file describes itself again");
    Assert(retimed.modified.UnixSeconds() == 1000000000i64, "the modification time is the one written");
    Assert(retimed.accessed.UnixSeconds() == 1000000000i64, "and so is the access time");

    // Read-only is the one permission every supported system records: setting and clearing it round trips. An
    // ordinary writer is refused, while a privileged Unix process may validly bypass the mode bits.
    Assert(SetPermissions(allocator, file, Permissions::FromReadOnly(true)).IsOk(), "read-only is set");
    let locked = MetadataOf(allocator, file, true, @error);
    Assert(error.IsOk() && !locked.permissions.IsWritable(), "and reads back without owner-write permission");
    var probe = File::Open(allocator, file, OpenOptions::Writing(), @error);
    if probe.IsOpen() {
        Assert(able.unixPermissions && error.IsOk(), "only a privileged Unix writer may bypass read-only");
        Assert(probe.Close().IsOk(), "and the privileged probe closes");
    }
    else {
        Assert(error.kind == IoErrorKind::PermissionDenied, "an ordinary write is PermissionDenied");
    }

    Assert(SetPermissions(allocator, file, Permissions::FromReadOnly(false)).IsOk(), "read-only is cleared");
    let unlocked = MetadataOf(allocator, file, true, @error);
    Assert(error.IsOk() && unlocked.permissions.IsWritable(), "and reads back as writable");
    var allowed = File::Open(allocator, file, OpenOptions::Writing(), @error);
    Assert(allowed.IsOpen() && error.IsOk(), "and the write is allowed again");
    Assert(allowed.Close().IsOk(), "and closes");

    if able.unixPermissions {
        // Where the mode is the system's own, an exact triple survives the round trip.
        Assert(SetPermissions(allocator, file, Permissions::FromMode(0x1A4u32)).IsOk(), "an exact mode is set");
        let moded = MetadataOf(allocator, file, true, @error);
        Assert(error.IsOk() && moded.permissions.mode == 0x1A4u32, "and reads back bit for bit");
    }
    else {
        // Where it is not, the mode is synthesized and says so by being one of exactly two values.
        Assert(unlocked.permissions.mode == 0x1B6u32, "a synthesized writable mode is the documented one");
        Assert(locked.permissions.mode == 0x124u32, "and a synthesized read-only mode is the other");
    }

    Assert(DeleteFile(allocator, file).IsOk(), "the file cleans up");
    Assert(DeleteDirectory(allocator, dir).IsOk(), "and so does the directory");

    return 0;
}
