// A directory is made, filled, read back name for name -- a non-ASCII name included, held losslessly in the
// system's own units -- refused deletion while full, and deleted once empty.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Slice };
import Io::{ IoError, IoErrorKind };
import Path::{ OsString, OsStringView, Path };
import Storage::{ DeleteDirectory, DeleteFile, DirectoryIterator, File, MakeDirectory, OpenOptions, ReadDirectory };
import Text::TextError;

func PathOf(allocator: Allocator, text: Slice<char8>, holder: *var OsString) -> Path {
    var textError = TextError::None;
    *holder = OsString::FromText(allocator, text, @textError);
    Assert(textError == TextError::None, "the name converts");
    return Path::FromView(holder.View());
}

func Touch(allocator: Allocator, path: Path) {
    var error = IoError::Ok();
    var made = File::Open(allocator, path, OpenOptions::Writing(), @error);
    Assert(made.IsOpen() && error.IsOk(), "a file is made");
    Assert(made.Close().IsOk(), "and closed");
}

func NameOf(allocator: Allocator, text: Slice<char8>, holder: *var OsString) -> OsStringView {
    var textError = TextError::None;
    *holder = OsString::FromText(allocator, text, @textError);
    Assert(textError == TextError::None, "the expected name converts");
    return holder.View();
}

func Main() -> int {
    var system = SystemAllocator::New();
    let allocator: Allocator = system;
    var error = IoError::Ok();

    var dirHolder = OsString::New(allocator);
    let dir = PathOf(allocator, "Bin/StorageDir.tmp", @dirHolder);
    var oneHolder = OsString::New(allocator);
    let one = PathOf(allocator, "Bin/StorageDir.tmp/one.txt", @oneHolder);
    var twoHolder = OsString::New(allocator);
    let two = PathOf(allocator, "Bin/StorageDir.tmp/two.txt", @twoHolder);
    var accentHolder = OsString::New(allocator);
    let accent = PathOf(allocator, "Bin/StorageDir.tmp/caf\u{00E9}.txt", @accentHolder);

    // Fresh ground: an earlier run may have left the tree behind, and cleanup is not the thing under test yet.
    DeleteFile(allocator, one);
    DeleteFile(allocator, two);
    DeleteFile(allocator, accent);
    DeleteDirectory(allocator, dir);

    // Made once; a second claim on the name is refused with the reason named.
    Assert(MakeDirectory(allocator, dir).IsOk(), "the directory is made");
    Assert(MakeDirectory(allocator, dir).kind == IoErrorKind::AlreadyExists, "a second make is AlreadyExists");

    Touch(allocator, one);
    Touch(allocator, two);
    Touch(allocator, accent);

    // Read back: three names, each one expected, the accent intact in the system's own units.
    var iterator = ReadDirectory(allocator, dir, @error);
    Assert(error.IsOk(), "the directory opens for reading");
    var oneWantHolder = OsString::New(allocator);
    let oneWant = NameOf(allocator, "one.txt", @oneWantHolder);
    var twoWantHolder = OsString::New(allocator);
    let twoWant = NameOf(allocator, "two.txt", @twoWantHolder);
    var accentWantHolder = OsString::New(allocator);
    let accentWant = NameOf(allocator, "caf\u{00E9}.txt", @accentWantHolder);
    var seenOne = false;
    var seenTwo = false;
    var seenAccent = false;
    var count: uint = 0;
    var entry = OsString::New(allocator);
    while iterator.Next(@entry, @error) {
        count = count + 1;
        let view = entry.View();
        if view.Equals(@oneWant) {
            seenOne = true;
        }
        else if view.Equals(@twoWant) {
            seenTwo = true;
        }
        else if view.Equals(@accentWant) {
            seenAccent = true;
        }
        entry.Clear();
    }
    Assert(error.IsOk(), "the enumeration ends rather than fails");
    Assert(count == 3, "three entries, dot entries skipped");
    Assert(seenOne && seenTwo && seenAccent, "every written name reads back, the accent losslessly");
    iterator.Release();

    // Deletion respects fullness: refused while anything is inside, clean once nothing is.
    Assert(DeleteDirectory(allocator, dir).IsError(), "a full directory refuses deletion");
    Assert(DeleteFile(allocator, one).IsOk(), "the first file deletes");
    Assert(DeleteFile(allocator, two).IsOk(), "the second file deletes");
    Assert(DeleteFile(allocator, accent).IsOk(), "the accented file deletes");
    Assert(DeleteFile(allocator, one).kind == IoErrorKind::NotFound, "deleting it again is NotFound");

    var emptied = ReadDirectory(allocator, dir, @error);
    Assert(error.IsOk(), "the emptied directory still opens");
    var nothing = OsString::New(allocator);
    Assert(!emptied.Next(@nothing, @error) && error.IsOk(), "and holds nothing");
    emptied.Release();
    nothing.Clear();

    Assert(DeleteDirectory(allocator, dir).IsOk(), "the empty directory deletes");
    var gone = ReadDirectory(allocator, dir, @error);
    Assert(error.kind == IoErrorKind::NotFound, "and reading it afterward is NotFound");
    gone.Release();

    return 0;
}
