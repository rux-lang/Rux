import Core::{ #target, OperatingSystem };

when #target.os == OperatingSystem::Windows {
    import Windows::{ CLEARTYPE_QUALITY, CLIP_DEFAULT_PRECIS, CreateFontW, CreateWindowExW, DEFAULT_CHARSET,
                      DEFAULT_PITCH, DefWindowProcW, DeleteObject, DestroyWindow, FW_NORMAL, GetDpiForWindow,
                      GetModuleHandleW, HWND_MESSAGE, IDC_ARROW, LoadCursorW, OUT_DEFAULT_PRECIS, RegisterClassExW,
                      SendMessageW, UnregisterClassW, WM_CREATE, WM_DESTROY, WM_USER, WindowClassEx };

    // A window is the one Win32 object whose code the system calls back, so the test is mostly about that call: the
    // procedure is an ordinary Rux function, and every message that reaches it proves the convention and the four
    // arguments arrive as the system sent them. The window is message-only, so nothing is ever shown on screen.

    const ClassName = c16"RuxWindowTest";
    const FaceName = c16"Segoe UI";

    // What the procedure saw, kept where the test can read it after each call.
    var Created: uint32 = 0;
    var Destroyed: uint32 = 0;
    var LastWParam: uint = 0;
    var LastLParam: int = 0;

    func Procedure(window: *var opaque, message: uint32, wParam: uint, lParam: int) -> int {
        if message == WM_CREATE {
            Created += 1;
            return 0;
        }
        if message == WM_DESTROY {
            Destroyed += 1;
            return 0;
        }
        if message == WM_USER + 1 {
            LastWParam = wParam;
            LastLParam = lParam;
            return 0x5EED;
        }
        // Safety: the arguments are exactly the ones the system passed for `window`, which is live during the call.
        return unsafe { DefWindowProcW(window, message, wParam, lParam) };
    }

    func Main() -> int {
        // Safety: a null name asks for this executable's own module handle and reads no memory.
        let instance = unsafe { GetModuleHandleW(null) };
        if instance == null {
            return 1;
        }

        let windowClass = WindowClassEx {
            size: sizeof(WindowClassEx) as uint32,
            style: 0,
            windowProcedure: Procedure,
            classExtra: 0,
            windowExtra: 0,
            instance,
            icon: null,
            // Safety: a null instance with a predefined cursor identifier in place of a name is the documented form.
            cursor: unsafe { LoadCursorW(null, IDC_ARROW as *char16) },
            background: null,
            menuName: null,
            className: ClassName.data,
            smallIcon: null
        };
        if windowClass.cursor == null {
            return 2;
        }
        // Safety: `windowClass` is a local, fully initialized, sized structure whose name is a NUL-terminated constant.
        if unsafe { RegisterClassExW(@windowClass) } == 0 {
            return 3;
        }

        // WM_CREATE arrives before CreateWindowExW returns.
        // Safety: the class is registered above under the NUL-terminated `ClassName`, and every optional pointer is
        // null.
        let window = unsafe {
            CreateWindowExW(0, ClassName.data, null, 0, 0, 0, 0, 0, HWND_MESSAGE as *var opaque, null, instance, null)
        };
        if window == null {
            return 4;
        }
        if Created != 1 {
            return 5;
        }

        // A sent message on the owning thread is a direct call, so its answer and both parameters come straight back;
        // the parameters are chosen so a swapped or truncated argument cannot pass.
        // Safety: `window` is the live window created above, and this private message carries no pointers.
        let answer = unsafe { SendMessageW(window, WM_USER + 1, 0xFFFFFFFF00000001, -2) };
        if answer != 0x5EED {
            return 6;
        }
        if LastWParam != 0xFFFFFFFF00000001 || LastLParam != -2 {
            return 7;
        }

        // Without DPI awareness a window reports 96, and in no case zero.
        // Safety: `window` is the live window created above.
        if unsafe { GetDpiForWindow(window) } == 0 {
            return 8;
        }

        // Safety: the face name is a NUL-terminated UTF-16 constant, and every other argument is a plain number.
        let font = unsafe {
            CreateFontW(-12, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                        CLEARTYPE_QUALITY, DEFAULT_PITCH, FaceName.data)
        };
        if font == null {
            return 9;
        }
        // Safety: `font` is the live font created above, selected into no device context, and not used again.
        if unsafe { DeleteObject(font) } == 0 {
            return 10;
        }

        // Destroying sends WM_DESTROY, and only then may the class go.
        // Safety: `window` is the live window created above on this thread, and not used again.
        if unsafe { DestroyWindow(window) } == 0 {
            return 11;
        }
        if Destroyed != 1 {
            return 12;
        }
        // Safety: `ClassName` is NUL-terminated, and its only window was destroyed above.
        if unsafe { UnregisterClassW(ClassName.data, instance) } == 0 {
            return 13;
        }
        // A second registration of the same name succeeds again once it is gone.
        // Safety: `windowClass` is still the local, sized structure registered before, and the class has no windows.
        if unsafe { RegisterClassExW(@windowClass) == 0 || UnregisterClassW(ClassName.data, instance) == 0 } {
            return 14;
        }
        return 0;
    }
} else {
    func Main() -> int {
        return 0;
    }
}
