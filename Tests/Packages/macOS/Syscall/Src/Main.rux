import Core::{ #target, OperatingSystem };

when #target.os == OperatingSystem::macOS {
    import macOS::{ AtFdCwd, ClockGetResolution, ClockMonotonic, Close, EACCES, EAGAIN, EBADF, EBUSY, EEXIST, EFAULT,
                    EINTR, EINVAL, EIO, EISDIR, ELOOP, EMFILE, ENAMETOOLONG, ENOENT, ENOMEM, ENOSPC, ENOSYS, ENOTDIR,
                    ENXIO, EOVERFLOW, EPERM, EPIPE, EROFS, ESPIPE, ESRCH, ETIMEDOUT, EXDEV, Errno, FstatAt, GetPid,
                    GetRandom, GetTimeOfDay, IsError, MapAnonymous, MapPrivate, Mmap, Munmap, Nanosleep, Normalize,
                    OpenAt, OpenReadOnly, ProtectionRead, ProtectionWrite, Read, Timespec, Timeval, Write };

    // Every call here goes through libSystem, which is the only interface Apple supports. The previous version of
    // this test drove the trap instruction directly with a call number, which is exactly what a Darwin binary must
    // not do — the numbers are private and the interface is not reachable from ordinary code on Apple Silicon.

    func Main() -> int {
        if GetPid() <= 0 {
            return 1;
        }

        // A failing call reports through errno, which Normalize folds into the negative form IsError reads.
        // Safety: a zero count reads nothing into the null buffer.
        let readError = unsafe { Read(-1, null as *var opaque, 0) };
        if !IsError(readError) || Errno(readError) == 0 {
            return 2;
        }

        // Safety: a zero count writes nothing from the null buffer.
        let writeError = unsafe { Write(-1, null, 0) };
        if !IsError(writeError) || Errno(writeError) == 0 {
            return 3;
        }

        // Opening a path that does not exist reports ENOENT rather than returning a descriptor.
        // Safety: the path is a NUL-terminated string literal.
        let missing = unsafe { OpenAt(AtFdCwd, "/no-such-file-8f2c1e".data, OpenReadOnly, 0) };
        if !IsError(missing) || Errno(missing) == 0 {
            return 4;
        }

        // A successful call must not be mistaken for a failure by the same fold. The record is passed by address,
        // which is what every clock wrapper on all three POSIX systems takes since task 38.
        var time = Timeval { seconds: 0, microseconds: 0 };
        // Safety: `time` is a local `Timeval`, the record the call fills.
        if unsafe { GetTimeOfDay(@time) } != 0 || time.seconds <= 0 ||
            time.microseconds < 0 || time.microseconds >= 1000000 {
            return 5;
        }
        let copiedTime = time;
        if copiedTime.seconds != time.seconds || copiedTime.microseconds != time.microseconds {
            return 6;
        }

        const PageSize: uint = 4096;
        // Safety: a null address lets the kernel place the mapping, and an anonymous one reads no descriptor.
        let mapping = unsafe {
            Mmap(null, PageSize, ProtectionRead | ProtectionWrite, MapPrivate | MapAnonymous, -1, 0)
        };
        if IsError(mapping) {
            return 7;
        }

        // Safety: `mapping` is the live read-write page checked above, so its first byte may be written and read.
        let stored = unsafe {
            let bytes = mapping as *var char8;
            *bytes = 42 as char8;
            *bytes
        };
        if stored != 42 as char8 {
            return 8;
        }

        // Safety: `mapping` is the page mapped above, and nothing uses it after this.
        if unsafe { Munmap(mapping as *opaque, PageSize) } != 0 {
            return 9;
        }

        // The entropy source cannot fail and has no count to check, so what is checked is that it wrote something.
        var seed: uint64[4] = [0; 4];
        // Safety: `seed` is a local array of exactly 32 bytes.
        unsafe { GetRandom(@seed[0] as *var opaque, 32); }
        if seed[0] == 0 && seed[1] == 0 && seed[2] == 0 && seed[3] == 0 {
            return 10;
        }

        // Normalize leaves a value alone and only folds the failure sentinel.
        if Normalize(7) != 7 || Normalize(0) != 0 {
            return 11;
        }

        if Close(-1) == 0 {
            return 12;
        }

        // --- The shared POSIX contract ------------------------------------------------------------------------
        // Everything below is spelled identically in the Linux, macOS and FreeBSD copies of this test. That is
        // the contract task 38 aligned: one wrapper name, one parameter shape, one call site. The numbers differ
        // per system and are asserted per system, which is the part that must not be shared.

        // A clock resolution is a positive granularity, and is read through the same address-passing shape as the
        // clock itself.
        var resolution: Timespec;
        // Safety: `resolution` is a local `Timespec`, the record the call fills.
        if unsafe { ClockGetResolution(ClockMonotonic, @resolution) } != 0 {
            return 20;
        }
        if resolution.seconds < 0 || resolution.nanoseconds < 0 ||
            (resolution.seconds == 0 && resolution.nanoseconds == 0) {
            return 21;
        }

        // Nanosleep takes both records by address on every system. A hundred microseconds is long enough to be a
        // real wait and short enough not to slow the suite.
        var request = Timespec { seconds: 0, nanoseconds: 100000 };
        var remaining = Timespec { seconds: 0, nanoseconds: 0 };
        // Safety: `request` and `remaining` are local `Timespec` records.
        if unsafe { Nanosleep(@request, @remaining) } != 0 {
            return 22;
        }

        // A nanosecond count of a second or more is what every one of the three refuses, with EINVAL.
        var invalid = Timespec { seconds: 0, nanoseconds: 1000000000 };
        // Safety: `invalid` is a local `Timespec`, and the remainder may be null.
        let refused = unsafe { Nanosleep(@invalid, null) };
        if !IsError(refused) || Errno(refused) != EINVAL {
            return 23;
        }

        // FstatAt is one name on all three systems now; Linux spelled it NewFstatAt until task 38.
        var status: char8[256];
        // Safety: the path is a NUL-terminated literal, and the 256-byte local `status` holds a whole `stat` record.
        if unsafe { FstatAt(AtFdCwd, "/".data, @status[0] as *var opaque, 0) } != 0 {
            return 24;
        }
        // Safety: the path is a NUL-terminated literal, and the 256-byte local `status` holds a whole `stat` record.
        let absent = unsafe { FstatAt(AtFdCwd, "/no-such-file-8f2c1e".data, @status[0] as *var opaque, 0) };
        if !IsError(absent) || Errno(absent) != ENOENT {
            return 25;
        }

        // The errno names shared by all three are declared by all three. The numbers are this system's own and are
        // checked here, because a name that agrees while its value quietly does not is the hazard alignment
        // introduces.
        if EPERM != 1 || ENOENT != 2 || ESRCH != 3 || EINTR != 4 || EIO != 5 || ENXIO != 6 || EBADF != 9 {
            return 26;
        }
        if ENOMEM != 12 || EACCES != 13 || EFAULT != 14 || EBUSY != 16 || EEXIST != 17 || EXDEV != 18 {
            return 27;
        }
        if ENOTDIR != 20 || EISDIR != 21 || EINVAL != 22 || EMFILE != 24 || ENOSPC != 28 || ESPIPE != 29 {
            return 28;
        }
        if EROFS != 30 || EPIPE != 32 {
            return 29;
        }
        if EAGAIN != 35 || ELOOP != 62 || ENAMETOOLONG != 63 {
            return 30;
        }
        if ENOSYS != 78 || EOVERFLOW != 84 || ETIMEDOUT != 60 {
            return 31;
        }

        return 0;
    }
} else {
    func Main() -> int {
        return 0;
    }
}
