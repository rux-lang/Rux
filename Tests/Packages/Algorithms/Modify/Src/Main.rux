import Core::Slice;
import Algorithms::{ CopyTo, Fill, MoveTo, Partition, PartitionPoint, RemoveValue, RemoveWhere, Reverse, Rotate,
                     SequenceEqual, Swap, Unique };
import Core::{ Assert, MutableSlice };

// Rearranging in place. Two things run through all of it: nothing resizes anything, and a removal reports how many
// elements are left rather than shortening the storage it does not own. What lies past that count is unspecified, so
// nothing here asserts anything about it -- which is itself the point worth making.

func View(data: *var int32, length: uint) -> MutableSlice<int32> {
    return MutableSlice<int32> { data: data, length: length };
}

func Read(data: *int32, length: uint) -> Slice<int32> {
    return Slice<int32> { data: data, length: length };
}

func Same(left: *int32, right: *int32, length: uint) -> bool {
    return SequenceEqual<int32>(Read(left, length), Read(right, length));
}

func IsEven(value: int32) -> bool {
    return value % 2 == 0;
}

func Always(value: int32) -> bool {
    return true;
}

func IsBelowThirty(value: int32) -> bool {
    return value < 30;
}

func Never(value: int32) -> bool {
    return false;
}

func Main() -> int {
    // Swap exchanges two locations, and a location with itself is left alone.
    var pair: int32[2];
    pair[0] = 1;
    pair[1] = 2;
    Swap<int32>(@pair[0], @pair[1]);
    Assert(pair[0] == 2 && pair[1] == 1, "swapping exchanges both values");
    Swap<int32>(@pair[0], @pair[0]);
    Assert(pair[0] == 2, "and swapping a location with itself leaves it alone");

    // Reverse, including the two lengths that are already reversed.
    var five: int32[5];
    var index: uint = 0;
    while index < 5 {
        five[index] = (index + 1) as int32;
        index++;
    }
    Reverse<int32>(View(@five[0], 5));
    Assert(five[0] == 5 && five[4] == 1, "an odd length reverses end for end");
    Assert(five[2] == 3, "leaving the middle where it was");
    Reverse<int32>(View(@five[0], 5));
    Assert(five[0] == 1 && five[4] == 5, "and reversing twice restores the original");

    var four: int32[4];
    index = 0;
    while index < 4 {
        four[index] = (index + 1) as int32;
        index++;
    }
    Reverse<int32>(View(@four[0], 4));
    Assert(four[0] == 4 && four[1] == 3 && four[2] == 2 && four[3] == 1, "an even length reverses with no middle");
    Reverse<int32>(View(@four[0], 0));
    Reverse<int32>(View(@four[0], 1));
    Assert(four[0] == 4, "reversing nothing, or one element, changes nothing");

    // Rotate brings the element at the given index to the front.
    var six: int32[6];
    index = 0;
    while index < 6 {
        six[index] = (index + 1) as int32;
        index++;
    }
    Assert(Rotate<int32>(View(@six[0], 6), 2), "rotating within the length succeeds");
    Assert(six[0] == 3 && six[1] == 4 && six[2] == 5, "the element at the middle comes to the front");
    Assert(six[3] == 6 && six[4] == 1 && six[5] == 2, "and the front follows the back");
    Assert(Rotate<int32>(View(@six[0], 6), 4), "rotating back by the complement succeeds");
    Assert(six[0] == 1 && six[5] == 6, "and restores the original order");
    Assert(Rotate<int32>(View(@six[0], 6), 0), "rotating by zero is allowed");
    Assert(six[0] == 1, "and changes nothing");
    Assert(Rotate<int32>(View(@six[0], 6), 6), "rotating by the whole length is allowed");
    Assert(six[0] == 1, "and also changes nothing");
    Assert(!Rotate<int32>(View(@six[0], 6), 7), "and rotating past the length is refused");
    Assert(six[0] == 1 && six[5] == 6, "leaving the sequence untouched");

    // Fill writes every position, and an empty view writes none.
    var filled: int32[4];
    Fill<int32>(View(@filled[0], 4), 9);
    Assert(filled[0] == 9 && filled[3] == 9, "fill writes every position");
    Fill<int32>(View(@filled[0], 2), 1);
    Assert(filled[0] == 1 && filled[1] == 1, "a partial view writes only its own");
    Assert(filled[2] == 9 && filled[3] == 9, "and leaves the rest alone");
    Fill<int32>(View(null, 0), 7);

    // Copy between separate storage, and the refusal that writes nothing.
    var source: int32[4];
    index = 0;
    while index < 4 {
        source[index] = (index + 10) as int32;
        index++;
    }
    var target: int32[4];
    Fill<int32>(View(@target[0], 4), 0);
    Assert(CopyTo<int32>(View(@target[0], 4), Read(@source[0], 4)), "a copy of matching lengths succeeds");
    Assert(Same(@target[0], @source[0], 4), "and reproduces the source");
    Assert(!CopyTo<int32>(View(@target[0], 3), Read(@source[0], 4)), "mismatched lengths are refused");
    Assert(Same(@target[0], @source[0], 4), "having written nothing");
    Assert(CopyTo<int32>(View(null, 0), Read(null, 0)), "copying nothing succeeds");

    // Move handles overlap in both directions, which is what shifting a run along its own storage needs.
    var shifted: int32[6];
    index = 0;
    while index < 6 {
        shifted[index] = (index + 1) as int32;
        index++;
    }
    Assert(MoveTo<int32>(View(@shifted[2], 4), Read(@shifted[0], 4)), "shifting a run forward succeeds");
    Assert(shifted[2] == 1 && shifted[3] == 2 && shifted[4] == 3 && shifted[5] == 4, "and carries every element");
    Assert(shifted[0] == 1 && shifted[1] == 2, "leaving the source region as the overlap left it");

    index = 0;
    while index < 6 {
        shifted[index] = (index + 1) as int32;
        index++;
    }
    Assert(MoveTo<int32>(View(@shifted[0], 4), Read(@shifted[2], 4)), "shifting a run backward succeeds");
    Assert(shifted[0] == 3 && shifted[1] == 4 && shifted[2] == 5 && shifted[3] == 6, "and carries every element");
    Assert(!MoveTo<int32>(View(@shifted[0], 3), Read(@shifted[2], 4)), "mismatched lengths are refused");

    // Unique collapses adjacent runs only, which is what makes it the second half of sort-then-unique.
    var runs: int32[8];
    runs[0] = 1;
    runs[1] = 1;
    runs[2] = 2;
    runs[3] = 2;
    runs[4] = 2;
    runs[5] = 3;
    runs[6] = 1;
    runs[7] = 1;
    let kept = Unique<int32>(View(@runs[0], 8));
    Assert(kept == 4, "each run collapses to one");
    Assert(runs[0] == 1 && runs[1] == 2 && runs[2] == 3 && runs[3] == 1,
           "and a value that returns after a gap is kept, because only adjacent duplicates go");

    var distinct: int32[3];
    distinct[0] = 5;
    distinct[1] = 6;
    distinct[2] = 7;
    Assert(Unique<int32>(View(@distinct[0], 3)) == 3, "a slice with no duplicates keeps everything");
    Assert(Unique<int32>(View(@distinct[0], 1)) == 1, "one element has nothing adjacent to it");
    Assert(Unique<int32>(View(null, 0)) == 0, "and nothing collapses to nothing");

    // Removal compacts survivors and keeps their order.
    var mixed: int32[8];
    index = 0;
    while index < 8 {
        mixed[index] = (index + 1) as int32;
        index++;
    }
    Assert(RemoveWhere<int32>(View(@mixed[0], 8), IsEven) == 4, "removing the accepted leaves the rest");
    Assert(mixed[0] == 1 && mixed[1] == 3 && mixed[2] == 5 && mixed[3] == 7, "in their original order");

    index = 0;
    while index < 8 {
        mixed[index] = (index + 1) as int32;
        index++;
    }
    Assert(RemoveWhere<int32>(View(@mixed[0], 8), Never) == 8, "a predicate that accepts nothing removes nothing");
    Assert(RemoveWhere<int32>(View(@mixed[0], 8), Always) == 0, "and one that accepts everything removes everything");

    var repeated: int32[6];
    repeated[0] = 4;
    repeated[1] = 1;
    repeated[2] = 4;
    repeated[3] = 2;
    repeated[4] = 4;
    repeated[5] = 3;
    Assert(RemoveValue<int32>(View(@repeated[0], 6), 4) == 3, "removing a value removes every occurrence");
    Assert(repeated[0] == 1 && repeated[1] == 2 && repeated[2] == 3, "keeping the survivors in order");
    Assert(RemoveValue<int32>(View(@repeated[0], 3), 9) == 3, "removing an absent value removes nothing");
    Assert(RemoveValue<int32>(View(null, 0), 4) == 0, "and removing from nothing leaves nothing");

    // Partition moves the accepted to the front, and PartitionPoint finds where they end.
    var split: int32[8];
    index = 0;
    while index < 8 {
        split[index] = (index + 1) as int32;
        index++;
    }
    let boundary = Partition<int32>(View(@split[0], 8), IsEven);
    Assert(boundary == 4, "the accepted elements are counted");
    index = 0;
    while index < boundary {
        Assert(IsEven(split[index]), "everything before the boundary is accepted");
        index++;
    }
    while index < 8 {
        Assert(!IsEven(split[index]), "and everything from it on is not");
        index++;
    }
    Assert(PartitionPoint<int32>(Read(@split[0], 8), IsEven) == boundary,
           "and the partition point agrees with where partitioning left the boundary");

    Assert(Partition<int32>(View(@split[0], 8), Always) == 8, "a predicate accepting everything partitions at the end");
    Assert(Partition<int32>(View(@split[0], 8), Never) == 0, "and one accepting nothing at the front");
    Assert(Partition<int32>(View(null, 0), IsEven) == 0, "an empty slice partitions at zero");
    Assert(PartitionPoint<int32>(Read(null, 0), IsEven) == 0, "and its partition point is there too");

    // A sorted slice is partitioned with respect to any threshold, which is the other thing PartitionPoint is for.
    var sorted: int32[6];
    index = 0;
    while index < 6 {
        sorted[index] = (index * 10) as int32;
        index++;
    }
    Assert(PartitionPoint<int32>(Read(@sorted[0], 6), IsBelowThirty) == 3, "a threshold splits a sorted slice");

    return 0;
}
