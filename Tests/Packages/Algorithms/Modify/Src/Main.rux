import Algorithms::{ Swap, Reverse, Rotate, Fill, Copy, CopyBackward, Unique, RemoveValue };
import Core::MutableSlice;

// A key carrying its original position, so a reordering can be checked for
// having moved elements rather than overwritten them.
struct Record {
    key: int32;
    origin: int32;
}

extend Record {
    func ==(self, other: Record) -> bool {
        return self.key == other.key && self.origin == other.origin;
    }
}

func Main() -> int {
    // Swap exchanges two values, and tolerates a null on either side so an
    // optional endpoint needs no guard at the call site.
    var left = 1;
    var right = 2;
    Swap<int>(@left, @right);
    if left != 2 || right != 1 { return 10; }
    Swap<int>(@left, null);
    Swap<int>(null, @right);
    if left != 2 || right != 1 { return 11; }
    Swap<int>(@left, @left);
    if left != 2 { return 12; }

    // Reverse is a no-op below two elements and is its own inverse.
    var single: int32[1] = [7];
    Reverse<int32>(@single[0], 1);
    if single[0] != 7 { return 20; }
    Reverse<int32>(@single[0], 0);
    if single[0] != 7 { return 21; }

    var even: int32[4] = [1, 2, 3, 4];
    Reverse<int32>(@even[0], 4);
    if even[0] != 4 || even[1] != 3 || even[2] != 2 || even[3] != 1 { return 22; }
    Reverse<int32>(@even[0], 4);
    if even[0] != 1 || even[3] != 4 { return 23; }

    var odd: int32[5] = [1, 2, 3, 4, 5];
    Reverse<int32>(@odd[0], 5);
    if odd[0] != 5 || odd[2] != 3 || odd[4] != 1 { return 24; }

    // Rotate accepts every position through length, rejects anything past it,
    // and treats both endpoints as no-ops.
    var turn: int32[5] = [1, 2, 3, 4, 5];
    if !Rotate<int32>(@turn[0], 5, 2) { return 30; }
    if turn[0] != 3 || turn[1] != 4 || turn[2] != 5 || turn[3] != 1 || turn[4] != 2 { return 31; }
    // Rotating back by the complement restores the original order.
    if !Rotate<int32>(@turn[0], 5, 3) { return 32; }
    if turn[0] != 1 || turn[4] != 5 { return 33; }
    if !Rotate<int32>(@turn[0], 5, 0) { return 34; }
    if turn[0] != 1 { return 35; }
    if !Rotate<int32>(@turn[0], 5, 5) { return 36; }
    if turn[0] != 1 { return 37; }
    if Rotate<int32>(@turn[0], 5, 6) { return 38; }
    if turn[0] != 1 || turn[4] != 5 { return 39; }

    // Fill writes every element, and a zero length writes none.
    var canvas: int32[4] = [1, 2, 3, 4];
    Fill<int32>(@canvas[0], 3, 9);
    if canvas[0] != 9 || canvas[2] != 9 || canvas[3] != 4 { return 40; }
    Fill<int32>(@canvas[0], 0, 5);
    if canvas[0] != 9 { return 41; }

    // Copy moves elements forward and reports whether it ran; copying nothing
    // always succeeds, while a null with a real length fails.
    var source: int32[4] = [1, 2, 3, 4];
    var target: int32[4] = [0, 0, 0, 0];
    if !Copy<int32>(@target[0], @source[0], 4) { return 50; }
    if target[0] != 1 || target[3] != 4 { return 51; }
    if !Copy<int32>(@target[0], @source[0], 0) { return 52; }
    if Copy<int32>(null, @source[0], 1) { return 53; }
    if Copy<int32>(@target[0], null, 1) { return 54; }

    // CopyBackward produces the same result for disjoint ranges.
    var mirror: int32[4] = [0, 0, 0, 0];
    if !CopyBackward<int32>(@mirror[0], @source[0], 4) { return 55; }
    if mirror[0] != 1 || mirror[3] != 4 { return 56; }

    // Overlapping ranges: Copy is correct when the destination is at or below
    // the source, which shifts the tail left.
    var shift: int32[5] = [1, 2, 3, 4, 5];
    if !Copy<int32>(@shift[0], @shift[1], 4) { return 57; }
    if shift[0] != 2 || shift[1] != 3 || shift[2] != 4 || shift[3] != 5 { return 58; }

    // CopyBackward is correct in the other direction, shifting the head right.
    var slide: int32[5] = [1, 2, 3, 4, 5];
    if !CopyBackward<int32>(@slide[1], @slide[0], 4) { return 59; }
    if slide[0] != 1 || slide[1] != 1 || slide[2] != 2 || slide[4] != 4 { return 60; }

    // Unique collapses adjacent runs only, and reports the surviving length.
    var runs: int32[8] = [1, 1, 2, 2, 2, 3, 1, 1];
    if Unique<int32>(@runs[0], 8) != 4 { return 70; }
    if runs[0] != 1 || runs[1] != 2 || runs[2] != 3 || runs[3] != 1 { return 71; }

    var allEqual: int32[4] = [5, 5, 5, 5];
    if Unique<int32>(@allEqual[0], 4) != 1 { return 72; }
    if allEqual[0] != 5 { return 73; }

    var distinct: int32[3] = [1, 2, 3];
    if Unique<int32>(@distinct[0], 3) != 3 { return 74; }
    if distinct[2] != 3 { return 75; }

    var tiny: int32[1] = [4];
    if Unique<int32>(@tiny[0], 0) != 0 { return 76; }
    if Unique<int32>(@tiny[0], 1) != 1 { return 77; }

    // RemoveValue compacts survivors toward the front, preserving their order.
    var mixed: int32[6] = [1, 9, 2, 9, 3, 9];
    if RemoveValue<int32>(@mixed[0], 6, 9) != 3 { return 80; }
    if mixed[0] != 1 || mixed[1] != 2 || mixed[2] != 3 { return 81; }

    var none: int32[3] = [1, 2, 3];
    if RemoveValue<int32>(@none[0], 3, 4) != 3 { return 82; }
    if none[0] != 1 || none[2] != 3 { return 83; }

    var every: int32[3] = [7, 7, 7];
    if RemoveValue<int32>(@every[0], 3, 7) != 0 { return 84; }
    if RemoveValue<int32>(@every[0], 0, 7) != 0 { return 85; }

    // The same operations over a multi-word struct, which is where pointer
    // offsetting has to scale by the element size.
    var records: Record[4] = [Record { key: 1, origin: 0 },
                              Record { key: 2, origin: 1 },
                              Record { key: 3, origin: 2 },
                              Record { key: 4, origin: 3 }];
    Reverse<Record>(@records[0], 4);
    if records[0].key != 4 || records[0].origin != 3 { return 90; }
    if records[3].key != 1 || records[3].origin != 0 { return 91; }

    if !Rotate<Record>(@records[0], 4, 1) { return 92; }
    if records[0].key != 3 || records[3].key != 4 { return 93; }

    let filler = Record { key: 0, origin: 9 };
    Fill<Record>(@records[0], 2, filler);
    if records[0].key != 0 || records[0].origin != 9 { return 94; }
    if records[1].origin != 9 || records[2].key != 1 { return 95; }

    var duplicates: Record[4] = [Record { key: 1, origin: 0 },
                                 Record { key: 1, origin: 0 },
                                 Record { key: 2, origin: 1 },
                                 Record { key: 2, origin: 1 }];
    if Unique<Record>(@duplicates[0], 4) != 2 { return 96; }
    if duplicates[0].key != 1 || duplicates[1].key != 2 { return 97; }

    // A Core view hands its storage to the algorithms through data and length.
    var owned: int32[4] = [4, 3, 2, 1];
    let view = MutableSlice::From<int32>(@owned[0], 4);
    Reverse<int32>(view.data, view.length);
    if view.At(0) != 1 || view.At(3) != 4 { return 100; }

    // A sub-view rearranges only the elements it covers.
    let middle = view.Sub(1, 2);
    Reverse<int32>(middle.data, middle.length);
    if owned[0] != 1 || owned[1] != 3 || owned[2] != 2 || owned[3] != 4 { return 101; }

    return 0;
}
