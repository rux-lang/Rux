import Algorithms::{ ExclusiveScan, InclusiveScan, Iota, Midpoint, PartialSum, SequenceEqual };
import Core::Assert;

// Running totals, written beside the input or over it; scans with any combining function; counting sequences; and
// midpoints that stay in range however far apart their ends are.

func Multiply(left: int32, right: int32) -> int32 {
    return left * right;
}

func Larger(left: int32, right: int32) -> int32 {
    return left > right ? left : right;
}

func Main() -> int {
    let items: int32[5] = [1, 2, 3, 4, 5];
    var sums: int32[5] = [0; 5];
    Assert(PartialSum<int32>(items[..], sums[..]), "the destination is long enough");
    let expectedSums: int32[5] = [1, 3, 6, 10, 15];
    Assert(SequenceEqual<int32>(sums[..], expectedSums[..]), "running sums");

    var inPlace: int32[5] = [1, 2, 3, 4, 5];
    Assert(PartialSum<int32>(inPlace[..], inPlace[..]) && SequenceEqual<int32>(inPlace[..], expectedSums[..]),
           "a scan in place");
    var short: int32[3] = [7, 7, 7];
    Assert(!PartialSum<int32>(items[..], short[..]) && short[0] == 7, "a short destination is refused untouched");
    let empty: int32[0] = [];
    Assert(PartialSum<int32>(empty[..], short[..]), "an empty input writes nothing");

    var products: int32[5] = [0; 5];
    Assert(InclusiveScan<int32>(items[..], products[..], Multiply), "inclusive scan");
    let expectedProducts: int32[5] = [1, 2, 6, 24, 120];
    Assert(SequenceEqual<int32>(products[..], expectedProducts[..]), "running products");

    let bumpy: int32[5] = [3, 1, 4, 1, 5];
    var maxima: int32[5] = [0; 5];
    Assert(InclusiveScan<int32>(bumpy[..], maxima[..], Larger), "running maximum");
    let expectedMaxima: int32[5] = [3, 3, 4, 4, 5];
    Assert(SequenceEqual<int32>(maxima[..], expectedMaxima[..]), "running maxima");

    var before: int32[5] = [0; 5];
    Assert(ExclusiveScan<int32>(items[..], before[..], 100, Larger), "exclusive scan");
    let expectedBefore: int32[5] = [100, 100, 100, 100, 100];
    Assert(SequenceEqual<int32>(before[..], expectedBefore[..]), "the initial value leads");
    var exclusiveInPlace: int32[5] = [1, 2, 3, 4, 5];
    Assert(ExclusiveScan<int32>(exclusiveInPlace[..], exclusiveInPlace[..], 1, Multiply), "exclusive in place");
    let expectedExclusive: int32[5] = [1, 1, 2, 6, 24];
    Assert(SequenceEqual<int32>(exclusiveInPlace[..], expectedExclusive[..]), "exclusive products");

    var counted: int32[4] = [0; 4];
    Iota<int32>(counted[..], 10, 5);
    let expectedCounted: int32[4] = [10, 15, 20, 25];
    Assert(SequenceEqual<int32>(counted[..], expectedCounted[..]), "a counting sequence");
    var edge: uint8[2] = [0u8; 2];
    Iota<uint8>(edge[..], 254u8, 1u8);
    Assert(edge[0] == 254u8 && edge[1] == 255u8, "the step after the last value is never taken");

    Assert(Midpoint(2i64, 8i64) == 5i64 && Midpoint(8i64, 3i64) == 6i64 && Midpoint(3i64, 8i64) == 5i64,
           "integer midpoints round toward the first");
    Assert(Midpoint(-9223372036854775807i64 - 1i64, 9223372036854775807i64) == -1i64, "the full int64 range");
    Assert(Midpoint(2147483647i32, 2147483645i32) == 2147483646i32 && Midpoint(-7i32, 7i32) == 0i32, "int32");
    Assert(Midpoint(18446744073709551615u64, 18446744073709551613u64) == 18446744073709551614u64, "uint64");
    Assert(Midpoint(0u32, 4294967295u32) == 2147483647u32, "uint32");
    Assert(Midpoint(1.0, 2.0) == 1.5 && Midpoint(1.7e308, 1.7e308) == 1.7e308, "float midpoints do not overflow");
    return 0;
}
