import Algorithms::{ IsSorted, IsSortedUntil, LowerBound, UpperBound, TryBinarySearch, EqualRange, Count };

// Ordered by key alone, so several distinct records compare equivalent and the
// bounds have a run to delimit. Deliberately defines `<` and not `==`, which
// is what the Search module is documented to require.
struct Ranked {
    key: int32;
    origin: int32;
}

extend Ranked {
    func <(self: *Ranked, other: Ranked) -> bool {
        return self.key < other.key;
    }
}

// Checks every bound invariant at one probe value at once: the expected
// endpoints, that EqualRange agrees with the two bounds, that the width of the
// range equals the number of matching elements, and that TryBinarySearch
// succeeds exactly when the range is non-empty and then reports its start.
func CheckBounds(data: *int32, length: uint, value: int32, wantLower: uint, wantUpper: uint, code: int) -> int {
    if LowerBound<int32>(data, length, value) != wantLower {
        return code;
    }
    if UpperBound<int32>(data, length, value) != wantUpper {
        return code + 1;
    }

    let bounds = EqualRange<int32>(data, length, value);
    if bounds.start != wantLower || bounds.end != wantUpper {
        return code + 2;
    }
    if bounds.start > bounds.end {
        return code + 3;
    }
    if bounds.end - bounds.start != Count<int32>(data, length, value) {
        return code + 4;
    }

    var index: uint = 12345;
    let found = TryBinarySearch<int32>(data, length, value, @index);
    if found != (wantLower != wantUpper) {
        return code + 5;
    }
    if found {
        if index != wantLower {
            return code + 6;
        }
    }
    else {
        if index != 12345 {
            return code + 7;
        }
    }
    return 0;
}

func Main() -> int {
    var code = 0;
    var index: uint = 0;

    // IsSorted accepts the empty and single-element cases, and equal adjacent
    // elements are non-decreasing rather than a break.
    var one: int32[1] = [5];
    var equal: int32[3] = [7, 7, 7];
    var rising: int32[4] = [1, 2, 3, 4];
    var falling: int32[4] = [4, 3, 2, 1];

    if !IsSorted<int32>(@one[0], 0) { return 10; }
    if !IsSorted<int32>(@one[0], 1) { return 11; }
    if !IsSorted<int32>(@equal[0], 3) { return 12; }
    if !IsSorted<int32>(@rising[0], 4) { return 13; }
    if IsSorted<int32>(@falling[0], 4) { return 14; }

    // IsSortedUntil returns length when sorted, so the empty and
    // single-element cases report 0 and 1 rather than a sentinel.
    if IsSortedUntil<int32>(@one[0], 0) != 0 { return 20; }
    if IsSortedUntil<int32>(@one[0], 1) != 1 { return 21; }
    if IsSortedUntil<int32>(@equal[0], 3) != 3 { return 22; }
    if IsSortedUntil<int32>(@rising[0], 4) != 4 { return 23; }

    // The break index is exact wherever it falls.
    var breakFirst: int32[4] = [9, 1, 2, 3];
    var breakMiddle: int32[4] = [1, 2, 0, 3];
    var breakLast: int32[4] = [1, 2, 3, 0];
    if IsSortedUntil<int32>(@breakFirst[0], 4) != 1 { return 24; }
    if IsSortedUntil<int32>(@breakMiddle[0], 4) != 2 { return 25; }
    if IsSortedUntil<int32>(@breakLast[0], 4) != 3 { return 26; }

    // Bounds on an empty sequence collapse to 0, and nothing is found.
    code = CheckBounds(null, 0, 5, 0, 0, 30);
    if code != 0 { return code; }

    // A single element: below it, on it, above it.
    code = CheckBounds(@one[0], 1, 4, 0, 0, 40);
    if code != 0 { return code; }
    code = CheckBounds(@one[0], 1, 5, 0, 1, 50);
    if code != 0 { return code; }
    code = CheckBounds(@one[0], 1, 6, 1, 1, 60);
    if code != 0 { return code; }

    // An all-equal sequence: the matching range spans the whole thing.
    code = CheckBounds(@equal[0], 3, 7, 0, 3, 70);
    if code != 0 { return code; }
    code = CheckBounds(@equal[0], 3, 6, 0, 0, 80);
    if code != 0 { return code; }
    code = CheckBounds(@equal[0], 3, 8, 3, 3, 90);
    if code != 0 { return code; }

    // A sorted sequence with a run of duplicates, probed at every insertion
    // position: before the first element, on each distinct value, in each gap,
    // and past the last element.
    var values: int32[6] = [10, 20, 20, 20, 40, 50];
    code = CheckBounds(@values[0], 6, 5, 0, 0, 100);
    if code != 0 { return code; }
    code = CheckBounds(@values[0], 6, 10, 0, 1, 110);
    if code != 0 { return code; }
    code = CheckBounds(@values[0], 6, 15, 1, 1, 120);
    if code != 0 { return code; }
    code = CheckBounds(@values[0], 6, 20, 1, 4, 130);
    if code != 0 { return code; }
    code = CheckBounds(@values[0], 6, 30, 4, 4, 140);
    if code != 0 { return code; }
    code = CheckBounds(@values[0], 6, 40, 4, 5, 150);
    if code != 0 { return code; }
    code = CheckBounds(@values[0], 6, 45, 5, 5, 160);
    if code != 0 { return code; }
    code = CheckBounds(@values[0], 6, 50, 5, 6, 170);
    if code != 0 { return code; }
    code = CheckBounds(@values[0], 6, 60, 6, 6, 180);
    if code != 0 { return code; }

    // A null index reports failure instead of searching.
    if TryBinarySearch<int32>(@values[0], 6, 20, null) { return 190; }

    // A long sequence exercises the halving loop and the overflow-safe
    // midpoint, and every element must be found at its own index.
    var many: int32[1000];
    var i: uint = 0;
    while i < 1000 {
        many[i] = (i as int32) * 2;
        i++;
    }
    if !IsSorted<int32>(@many[0], 1000) { return 200; }
    if IsSortedUntil<int32>(@many[0], 1000) != 1000 { return 201; }

    i = 0;
    while i < 1000 {
        if !TryBinarySearch<int32>(@many[0], 1000, (i as int32) * 2, @index) { return 202; }
        if index != i { return 203; }
        // The odd values in between are absent, and their bounds meet at the
        // position where they would be inserted.
        if TryBinarySearch<int32>(@many[0], 1000, (i as int32) * 2 + 1, @index) { return 204; }
        if LowerBound<int32>(@many[0], 1000, (i as int32) * 2 + 1) != i + 1 { return 205; }
        i++;
    }

    // Unsigned elements, including the type's limits.
    var unsigned: uint32[4] = [0u32, 1u32, 4294967294u32, 4294967295u32];
    if !IsSorted<uint32>(@unsigned[0], 4) { return 210; }
    if LowerBound<uint32>(@unsigned[0], 4, 0u32) != 0 { return 211; }
    if UpperBound<uint32>(@unsigned[0], 4, 4294967295u32) != 4 { return 212; }
    if !TryBinarySearch<uint32>(@unsigned[0], 4, 4294967294u32, @index) { return 213; }
    if index != 2 { return 214; }

    // Signed elements at their limits.
    var signed: int32[3] = [-2147483648i32, 0i32, 2147483647i32];
    if !IsSorted<int32>(@signed[0], 3) { return 220; }
    if LowerBound<int32>(@signed[0], 3, -2147483648i32) != 0 { return 221; }
    if UpperBound<int32>(@signed[0], 3, 2147483647i32) != 3 { return 222; }

    // A user struct ordered by key alone. Equivalent-but-distinct records form
    // a run, and the bounds must delimit the whole run while the search
    // reports its first index.
    var ranked: Ranked[5] = [Ranked { key: 1, origin: 0 },
                             Ranked { key: 3, origin: 1 },
                             Ranked { key: 3, origin: 2 },
                             Ranked { key: 3, origin: 3 },
                             Ranked { key: 8, origin: 4 }];
    let three = Ranked { key: 3, origin: 99 };
    let five = Ranked { key: 5, origin: 99 };

    if !IsSorted<Ranked>(@ranked[0], 5) { return 230; }
    if LowerBound<Ranked>(@ranked[0], 5, three) != 1 { return 231; }
    if UpperBound<Ranked>(@ranked[0], 5, three) != 4 { return 232; }

    let span = EqualRange<Ranked>(@ranked[0], 5, three);
    if span.start != 1 || span.end != 4 { return 233; }

    // The record found is the first of the run, identified by its origin even
    // though the probe's origin differs.
    if !TryBinarySearch<Ranked>(@ranked[0], 5, three, @index) { return 234; }
    if index != 1 { return 235; }
    if ranked[index].origin != 1 { return 236; }

    // A key falling between two runs is absent, and its bounds meet.
    if TryBinarySearch<Ranked>(@ranked[0], 5, five, @index) { return 237; }
    let gap = EqualRange<Ranked>(@ranked[0], 5, five);
    if gap.start != 4 || gap.end != 4 { return 238; }

    return 0;
}
