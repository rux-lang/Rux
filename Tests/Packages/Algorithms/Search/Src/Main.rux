import Algorithms::{ BinarySearch, BinarySearchBy, EqualRange, EqualRangeBy, IsSorted, IsSortedBy, IsSortedUntil,
                     IsSortedUntilBy, LowerBound, LowerBoundBy, UpperBound, UpperBoundBy };
import Core::{ Assert, Ordering };

// The ordered searches. A binary search is easy to write in a way that works on the cases anyone thinks to try and
// fails on the ones nobody does, so what is checked here is the boundaries: a value before everything, after
// everything, absent between two present ones, present once, present many times, and every one of those against an
// empty slice and a one-element slice.
//
// The bounds are checked against a linear count of the equal elements, so the two answers have to agree rather than
// merely look plausible.

// Ordered by key alone, so equivalent-but-distinct elements exist and which one a search finds is observable.
struct Ranked {
    key: int32;
    origin: int32;
}

extend Ranked {
    func <(self: &Ranked, other: Ranked) -> bool {
        return self.key < other.key;
    }
}

func ByKey(left: Ranked, right: Ranked) -> Ordering {
    if left.key < right.key {
        return Ordering::Less;
    }
    if right.key < left.key {
        return Ordering::Greater;
    }
    return Ordering::Equal;
}

func LessInt32(left: int32, right: int32) -> Ordering {
    if left < right {
        return Ordering::Less;
    }
    if right < left {
        return Ordering::Greater;
    }
    return Ordering::Equal;
}

func Ints(data: *int32, length: uint) -> Slice<int32> {
    return Slice<int32> { data: data, length: length };
}

// A linear count, so the bounds have something independent to agree with.
func CountEqual(items: Slice<int32>, value: int32) -> uint {
    var found: uint = 0;
    var index: uint = 0;
    while index < items.length {
        if items.data[index] == value {
            found = found + 1;
        }
        index++;
    }
    return found;
}

// Every claim the bounds make about one value, checked together and against the linear count.
func CheckBounds(items: Slice<int32>, value: int32, wantLower: uint, wantUpper: uint) {
    Assert(LowerBound<int32>(items, value) == wantLower, "the lower bound is where the value starts");
    Assert(UpperBound<int32>(items, value) == wantUpper, "the upper bound is where it ends");
    let span = EqualRange<int32>(items, value);
    Assert(span.start == wantLower && span.end == wantUpper, "the equal range is both bounds at once");
    Assert(span.end - span.start == CountEqual(items, value), "and spans exactly the equal elements");
    Assert(LowerBoundBy<int32>(items, value, LessInt32) == wantLower, "a comparator agrees on the lower bound");
    Assert(UpperBoundBy<int32>(items, value, LessInt32) == wantUpper, "and on the upper");
    let byRange = EqualRangeBy<int32>(items, value, LessInt32);
    Assert(byRange.start == wantLower && byRange.end == wantUpper, "and on the range between them");

    var at: uint = 0;
    if wantLower == wantUpper {
        Assert(BinarySearch<int32>(items, value).IsNone(), "an empty range means the value is absent");
        Assert(BinarySearchBy<int32>(items, value, LessInt32).IsNone(), "under a comparator too");
    }
    else {
        Assert(BinarySearch<int32>(items, value).TryIntoValue(@at), "a non-empty range means the value is present");
        Assert(at == wantLower, "and the first of the equal elements is the one reported");
        Assert(BinarySearchBy<int32>(items, value, LessInt32).TryIntoValue(@at) && at == wantLower,
               "which a comparator agrees with");
    }
}

func Main() -> int {
    // Sortedness, including the two lengths that are sorted for want of a pair to be out of order.
    var run: int32[5];
    run[0] = 1;
    run[1] = 3;
    run[2] = 3;
    run[3] = 7;
    run[4] = 9;
    Assert(IsSorted<int32>(Ints(@run[0], 5)), "a sorted slice is sorted");
    Assert(IsSorted<int32>(Ints(@run[0], 1)), "and so is one element");
    Assert(IsSorted<int32>(Ints(null, 0)), "and so is nothing at all");
    Assert(IsSortedUntil<int32>(Ints(@run[0], 5)) == 5, "a sorted slice runs to its end");
    Assert(IsSortedUntil<int32>(Ints(null, 0)) == 0, "an empty one gets nowhere");
    Assert(IsSortedUntil<int32>(Ints(@run[0], 1)) == 1, "and one element runs to its end");

    var broken: int32[4];
    broken[0] = 1;
    broken[1] = 2;
    broken[2] = 0;
    broken[3] = 3;
    Assert(!IsSorted<int32>(Ints(@broken[0], 4)), "a slice with a break is not sorted");
    Assert(IsSortedUntil<int32>(Ints(@broken[0], 4)) == 2, "and the break is where it stops");
    Assert(IsSortedBy<int32>(Ints(@run[0], 5), LessInt32), "a comparator agrees about a sorted slice");
    Assert(!IsSortedBy<int32>(Ints(@broken[0], 4), LessInt32), "and about a broken one");
    Assert(IsSortedUntilBy<int32>(Ints(@broken[0], 4), LessInt32) == 2, "and about where it breaks");

    // The bounds, over a slice with a value present three times and gaps either side of it.
    var values: int32[6];
    values[0] = 10;
    values[1] = 20;
    values[2] = 20;
    values[3] = 20;
    values[4] = 40;
    values[5] = 50;
    let items = Ints(@values[0], 6);
    Assert(IsSorted<int32>(items), "the searched slice really is sorted");

    CheckBounds(items, 5, 0, 0);
    CheckBounds(items, 10, 0, 1);
    CheckBounds(items, 15, 1, 1);
    CheckBounds(items, 20, 1, 4);
    CheckBounds(items, 30, 4, 4);
    CheckBounds(items, 40, 4, 5);
    CheckBounds(items, 50, 5, 6);
    CheckBounds(items, 60, 6, 6);

    // The degenerate slices answer for every value rather than refusing.
    let empty = Ints(null, 0);
    CheckBounds(empty, 20, 0, 0);
    var one: int32[1];
    one[0] = 7;
    let single = Ints(@one[0], 1);
    CheckBounds(single, 3, 0, 0);
    CheckBounds(single, 7, 0, 1);
    CheckBounds(single, 9, 1, 1);

    // A comparator searches a type with no ordering the search could have used, and finds the first of the equals.
    var ranked: Ranked[5];
    ranked[0] = Ranked { key: 1, origin: 100 };
    ranked[1] = Ranked { key: 2, origin: 101 };
    ranked[2] = Ranked { key: 2, origin: 102 };
    ranked[3] = Ranked { key: 4, origin: 103 };
    ranked[4] = Ranked { key: 5, origin: 104 };
    let records = Slice<Ranked> { data: @ranked[0], length: 5 };
    let probe = Ranked { key: 2, origin: 999 };

    Assert(IsSortedBy<Ranked>(records, ByKey), "the record slice is sorted by the comparator");
    Assert(LowerBoundBy<Ranked>(records, probe, ByKey) == 1, "the lower bound of an equivalent key");
    Assert(UpperBoundBy<Ranked>(records, probe, ByKey) == 3, "and its upper bound");
    var at: uint = 0;
    Assert(BinarySearchBy<Ranked>(records, probe, ByKey).TryIntoValue(@at), "an equivalent key is found");
    Assert(at == 1, "as the first of the equals");
    Assert(ranked[at].origin == 101, "which is the element the sequence puts first, not whichever was landed on");

    let missing = Ranked { key: 3, origin: 0 };
    Assert(BinarySearchBy<Ranked>(records, missing, ByKey).IsNone(), "a key nothing matches is not found");
    let gap = EqualRangeBy<Ranked>(records, missing, ByKey);
    Assert(gap.start == 3 && gap.end == 3, "and its range is empty where it would be inserted");

    // Equality here is the ordering's rather than the type's: these records differ in a field it never reads.
    Assert(BinarySearch<Ranked>(records, probe).TryIntoValue(@at) && at == 1,
           "the type's own ordering finds it in the same place");

    // A large sorted slice, so the search really divides rather than scanning.
    var many: int32[64];
    var index: uint = 0;
    while index < 64 {
        many[index] = (index * 2) as int32;
        index++;
    }
    let wide = Ints(@many[0], 64);
    Assert(IsSorted<int32>(wide), "the large slice is sorted");
    index = 0;
    while index < 64 {
        let present = (index * 2) as int32;
        var found: uint = 0;
        Assert(BinarySearch<int32>(wide, present).TryIntoValue(@found), "every present value is found");
        Assert(found == index, "at its own index");
        Assert(BinarySearch<int32>(wide, present + 1).IsNone(), "and every absent one is not");
        Assert(LowerBound<int32>(wide, present + 1) == index + 1, "with the gap's bound just past it");
        index++;
    }

    return 0;
}
