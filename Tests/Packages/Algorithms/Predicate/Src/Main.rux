import Algorithms::{ TryFindIf, TryFindLastIf, CountIf, All, Any, None };
import Algorithms::{ RemoveIf, Partition, PartitionPoint, Transform, Fold };
import Algorithms::{ IsSorted, Equal };

struct Record {
    key: int32;
    origin: int32;
}

extend Record {
    func ==(self, other: Record) -> bool {
        return self.key == other.key && self.origin == other.origin;
    }
}

func IsEven(value: int32) -> bool {
    return value % 2 == 0;
}

func IsOdd(value: int32) -> bool {
    return value % 2 != 0;
}

func IsPositive(value: int32) -> bool {
    return value > 0;
}

func Never(value: int32) -> bool {
    return false;
}

func Always(value: int32) -> bool {
    return true;
}

func Below4(value: int32) -> bool {
    return value < 4;
}

func HasEvenKey(record: Record) -> bool {
    return record.key % 2 == 0;
}

func Double(value: int32) -> int32 {
    return value * 2;
}

func KeyOf(record: Record) -> int32 {
    return record.key;
}

func AddInt32(total: int32, value: int32) -> int32 {
    return total + value;
}

func AddKey(total: int32, record: Record) -> int32 {
    return total + record.key;
}

func CountEven(total: int32, value: int32) -> int32 {
    if value % 2 == 0 {
        return total + 1;
    }
    return total;
}

func Main() -> int {
    var values: int32[8] = [1, 2, 3, 4, 5, 6, 7, 8];
    var empty: int32[1] = [0];
    var index: uint = 0;

    // TryFindIf reports the first accepted element, TryFindLastIf the last.
    if !TryFindIf<int32>(@values[0], 8, IsEven, @index) { return 10; }
    if index != 1 { return 11; }
    if !TryFindLastIf<int32>(@values[0], 8, IsEven, @index) { return 12; }
    if index != 7 { return 13; }

    // A miss leaves the index untouched, so a caller may seed it.
    index = 99;
    if TryFindIf<int32>(@values[0], 8, Never, @index) { return 14; }
    if index != 99 { return 15; }
    if TryFindLastIf<int32>(@values[0], 8, Never, @index) { return 16; }
    if index != 99 { return 17; }

    // An empty sequence matches nothing, and a null index reports failure.
    if TryFindIf<int32>(@empty[0], 0, Always, @index) { return 18; }
    if TryFindLastIf<int32>(@empty[0], 0, Always, @index) { return 19; }
    if TryFindIf<int32>(@values[0], 8, IsEven, null) { return 20; }
    if TryFindLastIf<int32>(@values[0], 8, IsEven, null) { return 21; }

    // CountIf agrees with the two quantifiers at the extremes.
    if CountIf<int32>(@values[0], 8, IsEven) != 4 { return 30; }
    if CountIf<int32>(@values[0], 8, Never) != 0 { return 31; }
    if CountIf<int32>(@values[0], 8, Always) != 8 { return 32; }
    if CountIf<int32>(@empty[0], 0, Always) != 0 { return 33; }

    // All, Any and None over a mixed sequence.
    if All<int32>(@values[0], 8, IsEven) { return 40; }
    if !All<int32>(@values[0], 8, IsPositive) { return 41; }
    if !Any<int32>(@values[0], 8, IsEven) { return 42; }
    if Any<int32>(@values[0], 8, Never) { return 43; }
    if !None<int32>(@values[0], 8, Never) { return 44; }
    if None<int32>(@values[0], 8, IsEven) { return 45; }

    // None is the exact negation of Any, including when empty.
    if None<int32>(@values[0], 8, IsEven) == Any<int32>(@values[0], 8, IsEven) { return 46; }

    // An empty sequence satisfies All vacuously and Any never, which keeps
    // All and None true together only when there is nothing to test.
    if !All<int32>(@empty[0], 0, Never) { return 47; }
    if Any<int32>(@empty[0], 0, Always) { return 48; }
    if !None<int32>(@empty[0], 0, Always) { return 49; }

    // RemoveIf compacts survivors and preserves their order.
    var mixed: int32[8] = [1, 2, 3, 4, 5, 6, 7, 8];
    if RemoveIf<int32>(@mixed[0], 8, IsEven) != 4 { return 50; }
    if mixed[0] != 1 || mixed[1] != 3 || mixed[2] != 5 || mixed[3] != 7 { return 51; }

    var none: int32[3] = [1, 3, 5];
    if RemoveIf<int32>(@none[0], 3, IsEven) != 3 { return 52; }
    if none[0] != 1 || none[2] != 5 { return 53; }

    var every: int32[3] = [2, 4, 6];
    if RemoveIf<int32>(@every[0], 3, IsEven) != 0 { return 54; }
    if RemoveIf<int32>(@every[0], 0, IsEven) != 0 { return 55; }

    // Partition splits the sequence and reports the boundary, which equals the
    // number of accepted elements.
    var split: int32[8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let total: uint = 8;
    let boundary = Partition<int32>(@split[0], 8, IsEven);
    if boundary != 4 { return 60; }
    if !All<int32>(@split[0], boundary, IsEven) { return 61; }
    if !None<int32>(@split[4], total - boundary, IsEven) { return 62; }
    if boundary != CountIf<int32>(@split[0], 8, IsEven) { return 63; }

    // Partitioning by a predicate nothing or everything satisfies.
    var all: int32[4] = [2, 4, 6, 8];
    if Partition<int32>(@all[0], 4, IsEven) != 4 { return 64; }
    if Partition<int32>(@all[0], 4, Never) != 0 { return 65; }
    if Partition<int32>(@all[0], 0, Always) != 0 { return 66; }

    // PartitionPoint finds the boundary of an already-partitioned sequence in
    // logarithmic time, and agrees with Partition's own answer.
    var ordered: int32[8] = [1, 2, 3, 4, 5, 6, 7, 8];
    if PartitionPoint<int32>(@ordered[0], 8, Below4) != 3 { return 70; }
    if PartitionPoint<int32>(@ordered[0], 8, Always) != 8 { return 71; }
    if PartitionPoint<int32>(@ordered[0], 8, Never) != 0 { return 72; }
    if PartitionPoint<int32>(@ordered[0], 0, Always) != 0 { return 73; }

    var reordered: int32[8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let point = Partition<int32>(@reordered[0], 8, IsOdd);
    if PartitionPoint<int32>(@reordered[0], 8, IsOdd) != point { return 74; }

    // Transform writes into a separate destination.
    var source: int32[4] = [1, 2, 3, 4];
    var doubled: int32[4] = [0, 0, 0, 0];
    if !Transform<int32, int32>(@doubled[0], @source[0], 4, Double) { return 80; }
    if doubled[0] != 2 || doubled[3] != 8 { return 81; }
    if source[0] != 1 || source[3] != 4 { return 82; }

    // Transforming in place is allowed when the types match.
    if !Transform<int32, int32>(@source[0], @source[0], 4, Double) { return 83; }
    if source[0] != 2 || source[3] != 8 { return 84; }

    // Zero elements always succeeds; a null with a real length does not.
    if !Transform<int32, int32>(null, null, 0, Double) { return 85; }
    if Transform<int32, int32>(null, @source[0], 4, Double) { return 86; }
    if Transform<int32, int32>(@doubled[0], null, 4, Double) { return 87; }

    // The element and result types may differ.
    var records: Record[3] = [Record { key: 5, origin: 0 },
                              Record { key: 6, origin: 1 },
                              Record { key: 7, origin: 2 }];
    var keys: int32[3] = [0, 0, 0];
    if !Transform<Record, int32>(@keys[0], @records[0], 3, KeyOf) { return 88; }
    if keys[0] != 5 || keys[2] != 7 { return 89; }

    // Fold accumulates left to right, and an empty sequence yields the seed.
    var digits: int32[5] = [1, 2, 3, 4, 5];
    if Fold<int32, int32>(@digits[0], 5, 0, AddInt32) != 15 { return 90; }
    if Fold<int32, int32>(@digits[0], 5, 100, AddInt32) != 115 { return 91; }
    if Fold<int32, int32>(@digits[0], 0, 7, AddInt32) != 7 { return 92; }

    // The accumulator need not be the element type's own sum.
    if Fold<int32, int32>(@digits[0], 5, 0, CountEven) != 2 { return 93; }
    if Fold<Record, int32>(@records[0], 3, 0, AddKey) != 18 { return 94; }

    // Predicates over a struct element type.
    if CountIf<Record>(@records[0], 3, HasEvenKey) != 1 { return 100; }
    if !TryFindIf<Record>(@records[0], 3, HasEvenKey, @index) { return 101; }
    if index != 1 { return 102; }

    var pruned: Record[3] = [Record { key: 5, origin: 0 },
                             Record { key: 6, origin: 1 },
                             Record { key: 7, origin: 2 }];
    if RemoveIf<Record>(@pruned[0], 3, HasEvenKey) != 2 { return 103; }
    if pruned[0].key != 5 || pruned[1].key != 7 { return 104; }
    if pruned[1].origin != 2 { return 105; }

    // The value-based queries still work alongside the predicate ones.
    var check: int32[4] = [2, 4, 6, 8];
    if !IsSorted<int32>(@check[0], 4) { return 110; }
    if !Equal<int32>(@check[0], 4, @all[0], 4) { return 111; }

    return 0;
}
