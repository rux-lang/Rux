import Core::{ MutableSlice, Slice };
import Format::{ ByteCursor, FormatSpec, CursorWriter, Display, TextWriter };

// Std is deliberately absent from the dependencies: it exports conversions of the same name, and the compiler pools
// the overloads of two same-named symbols, so Std's would win over this package's and the code under test would
// never run. That rules out Std::Assert, so a failed check reports itself through the exit code instead: each one
// below is numbered, and `rux test` prints the number of the first that fails.
//
// Rendering goes into a buffer on the stack rather than into a string, which is what the writer-based contract
// buys: this test needs no allocator at all.
func Check(value: int, expected: Slice<char8>, code: int) -> int {
    var storage: char8[64];
    var cursor = ByteCursor::New(MutableSlice::From<char8>(@storage[0], 64));
    let writer: TextWriter = CursorWriter::Of(@cursor);
    let shown: Display = value;
    if shown.Format(writer, FormatSpec::Plain()).IsError() {
        return code;
    }
    let actual = cursor.Written();
    if actual.length != expected.length {
        return code;
    }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] {
            return code;
        }
        index = index + 1;
    }
    return 0;
}

func Main() -> int {
    // int is the signed integer as wide as a pointer. It is a type of its own
    // rather than another name for int64, so it has a conversion of its own --
    // and reaching that conversion through a variable of the type is what proves
    // the two overloads do not collide, which is the whole point of this test.
    let zero: int = 0;
    var code = Check(zero, "0", 10);
    if code != 0 { return code; }

    let negative: int = -42;
    code = Check(negative, "-42", 11);
    if code != 0 { return code; }

    let positive: int = 42;
    code = Check(positive, "42", 12);
    if code != 0 { return code; }

    // A value past the range of an int32, which an int holds on every target the
    // package supports.
    let large: int = 4294967296;
    code = Check(large, "4294967296", 20);
    if code != 0 { return code; }

    // An untyped literal is an int, so this is the overload it lands on with no
    // annotation anywhere to steer it.
    code = Check(-7, "-7", 21);
    if code != 0 { return code; }

    return 0;
}
