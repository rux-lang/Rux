import Core::{ MutableSlice, Slice };
import Format::{ ByteCursor, FormatSpec, CursorWriter, Display, Writer };

// Std is deliberately absent from the dependencies: it exports conversions of the same name, and the compiler pools
// the overloads of two same-named symbols, so Std's would win over this package's and the code under test would
// never run. That rules out Std::Assert, so a failed check reports itself through the exit code instead: each one
// below is numbered, and `rux test` prints the number of the first that fails.
//
// Rendering goes into a buffer on the stack rather than into a string, which is what the writer-based contract
// buys: this test needs no allocator at all.
func Check(value: int8, expected: Slice<char8>, code: int) -> int {
    var storage: char8[64];
    var cursor = ByteCursor::New(MutableSlice::From<char8>(@storage[0], 64));
    let writer: Writer = CursorWriter::Of(@cursor);
    let shown: Display = value;
    if shown.Format(writer, FormatSpec::Plain()).IsError() {
        return code;
    }
    let actual = cursor.Written();
    if actual.length != expected.length {
        return code;
    }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] {
            return code;
        }
        index = index + 1;
    }
    return 0;
}

func Main() -> int {
    let zero: int8 = 0;
    var code = Check(zero, "0", 10);
    if code != 0 { return code; }

    let one: int8 = 1;
    code = Check(one, "1", 11);
    if code != 0 { return code; }

    // A negative value opens with a minus sign; a positive one carries no plus.
    let negative: int8 = -7;
    code = Check(negative, "-7", 12);
    if code != 0 { return code; }

    // The ends of the range. The most negative value of a signed type is the one
    // with no positive counterpart, which is why the digits come from the
    // magnitude taken in unsigned rather than from a negation.
    let min: int8 = -128;
    let max: int8 = 127;
    code = Check(min, "-128", 20);
    if code != 0 { return code; }
    code = Check(max, "127", 21);
    if code != 0 { return code; }

    return 0;
}
