
import Core::{ Result, Unit };
import Allocator::{ Allocator, SystemAllocator };
import Format::Render;
import Text::{ FormatError, ParseFormatSpec, String, StringView };

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: char8[..]) -> char8[..] {
    return (text.data)[..text.length];
}

// The spec grammar, exercised through whole format calls so what is checked is what a caller sees. Each family gets
// its edges: alignment with and without a named fill, zero-padding around a sign, each base with and without its
// prefix, precision on text at a multi-byte boundary, and the ill-formed specs that must come through as literal
// text rather than half-applied.

// Zero when `text` fails to parse with `InvalidSpecification` carrying exactly `offset`, and non-zero otherwise,
// so a caller can distinguish "parsed", "failed elsewhere" and "failed at the wrong place".
func MalformedAt(text: char8[..], offset: uint) -> int {
    return match ParseFormatSpec(text) {
        .Success(_) => 1,
        .Error(reason) => match reason {
            .InvalidSpecification(found) => found == offset ? 0 : 2,
            else => 3
        }
    };
}

func Matches(allocator: Allocator, format: char8[..], expected: char8[..]) -> bool {
    let rendered = Rendered(allocator, Render(allocator, format, 0));
    let wanted = StringView::FromValidated(expected);
    let renderedView = rendered.View();
    return renderedView.Equals(wanted);
}

// Whether rendering `format` is refused with `InvalidSpecification` at exactly `offset` — an offset into the whole
// pattern, not into the specification inside it, which is what a caller pointing at a character needs.
func RefusedAt(allocator: Allocator, format: char8[..], offset: uint) -> bool {
    return match <-Render(allocator, format, 0) {
        .Success(_) => false,
        .Error(reason) => match reason {
            .InvalidSpecification(found) => found == offset,
            else => false
        }
    };
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // Width and alignment: numbers sit right by default, text left, and a named fill replaces the space.
    let right = Rendered(allocator, Render(allocator, "[{:6}]", 42));
    let wantedRight = StringView::FromValidated("[    42]");
    var got = right.View();
    if !got.Equals(wantedRight) { return 10; }

    let text = Rendered(allocator, Render(allocator, "[{:6}]", StringView::FromValidated("ab")));
    let wantedText = StringView::FromValidated("[ab    ]");
    got = text.View();
    if !got.Equals(wantedText) { return 11; }

    let left = Rendered(allocator, Render(allocator, "[{:<6}]", 42));
    let wantedLeft = StringView::FromValidated("[42    ]");
    got = left.View();
    if !got.Equals(wantedLeft) { return 12; }

    let center = Rendered(allocator, Render(allocator, "[{:^7}]", 42));
    let wantedCenter = StringView::FromValidated("[  42   ]");
    got = center.View();
    if !got.Equals(wantedCenter) { return 13; }

    let starred = Rendered(allocator, Render(allocator, "[{:*>6}]", 42));
    let wantedStars = StringView::FromValidated("[****42]");
    got = starred.View();
    if !got.Equals(wantedStars) { return 14; }

    // A width no wider than the value changes nothing.
    let snug = Rendered(allocator, Render(allocator, "[{:2}]", 12345));
    let wantedSnug = StringView::FromValidated("[12345]");
    got = snug.View();
    if !got.Equals(wantedSnug) { return 15; }

    // Sign and zero-padding: the zeros go inside the number, after its sign.
    let plus = Rendered(allocator, Render(allocator, "{:+}", 42));
    let wantedPlus = StringView::FromValidated("+42");
    got = plus.View();
    if !got.Equals(wantedPlus) { return 20; }

    let minusPadded = Rendered(allocator, Render(allocator, "{:06}", -42));
    let wantedMinus = StringView::FromValidated("-00042");
    got = minusPadded.View();
    if !got.Equals(wantedMinus) { return 21; }

    let plusPadded = Rendered(allocator, Render(allocator, "{:+06}", 42));
    let wantedPlusPad = StringView::FromValidated("+00042");
    got = plusPadded.View();
    if !got.Equals(wantedPlusPad) { return 22; }

    // The bases, bare and prefixed, and the case of the hex digits.
    let hex = Rendered(allocator, Render(allocator, "{:x}", 255));
    let wantedHex = StringView::FromValidated("ff");
    got = hex.View();
    if !got.Equals(wantedHex) { return 30; }

    let upperHex = Rendered(allocator, Render(allocator, "{:X}", 255));
    let wantedUpper = StringView::FromValidated("FF");
    got = upperHex.View();
    if !got.Equals(wantedUpper) { return 31; }

    let prefixed = Rendered(allocator, Render(allocator, "{:#x}", 255));
    let wantedPrefixed = StringView::FromValidated("0xff");
    got = prefixed.View();
    if !got.Equals(wantedPrefixed) { return 32; }

    let binary = Rendered(allocator, Render(allocator, "{:#b}", 5));
    let wantedBinary = StringView::FromValidated("0b101");
    got = binary.View();
    if !got.Equals(wantedBinary) { return 33; }

    let octal = Rendered(allocator, Render(allocator, "{:#o}", 8));
    let wantedOctal = StringView::FromValidated("0o10");
    got = octal.View();
    if !got.Equals(wantedOctal) { return 34; }

    // Zero-padded hex with its prefix: the zeros sit between prefix and digits.
    let padHex = Rendered(allocator, Render(allocator, "{:#06x}", 255));
    let wantedPadHex = StringView::FromValidated("0x00ff");
    got = padHex.View();
    if !got.Equals(wantedPadHex) { return 35; }

    // A negative number in a base renders its magnitude behind its sign.
    let negHex = Rendered(allocator, Render(allocator, "{:x}", -255));
    let wantedNegHex = StringView::FromValidated("-ff");
    got = negHex.View();
    if !got.Equals(wantedNegHex) { return 36; }

    // Precision keeps characters, and cuts on a character boundary even when the byte count says otherwise.
    let cut = Rendered(allocator, Render(allocator, "{:.3}", StringView::FromValidated("hello")));
    let wantedCut = StringView::FromValidated("hel");
    got = cut.View();
    if !got.Equals(wantedCut) { return 40; }

    let accented = Rendered(allocator, Render(allocator, "{:.2}", StringView::FromValidated("héllo")));
    let wantedAccent = StringView::FromValidated("hé");
    got = accented.View();
    if !got.Equals(wantedAccent) { return 41; }

    let wideEnough = Rendered(allocator, Render(allocator, "[{:6.2}]", StringView::FromValidated("hello")));
    let wantedBoth = StringView::FromValidated("[he    ]");
    got = wideEnough.View();
    if !got.Equals(wantedBoth) { return 42; }

    // A float under width and sign; its digits are the shortest rendering either way.
    let floatPad = Rendered(allocator, Render(allocator, "[{:8}]", 2.5));
    let wantedFloat = StringView::FromValidated("[     2.5]");
    got = floatPad.View();
    if !got.Equals(wantedFloat) { return 50; }

    let floatPlus = Rendered(allocator, Render(allocator, "{:+}", 2.5));
    let wantedFloatPlus = StringView::FromValidated("+2.5");
    got = floatPlus.View();
    if !got.Equals(wantedFloatPlus) { return 51; }

    // A spec that does not parse is a refusal carrying where, rather than literal text printed back. `{:>>>}` has
    // a third alignment mark where a sign, a width or a style could go, and `{:.}` opens a precision it never gives
    // digits to. The offsets are into the pattern: the specification starts two bytes in, so each is the parser's
    // own offset plus two, and a check that only asked for the reason would pass with all three set to zero.
    if !RefusedAt(allocator, "{:>>>}", 4u) { return 61; }
    if !RefusedAt(allocator, "{:.}", 3u) { return 62; }
    if !RefusedAt(allocator, "{:8q!}", 4u) { return 63; }

    // `{:q}` is no longer among them. A style is an identifier in the grammar, so `q` parses; whether it means
    // anything is the value's question, and every value here answers no. The failure moved from the parser to the
    // value, which is where it belongs — the parser cannot know what an integer or a string supports.
    if Render(allocator, "{:q}", 42).IsSuccess() { return 64; }
    if Render(allocator, "{:q}", "text").IsSuccess() { return 65; }
    if Render(allocator, "{:q}", true).IsSuccess() { return 66; }
    if Render(allocator, "{:iso8601}", 42).IsSuccess() { return 67; }

    // What an integer does support is its four bases, checked above: those are styles too, and they parse by the
    // same rule as `iso8601` does, which is why `{:x}` still works and `{:q}` does not.

    // The parser itself, where a failure carries where it was found. The cases above check that a format call
    // reports the same failure with the offset moved into the pattern; these check the parser against the body it
    // was actually given.
    if ParseFormatSpec("").IsError() { return 80; }
    if ParseFormatSpec(">8.2iso8601").IsError() { return 81; }
    if MalformedAt("{>8", 0u) != 0 { return 82; }
    if MalformedAt(".", 1u) != 0 { return 83; }
    if MalformedAt(".x", 1u) != 0 { return 84; }
    if MalformedAt(">>>", 2u) != 0 { return 85; }
    if MalformedAt("8!", 1u) != 0 { return 86; }
    if MalformedAt("8q!", 2u) != 0 { return 87; }

    // Width and precision arithmetic is checked rather than wrapped, and the offset names the digit that would not
    // fit, which is the twentieth digit: nineteen nines fit a 64-bit uint and twenty do not.
    if MalformedAt("999999999999999999999", 19u) != 0 { return 88; }
    if MalformedAt(".999999999999999999999", 20u) != 0 { return 89; }
    if ParseFormatSpec("18446744073709551615").IsError() { return 90; }

    // Float precision: digits after the point, rounded to nearest with ties to even. A tie goes to the even
    // neighbour rather than away from zero, which is what reading the result back would do with it — so 1.25 at one
    // decimal is 1.2 and 2.5 at none is 2. Tests/Packages/Format/Precision is where that rule is covered properly.
    let twoPlaces = Rendered(allocator, Render(allocator, "{:.2}", 2.5));
    let wantedTwo = StringView::FromValidated("2.50");
    got = twoPlaces.View();
    if !got.Equals(wantedTwo) { return 70; }

    let carried = Rendered(allocator, Render(allocator, "{:.1}", 1.25));
    let wantedCarried = StringView::FromValidated("1.2");
    got = carried.View();
    if !got.Equals(wantedCarried) { return 71; }

    let rounded = Rendered(allocator, Render(allocator, "{:.0}", 2.5));
    let wantedRounded = StringView::FromValidated("2");
    got = rounded.View();
    if !got.Equals(wantedRounded) { return 72; }

    let stretched = Rendered(allocator, Render(allocator, "{:.3}", 0.1));
    let wantedStretched = StringView::FromValidated("0.100");
    got = stretched.View();
    if !got.Equals(wantedStretched) { return 73; }

    let negRounded = Rendered(allocator, Render(allocator, "{:.0}", -2.5));
    let wantedNeg = StringView::FromValidated("-2");
    got = negRounded.View();
    if !got.Equals(wantedNeg) { return 74; }

    let zeroTwo = Rendered(allocator, Render(allocator, "{:.2}", 0.0));
    let wantedZeroTwo = StringView::FromValidated("0.00");
    got = zeroTwo.View();
    if !got.Equals(wantedZeroTwo) { return 75; }

    let trimmed = Rendered(allocator, Render(allocator, "{:.2}", 3.14159));
    let wantedTrimmed = StringView::FromValidated("3.14");
    got = trimmed.View();
    if !got.Equals(wantedTrimmed) { return 76; }

    return 0;
}

// The rendered text, or an empty string when rendering failed. Every check above compares against text it expects
// to be non-empty, so a failure cannot pass as a success: an empty string matches none of them, and an empty one
// handed to a parser is refused.
func Rendered(allocator: Allocator, outcome: Result<String, FormatError>) -> String {
    var text = String(allocator);
    outcome.TryIntoValue(@text);
    return <-text;
}
