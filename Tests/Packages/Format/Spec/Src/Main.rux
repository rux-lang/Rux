
import Core::{ Result, Unit };
import Allocator::{ Allocator, SystemAllocator };
import Format::Format;
import Text::{ FormatError, String, StringView };

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: char8[..]) -> char8[..] {
    return (text.data)[..text.length];
}

// The spec grammar, exercised through whole format calls so what is checked is what a caller sees. Each family gets
// its edges: alignment with and without a named fill, zero-padding around a sign, each base with and without its
// prefix, precision on text at a multi-byte boundary, and the ill-formed specs that must come through as literal
// text rather than half-applied.

func Matches(allocator: Allocator, format: char8[..], expected: char8[..]) -> bool {
    let rendered = Rendered(allocator, Format(allocator, format, 0));
    let wanted = StringView::FromValidated(expected);
    let renderedView = rendered.View();
    return renderedView.Equals(wanted);
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // Width and alignment: numbers sit right by default, text left, and a named fill replaces the space.
    let right = Rendered(allocator, Format(allocator, "[{:6}]", 42));
    let wantedRight = StringView::FromValidated("[    42]");
    var got = right.View();
    if !got.Equals(wantedRight) { return 10; }

    let text = Rendered(allocator, Format(allocator, "[{:6}]", StringView::FromValidated("ab")));
    let wantedText = StringView::FromValidated("[ab    ]");
    got = text.View();
    if !got.Equals(wantedText) { return 11; }

    let left = Rendered(allocator, Format(allocator, "[{:<6}]", 42));
    let wantedLeft = StringView::FromValidated("[42    ]");
    got = left.View();
    if !got.Equals(wantedLeft) { return 12; }

    let center = Rendered(allocator, Format(allocator, "[{:^7}]", 42));
    let wantedCenter = StringView::FromValidated("[  42   ]");
    got = center.View();
    if !got.Equals(wantedCenter) { return 13; }

    let starred = Rendered(allocator, Format(allocator, "[{:*>6}]", 42));
    let wantedStars = StringView::FromValidated("[****42]");
    got = starred.View();
    if !got.Equals(wantedStars) { return 14; }

    // A width no wider than the value changes nothing.
    let snug = Rendered(allocator, Format(allocator, "[{:2}]", 12345));
    let wantedSnug = StringView::FromValidated("[12345]");
    got = snug.View();
    if !got.Equals(wantedSnug) { return 15; }

    // Sign and zero-padding: the zeros go inside the number, after its sign.
    let plus = Rendered(allocator, Format(allocator, "{:+}", 42));
    let wantedPlus = StringView::FromValidated("+42");
    got = plus.View();
    if !got.Equals(wantedPlus) { return 20; }

    let minusPadded = Rendered(allocator, Format(allocator, "{:06}", -42));
    let wantedMinus = StringView::FromValidated("-00042");
    got = minusPadded.View();
    if !got.Equals(wantedMinus) { return 21; }

    let plusPadded = Rendered(allocator, Format(allocator, "{:+06}", 42));
    let wantedPlusPad = StringView::FromValidated("+00042");
    got = plusPadded.View();
    if !got.Equals(wantedPlusPad) { return 22; }

    // The bases, bare and prefixed, and the case of the hex digits.
    let hex = Rendered(allocator, Format(allocator, "{:x}", 255));
    let wantedHex = StringView::FromValidated("ff");
    got = hex.View();
    if !got.Equals(wantedHex) { return 30; }

    let upperHex = Rendered(allocator, Format(allocator, "{:X}", 255));
    let wantedUpper = StringView::FromValidated("FF");
    got = upperHex.View();
    if !got.Equals(wantedUpper) { return 31; }

    let prefixed = Rendered(allocator, Format(allocator, "{:#x}", 255));
    let wantedPrefixed = StringView::FromValidated("0xff");
    got = prefixed.View();
    if !got.Equals(wantedPrefixed) { return 32; }

    let binary = Rendered(allocator, Format(allocator, "{:#b}", 5));
    let wantedBinary = StringView::FromValidated("0b101");
    got = binary.View();
    if !got.Equals(wantedBinary) { return 33; }

    let octal = Rendered(allocator, Format(allocator, "{:#o}", 8));
    let wantedOctal = StringView::FromValidated("0o10");
    got = octal.View();
    if !got.Equals(wantedOctal) { return 34; }

    // Zero-padded hex with its prefix: the zeros sit between prefix and digits.
    let padHex = Rendered(allocator, Format(allocator, "{:#06x}", 255));
    let wantedPadHex = StringView::FromValidated("0x00ff");
    got = padHex.View();
    if !got.Equals(wantedPadHex) { return 35; }

    // A negative number in a base renders its magnitude behind its sign.
    let negHex = Rendered(allocator, Format(allocator, "{:x}", -255));
    let wantedNegHex = StringView::FromValidated("-ff");
    got = negHex.View();
    if !got.Equals(wantedNegHex) { return 36; }

    // Precision keeps characters, and cuts on a character boundary even when the byte count says otherwise.
    let cut = Rendered(allocator, Format(allocator, "{:.3}", StringView::FromValidated("hello")));
    let wantedCut = StringView::FromValidated("hel");
    got = cut.View();
    if !got.Equals(wantedCut) { return 40; }

    let accented = Rendered(allocator, Format(allocator, "{:.2}", StringView::FromValidated("héllo")));
    let wantedAccent = StringView::FromValidated("hé");
    got = accented.View();
    if !got.Equals(wantedAccent) { return 41; }

    let wideEnough = Rendered(allocator, Format(allocator, "[{:6.2}]", StringView::FromValidated("hello")));
    let wantedBoth = StringView::FromValidated("[he    ]");
    got = wideEnough.View();
    if !got.Equals(wantedBoth) { return 42; }

    // A float under width and sign; its digits are the shortest rendering either way.
    let floatPad = Rendered(allocator, Format(allocator, "[{:8}]", 2.5));
    let wantedFloat = StringView::FromValidated("[     2.5]");
    got = floatPad.View();
    if !got.Equals(wantedFloat) { return 50; }

    let floatPlus = Rendered(allocator, Format(allocator, "{:+}", 2.5));
    let wantedFloatPlus = StringView::FromValidated("+2.5");
    got = floatPlus.View();
    if !got.Equals(wantedFloatPlus) { return 51; }

    // A spec that does not parse is literal text, mistake and all.
    if !Matches(allocator, "{:q}", "{:q}") { return 60; }
    if !Matches(allocator, "{:>>>}", "{:>>>}") { return 61; }
    if !Matches(allocator, "{:.}", "{:.}") { return 62; }

    // Float precision: digits after the point, rounded half away from zero, carry and all.
    let twoPlaces = Rendered(allocator, Format(allocator, "{:.2}", 2.5));
    let wantedTwo = StringView::FromValidated("2.50");
    got = twoPlaces.View();
    if !got.Equals(wantedTwo) { return 70; }

    let carried = Rendered(allocator, Format(allocator, "{:.1}", 1.25));
    let wantedCarried = StringView::FromValidated("1.3");
    got = carried.View();
    if !got.Equals(wantedCarried) { return 71; }

    let rounded = Rendered(allocator, Format(allocator, "{:.0}", 2.5));
    let wantedRounded = StringView::FromValidated("3");
    got = rounded.View();
    if !got.Equals(wantedRounded) { return 72; }

    let stretched = Rendered(allocator, Format(allocator, "{:.3}", 0.1));
    let wantedStretched = StringView::FromValidated("0.100");
    got = stretched.View();
    if !got.Equals(wantedStretched) { return 73; }

    let negRounded = Rendered(allocator, Format(allocator, "{:.0}", -2.5));
    let wantedNeg = StringView::FromValidated("-3");
    got = negRounded.View();
    if !got.Equals(wantedNeg) { return 74; }

    let zeroTwo = Rendered(allocator, Format(allocator, "{:.2}", 0.0));
    let wantedZeroTwo = StringView::FromValidated("0.00");
    got = zeroTwo.View();
    if !got.Equals(wantedZeroTwo) { return 75; }

    let trimmed = Rendered(allocator, Format(allocator, "{:.2}", 3.14159));
    let wantedTrimmed = StringView::FromValidated("3.14");
    got = trimmed.View();
    if !got.Equals(wantedTrimmed) { return 76; }

    return 0;
}

// The rendered text, or an empty string when rendering failed. Every check above compares against text it expects
// to be non-empty, so a failure cannot pass as a success: an empty string matches none of them, and an empty one
// handed to a parser is refused.
func Rendered(allocator: Allocator, outcome: Result<String, FormatError>) -> String {
    var text = String(allocator);
    outcome.TryIntoValue(@text);
    return <-text;
}
