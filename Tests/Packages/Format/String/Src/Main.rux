import Core::{ Result, Unit };
import Text::{ Debug, Display, FormatSpec, TextWriter };
import Allocator::{ Allocator, SystemAllocator };
import Format::{ Format };
import Text::{ FormatError, String, StringBuilder, StringView, TextError };

// Text rendering itself: a string and a view write their bytes straight through, and Debug adds the quotes that
// make an empty one visible. Std stays out of the dependencies and a failed check reports through the exit code.

func Matches(actual: StringView, expected: char8[..]) -> bool {
    let wanted = StringView::FromValidated(expected);
    return actual.Equals(wanted);
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    var error = TextError::None;
    let hello = String::FromBytes(allocator, "Hello World!", @error);
    if error != TextError::None { return 1; }

    // Through a placeholder, which is the path an argument takes.
    let alone = Rendered(allocator, Format(allocator, "{}", hello.View()));
    if !Matches(alone.View(), "Hello World!") { return 10; }

    let wrapped = Rendered(allocator, Format(allocator, "<{}>", hello.View()));
    if !Matches(wrapped.View(), "<Hello World!>") { return 11; }

    // Alongside arguments of other types, and twice from one value.
    let mixed = Rendered(allocator, Format(allocator, "{} {} {}", hello.View(), 42, true));
    if !Matches(mixed.View(), "Hello World! 42 true") { return 12; }
    let doubled = Rendered(allocator, Format(allocator, "{}{}", hello.View(), hello.View()));
    if !Matches(doubled.View(), "Hello World!Hello World!") { return 13; }

    // The receiver is untouched by having been rendered, however many times.
    if hello.Length() != 12 { return 14; }

    // Debug quotes; Display does not. The difference is what makes an empty string visible.
    var builder = StringBuilder(allocator);
    let empty = String(allocator);
    let shownPlain: Display = empty.View();
    let plainWriter: &var TextWriter = builder;
    if shownPlain.WriteDisplay(plainWriter, FormatSpec::Plain()).IsError() { return 20; }
    if builder.Length() != 0 { return 21; }
    let shownDebug: Debug = empty.View();
    let emptyDebugWriter: &var TextWriter = builder;
    if shownDebug.WriteDebug(emptyDebugWriter, FormatSpec::Plain()).IsError() { return 22; }
    if !Matches(builder.View(), "\"\"") { return 23; }

    // A character slice containing a text literal renders and quotes the same way.
    builder.Clear();
    let shownText: Display = "Hello World!";
    let textWriter: &var TextWriter = builder;
    if shownText.WriteDisplay(textWriter, FormatSpec::Plain()).IsError() { return 30; }
    if !Matches(builder.View(), "Hello World!") { return 31; }

    builder.Clear();
    let shownTextDebug: Debug = "";
    let textDebugWriter: &var TextWriter = builder;
    if shownTextDebug.WriteDebug(textDebugWriter, FormatSpec::Plain()).IsError() { return 32; }
    if !Matches(builder.View(), "\"\"") { return 33; }

    builder.Clear();
    let shownHello: Debug = hello.View();
    let helloDebugWriter: &var TextWriter = builder;
    if shownHello.WriteDebug(helloDebugWriter, FormatSpec::Plain()).IsError() { return 24; }
    if !Matches(builder.View(), "\"Hello World!\"") { return 25; }

    return 0;
}

// The rendered text, or an empty string when rendering failed. Every check above compares against text it expects
// to be non-empty, so a failure cannot pass as a success.
func Rendered(allocator: Allocator, outcome: Result<String, FormatError>) -> String {
    var text = String(allocator);
    outcome.TryIntoValue(@text);
    return <-text;
}
