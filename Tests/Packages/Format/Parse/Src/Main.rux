import Core::Diagnostics::Assert;
import Format::{ IsInfinite, IsNan };
import Format::Parsing::{ ParseBool, ParseChar, ParseError, ParseFloat32, ParseFloat64, ParseInt128, ParseInt64,
                          ParseInt8, ParseUint128, ParseUint512, ParseUint64, ParseUint8 };
import Text::Formatting::ParseFailure;

// One grammar serves every width — sign, optional base prefix, digits — and the width's own bound is checked
// last, so what is tested per width is the bound: the largest value in, one past it refused, and for the signed
// widths the most negative value, which fits where its positive twin does not.
// The prefixes are exactly the ones formatting writes under `#`, so what one side prints the other reads.
// Every refusal also says where, and the offsets are the half that fails quietly: a reason with the wrong offset
// still passes a check that only asks for the reason, and still underlines the wrong character in whatever reports
// it. So the section at the bottom names the exact byte for each, including the two flavours of overflow, which
// point at different things on purpose. A number past what the widest integer holds points at the digit that did
// it, because the number itself is unreadable from there on; a number that merely does not fit the width asked for
// points at its end, because the whole of it is what does not fit and no single digit is at fault.

// Which failure a result carries, as a small code: 1 Empty, 2 InvalidCharacter, 3 Overflow.
func CodeOf(error: &ParseError) -> int {
    return match error {
        .Empty => 1,
        .InvalidCharacter(_) => 2,
        .Overflow(_) => 3
    };
}

// Whether `outcome` failed with exactly `code` at exactly `at`. The offset is read through `Offset`, which is what
// a caller embedding this parser in a larger grammar calls, so the test exercises the contract rather than the
// payload shape.
func FailedAt(reason: ParseError, code: int, at: uint) -> bool {
    return CodeOf(reason) == code && reason.Offset() == at;
}

func FailedAt8(reason: ParseError, code: int, at: uint) -> bool {
    return CodeOf(reason) == code && reason.Offset() == at;
}

func FailedAtU8(reason: ParseError, code: int, at: uint) -> bool {
    return CodeOf(reason) == code && reason.Offset() == at;
}

func FailedAtU512(reason: ParseError, code: int, at: uint) -> bool {
    return CodeOf(reason) == code && reason.Offset() == at;
}

func FailedAtBool(reason: ParseError, code: int, at: uint) -> bool {
    return CodeOf(reason) == code && reason.Offset() == at;
}

func FailedAtChar(reason: ParseError, code: int, at: uint) -> bool {
    return CodeOf(reason) == code && reason.Offset() == at;
}

func FailedAtFloat(reason: ParseError, code: int, at: uint) -> bool {
    return CodeOf(reason) == code && reason.Offset() == at;
}

func Main() -> int {
    // The grammar itself, at one width.
    {
        let value = ParseInt64("42") catch { _ => return 2 };
        if value != 42 { return 1; }
    }
    {
        let value = ParseInt64("-42") catch { _ => return 4 };
        if value != -42i64 { return 3; }
    }
    {
        let value = ParseInt64("+42") catch { _ => return 6 };
        if value != 42 { return 5; }
    }
    {
        let value = ParseUint64("0xff") catch { _ => return 8 };
        if value != 255 { return 7; }
    }
    {
        let value = ParseUint64("0b101") catch { _ => return 10 };
        if value != 5 { return 9; }
    }
    {
        let value = ParseUint64("0o10") catch { _ => return 12 };
        if value != 8 { return 11; }
    }
    {
        let value = ParseInt64("-0x10") catch { _ => return 14 };
        if value != -16i64 { return 13; }
    }

    // What is refused, and why.
    if (ParseInt64("") !! none) != none { return 20; }
    if (ParseInt64("12a") !! none) != none { return 21; }
    if (ParseInt64("-") !! none) != none { return 22; }
    if (ParseInt64("0x") !! none) != none { return 23; }
    if (ParseUint64("-1") !! none) != none { return 24; }
    if (ParseUint64("0xG") !! none) != none { return 25; }
    if (ParseUint64("0b2") !! none) != none { return 26; }

    // The bounds, narrow and wide: the largest in, one past it out.
    {
        let value = ParseInt8("127") catch { _ => return 31 };
        if value != 127 { return 30; }
    }
    if (ParseInt8("128") !! none) != none { return 32; }
    {
        let value = ParseInt8("-128") catch { _ => return 34 };
        if value != -128i8 { return 33; }
    }
    if (ParseInt8("-129") !! none) != none { return 35; }
    {
        let value = ParseUint8("255") catch { _ => return 37 };
        if value != 255 { return 36; }
    }
    if (ParseUint8("256") !! none) != none { return 38; }

    {
        let value = ParseUint128("340282366920938463463374607431768211455") catch { _ => return 41 };
        if (value % 10) != 5 { return 40; }
    }
    if (ParseUint128("340282366920938463463374607431768211456") !! none) != none { return 42; }
    {
        let value = ParseInt128("-170141183460469231731687303715884105728") catch { _ => return 44 };
        if value >= 0 { return 43; }
    }
    if (ParseInt128("170141183460469231731687303715884105728") !! none) != none { return 45; }

    // The widest width takes its largest value, and one more digit is an overflow rather than a wrap.
    if (ParseUint512("13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095") !! none) == none { return 50; }
    if (ParseUint512("13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096") !! none) != none { return 51; }

    // Booleans are the two words and nothing else.
    {
        let value = ParseBool("true") catch { _ => return 61 };
        if !value { return 60; }
    }
    {
        let value = ParseBool("false") catch { _ => return 63 };
        if value { return 62; }
    }
    if (ParseBool("True") !! none) != none { return 64; }
    if (ParseBool("1") !! none) != none { return 65; }
    if (ParseBool("") !! none) != none { return 66; }

    // A character is one whole scalar value.
    {
        let value = ParseChar("A") catch { _ => return 71 };
        if (value as uint32) != 0x41 { return 70; }
    }
    {
        let value = ParseChar("€") catch { _ => return 73 };
        if (value as uint32) != 0x20AC { return 72; }
    }
    if (ParseChar("ab") !! none) != none { return 74; }
    if (ParseChar("") !! none) != none { return 75; }

    // Floats: the special spellings formatting writes, the exponent's edges, and the narrower width's bound.
    {
        let value = ParseFloat64("NaN") catch { _ => return 81 };
        if !IsNan(value) { return 80; }
    }
    {
        let value = ParseFloat64("Inf") catch { _ => return 83 };
        if !IsInfinite(value) || value < 0.0 { return 82; }
    }
    {
        let value = ParseFloat64("-Inf") catch { _ => return 85 };
        if !IsInfinite(value) || value > 0.0 { return 84; }
    }
    if (ParseFloat64("Infinity") !! none) != none { return 86; }

    {
        let value = ParseFloat64("1.5e300") catch { _ => return 88 };
        if value < 1.0e300 { return 87; }
    }
    if (ParseFloat64("1e400") !! none) != none { return 89; }
    {
        let value = ParseFloat64("1e-400") catch { _ => return 91 };
        if value != 0.0 { return 90; }
    }

    {
        let value = ParseFloat32("2.5") catch { _ => return 93 };
        if value != 2.5f32 { return 92; }
    }
    // A value a float64 holds and a float32 does not is the narrow width's overflow, not a quiet infinity.
    if (ParseFloat32("1e39") !! none) != none { return 94; }
    {
        let value = ParseFloat32("1e-39") catch { _ => return 96 };
        if value <= 0.0f32 { return 95; }
    }
    {
        let value = ParseFloat32("-Inf") catch { _ => return 98 };
        if value > -3.0e38f32 { return 97; }
    }

    // Text parses by the same grammar, through the overloads that take a string rather than raw bytes.
    {
        let value = ParseInt64("-42") catch { _ => return 101 };
        if value != -42i64 { return 100; }
    }
    {
        let value = ParseUint64("0xff") catch { _ => return 103 };
        if value != 255 { return 102; }
    }
    {
        let value = ParseFloat64("2.5") catch { _ => return 105 };
        if value != 2.5 { return 104; }
    }
    {
        let value = ParseBool("true") catch { _ => return 107 };
        if !value { return 106; }
    }
    {
        let value = ParseChar("\u{20AC}") catch { _ => return 109 };
        if value as uint32 != 0x20AC { return 108; }
    }
    if (ParseInt64("nope") !! none) != none { return 110; }

    // Where each refusal happened. An empty text has one position and it is zero, which is also its length.
    match ParseInt64("") {
        .Success(_) => {
            Assert(false, "an empty text is Empty at zero");
        },
        .Failure(refusal) => Assert(FailedAt(refusal, 1, 0), "an empty text is Empty at zero"),
    }
    match ParseInt64("12a") {
        .Success(_) => {
            Assert(false, "a byte that is not a digit is reported at that byte");
        },
        .Failure(refusal) => Assert(FailedAt(refusal, 2, 2), "a byte that is not a digit is reported at that byte"),
    }
    match ParseInt64("-") {
        .Success(_) => {
            Assert(false, "a sign with nothing after it points at the sign");
        },
        .Failure(refusal) => Assert(FailedAt(refusal, 2, 0), "a sign with nothing after it points at the sign"),
    }
    match ParseInt64("0x") {
        .Success(_) => {
            Assert(false, "and a prefix with no digits points at its mark");
        },
        .Failure(refusal) => Assert(FailedAt(refusal, 2, 1), "and a prefix with no digits points at its mark"),
    }
    match ParseInt64("1 2") {
        .Success(_) => {
            Assert(false, "a space inside a number is reported where it stands");
        },
        .Failure(refusal) => Assert(FailedAt(refusal, 2, 1), "a space inside a number is reported where it stands"),
    }
    match ParseInt64("0b102") {
        .Success(_) => {
            Assert(false, "and a digit outside the base is reported at itself");
        },
        .Failure(refusal) => Assert(FailedAt(refusal, 2, 4), "and a digit outside the base is reported at itself"),
    }

    // The width bound: the whole number is what does not fit, so the offset is its end.
    match ParseInt8("128") {
        .Success(_) => {
            Assert(false, "one past the signed maximum overflows at the end of the number");
        },
        .Failure(refusal) => {
            Assert(FailedAt8(refusal, 3, 3), "one past the signed maximum overflows at the end of the number");
        },
    }
    match ParseInt8("-129") {
        .Success(_) => {
            Assert(false, "and one past the signed minimum, whose sign is part of the length");
        },
        .Failure(refusal) => Assert(FailedAt8(refusal, 3, 4),
                          "and one past the signed minimum, whose sign is part of the length"),
    }
    match ParseUint8("256") {
        .Success(_) => {
            Assert(false, "the unsigned maximum likewise");
        },
        .Failure(refusal) => Assert(FailedAtU8(refusal, 3, 3), "the unsigned maximum likewise"),
    }
    match ParseUint8("-1") {
        .Success(_) => {
            Assert(false, "while a sign on an unsigned width is a character, not an overflow");
        },
        .Failure(refusal) => Assert(FailedAtU8(refusal, 2, 0),
                          "while a sign on an unsigned width is a character, not an overflow"),
    }

    // Past what the widest integer holds, where the digit that did it is the offset rather than the end.
    match ParseUint512("99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999") {
        .Success(_) => {
            Assert(false,
               "a number past the widest magnitude points at the digit that passed it");
        },
        .Failure(refusal) => Assert(FailedAtU512(refusal, 3, 154),
            "a number past the widest magnitude points at the digit that passed it"),
    }

    // The two values whose text is a word or a character.
    match ParseBool("") {
        .Success(_) => {
            Assert(false, "an empty boolean is Empty");
        },
        .Failure(refusal) => Assert(FailedAtBool(refusal, 1, 0), "an empty boolean is Empty"),
    }
    match ParseBool("yes") {
        .Success(_) => {
            Assert(false, "and a word that is not one of the two is reported at its start");
        },
        .Failure(refusal) => Assert(FailedAtBool(refusal, 2, 0),
                          "and a word that is not one of the two is reported at its start"),
    }
    match ParseBool("truex") {
        .Success(_) => {
            Assert(false, "including a correct word with something after it");
        },
        .Failure(refusal) => Assert(FailedAtBool(refusal, 2, 0), "including a correct word with something after it"),
    }
    match ParseChar("") {
        .Success(_) => {
            Assert(false, "an empty character is Empty");
        },
        .Failure(refusal) => Assert(FailedAtChar(refusal, 1, 0), "an empty character is Empty"),
    }
    match ParseChar("ab") {
        .Success(_) => {
            Assert(false, "and a second character is reported at itself");
        },
        .Failure(refusal) => Assert(FailedAtChar(refusal, 2, 1), "and a second character is reported at itself"),
    }

    // Floats, where an exponent past the format is the number failing rather than a byte.
    match ParseFloat64("") {
        .Success(_) => {
            Assert(false, "an empty float is Empty");
        },
        .Failure(refusal) => Assert(FailedAtFloat(refusal, 1, 0), "an empty float is Empty"),
    }
    match ParseFloat64("1.2.3") {
        .Success(_) => {
            Assert(false, "a second point is reported where it stands");
        },
        .Failure(refusal) => Assert(FailedAtFloat(refusal, 2, 3), "a second point is reported where it stands"),
    }
    match ParseFloat64("1e999") {
        .Success(_) => {
            Assert(false, "and an exponent past the format overflows at the end");
        },
        .Failure(refusal) => {
            Assert(FailedAtFloat(refusal, 3, 5), "and an exponent past the format overflows at the end");
        },
    }

    return 0;
}
