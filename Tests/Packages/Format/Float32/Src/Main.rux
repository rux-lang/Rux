import Core::{ MutableSlice, Slice };
import Format::{ ByteCursor, FormatSpec, Display, IsFinite, IsInfinite, IsNan, TextWriter };

// Std is deliberately absent from the dependencies: it exports conversions of the same name, and the compiler pools
// the overloads of two same-named symbols, so Std's would win over this package's and the code under test would
// never run. That rules out Std::Assert, so a failed check reports itself through the exit code instead: each one
// below is numbered, and `rux test` prints the number of the first that fails.
//
// Rendering goes into a buffer on the stack rather than into a string, which is what the writer-based contract
// buys: this test needs no allocator at all.
func Check(value: float32, expected: Slice<char8>, code: int) -> int {
    var storage: char8[64];
    var cursor = ByteCursor(MutableSlice::From<char8>(@storage[0], 64));
    let sink: &var TextWriter = cursor;
    let writer: &var TextWriter = sink;
    let shown: Display = value;
    if shown.Format(writer, FormatSpec::Plain()).IsError() {
        return code;
    }
    let actual = cursor.Written();
    if actual.length != expected.length {
        return code;
    }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] {
            return code;
        }
        index = index + 1;
    }
    return 0;
}

func Main() -> int {
    var code = Check(0.0f32, "0.0", 10);
    if code != 0 { return code; }
    code = Check(1.0f32, "1.0", 11);
    if code != 0 { return code; }
    code = Check(-2.25f32, "-2.25", 12);
    if code != 0 { return code; }

    // The point of the seven digit cutoff: a float32 widens to the float64 that
    // holds its full binary value, and 0.1f is really 0.100000001490116119, so
    // printing it to the fifteen digits a float64 earns would print noise this
    // value never carried.
    code = Check(0.1f32, "0.1", 20);
    if code != 0 { return code; }
    code = Check(0.2f32, "0.2", 21);
    if code != 0 { return code; }
    code = Check(1.0f32 / 3.0f32, "0.3333333", 22);
    if code != 0 { return code; }

    // Scientific notation takes over at an exponent of 7, where the digits run
    // out, and below -4.
    code = Check(1000000.0f32, "1000000.0", 30);
    if code != 0 { return code; }
    code = Check(10000000.0f32, "1.0e+07", 31);
    if code != 0 { return code; }
    code = Check(0.0001f32, "0.0001", 32);
    if code != 0 { return code; }
    code = Check(0.00001f32, "1.0e-05", 33);
    if code != 0 { return code; }

    // The ends of the float32 range: the largest finite value and the smallest
    // normal one.
    code = Check(3.4028235e38f32, "3.402823e+38", 40);
    if code != 0 { return code; }
    code = Check(1.1754944e-38f32, "1.175494e-38", 41);
    if code != 0 { return code; }

    // Values that are not numbers at all. The classification is by float32
    // overload, so an infinity of this width is recognised as one rather than
    // being measured against the float64 range and found finite.
    let nan = 0.0f32 / 0.0f32;
    let inf = 1.0f32 / 0.0f32;
    code = Check(nan, "NaN", 50);
    if code != 0 { return code; }
    code = Check(inf, "Inf", 51);
    if code != 0 { return code; }
    code = Check(-inf, "-Inf", 52);
    if code != 0 { return code; }

    if !IsNan(nan) { return 60; }
    if IsNan(1.0f32) { return 61; }
    if !IsInfinite(inf) { return 62; }
    if IsInfinite(nan) { return 63; }
    if IsFinite(inf) { return 64; }
    if !IsFinite(3.4028235e38f32) { return 65; }
    // Reached through the interface rather than through the concrete type, which is how a format call reaches it.
    let code70 = Check(2.5f32, "2.5", 70);
    if code70 != 0 { return code70; }

    return 0;
}
