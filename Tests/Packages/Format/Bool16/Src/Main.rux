

import Text::{ Display, FormatSpec, TextWriter };
import Format::{ ByteCursor };

// A failed check returns its numbered exit code for `rux test`.
//
// Rendering goes into a buffer on the stack rather than into a string, which is what the writer-based contract
// buys: this test needs no allocator at all.
func Check(value: bool16, expected: char8[..], code: int) -> int {
    var storage: char8[64];
    var cursor = ByteCursor((@storage[0])[..64]);
    let writer: &var TextWriter = cursor;
    let shown: Display = value;
    if shown.WriteDisplay(writer, FormatSpec::Plain()).IsError() {
        return code;
    }
    let actual = cursor.Written();
    if actual.length != expected.length {
        return code;
    }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] {
            return code;
        }
        index = index + 1;
    }
    return 0;
}

func Main() -> int {
    // The wider bools say exactly what bool8 says: what differs between them is
    // how much room they take, not what they can mean.
    let yes: bool16 = true;
    let no: bool16 = false;

    var code = Check(yes, "true", 10);
    if code != 0 { return code; }
    code = Check(no, "false", 11);
    if code != 0 { return code; }
    code = Check(no, "false", 21);
    if code != 0 { return code; }

    return 0;
}
