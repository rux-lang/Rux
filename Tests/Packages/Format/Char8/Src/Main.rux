

import Text::{ Display, FormatSpec, TextWriter };
import Format::{ ByteCursor };

// A failed check returns its numbered exit code for `rux test`.
func Check(value: char8, expected: char8[..], code: int) -> int {
    var storage: char8[8];
    var cursor = ByteCursor(storage[..8]);
    let writer: &var TextWriter = cursor;
    let shown: Display = value;
    if (try? shown.WriteDisplay(writer, FormatSpec::Plain())) is none {
        return code;
    }
    let actual = cursor.Written();
    if actual.length != expected.length {
        return code;
    }
    var index: uint = 0;
    while index < actual.length {
        if actual[index] != expected[index] {
            return code;
        }
        index = index + 1;
    }
    return 0;
}

func Main() -> int {
    // A char8 is one byte of UTF-8, not one character. Nothing is encoded and
    // nothing is validated: the byte is passed through as it stands, and the
    // String that comes back is one byte long whatever the byte happens to be.
    var code = Check(c8'A', "A", 10);
    if code != 0 { return code; }
    code = Check(c8'z', "z", 11);
    if code != 0 { return code; }
    code = Check(c8'0', "0", 12);
    if code != 0 { return code; }
    code = Check(c8' ', " ", 13);
    if code != 0 { return code; }
    code = Check(c8'\n', "\n", 14);
    if code != 0 { return code; }

    // The null character is a byte like any other, and what it renders into is one byte long rather than nothing:
    // text carries its length and does not look for a terminator.
    var storage: char8[8];
    var cursor = ByteCursor(storage[..8]);
    let writer: &var TextWriter = cursor;
    let nul: Display = c8'\0';
    if (try? nul.WriteDisplay(writer, FormatSpec::Plain())) is none { return 20; }
    if cursor.Written().length != 1 { return 21; }
    if (cursor.Written()[0] as uint8) != 0 { return 22; }

    // A byte out of the middle of a multi-byte sequence is not a character, and a writer takes whole characters --
    // so what comes out is the replacement character rather than the fragment. Writing the byte on its own would
    // produce something that is not UTF-8, and every reader of the result relies on it being UTF-8.
    var second: char8[8];
    var piece = ByteCursor(second[..8]);
    let fragmentWriter: &var TextWriter = piece;
    let fragment: Display = 0xC3u8 as char8;
    if (try? fragment.WriteDisplay(fragmentWriter, FormatSpec::Plain())) is none { return 30; }
    let rendered = piece.Written();
    if rendered.length != 3 { return 31; }
    if (rendered[0] as uint8) != 0xEF { return 32; }
    if (rendered[1] as uint8) != 0xBF { return 33; }
    if (rendered[2] as uint8) != 0xBD { return 34; }

    return 0;
}
