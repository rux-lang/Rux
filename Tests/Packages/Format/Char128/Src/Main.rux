import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Failed, Panic, Succeeded };
import Format::Render;
import Text::{ BufferWriter, Debug, Display, FormatError, FormatSpec, ParseFormatSpec, String, StringView };

// A `char128` holds one Unicode scalar value in sixteen bytes, and renders exactly as a `char64` of the same value.
// The width adds a second machine word that no character ever uses. A value with a bit set there is no character,
// whatever its low word spells, so `Display` refuses it before narrowing and `Debug` writes every bit of it: the
// escape keeps its doubling steps and grows from sixteen hex digits to thirty-two.
// Every case renders twice, once through a constrained borrowed receiver and once through the interface, and
// `Display` is reached a third way through `Render`'s variadic arguments.

// Reinterpret malformed raw storage to test presentation independently of checked character casts.
func AsChar128(value: uint128) -> char128 {
    return *((@value) as *char128);
}

func Same(actual: char8[..], expected: char8[..]) -> bool {
    if actual.length != expected.length { return false; }
    var index: uint = 0;
    while index < actual.length {
        if actual[index] != expected[index] { return false; }
        index += 1;
    }
    return true;
}

func Spec(text: char8[..]) -> FormatSpec {
    var spec = FormatSpec::Plain();
    spec = ParseFormatSpec(text) catch { else => Panic("the test's specification is valid") };
    return spec;
}

// Renders `value` under `spec` through a constrained receiver and through the interface, and checks both.
func Shown<T: Display>(value: &T, spec: FormatSpec, expected: char8[..]) {
    var storage: char8[192];
    var writer = BufferWriter((@storage[0])[..192]);
    Assert(Succeeded(value.WriteDisplay(writer, spec)), "a constrained receiver renders");
    Assert(Same(writer.Written(), expected), expected);
    writer.Clear();
    let shown: &Display = value;
    Assert(Succeeded(shown.WriteDisplay(writer, spec)), "an interface receiver renders");
    Assert(Same(writer.Written(), expected), expected);
}

// The `Debug` counterpart of `Shown`.
func Inspected<T: Debug>(value: &T, expected: char8[..]) {
    var storage: char8[192];
    var writer = BufferWriter((@storage[0])[..192]);
    Assert(Succeeded(value.WriteDebug(writer, FormatSpec::Plain())), "a constrained debug receiver renders");
    Assert(Same(writer.Written(), expected), expected);
    writer.Clear();
    let shown: &Debug = value;
    Assert(Succeeded(shown.WriteDebug(writer, FormatSpec::Plain())), "an interface debug receiver renders");
    Assert(Same(writer.Written(), expected), expected);
}

// Whether `Display` refuses `spec` rather than rendering under it.
func Refused<T: Display>(value: &T, spec: FormatSpec) -> bool {
    var storage: char8[16];
    var writer = BufferWriter((@storage[0])[..16]);
    return Failed(value.WriteDisplay(writer, spec));
}

// Whether the outcome is exactly `expected`. Consuming the result is what forces a failure to be visible.
func Rendered(outcome: String ! FormatError, expected: char8[..]) -> bool {
    let wanted = StringView::FromValidated(expected);
    return match <-outcome {
        .Success(text) => text.View().Equals(wanted),
        .Failure(_) => false
    };
}

func Main() -> int {
    let plain = FormatSpec::Plain();

    // Valid scalars at every UTF-8 length, one to four bytes, and the last scalar there is.
    let letter = c128'A';
    Shown<char128>(letter, plain, "A");
    Inspected<char128>(letter, "'A'");
    let accented = c128'é';
    Shown<char128>(accented, plain, "é");
    Inspected<char128>(accented, "'é'");
    let euro = c128'€';
    Shown<char128>(euro, plain, "€");
    Inspected<char128>(euro, "'€'");
    let face = c128'😀';
    Shown<char128>(face, plain, "😀");
    Inspected<char128>(face, "'😀'");
    let last = c128'\u{10FFFF}';
    Shown<char128>(last, plain, "\u{10FFFF}");
    Inspected<char128>(last, "'\u{10FFFF}'");

    // Debug escapes the quote, the backslash and the controls, as it does everywhere else; Display writes them
    // as they are.
    let newline = c128'\n';
    Shown<char128>(newline, plain, "\n");
    Inspected<char128>(newline, "'\\n'");
    let quote = c128'\'';
    Shown<char128>(quote, plain, "'");
    Inspected<char128>(quote, "'\\''");
    let backslash = c128'\\';
    Shown<char128>(backslash, plain, "\\");
    Inspected<char128>(backslash, "'\\\\'");
    let zero = c128'\0';
    Inspected<char128>(zero, "'\\0'");
    let control = AsChar128(0x01u128);
    Inspected<char128>(control, "'\\x{01}'");
    let c1 = AsChar128(0x85u128);
    Inspected<char128>(c1, "'\\x{85}'");

    // A width counts characters rather than bytes, and the fill and alignment are the ones every value takes.
    Shown<char128>(letter, Spec(">3"), "  A");
    Shown<char128>(letter, Spec("<3"), "A  ");
    Shown<char128>(letter, Spec("^5"), "  A  ");
    Shown<char128>(letter, Spec("*^5"), "**A**");
    Shown<char128>(face, Spec(">3"), "  😀");
    Shown<char128>(face, Spec("1"), "😀");
    // A character has no second form, so a style is refused rather than ignored.
    Assert(Refused<char128>(letter, Spec("x")), "a character refuses a base");
    Assert(Refused<char128>(letter, Spec("e")), "and any other style");

    // Through Render, as an ordinary variadic argument.
    var system = SystemAllocator();
    let allocator: Allocator = system;
    Assert(Rendered(Render(allocator, "[{}]", letter), "[A]"), "a char128 is a Render argument");
    Assert(Rendered(Render(allocator, "{:>4}|{}", face, accented), "   😀|é"), "padded, beside another");

    // Values below 2^64 that are not characters render as a char64 of the same number does: the replacement
    // under Display, and the number itself under Debug.
    let surrogate = AsChar128(0xD800u128);
    Shown<char128>(surrogate, plain, "\u{FFFD}");
    Inspected<char128>(surrogate, "'\\u{d800}'");
    let lowSurrogate = AsChar128(0xDFFFu128);
    Shown<char128>(lowSurrogate, plain, "\u{FFFD}");
    Inspected<char128>(lowSurrogate, "'\\u{dfff}'");
    let past = AsChar128(0x110000u128);
    Shown<char128>(past, plain, "\u{FFFD}");
    Inspected<char128>(past, "'\\u{00110000}'");
    let disguised = AsChar128(0x100000041u128);
    Shown<char128>(disguised, plain, "\u{FFFD}");
    Inspected<char128>(disguised, "'\\u{0000000100000041}'");
    let top64 = AsChar128(0xFFFFFFFFFFFFFFFFu128);
    Shown<char128>(top64, plain, "\u{FFFD}");
    Inspected<char128>(top64, "'\\u{ffffffffffffffff}'");
    Shown<char128>(disguised, Spec(">2"), " \u{FFFD}");

    // Values with a bit above the sixty-fourth. Each is refused under Display however good a character its
    // low word spells, and Debug spells every bit, in as many digits as the highest set bit needs.
    let word1 = AsChar128((1u128 << 64) | 0x41u128);
    Shown<char128>(word1, plain, "\u{FFFD}");
    Inspected<char128>(word1, "'\\u{00000000000000010000000000000041}'");
    let word1Face = AsChar128((1u128 << 100) | 0x1F600u128);
    Shown<char128>(word1Face, plain, "\u{FFFD}");
    Inspected<char128>(word1Face, "'\\u{0000001000000000000000000001f600}'");
    let top128 = AsChar128(1u128 << 127);
    Shown<char128>(top128, plain, "\u{FFFD}");
    Inspected<char128>(top128, "'\\u{80000000000000000000000000000000}'");
    let all128 = AsChar128(0u128 - 1u128);
    Shown<char128>(all128, plain, "\u{FFFD}");
    Inspected<char128>(all128, "'\\u{ffffffffffffffffffffffffffffffff}'");
    Shown<char128>(word1, Spec("*<3"), "\u{FFFD}**");

    return 0;
}
