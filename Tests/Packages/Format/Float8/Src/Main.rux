import Core::Failed;


import Text::{ Debug, Display, FormatSpec, TextWriter };
import Format::{ BitsOfFloat8, ByteCursor, IsFinite, IsInfinite, IsNan, WriteFormat };

// Every float8 is rendered and held to the table Tools/FloatVectors wrote for it: the shortest decimal that reads
// back as the same float8, at this width's own neighbours. A failed check returns its numbered exit code for
// `rux test`. Rendering goes into a buffer on the stack, so the test needs no allocator.

func Same(actual: char8[..], expected: char8[..]) -> bool {
    if actual.length != expected.length {
        return false;
    }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// The float8 a bit pattern encodes, read through a pointer as Format reads the other way.
func FromBits(bits: uint8) -> float8 {
    let address = (@bits) as *float8;
    return *address;
}

// Whether the value's `Display` text is `expected`, with `prefix` in front of it.
func Shows(value: float8, prefix: char8[..], expected: char8[..]) -> bool {
    var storage: char8[64];
    var cursor = ByteCursor((@storage[0])[..64]);
    let writer: &var TextWriter = cursor;
    let shown: Display = value;
    if Failed(shown.WriteDisplay(writer, FormatSpec::Plain())) {
        return false;
    }
    let actual = cursor.Written();
    return actual.length >= prefix.length && Same(actual[..prefix.length], prefix) &&
           Same(actual[prefix.length..], expected);
}

// Whether `format` applied to the value writes `expected`.
func Formats(format: char8[..], value: float8, expected: char8[..]) -> bool {
    var storage: char8[64];
    var cursor = ByteCursor((@storage[0])[..64]);
    let writer: &var TextWriter = cursor;
    if Failed(WriteFormat(writer, format, value)) {
        return false;
    }
    return Same(cursor.Written(), expected);
}

// Walks the whole table: each non-negative pattern up to the infinity against its text, the same pattern with the
// sign bit set against the text with a minus sign, and every pattern past the infinity, of either sign, as a NaN.
func CheckTable() -> int {
    var bits: uint = 0;
    var chunk: uint = 0;
    while bits < TextCount8() {
        let texts = TextChunk8(chunk);
        if texts.length == 0 { return 10; }
        var start: uint = 0;
        while start < texts.length {
            var end = start;
            while end < texts.length && texts.data[end] != c8' ' {
                end = end + 1;
            }
            let expected = texts[start..end];
            let pattern = bits as uint8;
            if !Shows(FromBits(pattern), "", expected) { return 11; }
            if !Shows(FromBits(pattern | 0x80), "-", expected) { return 12; }
            bits = bits + 1;
            start = end + 1;
        }
        chunk = chunk + 1;
    }
    if bits != 0x79 { return 13; }
    while bits < 0x80 {
        let pattern = bits as uint8;
        if !Shows(FromBits(pattern), "", "NaN") { return 14; }
        if !Shows(FromBits(pattern | 0x80), "", "NaN") { return 15; }
        if !IsNan(FromBits(pattern)) || IsFinite(FromBits(pattern)) || IsInfinite(FromBits(pattern)) { return 16; }
        bits = bits + 1;
    }
    return 0;
}

// A run-time value, so the arithmetic below is done by the software helpers rather than folded.
func Pass(value: float8) -> float8 {
    return value;
}

func Main() -> int {
    let code = CheckTable();
    if code != 0 { return code; }

    // The digits are this width's shortest, not the float32 or float64 the value widens to: 0.1 is stored as
    // 0.1015625, and nothing shorter than "0.1" is closer to it than to a neighbour.
    if !Shows(0.1f8, "", "0.1") { return 20; }
    if !Shows(Pass(1.0f8) / Pass(3.0f8), "", "0.34") { return 21; }
    if !Shows(Pass(0.1f8) + Pass(0.2f8), "", "0.3") { return 22; }
    if !Shows(-2.25f8, "", "-2.2") { return 23; }
    if !Shows(-0.0f8, "", "-0.0") { return 24; }
    if BitsOfFloat8(0.1f8) != 0x1D { return 25; }

    // The ends of the range: the largest value, the smallest normal and the smallest subnormal, all in fixed
    // notation, since no float8 reaches the three digits that would switch to scientific.
    if !Shows(240.0f8, "", "240.0") { return 30; }
    if !Shows(0.015625f8, "", "0.016") { return 31; }
    if !Shows(0.001953125f8, "", "0.002") { return 32; }
    if !Shows(Pass(240.0f8) * Pass(2.0f8), "", "Inf") { return 33; }

    // The placeholder's precision, style, sign and width reach the same writers as the wider widths.
    if !Formats("{:.3}", 0.1f8, "0.102") { return 40; }
    if !Formats("{:.7}", 0.1f8, "0.1015625") { return 41; }
    if !Formats("{:e}", 240.0f8, "2.4e+02") { return 42; }
    if !Formats("{:.1E}", 1.5f8, "1.5E+00") { return 43; }
    if !Formats("{:+}", 1.5f8, "+1.5") { return 44; }
    if !Formats("{:>6}", 1.5f8, "   1.5") { return 45; }
    if !Formats("{:.2}", Pass(1.0f8) / Pass(0.0f8), "Inf") { return 46; }
    if !Formats("{:e}", Pass(-1.0f8) / Pass(0.0f8), "-Inf") { return 47; }
    if !Formats("{}", Pass(0.0f8) / Pass(0.0f8), "NaN") { return 48; }

    // Debug is the same text.
    var storage: char8[64];
    var cursor = ByteCursor((@storage[0])[..64]);
    let writer: &var TextWriter = cursor;
    let debugged: Debug = 0.34375f8;
    if Failed(debugged.WriteDebug(writer, FormatSpec::Plain())) { return 50; }
    if !Same(cursor.Written(), "0.34") { return 51; }

    // Classification by the bits, so an infinity of this width is recognised as one.
    let inf = Pass(1.0f8) / Pass(0.0f8);
    let nan = Pass(0.0f8) / Pass(0.0f8);
    if !IsInfinite(inf) || !IsInfinite(-inf) || IsFinite(inf) || IsNan(inf) { return 60; }
    if !IsNan(nan) || IsFinite(nan) || IsInfinite(nan) { return 61; }
    if !IsFinite(240.0f8) || IsInfinite(240.0f8) || IsNan(240.0f8) { return 62; }
    if !IsFinite(-0.0f8) { return 63; }

    return 0;
}
