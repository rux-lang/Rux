import Text::{ Display, FormatSpec, TextWriter };
import Core::{ Succeeded, int64 };
import Text::StringView;
import Format::{ ByteCursor, ParseError, ParseInt64 };
import Core::Failed;


// A failed check returns its numbered exit code for `rux test`.
func Check(value: int64, expected: char8[..], code: int) -> int {
    var storage: char8[64];
    var cursor = ByteCursor((@storage[0])[..64]);
    let writer: &var TextWriter = cursor;
    let shown: Display = value;
    if Failed(shown.WriteDisplay(writer, FormatSpec::Plain())) {
        return code;
    }
    let actual = cursor.Written();
    if actual.length != expected.length {
        return code;
    }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] {
            return code;
        }
        index = index + 1;
    }
    return 0;
}

func CheckParse(str: char8[..], expected: int64, code: int) -> int {
    let result = ParseInt64(str);
    return match result {
        .Success(value) => value == expected ? 0 : code,
        .Failure(_) => code
    };
}

func CheckParseError(str: char8[..], expected: ParseError, code: int) -> int {
    let result = ParseInt64(str);
    return match result {
        .Success(_) => code,
        .Failure(error) => error == expected ? 0 : code
    };
}

func CheckParsedValues() -> int {
    var code = CheckParse("0", 0, 100);
    if code != 0 { return code; }
    code = CheckParse("+42", 42, 101);
    if code != 0 { return code; }
    code = CheckParse("-42", -42, 102);
    if code != 0 { return code; }
    code = CheckParse("00017", 17, 103);
    if code != 0 { return code; }
    code = CheckParse("9223372036854775807", int64::Max, 104);
    if code != 0 { return code; }
    return CheckParse("-9223372036854775808", int64::Min, 105);
}

func CheckParseErrors() -> int {
    var code = CheckParseError("", ParseError::Empty, 110);
    if code != 0 { return code; }
    code = CheckParseError("12x", ParseError::InvalidCharacter(2), 111);
    if code != 0 { return code; }
    code = CheckParseError("-", ParseError::InvalidCharacter(0), 112);
    if code != 0 { return code; }
    code = CheckParseError("9223372036854775808", ParseError::Overflow(19), 113);
    if code != 0 { return code; }
    return CheckParseError("-9223372036854775809", ParseError::Overflow(20), 114);
}

func CheckParseOverloads() -> int {
    var text = StringView::FromBytes("-123") ?? StringView();
    let parsed = ParseInt64(text);
    let code = match parsed {
        .Success(value) => value == -123i64 ? 0 : 120,
        .Failure(_) => 120
    };
    if code != 0 { return code; }

    // The bool-and-output-slot overload is gone: a caller reads the Result, which cannot be ignored the way a
    // returned bool could and carries why as well as whether.
    var value: int64 = 9;
    match ParseInt64("456") {
        .Success(parsedValue) => { value = parsedValue; },
        .Failure(_) => { return 121; }
    }
    if value != 456 { return 122; }
    if Succeeded(ParseInt64("invalid")) { return 123; }
    if value != 456 { return 124; }

    text = StringView::FromBytes("-789") ?? StringView();
    match ParseInt64(text) {
        .Success(parsedView) => { value = parsedView; },
        .Failure(_) => { return 126; }
    }
    if value != -789i64 { return 127; }

    text = StringView::FromBytes("bad") ?? StringView();
    if Succeeded(ParseInt64(text)) { return 128; }
    if value != -789i64 { return 129; }
    return 0;
}

func CheckParsing() -> int {
    let code = CheckParsedValues();
    if code != 0 { return code; }
    let errorCode = CheckParseErrors();
    if errorCode != 0 { return errorCode; }
    return CheckParseOverloads();
}

func Main() -> int {
    let zero: int64 = 0;
    var code = Check(zero, "0", 10);
    if code != 0 { return code; }

    let negative: int64 = -9876543210;
    code = Check(negative, "-9876543210", 11);
    if code != 0 { return code; }

    let positive: int64 = 9876543210;
    code = Check(positive, "9876543210", 12);
    if code != 0 { return code; }

    // int64 is the type every signed conversion widens to, so its ends are the
    // ones the digit loop is really sized for. The most negative value is the
    // reason the magnitude is taken in uint64: negating it within int64 would
    // overflow straight back to itself.
    let min: int64 = -9223372036854775807 - 1;
    let max: int64 = 9223372036854775807;
    code = Check(min, "-9223372036854775808", 20);
    if code != 0 { return code; }
    code = Check(max, "9223372036854775807", 21);
    if code != 0 { return code; }

    // The method the Stringable extension provides.
    code = Check(max, "9223372036854775807", 30);
    if code != 0 { return code; }

    code = CheckParsing();
    if code != 0 { return code; }

    return 0;
}
