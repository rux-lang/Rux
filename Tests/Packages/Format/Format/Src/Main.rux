import Allocator::{ AllocError, Allocator, Layout, SystemAllocator };
import Core::{ Assert, Result };
import Format::{ Render, WriteFormat };
import Text::{ BufferWriter, Display, FormatError, FormatSpec, String, StringView, TextWriter, WriteAscii, WriteBytes };

// Placeholder filling, and what it refuses.
// The grammar is four shapes: `{}`, `{:spec}`, `{{` and `}}`. Everything else containing a brace is a mistake in
// the pattern, and this file's job is mostly the mistakes. Two of them used to be printed rather than reported — a
// placeholder with no argument left rendered as nothing, and a specification that did not parse was copied through
// as literal text — and both are now failures that carry where. Printing a mistake is the worst way to report one:
// the program carries on, the output is wrong in a way that looks deliberate, and the caller hears about it from a
// reader.
// The offsets are the half that fails quietly, so every refusal below names the exact byte, and the specification
// cases are written so that the offset inside the specification is not the offset inside the pattern. A test that
// only checked the reason would pass with every offset set to zero.
// The counting allocator at the bottom is what checks the other promise: a failed render gives its block back. A
// leak is invisible to a test that only reads the result, because the result is an error either way.

// An allocator that forwards to the system one and counts what it hands out and takes back.
struct AllocationCounts {
    live: int;
    allocations: int;
    releases: int;
    invalidReleases: int;
}

struct CountingAllocator {
    inner: Allocator;
    counts: *var AllocationCounts;
}

extend CountingAllocator : Allocator {
    func Allocate(&self, layout: Layout) -> *var opaque throws AllocError {
        let block = try self.inner.Allocate(layout);
        // Safety: `counts` points at the test's local `AllocationCounts`, which outlives every use of this allocator.
        unsafe {
            self.counts.live += 1;
            self.counts.allocations += 1;
        }
        return block;
    }

    func Deallocate(&self, block: *var opaque, layout: Layout) throws AllocError {
        try self.inner.Deallocate(block, layout) catch {
            error => {
                // Safety: `counts` points at the test's local `AllocationCounts`, which outlives this allocator.
                unsafe { self.counts.invalidReleases += 1; }
                throw error;
            },
        };
        // Safety: `counts` points at the test's local `AllocationCounts`, which outlives every use of this allocator.
        unsafe {
            self.counts.live -= 1;
            self.counts.releases += 1;
        }
    }

    func Reallocate(&self, block: *var opaque, oldLayout: Layout, newLayout: Layout)
        -> *var opaque throws AllocError {
        return try self.inner.Reallocate(block, oldLayout, newLayout);
    }
}

// A type of this package's own, so an argument reaches the call through the interface and not through an overload.
struct Point {
    x: int32;
    y: int32;
}

extend Point : Display {
    func WriteDisplay(&self, writer: &var TextWriter, spec: FormatSpec) throws FormatError {
        try WriteAscii(writer, c8'(');
        let first: Display = self.x;
        try first.WriteDisplay(writer, FormatSpec::Plain());
        try WriteBytes(writer, ", ");
        let second: Display = self.y;
        try second.WriteDisplay(writer, FormatSpec::Plain());
        return try WriteAscii(writer, c8')');
    }
}

// A value whose rendering is long, so filling a placeholder grows the result past any up-front guess.
struct Filler {
    count: uint;
}

extend Filler : Display {
    func WriteDisplay(&self, writer: &var TextWriter, spec: FormatSpec) throws FormatError {
        var remaining = self.count;
        while remaining > 0 {
            try WriteBytes(writer, "0123456789abcdef");
            remaining = remaining - 1;
        }
        return;
    }
}

// Consumes the outcome and reports whether it succeeded with exactly `expected`. An error is never a match, so a
// check cannot pass by accident on a failed render.
func Matches(outcome: String?, expected: char8[..]) -> bool {
    let wanted = StringView::FromValidated(expected);
    return match move outcome {
        .Some(text) => text.View().Equals(wanted),
        none => false
    };
}

// Consumes the outcome and reports the rendered length, or a length no check expects when it failed.
func RenderedLength(outcome: String?) -> uint {
    return match move outcome {
        .Some(text) => text.Length(),
        none => 0
    };
}

// Consumes the outcome and reports whether it failed with `InvalidSpecification` at exactly `at`. Both halves
// matter: the reason says what kind of mistake it was, and the offset says which character to point at.
func InvalidAt(reason: FormatError, at: uint) -> bool {
    return match reason {
        .InvalidSpecification(offset) => offset == at,
        _ => false
    };
}

// A pattern the compiler cannot see as a literal. A literal passed for a `#Format` parameter has its placeholders
// counted while compiling, so a mismatch is a compile error; the run-time failure is reached through a pattern known
// only when the program runs, which is what this stands for.
func Pattern(text: char8[..]) -> char8[..] {
    return text;
}

// Consumes the outcome and reports whether it failed with `ArgumentCountMismatch(expected, supplied)`.
func MismatchOf(reason: FormatError, expected: uint, supplied: uint) -> bool {
    return match reason {
        .ArgumentCountMismatch(wanted, given) => wanted == expected && given == supplied,
        _ => false
    };
}

// A renderer that emits a prefix, then returns a positioned failure of its own.
struct RefusingValue {
    calls: *var int;
}

extend RefusingValue : Display {
    func WriteDisplay(&self, writer: &var TextWriter, spec: FormatSpec) throws FormatError {
        // Safety: `calls` points at the test's local counter, which outlives every render of this value.
        unsafe { *self.calls += 1; }
        try WriteBytes(writer, "partial");
        throw .InvalidSpecification(73);
    }
}

func InvalidUtf8(reason: FormatError) -> bool {
    return match reason {
        .TextFailure(kind) => match kind { .InvalidUtf8 => true, _ => false },
        _ => false
    };
}

func PropagationCases(allocator: Allocator) {
    var counts = AllocationCounts { live: 0, allocations: 0, releases: 0, invalidReleases: 0 };
    var counting = CountingAllocator { inner: allocator, counts: @counts };
    let counted: Allocator = counting;
    try {
        Render(counted, "é 😀 {} {:>>>}", 1, 2);
        Assert(false, "embedded specification positions count UTF-8 bytes");
    } catch {
        refusal => Assert(InvalidAt(refusal, 15), "embedded specification positions count UTF-8 bytes"),
    }
    try {
        Render(counted, Pattern("é 😀 {} {bad}"), 1, 2);
        Assert(false, "a malformed later placeholder retains its absolute byte offset");
    } catch {
        refusal => Assert(InvalidAt(refusal, 12), "a malformed later placeholder retains its absolute byte offset"),
    }
    try {
        Render(counted, "é {} tail {", 1);
        Assert(false, "an unterminated later placeholder points at its opening byte");
    } catch {
        refusal => Assert(InvalidAt(refusal, 11), "an unterminated later placeholder points at its opening byte"),
    }
    try {
        Render(counted, Pattern("é {} {} {}"), 1);
        Assert(false, "both words of argument-count failures survive Render");
    } catch {
        refusal => Assert(MismatchOf(refusal, 3, 1), "both words of argument-count failures survive Render"),
    }
    Assert(counts.live == 0 && counts.allocations == 4 && counts.releases == 4 && counts.invalidReleases == 0,
           "each validation failure releases its reserved builder once");

    var calls = 0;
    let refusing = RefusingValue { calls: @calls };
    try {
        Render(counted, "head {} tail", refusing);
        Assert(false, "a renderer failure propagates through WriteFormat and Render");
    } catch {
        refusal => Assert(InvalidAt(refusal, 73), "a renderer failure propagates through WriteFormat and Render"),
    }
    Assert(calls == 1 && counts.live == 0 && counts.allocations == 5 && counts.releases == 5,
           "a partial rendering is discarded with exactly one release");
    Assert(counts.invalidReleases == 0, "propagation does not attempt a second builder release");

    var room: char8[64];
    var writer = BufferWriter(room[..64]);
    let sink: &var TextWriter = writer;
    let failed: Result<(), FormatError> = try .Success(WriteFormat(sink, "head {} tail", refusing)) catch {
        error => .Failure(error),
    };
    Assert(failed is .Failure(_) && calls == 2 && writer.Length() == 12, "writer failure stops after the accepted prefix");
    let written = StringView::FromValidated(writer.Written());
    let wanted = StringView::FromValidated("head partial");
    Assert(written.Equals(wanted), "direct writing retains the exact bytes accepted before the refusal");
    Assert(counts.allocations == 5 && counts.releases == 5, "WriteFormat does not allocate intermediate text");

    writer.Clear();
    let checked: &var TextWriter = writer;
    Assert((try? WriteFormat(checked, "prefix {} {:>>>}", refusing, 2)) is none,
           "the whole pattern is validated first");
    Assert(calls == 2 && writer.Length() == 0, "late validation failure invokes no renderer and writes no prefix");
    Assert(Matches(try? Render(counted, "é 😀 {{}} {}", 12), "é 😀 {} 12"),
           "successful Unicode rendering preserves its output");
    Assert(counts.live == 0 && counts.allocations == 6 && counts.releases == 6 && counts.invalidReleases == 0,
           "a successful returned string releases its transferred allocation once");
    let malformed: char8[4] = [c8'o', c8'k', 0xC3u8 as char8, c8'('];
    try {
        Render(counted, malformed);
        Assert(false, "malformed literal bytes preserve the nested text failure");
    } catch {
        refusal => Assert(InvalidUtf8(refusal), "malformed literal bytes preserve the nested text failure"),
    }
    Assert(counts.live == 0 && counts.allocations == 7 && counts.releases == 7 && counts.invalidReleases == 0,
           "a malformed UTF-8 suffix releases its partially filled builder once");
    let truncated: char8[2] = [c8'x', 0xF0u8 as char8];
    try {
        Render(counted, truncated);
        Assert(false, "a truncated supplementary character is rejected");
    } catch {
        refusal => Assert(InvalidUtf8(refusal), "a truncated supplementary character is rejected"),
    }
    Assert(counts.live == 0 && counts.allocations == 8 && counts.releases == 8 && counts.invalidReleases == 0,
           "truncated UTF-8 also follows ordinary cleanup");
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    PropagationCases(allocator);

    // Text outside a placeholder is copied through, and a pattern with nothing to substitute is copied entire.
    if !Matches(try? Render(allocator, ""), "") { return 10; }
    if !Matches(try? Render(allocator, "hello"), "hello") { return 11; }

    // Each placeholder takes the next argument, in the order they are written.
    if !Matches(try? Render(allocator, "point = ({}, {})", 3, 4), "point = (3, 4)") { return 20; }
    if !Matches(try? Render(allocator, "{}{}{}", 1, 2, 3), "123") { return 21; }

    // Arguments of different types in one call, each rendered its own way.
    if !Matches(try? Render(allocator, "{} {} {} {}", 42, 0.5, true, c8'A'), "42 0.5 true A") { return 22; }

    // The argument count has to match the placeholder count exactly, in both directions, and the failure carries
    // both numbers — expected first, supplied second — because which way the mismatch runs is what a caller fixes.
    try {
        Render(allocator, Pattern("{}"), 1, 2);
        if !(false) { return 30; }
    } catch {
        refusal => { if !MismatchOf(refusal, 1, 2) { return 30; } }
    }
    try {
        Render(allocator, Pattern("[{}][{}]"), 1);
        if !(false) { return 31; }
    } catch {
        refusal => { if !MismatchOf(refusal, 2, 1) { return 31; } }
    }
    try {
        Render(allocator, Pattern("{}"));
        if !(false) { return 32; }
    } catch {
        refusal => { if !MismatchOf(refusal, 1, 0) { return 32; } }
    }
    try {
        Render(allocator, Pattern("none"), 1);
        if !(false) { return 33; }
    } catch {
        refusal => { if !MismatchOf(refusal, 0, 1) { return 33; } }
    }
    try {
        Render(allocator, Pattern("{{}} {}"), 1, 2);
        if !(false) { return 34; }
    } catch {
        refusal => { if !MismatchOf(refusal, 1, 2) { return 34; } }
    }

    // Escaped braces are the only way to write one, and a lone brace of either kind is now a refusal rather than
    // literal text. The offset is the brace itself: that is where the pattern went wrong, not where the scan
    // noticed.
    if !Matches(try? Render(allocator, "{{}}"), "{}") { return 40; }
    if !Matches(try? Render(allocator, "{{{}}}", 7), "{7}") { return 41; }
    try {
        Render(allocator, "{");
        if !(false) { return 50; }
    } catch {
        refusal => { if !InvalidAt(refusal, 0) { return 50; } }
    }
    try {
        Render(allocator, "}");
        if !(false) { return 51; }
    } catch {
        refusal => { if !InvalidAt(refusal, 0) { return 51; } }
    }
    try {
        Render(allocator, "ab{");
        if !(false) { return 52; }
    } catch {
        refusal => { if !InvalidAt(refusal, 2) { return 52; } }
    }
    try {
        Render(allocator, "ab}cd");
        if !(false) { return 53; }
    } catch {
        refusal => { if !InvalidAt(refusal, 2) { return 53; } }
    }
    try {
        Render(allocator, "a{b");
        if !(false) { return 54; }
    } catch {
        refusal => { if !InvalidAt(refusal, 1) { return 54; } }
    }

    // Between the braces, a specification opens with a colon and nothing else does. Positional and named arguments
    // are not part of the run-time grammar, so the offset is the first character that is not a colon. A literal with
    // a named placeholder is rewritten while compiling, so these patterns reach the formatter as values.
    try {
        Render(allocator, Pattern("{x} {}"), 1);
        if !(false) { return 55; }
    } catch {
        refusal => { if !InvalidAt(refusal, 1) { return 55; } }
    }
    try {
        Render(allocator, "{0}", 1);
        if !(false) { return 56; }
    } catch {
        refusal => { if !InvalidAt(refusal, 1) { return 56; } }
    }
    try {
        Render(allocator, Pattern("ok {name}"), 1);
        if !(false) { return 57; }
    } catch {
        refusal => { if !InvalidAt(refusal, 4) { return 57; } }
    }

    // A specification that does not parse is a refusal, and its offset is into the pattern rather than into the
    // specification — which is the case a test checking only the reason would pass with every offset at zero.
    try {
        Render(allocator, "{:>>>}", 1);
        if !(false) { return 60; }
    } catch {
        refusal => { if !InvalidAt(refusal, 4) { return 60; } }
    }
    try {
        Render(allocator, "ab {:>>>}", 1);
        if !(false) { return 61; }
    } catch {
        refusal => { if !InvalidAt(refusal, 7) { return 61; } }
    }
    try {
        Render(allocator, "{} {:>>>}", 1, 2);
        if !(false) { return 62; }
    } catch {
        refusal => { if !InvalidAt(refusal, 7) { return 62; } }
    }

    // A style the value refuses is a different failure from one the parser refuses: the first parses and is turned
    // down by the value, and it is reported as unsupported rather than as a malformed pattern.
    var refusedStyle = false;
    try {
        Render(allocator, "{:q}", 1);
    } catch {
        reason => { refusedStyle = match reason { .UnsupportedRequest => true, _ => false }; }
    }
    if !refusedStyle { return 63; }

    // A valid specification still works, which is what makes the refusals above about the malformed ones.
    if !Matches(try? Render(allocator, "[{:>6}]", "ab"), "[    ab]") { return 64; }
    if !Matches(try? Render(allocator, "{:04}", 7), "0007") { return 65; }

    // A type of this package's own, reached through the interface.
    if !Matches(try? Render(allocator, "at {}", Point { x: -1, y: 2 }), "at (-1, 2)") { return 70; }

    // Text as the pattern and as an argument. A string renders itself, which is what makes it usable as a
    // variadic argument at all.
    if !Matches(try? Render(allocator, "{} and {}", "text", 1), "text and 1") { return 71; }

    // A rendering that outgrows any up-front guess: one hundred units of sixteen bytes, plus the frame around them.
    if RenderedLength(try? Render(allocator, "<{}>", Filler { count: 100 })) != 1602 { return 80; }

    // A destination that runs out of room reports it, and stops: what a refused write did not accept is not
    // written, and nothing after the failing placeholder is either.
    var room: char8[8];
    var writer = BufferWriter(room[..8]);
    let sink: &var TextWriter = writer;
    let overflowed: Result<(), FormatError> =
        try .Success(WriteFormat(sink, "12345{}<end>", Filler { count: 1 })) catch { error => .Failure(error) };
    let capacity = match overflowed {
        .Success(_) => false,
        .Failure(reason) => match reason { .InsufficientCapacity => true, _ => false }
    };
    if !capacity { return 90; }
    // The literal before the placeholder went in; the sixteen bytes the value wanted did not fit and so landed not
    // at all, and the text after it never ran.
    if writer.Length() != 5 { return 91; }

    // A pattern that is wrong writes nothing at all, because it is checked before the first byte goes out.
    var second = BufferWriter(room[..8]);
    let other: &var TextWriter = second;
    if (try? WriteFormat(other, "abc{", 1)) is .Some(_) { return 92; }
    if second.Length() != 0 { return 93; }
    var third = BufferWriter(room[..8]);
    let last: &var TextWriter = third;
    if (try? WriteFormat(last, Pattern("abc{}"), 1, 2)) is .Some(_) { return 94; }
    if third.Length() != 0 { return 95; }

    // A failed render gives its block back. Counted, because a leak leaves the same error behind as a clean
    // failure and is invisible to a check that only reads the result.
    var counts = AllocationCounts { live: 0, allocations: 0, releases: 0, invalidReleases: 0 };
    var counting = CountingAllocator { inner: allocator, counts: @counts };
    let counted: Allocator = counting;
    if !Matches(try? Render(counted, "{} ok", 1), "1 ok") { return 100; }
    if counts.live != 0 { return 101; }
    try {
        Render(counted, "abcdefghijklmnop {", 1);
        if !(false) { return 102; }
    } catch {
        refusal => { if !InvalidAt(refusal, 17) { return 102; } }
    }
    if counts.live != 0 { return 103; }
    try {
        Render(counted, Pattern("abcdefghijklmnop {}"), 1, 2);
        if !(false) { return 104; }
    } catch {
        refusal => { if !MismatchOf(refusal, 1, 2) { return 104; } }
    }
    if counts.live != 0 { return 105; }

    return 0;
}
