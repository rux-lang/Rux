import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Failed, Panic, Succeeded };
import Format::Render;
import Text::{ BufferWriter, Debug, Display, FormatError, FormatSpec, ParseFormatSpec, String, StringView };

// A `char64` holds one Unicode scalar value in eight bytes, and renders exactly as a `char32` of the same scalar.
// What is particular to the width is the room it has for numbers no character has. A cast can put one there, and
// it must be refused at the full sixty-four bits: `0x100000041` narrows into a perfectly good `A`, so a check after
// narrowing would write the wrong character instead of the replacement.
// Every case renders twice, once through a constrained borrowed receiver and once through the interface, and
// `Display` is reached a third way through `Render`'s variadic arguments.

// A value that is not a character, made at run time.
// The compiler refuses to fold a surrogate or an out-of-range number into a character constant, so the number is
// passed through a function and the cast happens on a value the compiler cannot see.
func AsChar64(value: uint64) -> char64 {
    return value as char64;
}

func Same(actual: char8[..], expected: char8[..]) -> bool {
    if actual.length != expected.length { return false; }
    var index: uint = 0;
    while index < actual.length {
        if actual[index] != expected[index] { return false; }
        index += 1;
    }
    return true;
}

func Spec(text: char8[..]) -> FormatSpec {
    var spec = FormatSpec::Plain();
    spec = ParseFormatSpec(text) catch { else => Panic("the test's specification is valid") };
    return spec;
}

// Renders `value` under `spec` through a constrained receiver and through the interface, and checks both.
func Shown<T: Display>(value: &T, spec: FormatSpec, expected: char8[..]) {
    var storage: char8[192];
    var writer = BufferWriter((@storage[0])[..192]);
    Assert(Succeeded(value.WriteDisplay(writer, spec)), "a constrained receiver renders");
    Assert(Same(writer.Written(), expected), expected);
    writer.Clear();
    let shown: &Display = value;
    Assert(Succeeded(shown.WriteDisplay(writer, spec)), "an interface receiver renders");
    Assert(Same(writer.Written(), expected), expected);
}

// The `Debug` counterpart of `Shown`.
func Inspected<T: Debug>(value: &T, expected: char8[..]) {
    var storage: char8[192];
    var writer = BufferWriter((@storage[0])[..192]);
    Assert(Succeeded(value.WriteDebug(writer, FormatSpec::Plain())), "a constrained debug receiver renders");
    Assert(Same(writer.Written(), expected), expected);
    writer.Clear();
    let shown: &Debug = value;
    Assert(Succeeded(shown.WriteDebug(writer, FormatSpec::Plain())), "an interface debug receiver renders");
    Assert(Same(writer.Written(), expected), expected);
}

// Whether `Display` refuses `spec` rather than rendering under it.
func Refused<T: Display>(value: &T, spec: FormatSpec) -> bool {
    var storage: char8[16];
    var writer = BufferWriter((@storage[0])[..16]);
    return Failed(value.WriteDisplay(writer, spec));
}

// Whether the outcome is exactly `expected`. Consuming the result is what forces a failure to be visible.
func Rendered(outcome: String ! FormatError, expected: char8[..]) -> bool {
    let wanted = StringView::FromValidated(expected);
    return match <-outcome {
        .Success(text) => text.View().Equals(wanted),
        .Failure(_) => false
    };
}

func Main() -> int {
    let plain = FormatSpec::Plain();

    // Valid scalars at every UTF-8 length, one to four bytes, and the last scalar there is.
    let letter = c64'A';
    Shown<char64>(letter, plain, "A");
    Inspected<char64>(letter, "'A'");
    let accented = c64'é';
    Shown<char64>(accented, plain, "é");
    Inspected<char64>(accented, "'é'");
    let euro = c64'€';
    Shown<char64>(euro, plain, "€");
    Inspected<char64>(euro, "'€'");
    let face = c64'😀';
    Shown<char64>(face, plain, "😀");
    Inspected<char64>(face, "'😀'");
    let last = c64'\u{10FFFF}';
    Shown<char64>(last, plain, "\u{10FFFF}");
    Inspected<char64>(last, "'\u{10FFFF}'");

    // Debug escapes the quote, the backslash and the controls, as it does everywhere else; Display writes them
    // as they are.
    let newline = c64'\n';
    Shown<char64>(newline, plain, "\n");
    Inspected<char64>(newline, "'\\n'");
    let quote = c64'\'';
    Shown<char64>(quote, plain, "'");
    Inspected<char64>(quote, "'\\''");
    let backslash = c64'\\';
    Shown<char64>(backslash, plain, "\\");
    Inspected<char64>(backslash, "'\\\\'");
    let zero = c64'\0';
    Inspected<char64>(zero, "'\\0'");
    let control = AsChar64(0x01u64);
    Inspected<char64>(control, "'\\x{01}'");
    let c1 = AsChar64(0x85u64);
    Inspected<char64>(c1, "'\\x{85}'");

    // A width counts characters rather than bytes, and the fill and alignment are the ones every value takes.
    Shown<char64>(letter, Spec(">3"), "  A");
    Shown<char64>(letter, Spec("<3"), "A  ");
    Shown<char64>(letter, Spec("^5"), "  A  ");
    Shown<char64>(letter, Spec("*^5"), "**A**");
    Shown<char64>(face, Spec(">3"), "  😀");
    Shown<char64>(face, Spec("1"), "😀");
    // A character has no second form, so a style is refused rather than ignored.
    Assert(Refused<char64>(letter, Spec("x")), "a character refuses a base");
    Assert(Refused<char64>(letter, Spec("e")), "and any other style");

    // Through Render, as an ordinary variadic argument.
    var system = SystemAllocator();
    let allocator: Allocator = system;
    Assert(Rendered(Render(allocator, "[{}]", letter), "[A]"), "a char64 is a Render argument");
    Assert(Rendered(Render(allocator, "{:>4}|{}", face, accented), "   😀|é"), "padded, beside another");

    // Values that are not characters: the replacement under Display, and the number itself under Debug.
    let surrogate = AsChar64(0xD800u64);
    Shown<char64>(surrogate, plain, "\u{FFFD}");
    Inspected<char64>(surrogate, "'\\u{d800}'");
    let lowSurrogate = AsChar64(0xDFFFu64);
    Shown<char64>(lowSurrogate, plain, "\u{FFFD}");
    Inspected<char64>(lowSurrogate, "'\\u{dfff}'");
    let past = AsChar64(0x110000u64);
    Shown<char64>(past, plain, "\u{FFFD}");
    Inspected<char64>(past, "'\\u{00110000}'");
    let disguised = AsChar64(0x100000041u64);
    Shown<char64>(disguised, plain, "\u{FFFD}");
    Inspected<char64>(disguised, "'\\u{0000000100000041}'");
    let top64 = AsChar64(0xFFFFFFFFFFFFFFFFu64);
    Shown<char64>(top64, plain, "\u{FFFD}");
    Inspected<char64>(top64, "'\\u{ffffffffffffffff}'");
    Shown<char64>(disguised, Spec(">2"), " \u{FFFD}");

    return 0;
}
