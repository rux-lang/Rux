
import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Io::{ BufferedReader, BufferedWriter, IoError, IoErrorKind, Reader, Writer };

// The bytes a string spans, which is how a caller holding text reaches an entry point that takes bytes.
func TextBytes(text: char8[..]) -> char8[..] {
    return text;
}

// What buffering promises is fewer conversations, and the way to test a count of conversations is to count them:
// the scripted source and sink tally their calls, and the assertions are about the tallies as much as the bytes.
// The bypass, the ordering across a bypass, and the flush contracts each get the shape that would catch them.

// A source that hands out a repeating alphabet and counts how often it is asked.
struct CountingSource {
    served: uint;
    calls: uint;
    limit: uint;
}

struct SourceHandle {
    state: *var CountingSource;
}

extend SourceHandle : Reader {
    func Read(&var self, into: var char8[..]) -> uint throws IoError {
        let state = self.state;
        // Safety: `state` points at the `CountingSource` local of `Main`, which outlives every handle made from it.
        unsafe {
            state.calls = state.calls + 1;
            if state.served >= state.limit {
                throw IoError::Of(IoErrorKind::EndOfStream);
            }
            var give = state.limit - state.served;
            if give > into.length {
                give = into.length;
            }
            var index: uint = 0;
            while index < give {
                into[index] = ((state.served + index) % 26 + 0x61) as char8;
                index = index + 1;
            }
            state.served = state.served + give;
            return give;
        }
    }
}

// A sink that records everything and counts its calls.
struct CountingSink {
    room: var char8[..];
    written: uint;
    calls: uint;
    flushes: uint;
}

struct SinkHandle {
    state: *var CountingSink;
}

extend SinkHandle : Writer {
    func Write(&var self, bytes: char8[..]) -> uint throws IoError {
        let state = self.state;
        // Safety: `state` points at the `CountingSink` local of `Main`, which outlives every handle made from it.
        unsafe {
            state.calls = state.calls + 1;
            var take = bytes.length;
            if take > state.room.length - state.written {
                take = state.room.length - state.written;
            }
            var index: uint = 0;
            while index < take {
                state.room[state.written + index] = bytes[index];
                index = index + 1;
            }
            state.written = state.written + take;
            return take;
        }
    }

    func Flush(&var self) throws IoError {
        // Safety: `state` points at the `CountingSink` local of `Main`, which outlives every handle made from it.
        unsafe { self.state.flushes = self.state.flushes + 1; }
    }
}

// A non-blocking source that is never ready: every read fails with `WouldBlock`, counted where the test can see it.
struct BlockedHandle {
    calls: *var uint;
}

extend BlockedHandle : Reader {
    func Read(&var self, into: var char8[..]) -> uint throws IoError {
        // Safety: `calls` points at a counter local of `Main`, which outlives the handle.
        unsafe { *self.calls = *self.calls + 1; }
        throw IoError::Of(IoErrorKind::WouldBlock);
    }
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // Sixty-four one-byte reads out of a 16-byte buffer cost the source four calls, not sixty-four.
    var source = CountingSource { served: 0, calls: 0, limit: 64 };
    let sourceHandle: Reader = SourceHandle { state: @source };
    var reader = try BufferedReader::New(allocator, sourceHandle, 16) catch {
        _ => Panic("the reader takes its buffer")
    };
    var one: char8[1];
    let oneRoom = one[..1];
    var count: uint = 0;
    var lastByte = 0u8 as char8;
    while true {
        let filled = try reader.Read(oneRoom) catch {
            error if error.IsEnd() => break,
            _ => Panic("every read before the end succeeds")
        };
        Assert(filled == 1, "each read fills the one-byte room");
        count = count + 1;
        lastByte = one[0];
    }
    Assert(count == 64, "every byte arrives");
    Assert(lastByte == ((63u % 26u + 0x61u) as char8), "in order, to the last");
    Assert(source.calls <= 6, "and the source was asked a handful of times, not sixty-four");

    // A read larger than the whole buffer bypasses it.
    var bigSource = CountingSource { served: 0, calls: 0, limit: 64 };
    let bigHandle: Reader = SourceHandle { state: @bigSource };
    var bypassReader = try BufferedReader::New(allocator, bigHandle, 8) catch {
        _ => Panic("the reader takes its buffer")
    };
    var bigStorage: char8[32];
    let bigRoom = bigStorage[..32];
    let filled = try bypassReader.Read(bigRoom) catch { _ => Panic("the large read succeeds") };
    Assert(filled == 32, "whole");
    Assert(bigSource.calls == 1, "in one conversation, straight past the buffer");

    // Buffered() and Consume() expose the lookahead line reading is built from.
    var peekSource = CountingSource { served: 0, calls: 0, limit: 10 };
    let peekHandle: Reader = SourceHandle { state: @peekSource };
    var peekReader = try BufferedReader::New(allocator, peekHandle, 16) catch {
        _ => Panic("the reader takes its buffer")
    };
    try peekReader.Fill() catch { _ => Panic("the buffer fills on request") };
    Assert(peekReader.Available() == 10, "with everything the source had");
    let peeked = peekReader.Buffered();
    Assert(peeked[0] == c8'a' && peeked[9] == c8'j', "visible without being consumed");
    peekReader.Consume(4);
    Assert(peekReader.Available() == 6, "and consumed on request");

    // The writer: many small writes, one conversation.
    var sinkStorage: char8[64];
    var sink = CountingSink {
        room: sinkStorage[..64],
        written: 0,
        calls: 0,
        flushes: 0
    };
    let sinkHandle: Writer = SinkHandle { state: @sink };
    var writer = try BufferedWriter::New(allocator, sinkHandle, 32) catch { _ => Panic("the writer takes its buffer") };
    var piece: uint = 0;
    while piece < 8 {
        let taken = try writer.Write(TextBytes("ab")) catch { _ => Panic("each small write succeeds") };
        Assert(taken == 2, "each small write is taken whole");
        piece = piece + 1;
    }
    Assert(sink.calls == 0, "and none of them reached the sink yet");
    Assert(writer.Pending() == 16, "they wait in the buffer");
    try writer.Flush() catch { _ => Panic("until the flush") };
    Assert(sink.calls == 1, "which is one conversation");
    Assert(sink.flushes == 1, "passed through to the sink");
    Assert(sink.written == 16 && sinkStorage[0] == c8'a' && sinkStorage[15] == c8'b', "carrying every byte in order");

    // A write larger than the buffer goes around it — after what was gathered, so order holds.
    let gathered = try writer.Write(TextBytes("xy")) catch { _ => Panic("a small write gathers") };
    Assert(gathered == 2, "and is taken whole");
    let around = try writer.Write(TextBytes("0123456789abcdefghijklmnopqrstuvwxyz")) catch {
        _ => Panic("a huge one goes around")
    };
    Assert(around == 36, "whole");
    Assert(sinkStorage[16] == c8'x' && sinkStorage[17] == c8'y', "the gathered bytes went first");
    Assert(sinkStorage[18] == c8'0', "then the bypass");
    Assert(writer.Pending() == 0, "and nothing waits");

    // A source that would block is handed back to the caller after one attempt, by the fill and by the bypass alike,
    // rather than asked again until it is ready.
    var blockedCalls: uint = 0;
    let blockedHandle: Reader = BlockedHandle { calls: @blockedCalls };
    var blocked = try BufferedReader::New(allocator, blockedHandle, 8) catch {
        _ => Panic("the reader takes its buffer")
    };
    try {
        blocked.Fill();
        Panic("a source that is never ready fills nothing");
    } catch {
        error => Assert(error.kind == IoErrorKind::WouldBlock, "the fill reports the would-block"),
    }
    Assert(blockedCalls == 1, "after a single attempt");
    var wide: char8[16];
    try {
        blocked.Read(wide[..]);
        Panic("a bypassing read of a source that is never ready reads nothing");
    } catch {
        error => Assert(error.kind == IoErrorKind::WouldBlock, "the bypass reports it too"),
    }
    Assert(blockedCalls == 2, "after a single attempt of its own");

    return 0;
}
