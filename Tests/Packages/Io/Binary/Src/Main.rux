// The caller names the format's byte order, and the host's own never enters into it: the same value writes to
// mirrored bytes under the two orders, and each order reads back exactly what it wrote.

import Core::{ Assert, Panic };
import Io::{ Endian, IoError, IoErrorKind, Reader, Writer };
import Io::{ ReadFloat32, ReadFloat64, ReadInt16, ReadInt64, ReadInt8, ReadUint128, ReadUint16, ReadUint256, ReadUint32,
             ReadUint512, ReadUint64, ReadUint8 };
import Io::{ WriteFloat32, WriteFloat64, WriteInt16, WriteInt64, WriteInt8, WriteUint128, WriteUint16, WriteUint256,
             WriteUint32, WriteUint512, WriteUint64, WriteUint8 };

// A little memory stream: writes append, reads serve from the front.
struct MemoryState {
    room: var char8[..];
    length: uint;
    offset: uint;
}

extend MemoryState : Reader {
    func Read(self: &var MemoryState, into: var char8[..]) -> uint ! IoError {
        var give = self.length - self.offset;
        if give == 0 {
            fail IoError::Of(IoErrorKind::EndOfStream);
        }
        if give > into.length {
            give = into.length;
        }
        var index: uint = 0;
        while index < give {
            into.data[index] = self.room.data[self.offset + index];
            index = index + 1;
        }
        self.offset = self.offset + give;
        return give;
    }
}

extend MemoryState : Writer {
    func Write(self: &var MemoryState, bytes: char8[..]) -> uint ! IoError {
        var index: uint = 0;
        while index < bytes.length {
            self.room.data[self.length + index] = bytes.data[index];
            index = index + 1;
        }
        self.length = self.length + bytes.length;
        return bytes.length;
    }

    func Flush(self: &var MemoryState) -> ! IoError {
        return;
    }
}

func ByteAt(state: &MemoryState, index: uint) -> uint8 {
    return state.room.data[index] as uint8;
}

// The value an operation expected to succeed produced.
func Expect<T>(outcome: T ! IoError, message: char8[..]) -> T {
    return outcome catch { else => Panic(message) };
}

// The failure an operation expected to fail reported.
func Refusal<T>(outcome: T ! IoError) -> IoError {
    return match outcome {
        .Success(_) => Panic("expected a failure"),
        .Failure(error) => error
    };
}

func Main() -> int {
    // The two orders write mirrored bytes: the value is the same, only which end comes first differs.
    var goldenStorage: char8[256];
    var golden = MemoryState { room: (@goldenStorage[0])[..256], length: 0, offset: 0 };
    WriteUint32(golden, Endian::Big, 0x12345678) catch { else => Panic("big writes") };
    WriteUint32(golden, Endian::Little, 0x12345678) catch { else => Panic("and little writes") };
    Assert(ByteAt(golden, 0) == 0x12u8 && ByteAt(golden, 1) == 0x34u8 &&
           ByteAt(golden, 2) == 0x56u8 && ByteAt(golden, 3) == 0x78u8,
           "big-endian puts the most significant byte first");
    Assert(ByteAt(golden, 4) == 0x78u8 && ByteAt(golden, 5) == 0x56u8 &&
           ByteAt(golden, 6) == 0x34u8 && ByteAt(golden, 7) == 0x12u8,
           "and little-endian mirrors it");

    // The IEEE 754 pattern of 1.0, byte for byte, in network order.
    var floatsStorage: char8[256];
    var floats = MemoryState { room: (@floatsStorage[0])[..256], length: 0, offset: 0 };
    WriteFloat64(floats, Endian::Big, 1.0) catch { else => Panic("the float writes") };
    Assert(ByteAt(floats, 0) == 0x3Fu8 && ByteAt(floats, 1) == 0xF0u8 && ByteAt(floats, 2) == 0u8 &&
           ByteAt(floats, 7) == 0u8, "as the bit pattern its specification names");

    // A mixed record round-trips through both orders, each value read back where it was written.
    var recordStorage: char8[256];
    var record = MemoryState { room: (@recordStorage[0])[..256], length: 0, offset: 0 };
    let wideValue = (0x0123456789ABCDEFu512 << 64u512) | 0xFEDCBA9876543210u512;
    let hugeValue = (wideValue << 256u512) | (wideValue << 128u512) | wideValue;
    var order = Endian::Big;
    var pass: uint = 0;
    while pass < 2 {
        WriteUint8(record, order, 0xAB) catch { else => Panic("u8 writes") };
        WriteUint16(record, order, 0xBEEF) catch { else => Panic("u16 writes") };
        WriteUint32(record, order, 0xDEADBEEF) catch { else => Panic("u32 writes") };
        WriteUint64(record, order, 0x0123456789ABCDEF) catch { else => Panic("u64 writes") };
        WriteUint128(record, order, wideValue as uint128) catch { else => Panic("u128 writes") };
        WriteUint256(record, order, (hugeValue as uint256) | 1) catch { else => Panic("u256 writes") };
        WriteUint512(record, order, hugeValue) catch { else => Panic("u512 writes") };
        WriteInt8(record, order, -100) catch { else => Panic("i8 writes") };
        WriteInt16(record, order, -32768) catch { else => Panic("the most negative i16 writes") };
        WriteInt64(record, order, -1) catch { else => Panic("minus one writes") };
        WriteFloat32(record, order, -2.5f32) catch { else => Panic("f32 writes") };
        WriteFloat64(record, order, 6.02214076e23) catch { else => Panic("f64 writes") };

        Assert(Expect(ReadUint8(record, order), "u8 reads") == 0xABu8, "u8 returns");
        Assert(Expect(ReadUint16(record, order), "u16 reads") == 0xBEEFu16, "u16 returns");
        Assert(Expect(ReadUint32(record, order), "u32 reads") == 0xDEADBEEFu32, "u32 returns");
        Assert(Expect(ReadUint64(record, order), "u64 reads") == 0x0123456789ABCDEFu64, "u64 returns");
        Assert(Expect(ReadUint128(record, order), "u128 reads") == (wideValue as uint128), "u128 returns");
        Assert(Expect(ReadUint256(record, order), "u256 reads") == ((hugeValue as uint256) | 1),
               "u256 returns");
        Assert(Expect(ReadUint512(record, order), "u512 reads") == hugeValue, "u512 returns");
        Assert(Expect(ReadInt8(record, order), "i8 reads") == -100i8, "i8 returns");
        Assert(Expect(ReadInt16(record, order), "i16 reads") == -32768i16, "the most negative i16 returns");
        Assert(Expect(ReadInt64(record, order), "i64 reads") == -1i64, "minus one returns");
        Assert(Expect(ReadFloat32(record, order), "f32 reads") == -2.5f32, "f32 returns");
        Assert(Expect(ReadFloat64(record, order), "f64 reads") == 6.02214076e23, "f64 returns");

        record.length = 0;
        record.offset = 0;
        order = Endian::Little;
        pass = pass + 1;
    }

    // A stream two bytes long cannot yield a four-byte value, and says so rather than inventing the rest.
    var shortStorage: char8[256];
    var short = MemoryState { room: (@shortStorage[0])[..256], length: 2, offset: 0 };
    Assert(Refusal(ReadUint32(short, Endian::Big)).IsEnd(), "a short stream is the end, not a value");

    return 0;
}
