import Core::Assert;
import Format::WriteFormat;
import Io::{ IoError, PrintLine };
import Text::{ BufferWriter, FormatSpec, WriteValue };

func Same(left: char8[..], right: char8[..]) -> bool {
    if left.length != right.length { return false; }
    var index: uint = 0;
    while index < left.length {
        if left[index] != right[index] { return false; }
        index += 1;
    }
    return true;
}
func Check(flag: bool) {
    var storage: char8[128];
    var writer = BufferWriter(storage[..128]);
    Assert(WriteFormat(writer, "{}/{}/{}", if flag { "alpha" } else { "B" }, if flag { "" } else { "alpha" }, if flag {
        "B"
    } else {
        ""
    }) is .Success(_), "inline variadic formatting succeeds");
    Assert(Same(writer.Written(), if flag { "alpha//B" } else { "B/alpha/" }), "all selected slice bytes survive");
    var plainStorage: char8[32];
    var plainWriter = BufferWriter(plainStorage[..32]);
    Assert(WriteValue(plainWriter, if flag {
        "alpha"
    } else {
        "B"
    }, FormatSpec::Plain()) is .Success(_), "an ordinary interface argument succeeds");
    Assert(Same(plainWriter.Written(), if flag {
        "alpha"
    } else {
        "B"
    }), "ordinary interface conversion preserves the text");
    Assert(!(PrintLine("{}/{}/{}", if flag { "alpha" } else { "B" }, if flag { "" } else { "alpha" }, if flag {
        "B"
    } else {
        ""
    }) is IoError), "inline PrintLine succeeds");
    Assert(!(PrintLine("{} {}", if flag { "alpha" } else { "B" }, if flag {
        "alpha"
    } else {
        "B"
    }) is IoError), "repeated PrintLine arguments succeed");
}
func Main() -> int {
    var iteration = 0;
    while iteration < 4 {
        Check(iteration % 2 == 0);
        iteration += 1;
    }
    return 0;
}
