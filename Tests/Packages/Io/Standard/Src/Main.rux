
// The standard streams under the test runner are redirected, which is itself the point: the redirection path is
// the one a program in a pipeline lives on, and these writes must land as the raw bytes they are.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Io::{ BufferedWriter, StandardError, StandardIn, StandardOut, WriteAll, Writer };

// The bytes a string spans, which is how a caller holding text reaches an entry point that takes bytes.
func TextBytes(text: char8[..]) -> char8[..] {
    return text;
}

func Main() -> int {
    // Acquisition asks its one question and cannot fail; the values are plain data.
    var out = StandardOut::Acquire();
    var errStream = StandardError::Acquire();
    let stdin = StandardIn::Acquire();
    Assert(stdin.pendingCount == 0, "nothing is pending before anything is read");

    // A write to standard output takes the bytes and says so.
    let line = TextBytes("standard streams under test\n");
    try WriteAll(out, line) catch { _ => Panic("the write is taken in full") };
    let taken = try out.Write(TextBytes("")) catch { _ => Panic("an empty write succeeds") };
    Assert(taken == 0, "an empty write is nothing and succeeds");
    try out.Flush() catch { _ => Panic("and flush holds nothing back") };

    // Standard error is the same contract on the other stream.
    try WriteAll(errStream, TextBytes("a report belongs on standard error\n")) catch {
        _ => Panic("stderr takes its bytes")
    };

    // The handle is a plain byte Writer, so the buffered writer stacks on it unchanged.
    var system = SystemAllocator();
    let allocator: Allocator = system;
    let sink: Writer = out;
    var buffered = try BufferedWriter(allocator, sink, 64) catch {
        _ => Panic("the buffered writer takes its buffer")
    };
    let piece = try buffered.Write(TextBytes("buffered ")) catch { _ => Panic("a piece is gathered") };
    Assert(piece == 9, "and taken whole");
    let another = try buffered.Write(TextBytes("through the standard stream\n")) catch { _ => Panic("and another") };
    Assert(another == 28, "also whole");
    try buffered.Flush() catch { _ => Panic("and the flush sends them") };

    return 0;
}
