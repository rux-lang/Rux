import Allocator::SystemAllocator;
import Core::Assert;
import Io::{ ByteReader, ByteWriter, Endian, IoErrorKind, ReadExact, ReadUint32, SeekFrom, WriteAll, WriteUint32 };

// A reader over bytes in memory ends with `EndOfStream`, seeks anywhere within them and refuses beyond; a writer
// grows to hold anything written, overwrites after a seek back, and works with every `Io` helper.

func Same(left: char8[..], right: char8[..]) -> bool {
    if left.length != right.length { return false; }
    var index: uint = 0;
    while index < left.length {
        if left[index] != right[index] { return false; }
        index = index + 1;
    }
    return true;
}

func Main() -> int {
    var reader = ByteReader("hello, world");
    var five: char8[5] = [c8' '; 5];
    try ReadExact(reader, five[..]) catch { _ => return 1 };
    Assert(Same(five[..], "hello") && reader.Position() == 5u && Same(reader.Remaining(), ", world"), "reads in order");
    var big: char8[32] = [c8' '; 32];
    let count = try reader.Read(big[..]) catch { _ => return 2 };
    Assert(count == 7u && Same(big[..count], ", world"), "a read takes what is left");
    try {
        reader.Read(big[..]);
        Assert(false, "nothing is left");
    } catch {
        error => Assert(error.kind == IoErrorKind::EndOfStream, "the end is EndOfStream"),
    }
    Assert(((try reader.Seek(SeekFrom::End, -5) catch { _ => 99u64 })) == 7u64, "seeks from the end");
    let tail = try reader.Read(big[..]) catch { _ => return 3 };
    Assert(Same(big[..tail], "world"), "reads after a seek");
    Assert(((try reader.Seek(SeekFrom::Current, -12) catch { _ => 99u64 })) == 0u64, "seeks back to the start");
    try {
        reader.Seek(SeekFrom::Start, 13);
        Assert(false, "past the end");
    } catch {
        error => Assert(error.kind == IoErrorKind::InvalidInput, "a seek past the end is refused"),
    }

    var writer = ByteWriter(SystemAllocator());
    Assert(writer.Length() == 0u && writer.Bytes().length == 0u, "an empty writer");
    try WriteAll(writer, "abc") catch { _ => return 4 };
    var index: uint = 0;
    while index < 100u {
        try WriteAll(writer, "0123456789") catch { _ => return 5 };
        index = index + 1;
    }
    Assert(writer.Length() == 1003u && Same(writer.Bytes()[..13], "abc0123456789"), "grows past its first block");
    try writer.Seek(SeekFrom::Start, 1) catch { _ => return 6 };
    try WriteAll(writer, "XY") catch { _ => return 7 };
    Assert(Same(writer.Bytes()[..5], "aXY01") && writer.Length() == 1003u, "a seek back overwrites in place");
    try writer.Seek(SeekFrom::End, 0) catch { _ => return 8 };
    try WriteUint32(writer, Endian::Big, 0x01020304u32) catch { _ => return 9 };
    Assert(writer.Length() == 1007u, "binary writes append");

    var back = ByteReader(writer.Bytes());
    try back.Seek(SeekFrom::End, -4) catch { _ => return 10 };
    Assert(((try ReadUint32(back, Endian::Big) catch { _ => 0u32 })) == 0x01020304u32, "what was written reads back");

    writer.Clear();
    Assert(writer.Length() == 0u, "clearing empties it");
    try WriteAll(writer, "again") catch { _ => return 11 };
    Assert(Same(writer.Bytes(), "again"), "and it writes again");

    // Writing the writer's own bytes back into it reads them where they live after growing, not where they were.
    var doublings: uint = 0;
    while doublings < 10u {
        let mine = writer.Bytes();
        try WriteAll(writer, mine) catch { _ => return 12 };
        doublings = doublings + 1;
    }
    Assert(writer.Length() == 5120u, "doubling the text ten times grows the storage past its block");
    Assert(Same(writer.Bytes()[..10], "againagain") && Same(writer.Bytes()[5115..], "again"),
           "and every copy holds the text, read from the storage as it is after each growth");

    // Reading into the very bytes being read moves them rather than copying over themselves.
    var overlap: char8[8];
    overlap[0] = c8'a';
    overlap[1] = c8'b';
    overlap[2] = c8'c';
    overlap[3] = c8'd';
    var source = ByteReader(overlap[0..4]);
    let moved = try source.Read(overlap[1..5]) catch { _ => 0u };
    Assert(moved == 4u && overlap[1] == c8'a' && overlap[4] == c8'd', "an overlapping read keeps every byte");
    writer.Release();
    Assert(writer.Length() == 0u && writer.Bytes().length == 0u, "releasing gives the storage back");
    return 0;
}
