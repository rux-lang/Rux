import Allocator::{ Allocator, SystemAllocator };
import Io::{ Print, PrintLine, ReadLine };

func EchoLine(allocator: Allocator) {
    let line = ReadLine(allocator);
    Print("[");
    Print(line);
    PrintLine("]");
}

func Main() -> int {
    var system = SystemAllocator::New();
    let allocator: Allocator = system;
    EchoLine(allocator);
    EchoLine(allocator);
    EchoLine(allocator);
    EchoLine(allocator);
    return 0;
}
