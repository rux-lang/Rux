// The suite runs this with nothing on standard input, which is itself the contract worth holding: an ended
// stream with nothing before it is EndOfStream, not an empty line, so an echo loop stops rather than spins.
// The same reading over a scripted source checks what a console cannot be made to type: UTF-8 lines, a character
// split across reads, the bytes that are not text, and a source that is interrupted or not ready.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Io::{ IoError, IoErrorKind, Print, PrintLine, ReadLine, ReadLineFrom, Reader };
import Text::{ StringBuilder, StringView };

// A source that serves a fixed byte string one byte at a time, as a console does.
struct ScriptState {
    bytes: char8[..];
    offset: uint;
}

struct ScriptHandle {
    state: *var ScriptState;
}

extend ScriptHandle : Reader {
    func Read(&var self, into: var char8[..]) -> uint throws IoError {
        let state = self.state;
        // Safety: `state` points at a `ScriptState` local of the checking function, which outlives the handle.
        unsafe {
            if state.offset == state.bytes.length {
                throw IoError::Of(IoErrorKind::EndOfStream);
            }
            into[0] = state.bytes[state.offset];
            state.offset = state.offset + 1;
        }
        return 1;
    }
}

// A source that serves bytes one at a time like `ScriptHandle`, but fails once with `pauseKind` when it reaches
// `pauseAt`, and counts every call.
struct PausingState {
    bytes: char8[..];
    offset: uint;
    pauseAt: uint;
    pauseKind: IoErrorKind;
    paused: bool;
    calls: uint;
}

struct PausingHandle {
    state: *var PausingState;
}

extend PausingHandle : Reader {
    func Read(&var self, into: var char8[..]) -> uint throws IoError {
        let state = self.state;
        // Safety: `state` points at a `PausingState` local of `CheckPauses`, which outlives the handle.
        unsafe {
            state.calls = state.calls + 1;
            if state.offset == state.pauseAt && !state.paused {
                state.paused = true;
                throw IoError::Of(state.pauseKind);
            }
            if state.offset == state.bytes.length {
                throw IoError::Of(IoErrorKind::EndOfStream);
            }
            into[0] = state.bytes[state.offset];
            state.offset = state.offset + 1;
        }
        return 1;
    }
}

// An interruption is retried within the line; a would-block ends the call with what was read so far, and the next
// call carries on from the byte the source had not yet given.
func CheckPauses(allocator: Allocator) {
    var interrupted = PausingState {
        bytes: "ab\n",
        offset: 0,
        pauseAt: 1,
        pauseKind: IoErrorKind::Interrupted,
        paused: false,
        calls: 0
    };
    var interruptedSource = PausingHandle { state: @interrupted };
    var first = StringBuilder(allocator);
    Assert((try? ReadLineFrom(interruptedSource, first)) is .Some(_),
           "an interrupted read is retried within the line");
    let ab = StringView::FromBytes("ab") ?? StringView();
    Assert(first.View().Equals(ab), "which arrives whole");
    Assert(interrupted.calls == 4, "after three bytes and one interruption");
    first.Release();

    var blocked = PausingState {
        bytes: "ab\n",
        offset: 0,
        pauseAt: 2,
        pauseKind: IoErrorKind::WouldBlock,
        paused: false,
        calls: 0
    };
    var blockedSource = PausingHandle { state: @blocked };
    var second = StringBuilder(allocator);
    var kind: IoErrorKind? = none;
    try {
        ReadLineFrom(blockedSource, second);
    } catch {
        error => { kind = error.kind; }
    }
    Assert(kind == .Some(IoErrorKind::WouldBlock), "a source that is not ready is handed back");
    Assert(second.View().Equals(ab), "with the bytes read before it in the builder");
    Assert(blocked.calls == 3, "after a single attempt, not a spin");
    CheckLine(allocator, blockedSource, none, "");
    Assert(blocked.calls == 4, "and the next call finishes the line once the source is ready");
    second.Release();
}

// Reads the next line of `source` and checks the outcome: success when `expectedKind` is `none`, otherwise a
// failure of that kind; either way the builder holds `expected`.
func CheckLine(allocator: Allocator, source: &var Reader, expectedKind: IoErrorKind?, expected: char8[..]) {
    var builder = StringBuilder(allocator);
    var reported: IoErrorKind? = none;
    try {
        ReadLineFrom(source, builder);
    } catch {
        error => { reported = error.kind; }
    }
    Assert(reported == expectedKind, "the outcome names the reason");
    let want = StringView::FromBytes(expected) ?? StringView();
    Assert(builder.View().Equals(want), "and the builder holds the line, no more and no less");
    builder.Release();
}

func CheckScript(allocator: Allocator) {
    var bytes: char8[48];
    var length: uint = 0;
    // "héllo\n": six bytes of text, the é taking two of them.
    for b in [0x68u8, 0xC3, 0xA9, 0x6C, 0x6C, 0x6F, 0x0A] {
        bytes[length] = b as char8;
        length = length + 1;
    }
    // "😀\r\n": a four-byte character, then an ending whose return belongs to it.
    for b in [0xF0u8, 0x9F, 0x98, 0x80, 0x0D, 0x0A] {
        bytes[length] = b as char8;
        length = length + 1;
    }
    // "a\xFFb\n": a byte that starts no character fails the line, which is still read through its ending.
    for b in [0x61u8, 0xFF, 0x62, 0x0A] {
        bytes[length] = b as char8;
        length = length + 1;
    }
    // "\xC3\n": a character cut short by the ending.
    for b in [0xC3u8, 0x0A] {
        bytes[length] = b as char8;
        length = length + 1;
    }
    // "ok\n", which shows the failures left the source at the next line, then "\xE2\x82" cut by the end.
    for b in [0x6Fu8, 0x6B, 0x0A, 0xE2, 0x82] {
        bytes[length] = b as char8;
        length = length + 1;
    }
    var state = ScriptState { bytes: bytes[0..length], offset: 0 };
    var source = ScriptHandle { state: @state };

    var accented: char8[6];
    for index in 0..6 {
        accented[index] = bytes[index];
    }
    CheckLine(allocator, source, none, accented[0..6]);
    var face: char8[4];
    for index in 0..4 {
        face[index] = bytes[7 + index];
    }
    CheckLine(allocator, source, none, face[0..4]);
    CheckLine(allocator, source, .Some(IoErrorKind::InvalidText), "a");
    CheckLine(allocator, source, .Some(IoErrorKind::InvalidText), "");
    CheckLine(allocator, source, none, "ok");
    CheckLine(allocator, source, .Some(IoErrorKind::InvalidText), "");
    CheckLine(allocator, source, .Some(IoErrorKind::EndOfStream), "");
}

func Main() -> int {
    let allocator = SystemAllocator();
    CheckScript(allocator);
    CheckPauses(allocator);

    var count: uint = 0;
    while count < 8 {
        var builder = StringBuilder(allocator);
        try {
            ReadLine(builder);
            let line = builder.TakeString();
            Print("[");
            Print(line);
            PrintLine("]");
            count = count + 1;
        } catch {
            error => {
                builder.Release();
                if !error.IsEnd() { return 1; }
                break;
            },
        }
    }
    return 0;
}
