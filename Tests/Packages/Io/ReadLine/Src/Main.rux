import Allocator::{ Allocator, SystemAllocator };
import Io::{ IoError, Print, PrintLine, ReadLine };
import Text::StringBuilder;

// The suite runs this with nothing on standard input, which is itself the contract worth holding: an ended
// stream with nothing before it is EndOfStream, not an empty line, so an echo loop stops rather than spins.

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    var count: uint = 0;
    while count < 8 {
        var builder = StringBuilder(allocator);
        match ReadLine(builder) {
            .Success(_) => {
                let line = builder.IntoString();
                Print("[");
                Print(line);
                PrintLine("]");
                count = count + 1;
            },
            .Failure(error) => {
                builder.Release();
                if !error.IsEnd() { return 1; }
                break;
            }
        }
    }
    return 0;
}
