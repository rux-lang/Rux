import Core::uint;
import Allocator::{ Allocator, SystemAllocator };
import Collections::{ CollectionError, EqualsInt32, HashInt32, HashSet, TableSeed };
import Core::{ Assert, Panic };

// A set is the same kernel as a map with nothing stored alongside the key, so what is worth checking here is what a
// set adds: that it holds one of each, that adding a duplicate is reported rather than silently doubling the count,
// and that the element it keeps is the one it already had.

struct Tracked {
    counter: *var int32;
    value: int32;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked);

    func ~Tracked(self: &var Tracked) {
        if self.counter != null {
            *self.counter = *self.counter + 1i32;
        }
    }
}

/// Why an operation the test expects to fail failed. One that succeeds instead panics, so an expected failure
/// cannot pass by accident.
func Refusal<T, E>(outcome: T ! E) -> E {
    return match <-outcome {
        .Failure(error) => error,
        .Success(_) => Panic("the operation was expected to fail")
    };
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    var set = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    Assert(set.IsEmpty(), "a new set is empty");
    Assert(set.Capacity() == 0, "and has no storage");
    Assert(!set.Contains(1), "with nothing in it");
    Assert(set.Remove(1) == none, "and nothing to take out");

    var added = set.Insert(1) catch { else => Panic("the first insertion succeeds") };
    Assert(added, "and reports that the set grew");
    Assert(set.Length() == 1, "which it did");
    Assert(set.Contains(1), "holding what was put in");

    // A set holds one of each.
    added = set.Insert(1) catch { else => Panic("inserting a duplicate succeeds") };
    Assert(!added, "and reports that the set did not grow");
    Assert(set.Length() == 1, "which it did not");

    // Enough elements to grow several times, with duplicates mixed in.
    var value: int32 = 0;
    while value < 300 {
        set.Insert(value % 200) catch { else => Panic("every insertion succeeds") };
        value = value + 1;
    }
    Assert(set.Length() == 200, "and the set holds one of each distinct value");
    value = 0;
    while value < 200 {
        Assert(set.Contains(value), "every value put in is in the set");
        value = value + 1;
    }
    Assert(!set.Contains(200), "and nothing that was not");

    // Removal hands the element back and closes the gap; everything else stays findable.
    value = 0;
    while value < 200 {
        if value % 2 == 0 {
            Assert(set.Remove(value) == .Some(value), "removal hands back what it took");
        }
        value = value + 1;
    }
    Assert(set.Length() == 100, "with the count down by exactly what was removed");
    value = 0;
    while value < 200 {
        if value % 2 == 0 {
            Assert(!set.Contains(value), "a removed value is gone");
        }
        else {
            Assert(set.Contains(value), "and everything left is still findable");
        }
        value = value + 1;
    }

    // Churning at a steady size never grows the table.
    let settled = set.Capacity();
    var round: int32 = 0;
    while round < 500 {
        set.Insert(1000 + round) catch { else => Panic("every churn insertion succeeds") };
        Assert(set.Remove(1000 + round) is int32, "every churn removal finds what it just added");
        round = round + 1;
    }
    Assert(set.Capacity() == settled, "churning at a steady size never grows the table");
    Assert(set.Length() == 100, "and leaves the count where it was");

    // Walking reaches every element exactly once.
    var cursor: uint = 0;
    var seen: int32 = 0;
    var walked: uint = 0;
    var total: int64 = 0;
    while set.TryNext(@cursor, @seen) {
        Assert(seen % 2 == 1, "every element a walk reports is one still in the set");
        total = total + (seen as int64);
        walked = walked + 1;
    }
    Assert(walked == 100, "and a walk reaches every element");
    Assert(total == 10000, "each exactly once, since the odd numbers below two hundred sum to what they should");

    // Capacity behaviour.
    set.Reserve(1000) catch { else => Panic("reserving succeeds") };
    Assert(set.Capacity() >= 1000, "taking the room asked for");
    set.ShrinkToFit() catch { else => Panic("shrinking succeeds") };
    Assert(set.Capacity() < 1000, "giving back what the elements do not need");
    Assert(set.Contains(3), "and keeping every element");
    Assert(Refusal(set.Reserve(uint::Max)) == CollectionError::CapacityOverflow,
           "an impossible reservation is refused");
    Assert(set.Length() == 100, "leaving the set as it was");

    set.Clear();
    Assert(set.IsEmpty(), "clearing empties the set");
    set.Insert(1) catch { else => Panic("and the set is usable afterwards") };

    // Two seeds lay the same elements out differently.
    var first = HashSet::WithSeed<int32>(allocator, TableSeed::Of(1, 2), HashInt32, EqualsInt32);
    var second = HashSet::WithSeed<int32>(allocator, TableSeed::Of(99, 100), HashInt32, EqualsInt32);
    value = 0;
    while value < 32 {
        first.Insert(value) catch { else => Panic("the first seeded insertion succeeds") };
        second.Insert(value) catch { else => Panic("the second seeded insertion succeeds") };
        value = value + 1;
    }
    var firstCursor: uint = 0;
    var secondCursor: uint = 0;
    var firstValue: int32 = 0;
    var secondValue: int32 = 0;
    var differed = false;
    while first.TryNext(@firstCursor, @firstValue) {
        if !second.TryNext(@secondCursor, @secondValue) {
            differed = true;
            break;
        }
        if firstValue != secondValue {
            differed = true;
        }
    }
    Assert(differed, "two different seeds lay the same elements out differently");

    // Iterating with a `for` loop reaches every element exactly once.
    var loops = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    value = 0;
    while value < 40 {
        loops.Insert(value) catch { else => Panic("every loop insertion succeeds") };
        value = value + 1;
    }
    var iterated: uint = 0;
    var sum: int64 = 0;
    for element in loops {
        sum = sum + (element as int64);
        iterated = iterated + 1;
    }
    Assert(iterated == 40, "a loop reaches every element");
    Assert(sum == 780, "each exactly once, since the elements sum to what they should");

    // Consuming iteration moves every element out and takes the storage with it.
    var drained = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    value = 0;
    while value < 10 {
        drained.Insert(value) catch { else => Panic("every insertion before draining succeeds") };
        value = value + 1;
    }
    var moving = (<-drained).IntoIterator();
    var moved: uint = 0;
    var draining = true;
    while draining {
        match moving.Next() {
            .Some(element) => {
                moved = moved + 1;
            },
            none => {
                draining = false;
            }
        }
    }
    Assert(moved == 10, "consuming iteration yields every element");

    // Set algebra. Three sets whose overlaps are known, so every answer is one that can be written down.
    var evens = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    var odds = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    var small = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    value = 0;
    while value < 20 {
        if value % 2 == 0 {
            evens.Insert(value) catch { else => Panic("building the evens set succeeds") };
        }
        else {
            odds.Insert(value) catch { else => Panic("building the odds set succeeds") };
        }
        if value < 6 {
            small.Insert(value) catch { else => Panic("building the small set succeeds") };
        }
        value = value + 1;
    }
    Assert(evens.Length() == 10 && odds.Length() == 10 && small.Length() == 6, "the three sets are what they claim");

    // Containment, including the two vacuous cases.
    var empty = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    Assert(empty.IsSubsetOf(evens), "the empty set is a subset of anything");
    Assert(empty.IsSubsetOf(empty), "including itself");
    Assert(evens.IsSubsetOf(evens), "and every set is a subset of itself");
    Assert(!evens.IsSubsetOf(small), "a larger set is not a subset of a smaller one");
    Assert(!small.IsSubsetOf(evens), "and a set with an element the other lacks is not one either");
    Assert(evens.IsSupersetOf(empty), "a superset is a subset read the other way");
    Assert(evens.IsDisjointFrom(odds), "evens and odds share nothing");
    Assert(!evens.IsDisjointFrom(small), "while evens and the small set share their even members");
    Assert(empty.IsDisjointFrom(evens), "the empty set is disjoint from everything");
    Assert(evens.Equals(evens), "a set equals itself");
    Assert(!evens.Equals(odds), "and not one with different elements");

    // Union takes what the other has and keeps what it had.
    var everything = evens.Clone() catch { else => Panic("cloning a set succeeds") };
    Assert(everything.Equals(evens), "and the clone holds the same elements");
    everything.UnionWith(odds) catch { else => Panic("a union succeeds") };
    Assert(everything.Length() == 20, "and holds both sides");
    value = 0;
    while value < 20 {
        Assert(everything.Contains(value), "every element of either side is in the union");
        value = value + 1;
    }
    everything.UnionWith(evens) catch { else => Panic("a union with a subset succeeds") };
    Assert(everything.Length() == 20, "and adds nothing");

    // Intersection keeps only what both have, and cannot fail.
    var shared = evens.Clone() catch { else => Panic("cloning a set succeeds") };
    shared.IntersectWith(small);
    Assert(shared.Length() == 3, "the intersection is the even numbers below six");
    Assert(shared.Contains(0) && shared.Contains(2) && shared.Contains(4), "which are exactly those three");
    Assert(!shared.Contains(6), "and nothing above them");
    shared.IntersectWith(odds);
    Assert(shared.IsEmpty(), "intersecting with a disjoint set leaves nothing");

    // Difference removes what the other has.
    var without = evens.Clone() catch { else => Panic("cloning a set succeeds") };
    without.Subtract(small);
    Assert(without.Length() == 7, "the difference drops the even numbers below six");
    Assert(!without.Contains(0) && !without.Contains(4), "which are gone");
    Assert(without.Contains(6) && without.Contains(18), "while the rest remain");
    without.Subtract(odds);
    Assert(without.Length() == 7, "and subtracting a disjoint set changes nothing");

    // The symmetric difference keeps what exactly one side has.
    var exclusive = small.Clone() catch { else => Panic("cloning a set succeeds") };
    exclusive.SymmetricDifferenceWith(evens) catch { else => Panic("a symmetric difference succeeds") };
    Assert(!exclusive.Contains(0) && !exclusive.Contains(2) && !exclusive.Contains(4), "shared elements leave");
    Assert(exclusive.Contains(1) && exclusive.Contains(3) && exclusive.Contains(5), "the small set keeps its own");
    Assert(exclusive.Contains(6) && exclusive.Contains(18), "and takes the ones only the other side had");
    Assert(exclusive.Length() == 10, "which is three plus seven");

    // A symmetric difference with itself leaves nothing, which is the identity worth checking.
    var mirrored = evens.Clone() catch { else => Panic("cloning a set succeeds") };
    var alsoEvens = evens.Clone() catch { else => Panic("cloning a set succeeds") };
    mirrored.SymmetricDifferenceWith(alsoEvens) catch { else => Panic("a set against its own copy runs") };
    Assert(mirrored.IsEmpty(), "and leaves nothing at all");

    // Ownership: elements are destroyed with the set, and a removed one is handed back.
    var destroyed: int32 = 0;
    var owning = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    var counted: int32 = 0;
    while counted < 20 {
        owning.Insert(counted) catch { else => Panic("every owning insertion succeeds") };
        counted = counted + 1;
    }
    Assert(owning.Length() == 20, "the set holds every distinct element");
    owning.Clear();
    Assert(owning.IsEmpty(), "and clearing empties it");

    return 0;
}
