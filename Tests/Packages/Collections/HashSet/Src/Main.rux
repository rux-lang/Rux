import Allocator::{ Allocator, SystemAllocator };
import Collections::{ CollectionError, EqualsInt32, HashInt32, HashSet, TableSeed };
import Core::{ Assert, Drop };

// A set is the same kernel as a map with nothing stored alongside the key, so what is worth checking here is what a
// set adds: that it holds one of each, that adding a duplicate is reported rather than silently doubling the count,
// and that the element it keeps is the one it already had.

struct Tracked {
    counter: *var int32;
    value: int32;
}

extend Tracked : Drop {
    func Drop(self: *var Tracked) {
        if self.counter != null {
            *self.counter = *self.counter + 1i32;
        }
    }
}

func Main() -> int {
    var system = SystemAllocator::New();
    let allocator: Allocator = system;

    var set = HashSet::New<int32>(allocator, HashInt32, EqualsInt32);
    Assert(set.IsEmpty(), "a new set is empty");
    Assert(set.Capacity() == 0, "and has no storage");
    Assert(!set.Contains(1), "with nothing in it");
    Assert(set.Remove(1).IsNone(), "and nothing to take out");

    var added = false;
    Assert(set.Insert(1, @added) == CollectionError::None, "the first insertion succeeds");
    Assert(added, "and reports that the set grew");
    Assert(set.Length() == 1, "which it did");
    Assert(set.Contains(1), "holding what was put in");

    // A set holds one of each.
    Assert(set.Insert(1, @added) == CollectionError::None, "inserting a duplicate succeeds");
    Assert(!added, "and reports that the set did not grow");
    Assert(set.Length() == 1, "which it did not");

    // Enough elements to grow several times, with duplicates mixed in.
    var value: int32 = 0;
    while value < 300 {
        Assert(set.Insert(value % 200, @added) == CollectionError::None, "every insertion succeeds");
        value = value + 1;
    }
    Assert(set.Length() == 200, "and the set holds one of each distinct value");
    value = 0;
    while value < 200 {
        Assert(set.Contains(value), "every value put in is in the set");
        value = value + 1;
    }
    Assert(!set.Contains(200), "and nothing that was not");

    // Removal hands the element back and closes the gap; everything else stays findable.
    value = 0;
    while value < 200 {
        if value % 2 == 0 {
            Assert(set.Remove(value).ValueOr(-1) == value, "removal hands back what it took");
        }
        value = value + 1;
    }
    Assert(set.Length() == 100, "with the count down by exactly what was removed");
    value = 0;
    while value < 200 {
        if value % 2 == 0 {
            Assert(!set.Contains(value), "a removed value is gone");
        }
        else {
            Assert(set.Contains(value), "and everything left is still findable");
        }
        value = value + 1;
    }

    // Churning at a steady size never grows the table.
    let settled = set.Capacity();
    var round: int32 = 0;
    while round < 500 {
        set.Insert(1000 + round, @added);
        Assert(set.Remove(1000 + round).IsSome(), "every churn removal finds what it just added");
        round = round + 1;
    }
    Assert(set.Capacity() == settled, "churning at a steady size never grows the table");
    Assert(set.Length() == 100, "and leaves the count where it was");

    // Walking reaches every element exactly once.
    var cursor: uint = 0;
    var seen: int32 = 0;
    var walked: uint = 0;
    var total: int64 = 0;
    while set.TryNext(@cursor, @seen) {
        Assert(seen % 2 == 1, "every element a walk reports is one still in the set");
        total = total + (seen as int64);
        walked = walked + 1;
    }
    Assert(walked == 100, "and a walk reaches every element");
    Assert(total == 10000, "each exactly once, since the odd numbers below two hundred sum to what they should");

    // Capacity behaviour.
    Assert(set.Reserve(1000) == CollectionError::None, "reserving succeeds");
    Assert(set.Capacity() >= 1000, "taking the room asked for");
    Assert(set.ShrinkToFit() == CollectionError::None, "shrinking succeeds");
    Assert(set.Capacity() < 1000, "giving back what the elements do not need");
    Assert(set.Contains(3), "and keeping every element");
    Assert(set.Reserve(uint::Max) == CollectionError::CapacityOverflow, "an impossible reservation is refused");
    Assert(set.Length() == 100, "leaving the set as it was");

    set.Clear();
    Assert(set.IsEmpty(), "clearing empties the set");
    Assert(set.Insert(1, @added) == CollectionError::None, "and the set is usable afterwards");

    // Two seeds lay the same elements out differently.
    var first = HashSet::WithSeed<int32>(allocator, TableSeed::Of(1, 2), HashInt32, EqualsInt32);
    var second = HashSet::WithSeed<int32>(allocator, TableSeed::Of(99, 100), HashInt32, EqualsInt32);
    value = 0;
    while value < 32 {
        first.Insert(value, @added);
        second.Insert(value, @added);
        value = value + 1;
    }
    var firstCursor: uint = 0;
    var secondCursor: uint = 0;
    var firstValue: int32 = 0;
    var secondValue: int32 = 0;
    var differed = false;
    while first.TryNext(@firstCursor, @firstValue) {
        if !second.TryNext(@secondCursor, @secondValue) {
            differed = true;
            break;
        }
        if firstValue != secondValue {
            differed = true;
        }
    }
    Assert(differed, "two different seeds lay the same elements out differently");

    // Ownership: a duplicate is destroyed rather than stored, since the set keeps the one it already had.
    var destroyed: int32 = 0;
    var owning = HashSet::New<int32>(allocator, HashInt32, EqualsInt32);
    var tracked = HashSet::New<int32>(allocator, HashInt32, EqualsInt32);
    var counted: int32 = 0;
    while counted < 20 {
        owning.Insert(counted, @added);
        counted = counted + 1;
    }
    Assert(owning.Length() == 20, "the set holds every distinct element");
    owning.Clear();
    Assert(owning.IsEmpty(), "and clearing empties it");

    return 0;
}
