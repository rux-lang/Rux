import Core::{ uint };
import Allocator::{ Allocator, SystemAllocator };
import Collections::{ CollectionError, MinimumVectorCapacity, Vector };
import Core::{ Assert, Panic };

// A vector owns its storage and its elements, so the questions are an array's plus the ones growth raises: does
// capacity survive what length does, does a failed growth leave the vector as it was, and is every element destroyed
// exactly once however it left.

struct Tracked {
    counter: *var int32;
    value: int32;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked);

    func ~Tracked(self: &var Tracked) {
        if self.counter != null {
            *self.counter = *self.counter + 1;
        }
    }
}

/// Why an operation the test expects to fail failed. One that succeeds instead panics, so an expected failure
/// cannot pass by accident.
func Refusal<T, E>(outcome: T ! E) -> E {
    return match <-outcome {
        .Failure(error) => error,
        .Success(_) => Panic("the operation was expected to fail")
    };
}

// A scope for a vector of tracked elements, so its destruction happens somewhere observable. `afterPushing` reports
// what the counter read once everything was in, which is what separates the pushes from the destruction.
func PushAndDrop(allocator: Allocator, counter: *var int32, count: uint, afterPushing: *var int32)
    -> ! CollectionError {
    var vector = Vector<Tracked>(allocator);
    var index: uint = 0;
    while index < count {
        vector.Push(Tracked { counter: counter, value: index as int32 })?;
        index++;
    }
    Assert(vector.Length() == count, "the vector holds what was pushed into it");
    *afterPushing = *counter;
}

// Pops everything, which is a different path from the vector destroying them.
func PushThenPop(allocator: Allocator, counter: *var int32, count: uint) {
    var vector = Vector<Tracked>(allocator);
    var index: uint = 0;
    while index < count {
        vector.Push(Tracked { counter: counter, value: index as int32 }) catch {
            else => Panic("every push succeeds")
        };
        index++;
    }
    var taken = Tracked { counter: null, value: 0 };
    while vector.TryPop(@taken) {
        // `taken` holds the element that was moved out; the next round overwrites it and the last is destroyed here.
    }
    Assert(vector.IsEmpty(), "popping everything empties the vector");
}

// Drains a vector of tracked elements completely, letting each yielded element die here. Returns how many came out.
func DrainFully(allocator: Allocator, counter: *var int32, count: uint) -> uint {
    var vector = Vector<Tracked>(allocator);
    var index: uint = 0;
    while index < count {
        vector.Push(Tracked { counter: counter, value: index as int32 }) catch {
            else => Panic("every push succeeds")
        };
        index++;
    }
    var taken = (<-vector).IntoIterator();
    var yielded: uint = 0;
    // A fresh binding each round, so each element is owned by exactly one of them and destroyed when that round
    // ends. Reusing one binding would overwrite the previous element instead, and assignment destroys nothing.
    // Matched rather than unwrapped: matching an optional by value consumes it, so the arm's binding is the
    // payload's only owner and destroys it once when the arm ends.
    var draining = true;
    while draining {
        match taken.Next() {
            .Some(element) => {
                yielded = yielded + 1;
            },
            none => {
                draining = false;
            }
        }
    }
    return yielded;
}

// Stops part-way, so the iterator has to destroy what nobody took.
func DrainPartly(allocator: Allocator, counter: *var int32, count: uint, stopAfter: uint) {
    var vector = Vector<Tracked>(allocator);
    var index: uint = 0;
    while index < count {
        vector.Push(Tracked { counter: counter, value: index as int32 }) catch {
            else => Panic("every push succeeds")
        };
        index++;
    }
    var taken = (<-vector).IntoIterator();
    var yielded: uint = 0;
    var draining = true;
    while draining && yielded < stopAfter {
        match taken.Next() {
            .Some(element) => {
                yielded = yielded + 1;
            },
            none => {
                draining = false;
            }
        }
    }
}

func Main() -> ! CollectionError {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // A new vector allocates nothing at all.
    var numbers = Vector<int32>(allocator);
    Assert(numbers.IsEmpty(), "a new vector is empty");
    Assert(numbers.Length() == 0, "with no elements");
    Assert(numbers.Capacity() == 0, "and no storage");

    // The first push takes the minimum capacity rather than one element's worth.
    numbers.Push(10) catch { else => Panic("the first push succeeds") };
    Assert(numbers.Length() == 1, "and the vector holds it");
    Assert(numbers.Capacity() == MinimumVectorCapacity, "taking the minimum capacity rather than room for one");

    Assert(numbers.Get(0) == .Some(10), "the element is where it was put");
    Assert(numbers.Get(1) == none, "and there is nothing past it");

    // Capacity doubles rather than growing by one, so a run of pushes reallocates a handful of times.
    var index: uint = 0;
    while index < 100 {
        numbers.Push(index as int32) catch { else => Panic("every push succeeds") };
        index++;
    }
    Assert(numbers.Length() == 101, "the vector holds everything pushed");
    Assert(numbers.Capacity() >= 101, "with capacity to match");
    Assert(numbers.Capacity() <= 256, "and no more than a doubling would give");

    // Capacity is not length, and reserving changes only the former.
    let before = numbers.Capacity();
    numbers.Reserve(500) catch { else => Panic("reserving succeeds") };
    Assert(numbers.Capacity() >= 601, "and takes the room asked for on top of the length");
    Assert(numbers.Length() == 101, "without changing the length");
    Assert(numbers.Capacity() > before, "or leaving the capacity where it was");

    // Shrinking hands the spare back.
    numbers.ShrinkToFit() catch { else => Panic("shrinking succeeds") };
    Assert(numbers.Capacity() == numbers.Length(), "leaving capacity equal to length");
    Assert(numbers.Get(100) == .Some(99), "and every element still where it was");

    // Truncating drops the tail and keeps the storage.
    let kept = numbers.Capacity();
    numbers.Truncate(10);
    Assert(numbers.Length() == 10, "truncating shortens the vector");
    Assert(numbers.Capacity() == kept, "without giving back the storage");
    numbers.Truncate(50);
    Assert(numbers.Length() == 10, "and a length past the current one changes nothing");

    // Clearing empties it and keeps the storage.
    numbers.Clear();
    Assert(numbers.IsEmpty(), "clearing empties the vector");
    Assert(numbers.Capacity() == kept, "keeping the storage for the next round");
    numbers.Push(1) catch { else => Panic("which the next push uses") };
    Assert(numbers.Capacity() == kept, "without allocating again");

    // Shrinking an empty vector gives the storage back entirely.
    numbers.Clear();
    numbers.ShrinkToFit() catch { else => Panic("shrinking an empty vector succeeds") };
    Assert(numbers.Capacity() == 0, "and hands back everything");

    // A reservation that cannot be represented is refused as arithmetic, and changes nothing.
    numbers.Push(5) catch { else => Panic("a push before the overflow test succeeds") };
    let survived = numbers.Capacity();
    Assert(Refusal(numbers.Reserve(uint::Max)) == CollectionError::CapacityOverflow,
        "an impossible reservation is refused");
    Assert(numbers.Capacity() == survived, "leaving the capacity where it was");
    Assert(numbers.Length() == 1, "and the length");
    Assert(numbers.Get(0) == .Some(5), "and the elements");

    // Construction from a slice, and cloning.
    var source: int32[4];
    index = 0;
    while index < 4 {
        source[index] = (index * 3) as int32;
        index++;
    }
    let view = (@source[0])[..4];
    var copied = Vector::FromSlice<int32>(allocator, view) catch { else => Panic("a vector is made from a slice") };
    Assert(copied.Length() == 4, "holding every element");
    Assert(copied.Get(3) == .Some(9), "in order");

    var clone = copied.Clone() catch { else => Panic("cloning succeeds") };
    Assert(clone.Length() == copied.Length(), "with the same length");
    Assert(clone.AsSlice().data != copied.AsSlice().data, "over storage of its own");
    clone.Set(0, 77) catch { else => Panic("writing to the clone succeeds") };
    Assert(copied.Get(0) == .Some(0), "and leaves the original alone");

    // Iteration reads what is there and stops at the length rather than the capacity.
    var total: int32 = 0;
    for element in copied {
        total = total + element;
    }
    Assert(total == 18, "iterating covers every element and no spare capacity");

    // Destruction: the vector destroys exactly the elements it holds, once each, when its life ends — and pushing
    // destroys nothing at all, because handing a value to `Push` moves it in rather than copying it.
    var destroyed: int32 = 0;
    var afterPushing: int32 = 0;
    PushAndDrop(allocator, @destroyed, 7, @afterPushing) catch {
        else => Panic("a vector of tracked elements is filled")
    };
    Assert(afterPushing == 0, "pushing seven elements destroys none of them");
    Assert(destroyed == 7, "and destroying the vector destroys exactly those seven, once each");

    destroyed = 0;
    afterPushing = 0;
    PushAndDrop(allocator, @destroyed, 0, @afterPushing) catch { else => Panic("an empty one is made") };
    Assert(destroyed == 0, "and destroys nothing");

    // Popping moves elements out, so the vector destroys none of them and whoever took them does.
    destroyed = 0;
    PushThenPop(allocator, @destroyed, 5);
    // One, not five: popping moves each element out, and overwriting `taken` on each round destroys nothing —
    // assignment replaces a binding's value without destroying what was there — so the only destruction is the last
    // element, still held by `taken` when the function ended.
    Assert(destroyed == 1, "popping moves elements out rather than destroying them");

    // Truncating destroys exactly the elements it drops.
    destroyed = 0;
    var tracked = Vector<Tracked>(allocator);
    var explicitlyMoved = Tracked { counter: @destroyed, value: 41 };
    tracked.Push(<-explicitlyMoved) catch {
        else => Panic("a named move-only element transfers explicitly into the vector")
    };
    Assert(destroyed == 0, "the transfer does not destroy the element");
    tracked.Clear();
    Assert(destroyed == 1, "the vector becomes the element's sole owner");

    destroyed = 0;
    index = 0;
    while index < 6 {
        tracked.Push(Tracked { counter: @destroyed, value: 0 })?;
        index++;
    }
    Assert(destroyed == 0, "pushing destroys nothing");
    tracked.Truncate(2);
    Assert(destroyed == 4, "truncating destroys exactly the four elements it drops");
    tracked.Clear();
    Assert(destroyed == 6, "and clearing destroys the two that were left");

    // Insertion moves elements along and keeps order.
    var ordered = Vector<int32>(allocator);
    index = 0;
    while index < 4 {
        ordered.Push((index * 10) as int32)?;
        index++;
    }
    ordered.Insert(0, 99) catch { else => Panic("inserting at the front succeeds") };
    Assert(ordered.Get(0) == .Some(99), "putting the value there");
    Assert(ordered.Get(1) == .Some(0), "and moving what was there along");
    Assert(ordered.Length() == 5, "with one more element than before");
    ordered.Insert(5, 55) catch { else => Panic("inserting at exactly the length appends") };
    Assert(ordered.Get(5) == .Some(55), "putting it at the end");
    Assert(Refusal(ordered.Insert(7, 1)) == CollectionError::IndexOutOfRange,
        "and inserting past the length is refused");
    Assert(ordered.Length() == 6, "changing nothing");
    ordered.Insert(3, 77) catch { else => Panic("inserting in the middle succeeds") };
    Assert(ordered.Get(3) == .Some(77), "putting the value there");
    Assert(ordered.Get(4) == .Some(20), "and moving the rest along");

    // Removal keeps order and hands the element back.
    Assert(ordered.Length() == 7, "three insertions on four elements leave seven");
    Assert(ordered.RemoveAt(3) == .Some(77), "removal hands back what it took");
    Assert(ordered.Get(3) == .Some(20), "closing the gap behind it");
    Assert(ordered.Length() == 6, "with one fewer element");
    Assert(ordered.RemoveAt(6) == none, "removing past the end reports nothing");
    Assert(ordered.Length() == 6, "and changes nothing");

    // Swap-removal is constant time and does not keep order.
    let wasLast = ordered.Get(ordered.Length() - 1) ?? -1;
    Assert(ordered.SwapRemoveAt(0) == .Some(99), "swap-removal hands back what it took");
    Assert((ordered.Get(0) ?? -1) == wasLast, "and moves the last element into the gap");
    Assert(ordered.SwapRemoveAt(ordered.Length()) == none, "swap-removing past the end reports nothing");

    // The ends, and what an empty vector has instead of them.
    Assert(ordered.First() != none, "a non-empty vector has a first element");
    Assert(ordered.Last() != none, "and a last one");
    var nothing = Vector<int32>(allocator);
    Assert(nothing.First() == none, "an empty vector has no first element");
    Assert(nothing.Last() == none, "and no last one");

    // Slicing is clamped rather than refused, so a caller need not check twice.
    var span = Vector<int32>(allocator);
    index = 0;
    while index < 6 {
        span.Push(index as int32)?;
        index++;
    }
    Assert(span.Slice(2, 3).length == 3, "a slice inside the vector is its own length");
    Assert(span.Slice(2, 3).data[0] == 2, "starting where it was asked to");
    Assert(span.Slice(4, 10).length == 2, "a slice running past the end is clamped");
    Assert(span.Slice(6, 1).length == 0, "a slice starting at the end is empty");
    Assert(span.Slice(0, 0).length == 0, "and so is one of no elements");
    Assert(span.MutableSliceOf(1, 2).length == 2, "a writable slice is clamped the same way");

    // Consuming iteration moves every element out and takes the storage with it.
    var drained = Vector<int32>(allocator);
    index = 0;
    while index < 5 {
        drained.Push((index + 1) as int32)?;
        index++;
    }
    var sum: int32 = 0;
    var taken = (<-drained).IntoIterator();
    while true {
        let element = taken.Next() ?? break;
        sum = sum + element;
    }
    Assert(sum == 15, "consuming iteration yields every element");
    Assert(taken.Next() == none, "and stops once they are gone");

    // Every element leaves the vector exactly once, and is destroyed exactly once: by the arm that took it, or by
    // the iterator if nobody did.
    destroyed = 0;
    Assert(DrainFully(allocator, @destroyed, 6) == 6, "consuming iteration yields every element of a tracked vector");
    Assert(destroyed == 6, "each destroyed once, by the arm that took it");

    destroyed = 0;
    DrainPartly(allocator, @destroyed, 6, 2);
    Assert(destroyed == 6, "and stopping part-way destroys the two taken and the four left, once each");

    // Handing the storage to an array copies nothing.
    var moving = Vector<int32>(allocator);
    moving.Push(3)?;
    moving.Push(4)?;
    var fixed = (<-moving).IntoArray() catch { else => Panic("handing the storage to an array succeeds") };
    Assert(fixed.Length() == 2, "with every element");
    Assert(fixed.Get(0) == .Some(3) && fixed.Get(1) == .Some(4), "in order");
    // The block itself is handed over rather than the elements copied, though the trim that precedes the handover
    // may move it: an array's length is its capacity, and a vector's spare has to go before it can be one.
    Assert(fixed.AsSlice().data != null, "over storage the array now owns");

    var copying = Vector<int32>(allocator);
    copying.Push(8)?;
    var duplicated = copying.ToArray() catch { else => Panic("copying into an array succeeds") };
    Assert(duplicated.AsSlice().data != copying.AsSlice().data, "over storage of its own");

}
