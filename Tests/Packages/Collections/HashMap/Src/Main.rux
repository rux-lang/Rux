import Core::uint;
import Allocator::{ Allocator, SystemAllocator };
import Collections::{ CollectionError, EqualsInt32, HashInt32, HashMap, KeyValue, TableSeed };
import Core::{ Assert, Panic };

// A hash table is mostly interesting where it is full and where things have been removed from it, so what is checked
// is the state after churn: every key that should be there is, every key that should not is not, and the table has
// not quietly grown while entries were being added and taken away in equal measure.

struct Tracked {
    counter: *var int32;
    value: int32;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked);

    func ~Tracked(self: &var Tracked) {
        if self.counter != null {
            *self.counter = *self.counter + 1i32;
        }
    }
}

// A scope for a map of tracked values, so its destruction happens somewhere observable.
func FillAndDrop(allocator: Allocator, counter: *var int32, count: int32, afterFilling: *var int32) {
    var map = HashMap<int32, Tracked>(allocator, HashInt32, EqualsInt32);
    var key: int32 = 0;
    while key < count {
        map.Insert(key, Tracked { counter: counter, value: key })
            catch { else => Panic("every tracked insertion succeeds") };
        key = key + 1;
    }
    Assert(map.Length() == count as uint, "the map holds what was put into it");
    *afterFilling = *counter;
}

// Drains a map of tracked values completely, giving each yielded entry its own scope so it is owned by exactly one
// binding and destroyed once.
func DrainFully(allocator: Allocator, counter: *var int32, count: int32) -> uint {
    var map = HashMap<int32, Tracked>(allocator, HashInt32, EqualsInt32);
    var key: int32 = 0;
    while key < count {
        map.Insert(key, Tracked { counter: counter, value: key })
            catch { else => Panic("every tracked insertion succeeds") };
        key = key + 1;
    }
    var taken = (<-map).IntoIterator();
    var yielded: uint = 0;
    var draining = true;
    while draining {
        match taken.Next() {
            .Some(entry) => {
                yielded = yielded + 1;
            },
            none => {
                draining = false;
            }
        }
    }
    return yielded;
}

// Stops part-way, so the iterator has to destroy what nobody took.
func DrainPartly(allocator: Allocator, counter: *var int32, count: int32, stopAfter: uint) {
    var map = HashMap<int32, Tracked>(allocator, HashInt32, EqualsInt32);
    var key: int32 = 0;
    while key < count {
        map.Insert(key, Tracked { counter: counter, value: key })
            catch { else => Panic("every tracked insertion succeeds") };
        key = key + 1;
    }
    var taken = (<-map).IntoIterator();
    var yielded: uint = 0;
    var draining = true;
    while draining && yielded < stopAfter {
        match taken.Next() {
            .Some(entry) => {
                yielded = yielded + 1;
            },
            none => {
                draining = false;
            }
        }
    }
}

/// Why an operation the test expects to fail failed. One that succeeds instead panics, so an expected failure
/// cannot pass by accident.
func Refusal<T, E>(outcome: T ! E) -> E {
    return match <-outcome {
        .Failure(error) => error,
        .Success(_) => Panic("the operation was expected to fail")
    };
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // A new map allocates nothing.
    var map = HashMap<int32, int32>(allocator, HashInt32, EqualsInt32);
    Assert(map.IsEmpty(), "a new map is empty");
    Assert(map.Capacity() == 0, "and has no storage");
    Assert(!map.ContainsKey(1), "with nothing in it");
    Assert(map.Get(1) == none, "and nothing to read");
    Assert(map.Remove(1) == none, "and nothing to take out");

    // Insert and read back.
    map.Insert(1, 10) catch { else => Panic("the first insertion succeeds") };
    Assert(map.Length() == 1, "and the map holds it");
    Assert(map.ContainsKey(1), "under the key it was given");
    Assert(map.Get(1) == .Some(10), "with the value it was given");
    Assert(!map.ContainsKey(2), "and nothing under a key that was never inserted");

    // Inserting an existing key replaces the value and does not grow the map.
    map.Insert(1, 20) catch { else => Panic("reinserting a key succeeds") };
    Assert(map.Length() == 1, "without adding an entry");
    Assert(map.Get(1) == .Some(20), "and replaces the value");

    // Enough entries to grow the table several times.
    var key: int32 = 0;
    while key < 200 {
        map.Insert(key, key * 3) catch { else => Panic("every insertion succeeds") };
        key = key + 1;
    }
    Assert(map.Length() == 200, "the map holds every distinct key");
    key = 0;
    while key < 200 {
        Assert(map.Get(key) == .Some(key * 3), "and every key reads back what it was given");
        key = key + 1;
    }
    Assert(!map.ContainsKey(200), "with nothing under a key that was never inserted");
    Assert(!map.ContainsKey(-1), "at either end of the range");

    // Removal hands the value back and closes the gap. Every other key must still be findable afterwards, which is
    // what backward-shift deletion is for and what a missing tombstone would break.
    key = 0;
    while key < 200 {
        if key % 3 == 0 {
            Assert(map.Remove(key) == .Some(key * 3), "removal hands back the value it held");
        }
        key = key + 1;
    }
    key = 0;
    while key < 200 {
        if key % 3 == 0 {
            Assert(!map.ContainsKey(key), "a removed key is gone");
            Assert(map.Get(key) == none, "and reads back nothing");
        }
        else {
            Assert(map.Get(key) == .Some(key * 3), "and every key left is still findable");
        }
        key = key + 1;
    }
    Assert(map.Length() == 133, "with the count down by exactly what was removed");

    // Churning at a steady size must not grow the table: there are no tombstones to accumulate.
    let settled = map.Capacity();
    var round: int32 = 0;
    while round < 500 {
        map.Insert(1000 + round, round) catch { else => Panic("every churn insertion succeeds") };
        Assert(map.Remove(1000 + round) == .Some(round), "and every churn removal hands its value back");
        round = round + 1;
    }
    Assert(map.Capacity() == settled, "churning at a steady size never grows the table");
    Assert(map.Length() == 133, "and leaves the count where it was");

    // Reinserting removed keys finds room without growing, because the gaps really closed.
    key = 0;
    while key < 200 {
        if key % 3 == 0 {
            map.Insert(key, key * 3) catch { else => Panic("reinserting a removed key succeeds") };
        }
        key = key + 1;
    }
    Assert(map.Length() == 200, "and the map holds all of them again");
    key = 0;
    while key < 200 {
        Assert(map.Get(key) == .Some(key * 3), "with every key readable");
        key = key + 1;
    }

    // Walking the slots reaches every entry exactly once.
    var cursor: uint = 0;
    var seenKey: int32 = 0;
    var seenValue: int32 = 0;
    var walked: uint = 0;
    var total: int64 = 0;
    while map.TryNextEntry(@cursor, @seenKey, @seenValue) {
        Assert(seenValue == seenKey * 3, "every entry a walk reports is one that was put in");
        total = total + (seenKey as int64);
        walked = walked + 1;
    }
    Assert(walked == 200, "and a walk reaches every entry");
    Assert(total == 19900, "each of them exactly once, since the keys sum to what they should");

    // A pointer to a value reads it where it sits, and the mutable form changes it in place.
    let reading = map.Reference(7) ?? Panic("a present key has a value to point at");
    Assert(*reading == 21, "which reads what was stored");
    var writing: *var int32 = null;
    Assert(map.TryReferenceMutable(7, @writing), "and one that can be written through");
    *writing = 99;
    Assert(map.Get(7) == .Some(99), "which changes the stored value");
    Assert(!map.TryReferenceMutable(1000, @writing), "an absent key has nothing to point at");

    // Capacity behaviour.
    map.Reserve(1000) catch { else => Panic("reserving succeeds") };
    Assert(map.Capacity() >= 1000, "taking the room asked for");
    Assert(map.Length() == 200, "without changing the count");
    map.ShrinkToFit() catch { else => Panic("shrinking succeeds") };
    Assert(map.Capacity() < 1000, "giving back what the entries do not need");
    Assert(map.Get(11) == .Some(33), "and keeping every entry");
    Assert(Refusal(map.Reserve(uint::Max)) == CollectionError::CapacityOverflow,
           "an impossible reservation is refused");
    Assert(map.Length() == 200, "leaving the map as it was");

    map.Clear();
    Assert(map.IsEmpty(), "clearing empties the map");
    Assert(!map.ContainsKey(11), "with nothing left in it");
    map.Insert(1, 1) catch { else => Panic("and the map is usable afterwards") };

    // Two maps with different seeds hash the same keys differently, which is the whole point of seeding. What is
    // observable is the walk order, since that is the slot order and the slot order is the hash's.
    var first = HashMap::WithSeed<int32, int32>(allocator, TableSeed::Of(1, 2), HashInt32, EqualsInt32);
    var second = HashMap::WithSeed<int32, int32>(allocator, TableSeed::Of(99, 100), HashInt32, EqualsInt32);
    key = 0;
    while key < 32 {
        first.Insert(key, key) catch { else => Panic("the first seeded insertion succeeds") };
        second.Insert(key, key) catch { else => Panic("the second seeded insertion succeeds") };
        key = key + 1;
    }
    Assert(first.Length() == second.Length(), "two maps given the same keys hold the same number");

    var firstCursor: uint = 0;
    var secondCursor: uint = 0;
    var firstKey: int32 = 0;
    var secondKey: int32 = 0;
    var differed = false;
    while first.TryNextEntry(@firstCursor, @firstKey, null) {
        if !second.TryNextEntry(@secondCursor, @secondKey, null) {
            differed = true;
            break;
        }
        if firstKey != secondKey {
            differed = true;
        }
    }
    Assert(differed, "but two different seeds lay the same keys out differently");

    // A third map with the first one's seed lays them out identically, which says the difference was the seed and
    // not chance.
    var same = HashMap::WithSeed<int32, int32>(allocator, TableSeed::Of(1, 2), HashInt32, EqualsInt32);
    key = 0;
    while key < 32 {
        same.Insert(key, key) catch { else => Panic("the same-seeded insertion succeeds") };
        key = key + 1;
    }
    firstCursor = 0;
    var sameCursor: uint = 0;
    var matched = true;
    while first.TryNextEntry(@firstCursor, @firstKey, null) {
        var sameKey: int32 = 0;
        if !same.TryNextEntry(@sameCursor, @sameKey, null) {
            matched = false;
            break;
        }
        if firstKey != sameKey {
            matched = false;
        }
    }
    Assert(matched, "and the same seed lays them out the same way");

    // Ownership: values are destroyed with the map, and a removed one is handed over rather than destroyed.
    var destroyed: int32 = 0;
    var afterFilling: int32 = 0;
    FillAndDrop(allocator, @destroyed, 40, @afterFilling);
    Assert(afterFilling == 0, "filling a map destroys nothing");
    Assert(destroyed == 40, "and destroying it destroys every value exactly once");

    destroyed = 0;
    var owning = HashMap<int32, Tracked>(allocator, HashInt32, EqualsInt32);
    owning.Insert(1, Tracked { counter: @destroyed, value: 1 })
        catch { else => Panic("inserting a tracked value succeeds") };
    Assert(destroyed == 0, "inserting destroys nothing");
    owning.Insert(1, Tracked { counter: @destroyed, value: 2 })
        catch { else => Panic("replacing a tracked value succeeds") };
    Assert(destroyed == 1, "but replacing a value destroys the one it replaced");
    owning.Clear();
    Assert(destroyed == 2, "and clearing destroys what is left");

    // One operation where a lookup and an insertion would have been two, and the key named once.
    var lookup = HashMap<int32, int32>(allocator, HashInt32, EqualsInt32);
    var existing: *var int32 = null;
    var inserted = false;
    lookup.GetOrInsert(5, 50, @existing, @inserted) catch { else => Panic("get-or-insert succeeds") };
    Assert(inserted, "reporting that the map grew");
    Assert(*existing == 50, "and pointing at the value it put there");
    *existing = 55;
    Assert(lookup.Get(5) == .Some(55), "which is the stored value, not a copy of it");

    lookup.GetOrInsert(5, 999, @existing, @inserted) catch { else => Panic("asking again succeeds") };
    Assert(!inserted, "reporting that the map did not grow");
    Assert(*existing == 55, "and pointing at what was already there rather than what was offered");
    Assert(lookup.Length() == 1, "with the map still holding one entry");

    // Replacement hands the old value back, where Insert throws it away.
    let replaced = lookup.Replace(5, 60) catch { else => Panic("replacing reports no failure") };
    Assert(replaced == .Some(55), "replacing hands back what was there");
    Assert(lookup.Get(5) == .Some(60), "having stored the new value");
    let absent = lookup.Replace(6, 70) catch { else => Panic("replacing an absent key is not a failure") };
    Assert(absent == none, "replacing an absent key hands back nothing");
    Assert(lookup.Get(6) == .Some(70), "having inserted it");

    // Consuming removal hands back both halves.
    let entry = lookup.RemoveEntry(5) ?? Panic("removing an entry finds it");
    Assert(entry.key == 5 && entry.value == 60, "and hands back the key as well as the value");
    Assert(!lookup.ContainsKey(5), "leaving the map without it");
    Assert(!(lookup.RemoveEntry(5) is KeyValue<int32, int32>), "and a second removal finds nothing");

    // Iterating with a `for` loop reaches every entry exactly once.
    var loops = HashMap<int32, int32>(allocator, HashInt32, EqualsInt32);
    key = 0;
    while key < 50 {
        loops.Insert(key, key * 2) catch { else => Panic("every loop insertion succeeds") };
        key = key + 1;
    }
    var iterated: uint = 0;
    var sum: int64 = 0;
    for pair in loops {
        Assert(pair.value == pair.key * 2, "every entry a loop yields is one that was put in");
        sum = sum + (pair.key as int64);
        iterated = iterated + 1;
    }
    Assert(iterated == 50, "and a loop reaches every entry");
    Assert(sum == 1225, "each exactly once, since the keys sum to what they should");

    // Consuming iteration moves every entry out and takes the storage with it.
    var drained = HashMap<int32, int32>(allocator, HashInt32, EqualsInt32);
    key = 0;
    while key < 20 {
        drained.Insert(key, key + 100) catch { else => Panic("every insertion before draining succeeds") };
        key = key + 1;
    }
    var moving = (<-drained).IntoIterator();
    var moved: uint = 0;
    var movedSum: int64 = 0;
    var draining = true;
    while draining {
        match moving.Next() {
            .Some(pair) => {
                movedSum = movedSum + (pair.value as int64);
                moved = moved + 1;
            },
            none => {
                draining = false;
            }
        }
    }
    Assert(moved == 20, "consuming iteration yields every entry");
    Assert(movedSum == 2190, "each exactly once");

    // Every value leaves exactly once, and stopping part-way destroys only what is left.
    destroyed = 0;
    Assert(DrainFully(allocator, @destroyed, 12) == 12, "consuming iteration yields every tracked entry");
    Assert(destroyed == 12, "each destroyed once, by the arm that took it");

    destroyed = 0;
    DrainPartly(allocator, @destroyed, 12, 5);
    Assert(destroyed == 12, "and stopping part-way destroys the five taken and the seven left, once each");

    return 0;
}
