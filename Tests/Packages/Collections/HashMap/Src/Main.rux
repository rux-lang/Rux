import Collections::CollectionError;
import Collections::HashMap;
import Collections::{ EqualsInt32, EqualsInt64, HashInt32, HashInt64 };

// See Tests/Packages/Collections/Array for why a failed check reports itself
// through a numbered exit code rather than through an assertion.

struct Point {
    x: int64;
    y: int64;
}

// Every key lands in the same bucket, so the whole table becomes one probe
// chain. Insertion, lookup, removal and tombstone reuse all have to survive it.
func CollideAll(key: int32) -> uint {
    return 0u;
}

// Keys that differ only above the low bit hash together but are not equal, so
// equality has to be what separates them rather than the hash.
func HashLowBit(key: int32) -> uint {
    return (key % 2) as uint;
}

func Main() -> int {
    // An empty map allocates nothing and finds nothing.
    var empty = HashMap::New<int32, int32>(HashInt32, EqualsInt32);
    var got: int32 = -1;
    if !empty.IsEmpty() || empty.Length() != 0 || empty.Capacity() != 0 { return 10; }
    if empty.ContainsKey(1) { return 11; }
    if empty.TryGet(1, @got) { return 12; }
    if empty.TryRemove(1, @got) { return 13; }
    var cursor: uint = 0;
    if empty.TryNextEntry(@cursor, null, null) { return 14; }

    // The first insertion builds the table.
    var map = HashMap::New<int32, int32>(HashInt32, EqualsInt32);
    var inserted = false;
    if !(map.Insert(1, 100, null, @inserted) == CollectionError::None) { return 20; }
    if !inserted || map.Length() != 1 || map.Capacity() != 8 { return 21; }
    if !map.ContainsKey(1) || !map.TryGet(1, @got) || got != 100 { return 22; }
    if map.ContainsKey(2) || map.TryGet(2, @got) { return 23; }
    if got != 100 { return 24; }

    // Reinserting an existing key replaces the value, reports that nothing was
    // added, and hands back what was displaced.
    var previous: int32 = -1;
    if !(map.Insert(1, 101, @previous, @inserted) == CollectionError::None) { return 30; }
    if inserted || previous != 100 || map.Length() != 1 { return 31; }
    if !map.TryGet(1, @got) || got != 101 { return 32; }

    // Both out-parameters are optional.
    if !(map.Insert(1, 102, null, null) == CollectionError::None) { return 33; }
    if !map.TryGet(1, @got) || got != 102 || map.Length() != 1 { return 34; }

    // A pointer to the value updates it in place.
    var slot: *var int32 = null;
    if !map.TryGetPointer(1, @slot) || slot == null { return 35; }
    *slot = 103;
    if !map.TryGet(1, @got) || got != 103 { return 36; }
    if map.TryGetPointer(9, @slot) { return 37; }

    // Every key colliding into one bucket still round-trips.
    var collided = HashMap::New<int32, int32>(CollideAll, EqualsInt32);
    var k: int32 = 0;
    while k < 20 {
        if !(collided.Insert(k, k * 10, null, @inserted) == CollectionError::None) { return 40; }
        if !inserted { return 41; }
        k++;
    }
    if collided.Length() != 20 { return 42; }
    k = 0;
    while k < 20 {
        if !collided.TryGet(k, @got) || got != k * 10 { return 43; }
        k++;
    }
    if collided.ContainsKey(20) { return 44; }

    // Removing from the middle of one long chain leaves the rest reachable:
    // a probe has to run past a tombstone rather than stop at it.
    k = 0;
    while k < 20 {
        if k % 2 == 0 {
            if !collided.TryRemove(k, @got) || got != k * 10 { return 45; }
        }
        k++;
    }
    if collided.Length() != 10 { return 46; }
    k = 1;
    while k < 20 {
        if !collided.TryGet(k, @got) || got != k * 10 { return 47; }
        k = k + 2;
    }
    if collided.TryRemove(0, @got) { return 48; }
    collided.Free();

    // A hash that maps distinct keys together relies on equality to separate
    // them, and must not merge them.
    var shared = HashMap::New<int32, int32>(HashLowBit, EqualsInt32);
    if !(shared.Insert(2, 20, null, null) == CollectionError::None) { return 50; }
    if !(shared.Insert(4, 40, null, null) == CollectionError::None) { return 51; }
    if !(shared.Insert(3, 30, null, null) == CollectionError::None) { return 52; }
    if shared.Length() != 3 { return 53; }
    if !shared.TryGet(2, @got) || got != 20 { return 54; }
    if !shared.TryGet(4, @got) || got != 40 { return 55; }
    if !shared.TryGet(3, @got) || got != 30 { return 56; }
    shared.Free();

    // Removing and reinserting the same key reuses the tombstone rather than
    // consuming a fresh slot, so the capacity does not creep upward.
    var churn = HashMap::New<int32, int32>(HashInt32, EqualsInt32);
    if !(churn.Insert(7, 1, null, null) == CollectionError::None) { return 60; }
    let steadyCapacity = churn.Capacity();
    var round: int32 = 0;
    while round < 200 {
        if !churn.TryRemove(7, null) { return 61; }
        if !(churn.Insert(7, round, null, @inserted) == CollectionError::None) { return 62; }
        if !inserted { return 63; }
        round++;
    }
    if churn.Length() != 1 { return 64; }
    if churn.Capacity() != steadyCapacity { return 65; }
    if !churn.TryGet(7, @got) || got != 199 { return 66; }
    churn.Free();

    // Growing past the load factor rehashes and keeps every entry.
    var many = HashMap::New<int32, int32>(HashInt32, EqualsInt32);
    var i: int32 = 0;
    while i < 500 {
        if !(many.Insert(i, i * 3, null, @inserted) == CollectionError::None) { return 70; }
        if !inserted { return 71; }
        i++;
    }
    if many.Length() != 500 { return 72; }
    if many.Capacity() < 668 { return 73; }
    i = 0;
    while i < 500 {
        if !many.TryGet(i, @got) || got != i * 3 { return 74; }
        i++;
    }

    // The table keeps at least a quarter of its slots free.
    if many.Length() > many.Capacity() - (many.Capacity() / 4) { return 75; }

    // Traversal visits every live entry exactly once, in whatever order the
    // table holds them.
    var visited: int64 = 0;
    var count: uint = 0;
    var key: int32 = 0;
    var value: int32 = 0;
    cursor = 0;
    while many.TryNextEntry(@cursor, @key, @value) {
        if value != key * 3 { return 80; }
        visited = visited + (key as int64);
        count++;
    }
    if count != 500 { return 81; }
    if visited != 124750i64 { return 82; }

    // Either half of an entry can be declined.
    cursor = 0;
    count = 0;
    while many.TryNextEntry(@cursor, @key, null) {
        count++;
    }
    if count != 500 { return 83; }
    cursor = 0;
    count = 0;
    while many.TryNextEntry(@cursor, null, @value) {
        count++;
    }
    if count != 500 { return 84; }

    // Clone is independent, and keeps the same functions.
    var copy = HashMap::New<int32, int32>(HashInt32, EqualsInt32);
    if !(many.Clone(@copy) == CollectionError::None) { return 90; }
    if copy.Length() != many.Length() || copy.Capacity() != many.Capacity() { return 91; }
    if !copy.TryGet(499, @got) || got != 1497 { return 92; }
    if !(copy.Insert(1000, 5, null, null) == CollectionError::None) { return 93; }
    if many.ContainsKey(1000) { return 94; }
    if !copy.TryRemove(0, null) { return 95; }
    if !many.ContainsKey(0) { return 96; }
    copy.Free();
    many.Free();

    // Reserve sizes ahead so a run of insertions does not rehash.
    var sized = HashMap::New<int32, int32>(HashInt32, EqualsInt32);
    if !(sized.Reserve(100) == CollectionError::None) { return 100; }
    let reserved = sized.Capacity();
    if reserved < 134 { return 101; }
    i = 0;
    while i < 100 {
        if !(sized.Insert(i, i, null, null) == CollectionError::None) { return 102; }
        i++;
    }
    if sized.Capacity() != reserved { return 103; }

    // Clear keeps the table and drops the tombstones with the entries.
    sized.Clear();
    if !sized.IsEmpty() || sized.Capacity() != reserved { return 104; }
    if sized.ContainsKey(0) { return 105; }
    if !(sized.Insert(1, 1, null, @inserted) == CollectionError::None) { return 106; }
    if !inserted || sized.Capacity() != reserved { return 107; }

    // Shrinking rebuilds at the smallest capacity the entries need, and an
    // emptied map releases its table entirely.
    if !(sized.ShrinkToFit() == CollectionError::None) { return 108; }
    if sized.Capacity() != 8 || sized.Length() != 1 { return 109; }
    if !sized.TryGet(1, @got) || got != 1 { return 110; }
    if !sized.TryRemove(1, null) { return 111; }
    if !(sized.ShrinkToFit() == CollectionError::None) { return 112; }
    if sized.Capacity() != 0 || !sized.IsEmpty() { return 113; }
    sized.Free();

    // Keys and values wider than one machine word.
    var points = HashMap::New<int64, Point>(HashInt64, EqualsInt64);
    let origin = Point { x: 1i64, y: 2i64 };
    let far = Point { x: 30i64, y: 40i64 };
    var readPoint = Point { x: 0i64, y: 0i64 };
    if !(points.Insert(1i64, origin, null, null) == CollectionError::None) { return 120; }
    if !(points.Insert(2i64, far, null, null) == CollectionError::None) { return 121; }
    if !points.TryGet(2i64, @readPoint) || readPoint.x != 30i64 || readPoint.y != 40i64 { return 122; }
    if !points.TryRemove(1i64, @readPoint) || readPoint.y != 2i64 { return 123; }
    if points.Length() != 1 { return 124; }
    points.Free();

    // A reservation whose table cannot be addressed is rejected before any
    // allocation, and the map stays usable.
    var huge = HashMap::New<int64, Point>(HashInt64, EqualsInt64);
    if !(huge.Insert(5i64, origin, null, null) == CollectionError::None) { return 130; }
    if !(huge.Reserve(uint::Max) == CollectionError::CapacityOverflow) { return 131; }
    if huge.Length() != 1 || !huge.ContainsKey(5i64) { return 132; }
    huge.Free();

    empty.Free();
    return 0;
}
