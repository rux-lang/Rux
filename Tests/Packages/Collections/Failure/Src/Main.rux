import Allocator::{ Allocator, SystemAllocator };
import Collections::CollectionError;
import Collections::Deque;
import Collections::HashMap;
import Collections::HashSet;
import Collections::Vector;
import Collections::{ EqualsInt32, HashInt32 };

// The cross-cutting axis: what every container does when an operation cannot
// be completed. Two things are checked here that the per-type tests do not.
//
// First, that the failure modes stay distinguishable. An exhausted allocator,
// an unaddressable capacity and a rejected index are three different answers,
// and a caller has to be able to tell them apart.
//
// Second, that a failed operation changes nothing. Every check below reads the
// whole container back afterwards, because the defect this package was
// rewritten to fix was exactly a failure that left a container claiming
// storage it did not own.
//
// Out-of-memory itself cannot be forced portably, so it is not exercised
// directly; it shares its reporting path with the overflow cases that are.
//
// See Tests/Packages/Collections/Array for the numbered exit-code convention.

func Main() -> int {
    // The error cases are distinct values, so no two failures can be confused.
    if CollectionError::None == CollectionError::OutOfMemory { return 10; }
    if CollectionError::None == CollectionError::CapacityOverflow { return 11; }
    if CollectionError::None == CollectionError::IndexOutOfRange { return 12; }
    if CollectionError::OutOfMemory == CollectionError::CapacityOverflow { return 13; }
    if CollectionError::OutOfMemory == CollectionError::IndexOutOfRange { return 14; }
    if CollectionError::CapacityOverflow == CollectionError::IndexOutOfRange { return 15; }
    if !(CollectionError::None == CollectionError::None) { return 16; }

    // A count whose byte size cannot be addressed is rejected before anything is allocated. Array now takes an
    // allocator and is covered by its own test; what stays here is the Vector side.

    var system = SystemAllocator();
    let allocator: Allocator = system;

    var overflowError = CollectionError::None;
    var vector = Vector::WithCapacity<int64>(allocator, uint::Max, @overflowError);
    if !(overflowError == CollectionError::CapacityOverflow) { return 22; }
    if !vector.IsEmpty() || vector.AsSlice().data != null || vector.Capacity() != 0 { return 23; }

    var dequeError = CollectionError::None;
    var deque = Deque::WithCapacity<int64>(allocator, uint::Max, @dequeError);
    if !(dequeError == CollectionError::CapacityOverflow) { return 24; }
    if !deque.IsEmpty() || deque.Capacity() != 0 { return 25; }

    // A populated Vector survives a rejected reservation untouched: the same
    // block, the same length, the same capacity, the same elements.
    var populated = Vector<int64>(allocator);
    var element: int64 = 0;
    while element < 8i64 {
        if !(populated.Push(element) == CollectionError::None) { return 30; }
        element++;
    }

    let block = populated.AsSlice().data;
    let length = populated.Length();
    let capacity = populated.Capacity();

    // The length plus the request wraps.
    if !(populated.Reserve(uint::Max) == CollectionError::CapacityOverflow) { return 31; }
    if populated.AsSlice().data != block || populated.Length() != length { return 32; }
    if populated.Capacity() != capacity { return 33; }

    // The sum fits but its byte size does not, which is the other way the same
    // request fails.
    if !(populated.Reserve(uint::Max / 4) == CollectionError::CapacityOverflow) { return 34; }
    if populated.AsSlice().data != block || populated.Length() != length { return 35; }
    if populated.Capacity() != capacity { return 36; }

    element = 0;
    while element < 8i64 {
        if populated.Get(element as uint).ValueOr(-1i64) != element { return 37; }
        element++;
    }

    // A bulk append is checked the same way, and a rejected one appends
    // nothing rather than part of its input.
    let borrowed = populated.AsSlice();
    let hostile = Slice<int64> { data: borrowed.data, length: uint::Max };
    if !(populated.PushSlice(hostile) == CollectionError::CapacityOverflow) { return 40; }
    if populated.AsSlice().data != block || populated.Length() != length { return 41; }
    if populated.Capacity() != capacity { return 42; }

    // A rejected index is reported as itself, not as an exhausted allocator, and the container is left alone.
    if !(populated.Set(populated.Length(), 99i64) == CollectionError::IndexOutOfRange) { return 50; }
    if populated.Length() != length || populated.AsSlice().data != block { return 51; }
    if populated.Get(0).ValueOr(-1i64) != 0i64 { return 52; }

    // Reading past the end is an ordinary absence rather than a failure, and reads nothing.
    if populated.Get(populated.Length()).IsSome() { return 53; }
    if populated.Reference(populated.Length()).IsSome() { return 54; }

    // Insert, RemoveAt and SwapRemoveAt return with C04; the rejections they report are covered there.

    // A Deque rejects the same requests and stays usable afterwards.
    var ring = Deque<int64>(allocator);
    if !(ring.PushBack(1i64) == CollectionError::None) { return 60; }
    let ringCapacity = ring.Capacity();
    if !(ring.Reserve(uint::Max) == CollectionError::CapacityOverflow) { return 61; }
    if ring.Length() != 1 || ring.Capacity() != ringCapacity { return 62; }
    if ring.Get(0).ValueOr(-1i64) != 1i64 { return 67; }
    if !(ring.Reserve(uint::Max / 4) == CollectionError::CapacityOverflow) { return 63; }
    if ring.Length() != 1 || ring.Capacity() != ringCapacity { return 64; }
    if !(ring.PushFront(0i64) == CollectionError::None) { return 65; }
    if ring.Get(0).ValueOr(-1i64) != 0i64 || ring.Get(1).ValueOr(-1i64) != 1i64 { return 66; }

    // A hash table rejects an unsizeable reservation and keeps every entry.
    var map = HashMap<int32, int32>(allocator, HashInt32, EqualsInt32);
    if !(map.Insert(1, 10) == CollectionError::None) { return 70; }
    if !(map.Insert(2, 20) == CollectionError::None) { return 71; }
    let mapCapacity = map.Capacity();
    if !(map.Reserve(uint::Max) == CollectionError::CapacityOverflow) { return 72; }
    if map.Length() != 2 || map.Capacity() != mapCapacity { return 73; }
    if map.Get(1).ValueOr(-1) != 10 { return 74; }

    // A set rejects it the same way.
    var set = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    var added = false;
    if !(set.Insert(1, @added) == CollectionError::None) { return 80; }
    let setCapacity = set.Capacity();
    if !(set.Reserve(uint::Max) == CollectionError::CapacityOverflow) { return 81; }
    if set.Length() != 1 || set.Capacity() != setCapacity { return 82; }
    if !set.Contains(1) { return 83; }

    // Every container releases what it owns when its life ends; nothing here has a Free to call twice.
    return 0;
}
