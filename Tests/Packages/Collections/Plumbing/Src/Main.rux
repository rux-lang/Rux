import Core::{ uint };
import Allocator::AllocError;
import Collections::{ CollectionError, FromAllocError, ReferenceIterator, ValueIterator };
import Core::Assert;

// The plumbing every container shares: what an error means, and what the iterators yield. None of it is
// interesting on its own, which is exactly why it is worth testing once here rather than discovering it through
// whichever container gets it wrong.
//
// The allocator helpers used to be checked here directly. They are package-private now — they are how a container
// talks to an allocator in elements rather than bytes, not something a caller composes with — so what they do is
// checked through the containers instead, in Tests/Packages/Collections/ContainerStorage. That is the better place for it:
// it exercises the surface a caller can actually reach.

func Main() -> int {
    // The error's own questions.
    Assert(CollectionError::None.IsOk(), "None is the only value that reports success");
    Assert(!CollectionError::None.IsError(), "and the only one that is not an error");
    Assert(CollectionError::OutOfMemory.IsError(), "running out of memory is an error");
    Assert(CollectionError::CapacityOverflow.IsError(), "and so is arithmetic that does not fit");
    Assert(CollectionError::IndexOutOfRange.IsError(), "and an index the collection does not have");
    Assert(CollectionError::OutOfMemory.IsTransient(), "an allocator that ran short may not have next time");
    Assert(!CollectionError::CapacityOverflow.IsTransient(), "but a size that cannot be named will not start being");
    Assert(!CollectionError::IndexOutOfRange.IsTransient(), "and an absent index will not appear");
    Assert(!CollectionError::Unsupported.IsTransient(), "and a refused layout will be refused again");
    Assert(!CollectionError::None.IsTransient(), "success is not a thing to retry");

    // The mapping from the allocator's answers to this package's.
    Assert(FromAllocError(AllocError::None) == CollectionError::None, "success maps to success");
    Assert(FromAllocError(AllocError::OutOfMemory) == CollectionError::OutOfMemory, "a shortage maps to a shortage");
    Assert(FromAllocError(AllocError::Unsupported) == CollectionError::Unsupported, "a refusal maps to a refusal");
    Assert(FromAllocError(AllocError::InvalidBlock) == CollectionError::Unsupported,
           "and so does a block the allocator did not hand out, which is the same thing from here");

    // The iterators, over a run the test owns.
    var values: int32[5];
    var index: uint = 0;
    while index < 5 {
        values[index] = (index * 10) as int32;
        index++;
    }
    let items = (@values[0])[..5];

    var byValue = ValueIterator<int32>(items);
    var seen: uint = 0;
    var total: int32 = 0;
    for value in byValue {
        total = total + value;
        seen = seen + 1;
    }
    Assert(seen == 5, "the value iterator yields every element");
    Assert(total == 100, "and yields the elements themselves");

    // An iterator driven to its end keeps reporting nothing.
    var drained = ValueIterator<int32>(items);
    var drawn: int32 = 0;
    seen = 0;
    while drained.Next().TryIntoValue(@drawn) {
        seen = seen + 1;
    }
    Assert(seen == 5, "driving an iterator by hand yields every element");
    Assert(drained.Next().IsNone(), "and an exhausted iterator stays exhausted");

    // A `for` loop over an iterator walks a copy of it, so the iterator the caller holds is where it was. Worth
    // knowing rather than discovering: a loop is not a way to advance an iterator someone else is also reading.
    var untouched = ValueIterator<int32>(items);
    for value in untouched {
        seen = seen + 1;
    }
    Assert(untouched.Next().IsSome(), "a loop over an iterator leaves the caller's own where it was");

    // Nothing to walk yields nothing, rather than one of something.
    var nothing = ValueIterator<int32>([]);
    Assert(nothing.Next().IsNone(), "an empty run yields nothing at once");

    // The reference iterator borrows each element where it sits.
    var byReference = ReferenceIterator<int32>(items);
    seen = 0;
    var readBack: int32 = 0;
    for element in byReference {
        readBack = readBack + *element;
        seen = seen + 1;
    }
    Assert(seen == 5, "the reference iterator yields every element");
    Assert(readBack == 100, "and each pointer reads the element it borrowed");

    // Both iterators walk the same run and agree about what is in it, which is the one thing they must.
    var counted = ValueIterator<int32>(items);
    var borrowed = ReferenceIterator<int32>(items);
    var value: int32 = 0;
    var element: *int32 = null;
    while counted.Next().TryIntoValue(@value) {
        Assert(borrowed.Next().TryIntoValue(@element), "the two iterators end together");
        Assert(*element == value, "and agree element for element");
    }
    Assert(borrowed.Next().IsNone(), "and neither has anything left");

    return 0;
}
