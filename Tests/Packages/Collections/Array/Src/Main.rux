import Core::{ uint };
import Allocator::{ Allocator, SystemAllocator };
import Collections::{ Array, CollectionError };
import Core::{ Assert, Panic };

// An array owns its storage and its elements, so the questions worth asking are about ownership: does destroying one
// destroy what it holds, exactly once, and does a failed construction leave anything behind. Counting destructions is
// the only way to see that, so the element type counts them.

// The counter lives where the test put it. The element only points at it, so destroying an element is observable and
// the count survives the element.
struct Tracked {
    counter: *var int32;
    value: int32;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked) {
        self.counter = other.counter;
        self.value = other.value;
    }

    func ~Tracked(self: &var Tracked) {
        if self.counter != null {
            *self.counter = *self.counter + 1;
        }
    }
}

/// Why an operation the test expects to fail failed. One that succeeds instead panics, so an expected failure
/// cannot pass by accident.
func Refusal<T, E>(outcome: T ! E) -> E {
    return match <-outcome {
        .Failure(error) => error,
        .Success(_) => Panic("the operation was expected to fail")
    };
}

// A scope for an array, so its destruction happens somewhere observable.
func FillAndDrop(allocator: Allocator, counter: *var int32, length: uint) -> ! CollectionError {
    var array = Array::Filled<Tracked>(allocator, length, Tracked { counter: counter, value: 5 })?;
    Assert(array.Length() == length, "the array is the length it was asked for");
}

func SumOf(allocator: Allocator) -> int32 {
    var values: int32[4];
    values[0] = 1;
    values[1] = 2;
    values[2] = 3;
    values[3] = 4;
    var array = Array::FromSlice<int32>(allocator, (@values[0])[..4]) catch {
        else => Panic("an array of numbers is made")
    };

    var total: int32 = 0;
    for value in array {
        total = total + value;
    }
    return total;
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // The ordinary shape: numbers copied in, walked, and released with the array.
    Assert(SumOf(allocator) == 10, "an array holds what was copied into it and iterates over it");

    // Filling with a value copies it into every position.
    var filled = Array::Filled<int32>(allocator, 6, 7) catch { else => Panic("a filled array is made") };
    Assert(filled.Length() == 6, "with the length asked for");
    Assert(!filled.IsEmpty(), "and is not empty");
    var index: uint = 0;
    while index < 6 {
        let value = filled.Get(index) ?? Panic("every index has an element");
        Assert(value == 7, "and every element is the value it was filled with");
        index++;
    }
    Assert(filled.Get(6) == none, "one past the end has no element");
    Assert(filled.Reference(6) == none, "and no pointer either");

    // Setting replaces an element and refuses an index the array does not have.
    filled.Set(2, 99) catch { else => Panic("setting an element in range succeeds") };
    Assert(filled.Get(2) == .Some(99), "and replaces what was there");
    Assert(Refusal(filled.Set(6, 1)) == CollectionError::IndexOutOfRange, "setting past the end is refused");
    Assert(filled.Get(5) == .Some(7), "changing nothing");

    // A borrowed view is what the algorithms take, and it sees the array's own storage.
    let view = filled.AsSlice();
    Assert(view.length == 6, "the view is the whole array");
    Assert(view.data == filled.AsSlice().data, "over the array's own storage");

    // An empty array owns a block it still releases, and is not a special shape anywhere.
    var empty = Array::Filled<int32>(allocator, 0, 0) catch { else => Panic("an empty array is made") };
    Assert(empty.IsEmpty(), "and is empty");
    Assert(empty.Length() == 0, "with no elements");
    Assert(empty.Get(0) == none, "and nothing at any index");

    // A length that cannot be sized is refused as arithmetic.
    Assert(Refusal(Array::Filled<int32>(allocator, uint::Max, 0)) == CollectionError::CapacityOverflow,
        "a length that cannot be sized is refused");

    // Destruction: every element of an array is destroyed exactly once when the array's life ends.
    // `Filled` copies its value into every position, then destroys the source parameter when the call ends.
    // rather than copied and destroyed, so the count is the length exactly. An element type that owns something
    // could not be filled this way at all — the copies would each claim what one of them owns — which is why the
    // element here owns nothing but a pointer to the counter.
    var destroyed: int32 = 0;
    FillAndDrop(allocator, @destroyed, 5) catch { else => Panic("an array of tracked elements is made") };
    Assert(destroyed == 6, "and destroys every element plus the source parameter exactly once");

    destroyed = 0;
    FillAndDrop(allocator, @destroyed, 1) catch { else => Panic("a single-element array is made") };
    Assert(destroyed == 2, "and destroys its element and source parameter once");

    // One for a length of zero: the value was handed over and never copied anywhere, so `Filled` destroys its
    // parameter rather than leaving it to nobody.
    destroyed = 0;
    FillAndDrop(allocator, @destroyed, 0) catch { else => Panic("an empty array of them is made") };
    Assert(destroyed == 1, "and destroys the value it was given but never stored");

    destroyed = 0;
    FillAndDrop(allocator, @destroyed, 32) catch { else => Panic("a longer array is made") };
    Assert(destroyed == 33, "with one destruction per element plus the source parameter");

    return 0;
}
