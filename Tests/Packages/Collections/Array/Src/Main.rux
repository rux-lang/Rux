import Core::{ uint };
import Allocator::{ Allocator, SystemAllocator };
import Collections::{ Array, CollectionError, Vector };
import Core::{ Assert, Panic };

// An array owns its storage and its elements, so the questions worth asking are about ownership and failure: what
// each constructor copies in, and whether a failed construction leaves anything behind.

// The counter lives where the test put it. The element only points at it, so destroying an element is observable and
// the count survives the element.
struct Tracked {
    counter: *var int32;
    value: int32;
}

extend Tracked {
    func ~Tracked(&var self) {
        if self.counter != null {
            // Safety: a non-null counter points at a local of the test that outlives every element.
            unsafe { *self.counter = *self.counter + 1; }
        }
    }
}

// Sets and replaces elements of a two-element array, then lets it go. The elements own nothing but a pointer to a
// counter, so destroying one is observable; they come from a vector because filling copies, and a type with a
// destructor is move-only.
func SetAndReplace(allocator: Allocator, destroyed: *var int32, replacements: *var int32) {
    var items = Vector<Tracked>(allocator);
    items.Push(Tracked { counter: destroyed, value: 1 });
    items.Push(Tracked { counter: destroyed, value: 2 });
    var array = (move items).IntoArray();
    // Safety: `destroyed` points at a local of `Main`, which outlives this call.
    Assert(unsafe { *destroyed == 0 }, "moving the elements into the array destroys none of them");
    try array.Set(0, Tracked { counter: replacements, value: 10 }) catch { _ => Panic("setting an element succeeds") };
    // Safety: `destroyed` points at a local of `Main`, which outlives this call.
    Assert(unsafe { *destroyed == 1 }, "setting destroys the element it replaces");
    // Safety: `replacements` points at a local of `Main`, which outlives this call.
    Assert(unsafe { *replacements == 0 }, "and not the one it stores");
    try {
        array.Set(2, Tracked { counter: replacements, value: 99 });
        Panic("the operation was expected to fail");
    } catch {
        refusal => Assert(refusal == CollectionError::IndexOutOfRange, "setting past the end is refused"),
    }
    // Safety: `replacements` points at a local of `Main`, which outlives this call.
    Assert(unsafe { *replacements == 1 }, "destroying the refused value rather than leaking it");
    var previous = try array.Replace(1, Tracked { counter: destroyed, value: 20 }) catch {
        _ => Panic("replacing an element succeeds")
    };
    // Safety: `destroyed` points at a local of `Main`, which outlives this call.
    Assert(unsafe { previous.value == 2 && *destroyed == 1 }, "replacing hands back the element without destroying it");
    previous.counter = null;
}

func SumOf(allocator: Allocator) -> int32 {
    var values: int32[4];
    values[0] = 1;
    values[1] = 2;
    values[2] = 3;
    values[3] = 4;
    // Safety: `values` is a local array of four elements.
    var array = Array::FromSlice<int32>(allocator, unsafe { (@values[0])[..4] });

    var total: int32 = 0;
    for value in array {
        total = total + value;
    }
    return total;
}

func Main() -> int {
    let allocator = SystemAllocator();

    // The ordinary shape: numbers copied in, walked, and released with the array.
    Assert(SumOf(allocator) == 10, "an array holds what was copied into it and iterates over it");

    // Filling with a value copies it into every position.
    var filled = Array::Filled<int32>(allocator, 6, 7);
    Assert(filled.Length() == 6, "with the length asked for");
    Assert(!filled.IsEmpty(), "and is not empty");
    var index: uint = 0;
    while index < 6 {
        let value = filled.Get(index) ?? Panic("every index has an element");
        Assert(value == 7, "and every element is the value it was filled with");
        index++;
    }
    Assert(filled.Get(6) == none, "one past the end has no element");
    Assert(filled.At(6) is none, "and nothing to borrow either");

    // Setting replaces an element and refuses an index the array does not have.
    try filled.Set(2, 99) catch { _ => Panic("setting an element in range succeeds") };
    Assert(filled.Get(2) == .Some(99), "and replaces what was there");
    try {
        filled.Set(6, 1);
        Panic("the operation was expected to fail");
    } catch {
        refusal => Assert(refusal == CollectionError::IndexOutOfRange, "setting past the end is refused"),
    }
    Assert(filled.Get(5) == .Some(7), "changing nothing");

    // A borrowed view is what the algorithms take, and it sees the array's own storage.
    let view = filled.AsSlice();
    Assert(view.length == 6, "the view is the whole array");
    Assert(view.data == filled.AsSlice().data, "over the array's own storage");

    // An empty array owns a block it still releases, and is not a special shape anywhere.
    var empty = Array::Filled<int32>(allocator, 0, 0);
    Assert(empty.IsEmpty(), "and is empty");
    Assert(empty.Length() == 0, "with no elements");
    Assert(empty.Get(0) == none, "and nothing at any index");

    // Every constructor copies its elements, so an element type must be plain data: one with a destructor is
    // move-only, and filling an array with it is rejected while compiling rather than leaving several elements
    // owning what one of them owns.

    // Setting destroys the element it replaces once the new one is stored; replacing hands it back instead.
    var destroyed: int32 = 0;
    var replacements: int32 = 0;
    SetAndReplace(allocator, @destroyed, @replacements);
    Assert(destroyed == 2, "the replaced element and the replacement are each destroyed once");
    Assert(replacements == 2, "and so are the stored element and the refused one, never twice");

    return 0;
}
