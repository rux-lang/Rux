import Allocator::{ Allocator, SystemAllocator };
import Collections::{ Array, CollectionError };
import Core::{ Assert, Drop };

// An array owns its storage and its elements, so the questions worth asking are about ownership: does destroying one
// destroy what it holds, exactly once, and does a failed construction leave anything behind. Counting destructions is
// the only way to see that, so the element type counts them.

// The counter lives where the test put it. The element only points at it, so destroying an element is observable and
// the count survives the element.
struct Tracked {
    counter: *var int32;
    value: int32;
}

extend Tracked : Drop {
    func Drop(self: *var Tracked) {
        if self.counter != null {
            *self.counter = *self.counter + 1i32;
        }
    }
}

// A scope for an array, so its destruction happens somewhere observable.
func FillAndDrop(allocator: Allocator, counter: *var int32, length: uint) -> CollectionError {
    var error = CollectionError::None;
    var array = Array::Filled<Tracked>(allocator, length, Tracked { counter: counter, value: 5 }, @error);
    if error.IsError() {
        return error;
    }
    Assert(array.Length() == length, "the array is the length it was asked for");
    return CollectionError::None;
}

func SumOf(allocator: Allocator) -> int32 {
    var values: int32[4];
    values[0] = 1;
    values[1] = 2;
    values[2] = 3;
    values[3] = 4;
    var error = CollectionError::None;
    var array = Array::FromSlice<int32>(allocator, Slice<int32> { data: @values[0], length: 4 }, @error);
    Assert(error == CollectionError::None, "an array of numbers is made");

    var total: int32 = 0;
    for value in array {
        total = total + value;
    }
    return total;
}

func Main() -> int {
    var system = SystemAllocator::New();
    let allocator: Allocator = system;

    // The ordinary shape: numbers copied in, walked, and released with the array.
    Assert(SumOf(allocator) == 10, "an array holds what was copied into it and iterates over it");

    // Filling with a value copies it into every position.
    var error = CollectionError::None;
    var filled = Array::Filled<int32>(allocator, 6, 7, @error);
    Assert(error == CollectionError::None, "a filled array is made");
    Assert(filled.Length() == 6, "with the length asked for");
    Assert(!filled.IsEmpty(), "and is not empty");
    var index: uint = 0;
    var value: int32 = 0;
    while index < 6 {
        Assert(filled.Get(index).TryIntoValue(@value), "every index has an element");
        Assert(value == 7, "and every element is the value it was filled with");
        index++;
    }
    Assert(filled.Get(6).IsNone(), "one past the end has no element");
    Assert(filled.Reference(6).IsNone(), "and no pointer either");

    // Setting replaces an element and refuses an index the array does not have.
    Assert(filled.Set(2, 99) == CollectionError::None, "setting an element in range succeeds");
    Assert(filled.Get(2).TryIntoValue(@value) && value == 99, "and replaces what was there");
    Assert(filled.Set(6, 1) == CollectionError::IndexOutOfRange, "setting past the end is refused");
    Assert(filled.Get(5).TryIntoValue(@value) && value == 7, "changing nothing");

    // A borrowed view is what the algorithms take, and it sees the array's own storage.
    let view = filled.AsSlice();
    Assert(view.length == 6, "the view is the whole array");
    Assert(view.data == filled.AsSlice().data, "over the array's own storage");

    // An empty array owns a block it still releases, and is not a special shape anywhere.
    var empty = Array::Filled<int32>(allocator, 0, 0, @error);
    Assert(error == CollectionError::None, "an empty array is made");
    Assert(empty.IsEmpty(), "and is empty");
    Assert(empty.Length() == 0, "with no elements");
    Assert(empty.Get(0).IsNone(), "and nothing at any index");

    // A length that cannot be sized is refused as arithmetic, and what comes back owns nothing.
    var impossible = Array::Filled<int32>(allocator, uint::Max, 0, @error);
    Assert(error == CollectionError::CapacityOverflow, "a length that cannot be sized is refused");
    Assert(impossible.IsEmpty(), "and the array that comes back owns nothing");

    // Destruction: every element of an array is destroyed exactly once when the array's life ends.
    //
    // The count is one more than the length, and the extra one is not a leak or a double destruction: `Filled`
    // copies the value it was given into every position and then that value, being a parameter, is destroyed where
    // it stood. So a length of five destroys six -- the five in the array, once each, and the one they were copied
    // from. What matters is that the difference stays exactly one however long the array is, which is what says the
    // elements themselves are destroyed once apiece.
    var destroyed: int32 = 0;
    Assert(FillAndDrop(allocator, @destroyed, 5) == CollectionError::None, "an array of tracked elements is made");
    Assert(destroyed == 6, "and destroying it destroys five elements and the value they were copied from");

    destroyed = 0;
    Assert(FillAndDrop(allocator, @destroyed, 1) == CollectionError::None, "a single-element array is made");
    Assert(destroyed == 2, "and destroys its one element and the source");

    destroyed = 0;
    Assert(FillAndDrop(allocator, @destroyed, 0) == CollectionError::None, "an empty array of them is made");
    Assert(destroyed == 1, "and destroys only the source, having stored nothing");

    destroyed = 0;
    Assert(FillAndDrop(allocator, @destroyed, 32) == CollectionError::None, "a longer array is made");
    Assert(destroyed == 33, "and the difference is still exactly one, whatever the length");

    return 0;
}
