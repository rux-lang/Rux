import Allocator::SystemAllocator;
import Collections::{ EqualsInt32, HashInt32, LruCache };
import Core::Assert;

// A full cache evicts the entry used least recently, where a lookup and a put both count as a use and a peek does
// not; removing an entry keeps the rest in order; and a cache of one keeps only the latest.

func Order(cache: &LruCache<int32, int32>, expected: int32[..]) -> bool {
    var keys: int32[8] = [0; 8];
    let count = cache.KeysByRecency(keys[..]);
    if count != expected.length { return false; }
    var index: uint = 0;
    while index < count {
        if keys[index] != expected[index] { return false; }
        index = index + 1;
    }
    return true;
}

// A value that counts its own destruction, so a value the cache replaces or evicts is seen to be released once.
struct Tracked {
    counter: *var int32;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked);

    func ~Tracked(self: &var Tracked) {
        if self.counter != null {
            // Safety: a non-null counter points at a local of the test that outlives every element.
            unsafe { *self.counter = *self.counter + 1; }
        }
    }
}

// Replaces one cached value and evicts another, then lets the cache go.
func ReplaceAndEvict(destroyed: *var int32, kept: *var int32) -> bool {
    var cache = LruCache<int32, Tracked>(SystemAllocator(), 1, HashInt32, EqualsInt32);
    cache.Put(1, Tracked { counter: destroyed });
    cache.Put(1, Tracked { counter: destroyed });
    // Safety: `destroyed` points at a local of the caller, which outlives this call.
    if unsafe { *destroyed } != 1 { return false; }
    cache.Put(2, Tracked { counter: kept });
    // Safety: both point at locals of the caller, which outlive this call.
    if unsafe { *destroyed != 2 || *kept != 0 } { return false; }
    return true;
}

func Main() -> int {
    var cache = LruCache<int32, int32>(SystemAllocator(), 3, HashInt32, EqualsInt32);
    Assert(cache.Capacity() == 3u && cache.Length() == 0u && cache.Get(1) == none, "an empty cache");
    Assert((cache.Put(1, 10)) == none, "room for the first");
    cache.Put(2, 20);
    cache.Put(3, 30);
    Assert(Order(cache, [3i32, 2, 1]) && cache.Length() == 3u, "newest first");

    Assert((cache.Get(1) ?? 0) == 10 && Order(cache, [1i32, 3, 2]), "a lookup makes an entry the newest");
    Assert((cache.Peek(2) ?? 0) == 20 && Order(cache, [1i32, 3, 2]), "a peek does not");
    let evicted = cache.Put(4, 40);
    Assert((evicted ?? 0) == 2 && !cache.Contains(2) && Order(cache, [4i32, 1, 3]), "the least recently used goes");
    Assert((cache.Put(3, 33)) == none && (cache.Peek(3) ?? 0) == 33 && Order(cache, [3i32, 4, 1]),
           "putting an existing key replaces its value and uses it");

    Assert((cache.Remove(4) ?? 0) == 40 && cache.Length() == 2u && Order(cache, [3i32, 1]), "removing keeps the order");
    Assert(cache.Remove(4) == none, "a missing key removes nothing");
    cache.Put(5, 50);
    cache.Put(6, 60);
    Assert(Order(cache, [6i32, 5, 3]) && !cache.Contains(1) && (cache.Get(3) ?? 0) == 33, "evicts after a removal");
    cache.Clear();
    Assert(cache.Length() == 0u && cache.Get(6) == none, "clearing forgets everything");

    var one = LruCache<int32, int32>(SystemAllocator(), 0, HashInt32, EqualsInt32);
    one.Put(1, 1);
    Assert(one.Capacity() == 1u && (one.Put(2, 2) ?? 0) == 1 && Order(one, [2i32]),
           "a cache of one keeps only the latest");

    var destroyed: int32 = 0;
    var kept: int32 = 0;
    Assert(ReplaceAndEvict(@destroyed, @kept), "a replaced value and an evicted one are each destroyed once");
    Assert(destroyed == 2 && kept == 1, "and the value still cached goes with the cache");
    return 0;
}
