import Allocator::{ Allocator, SystemAllocator };
import Collections::{ CollectionError, Deque, MinimumDequeCapacity };
import Core::Assert;

// A ring buffer is where off-by-one errors live, so what is checked is the wrapping: elements pushed at one end and
// taken from the other until the ring has wrapped several times over, and the answers compared against what a queue
// must give. Ownership is checked the same way as the vector's -- by counting destructions.

struct Tracked {
    counter: *var int32;
    value: int32;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked);

    func ~Tracked(self: &var Tracked) {
        if self.counter != null {
            *self.counter = *self.counter + 1i32;
        }
    }
}

// A scope for a deque of tracked elements. `afterPushing` reports what the counter read once everything was in.
func FillAndDrop(allocator: Allocator, counter: *var int32, count: uint, afterPushing: *var int32) {
    var deque = Deque<Tracked>(allocator);
    var index: uint = 0;
    while index < count {
        deque.PushBack(Tracked { counter: counter, value: index as int32 });
        index++;
    }
    Assert(deque.Length() == count, "the deque holds what was pushed into it");
    *afterPushing = *counter;
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // A new deque allocates nothing.
    var queue = Deque<int32>(allocator);
    Assert(queue.IsEmpty(), "a new deque is empty");
    Assert(queue.Capacity() == 0, "and has no storage");
    Assert(queue.PopFront().IsNone(), "with nothing to take from either end");
    Assert(queue.PopBack().IsNone(), "front or back");
    Assert(queue.Front().IsNone(), "and nothing to look at");
    Assert(queue.Back().IsNone(), "at either end");

    // The first push takes the minimum capacity.
    Assert(queue.PushBack(1) == CollectionError::None, "the first push succeeds");
    Assert(queue.Capacity() == MinimumDequeCapacity, "taking the minimum capacity");
    Assert(queue.Length() == 1, "and holding one element");

    // Both ends, and the order they produce.
    Assert(queue.PushBack(2) == CollectionError::None, "pushing at the back succeeds");
    Assert(queue.PushFront(0) == CollectionError::None, "and pushing at the front");
    Assert(queue.Length() == 3, "the deque holds all three");
    Assert(queue.Get(0).ValueOr(-1) == 0, "with the front-pushed element first");
    Assert(queue.Get(1).ValueOr(-1) == 1, "and the rest in order");
    Assert(queue.Get(2).ValueOr(-1) == 2, "to the back");
    Assert(queue.Get(3).IsNone(), "and nothing past it");

    // First in, first out, which is what this container is for.
    Assert(queue.PopFront().ValueOr(-1) == 0, "the front comes off first");
    Assert(queue.PopBack().ValueOr(-1) == 2, "and the back comes off last");
    Assert(queue.Length() == 1, "leaving what was in the middle");

    // Wrapping: push and pop enough times that the ring goes round several times, checking the queue order each
    // time. This is where an off-by-one in the mask shows.
    queue.Clear();
    var expected: int32 = 0;
    var pushed: int32 = 0;
    var round: uint = 0;
    while round < 40 {
        Assert(queue.PushBack(pushed) == CollectionError::None, "every push during wrapping succeeds");
        pushed = pushed + 1;
        if queue.Length() > 3 {
            Assert(queue.PopFront().ValueOr(-1) == expected, "and every element comes back in the order it went in");
            expected = expected + 1;
        }
        round++;
    }
    Assert(queue.Length() == 3, "with the window still the size it was kept at");
    Assert(queue.Capacity() >= 4, "over a ring no larger than it needs");

    // The same from the other side: push at the front and take from the back.
    queue.Clear();
    round = 0;
    while round < 40 {
        Assert(queue.PushFront(round as int32) == CollectionError::None, "every front push succeeds");
        if queue.Length() > 3 {
            Assert(queue.PopBack().ValueOr(-1) == (round - 3) as int32, "and the back gives them back in order");
        }
        round++;
    }
    Assert(queue.Length() == 3, "with the window the size it was kept at");

    // A deliberately wrapped deque, so the two-slice view has both runs to give.
    queue.Clear();
    Assert(queue.PushBack(10) == CollectionError::None, "filling a wrapped deque");
    Assert(queue.PushBack(20) == CollectionError::None, "with a few elements");
    Assert(queue.PushFront(5) == CollectionError::None, "one of them at the front, which wraps the head");
    Assert(!queue.IsContiguous(), "so the elements are in two runs");

    var front = Slice<int32> { data: null, length: 0 };
    var back = Slice<int32> { data: null, length: 0 };
    queue.AsSlices(@front, @back);
    Assert(front.length + back.length == queue.Length(), "the two runs together are every element");
    Assert(front.length > 0, "with the front run non-empty");
    Assert(back.length > 0, "and the back run too, for a wrapped deque");
    Assert(front.data[0] == 5, "the front run starting at the front element");

    // Making it contiguous moves the elements without changing the order.
    let view = queue.AsSlice();
    Assert(queue.IsContiguous(), "asking for one view makes the storage contiguous");
    Assert(view.length == 3, "over every element");
    Assert(view.data[0] == 5 && view.data[1] == 10 && view.data[2] == 20, "in the order the deque had them");

    queue.AsSlices(@front, @back);
    Assert(back.length == 0, "and a contiguous deque has nothing in its second run");

    // An empty deque has two empty runs rather than one of something.
    queue.Clear();
    queue.AsSlices(@front, @back);
    Assert(front.length == 0 && back.length == 0, "an empty deque is two empty runs");
    Assert(queue.IsContiguous(), "and is contiguous for want of anything to wrap");

    // Reserving takes room without changing the length; shrinking gives back what rounding leaves spare.
    Assert(queue.Reserve(100) == CollectionError::None, "reserving succeeds");
    Assert(queue.Capacity() >= 100, "taking the room asked for");
    Assert(queue.IsEmpty(), "without adding elements");
    Assert(queue.ShrinkToFit() == CollectionError::None, "shrinking an empty deque succeeds");
    Assert(queue.Capacity() == 0, "and hands back everything");

    Assert(queue.PushBack(7) == CollectionError::None, "a push after shrinking succeeds");
    Assert(queue.Reserve(200) == CollectionError::None, "and reserving again");
    let roomy = queue.Capacity();
    Assert(queue.ShrinkToFit() == CollectionError::None, "shrinking a non-empty deque succeeds");
    Assert(queue.Capacity() < roomy, "giving back what the length does not need");
    Assert(queue.Capacity() == MinimumDequeCapacity, "down to the smallest power of two that holds it");
    Assert(queue.Get(0).ValueOr(-1) == 7, "and keeping the element");

    // A reservation that cannot be represented is refused as arithmetic, and changes nothing.
    let survived = queue.Capacity();
    Assert(queue.Reserve(uint::Max) == CollectionError::CapacityOverflow, "an impossible reservation is refused");
    Assert(queue.Capacity() == survived, "leaving the capacity where it was");
    Assert(queue.Length() == 1, "and the length");
    Assert(queue.Get(0).ValueOr(-1) == 7, "and the elements");

    // Construction from a slice, and cloning a wrapped deque.
    var source: int32[3];
    source[0] = 1;
    source[1] = 2;
    source[2] = 3;
    var error = CollectionError::None;
    let items = Slice<int32> { data: @source[0], length: 3 };
    var built = Deque::FromSlice<int32>(allocator, items, @error);
    Assert(error == CollectionError::None, "a deque is made from a slice");
    Assert(built.Length() == 3, "holding every element");
    Assert(built.Get(2).ValueOr(-1) == 3, "in order");

    Assert(built.PushFront(0) == CollectionError::None, "pushing at the front wraps it");
    Assert(!built.IsContiguous(), "so the clone has a wrapped source to copy");
    var copy = built.Clone(@error);
    Assert(error == CollectionError::None, "cloning succeeds");
    Assert(copy.Length() == 4, "with every element");
    Assert(copy.Get(0).ValueOr(-1) == 0, "in order");
    Assert(copy.Get(3).ValueOr(-1) == 3, "front to back");
    Assert(copy.IsContiguous(), "and the copy starts unwrapped whatever the original was doing");

    // Ownership: every element is destroyed exactly once, and pushing destroys none.
    var destroyed: int32 = 0;
    var afterPushing: int32 = 0;
    FillAndDrop(allocator, @destroyed, 9, @afterPushing);
    Assert(afterPushing == 0, "pushing nine elements destroys none of them");
    Assert(destroyed == 9, "and destroying the deque destroys exactly those nine, once each");

    destroyed = 0;
    afterPushing = 0;
    FillAndDrop(allocator, @destroyed, 0, @afterPushing);
    Assert(destroyed == 0, "an empty deque destroys nothing");

    // Clearing destroys what it holds, and growth relocates rather than copying.
    destroyed = 0;
    var owning = Deque<Tracked>(allocator);
    var index: uint = 0;
    while index < 20 {
        owning.PushFront(Tracked { counter: @destroyed, value: index as int32 });
        index++;
    }
    Assert(destroyed == 0, "growing a deque past several capacities destroys nothing");
    Assert(owning.Length() == 20, "and keeps every element");
    owning.Clear();
    Assert(destroyed == 20, "clearing destroys exactly what it held");

    return 0;
}
