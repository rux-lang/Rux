import Allocator::{ AllocError, Allocator, ClassIndexFor, FixedBuffer, IsEmptyBlock, Layout, Pool, PoolAlignment,
                    PoolClassCount, PoolLargestClass, PoolSmallestClass, SystemAllocator };
import Core::{ Assert, Panic };
import Memory::IsPointerAligned;

// A pool rounds a request up to a size class and serves it from that class's free list, so what is checked is that
// the rounding is what it claims, that a released block comes straight back, that every block satisfies the
// alignment a chunk is taken at, that a request no class can serve goes to the backing allocator, and that a pool
// over an exhausted backing reports the failure rather than handing out storage it does not have.

func Main() throws AllocError {
    // The class a layout lands in depends only on the layout, which is what makes a release match its allocation.
    let zero = Layout::Of(0, 8) ?? Layout { size: 0, alignment: 1 };
    Assert(ClassIndexFor(Layout::Of(1, 1) ?? zero) == 0, "one byte lands in the smallest class");
    Assert(ClassIndexFor(Layout::Of(16, 8) ?? zero) == 0, "and so does exactly the smallest class");
    Assert(ClassIndexFor(Layout::Of(17, 8) ?? zero) == 1, "one byte past it rounds up to the next");
    Assert(ClassIndexFor(Layout::Of(256, 8) ?? zero) == PoolClassCount - 1, "the largest class holds its size");
    Assert(ClassIndexFor(Layout::Of(257, 8) ?? zero) == PoolClassCount, "and one byte past it has no class");
    Assert(ClassIndexFor(Layout::Of(16, 32) ?? zero) == PoolClassCount,
           "an alignment stricter than a chunk is taken at has no class either");

    var system = SystemAllocator();
    let backing: Allocator = system;

    // Four blocks to a chunk, so exhausting a class takes a handful of requests rather than dozens.
    var pool = Pool(backing, 4);
    Assert(pool.ChunkCount() == 0, "an unused pool holds no chunks");
    Assert(pool.LiveBlocks() == 0, "and has handed out nothing");
    Assert(pool.ClassSize(0) == PoolSmallestClass, "the first class is the smallest");
    Assert(pool.ClassSize(PoolClassCount - 1) == PoolLargestClass, "and the last is the largest");
    Assert(pool.ClassSize(PoolClassCount) == 0, "with nothing past the last");

    // Safety: `pool` is a local that outlives `handle` and is never moved.
    var handle = unsafe { pool.Handle() };
    let allocator: Allocator = handle;

    // A zero-sized layout costs the pool nothing.
    let empty = try allocator.Allocate(zero);
    Assert(IsEmptyBlock(empty), "and gives the shared empty block");
    Assert(pool.ChunkCount() == 0, "without taking a chunk");
    try allocator.Deallocate(empty, zero);

    // The first real request takes one chunk and carves it.
    let small = Layout::Of(12, 8) ?? zero;
    let first = try allocator.Allocate(small);
    Assert(first != null, "and reports an address");
    Assert(pool.ChunkCount() == 1, "which took exactly one chunk");
    Assert(pool.LiveBlocks() == 1, "with one block handed out of it");
    Assert(IsPointerAligned(first as *opaque, PoolAlignment), "every pooled block is chunk-aligned");

    // The next three come out of the same chunk, since it was carved into four.
    var second: *var opaque = null;
    var third: *var opaque = null;
    var fourth: *var opaque = null;
    second = try allocator.Allocate(small);
    third = try allocator.Allocate(small);
    fourth = try allocator.Allocate(small);
    Assert(pool.ChunkCount() == 1, "all out of the one chunk");
    Assert(pool.LiveBlocks() == 4, "which held exactly four blocks");

    // Blocks come off the list in address order, which keeps a run of allocations walking forward.
    Assert((second as uint) == (first as uint) + PoolSmallestClass, "the second follows the first");
    Assert((third as uint) == (second as uint) + PoolSmallestClass, "and the third the second");
    Assert((fourth as uint) == (third as uint) + PoolSmallestClass, "and the fourth the third");

    // Writing through every block must not disturb the others.
    // Safety: the four are distinct live blocks of the 16-byte class, chunk-aligned, so each holds a `uint64`.
    let (firstValue, fourthValue) = unsafe {
        *(first as *var uint64) = 0x1111111111111111;
        *(second as *var uint64) = 0x2222222222222222;
        *(third as *var uint64) = 0x3333333333333333;
        *(fourth as *var uint64) = 0x4444444444444444;
        (*(first as *uint64), *(fourth as *uint64))
    };
    Assert(firstValue == 0x1111111111111111, "the first block keeps its bytes");
    Assert(fourthValue == 0x4444444444444444, "and so does the fourth");

    // The fifth request finds the class empty and takes another chunk.
    let fifth = try allocator.Allocate(small);
    Assert(pool.ChunkCount() == 2, "by taking a second chunk");
    Assert(pool.LiveBlocks() == 5, "with five blocks now out");

    // A released block is the very next one handed out, which is the whole point of a pool.
    try allocator.Deallocate(third, small);
    Assert(pool.LiveBlocks() == 4, "leaving one fewer out");
    let reused = try allocator.Allocate(small);
    Assert((reused as uint) == (third as uint), "and reuses the block just released");
    Assert(pool.ChunkCount() == 2, "without taking another chunk");

    // Classes are independent: a bigger request does not touch the smaller class's free list.
    let medium = Layout::Of(100, 8) ?? zero;
    Assert(ClassIndexFor(medium) == 3, "a hundred bytes rounds up to the 128-byte class");
    let big = try allocator.Allocate(medium);
    Assert(pool.ChunkCount() == 3, "taking a chunk for its own class");
    Assert(IsPointerAligned(big as *opaque, PoolAlignment), "and is chunk-aligned too");

    // Every class hands out something aligned, whatever its size.
    var classIndex: uint = 0;
    while classIndex < PoolClassCount {
        let size = pool.ClassSize(classIndex);
        let layout = Layout::Of(size, PoolAlignment) ?? zero;
        let block = try allocator.Allocate(layout);
        Assert(IsPointerAligned(block as *opaque, PoolAlignment), "and every class is chunk-aligned");
        Assert(ClassIndexFor(layout) == classIndex, "a class's own size lands back in that class");
        try allocator.Deallocate(block, layout);
        classIndex++;
    }

    // Growing inside a class costs nothing, because the block already holds the new size.
    var grown: *var opaque = null;
    let sameClass = Layout::Of(15, 8) ?? zero;
    grown = try allocator.Reallocate(first, small, sameClass);
    Assert((grown as uint) == (first as uint), "without moving the block");

    // Growing past the class moves it, and carries the bytes across.
    let moved = try allocator.Reallocate(grown, sameClass, medium);
    // Safety: `moved` is a live 128-byte block, aligned to 8, that the reallocation just returned.
    let movedValue = unsafe { *(moved as *uint64) };
    Assert(movedValue == 0x1111111111111111, "carrying the contents to the new block");

    // A request no class can serve goes to the backing allocator, and comes back from it.
    let huge = Layout::Of(4096, 8) ?? zero;
    Assert(ClassIndexFor(huge) == PoolClassCount, "a large request has no class");
    var direct: *var opaque = null;
    let chunksBefore = pool.ChunkCount();
    let liveBefore = pool.LiveBlocks();
    direct = try allocator.Allocate(huge);
    Assert(direct != null, "which reports an address");
    Assert(pool.ChunkCount() == chunksBefore, "without the pool taking a chunk");
    Assert(pool.LiveBlocks() == liveBefore, "and without the pool counting it as its own");
    // Safety: `direct` is a live 4096-byte allocation aligned to 8, not yet released.
    let directValue = unsafe {
        *(direct as *var uint64) = 0x5555555555555555;
        *(direct as *uint64)
    };
    Assert(directValue == 0x5555555555555555, "the direct block is usable storage");
    try allocator.Deallocate(direct, huge);

    // A reset takes every pooled block back at once, keeping the chunks.
    let keptChunks = pool.ChunkCount();
    pool.Reset();
    Assert(pool.LiveBlocks() == 0, "a reset takes every block back");
    Assert(pool.ChunkCount() == keptChunks, "while keeping the chunks");
    let afterReset = try allocator.Allocate(small);
    Assert(pool.ChunkCount() == keptChunks, "asking the backing allocator for nothing");

    // Exhaustion: a pool over a buffer too small for a chunk reports the failure rather than inventing storage.
    var storage: byte[64];
    // Safety: `storage` is a local array of 64 bytes that outlives `tiny` and is touched only through it.
    var tiny = unsafe { FixedBuffer(@storage[0] as *var opaque, 64) };
    // Safety: `tiny` is a local that outlives `tinyHandle` and is never moved.
    var tinyHandle = unsafe { tiny.Handle() };
    let starved: Allocator = tinyHandle;
    var starvedPool = Pool(starved, 32);
    // Safety: `starvedPool` is a local that outlives `starvedHandle` and is never moved.
    var starvedHandle = unsafe { starvedPool.Handle() };
    let starvedAllocator: Allocator = starvedHandle;
    var refused: *var opaque = null;
    try {
        starvedAllocator.Allocate(small);
        Panic("the allocator was expected to refuse");
    } catch {
        refusal => Assert(refusal == AllocError::OutOfMemory,
            "a pool whose backing cannot hold a chunk reports the failure"),
    }
    Assert(starvedPool.ChunkCount() == 0, "having taken no chunk");
    Assert(starvedPool.LiveBlocks() == 0, "and handed out nothing");
    refused = try starvedAllocator.Allocate(zero);

}

