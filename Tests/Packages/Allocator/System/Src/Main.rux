import Core::uint;
import Allocator::{ AllocError, Allocator, EmptyBlockAddress, IsEmptyBlock, Layout, NaturalAlignment, SystemAllocator };
import Core::{ Assert, Panic };
import Memory::{ IsPointerAligned, Set };

// What an allocator gets wrong quietly: handing back an address that does not satisfy the alignment, accepting a
// release that does not match its allocation, and losing the original block when a reallocation fails. Each is
// checked rather than assumed.

struct ByteRun { bytes: uint8[9]; }
struct Empty {}

func Main() throws AllocError {
    // A layout that exists is valid, so the refusals happen at construction.
    Assert(!(Layout::Of(64, 0) is Layout), "an alignment of zero is not a layout");
    Assert(!(Layout::Of(64, 3) is Layout), "and neither is one that is not a power of two");
    Assert(Layout::Of(64, 8) is Layout, "an ordinary pair is a layout");
    Assert(Layout::Of(0, 8) is Layout, "and so is a zero size");
    Assert(!(Layout::Of(uint::Max, 8) is Layout), "a size whose rounding overflows is refused");
    Assert(Layout::Of(uint::Max, 1) is Layout, "where an alignment of one has nothing to round");

    var layout = Layout::Of(64, 16) ?? Layout { size: 0, alignment: 1 };
    Assert(layout.size == 64 && layout.alignment == 16, "the layout holds what it was built with");
    Assert(layout.PaddedSize() == 64, "an aligned size needs no padding");
    let odd = Layout::Of(60, 16) ?? Layout { size: 0, alignment: 1 };
    Assert(odd.PaddedSize() == 64, "and an unaligned one rounds up to its own alignment");
    Assert(layout.IsSatisfiedBy(32), "an aligned address satisfies the layout");
    Assert(!layout.IsSatisfiedBy(33), "and an unaligned one does not");
    Assert(layout == (Layout::Of(64, 16) ?? odd), "two layouts asking the same thing are equal");
    Assert(layout != odd, "and two asking different things are not");

    // An array layout has to check the multiplication, which is where a huge count turns into a small allocation.
    Assert(Layout::ForArray<uint64>(8) is Layout, "an ordinary array layout");
    Assert(!(Layout::ForArray<uint64>(uint::Max) is Layout), "a count that cannot fit is refused");
    let single = Layout::ForValue<uint64>();
    Assert(single.size == 8 && single.alignment == 8, "a value's layout is its own size and alignment");
    let byteLayout = Layout::ForValue<ByteRun>();
    Assert(byteLayout.size == 9 && byteLayout.alignment == 1,
           "alignment follows the type rather than a size heuristic");
    let manyBytes = Layout::ForArray<ByteRun>(3) ?? odd;
    Assert(manyBytes.size == 27 && manyBytes.alignment == 1, "array storage keeps the element's alignment");
    let noBytes = Layout::ForArray<ByteRun>(0) ?? odd;
    Assert(noBytes.size == 0 && noBytes.alignment == 1, "a zero count retains the element's alignment");
    let noValues = Layout::ForArray<Empty>(uint::Max) ?? odd;
    Assert(noValues.size == 0 && noValues.alignment == alignof(Empty), "zero-sized elements cannot overflow");
    Assert(NaturalAlignment(0) == 1 && NaturalAlignment(1) == 1, "a byte wants no alignment");
    Assert(NaturalAlignment(4) == 4 && NaturalAlignment(8) == 8, "a word wants its own width");

    // The error questions.
    Assert(AllocError::OutOfMemory.IsTransient(), "exhaustion might pass");
    Assert(!AllocError::Unsupported.IsTransient(), "but an unsupported request will not");
    Assert(!AllocError::InvalidBlock.IsTransient(), "and neither will a mistaken one");

    var allocator = SystemAllocator();

    // A concrete allocator can be borrowed directly as an interface view. The view changes the same allocator and
    // owns nothing, so it cannot accidentally duplicate or outlive allocator state.
    let borrowed: &var Allocator = allocator;
    let throughView = try borrowed.Allocate(layout);
    try borrowed.Deallocate(throughView, layout);

    // A zero-sized layout gives the shared empty block rather than null, so no caller has to branch.
    var empty: *var opaque = null;
    let zero = Layout::Of(0, 16) ?? layout;
    empty = try allocator.Allocate(zero);
    Assert(empty != null && IsEmptyBlock(empty), "and reports the shared empty block");
    Assert(empty == EmptyBlockAddress(), "which is the same address every time");
    try allocator.Deallocate(empty, zero);

    // An ordinary allocation is aligned to what was asked for, and the whole size is usable.
    let block = try allocator.Allocate(layout);
    Assert(block != null, "and reports an address");
    Assert(IsPointerAligned(block as *opaque, 16), "which satisfies the layout's alignment");
    // Safety: `block` is a live 64-byte allocation, so all 64 bytes are writable and offsets 0 and 63 readable.
    let (front, back) = unsafe {
        Set(block, 0xC3 as byte, 64);
        let bytes = block as *var byte;
        (*bytes, *(bytes + 63))
    };
    Assert(front == 0xC3 as byte && back == 0xC3 as byte, "the whole size is writable");

    // A stricter alignment than a page still works, because the allocator pads for it.
    var aligned: *var opaque = null;
    let strict = Layout::Of(32, 4096) ?? layout;
    aligned = try allocator.Allocate(strict);
    Assert(IsPointerAligned(aligned as *opaque, 4096), "and really is page-aligned");
    try allocator.Deallocate(aligned, strict);

    // A release that does not match its allocation is reported rather than corrupting anything.
    try {
        allocator.Deallocate(block, odd);
        Panic("the allocator was expected to refuse");
    } catch {
        refusal => Assert(refusal == AllocError::InvalidBlock, "a mismatched layout is refused"),
    }
    try {
        allocator.Deallocate(null, layout);
        Panic("the allocator was expected to refuse");
    } catch {
        refusal => Assert(refusal == AllocError::InvalidBlock, "and so is a null block"),
    }
    var stackValue: uint64 = 0;
    try {
        allocator.Deallocate(@stackValue as *var opaque, layout);
        Panic("the allocator was expected to refuse");
    } catch {
        refusal => Assert(refusal == AllocError::InvalidBlock, "and a pointer this allocator never gave out"),
    }

    // Reallocation keeps what fits and reports the address to use.
    var grown: *var opaque = null;
    let larger = Layout::Of(256, 16) ?? layout;
    grown = try allocator.Reallocate(block, layout, larger);
    Assert(grown != null, "and reports where the block now is");
    // Safety: `grown` is the live 256-byte block the reallocation returned, so offsets 0 and 63 are inside it.
    let (grownFront, grownBack) = unsafe {
        let grownBytes = grown as *var byte;
        (*grownBytes, *(grownBytes + 63))
    };
    Assert(grownFront == 0xC3 as byte && grownBack == 0xC3 as byte, "the old contents survived");

    var shrunk: *var opaque = null;
    let smaller = Layout::Of(16, 16) ?? layout;
    shrunk = try allocator.Reallocate(grown, larger, smaller);
    // Safety: `shrunk` is the live 16-byte block the reallocation returned, so its first byte is readable.
    let shrunkFront = unsafe { *(shrunk as *var byte) };
    Assert(shrunkFront == 0xC3 as byte, "and keeps what still fits");

    // The two layouts must share an alignment; anything else is refused rather than silently moved.
    let realigned = Layout::Of(16, 32) ?? layout;
    try {
        allocator.Reallocate(shrunk, smaller, realigned);
        Panic("the allocator was expected to refuse");
    } catch {
        refusal => Assert(refusal == AllocError::Unsupported, "changing the alignment is refused"),
    }
    try allocator.Deallocate(shrunk, smaller);
}

