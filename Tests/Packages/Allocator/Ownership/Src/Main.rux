// The four promises in Contract.rux, checked against every allocator rather than against one of them.
// Each allocator's own test covers what makes it different — how an arena rewinds, how a pool classes its blocks.
// What none of them covers is the part a caller may rely on *without* knowing which allocator it has, and that is
// exactly the part a generic over `<A: Allocator>` depends on. So this file takes the contract's four promises and
// asks each implementation the same questions.
// The third promise is the one nothing tested at all. "A failed reallocation leaves the original block exactly as
// it was, valid and still the caller's to release" is a claim about the block, not about the return value, and
// every existing test checks only the return value. A `Reallocate` that freed the old block before discovering it
// could not satisfy the request would pass all of them and corrupt every caller that handled the failure
// correctly. So each failed reallocation here is followed by reading the original back and releasing it.
// Ownership is the other half. An arena, a pool and a fixed buffer are owners; a handle is a copyable adapter
// pointing at one. The adapter holds an address, so two handles from one owner share its state and a handle does
// not survive its owner moving — both documented, neither checked.

import Allocator::{ AllocError, Allocator, Arena, EmptyBlockAddress, FixedBuffer, IsEmptyBlock, Layout, Pool,
                    SystemAllocator };
import Core::{ Assert, Panic };

/// A recognizable byte for position `index`, chosen so that a block filled with these cannot be mistaken for
/// zeroed storage, for a run of one repeated value, or for a shifted copy of itself.
func Mark(index: uint) -> byte {
    return ((index * 7 + 11) % 251 + 1) as byte;
}

func Fill(block: *var opaque, size: uint) {
    let bytes = block as *var byte;
    var index: uint = 0;
    while index < size {
        *(bytes + index) = Mark(index);
        index = index + 1;
    }
}

func Holds(block: *var opaque, size: uint) -> bool {
    let bytes = block as *byte;
    var index: uint = 0;
    while index < size {
        if *(bytes + index) != Mark(index) { return false; }
        index = index + 1;
    }
    return true;
}

func LayoutOr(size: uint, alignment: uint) -> Layout {
    return Layout::New(size, alignment) ?? Layout { size: size, alignment: alignment };
}

/// The first promise: an address handed back satisfies the layout it was asked for.
/// Asked of every alignment a caller might reasonably want, and asked of whichever allocator is passed. An
/// allocator that cannot serve an alignment must refuse it — what it may not do is serve it misaligned, which is
/// the failure a caller has no way to notice until something faults much later.
func CheckAlignment(allocator: Allocator, name: char8[..]) -> ! AllocError {
    var alignment: uint = 1;
    while alignment <= 256 {
        let layout = LayoutOr(64, alignment);
        // A refused allocation is allowed; a misaligned one is not.
        match allocator.Allocate(layout) {
            .Success(block) => {
                Assert(block != null, "a successful allocation reports an address");
                Assert(layout.IsSatisfiedBy(block as uint), "a served allocation is aligned to what was asked for");
                // The whole block is writable, not merely its aligned first byte.
                Fill(block, 64);
                Assert(Holds(block, 64), "and the whole block holds what was written to it");
                allocator.Deallocate(block, layout)?;
            },
            .Failure(_) => {}
        }
        alignment = alignment * 2;
    }
    Assert(name.length > 0, "every allocator under test is named");
}

/// The fourth promise: a zero-sized layout is legal, gives the shared empty address, and must still be released.
func CheckZeroSize(allocator: Allocator) -> ! AllocError {
    let zero = LayoutOr(0, 8);
    let block = allocator.Allocate(zero)?;
    Assert(block != null, "and is not null, so no caller has to branch on it");
    Assert(IsEmptyBlock(block), "and is the shared empty address");
    Assert(block == EmptyBlockAddress(), "which is the same address on every allocator");
    Assert(LayoutOr(0, 256).IsSatisfiedBy(block as uint), "aligned to anything, so it satisfies every layout");
    allocator.Deallocate(block, zero)?;

    // Releasing it twice is still a success, because nothing was ever taken: there is no storage to lose track of.
    allocator.Deallocate(block, zero)?;

    // Growing out of nothing is an ordinary allocation, and shrinking back to nothing gives the empty address.
    let real = LayoutOr(32, 8);
    match allocator.Reallocate(block, zero, real) {
        .Success(grown) => {
            Assert(!IsEmptyBlock(grown), "growing out of nothing gives real storage");
            Fill(grown, 32);
            match allocator.Reallocate(grown, real, zero) {
                .Success(shrunk) => {
                    Assert(IsEmptyBlock(shrunk), "and shrinking back to nothing gives the empty address again");
                    // The address is only half of it. A zero-sized release must arrive with the empty block, so an
                    // allocator that handed back the address it rewound off of would leave the caller holding
                    // something `Deallocate` refuses — which is exactly what Arena and FixedBuffer did until this
                    // test was written.
                    allocator.Deallocate(shrunk, zero)?;
                },
                .Failure(_) => {
                    allocator.Deallocate(grown, real)?;
                }
            }
        },
        .Failure(_) => {}
    }
}

/// The third promise, and the one nothing was checking: a failed reallocation leaves the original block exactly as
/// it was — same address, same contents, still the caller's to release.
/// An alignment change is the failure every allocator here reports the same way, and it is a real one rather than a
/// contrived one: `Unsupported` exists precisely so that no allocator silently moves a block to a different
/// alignment.
func CheckFailedReallocation(allocator: Allocator) -> ! AllocError {
    let original = LayoutOr(96, 8);
    let block = allocator.Allocate(original)?;
    Fill(block, 96);
    let before = block;

    // Changing the alignment is refused rather than served by moving the block.
    let realigned = LayoutOr(96, 32);
    Assert(Refusal(allocator.Reallocate(block, original, realigned)) == AllocError::Unsupported,
           "changing the alignment is refused");
    Assert(block == before, "the original address is unchanged");
    Assert(Holds(block, 96), "and the original contents survived the refusal");

    // A refused growth is the same claim with a different size. An exbibyte is past what any 64-bit address space
    // holds, which a mere 2^47 is not: FreeBSD gives an AArch64 process 256 TiB and promises any amount of anonymous
    // memory by default, so it served that request and the assertion below failed.
    let enormous = LayoutOr(0x1000000000000000, 8);
    let refused = match allocator.Reallocate(block, original, enormous) {
        .Success(_) => false,
        .Failure(_) => true
    };
    Assert(refused, "growing past what any allocator can serve is refused");
    Assert(Holds(block, 96), "and that refusal also left the original contents alone");

    // Still the caller's, which is the half of the promise a return value cannot express.
    allocator.Deallocate(block, original)?;
}

/// A successful reallocation preserves the first `min(old, new)` bytes, whether it moved the block or not.
func CheckSuccessfulReallocation(allocator: Allocator) -> ! AllocError {
    let small = LayoutOr(64, 8);
    let large = LayoutOr(256, 8);
    let block = allocator.Allocate(small)?;
    Fill(block, 64);

    match allocator.Reallocate(block, small, large) {
        .Success(grown) => {
            Assert(grown != null, "a successful growth reports where the block is now");
            Assert(Holds(grown, 64), "and the bytes that fit both layouts came across");

            // Shrinking keeps the prefix and nothing is promised about the rest.
            Fill(grown, 256);
            match allocator.Reallocate(grown, large, small) {
                .Success(shrunk) => {
                    Assert(Holds(shrunk, 64), "and shrinking keeps the prefix that still fits");
                    allocator.Deallocate(shrunk, small)?;
                },
                .Failure(_) => {
                    allocator.Deallocate(grown, large)?;
                }
            }
        },
        .Failure(_) => {
            Assert(Holds(block, 64), "a refused growth left the original alone");
            allocator.Deallocate(block, small)?;
        }
    }

    // Reallocating to the same layout is a no-op that reports the same address, which is what lets a caller call it
    // unconditionally rather than comparing sizes first.
    var same: *var opaque = null;
    var steady: *var opaque = null;
    same = allocator.Allocate(small)?;
    Fill(same, 64);
    steady = allocator.Reallocate(same, small, small)?;
    Assert(steady == same, "reporting the same address");
    Assert(Holds(steady, 64), "with its contents untouched");
    allocator.Deallocate(steady, small)?;
}

func Main() -> ! AllocError {
    var system = SystemAllocator();
    let real: Allocator = system;

    // --- The contract, asked of each allocator ------------------------------------------------------------------

    CheckAlignment(real, "SystemAllocator")?;
    CheckZeroSize(real)?;
    CheckFailedReallocation(real)?;
    CheckSuccessfulReallocation(real)?;

    var arena = Arena(real, 65536);
    var arenaHandle = arena.Handle();
    let arenaAllocator: Allocator = arenaHandle;
    CheckAlignment(arenaAllocator, "Arena")?;
    CheckZeroSize(arenaAllocator)?;
    CheckFailedReallocation(arenaAllocator)?;
    CheckSuccessfulReallocation(arenaAllocator)?;

    var pool = Pool(real, 16);
    var poolHandle = pool.Handle();
    let poolAllocator: Allocator = poolHandle;
    CheckAlignment(poolAllocator, "Pool")?;
    CheckZeroSize(poolAllocator)?;
    CheckFailedReallocation(poolAllocator)?;
    CheckSuccessfulReallocation(poolAllocator)?;

    var storage: byte[65536];
    var buffer = FixedBuffer(@storage[0] as *var opaque, 65536);
    var bufferHandle = buffer.Handle();
    let bufferAllocator: Allocator = bufferHandle;
    CheckAlignment(bufferAllocator, "FixedBuffer")?;
    CheckZeroSize(bufferAllocator)?;
    CheckFailedReallocation(bufferAllocator)?;
    CheckSuccessfulReallocation(bufferAllocator)?;

    // --- Adapters share their owner's state ---------------------------------------------------------------------

    // A handle is a copyable adapter holding the owner's address, so every copy sees one arena. If the adapter
    // carried the state instead, each copy would allocate out of its own and the accounting below would disagree.
    var counted = Arena(real, 65536);
    var first = counted.Handle();
    var second = counted.Handle();
    let firstAllocator: Allocator = first;
    let secondAllocator: Allocator = second;

    let unit = LayoutOr(128, 8);
    let throughFirst = firstAllocator.Allocate(unit)?;
    let afterFirst = counted.BytesUsed();
    Assert(afterFirst >= 128, "which the arena itself accounts for");

    let throughSecond = secondAllocator.Allocate(unit)?;
    Assert(counted.BytesUsed() > afterFirst, "advancing the same arena rather than a copy of it");
    Assert(throughSecond != throughFirst, "and handing out a different address");
    Assert(counted.BlockCount() == 1, "both came out of the one block the arena took");

    // --- Resetting invalidates what the owner handed out ---------------------------------------------------------

    // The addresses above become invalid here — the arena reclaims everything at once, which is the one dangerous
    // call on it. What is observable, and asserted, is that the space really is reclaimed: the accounting rewinds,
    // and the next request out of a handle taken *before* the reset comes back to the start of the same block.
    counted.Reset();
    Assert(counted.BytesUsed() == 0, "a reset rewinds the arena completely");
    Assert(counted.BlockCount() == 1, "keeping the block it already had");

    let afterReset = firstAllocator.Allocate(unit)?;
    Assert(afterReset == throughFirst, "and hands back the address the reset reclaimed, which is what invalidated it");
    Assert(counted.BytesUsed() == afterFirst, "with the accounting where it was after the first request");

    // --- An owner that moves -------------------------------------------------------------------------------------

    // An arena is move-only: it owns its blocks and copying would give two owners of each. A handle holds the
    // arena's address, so it does not survive the move — the rule `Arena::Handle` documents. What a caller does
    // instead is take a handle from the arena where it now is, which is what this checks works.
    var relocated <- counted;
    Assert(relocated.BytesUsed() == afterFirst, "a moved arena carries its accounting with it");
    Assert(relocated.BlockCount() == 1, "and the block it holds");

    var afterMove = relocated.Handle();
    let movedAllocator: Allocator = afterMove;
    let fromMoved = movedAllocator.Allocate(unit)?;
    Assert(relocated.BytesUsed() > afterFirst, "advancing the arena at its new home");
    Assert(fromMoved != afterReset, "with an address distinct from the one still outstanding");

    // A fixed buffer is the case where the storage does not move even though its owner might: the buffer points at
    // storage the caller owns, so a handle taken after a move serves out of the very same bytes.
    var moving = FixedBuffer(@storage[0] as *var opaque, 65536);
    var beforeMoveHandle = moving.Handle();
    let beforeMoveAllocator: Allocator = beforeMoveHandle;
    let early = beforeMoveAllocator.Allocate(unit)?;
    let earlyUsed = moving.BytesUsed();

    var carried <- moving;
    Assert(carried.BytesUsed() == earlyUsed, "a moved fixed buffer carries its accounting");
    var lateHandle = carried.Handle();
    let lateAllocator: Allocator = lateHandle;
    let late = lateAllocator.Allocate(unit)?;
    Assert(late != early, "handing out storage it had not already given away");
    Assert((late as uint) >= (@storage[0] as uint), "out of the caller's own bytes, which never moved");
    Assert((late as uint) < (@storage[0] as uint) + 65536, "and stays inside them");

}

/// Why an operation the test expects to be refused was refused. One that succeeds instead panics, so an expected
/// refusal cannot pass by accident.
func Refusal<T>(outcome: T ! AllocError) -> AllocError {
    return match <-outcome {
        .Failure(error) => error,
        .Success(_) => Panic("the allocator was expected to refuse")
    };
}
