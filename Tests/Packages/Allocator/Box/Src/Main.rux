import Allocator::{ AllocError, Allocator, Box, SystemAllocator };
import Core::{ Assert, Panic };

// A Box owns an allocation, so what is checked is that the allocation is released exactly once: not twice when the
// box is moved, and not at all when its value was taken out first. A double release would be caught by the system
// allocator's header check, and a leak by the loop below, which would exhaust the address space long before it
// finished — the system allocator being page-granular.

struct Tracked {
    destroyed: *var int32;
    value: int32;
}

extend Tracked {
    func ~Tracked(&var self) {
        if self.destroyed != null {
            // Safety: a non-null `destroyed` is the address of the local counter in `Main`, which outlives the value.
            unsafe { *self.destroyed += 1; }
        }
    }
}

func BoxAndDestroy(allocator: Allocator, destroyed: *var int32) throws AllocError {
    // A box accepts a move-only value.
    var boxed = Box<Tracked>(allocator, Tracked { destroyed, value: 91 });
    let held = (boxed.Get() ?? Panic("the box was just filled")).value;
    // Safety: `destroyed` is the address of the caller's live counter.
    let destroyedCount = unsafe { *destroyed };
    Assert(held == 91, "the box owns its value");
    Assert(destroyedCount == 0, "without destroying it during construction");
}

func BoxAndTake(allocator: Allocator, destroyed: *var int32) throws AllocError {
    var boxed = Box<Tracked>(allocator, Tracked { destroyed, value: 27 });
    let taken = boxed.Take() ?? Panic("a move-only value can be taken from a box");
    Assert(boxed.IsEmpty(), "taking leaves its box empty");
    // Safety: `destroyed` is the address of the live counter the caller passed in.
    let destroyedCount = unsafe { *destroyed };
    Assert(taken.value == 27 && destroyedCount == 0, "and transfers rather than destroys the value");
}

func Main() throws AllocError {
    let allocator = SystemAllocator();

    // An ordinary box holds its value and lends it where it sits in the box's own storage.
    var boxed = Box<int64>(allocator, 42);
    Assert(!boxed.IsEmpty(), "the box holds a value");
    let given: int64 = boxed.Get() ?? Panic("the box holds a value");
    let slot = boxed.GetMutable() ?? Panic("the box holds a value");
    slot = 43;
    let written: int64 = boxed.Get() ?? Panic("the box holds a value");
    Assert(given == 42, "which is the one it was given");
    Assert(written == 43, "and the value is writable through the box");

    // Taking the value out empties the box and releases the storage there and then.
    let taken = boxed.Take() ?? Panic("the value is taken out");
    Assert(taken == 43, "and is what the box held");
    Assert(boxed.IsEmpty(), "which leaves the box empty");
    Assert(boxed.Get() is none, "with nothing to lend");
    Assert(boxed.Take() is none, "and taking again reports that there is nothing");

    // A box of a value wider than a machine word, to exercise a layout that is not the default.
    var wide = Box<uint64>(allocator, 0xFEDCBA9876543210);
    let wideValue: uint64 = wide.Get() ?? Panic("the box was just filled");
    Assert(wideValue == 0xFEDCBA9876543210u64, "a wide box keeps every bit of its value");

    // Many boxes in sequence, each released as its scope ends. A leak here would exhaust the address space long
    // before the loop finished, since the system allocator is page-granular.
    var index: int32 = 0;
    while index < 512 {
        var scoped = Box<int64>(allocator, index as int64);
        let scopedValue: int64 = scoped.Get() ?? Panic("the box was just filled");
        Assert(scopedValue == index as int64, "a scoped box holds what it was given");
        index = index + 1;
    }

    // Moving a box transfers it: the source is moved-out, so the storage is released once, by the destination.
    var source = Box<int64>(allocator, 7);
    var destination = move source;
    let movedValue: int64 = destination.Get() ?? Panic("the destination took over the filled box");
    Assert(movedValue == 7, "the destination holds the value");
    Assert(destination.Take() is .Some(emptied) && emptied == 7, "and it is still takeable from there");

    var destroyed: int32 = 0;
    try BoxAndDestroy(allocator, @destroyed);
    Assert(destroyed == 1, "destroying a box destroys its move-only value exactly once");

    destroyed = 0;
    try BoxAndTake(allocator, @destroyed);
    Assert(destroyed == 1, "a value taken from a box is destroyed by its new owner exactly once");
}
