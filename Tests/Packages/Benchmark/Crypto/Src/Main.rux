import Benchmark::{ BenchRunner, BlackBox };
import Core::{ MutableSlice, Slice };
import Crypto::Sha256Of;
import Time::Instant;

func Main() -> int {
    let runner = BenchRunner().WithWarmup(50u64).WithIterations(200u64).WithBytes(64u64);

    var buffer: char8[64];
    var i: uint = 0;
    while i < 64 {
        buffer[i] = ((i % 251) as uint8) as char8;
        i = i + 1;
    }

    let message = Slice<char8> { data: @buffer[0], length: 64 };

    // Warm-up SHA-256
    var w: uint64 = 0;
    while w < runner.warmupIters {
        var digest: char8[32];
        let outSlice = MutableSlice::From<char8>(@digest[0], 32);
        Sha256Of(message, outSlice);
        let b = BlackBox(digest[0]);
        w = w + 1u64;
    }

    // Measure SHA-256
    let start = Instant::Now();
    var it: uint64 = 0;
    while it < runner.measuredIters {
        var digest: char8[32];
        let outSlice = MutableSlice::From<char8>(@digest[0], 32);
        Sha256Of(message, outSlice);
        let b = BlackBox(digest[0]);
        it = it + 1u64;
    }
    let elapsed = start.Elapsed();

    let result = runner.ComputeResult(elapsed);
    if result.iterations != 200u64 {
        return 1;
    }

    return 0;
}
