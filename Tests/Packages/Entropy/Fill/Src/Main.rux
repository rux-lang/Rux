import Core::Assert;
import Entropy::{ EntropyError, EntropySource, Fill, FillFrom, FillWithRetries, NextUint64, SystemEntropy };

// The failure paths are what this tests, and they cannot be reached through the real generator: they need a kernel
// with no source, a process being signalled steadily, or a provider that refuses. So the source is an interface and
// the test supplies one that fails on demand, which means the code handling a failure here is the same code that
// handles it in production.

// The scripted source keeps its state directly. A borrowed interface view refers to this value rather than copying
// it, so the test can observe the same counters that the implementation updates.
struct ScriptedSource {
    // What to report until `failures` runs out.
    error: EntropyError;
    // How many more calls report `error`; after that the source succeeds.
    failures: uint;
    // How many times the source has been called, so the retry policy can be checked rather than assumed.
    calls: uint;
}

extend ScriptedSource : EntropySource {
    func Fill(self: &var ScriptedSource, buffer: *var opaque, length: uint) -> EntropyError {
        self.calls = self.calls + 1;

        // Write a recognizable pattern first, exactly as a real source that fails part-way through would. If the
        // facade ever let a partial write reach a caller, this is what would be sitting in the buffer.
        var index: uint = 0;
        let bytes = buffer as *var byte;
        while index < length {
            *(bytes + index) = 0x7E;
            index++;
        }

        if self.failures > 0 {
            self.failures = self.failures - 1;
            return self.error;
        }
        return EntropyError::None;
    }
}

func Scripted(error: EntropyError, failures: uint) -> ScriptedSource {
    return ScriptedSource { error: error, failures: failures, calls: 0 };
}

func AllBytesAre(buffer: *byte, length: uint, value: byte) -> bool {
    var index: uint = 0;
    while index < length {
        if *(buffer + index) != value {
            return false;
        }
        index++;
    }
    return true;
}

func Main() -> int {
    var storage: byte[64];

    // A source that always succeeds fills the buffer, in a single call.
    var working = Scripted(EntropyError::None, 0);
    let workingSource: &var EntropySource = working;
    Assert(FillFrom(workingSource, @storage[0] as *var opaque, 64) == EntropyError::None,
           "a working source fills the buffer");
    Assert(working.calls == 1, "in a single call");
    Assert(AllBytesAre(@storage[0] as *byte, 64, 0x7E), "and what it wrote is what came back");

    // A refusal is reported, and everything the source managed to write is destroyed before the caller sees it.
    var refusing = Scripted(EntropyError::Failed, 1);
    let refusingSource: &var EntropySource = refusing;
    Assert(FillFrom(refusingSource, @storage[0] as *var opaque, 64) == EntropyError::Failed,
           "a refusal is reported as it was given");
    Assert(AllBytesAre(@storage[0] as *byte, 64, 0), "and the partial write is zeroized rather than left");

    // A system with no source reports that, and is not retried, because it will not grow one.
    var missing = Scripted(EntropyError::Unsupported, 8);
    let missingSource: &var EntropySource = missing;
    Assert(FillWithRetries(missingSource, @storage[0] as *var opaque, 64, 4) == EntropyError::Unsupported,
           "a system with no source reports it");
    Assert(missing.calls == 1, "and is asked exactly once, however many retries were offered");

    // An interruption is transient, so the retries are actually spent on it.
    var signalled = Scripted(EntropyError::Interrupted, 2);
    let signalledSource: &var EntropySource = signalled;
    Assert(FillWithRetries(signalledSource, @storage[0] as *var opaque, 64, 4) == EntropyError::None,
           "an interruption that clears is retried into success");
    Assert(signalled.calls == 3, "taking exactly the two failures and the attempt that worked");
    Assert(AllBytesAre(@storage[0] as *byte, 64, 0x7E), "and the successful attempt is what the caller keeps");

    // Retries are bounded: a source that stays interrupted is given up on rather than looped on forever.
    var stuck = Scripted(EntropyError::Interrupted, 100);
    let stuckSource: &var EntropySource = stuck;
    Assert(FillWithRetries(stuckSource, @storage[0] as *var opaque, 64, 3) == EntropyError::Interrupted,
           "a source that stays interrupted is given up on");
    Assert(stuck.calls == 4, "after the first attempt and exactly the three retries offered");
    Assert(AllBytesAre(@storage[0] as *byte, 64, 0), "leaving zeros rather than a partly written buffer");

    // Zero retries is one attempt, which is what makes the parameter an addition rather than a total.
    var once = Scripted(EntropyError::Interrupted, 100);
    let onceSource: &var EntropySource = once;
    Assert(FillWithRetries(onceSource, @storage[0] as *var opaque, 64, 0) == EntropyError::Interrupted,
           "no retries means one attempt");
    Assert(once.calls == 1, "and exactly one call");

    // The degenerate requests never reach the source at all.
    var untouched = Scripted(EntropyError::Failed, 100);
    let untouchedSource: &var EntropySource = untouched;
    Assert(FillFrom(untouchedSource, @storage[0] as *var opaque, 0) == EntropyError::None,
           "a zero-length request succeeds");
    Assert(FillFrom(untouchedSource, null, 64) == EntropyError::Failed, "and a null buffer is refused");
    Assert(untouched.calls == 0, "without either one reaching the source");

    // The real generator, reached the way a caller reaches it.
    Assert(Fill(@storage[0] as *var opaque, 64) == EntropyError::None, "the system source fills a buffer");
    Assert(!AllBytesAre(@storage[0] as *byte, 64, 0), "with something other than zeros");
    Assert(!AllBytesAre(@storage[0] as *byte, 64, 0x7E), "and something other than the scripted pattern");

    // The same source through the interface, which is what generic code will be handed.
    var system = SystemEntropy();
    let systemSource: &var EntropySource = system;
    Assert(FillFrom(systemSource, @storage[0] as *var opaque, 64) == EntropyError::None,
           "and does the same through the interface");

    // A seed is a draw like any other, and two of them differ.
    var error = EntropyError::Failed;
    let firstSeed = NextUint64(@error);
    Assert(error == EntropyError::None, "a seed reports success");
    let secondSeed = NextUint64(@error);
    Assert(error == EntropyError::None, "and so does the next");
    Assert(firstSeed != secondSeed, "and two seeds differ");

    return 0;
}
