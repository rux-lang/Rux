import Core::{ Assert, Ordering };
import Time::{ Duration, Timestamp };

// A wall clock cannot be tested for what it says — the machine's clock is whatever it is — so what is tested is
// the arithmetic around it and the one claim that survives any clock setting: now is after 2020 and before 2100,
// or the machine is so wrong that no test suite result means anything.

func Main() -> int {
    let epoch = Timestamp::Epoch();
    Assert(epoch.UnixSeconds() == 0 && epoch.SubsecondNanoseconds() == 0, "the epoch is zero exactly");

    let now = Timestamp::Now();
    Assert(now.UnixSeconds() > 1577836800, "now is after the start of 2020");
    Assert(now.UnixSeconds() < 4102444800, "and before the start of 2100");
    Assert(now.SubsecondNanoseconds() < 1000000000, "with the fraction in range");
    Assert(now.Compare(epoch) == Ordering::Greater, "and later than the epoch");

    // The distance from the epoch is the seconds themselves.
    let sinceEpoch = (now.Since(epoch) ?? Duration::Zero());
    Assert(sinceEpoch.WholeSeconds() == now.UnixSeconds(), "the span from the epoch is the count itself");
    Assert(sinceEpoch.SubsecondNanoseconds() == now.SubsecondNanoseconds(), "fraction included");

    // A reversed pair answers with a negative span rather than refusing: the wall clock really does go backwards.
    let reversed = (epoch.Since(now) ?? Duration::Zero());
    Assert(reversed.IsNegative(), "the reversed pair is a negative span");
    let cancelled = (sinceEpoch.Plus(reversed) ?? Duration::FromSeconds(99));
    Assert(cancelled.IsZero(), "and the two cancel exactly");

    // Shifting, both directions, across the epoch.
    let early = Timestamp::FromUnixSeconds(-1);
    Assert(early.Compare(epoch) == Ordering::Less, "a moment before the epoch is negative seconds");
    let shifted = (early.Plus(Duration::FromMilliseconds(1500)) ?? epoch);
    Assert(shifted.UnixSeconds() == 0 && shifted.SubsecondNanoseconds() == 500000000,
           "shifting across the epoch normalizes");
    let moved = (now.Plus(Duration::FromSeconds(3600)) ?? epoch);
    Assert((moved.Since(now) ?? Duration::Zero()).WholeSeconds() == 3600,
           "an hour forward is an hour apart");
    Assert(!(now.Plus(Duration::FromSeconds(9223372036854775807)) is Timestamp), "and the far edge refuses");

    // A second reading is close to the first: within a minute, or the clock jumped mid-test, which is exactly the
    // kind of claim a wall clock is allowed to break — so the bound is generous rather than tight.
    let later = Timestamp::Now();
    let gap = (later.Since(now) ?? Duration::FromSeconds(-999));
    Assert(gap.Compare(Duration::FromSeconds(60)) == Ordering::Less, "two readings sit close together");

    return 0;
}
