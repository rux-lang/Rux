import Core::{ Assert, Option, Result };
import Text::{ BufferWriter, Display, FormatSpec };
import Time::{ Date, DateTime, OffsetDateTime, ParseDate, ParseDateTime, ParseRfc3339, ParseTimeOfDay,
               TimeOfDay, TimeParseError, UtcOffset };

// Reading a moment out of text, and saying where the text went wrong.
//
// The parsers answer a `Result` now rather than a bool through output slots, so the interesting half of this file
// is the failures: which category a mistake lands in, and which byte it points at. A caller that cannot tell a typo
// from a February the thirtieth cannot report either usefully, and one that cannot point at a character makes its
// user re-read their own input to guess.
//
// The categories are the ones a caller acts on differently. A malformed shape is the writer's mistake. A month of
// 13, a day the month does not have, and an hour of 24 are well-formed text naming something that does not exist,
// which is usually a different bug. An excessive fraction and an impossible offset are fields that parsed and then
// would not fit.

// Which failure a result carries, as a small code, so a check names the reason it expects rather than only that
// something failed: 0 success, 1 InvalidSyntax, 2 InvalidMonth, 3 NonexistentDay, 4 InvalidTime,
// 5 ExcessiveFraction, 6 InvalidOffset.
func CodeOf(error: &TimeParseError) -> int {
    return match error {
        .InvalidSyntax(_) => 1,
        .InvalidMonth(_) => 2,
        .NonexistentDay(_) => 3,
        .InvalidTime(_) => 4,
        .ExcessiveFraction(_) => 5,
        .InvalidOffset(_) => 6
    };
}

// Zero when `text` fails to parse as RFC 3339 with exactly `code` at exactly `at`; a distinct non-zero value
// otherwise, so a check cannot pass by failing for another reason or in another place.
func FailsAt(text: char8[..], code: int, at: uint) -> int {
    let outcome = ParseRfc3339(text);
    if outcome.IsSuccess() { return 1; }
    var found: int = 0;
    var where: uint = 0;
    match outcome {
        .Success(_) => {
        },
        .Error(reason) => {
            found = CodeOf(reason);
            where = reason.Offset();
        }
    }
    if found != code { return 2; }
    if where != at { return 3; }
    return 0;
}

func Same(actual: char8[..], expected: char8[..]) -> bool {
    if actual.length != expected.length { return false; }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] { return false; }
        index = index + 1;
    }
    return true;
}

// The RFC 3339 text of a moment, through the Display the value now has.
func Rendered(moment: OffsetDateTime, expected: char8[..]) -> bool {
    var storage: char8[64];
    var writer = BufferWriter((@storage[0])[..64]);
    let shown: Display = moment;
    if shown.WriteDisplay(writer, FormatSpec::Plain()).IsError() { return false; }
    return Same(writer.Written(), expected);
}

// Check a positioned failure independently of the public parser's success type.
func HasFailure<T>(outcome: Result<T, TimeParseError>, code: int, at: uint) -> bool {
    return match outcome {
        .Success(_) => false,
        .Error(reason) => CodeOf(reason) == code && reason.Offset() == at
    };
}

func PropagationCases() {
    let complete = "2024-02-29T12:34:56Z";
    var length = 0u;
    while length < complete.length {
        Assert(FailsAt(complete.data[..length], 1, length) == 0,
               "every truncated prefix preserves the failing reader's end offset");
        length += 1u;
    }
    Assert(FailsAt("2024-02-29T12:34:56+05:", 1, 23u) == 0, "offset minutes propagate through digit and offset readers");
    Assert(FailsAt("2024-02-29T12:34:56+05:3", 1, 24u) == 0, "a partial final field retains its nonzero end offset");
    Assert(FailsAt("2024-02-29T12:34:56+05:30extra", 1, 25u) == 0, "the end check reports the first trailing byte");
    Assert(FailsAt("2024-02-29T12:34:éZ", 1, 17u) == 0, "a multibyte character fails at its first UTF-8 byte");
    Assert(FailsAt("2024-02-29T12:34:56.123456789😀", 1, 29u) == 0, "a supplementary character is not an offset marker");
    Assert(FailsAt("2024-02-29T12:34:56Zé", 1, 20u) == 0, "trailing Unicode keeps the byte position after Z");
    Assert(HasFailure<Date>(ParseDate("2024-13-01"), 2, 5u), "date-only invalid months retain their category and offset");
    Assert(HasFailure<Date>(ParseDate("2023-02-29"), 3, 8u), "date-only invalid days survive rewrapping");
    Assert(HasFailure<Date>(ParseDate("2024-é-29"), 1, 5u), "date-only Unicode is rejected at its first byte");
    Assert(HasFailure<TimeOfDay>(ParseTimeOfDay("12:60:00"), 4, 3u), "time-only validation reports the local minute offset");
    Assert(HasFailure<TimeOfDay>(ParseTimeOfDay("12:34:56.1234567890"), 5, 18u), "time-only excessive fraction offset survives");
    Assert(HasFailure<TimeOfDay>(ParseTimeOfDay("12:34:56Z"), 1, 8u), "time-only end check rejects an offset suffix");
    Assert(HasFailure<DateTime>(ParseDateTime("2024-02-29T12:60:00"), 4, 14u), "embedded time uses its position in the full text");
    Assert(HasFailure<DateTime>(ParseDateTime("2024-02-29T12:34:56Z"), 1, 19u), "local date-time rejects an offset without discarding it");
}

func Main() -> int {
    PropagationCases();

    // The shapes that parse, and what they parse to.
    let plain = ParseRfc3339("2024-02-29T12:30:45Z");
    Assert(plain.IsSuccess(), "the plain shape parses");
    let moment = plain.ValueOr(OffsetDateTime(DateTime { date: Date::FromEpochDays(0i64), time: TimeOfDay::Midnight() },
                                              UtcOffset::Utc()));
    Assert(moment.dateTime.date.year == 2024i32 && moment.dateTime.date.month == 2u8 &&
           moment.dateTime.date.day == 29u8, "a leap day in a leap year is a day");
    Assert(moment.dateTime.time.hour == 12u8 && moment.dateTime.time.minute == 30u8 &&
           moment.dateTime.time.second == 45u8, "and the time is what was written");
    Assert(moment.offset.TotalSeconds() == 0i32, "and Z is UTC");

    Assert(ParseRfc3339("2024-02-29t12:30:45.5z").IsSuccess(), "the lower-case letters parse too");
    Assert(ParseRfc3339("2024-02-29 12:30:45.123456789+05:30").IsSuccess(), "a space separator parses");
    Assert(ParseRfc3339("1970-01-01T00:00:00-08:00").IsSuccess(), "a negative offset parses");
    Assert(ParseRfc3339("2024-01-01T00:00:00.000000000Z").IsSuccess(), "nine fraction digits parse");

    // The leap second parses and folds, which is the one lossy acceptance this package makes on purpose.
    let leap = ParseRfc3339("2016-12-31T23:59:60Z");
    Assert(leap.IsSuccess(), "the leap second parses");
    let folded = leap.ValueOr(OffsetDateTime(DateTime { date: Date::FromEpochDays(0i64), time: TimeOfDay::Midnight() },
                                             UtcOffset::Utc()));
    Assert(folded.dateTime.time.second == 59u8 && folded.dateTime.time.nanosecond == 999999999u32,
           "and folds to the last nanosecond of second 59");

    // A syntax failure points at the byte where the shape stopped matching.
    Assert(FailsAt("2024-02-29X12:30:45Z", 1, 10u) == 0, "a wrong separator is a syntax failure at the separator");
    Assert(FailsAt("2024/02/29T12:30:45Z", 1, 4u) == 0, "and a wrong dash at the dash");
    Assert(FailsAt("2024-02-29T12:30:45Z ", 1, 20u) == 0, "text after the offset is a syntax failure where it starts");
    Assert(FailsAt("2024-02-29T12:30:45", 1, 19u) == 0, "and running out points one past the end");
    Assert(FailsAt("", 1, 0u) == 0, "empty text fails at the beginning, which is also the end");
    Assert(FailsAt("2O24-02-29T12:30:45Z", 1, 1u) == 0, "a letter where a digit belongs points at the letter");

    // A well-formed field naming something that does not exist is a different category from a typo.
    Assert(FailsAt("2024-13-01T00:00:00Z", 2, 5u) == 0, "month 13 is an invalid month at its first digit");
    Assert(FailsAt("2024-00-01T00:00:00Z", 2, 5u) == 0, "and so is month 0");
    Assert(FailsAt("2023-02-29T00:00:00Z", 3, 8u) == 0, "February 29 outside a leap year is a nonexistent day");
    Assert(FailsAt("2024-04-31T00:00:00Z", 3, 8u) == 0, "and April has no 31st");
    Assert(FailsAt("2024-01-00T00:00:00Z", 3, 8u) == 0, "nor has any month a zeroth");
    Assert(FailsAt("2024-01-01T24:00:00Z", 4, 11u) == 0, "hour 24 is an invalid time at the hour");
    Assert(FailsAt("2024-01-01T00:60:00Z", 4, 14u) == 0, "minute 60 at the minute");
    Assert(FailsAt("2024-01-01T00:00:61Z", 4, 17u) == 0, "second 61 at the second, since 60 is the leap second");

    // A fraction that will not fit, and an offset that is not one.
    Assert(FailsAt("2024-01-01T00:00:00.0000000005Z", 5, 29u) == 0,
           "a tenth fraction digit is an excessive fraction at that digit");
    Assert(FailsAt("2024-01-01T00:00:00.Z", 1, 20u) == 0, "a point with no digits is a syntax failure");
    Assert(FailsAt("2024-01-01T00:00:00+24:00", 6, 19u) == 0, "an impossible offset points at its sign");
    Assert(FailsAt("2024-01-01T00:00:00+05:60", 6, 19u) == 0, "and so does an impossible offset minute");
    Assert(FailsAt("2024-01-01T00:00:00", 1, 19u) == 0, "a missing offset runs out rather than defaulting to UTC");

    // The three narrower parsers read what they name and nothing more.
    Assert(ParseDate("2024-02-29").IsSuccess(), "a date parses on its own");
    Assert(ParseDate("2024-02-29T00:00:00Z").IsError(), "and refuses a whole moment");
    Assert(ParseTimeOfDay("12:30:45").IsSuccess(), "a time parses on its own");
    Assert(ParseTimeOfDay("12:30:45.25").IsSuccess(), "with a fraction");
    Assert(ParseDateTime("2024-02-29T12:30:45").IsSuccess(), "a local date-time parses without an offset");
    Assert(ParseDateTime("2024-02-29T12:30:45Z").IsError(),
           "and refuses one with an offset, having nowhere to keep it");

    // The round trip: what Display writes, ParseRfc3339 reads back to the same moment.
    let source = ParseRfc3339("2024-02-29T12:30:45.5-08:00");
    Assert(source.IsSuccess(), "the round-trip source parses");
    let original = source.ValueOr(OffsetDateTime(DateTime { date: Date::FromEpochDays(0i64), time: TimeOfDay::Midnight() },
                                                 UtcOffset::Utc()));
    Assert(Rendered(original, "2024-02-29T12:30:45.5-08:00"), "and renders back to the text it came from");
    let again = ParseRfc3339("2024-02-29T12:30:45.5-08:00");
    Assert(again.IsSuccess(), "which parses again");
    let second = again.ValueOr(original);
    Assert(second.ToTimestamp().seconds == original.ToTimestamp().seconds, "to the same instant");
    Assert(second.offset.TotalSeconds() == original.offset.TotalSeconds(), "at the same offset");

    // Formatting never produces second 60, which is what makes the fold one-way.
    Assert(Rendered(folded, "2016-12-31T23:59:59.999999999Z"), "the folded leap second renders as second 59");
    return 0;
}
