// Streaming exists so that reading one setting out of a large file does not cost the whole file, so what is
// tested here is that the events arrive in document order and that the reader still refuses malformed structure.
// It cannot refuse a table defined twice — that needs the tree it is avoiding — and pretending otherwise would
// be worse than saying so.

import Core::{ Assert, Panic };
import Text::{ BufferWriter, FormatSpec, TextWriter };
import Toml::{ TomlEvent, TomlEventReader };

// Whether the next event arrives and is `expected`.
func Arrives(reader: &var TomlEventReader, expected: TomlEvent) -> bool {
    let event = try reader.Next() catch { _ => return false };
    return event is .Some(arrived) && arrived == expected;
}

// Whether the document ends at the next call, with nothing wrong.
func Ends(reader: &var TomlEventReader) -> bool {
    let event = try reader.Next() catch { _ => return false };
    return event is none;
}

// Reads past one event, which must arrive.
func Skip(reader: &var TomlEventReader) {
    let event = try reader.Next() catch { _ => Panic("an event arrives") };
    Assert(event is .Some(_), "an event arrives");
}

// How many events `text` produces before it ends or is refused.
func Shape(text: char8[..]) -> uint {
    var reader = TomlEventReader(text);
    var count: uint = 0;
    while true {
        let event = try reader.Next() catch { _ => return count };
        if event is none { return count; }
        count = count + 1;
    }
    return count;
}

// Reads to the end and renders whatever stopped it, or writes nothing when nothing did. The rendering names the
// case and the position, so one assertion covers both — and it is the same failure the tree parser reports, which
// is the point of the two agreeing on a vocabulary.
func FailsWith(text: char8[..], into: var char8[..]) -> uint {
    var reader = TomlEventReader(text);
    while true {
        let event = try reader.Next() catch {
            failure => {
                var writer = BufferWriter(into);
                let sink: &var TextWriter = writer;
                Assert((try? failure.WriteDebug(sink, FormatSpec::Plain())) is .Some(_), "a failure renders");
                return writer.Length();
            },
        };
        if event is none { return 0; }
    }
    return 0;
}

func Same(actual: char8[..], expected: char8[..]) -> bool {
    if actual.length != expected.length { return false; }
    var index: uint = 0;
    while index < actual.length {
        if actual[index] != expected[index] { return false; }
        index = index + 1;
    }
    return true;
}

func Stops(text: char8[..], expected: char8[..]) -> bool {
    var storage: char8[96];
    let length = FailsWith(text, storage[..96]);
    return Same(storage[..length], expected);
}

func Main() -> int {
    // A pair arrives as a key and then its value.
    var pair = TomlEventReader("title = \"TOML\"");
    Assert(Arrives(pair, TomlEvent::KeyStart), "a pair begins with its key");
    Assert(Arrives(pair, TomlEvent::KeyPart), "whose one part follows");
    Assert(pair.Span().length == 5, "spanning the key as written");
    Assert(Arrives(pair, TomlEvent::Text), "then the value");
    Assert(pair.Span().length == 4, "spanning the string without its quotes");
    Assert(Ends(pair), "and then the document is finished");

    // A dotted key arrives as one part per name.
    var dotted = TomlEventReader("a.b.c = 1");
    Skip(dotted);
    Assert(Arrives(dotted, TomlEvent::KeyPart), "the first part");
    Assert(Arrives(dotted, TomlEvent::KeyPart), "the second");
    Assert(Arrives(dotted, TomlEvent::KeyPart), "and the third");
    Assert(Arrives(dotted, TomlEvent::Integer), "before the value");

    // A header opens, names its path, and closes.
    var header = TomlEventReader("[[a.b]]\nx = 1");
    Assert(Arrives(header, TomlEvent::HeaderStart), "a header opens");
    Assert(header.IsTableArray(), "and this one is the array spelling");
    Assert(Arrives(header, TomlEvent::KeyPart), "with its parts");
    Assert(Arrives(header, TomlEvent::KeyPart), "one at a time");
    Assert(Arrives(header, TomlEvent::HeaderEnd), "and then it closes");
    Assert(Arrives(header, TomlEvent::KeyStart), "and the lines after it follow");

    // Containers nest, and the reader says how deep it is.
    var nested = TomlEventReader("a = [1, [2], { b = 3 }]");
    Skip(nested);
    Skip(nested);
    Assert(Arrives(nested, TomlEvent::ArrayStart), "an array opens");
    Assert(nested.Depth() == 1, "one deep");
    Assert(Arrives(nested, TomlEvent::Integer), "its first element");
    Assert(Arrives(nested, TomlEvent::ArrayStart), "then an array inside it");
    Assert(nested.Depth() == 2, "two deep");
    Assert(Arrives(nested, TomlEvent::Integer), "holding one element");
    Assert(Arrives(nested, TomlEvent::ArrayEnd), "which closes");
    Assert(Arrives(nested, TomlEvent::InlineTableStart), "then an inline table");
    Assert(Arrives(nested, TomlEvent::KeyStart), "with a key");
    Assert(Arrives(nested, TomlEvent::KeyPart), "of one part");
    Assert(Arrives(nested, TomlEvent::Integer), "and a value");
    Assert(Arrives(nested, TomlEvent::InlineTableEnd), "before it closes");
    Assert(Arrives(nested, TomlEvent::ArrayEnd), "and then the outer array does");
    Assert(nested.Depth() == 0, "leaving nothing open");
    Assert(Ends(nested), "at the end of the document");

    // Locations, because a streaming reader that could not point at a line would leave the caller counting
    // bytes.
    var located = TomlEventReader("a = 1\n\nb = 2");
    Skip(located);
    Skip(located);
    Skip(located);
    Assert(Arrives(located, TomlEvent::KeyStart), "the second pair begins");
    Assert(located.Line() == 3, "on the third line, blank lines counted");
    Assert(located.Column() == 1, "at the first column");

    // Text arrives as written, so a caller skipping a field pays nothing for its escapes.
    var raw = TomlEventReader("a = \"x\\ty\"");
    Skip(raw);
    Skip(raw);
    Assert(Arrives(raw, TomlEvent::Text), "a string with an escape in it");
    Assert(raw.Span().length == 4, "spans the four bytes it was written with, unresolved");

    // A whole document streams in order, and the count is what the shape says.
    Assert(Shape("[a]\nx = 1\ny = [1, 2]") == 12,
           "a header, its two pairs and their values arrive as twelve events");

    // Structure is still checked, because a reader that accepted malformed input would push the problem onto
    // every caller.
    Assert(Stops("a = [1, 2", "TomlParseError::Truncated at 1:10"), "an array left open");
    Assert(Stops("a = { b = 1", "TomlParseError::Truncated at 1:12"), "an inline table left open");
    Assert(Stops("a = [1}", "TomlParseError::Unexpected at 1:7"), "a brace closing a bracket");
    Assert(Stops("[a\nx = 1", "TomlParseError::Unexpected at 1:3"), "a header with no closing bracket");
    Assert(Stops("[]\nx = 1", "TomlParseError::Unexpected at 1:2"), "a header that names nothing");
    Assert(Stops("a 1", "TomlParseError::Unexpected at 1:3"), "a pair with no equals sign");
    Assert(Stops("a = \"unterminated", "TomlParseError::Lexical(UnterminatedText) at 1:5"),
           "and a string the lexer refused, carrying the lexer's own reason inside it");

    // What streaming cannot do, stated rather than pretended: a table defined twice needs the set of tables
    // already seen, which is the tree this reader exists to avoid building.
    var quiet: char8[96];
    Assert(FailsWith("[a]\n[a]", quiet[..96]) == 0,
           "a redefinition streams without complaint, and the parser is what refuses it");

    return 0;
}
