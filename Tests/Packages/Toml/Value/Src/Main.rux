
// TOML has real types, so the interesting question about a value is not what it can be coerced into but what it
// refuses to be. An integer is not a float here even when the float is whole, and a local date-time has no
// offset — inventing one is how a meeting ends up an hour out.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Text::{ String, StringView };
import Time::{ Date, TimeOfDay, UtcOffset };
import Toml::{ TomlKind, TomlValue };

func View(bytes: char8[..]) -> StringView {
    return StringView::FromBytes(bytes) ?? StringView();
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // Each kind reports itself, and answers only the accessor that matches.
    var integer = TomlValue::Integer(allocator, -17);
    Assert(integer.Kind() == TomlKind::Integer, "an integer knows what it is");
    var readInteger: int64 = 0;
    Assert(integer.AsInteger(@readInteger) && readInteger == -17i64, "and gives back what it was made with");
    var readFloat = 0.0;
    Assert(!integer.AsFloat(@readFloat), "an integer is not a float, which TOML distinguishes and JSON does not");

    var number = TomlValue::Float(allocator, 1.0);
    Assert(number.Kind() == TomlKind::Float, "a whole float is still a float");
    Assert(!number.AsInteger(@readInteger), "and does not answer as an integer");

    var flag = TomlValue::Boolean(allocator, true);
    var readFlag = false;
    Assert(flag.AsBoolean(@readFlag) && readFlag, "a boolean");
    Assert(!integer.AsBoolean(@readFlag), "which an integer is not");

    var text = TomlValue::Text(allocator, "hello") catch { else => Panic("a string value is made") };
    Assert(text.Kind() == TomlKind::Text, "a string");
    Assert(text.AsText().Length() == 5, "of the length it was given");
    Assert(integer.AsText().Length() == 0, "while a non-string reports an empty view rather than its bytes");

    // The four date-time kinds differ in which parts they have, and that is the whole point of having four.
    let date = (Date::New(1979, 5, 27) ?? Date { year: 1970, month: 1, day: 1 });
    let time = TimeOfDay::New(7, 32, 0, 0) ?? TimeOfDay { hour: 0, minute: 0, second: 0, nanosecond: 0 };
    let offset = (UtcOffset::Of(-8, 0) ?? UtcOffset::Utc());

    var moment = TomlValue::OffsetDateTime(allocator, date, time, offset);
    var readOffset = UtcOffset::Utc();
    Assert(moment.AsOffset(@readOffset), "an offset date-time has an offset");
    Assert(readOffset.TotalSeconds() == -28800i32, "which is the one it was written with");

    var wall = TomlValue::LocalDateTime(allocator, date, time);
    Assert(!wall.AsOffset(@readOffset), "a local date-time deliberately has none");
    var readDate = Date { year: 1970, month: 1, day: 1 };
    var readTime = TimeOfDay { hour: 0, minute: 0, second: 0, nanosecond: 0 };
    Assert(wall.AsDate(@readDate) && readDate.day == 27, "but it does have a date");
    Assert(wall.AsTime(@readTime) && readTime.hour == 7, "and a time");

    var justDate = TomlValue::LocalDate(allocator, date);
    Assert(!justDate.AsTime(@readTime), "a local date has no time");
    var justTime = TomlValue::LocalTime(allocator, time);
    Assert(!justTime.AsDate(@readDate), "and a local time has no date");

    // A table keeps its entries in the order they arrived, which is what makes a document round-trip
    // recognisably rather than alphabetically.
    var table = TomlValue::Table(allocator);
    var zebra = String::FromBytes(allocator, "zebra") catch { else => Panic("the key is made") };
    table.Insert(zebra, TomlValue::Integer(allocator, 1));
    var apple = String::FromBytes(allocator, "apple") catch { else => Panic("the key is made") };
    table.Insert(apple, TomlValue::Integer(allocator, 2));
    var middle = String::FromBytes(allocator, "middle") catch { else => Panic("the key is made") };
    table.Insert(middle, TomlValue::Integer(allocator, 3));
    Assert(table.Length() == 3, "a table holds what it was given");
    Assert(table.EntryAt(0).key.View().Length() == 5, "the first entry is the first one added");
    var firstKey = table.EntryAt(0).key.View();
    Assert(firstKey.Bytes().data[0] == c8'z', "which is zebra, not apple");
    Assert(table.EntryAt(2).key.View().Bytes().data[0] == c8'm', "and the last is the last added");
    Assert(table.EntryAt(3) == null, "past the end there is nothing");

    // Lookup finds by key, and reports absence rather than inventing an empty value.
    var found = table.Find(View("apple"));
    Assert(found != null, "a key that is there is found");
    Assert((*found).AsInteger(@readInteger) && readInteger == 2, "with the value it was stored with");
    Assert(table.Find(View("pear")) == null, "and a key that is not there is not");

    // An array keeps its order too, and a borrowed element can be modified in place — which is how an array of
    // tables grows a member after its header has already been read.
    var array = TomlValue::Array(allocator);
    array.Push(TomlValue::Integer(allocator, 10));
    array.Push(TomlValue::Integer(allocator, 20));
    Assert(array.Length() == 2, "an array holds what it was given");
    Assert((*array.At(1)).AsInteger(@readInteger) && readInteger == 20, "in order");
    var element = array.AtMutable(0);
    element.integer = 11;
    Assert((*array.At(0)).AsInteger(@readInteger) && readInteger == 11,
           "and an element can be edited in place");

    // The kinds do not answer each other's questions.
    Assert(array.Find(View("apple")) == null, "an array has no keys");
    Assert(table.At(0) == null, "and a table has no elements");
    Assert(!table.Push(TomlValue::Integer(allocator, 1)), "pushing onto a table is refused");
    var stray = String::FromBytes(allocator, "stray") catch { else => Panic("the key is made") };
    Assert(!array.Insert(stray, TomlValue::Integer(allocator, 1)), "and inserting into an array is too");

    // Ownership is the whole difficulty of a document tree: a table holding a table holding an array must
    // release all of it exactly once, and it is released when the outermost value dies at the end of this scope.
    var outer = TomlValue::Table(allocator);
    var inner = TomlValue::Table(allocator);
    var nested = TomlValue::Array(allocator);
    nested.Push(TomlValue::Text(allocator, "held") catch { else => Panic("a nested string value is made") });
    nested.Push(TomlValue::Text(allocator, "also held") catch { else => Panic("a nested string value is made") });
    var nestedKey = String::FromBytes(allocator, "list") catch { else => Panic("the key is made") };
    inner.Insert(nestedKey, <-nested);
    var innerKey = String::FromBytes(allocator, "inner") catch { else => Panic("the key is made") };
    outer.Insert(innerKey, <-inner);
    Assert((*(*outer.Find(View("inner"))).Find(View("list"))).Length() == 2,
           "a nested tree is reachable all the way down");

    return 0;
}
