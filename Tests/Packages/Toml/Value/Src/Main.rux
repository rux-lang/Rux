
// TOML has real types, so the interesting question about a value is not what it can be coerced into but what it
// refuses to be. An integer is not a float here even when the float is whole, and a local date-time has no
// offset — inventing one is how a meeting ends up an hour out.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Text::{ String, StringView };
import Time::{ Date, TimeOfDay, UtcOffset };
import Toml::{ TomlKind, TomlValue };

func View(bytes: char8[..]) -> StringView {
    return StringView::FromBytes(bytes) ?? StringView();
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // Each kind reports itself, and answers only the accessor that matches.
    var integer = TomlValue::Integer(allocator, -17);
    Assert(integer.Kind() == TomlKind::Integer, "an integer knows what it is");
    Assert(integer.AsInteger() is .Some(-17i64), "and gives back what it was made with");
    Assert(integer.AsFloat() is none, "an integer is not a float, which TOML distinguishes and JSON does not");

    var number = TomlValue::Float(allocator, 1.0);
    Assert(number.Kind() == TomlKind::Float, "a whole float is still a float");
    Assert(number.AsInteger() is none, "and does not answer as an integer");

    var flag = TomlValue::Boolean(allocator, true);
    Assert(flag.AsBoolean() is .Some(true), "a boolean");
    Assert(integer.AsBoolean() is none, "which an integer is not");

    var text = try TomlValue::Text(allocator, "hello") catch { _ => Panic("a string value is made") };
    Assert(text.Kind() == TomlKind::Text, "a string");
    Assert(text.AsText() is .Some(view) && view.Length() == 5, "of the length it was given");
    Assert(integer.AsText() is none, "while a non-string has no text rather than its bytes");

    // The four date-time kinds differ in which parts they have, and that is the whole point of having four.
    let date = (Date::FromParts(1979, 5, 27) ?? Date { year: 1970, month: 1, day: 1 });
    let time = TimeOfDay::FromParts(7, 32, 0, 0) ?? TimeOfDay { hour: 0, minute: 0, second: 0, nanosecond: 0 };
    let offset = (UtcOffset::Of(-8, 0) ?? UtcOffset::Utc());

    var moment = TomlValue::OffsetDateTime(allocator, date, time, offset);
    Assert(moment.AsOffset() is .Some(readOffset) && readOffset.TotalSeconds() == -28800i32,
           "an offset date-time has the offset it was written with");

    var wall = TomlValue::LocalDateTime(allocator, date, time);
    Assert(wall.AsOffset() is none, "a local date-time deliberately has none");
    Assert(wall.AsDate() is .Some(readDate) && readDate.day == 27, "but it does have a date");
    Assert(wall.AsTime() is .Some(readTime) && readTime.hour == 7, "and a time");

    var justDate = TomlValue::LocalDate(allocator, date);
    Assert(justDate.AsTime() is none, "a local date has no time");
    var justTime = TomlValue::LocalTime(allocator, time);
    Assert(justTime.AsDate() is none, "and a local time has no date");

    // A table keeps its entries in the order they arrived, which is what makes a document round-trip
    // recognisably rather than alphabetically.
    var table = TomlValue::Table(allocator);
    var zebra = try String::FromBytes(allocator, "zebra") catch { _ => Panic("the key is made") };
    try table.Insert(move zebra, TomlValue::Integer(allocator, 1)) catch { _ => Panic("the kind is right") };
    var apple = try String::FromBytes(allocator, "apple") catch { _ => Panic("the key is made") };
    try table.Insert(move apple, TomlValue::Integer(allocator, 2)) catch { _ => Panic("the kind is right") };
    var middle = try String::FromBytes(allocator, "middle") catch { _ => Panic("the key is made") };
    try table.Insert(move middle, TomlValue::Integer(allocator, 3)) catch { _ => Panic("the kind is right") };
    Assert(table.Length() is .Some(3), "a table holds what it was given");
    let first = table.EntryAt(0) ?? Panic("the table holds three entries");
    Assert(first.key.View().Length() == 5, "the first entry is the first one added");
    var firstKey = first.key.View();
    Assert(firstKey.Bytes()[0] == c8'z', "which is zebra, not apple");
    let last = table.EntryAt(2) ?? Panic("the table holds three entries");
    Assert(last.key.View().Bytes()[0] == c8'm', "and the last is the last added");
    Assert(table.EntryAt(3) is none, "past the end there is nothing");

    // Lookup finds by key, and reports absence rather than inventing an empty value.
    let found = table.Find(View("apple"));
    Assert(found is .Some(_), "a key that is there is found");
    Assert(found is .Some(apple) && apple.AsInteger() is .Some(2),
           "with the value it was stored with");
    Assert(table.Find(View("pear")) is none, "and a key that is not there is not");

    // An array keeps its order too, and a borrowed element can be modified in place — which is how an array of
    // tables grows a member after its header has already been read.
    var array = TomlValue::Array(allocator);
    try array.Push(TomlValue::Integer(allocator, 10)) catch { _ => Panic("the kind is right") };
    try array.Push(TomlValue::Integer(allocator, 20)) catch { _ => Panic("the kind is right") };
    Assert(array.Length() is .Some(2), "an array holds what it was given");
    Assert(array.At(1) is .Some(second) && second.AsInteger() is .Some(20), "in order");
    let element = array.AtMutable(0) ?? Panic("the array holds two elements");
    element = TomlValue::Integer(allocator, 11);
    Assert(array.At(0) is .Some(edited) && edited.AsInteger() is .Some(11),
           "and an element can be edited in place");

    // The kinds do not answer each other's questions.
    Assert(array.Find(View("apple")) is none, "an array has no keys");
    Assert(table.At(0) is none, "and a table has no elements");
    Assert((try? table.Push(TomlValue::Integer(allocator, 1))) is none, "pushing onto a table is refused");
    var stray = try String::FromBytes(allocator, "stray") catch { _ => Panic("the key is made") };
    Assert((try? array.Insert(move stray, TomlValue::Integer(allocator, 1))) is none,
           "and inserting into an array is too");

    // Ownership is the whole difficulty of a document tree: a table holding a table holding an array must
    // release all of it exactly once, and it is released when the outermost value dies at the end of this scope.
    var outer = TomlValue::Table(allocator);
    var inner = TomlValue::Table(allocator);
    var nested = TomlValue::Array(allocator);
    try nested.Push(TomlValue::Text(allocator, "held")) catch { _ => Panic("the kind is right") };
    try nested.Push(TomlValue::Text(allocator, "also held")) catch { _ => Panic("the kind is right") };
    var nestedKey = try String::FromBytes(allocator, "list") catch { _ => Panic("the key is made") };
    try inner.Insert(move nestedKey, move nested) catch { _ => Panic("the kind is right") };
    var innerKey = try String::FromBytes(allocator, "inner") catch { _ => Panic("the key is made") };
    try outer.Insert(move innerKey, move inner) catch { _ => Panic("the kind is right") };
    let list = (outer.Find(View("inner")) ?? Panic("the outer table holds the inner one")).Find(View("list"));
    Assert(list is .Some(held) && held.Length() is .Some(2), "a nested tree is reachable all the way down");

    return 0;
}
