import Core::{ string, string8 };
// The coverage that is about the package as a whole rather than about one part of it.
//
// Two checks here are worth more than the rest. Every accepted document is written back out, read again and
// written again, and the two renderings must match -- which catches a writer that loses a value as surely as it
// catches one that is not deterministic. And every document is read twice, once into a tree and once as events,
// by two implementations of the same grammar written separately; a misreading would have to be made twice, the
// same way, to survive that.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, MutableSlice, Slice };
import Format::{ ByteCursor, TextWriter };
import Toml::{ TomlEvent, TomlEventReader, TomlKind, TomlParse, TomlParseError, TomlParseOutcome, TomlValue,
               TomlWriteDocument, TomlWriteError };

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: string) -> Slice<char8> {
    return Slice<char8> { data: text.data, length: text.length };
}

// Documents TOML 1.1 accepts. Each is one feature of the grammar, and a reader that refuses any of them is
// refusing a document someone is entitled to write.
func Valid(index: uint) -> string {
    if index == 0u {
        return "key = \"value\"";
    }
    if index == 1u {
        return "bare_key = 1";
    }
    if index == 2u {
        return "bare-key = 1";
    }
    if index == 3u {
        return "1234 = 1";
    }
    if index == 4u {
        return "\"127.0.0.1\" = 1";
    }
    if index == 5u {
        return "\"key\" = 1";
    }
    if index == 6u {
        return "'quoted \"value\"' = 1";
    }
    if index == 7u {
        return "\"\" = \"blank\"";
    }
    if index == 8u {
        return "name = \"Orange\"\nphysical.colour = \"orange\"\nphysical.shape = \"round\"";
    }
    if index == 9u {
        return "str = \"a \\\"quoted\\\" word, a \\t tab and a \\u00E9 escape.\"";
    }
    if index == 10u {
        return "str1 = \"\"\"\nRoses are red\nViolets are blue\"\"\"";
    }
    if index == 11u {
        return "str2 = \"\"\"\\\n  The quick brown \\\n  fox jumps over \\\n  the lazy dog.\\\n  \"\"\"";
    }
    if index == 12u {
        return "winpath = 'C:\\Users\\nodejs\\templates'";
    }
    if index == 13u {
        return "regex = '<\\i\\c*\\s*>'";
    }
    if index == 14u {
        return "re = '''I [dw]on't need \\d{2} apples'''";
    }
    if index == 15u {
        return "int1 = +99\nint2 = 42\nint3 = 0\nint4 = -17";
    }
    if index == 16u {
        return "int5 = 1_000\nint6 = 5_349_221\nint7 = 53_49_221";
    }
    if index == 17u {
        return "hex1 = 0xDEADBEEF\nhex2 = 0xdeadbeef\nhex3 = 0xdead_beef";
    }
    if index == 18u {
        return "oct1 = 0o01234567\noct2 = 0o755\nbin1 = 0b11010110";
    }
    if index == 19u {
        return "flt1 = +1.0\nflt2 = 3.1415\nflt3 = -0.01\nflt4 = 5e+22\nflt5 = 1e06\nflt6 = -2E-2\nflt7 = 6.626e-34";
    }
    if index == 20u {
        return "flt8 = 224_617.445_991_228";
    }
    if index == 21u {
        return "sf1 = inf\nsf2 = +inf\nsf3 = -inf\nsf4 = nan\nsf5 = +nan\nsf6 = -nan";
    }
    if index == 22u {
        return "bool1 = true\nbool2 = false";
    }
    if index == 23u {
        return "odt1 = 1979-05-27T07:32:00Z\nodt2 = 1979-05-27T00:32:00-07:00\nodt3 = 1979-05-27T00:32:00.999999-07:00";
    }
    if index == 24u {
        return "ldt1 = 1979-05-27T07:32:00\nldt2 = 1979-05-27T00:32:00.999999";
    }
    if index == 25u {
        return "ld1 = 1979-05-27\nlt1 = 07:32:00\nlt2 = 00:32:00.999999";
    }
    if index == 26u {
        return "integers = [ 1, 2, 3 ]\ncolours = [ \"red\", \"yellow\" ]\nnested = [ [ 1, 2 ], [3, 4, 5] ]";
    }
    if index == 27u {
        return "contributors = [\n  \"Foo <f@e.com>\",\n  { name = \"Baz\" },\n]";
    }
    if index == 28u {
        return "[table-1]\nkey1 = \"some string\"\nkey2 = 123\n\n[table-2]\nkey1 = \"another string\"\nkey2 = 456";
    }
    if index == 29u {
        return "[dog.\"tater.man\"]\ntype.name = \"pug\"";
    }
    if index == 30u {
        return "[a.b.c]\n[a]\nkey = 1";
    }
    if index == 31u {
        return "name = { first = \"Tom\", last = \"Preston-Werner\" }";
    }
    if index == 32u {
        return "point = {\n  x = 1,\n  y = 2,\n}";
    }
    if index == 33u {
        return "[[products]]\nname = \"Hammer\"\nsku = 738594937\n\n[[products]]\n\n[[products]]\nname = \"Nail\"";
    }
    if index == 34u {
        return "[[fruits]]\nname = \"apple\"\n\n[fruits.skin]\ncolour = \"red\"\n\n[[fruits.kinds]]\nn = 1";
    }
    if index == 35u {
        return "# just a comment\n";
    }
    if index == 36u {
        return "";
    }
    if index == 37u {
        return "key = \"value\" # a trailing comment";
    }
    if index == 38u {
        return "esc = \"\\e[1m\"";
    }
    if index == 39u {
        return "hex = \"\\x41\\x42\"";
    }
    if index == 40u {
        return "short = 07:32\nshortdt = 1979-05-27T07:32Z";
    }
    if index == 41u {
        return "a = [1, 2,]";
    }
    if index == 42u {
        return "empty_array = []\nempty_table = {}";
    }
    if index == 43u {
        return "\n\n\n";
    }
    return "";
}

const ValidCount: uint = 44;

// Documents TOML refuses. Each is a form some reader accepts and some does not, which is exactly the set that
// makes one document mean two things.
func Invalid(index: uint) -> string {
    if index == 0u {
        return "key = # no value";
    }
    if index == 1u {
        return "a = 1\na = 2";
    }
    if index == 2u {
        return "[a]\n[a]";
    }
    if index == 3u {
        return "a = { b = 1 }\n[a.c]";
    }
    if index == 4u {
        return "a = { b = 1 }\na.c = 2";
    }
    if index == 5u {
        return "[t]\na.b = 1\n[t.a]";
    }
    if index == 6u {
        return "a = 1\n[a]";
    }
    if index == 7u {
        return "a = 1\na.b = 2";
    }
    if index == 8u {
        return "a = [1, 2]\n[[a]]";
    }
    if index == 9u {
        return "[[a]]\n[a]";
    }
    if index == 10u {
        return "a = 010";
    }
    if index == 11u {
        return "a = 0x";
    }
    if index == 12u {
        return "a = +0x1";
    }
    if index == 13u {
        return "a = 1__0";
    }
    if index == 14u {
        return "a = _1";
    }
    if index == 15u {
        return "a = 1_";
    }
    if index == 16u {
        return "a = 0b102";
    }
    if index == 17u {
        return "a = .7";
    }
    if index == 18u {
        return "a = 7.";
    }
    if index == 19u {
        return "a = 1e";
    }
    if index == 20u {
        return "a = 3.e2";
    }
    if index == 21u {
        return "a = 01.5";
    }
    if index == 22u {
        return "a = 1979-02-30";
    }
    if index == 23u {
        return "a = 1979-13-01";
    }
    if index == 24u {
        return "a = 2023-02-29";
    }
    if index == 25u {
        return "a = 1979-05-27T25:00:00Z";
    }
    if index == 26u {
        return "a = \"unterminated";
    }
    if index == 27u {
        return "a = \"bad\\q\"";
    }
    if index == 28u {
        return "a = \"\\u12\"";
    }
    if index == 29u {
        return "a = 1 b = 2";
    }
    if index == 30u {
        return "[a";
    }
    if index == 31u {
        return "a = [1, 2";
    }
    if index == 32u {
        return "a = { b = 1";
    }
    if index == 33u {
        return "a = [1}";
    }
    if index == 34u {
        return "= 1";
    }
    if index == 35u {
        return "a";
    }
    if index == 36u {
        return "a = \"\"\"not closed";
    }
    if index == 37u {
        return "a = 'not closed";
    }
    if index == 38u {
        return "a = tru";
    }
    if index == 39u {
        return "[]\na = 1";
    }
    if index == 40u {
        return "a = 9223372036854775808";
    }
    if index == 41u {
        return "a = 1979-05-27T07:32:00+07";
    }
    return "a = 1";
}

