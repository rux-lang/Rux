    }
    if index == 38u {
        return "differential vector 38";
    }
    if index == 39u {
        return "differential vector 39";
    }
    if index == 40u {
        return "differential vector 40";
    }
    if index == 41u {
        return "differential vector 41";
    }
    if index == 42u {
        return "differential vector 42";
    }
    if index == 43u {
        return "differential vector 43";
    }
    return "differential vector past the end";
}
func Render(value: &TomlValue, storage: MutableSlice<char8>) -> Slice<char8> {
    var cursor = ByteCursor(storage);
    let writer: &var TextWriter = cursor;
    let failure = TomlWriteDocument(writer, value);
    Assert(failure == TomlWriteError::None, "every accepted document can be written back out");
    return cursor.Written();
}

func Same(left: Slice<char8>, right: Slice<char8>) -> bool {
    if left.length != right.length {
        return false;
    }
    var index: uint = 0;
    while index < left.length {
        if left.data[index] != right.data[index] {
            return false;
        }
        index = index + 1u;
    }
    return true;
}

// The rendered side is bytes and the expected side is text, which is the comparison every vector makes.
func Same(left: Slice<char8>, right: string) -> bool {
    return Same(left, TextBytes(right));
}

// How many scalar values the streaming reader finds, and whether it finished cleanly.
func StreamedScalars(text: string, clean: *var bool) -> uint {
    var reader = TomlEventReader(text);
    var count: uint = 0;
    while true {
        let event = reader.Next();
        if event == TomlEvent::Error {
            *clean = false;
            return count;
        }
        if event == TomlEvent::End {
            *clean = reader.Error() == TomlParseError::None;
            return count;
        }
        if event == TomlEvent::Text || event == TomlEvent::Integer || event == TomlEvent::Float ||
            event == TomlEvent::Boolean || event == TomlEvent::DateTime {
            count = count + 1u;
        }
    }
    *clean = false;
    return count;
}

// How many scalar values a tree holds, counted the same way.
func TreeScalars(value: &TomlValue) -> uint {
    let kind = value.Kind();
    if kind == TomlKind::Table {
        var total: uint = 0;
        var index: uint = 0;
        while index < value.Length() {
            total = total + TreeScalars((*value.EntryAt(index)).value);
            index = index + 1u;
        }
        return total;
    }
    if kind == TomlKind::Array {
        var total: uint = 0;
        var index: uint = 0;
        while index < value.Length() {
            total = total + TreeScalars(*value.At(index));
            index = index + 1u;
        }
        return total;
    }
    return 1u;
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    var storage: char8[8192];
    var second: char8[8192];
    var outcome = TomlParseOutcome();

    // Every document TOML accepts, accepted -- and then written, read and written again to the same bytes.
    var index: uint = 0;
    while index < ValidCount {
        let text = Valid(index);
        var parsed = TomlParse(allocator, text, @outcome);
        Assert(outcome.error == TomlParseError::None, Label(index));
        let once = Render(parsed, MutableSlice::From<char8>(@storage[0], 8192));
        var again = TomlParse(allocator, once, @outcome);
        Assert(outcome.error == TomlParseError::None, Reparsed(index));
        let twice = Render(again, MutableSlice::From<char8>(@second[0], 8192));
        Assert(Same(once, twice), Fixed(index));
        index = index + 1u;
    }

    // Every document TOML refuses, refused -- and refused with a position, not merely a flag.
    index = 0;
    while index < InvalidCount {
        let text = Invalid(index);
        var refused = TomlParse(allocator, text, @outcome);
        Assert(outcome.error != TomlParseError::None, Refusal(index));
        Assert(outcome.line > 0u && outcome.column > 0u, "reported at a position a reader can find");
        index = index + 1u;
    }

    // The differential check: the tree parser and the streaming reader must agree about every accepted
    // document. They are two implementations of the same grammar, so agreement is a much stronger statement
    // than either passing its own tests.
    index = 0;
    while index < ValidCount {
        let text = Valid(index);
        var parsed = TomlParse(allocator, text, @outcome);
        Assert(outcome.error == TomlParseError::None, "the tree parser accepts it");
        var clean = false;
        let streamed = StreamedScalars(text, @clean);
        Assert(clean, Differential(index));
        Assert(streamed == TreeScalars(parsed), Differential(index));
        index = index + 1u;
    }

    // And they must agree about refusals of syntax. The streaming reader cannot catch a table defined twice,
    // so the documents whose only fault is a redefinition are the ones it is allowed to accept.
    index = 0;
    while index < InvalidCount {
        let text = Invalid(index);
        var refused = TomlParse(allocator, text, @outcome);
        // The streaming reader is responsible for the grammar and not for the tables or the values: it cannot
        // know a table was defined twice without keeping every table it has seen, and it hands out the bytes of
        // a number rather than reading it, so `010` is the caller's to refuse when the caller decodes it.
        let structural = outcome.error == TomlParseError::Lexical ||
                         outcome.error == TomlParseError::Unexpected ||
                         outcome.error == TomlParseError::Truncated;
        if structural {
            var clean = false;
            StreamedScalars(text, @clean);
            Assert(!clean, Refusal(index));
        }
        index = index + 1u;
    }

    return 0;
}
