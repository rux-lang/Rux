
// A writer whose output depends on anything but the tree produces a diff every time it runs, which trains
// everyone to stop reading the diffs. So what is tested here is sameness: the same tree writes the same bytes,
// and a document written, read and written again is the same the second time.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Result, Unit };
import Format::{ ByteCursor, TextWriter };
import Text::{ BufferWriter, FormatError, StringView, TextError };
import Time::UtcOffset;
import Toml::{ TomlKind, TomlParse, TomlValue, TomlWriteDocument };

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: char8[..]) -> char8[..] {
    return (text.data)[..text.length];
}

// Renders `value` into `storage` and returns the bytes.
func Render(value: &TomlValue, storage: var char8[..]) -> char8[..] {
    var cursor = ByteCursor(storage);
    let writer: &var TextWriter = cursor;
    Assert(TomlWriteDocument(writer, value).IsSuccess(), "writing succeeds");
    return cursor.Written();
}

func View(bytes: char8[..]) -> StringView {
    return StringView::FromBytes(bytes).ValueOr(StringView());
}

func Same(left: char8[..], right: char8[..]) -> bool {
    if left.length != right.length {
        return false;
    }
    var index: uint = 0;
    while index < left.length {
        if left.data[index] != right.data[index] {
            return false;
        }
        index = index + 1u;
    }
    return true;
}

// Which failure a write reported, as a number, since a variant has no equality operator.
func CaseOf(reason: &FormatError) -> int32 {
    return match reason {
        .InvalidSpecification(_) => 1i32,
        .UnsupportedRequest => 2i32,
        .ArgumentCountMismatch(_, _) => 3i32,
        .InsufficientCapacity => 4i32,
        .ValueOutOfRange => 5i32,
        .TextFailure(_) => 6i32,
        .WriterFailure => 7i32
    };
}

func SameFailure(outcome: &Result<Unit, FormatError>, expected: &FormatError) -> bool {
    return match outcome {
        .Success(_) => false,
        .Error(reason) => CaseOf(reason) == CaseOf(expected)
    };
}

// A document this test knows is well-formed, which is every one of them: what is under test here is the writer.
func Parsed(allocator: Allocator, text: char8[..], note: char8[..]) -> TomlValue {
    var outcome = TomlParse(allocator, text);
    var value = TomlValue::Table(allocator);
    Assert((<-outcome).TryIntoValue(@value), note);
    return <-value;
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    var storage: char8[4096];
    var second: char8[4096];
    // A document written and read and written again is the same the second time, which is the property a file
    // in version control needs.
    var source = "[server]\nhost = \"local\"\nports = [1, 2]\n\n[[user]]\nname = \"ada\"\n\n[[user]]\nname = \"alan\"";
    var parsed = Parsed(allocator, source, "the document parses");
    let once = Render(parsed, (@storage[0])[..4096]);

    var again = Parsed(allocator, once, "its output parses");
    let twice = Render(again, (@second[0])[..4096]);
    Assert(Same(once, twice), "and writes the same bytes the second time");

    // Every kind survives the round trip, including the ones a lazier writer would collapse.
    var kinds = "i = 42\nf = 3.5\nwhole = 1.0\ntiny = 0.1\nbig = 5e+22\nb = true";
    var dates = "d = 1979-05-27\nt = 07:32:00\nw = 1979-05-27T07:32:00\nm = 1979-05-27T07:32:00-08:00";
    var values = Parsed(allocator, kinds, "a document of every scalar kind parses");
    let written = Render(values, (@storage[0])[..4096]);
    var reread = Parsed(allocator, written, "and its output parses");

    var readInteger = 0i64;
    Assert((*reread.Find(View("i"))).AsInteger(@readInteger) && readInteger == 42i64, "the integer survives");
    var readFloat = 0.0;
    Assert((*reread.Find(View("tiny"))).AsFloat(@readFloat) && readFloat == 0.1,
           "and a float comes back as exactly the same float, not merely a close one");
    Assert((*reread.Find(View("whole"))).Kind() == TomlKind::Float,
           "a whole float keeps its point, or it would read back as an integer");
    // The date kinds are their own document, since what matters about them is that the four stay four.
    var stamped = Parsed(allocator, dates, "a document of every date kind parses");
    let stampedText = Render(stamped, (@storage[0])[..4096]);
    var restamped = Parsed(allocator, stampedText, "and its output parses");
    Assert((*restamped.Find(View("m"))).Kind() == TomlKind::OffsetDateTime,
           "an offset date-time keeps its offset");
    var readOffset = UtcOffset::Utc();
    Assert((*restamped.Find(View("m"))).AsOffset(@readOffset) && readOffset.TotalSeconds() == -28800i32,
           "and the offset is the one it was written with");
    Assert((*restamped.Find(View("w"))).Kind() == TomlKind::LocalDateTime,
           "while a local one is not given one it never had");
    Assert((*restamped.Find(View("d"))).Kind() == TomlKind::LocalDate, "a date stays a date");
    Assert((*restamped.Find(View("t"))).Kind() == TomlKind::LocalTime, "and a time stays a time");

    // Keys are bare where TOML allows it and quoted where it does not, which is the whole of the choice.
    var keys = "bare_key = 1\n\"needs quoting\" = 2\n\"\" = 3\n1979 = 4";
    var keyed = Parsed(allocator, keys, "keys of every shape parse");
    let keyText = Render(keyed, (@storage[0])[..4096]);
    Assert(Same(keyText, "bare_key = 1\n\"needs quoting\" = 2\n\"\" = 3\n1979 = 4\n"),
           "and each is written in the shortest valid form");

    // Strings are escaped to exactly what TOML requires: the quote, the backslash and the control characters.
    var strings = "a = \"tab\\there\"\nb = \"quote\\\"here\"\nc = \"back\\\\slash\"";
    var stringy = Parsed(allocator, strings, "strings with escapes parse");
    let stringText = Render(stringy, (@storage[0])[..4096]);
    Assert(Same(stringText, "a = \"tab\\there\"\nb = \"quote\\\"here\"\nc = \"back\\\\slash\"\n"),
           "and come back escaped the same way");

    // Nesting produces headers, and an inline table read from a document is written as one of them.
    var nested = Parsed(allocator, "a = { b = 1, c = { d = 2 } }", "an inline table parses");
    let nestedText = Render(nested, (@storage[0])[..4096]);
    Assert(Same(nestedText, "[a]\nb = 1\n\n[a.c]\nd = 2\n"),
           "and is written as headers, which is the one spelling that stays readable as it grows");

    // A table inside an array has no header spelling, so it stays inline.
    var arrayed = Parsed(allocator, "a = [{ b = 1 }, {}]", "a table inside an array parses");
    let arrayedText = Render(arrayed, (@storage[0])[..4096]);
    Assert(Same(arrayedText, "a = [{ b = 1 }, {}]\n"), "and stays inline, because TOML has no other way");

    // The infinities and NaN are values TOML can spell, so they are written rather than refused.
    var special = Parsed(allocator, "a = inf\nb = -inf\nc = nan", "the three named floats parse");
    let specialText = Render(special, (@storage[0])[..4096]);
    Assert(Same(specialText, "a = inf\nb = -inf\nc = nan\n"), "and are written back as themselves");

    // The three escapes vector 9 combines, taken one at a time so a failure names the byte that caused it.
    var quoteOnly = Parsed(allocator, "a = \"\\\"q\\\"\"", "a quote escape parses");
    let quoteOnce = Render(quoteOnly, (@storage[0])[..4096]);
    Assert(Same(quoteOnce, "a = \"\\\"q\\\"\"\n"), "and is written back as an escaped quote");

    var tabOnly = Parsed(allocator, "a = \"x\\ty\"", "a tab escape parses");
    let tabOnce = Render(tabOnly, (@storage[0])[..4096]);
    Assert(Same(tabOnce, "a = \"x\\ty\"\n"), "and is written back as an escaped tab");

    var scalarOnly = Parsed(allocator, "a = \"x\\u00E9y\"", "a unicode escape parses");
    let scalarOnce = Render(scalarOnly, (@storage[0])[..4096]);
    Assert(Same(scalarOnce, "a = \"x\u{E9}y\"\n"),
           "and is written back as the scalar itself, which needs no escape");

    // Vector 9 of the conformance set, taken apart here where a failure can say which half of it moved.
    var whole = Parsed(allocator,
                       "str = \"a \\\"quoted\\\" word, a \\t tab and a \\u00E9 escape.\"",
                       "the combined document parses");
    let wholeOnce = Render(whole, (@storage[0])[..4096]);
    Assert(wholeOnce.length == 53u, "and renders to the length the escapes add up to");
    Assert(Same(wholeOnce, "str = \"a \\\"quoted\\\" word, a \\t tab and a \u{E9} escape.\"\n"),
           "with each byte where it belongs");
    var wholeAgain = Parsed(allocator, wholeOnce, "its output parses");
    let wholeTwice = Render(wholeAgain, (@second[0])[..4096]);
    Assert(wholeTwice.length == 53u, "to the same length");
    Assert(Same(wholeOnce, wholeTwice), "and the same bytes");

    // The loss the README describes, pinned here so the documentation cannot drift away from the code.
    var commented = Parsed(allocator, "# leading comment\na = 1 # trailing\n\n\nb = 2", "a commented document parses");
    let plain = Render(commented, (@storage[0])[..4096]);
    Assert(Same(plain, "a = 1\nb = 2\n"), "and comes back without its comments or its blank lines");

    var spelled = Parsed(allocator, "a = 0xFF\nb = 1e3\nc = 'literal'", "a document of alternative spellings parses");
    let canonical = Render(spelled, (@storage[0])[..4096]);
    Assert(Same(canonical, "a = 255\nb = 1000.0\nc = \"literal\"\n"),
           "and comes back in one spelling each, because the tree holds values and not the text of them");

    // A destination that runs out of room says which of the two things went wrong. The status this replaced had
    // one case for every destination failure, so a buffer that was merely full and a stream that had died arrived
    // identically — and a caller who could have written the document somewhere larger had no way to tell that was
    // the problem.
    var bounded = Parsed(allocator, "a = 1\nb = 2\n[t]\nc = 3", "a document for a bounded destination");
    var room: char8[8];
    var small = BufferWriter((@room[0])[..8]);
    let smallSink: &var TextWriter = small;
    let overflowed = TomlWriteDocument(smallSink, bounded);
    let full = FormatError::InsufficientCapacity;
    Assert(SameFailure(overflowed, full), "a destination without room reports being full, not merely failing");
    Assert(small.Length() <= 8u, "having written no more than it had");

    // And the same document goes out whole when there is room, so the case above is about the bound rather than
    // about a writer that refuses everything.
    var enough: char8[128];
    var roomy = BufferWriter((@enough[0])[..128]);
    let roomySink: &var TextWriter = roomy;
    Assert(TomlWriteDocument(roomySink, bounded).IsSuccess(),
           "the same document writes whole into a destination that has room");
    Assert(roomy.Length() == 23u, "all twenty-three bytes of it");

    return 0;
}
