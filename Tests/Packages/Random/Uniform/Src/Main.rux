// Bias is the whole subject here, and bias is invisible in a handful of draws -- so the tests count. A chi-
// squared-style spread check over many draws catches the modulo method's bias at a bound near the width, which
// is where it is enormous, and the range tests check the ends are reachable, since an off-by-one at either end
// is the other classic failure.

import Core::Assert;
import Math::{ Abs, PositiveInfinity64 };
import Random::{ NextFloat64, RandomGenerator, UniformBelow, UniformFloatInRange, UniformInRange,
                 UniformInSignedRange, Xoshiro256 };

func Main() -> int {
    // Every value below the bound appears, and none at or above it.
    var generator = Xoshiro256::New(1u64);
    var counts: uint[6];
    var index: uint = 0;
    while index < 6u {
        counts[index] = 0;
        index = index + 1;
    }
    var draw: uint = 0;
    while draw < 60000u {
        let value = UniformBelow<Xoshiro256>(@generator, 6u64);
        Assert(value < 6u64, "a bounded draw stays below its bound");
        counts[value as uint] = counts[value as uint] + 1;
        draw = draw + 1;
    }
    index = 0;
    while index < 6u {
        // Ten thousand expected each; three percent is far outside the noise of sixty thousand draws and far
        // inside anything a real bias would produce.
        Assert(counts[index] > 9700u && counts[index] < 10300u, "and every value comes up about equally often");
        index = index + 1;
    }

    // The case where the modulo method is worst: a bound just over half the width, where it favours the low
    // half by a factor of two. The spread here would be about 2:1 if this used a remainder.
    let halfish = 0x8000000000000001u64;
    var lowHalf: uint = 0;
    var highHalf: uint = 0;
    draw = 0;
    while draw < 20000u {
        let value = UniformBelow<Xoshiro256>(@generator, halfish);
        Assert(value < halfish, "a huge bound is still respected");
        if value < 0x4000000000000000u64 {
            lowHalf = lowHalf + 1;
        }
        else {
            highHalf = highHalf + 1;
        }
        draw = draw + 1;
    }
    // Half of the bound is 0x4000000000000000 plus a half, so the two sides should be near even. A remainder
    // would put roughly two thirds in the low half.
    Assert(lowHalf > 9500u && lowHalf < 10500u, "a bound just over half the width does not favour the low half");
    Assert(highHalf > 9500u && highHalf < 10500u, "nor the high one");

    // The degenerate bounds.
    Assert(UniformBelow<Xoshiro256>(@generator, 0u64) == 0u64, "a bound of zero has nothing to choose and gives it");
    draw = 0;
    while draw < 100u {
        Assert(UniformBelow<Xoshiro256>(@generator, 1u64) == 0u64, "a bound of one always gives zero");
        draw = draw + 1;
    }

    // Inclusive ranges: both ends must be reachable, which is where an off-by-one hides.
    var sawLow = false;
    var sawHigh = false;
    draw = 0;
    while draw < 20000u {
        let value = UniformInRange<Xoshiro256>(@generator, 10u64, 20u64);
        Assert(value >= 10u64 && value <= 20u64, "an inclusive range is respected at both ends");
        if value == 10u64 {
            sawLow = true;
        }
        if value == 20u64 {
            sawHigh = true;
        }
        draw = draw + 1;
    }
    Assert(sawLow && sawHigh, "and both ends actually occur");

    // A single-value range, a reversed one, and the full width.
    Assert(UniformInRange<Xoshiro256>(@generator, 7u64, 7u64) == 7u64, "a range of one value gives that value");
    Assert(UniformInRange<Xoshiro256>(@generator, 9u64, 3u64) == 9u64, "a reversed range gives its low end");
    var sawAbove = false;
    draw = 0;
    while draw < 200u {
        let value = UniformInRange<Xoshiro256>(@generator, 0u64, 0xFFFFFFFFFFFFFFFFu64);
        if value > 0x8000000000000000u64 {
            sawAbove = true;
        }
        draw = draw + 1;
    }
    Assert(sawAbove, "the full range of the type reaches its upper half rather than overflowing to nothing");

    // Signed ranges, including one that crosses zero and one that spans the whole width.
    var sawNegative = false;
    var sawPositive = false;
    draw = 0;
    while draw < 20000u {
        let value = UniformInSignedRange<Xoshiro256>(@generator, -5i64, 5i64);
        Assert(value >= -5i64 && value <= 5i64, "a signed range crossing zero is respected");
        if value < 0i64 {
            sawNegative = true;
        }
        if value > 0i64 {
            sawPositive = true;
        }
        draw = draw + 1;
    }
    Assert(sawNegative && sawPositive, "and reaches both sides of zero");
    var sawVeryNegative = false;
    draw = 0;
    while draw < 200u {
        let value = UniformInSignedRange<Xoshiro256>(@generator, -9223372036854775808i64, 9223372036854775807i64);
        if value < -4611686018427387904i64 {
            sawVeryNegative = true;
        }
        draw = draw + 1;
    }
    Assert(sawVeryNegative, "the whole signed width is reachable, where the span of the ends overflows");

    // Uniform floats: inside the interval, reaching both ends of it, and never the excluded top.
    var sawNearLow = false;
    var sawNearHigh = false;
    draw = 0;
    while draw < 20000u {
        let value = UniformFloatInRange<Xoshiro256>(@generator, -2.0, 3.0);
        Assert(value >= -2.0 && value < 3.0, "a float range is half-open at the top");
        if value < -1.9 {
            sawNearLow = true;
        }
        if value > 2.9 {
            sawNearHigh = true;
        }
        draw = draw + 1;
    }
    Assert(sawNearLow && sawNearHigh, "and both ends are approached");
    Assert(UniformFloatInRange<Xoshiro256>(@generator, 1.0, 1.0) == 1.0, "an empty float range gives its low end");

    // An interval so wide that its span overflows to an infinity still yields values across the whole of it.
    let enormous = 1.5e308;
    var sawBelowZero = false;
    var sawAboveZero = false;
    draw = 0;
    while draw < 2000u {
        let value = UniformFloatInRange<Xoshiro256>(@generator, -enormous, enormous);
        Assert(value >= -enormous && value < enormous, "an interval whose span overflows is still respected");
        if value < 0.0 {
            sawBelowZero = true;
        }
        if value > 0.0 {
            sawAboveZero = true;
        }
        draw = draw + 1;
    }
    Assert(sawBelowZero && sawAboveZero, "and covers both halves of it rather than collapsing to a NaN");

    return 0;
}
