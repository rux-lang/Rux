import Core::{ #target, OperatingSystem };
import FreeBSD::{ RTLD_NOW, dlclose, dlerror, dlopen, dlsym };

when #target.os == OperatingSystem::FreeBSD {
func Main() -> int {
    // A null name opens the program itself, whose global scope includes the C library the loader lives in.
    // Safety: a null name is the documented request for the program's own handle.
    let program = unsafe { dlopen(null, RTLD_NOW) };
    if program == null {
        return 1;
    }

    // Safety: `program` is the live handle opened above, the symbol names are NUL-terminated string constants, and
    // the error text `dlerror` returns is only compared with null, never read.
    unsafe {
        dlerror();
        if dlsym(program, "getpid".data) == null || dlerror() != null {
            return 2;
        }

        if dlsym(program, "RuxNoSuchSymbol".data) != null {
            return 3;
        }
        if dlerror() == null {
            return 4;
        }
        // Reading the error cleared it.
        if dlerror() != null {
            return 5;
        }
    }

    // Safety: `program` is the live handle opened above, and nothing uses it after this.
    if unsafe { dlclose(program) } != 0 {
        return 6;
    }
    return 0;
}
} else {
    func Main() -> int {
        return 0;
    }
}
