// A copy is the bytes and not an alias, a rename is the same name moved, a hard link is a second equal name,
// and a symbolic link is a stored pointer — each proven by mutating one side and watching the other.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic, Result };
import Io::{ IoError, IoErrorKind, ReadExact, Reader, WriteAll, Writer };
import Path::{ OsString, Path };
import FileSystem::{ CopyFile, CreateHardLink, CreateSymbolicLink, DeleteDirectory, DeleteFile, File, MakeDirectory,
                     OpenOptions, Rename };

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: char8[..]) -> char8[..] {
    return text;
}

func PathOf(allocator: Allocator, text: char8[..], holder: &var OsString) -> Path {
    holder = OsString::FromText(allocator, text);
    return Path::FromView(holder.View());
}

func WriteWhole(allocator: Allocator, path: Path, content: char8[..]) {
    var file = try File::Open(allocator, path, OpenOptions::Writing()) catch {
        _ => Panic("the file opens for writing")
    };
    Assert(file.IsOpen(), "the file opens for writing");
    try WriteAll(file, content) catch { _ => Panic("and takes its content") };
    try file.Close() catch { _ => Panic("and closes") };
}

// Reads the whole file and checks it equals `expected`, byte for byte, length included.
func CheckWhole(allocator: Allocator, path: Path, expected: char8[..]) {
    var file = try File::Open(allocator, path, OpenOptions::Reading()) catch {
        _ => Panic("the file opens for reading")
    };
    Assert(file.IsOpen(), "the file opens for reading");
    var storage: char8[64];
    let size = try file.Size() catch { _ => Panic("the size is known") };
    Assert(size == expected.length as uint64, "it is exactly as long as expected");
    let room = storage[..expected.length];
    try ReadExact(file, room) catch { _ => Panic("and reads whole") };
    var index: uint = 0;
    while index < expected.length {
        Assert(storage[index] == expected[index], "byte for byte");
        index = index + 1;
    }
    try file.Close() catch { _ => Panic("and closes") };
}

func Main() -> int throws IoError {
    let allocator = SystemAllocator();

    var dirHolder = OsString(allocator);
    let dir = PathOf(allocator, "Bin/FileSystemXfer.tmp", dirHolder);
    var aHolder = OsString(allocator);
    let a = PathOf(allocator, "Bin/FileSystemXfer.tmp/a.txt", aHolder);
    var bHolder = OsString(allocator);
    let b = PathOf(allocator, "Bin/FileSystemXfer.tmp/b.txt", bHolder);
    var cHolder = OsString(allocator);
    let c = PathOf(allocator, "Bin/FileSystemXfer.tmp/c.txt", cHolder);
    var dHolder = OsString(allocator);
    let d = PathOf(allocator, "Bin/FileSystemXfer.tmp/d.txt", dHolder);
    var hHolder = OsString(allocator);
    let h = PathOf(allocator, "Bin/FileSystemXfer.tmp/h.txt", hHolder);
    var sHolder = OsString(allocator);
    let s = PathOf(allocator, "Bin/FileSystemXfer.tmp/s.txt", sHolder);

    // Fresh ground.
    try DeleteFile(allocator, a) catch { _ => {} };
    try DeleteFile(allocator, b) catch { _ => {} };
    try DeleteFile(allocator, c) catch { _ => {} };
    try DeleteFile(allocator, d) catch { _ => {} };
    try DeleteFile(allocator, h) catch { _ => {} };
    try DeleteFile(allocator, s) catch { _ => {} };
    try DeleteDirectory(allocator, dir) catch { _ => {} };
    try MakeDirectory(allocator, dir);

    // A copy is the bytes, not an alias: mutate the original and the copy stands still.
    WriteWhole(allocator, a, "the original bytes");
    try CopyFile(allocator, a, b);
    CheckWhole(allocator, b, "the original bytes");
    WriteWhole(allocator, a, "changed afterwards");
    CheckWhole(allocator, b, "the original bytes");

    // A rename is the same content under a new name, the old name gone.
    try Rename(allocator, b, c);
    CheckWhole(allocator, c, "the original bytes");
    try {
        File::Open(allocator, b, OpenOptions::Reading());
        Panic("expected a failure");
    } catch {
        refusal => Assert(refusal.kind == IoErrorKind::NotFound, "the old name is gone"),
    }

    // Renaming onto an existing name replaces it.
    WriteWhole(allocator, d, "doomed");
    try Rename(allocator, c, d);
    CheckWhole(allocator, d, "the original bytes");

    // A hard link is a second equal name: delete the first and the content lives under the second.
    try CreateHardLink(allocator, a, h);
    try DeleteFile(allocator, a);
    CheckWhole(allocator, h, "changed afterwards");

    // A symbolic link follows on open and deletes as itself. Creation is privilege-gated on Windows, so a
    // PermissionDenied here is an environment, not a defect — the rest is skipped, not faked.
    var linkNameHolder = OsString(allocator);
    let linkTarget = PathOf(allocator, "h.txt", linkNameHolder);
    let linked: Result<(), IoError> = try .Success(CreateSymbolicLink(allocator, linkTarget, s, false)) catch {
        error => .Failure(error)
    };
    match linked {
        .Success(_) => {
            CheckWhole(allocator, s, "changed afterwards");
            try DeleteFile(allocator, s);
            CheckWhole(allocator, h, "changed afterwards");
        },
        .Failure(linkError) => {
            Assert(linkError.kind == IoErrorKind::PermissionDenied, "only the privilege gate excuses a failed link");
        }
    }

    // Clean ground behind us.
    try DeleteFile(allocator, d);
    try DeleteFile(allocator, h);
    try DeleteDirectory(allocator, dir);

    return 0;
}
