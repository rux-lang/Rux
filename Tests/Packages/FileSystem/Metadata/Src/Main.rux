// What the filesystem says about a file, and what it will not say. Every claim is checked against something the
// test itself just did — a file of known length, a directory it made, a timestamp it wrote — and the fields
// the running system cannot answer are checked to be reported as unanswerable rather than quietly zero.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic, Result };
import Io::{ IoError, IoErrorKind, WriteAll, Writer };
import Path::{ OsString, Path };
import FileSystem::{ CapabilitiesOfSystem, DeleteDirectory, DeleteFile, File, FileKind, MakeDirectory, Metadata,
                     MetadataOf, OpenOptions, Permissions, SetPermissions, SetTimes };
import Time::Timestamp;

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: char8[..]) -> char8[..] {
    return text;
}

func PathOf(allocator: Allocator, text: char8[..], holder: &var OsString) -> Path {
    holder = OsString::FromText(allocator, text);
    return Path::FromView(holder.View());
}

func Main() -> int throws IoError {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    let able = CapabilitiesOfSystem();

    var dirHolder = OsString(allocator);
    let dir = PathOf(allocator, "Bin/FileSystemMeta.tmp", dirHolder);
    var fileHolder = OsString(allocator);
    let file = PathOf(allocator, "Bin/FileSystemMeta.tmp/f.txt", fileHolder);

    try DeleteFile(allocator, file) catch { _ => {} };
    try DeleteDirectory(allocator, dir) catch { _ => {} };
    try MakeDirectory(allocator, dir);

    // A file of known length reports that length and calls itself a file.
    var written = try File::Open(allocator, file, OpenOptions::Writing());
    Assert(written.IsOpen(), "the file opens for writing");
    try WriteAll(written, TextBytes("0123456789"));
    let openMetadata = try written.Metadata();
    Assert(openMetadata.kind == FileKind::File, "as a file");
    Assert(openMetadata.size == 10, "of the length just written");
    try written.Close();

    // The same answers through the path.
    let byPath = try MetadataOf(allocator, file, true);
    Assert(byPath.kind == FileKind::File && byPath.size == 10, "identically");
    Assert(byPath.linkCount >= 1, "with at least the one name it was made under");

    // A directory is a directory, and asking about a name that is not there is NotFound.
    let dirMetadata = try MetadataOf(allocator, dir, true);
    Assert(dirMetadata.kind == FileKind::Directory, "a directory reports as one");
    var missingHolder = OsString(allocator);
    let missing = PathOf(allocator, "Bin/FileSystemMeta.tmp/nothing.txt", missingHolder);
    try {
        MetadataOf(allocator, missing, true);
        Panic("expected a failure");
    } catch {
        refusal => Assert(refusal.kind == IoErrorKind::NotFound, "and a missing name is NotFound"),
    }

    // Creation time is present exactly where the system claims it is.
    Assert(byPath.hasCreated == able.creationTime, "creation time is reported present exactly when it is real");

    // Timestamps written are timestamps read back. A whole second is used because filesystems differ in the
    // fraction they keep, and the second is what every one of them stores.
    let moment = Timestamp::FromUnixSeconds(1000000000);
    try SetTimes(allocator, file, moment, moment, true);
    let retimed = try MetadataOf(allocator, file, true);
    Assert(retimed.modified.UnixSeconds() == 1000000000, "the modification time is the one written");
    Assert(retimed.accessed.UnixSeconds() == 1000000000, "and so is the access time");

    // Read-only is the one permission every supported system records: setting and clearing it round trips. An
    // ordinary writer is refused, while a privileged Unix process may validly bypass the mode bits.
    try SetPermissions(allocator, file, Permissions::FromReadOnly(true));
    let locked = try MetadataOf(allocator, file, true);
    Assert(!locked.permissions.IsWritable(), "and reads back without owner-write permission");
    let opening: Result<File, IoError> = try .Success(File::Open(allocator, file, OpenOptions::Writing())) catch {
        error => .Failure(error)
    };
    match move opening {
        .Success(opened) => {
            var probe = move opened;
            Assert(able.unixPermissions, "only a privileged Unix writer may bypass read-only");
            try probe.Close() catch { _ => Panic("and the privileged probe closes") };
        },
        .Failure(error) => {
            Assert(error.kind == IoErrorKind::PermissionDenied, "an ordinary write is PermissionDenied");
        }
    }

    try SetPermissions(allocator, file, Permissions::FromReadOnly(false));
    let unlocked = try MetadataOf(allocator, file, true);
    Assert(unlocked.permissions.IsWritable(), "and reads back as writable");
    var allowed = try File::Open(allocator, file, OpenOptions::Writing());
    Assert(allowed.IsOpen(), "and the write is allowed again");
    try allowed.Close();

    if able.unixPermissions {
        // Where the mode is the system's own, an exact triple survives the round trip.
        try SetPermissions(allocator, file, Permissions::FromMode(0x1A4));
        let moded = try MetadataOf(allocator, file, true);
        Assert(moded.permissions.mode == 0x1A4, "and reads back bit for bit");
    }
    else {
        // Where it is not, the mode is synthesized and says so by being one of exactly two values.
        Assert(unlocked.permissions.mode == 0x1B6, "a synthesized writable mode is the documented one");
        Assert(locked.permissions.mode == 0x124, "and a synthesized read-only mode is the other");
    }

    try DeleteFile(allocator, file);
    try DeleteDirectory(allocator, dir);

    return 0;
}
