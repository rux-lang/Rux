// The promise is that the target holds the old contents until it holds the new ones, and never anything in
// between — so the test reads the target part-way through a replacement and demands the old bytes, then
// abandons a replacement and demands them still, then commits one and demands the new bytes exactly.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Io::{ IoError, IoErrorKind, ReadExact, Reader, WriteAll, Writer };
import Path::{ OsString, Path, PathBuffer };
import FileSystem::{ AtomicWrite, DeleteDirectory, DeleteFile, DirectoryIterator, File, MakeDirectory, MetadataOf, OpenOptions, ReadDirectory, WriteAtomically };

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: char8[..]) -> char8[..] {
    return (text.data)[..text.length];
}

func PathOf(allocator: Allocator, text: char8[..], holder: *var OsString) -> Path {
    *holder = OsString::FromText(allocator, text) catch { else => Panic("the name converts") };
    return Path::FromView((*holder).View());
}

// Reads the whole file and checks it against `expected`, length included.
func CheckWhole(allocator: Allocator, path: Path, expected: char8[..]) {
    var file = File::Open(allocator, path, OpenOptions::Reading()) catch { else => Panic("the target opens for reading") };
    Assert(file.IsOpen(), "the target opens for reading");
    let size = file.Size() catch { else => Panic("the size is known") };
    Assert(size == expected.length as uint64, "and is exactly as long as expected");
    var storage: char8[64];
    let room = (@storage[0])[..expected.length];
    ReadExact(file, room) catch { else => Panic("and reads whole") };
    var index: uint = 0;
    while index < expected.length {
        Assert(storage[index] == expected.data[index], "byte for byte");
        index = index + 1;
    }
    file.Close() catch { else => Panic("and closes") };
}

// How many entries the directory holds, which is how a leftover partial file is caught.
func CountEntries(allocator: Allocator, directory: Path) -> uint {
    var walk = ReadDirectory(allocator, directory) catch { else => Panic("the directory opens for counting") };
    var count: uint = 0;
    while true {
        let next = walk.Next() catch { else => Panic("and the count ends rather than fails") };
        if !(next is OsString) { break; }
        count = count + 1;
    }
    walk.Release();
    return count;
}

func Main() -> int ! IoError {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    var dirHolder = OsString(allocator);
    let dir = PathOf(allocator, "Bin/FileSystemAtomic.tmp", @dirHolder);
    var targetHolder = OsString(allocator);
    let target = PathOf(allocator, "Bin/FileSystemAtomic.tmp/settled.txt", @targetHolder);

    DeleteFile(allocator, target) catch { else => {} };
    DeleteDirectory(allocator, dir) catch { else => {} };
    MakeDirectory(allocator, dir)?;

    // A target that does not exist yet is created by the replacement.
    WriteAtomically(allocator, target, TextBytes("first contents"))?;
    CheckWhole(allocator, target, "first contents");
    Assert(CountEntries(allocator, dir) == 1, "and leaves exactly one file behind");

    // Part-way through a replacement, the target still holds the old contents.
    var replacement = AtomicWrite::Begin(allocator, target)?;
    WriteAll(replacement, TextBytes("second contents, longer"))?;
    CheckWhole(allocator, target, "first contents");
    Assert(CountEntries(allocator, dir) == 2, "with the partial file alongside, not on top");

    // Committing swaps them in one step.
    replacement.Commit(allocator)?;
    CheckWhole(allocator, target, "second contents, longer");
    Assert(CountEntries(allocator, dir) == 1, "and the partial file is gone");
    replacement.Release();

    // Abandoning leaves the target exactly as it was, and cleans up after itself.
    var discarded = AtomicWrite::Begin(allocator, target)?;
    WriteAll(discarded, TextBytes("never published"))?;
    discarded.Abandon(allocator)?;
    CheckWhole(allocator, target, "second contents, longer");
    Assert(CountEntries(allocator, dir) == 1, "and leaves nothing behind");
    discarded.Release();

    // A replacement dropped without a decision behaves like an abandoned one: the reason the type exists.
    Dropped(allocator, target)?;
    CheckWhole(allocator, target, "second contents, longer");
    Assert(CountEntries(allocator, dir) == 1, "an undecided replacement leaves no partial file");

    // Replacing with something shorter really shortens it, rather than leaving a tail of the old file.
    WriteAtomically(allocator, target, TextBytes("short"))?;
    CheckWhole(allocator, target, "short");

    DeleteFile(allocator, target)?;
    DeleteDirectory(allocator, dir)?;
    return 0;
}

// Begins a replacement, writes to it, and lets it fall out of scope undecided.
func Dropped(allocator: Allocator, target: Path) -> ! IoError {
    var replacement = AtomicWrite::Begin(allocator, target)?;
    WriteAll(replacement, TextBytes("abandoned by scope"))?;
}
