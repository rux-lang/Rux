// A directory is made, filled, read back name for name — a non-ASCII name included, held losslessly in the
// system's own units — refused deletion while full, and deleted once empty.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Io::{ IoError, IoErrorKind };
import Path::{ OsString, OsStringView, Path };
import FileSystem::{ DeleteDirectory, DeleteFile, DirectoryIterator, File, MakeDirectory, OpenOptions, ReadDirectory };

func PathOf(allocator: Allocator, text: char8[..], holder: &var OsString) -> Path {
    holder = OsString::FromText(allocator, text);
    return Path::FromView(holder.View());
}

func Touch(allocator: Allocator, path: Path) {
    var made = try File::Open(allocator, path, OpenOptions::Writing()) catch { _ => Panic("a file is made") };
    Assert(made.IsOpen(), "a file is made");
    try made.Close() catch { _ => Panic("and closed") };
}

func NameOf(allocator: Allocator, text: char8[..], holder: &var OsString) -> OsStringView {
    holder = OsString::FromText(allocator, text);
    return holder.View();
}

func Main() -> int throws IoError {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    var dirHolder = OsString(allocator);
    let dir = PathOf(allocator, "Bin/FileSystemDir.tmp", dirHolder);
    var oneHolder = OsString(allocator);
    let one = PathOf(allocator, "Bin/FileSystemDir.tmp/one.txt", oneHolder);
    var twoHolder = OsString(allocator);
    let two = PathOf(allocator, "Bin/FileSystemDir.tmp/two.txt", twoHolder);
    var accentHolder = OsString(allocator);
    let accent = PathOf(allocator, "Bin/FileSystemDir.tmp/caf\u{00E9}.txt", accentHolder);

    // Fresh ground: an earlier run may have left the tree behind, and cleanup is not the thing under test yet.
    try DeleteFile(allocator, one) catch { _ => {} };
    try DeleteFile(allocator, two) catch { _ => {} };
    try DeleteFile(allocator, accent) catch { _ => {} };
    try DeleteDirectory(allocator, dir) catch { _ => {} };

    // Made once; a second claim on the name is refused with the reason named.
    try MakeDirectory(allocator, dir);
    try {
        MakeDirectory(allocator, dir);
        Panic("expected a failure");
    } catch {
        refusal => Assert(refusal.kind == IoErrorKind::AlreadyExists, "a second make is AlreadyExists"),
    }

    Touch(allocator, one);
    Touch(allocator, two);
    Touch(allocator, accent);

    // Read back: three names, each one expected, the accent intact in the system's own units.
    var iterator = try ReadDirectory(allocator, dir);
    var oneWantHolder = OsString(allocator);
    let oneWant = NameOf(allocator, "one.txt", oneWantHolder);
    var twoWantHolder = OsString(allocator);
    let twoWant = NameOf(allocator, "two.txt", twoWantHolder);
    var accentWantHolder = OsString(allocator);
    let accentWant = NameOf(allocator, "caf\u{00E9}.txt", accentWantHolder);
    var seenOne = false;
    var seenTwo = false;
    var seenAccent = false;
    var count: uint = 0;
    while true {
        let next = try iterator.Next() catch { _ => Panic("the enumeration ends rather than fails") };
        match move next {
            .Some(entry) => {
                count = count + 1;
                let view = entry.View();
                if view.Equals(oneWant) {
                    seenOne = true;
                }
                else if view.Equals(twoWant) {
                    seenTwo = true;
                }
                else if view.Equals(accentWant) {
                    seenAccent = true;
                }
            },
            none => {
                break;
            }
        }
    }
    Assert(count == 3, "three entries, dot entries skipped");
    Assert(seenOne && seenTwo && seenAccent, "every written name reads back, the accent losslessly");
    iterator.Release();

    // Deletion respects fullness: refused while anything is inside, clean once nothing is.
    Assert((try? DeleteDirectory(allocator, dir)) is none, "a full directory refuses deletion");
    try DeleteFile(allocator, one);
    try DeleteFile(allocator, two);
    try DeleteFile(allocator, accent);
    try {
        DeleteFile(allocator, one);
        Panic("expected a failure");
    } catch {
        refusal => Assert(refusal.kind == IoErrorKind::NotFound, "deleting it again is NotFound"),
    }

    var emptied = try ReadDirectory(allocator, dir);
    let nothing = try emptied.Next() catch { _ => Panic("the emptied directory reads without failing") };
    Assert(!(nothing is OsString), "and holds nothing");
    emptied.Release();

    try DeleteDirectory(allocator, dir);
    try {
        ReadDirectory(allocator, dir);
        Panic("expected a failure");
    } catch {
        refusal => Assert(refusal.kind == IoErrorKind::NotFound, "and reading it afterward is NotFound"),
    }

    return 0;
}
