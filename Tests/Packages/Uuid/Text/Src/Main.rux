// A strict parser is only worth having if it actually refuses things, so most of this test is refusals -- the
// forms that circulate widely and are not the standard's, each rejected with the reason that names what is
// wrong rather than a single catch-all.

import Core::{ Assert, MutableSlice, Slice };
import Uuid::{ Format, FormatUpper, FormatUrn, Parse, Uuid, UuidParseError };

func Refuses(text: Slice<char8>, expected: UuidParseError, what: Slice<char8>) {
    var error = UuidParseError::None;
    var value = Parse(text, @error);
    Assert(error == expected, what);
    Assert(value.IsNil(), "and a refused parse gives nil rather than a half-filled value");
}

func Main() -> int {
    var error = UuidParseError::None;
    let canonical = "f81d4fae-7dec-11d0-a765-00a0c91e6bf6";

    // The canonical form round-trips.
    var value = Parse(canonical, @error);
    Assert(error == UuidParseError::None, "the canonical form parses");
    Assert(value.Version() == 1u8, "and its version is read from the right nibble");
    var text: char8[64];
    Format(@value, MutableSlice::From<char8>(@text[0], 36));
    var index: uint = 0;
    while index < 36u {
        Assert(text[index] == canonical.data[index], "and it formats back to exactly what was parsed");
        index = index + 1;
    }

    // Upper case is read and gives the same value, but is never written by `Format`.
    var upper = Parse("F81D4FAE-7DEC-11D0-A765-00A0C91E6BF6", @error);
    Assert(error == UuidParseError::None, "upper case parses");
    Assert(upper.Equals(@value), "and means the same thing");
    var mixed = Parse("f81D4fAe-7DeC-11d0-A765-00a0C91e6Bf6", @error);
    Assert(error == UuidParseError::None && mixed.Equals(@value), "as does mixed case");

    var upperText: char8[64];
    FormatUpper(@value, MutableSlice::From<char8>(@upperText[0], 36));
    Assert((upperText[0] as uint8) == 0x46u8, "the upper-case form writes upper-case digits");
    Assert((upperText[8] as uint8) == 0x2Du8, "and keeps the hyphens");
    var reparsed = Parse(Slice<char8> { data: @upperText[0], length: 36 }, @error);
    Assert(error == UuidParseError::None && reparsed.Equals(@value), "and parses back to the same value");

    // The URN form, in both cases of its prefix.
    var urn = Parse("urn:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6", @error);
    Assert(error == UuidParseError::None && urn.Equals(@value), "the URN form parses");
    var urnUpper = Parse("URN:UUID:f81d4fae-7dec-11d0-a765-00a0c91e6bf6", @error);
    Assert(error == UuidParseError::None && urnUpper.Equals(@value),
           "and its prefix is case-insensitive, which is a different rule from the digits and also the standard's");

    var urnText: char8[64];
    FormatUrn(@value, MutableSlice::From<char8>(@urnText[0], 45));
    var urnRoundTrip = Parse(Slice<char8> { data: @urnText[0], length: 45 }, @error);
    Assert(error == UuidParseError::None && urnRoundTrip.Equals(@value), "and the written URN form parses back");

    // The refusals: every widely-circulated non-standard form.
    Refuses("f81d4fae7dec11d0a76500a0c91e6bf6", UuidParseError::WrongLength,
            "the hyphen-free form some databases store is refused");
    Refuses("{f81d4fae-7dec-11d0-a765-00a0c91e6bf6}", UuidParseError::WrongLength,
            "the brace-wrapped form Windows tools print is refused");
    Refuses("f81d4fae-7dec-11d0-a765-00a0c91e6bf", UuidParseError::WrongLength, "one digit short is refused");
    Refuses("f81d4fae-7dec-11d0-a765-00a0c91e6bf67", UuidParseError::WrongLength, "one digit long is refused");
    Refuses("", UuidParseError::WrongLength, "and so is nothing at all");

    // Hyphens in the wrong places, which is the error a length check alone would miss.
    Refuses("f81d4fae7-dec-11d0-a765-00a0c91e6bf6", UuidParseError::Misplaced,
            "a hyphen one position late is refused");
    Refuses("f81d4fa-e7dec-11d0-a765-00a0c91e6bf6", UuidParseError::Misplaced,
            "and one position early");
    Refuses("f81d4fae_7dec-11d0-a765-00a0c91e6bf6", UuidParseError::Misplaced,
            "and a separator that is not a hyphen");

    // Characters that are not hexadecimal.
    Refuses("g81d4fae-7dec-11d0-a765-00a0c91e6bf6", UuidParseError::NotHexadecimal,
            "a letter past f is refused");
    Refuses("f81d4fae-7dec-11d0-a765-00a0c91e6bf ", UuidParseError::NotHexadecimal,
            "and so is a space");

    // A URN prefix that is misspelled, which is its own kind of wrong.
    Refuses("urn:uuix:f81d4fae-7dec-11d0-a765-00a0c91e6bf6", UuidParseError::BadPrefix,
            "a misspelled URN prefix is refused as such");
    Refuses("uri:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6", UuidParseError::BadPrefix,
            "as is the wrong scheme");

    // The sentinels have text forms too.
    var nil = Uuid::Nil();
    Format(@nil, MutableSlice::From<char8>(@text[0], 36));
    var nilParsed = Parse(Slice<char8> { data: @text[0], length: 36 }, @error);
    Assert(error == UuidParseError::None && nilParsed.IsNil(), "the nil UUID round-trips through text");
    var max = Uuid::Max();
    Format(@max, MutableSlice::From<char8>(@text[0], 36));
    var maxParsed = Parse(Slice<char8> { data: @text[0], length: 36 }, @error);
    Assert(error == UuidParseError::None && maxParsed.IsMax(), "and so does the max UUID");

    // Every byte survives the round trip, at every position -- which a formatter that swapped a nibble would
    // fail while still producing something that looks like a UUID.
    var probe = Uuid::Nil();
    index = 0;
    while index < 16u {
        probe = Uuid::Nil();
        probe.bytes[index] = 0x9Cu8 as char8;
        Format(@probe, MutableSlice::From<char8>(@text[0], 36));
        var back = Parse(Slice<char8> { data: @text[0], length: 36 }, @error);
        Assert(error == UuidParseError::None && back.Equals(@probe),
               "every byte position survives the text round trip");
        index = index + 1;
    }

    return 0;
}
