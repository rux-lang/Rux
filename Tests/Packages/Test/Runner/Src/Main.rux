// A package of `#Test` functions and no `Main`: a test build generates the runner. The tests check every check's
// passing case and the message of its failing one, a skip, a test that returns nothing, a test inside a module, and
// how a run filters and counts.

import Core::Result;
import Test::{
    Expect, ExpectEqual, ExpectFailure, ExpectNear, ExpectNone, ExpectNotEqual, ExpectSome, ExpectSuccess, ExpectText,
    RunTestsWith, TestCase, TestFailure, TestOptions
};

// The message of the failure `outcome` holds, or a failure of the test when it passed.
func MessageOf(outcome: Result<(), TestFailure>) -> TestFailure throws TestFailure {
    return try ExpectFailure(move outcome, "the check should have failed");
}

#Test
func ChecksThatHold() throws TestFailure {
    try Expect(1 + 1 == 2, "arithmetic");
    try ExpectEqual(40 + 2, 42);
    try ExpectNotEqual(3, 4);
    try ExpectNear(0.1 + 0.2, 0.3, 0.000001);
    try ExpectText("same", "same");
    let found: int32? = 7;
    try ExpectEqual(ExpectSome(found, "present"), 7);
    let missing: int32? = none;
    try ExpectNone(missing, "absent");
}

#Test
func FailureMessages() throws TestFailure {
    let flag: Result<(), TestFailure> = try .Success(Expect(false, "the flag is set")) catch { f => .Failure(f) };
    try ExpectText(MessageOf(flag).Message(), "the flag is set");
    let equal: Result<(), TestFailure> = try .Success(ExpectEqual(1, 2)) catch { f => .Failure(f) };
    try ExpectText(MessageOf(equal).Message(), "expected 2, but got 1");
    let unequal: Result<(), TestFailure> = try .Success(ExpectNotEqual(5, 5)) catch { f => .Failure(f) };
    try ExpectText(MessageOf(unequal).Message(), "expected anything but 5");
    let near: Result<(), TestFailure> = try .Success(ExpectNear(1.0, 2.0, 0.5)) catch { f => .Failure(f) };
    try ExpectText(MessageOf(near).Message(), "expected 2.0 within 0.5, but got 1.0");
    let text: Result<(), TestFailure> = try .Success(ExpectText("hello world", "hello there")) catch {
        f => .Failure(f),
    };
    try ExpectText(MessageOf(text).Message(),
                   "texts differ at byte 6 (expected 11 bytes, got 11)\n  expected \"hello there\"\n  but got  \"hello world\"");
}

#Test
func OutcomeChecks() throws TestFailure {
    let good: Result<int32, TestFailure> = .Success(3);
    try ExpectEqual(ExpectSuccess(good, "succeeds"), 3);
    let bad: Result<int32, TestFailure> = .Failure(TestFailure::Of("broken"));
    try ExpectText(ExpectFailure(bad, "fails").Message(), "broken");
    let skip = TestFailure::Skip("later");
    try Expect(skip.IsSkip() && !TestFailure::Of("x").IsSkip(), "skips are told apart");
}

#Test
func ReturnsNothing() {
    let value = 2 * 21;
    if value != 42 { return; }
}

#Test
func Skipped() throws TestFailure {
    throw TestFailure::Skip("shows how a skip is reported");
}

module Nested {
    import Test::{ ExpectEqual, TestFailure };

    #Test
    func Inner() throws TestFailure {
        try ExpectEqual(Twice(4), 8);
    }

    func Twice(value: int32) -> int32 {
        return value * 2;
    }
}

func Passes() throws TestFailure {}

func Fails() throws TestFailure {
    throw TestFailure::Of("on purpose");
}

#Test
func Filtering() throws TestFailure {
    let table = [TestCase { name: "Group::Passes", run: Passes }, TestCase { name: "Group::Fails", run: Fails }];
    var options = TestOptions();
    options.quiet = true;
    try ExpectEqual(RunTestsWith(table[..], options), 1);
    options.skip = "Fails";
    try ExpectEqual(RunTestsWith(table[..], options), 0);
    options.skip = "";
    options.filter = "Group::Pass";
    try ExpectEqual(RunTestsWith(table[..], options), 0);
    options.exact = true;
    options.filter = "Group::Fails";
    try ExpectEqual(RunTestsWith(table[..], options), 1);
    options.list = true;
    try ExpectEqual(RunTestsWith(table[..], options), 0);

    // A filter that matches nothing reports so with a code of its own, listing or not, rather than passing with
    // nothing run.
    options.filter = "Fails";
    try ExpectEqual(RunTestsWith(table[..], options), 3);
    options.list = false;
    try ExpectEqual(RunTestsWith(table[..], options), 3);

    // Several filters choose every test any of them matches.
    options.exact = false;
    options.filter = "";
    let passing = ["Nothing", "Passes"];
    options.filters = passing[..];
    try ExpectEqual(RunTestsWith(table[..], options), 0);
    let both = ["Passes", "Fails"];
    options.filters = both[..];
    try ExpectEqual(RunTestsWith(table[..], options), 1);
}
