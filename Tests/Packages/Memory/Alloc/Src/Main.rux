import Core::Assert;
import Memory::{ Alloc, Free, Set };

func Main() -> int {
    let buffer = Alloc(1024);
    Assert(buffer != null, "Alloc(1024)");

    // Every byte of the block must be writable and read back what was written.
    // Safety: `buffer` is a live 1024-byte allocation, checked non-null above, so offsets 0 and 1023 are inside it.
    let (first, last) = unsafe {
        Set(buffer, 0xA5 as byte, 1024);
        let bytes = buffer as *uint8;
        (*bytes, *(bytes + 1023))
    };
    Assert(first == 0xA5, "Alloc(1024) first byte");
    Assert(last == 0xA5, "Alloc(1024) last byte");

    let other = Alloc(1024);
    Assert(other != null, "second Alloc(1024)");
    Assert(other != buffer, "distinct allocations");

    // Safety: both are live base addresses `Alloc` returned, and neither is used afterwards.
    unsafe {
        Free(other);
        Free(buffer);
    }

    let small = Alloc(1);
    Assert(small != null, "Alloc(1)");
    // Safety: `small` is the live base address `Alloc` returned, and is not used afterwards.
    unsafe { Free(small); }
    return 0;
}
