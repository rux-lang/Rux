import Core::{ Assert, Panic };
import Memory::{ MinimumPageSize, PageAlign, PageAllocate, PageError, PageExecute, PageNone, PageProtect, PageRead, PageRelease, PageSize, PageWrite, Set };

// The page layer is where four systems that agree on nothing are made to look the same, so what is checked here is
// the shape of the agreement: that a length is rounded up rather than refused, that an empty request is reported
// rather than quietly accepted, and that a protection actually applies. Every operation that must succeed is
// propagated with `?`, so a refusal the test did not expect fails `Main` itself.

func Main() -> ! PageError {
    let error = PageError::InvalidLength;
    let copiedError = error;
    Assert(copiedError == error, "page errors copy structurally");

    // The real page size is asked of the system, and the query reports whether it got an answer rather than
    // substituting one. A system that will not answer is not a system to guess about.
    let size = PageSize()?;
    Assert(size >= MinimumPageSize, "a real page is at least the documented minimum");
    Assert((size & (size - 1)) == 0, "and its size is a power of two");

    // The bound is what `PageAlign` rounds to, and it is a divisor of the real size on every machine — which is
    // what makes rounding to it safe. On Apple Silicon the two differ by a factor of four, so this is not a
    // restatement of the assertion above.
    Assert(MinimumPageSize == 4096, "the documented minimum is four kilobytes");
    Assert(size % MinimumPageSize == 0, "the real page size is a whole number of minimum pages");

    Assert(PageAlign(0) == 0, "nothing rounds to nothing");
    Assert(PageAlign(1) == MinimumPageSize, "one byte takes a whole minimum page");
    Assert(PageAlign(MinimumPageSize) == MinimumPageSize, "a whole minimum page is already aligned");
    Assert(PageAlign(MinimumPageSize + 1) == MinimumPageSize * 2, "and one byte past it takes two");

    // Rounding past the end of the address range gives the length back rather than wrapping to something small,
    // which the system would then accept as a tiny allocation.
    let nearTheEnd = 0xFFFFFFFFFFFFFFFFu64 as uint;
    Assert(PageAlign(nearTheEnd) == nearTheEnd, "a length that cannot be rounded is returned unchanged");

    // An empty request is an arithmetic error at the caller, so it is reported rather than accepted.
    let refused = match PageAllocate(0, PageRead | PageWrite) {
        .Failure(reason) => reason == PageError::InvalidLength,
        .Success(_) => false
    };
    Assert(refused, "a zero-length allocation is refused");

    // An ordinary allocation, with a length that is not a whole number of pages.
    let address = PageAllocate(size + 1, PageRead | PageWrite)?;
    Assert(address != null, "the allocation reports where it landed");

    // The whole rounded length is usable, not just the length asked for.
    let bytes = address as *var byte;
    Set(address, 0xC3 as byte, size * 2);
    Assert(*bytes == 0xC3 as byte, "the first byte is writable");
    Assert(*(bytes + size * 2 - 1) == 0xC3 as byte, "and so is the last of the rounded length");

    // Pages come zeroed, which the next allocation is what shows.
    let second = PageAllocate(size, PageRead | PageWrite)?;
    let secondBytes = second as *var byte;
    Assert(*secondBytes == 0 as byte && *(secondBytes + size - 1) == 0 as byte, "fresh pages are zero-filled");

    // Protection changes are accepted for a range that exists.
    PageProtect(second, size, PageRead)?;
    Assert(*secondBytes == 0 as byte, "narrowed to read-only, the pages are still readable");
    PageProtect(second, size, PageRead | PageWrite)?;
    *secondBytes = 0x5A as byte;
    Assert(*secondBytes == 0x5A as byte, "widened again, they are writable once more");

    // The degenerate arguments are reported rather than passed through.
    Assert(Reason(PageProtect(null, size, PageRead)) == PageError::InvalidAddress, "a null address is refused");
    Assert(Reason(PageProtect(second, 0, PageRead)) == PageError::InvalidLength, "a zero length is refused");
    Assert(Reason(PageRelease(null, size)) == PageError::InvalidAddress, "and so is releasing null");
    Assert(Reason(PageRelease(second, 0)) == PageError::InvalidLength, "or releasing nothing");

    // A protection of none is legal: it takes the space and refuses every access to it, which is a guard page.
    let guarded = PageAllocate(size, PageNone)?;
    Assert(guarded != null, "an inaccessible allocation still reports an address");
    PageRelease(guarded, size)?;

    PageRelease(second, size)?;
    // The first allocation is released by the length it asked for.
    PageRelease(address, size + 1)?;
}

/// The reason a completion failed. A completion that unexpectedly succeeds panics, so a refusal the test expects
/// cannot pass by accident.
func Reason(outcome: ! PageError) -> PageError {
    return match outcome {
        .Failure(reason) => reason,
        .Success(_) => Panic("the operation was expected to be refused")
    };
}
