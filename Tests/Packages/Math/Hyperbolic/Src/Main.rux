// Each inverse is split into ranges to dodge a cancellation, so the test walks straight across every split it
// has: a seam that is merely continuous rather than accurate shows up as a round trip that stops closing.

import Core::Assert;
import Math::{ Abs, ArcCosh, ArcSinh, ArcTanh, Cosh, Cotanh, IsNan, PositiveInfinity64, QuietNan64,
               ScaleByPowerOfTwo, SignBit, Sinh, Tanh, UlpDistance };

func Main() -> int {
    let infinity = PositiveInfinity64();
    let notANumber = QuietNan64();

    // The forward functions at the values that must be exact.
    Assert(Sinh(0.0) == 0.0 && !SignBit(Sinh(0.0)), "the hyperbolic sine of zero is zero");
    Assert(SignBit(Sinh(-0.0)), "and of a negative zero keeps its sign, since it is odd");
    Assert(Cosh(0.0) == 1.0 && Cosh(-0.0) == 1.0, "the hyperbolic cosine of either zero is one, being even");
    Assert(Tanh(0.0) == 0.0 && SignBit(Tanh(-0.0)), "and the hyperbolic tangent behaves like the sine");
    Assert(Sinh(infinity) == infinity && Sinh(-infinity) == -infinity, "the sine diverges both ways");
    Assert(Cosh(infinity) == infinity && Cosh(-infinity) == infinity, "the cosine diverges upward both ways");
    Assert(Tanh(infinity) == 1.0 && Tanh(-infinity) == -1.0, "and the tangent saturates at the unit values");
    Assert(IsNan(Sinh(notANumber)) && IsNan(Cosh(notANumber)) && IsNan(Tanh(notANumber)), "a NaN propagates");

    // The identity that defines them, across a range wide enough to reach the overflow guard.
    var step: uint = 0;
    while step <= 300u {
        let value = -15.0 + (step as float64) * 0.1;
        let s = Sinh(value);
        let c = Cosh(value);
        Assert(Abs(c * c - s * s - 1.0) < 1.0e-10 * (1.0 + c * c),
               "the hyperbolic Pythagorean identity holds");
        if Abs(value) > 0.05 {
            Assert(Abs(Tanh(value) - s / c) < 1.0e-14, "and the tangent is the ratio it is defined as");
            Assert(Abs(Cotanh(value) - c / s) < 1.0e-13 * (1.0 + Abs(c / s)),
                   "as the cotangent is the other ratio");
        }
        step = step + 1;
    }

    // The inverses at their exact points and on their domains.
    Assert(ArcSinh(0.0) == 0.0 && !SignBit(ArcSinh(0.0)), "the inverse hyperbolic sine of zero is zero");
    Assert(SignBit(ArcSinh(-0.0)), "and of a negative zero keeps its sign");
    Assert(ArcSinh(infinity) == infinity && ArcSinh(-infinity) == -infinity, "it is unbounded both ways");
    Assert(IsNan(ArcSinh(notANumber)), "and a NaN propagates");

    Assert(ArcCosh(1.0) == 0.0, "the inverse hyperbolic cosine of one is zero");
    Assert(IsNan(ArcCosh(0.5)) && IsNan(ArcCosh(-1.0)), "below one there is no real answer");
    Assert(ArcCosh(infinity) == infinity, "it is unbounded above");
    Assert(IsNan(ArcCosh(notANumber)), "and a NaN propagates");

    Assert(ArcTanh(0.0) == 0.0 && SignBit(ArcTanh(-0.0)), "the inverse hyperbolic tangent of zero is zero");
    Assert(ArcTanh(1.0) == infinity && ArcTanh(-1.0) == -infinity, "the unit values are its poles");
    Assert(IsNan(ArcTanh(1.5)) && IsNan(ArcTanh(-1.5)), "and outside them there is no real answer");
    Assert(IsNan(ArcTanh(notANumber)), "a NaN propagates here too");

    // Round trips across every range split each inverse has. For the inverse sine those sit at 2^-28, 2 and
    // 2^28, so the walk covers all three by spanning the exponents.
    var power: int64 = -40;
    while power <= 60i64 {
        let value = ScaleByPowerOfTwo(1.3, power);
        Assert(Abs(Sinh(ArcSinh(value)) - value) < 1.0e-14 * Abs(value),
               "the inverse hyperbolic sine inverts, at every scale");
        Assert(ArcSinh(0.0 - value) == 0.0 - ArcSinh(value), "and is odd");
        power = power + 1i64;
    }

    // The inverse cosine splits at one, two and 2^28; the interval just above one is the delicate part.
    var above: uint = 1;
    while above <= 200u {
        let value = 1.0 + (above as float64) * 0.005;
        Assert(Abs(Cosh(ArcCosh(value)) - value) < 1.0e-13 * value,
               "the inverse hyperbolic cosine inverts just above its domain edge");
        above = above + 1;
    }
    var scale: int64 = 1;
    while scale <= 60i64 {
        let value = ScaleByPowerOfTwo(1.7, scale);
        Assert(Abs(Cosh(ArcCosh(value)) - value) < 1.0e-13 * value,
               "and at every scale above that");
        scale = scale + 1i64;
    }

    // The inverse tangent splits at 2^-28 and a half; the walk crosses both and approaches the poles.
    var inner: uint = 0;
    while inner < 199u {
        let value = -0.995 + (inner as float64) * 0.01;
        Assert(Abs(Tanh(ArcTanh(value)) - value) < 1.0e-14,
               "the inverse hyperbolic tangent inverts across both of its splits");
        inner = inner + 1;
    }
    // Below 2^-28 the cubic term of the series is under half an ulp, so the answer is the argument exactly.
    // That is the range the short path claims, and it is the range this checks -- above it the cubic term is
    // real and the answer genuinely differs.
    var tinyPower: int64 = -80;
    while tinyPower <= -29i64 {
        let value = ScaleByPowerOfTwo(1.1, tinyPower);
        Assert(ArcTanh(value) == value,
               "and is the argument itself near zero, where the closed form would cancel it away");
        Assert(ArcSinh(value) == value, "as is the inverse sine on the same range");
        tinyPower = tinyPower + 1i64;
    }
    // Just above that boundary the cubic term appears, which is what makes the split necessary.
    let justAbove = ScaleByPowerOfTwo(1.0, -20i64);
    Assert(Abs(ArcTanh(justAbove) - (justAbove + justAbove * justAbove * justAbove / 3.0)) < 1.0e-30,
           "and just above it the cubic term of the series is exactly what appears");

    // A value large enough that the closed form's square root would overflow, while the answer is ordinary.
    let enormous = ScaleByPowerOfTwo(1.0, 600i64);
    Assert(!IsNan(ArcSinh(enormous)) && ArcSinh(enormous) < 500.0,
           "an argument whose square overflows still has an ordinary inverse sine");
    Assert(!IsNan(ArcCosh(enormous)) && ArcCosh(enormous) < 500.0, "and an ordinary inverse cosine");

    // The narrow width.
    Assert(ArcSinh(0.0f32) == 0.0f32 && ArcCosh(1.0f32) == 0.0f32 && ArcTanh(0.0f32) == 0.0f32,
           "the narrow inverses agree at their exact points");

    return 0;
}
