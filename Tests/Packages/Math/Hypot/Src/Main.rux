import Core::{ Assert, #target, #Error };
import Math::Hypot;

// Reading a float's bits is one register-to-register move, but which registers
// it moves between is the calling convention's business, so each architecture
// writes its own body. Both the Win64 and System V ABIs pass the first float
// argument in xmm0 and return an integer in rax; AAPCS64 passes it in d0 and
// returns it in x0.
when #target.arch {
    .X86_64 => {
        asm func BitsOf(x: float64) -> int64 {
            movq rax, xmm0
            ret
        }
    },
    .AArch64 => {
        asm func BitsOf(x: float64) -> int64 {
            fmov x0, d0
            ret
        }
    },
    else => #Error("Unsupported architecture")
}

func Close(actual: float64, expected: float64) -> bool {
    if actual != actual {
        return false;
    }
    if actual < 0.0 {
        return false;
    }
    var gap = BitsOf(actual) - BitsOf(expected);
    if gap < 0i64 {
        gap = -gap;
    }
    return gap <= 2i64;
}

func Main() -> int {
    var zero = 0.0;
    var one = 1.0;
    let inf = one / zero;

    Assert(Hypot(0.0, 0.0) == 0.0, "Hypot(0, 0)");
    Assert(Hypot(-0.0, 0.0) == 0.0, "Hypot(-0, 0)");
    Assert(Hypot(3.0, 4.0) == 5.0, "Hypot(3, 4)");
    Assert(Hypot(-3.0, 4.0) == 5.0, "Hypot(-3, 4)");
    Assert(Hypot(5.0, 12.0) == 13.0, "Hypot(5, 12)");
    Assert(Close(Hypot(1e300, 1e300), 1.4142135623730952e300), "Hypot huge");
    Assert(Close(Hypot(1e-300, 1e-300), 1.414213562373095e-300), "Hypot tiny");
    Assert(Hypot(inf, 1.0) == inf, "Hypot(+Inf, finite)");
    Assert(Hypot(1.0, -inf) == inf, "Hypot(finite, -Inf)");
    Assert(Hypot(inf, zero / zero) == inf, "Hypot(+Inf, NaN)");

    let nanHypot = Hypot(zero / zero, 1.0);
    Assert(nanHypot != nanHypot, "Hypot(NaN, finite)");

    Assert(Hypot(3.0f32, 4.0f32) == 5.0f32, "Hypot(3f32, 4f32)");
    return 0;
}
