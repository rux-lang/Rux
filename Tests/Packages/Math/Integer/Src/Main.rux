// The asymmetry of two's complement is behind nearly every edge here: the most negative value of a signed width
// has no positive counterpart, so its magnitude, its negation, and its greatest common divisor with zero are all
// unrepresentable. Each of those is checked at the width where it is cheapest to see, and the generic code means
// what holds for int8 holds for int512.

import Core::{ Assert, MaximumOf, MinimumOf };
import Math::{ AbsChecked, AbsWrapping, Clamp, GcdChecked, LcmChecked, Maximum, Minimum, PowChecked };

func Main() -> int {
    // Magnitude, including the one input that has none.
    var got: int32 = 0;
    Assert(!AbsChecked<int32>(-5, @got) && got == 5, "a negative magnitude is positive");
    Assert(!AbsChecked<int32>(5, @got) && got == 5, "and a positive one is itself");
    Assert(!AbsChecked<int32>(0, @got) && got == 0, "zero is its own magnitude");
    Assert(AbsChecked<int32>(-2147483648, @got), "the most negative value has no representable magnitude");
    Assert(got == -2147483648i32, "and the wrapped answer is the machine's own");
    Assert(AbsWrapping<int32>(-2147483648) == -2147483648i32, "which is what the wrapping form returns");

    var small: int8 = 0;
    Assert(AbsChecked<int8>(-128, @small), "the same holds at the narrowest width");
    Assert(!AbsChecked<int8>(-127, @small) && small == 127, "one above it is fine");

    // An unsigned type is already its own magnitude and can never overflow here.
    var wide: uint64 = 0;
    Assert(!AbsChecked<uint64>(18446744073709551615, @wide) && wide == 18446744073709551615u64,
           "an unsigned maximum is its own magnitude");

    // Ordering and clamping.
    Assert(Minimum<int32>(-3, 4) == -3i32, "the smaller of two is the smaller");
    Assert(Maximum<int32>(-3, 4) == 4, "and the larger is the larger");
    Assert(Minimum<uint8>(0, 255) == 0, "unsigned extremes order correctly");
    Assert(Maximum<uint8>(0, 255) == 255, "in both directions");
    Assert(Clamp<int32>(7, 0, 5) == 5, "a value above the range comes down to the top");
    Assert(Clamp<int32>(-7, 0, 5) == 0, "one below comes up to the bottom");
    Assert(Clamp<int32>(3, 0, 5) == 3, "and one inside is untouched");
    Assert(Clamp<int32>(3, 5, 0) == 5, "a contradictory pair yields the low bound, as documented");

    // Greatest common divisor, on magnitudes, with the conventional zero cases.
    var divisor: int32 = 0;
    Assert(!GcdChecked<int32>(12, 18, @divisor) && divisor == 6, "the usual case");
    Assert(!GcdChecked<int32>(-12, 18, @divisor) && divisor == 6, "signs do not matter");
    Assert(!GcdChecked<int32>(-12, -18, @divisor) && divisor == 6, "in either position");
    Assert(!GcdChecked<int32>(17, 5, @divisor) && divisor == 1, "coprime values share only one");
    Assert(!GcdChecked<int32>(0, 0, @divisor) && divisor == 0, "zero with zero is zero by convention");
    Assert(!GcdChecked<int32>(9, 0, @divisor) && divisor == 9, "which keeps Gcd(x, 0) equal to |x|");
    Assert(!GcdChecked<int32>(0, 9, @divisor) && divisor == 9, "from either side");
    Assert(GcdChecked<int32>(-2147483648, 0, @divisor),
           "and the one divisor too large to express is reported");

    // Least common multiple, and the identity that pins it to the divisor.
    var multiple: int32 = 0;
    Assert(!LcmChecked<int32>(4, 6, @multiple) && multiple == 12, "the usual case");
    Assert(!LcmChecked<int32>(0, 5, @multiple) && multiple == 0, "zero with anything is zero");
    Assert(!LcmChecked<int32>(-4, 6, @multiple) && multiple == 12, "signs do not matter here either");
    Assert(!LcmChecked<int32>(21, 6, @multiple) && multiple == 42, "a shared factor is counted once");
    // Two large coprime values multiply, which is exactly what does not fit.
    Assert(LcmChecked<int32>(65537, 65539, @multiple), "a product past the width is reported");
    // A value whose product would overflow but whose multiple does not: dividing first is what saves it.
    var lower: int32 = 0;
    Assert(!LcmChecked<int32>(2000000000, 1000000000, @lower) && lower == 2000000000,
           "dividing before multiplying keeps a representable answer representable");

    // Checked power.
    var power: int32 = 0;
    Assert(!PowChecked<int32>(2, 10, @power) && power == 1024, "the usual case");
    Assert(!PowChecked<int32>(7, 0, @power) && power == 1, "anything to the zeroth is one");
    Assert(!PowChecked<int32>(0, 0, @power) && power == 1, "including zero, since the empty product is one");
    Assert(!PowChecked<int32>(0, 5, @power) && power == 0, "zero to anything else is zero");
    Assert(!PowChecked<int32>(-2, 3, @power) && power == -8i32, "an odd power keeps a negative sign");
    Assert(!PowChecked<int32>(-2, 4, @power) && power == 16, "and an even one loses it");
    Assert(!PowChecked<int32>(1, 1000000, @power) && power == 1, "one stays one however long the exponent");
    Assert(PowChecked<int32>(2, 31, @power), "a power one past the signed maximum is reported");
    Assert(!PowChecked<int32>(2, 30, @power) && power == 1073741824, "and the one below it is not");
    var byte: uint8 = 0;
    Assert(!PowChecked<uint8>(15, 2, @byte) && byte == 225, "a square that just fits is not an overflow");
    Assert(PowChecked<uint8>(16, 2, @byte), "and one that just does not is");

    // The same code at a width nothing else in the suite reaches.
    var huge: uint512 = 0;
    Assert(!PowChecked<uint512>(2, 400, @huge), "two to the four hundredth fits a 512-bit integer");
    var back: uint512 = 0;
    Assert(!GcdChecked<uint512>(huge, 1024, @back) && back == 1024,
           "and shares its low power of two with a smaller one");

    return 0;
}
