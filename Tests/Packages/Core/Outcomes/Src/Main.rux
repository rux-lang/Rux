import Core::{ Assert, Ordering, Result };

struct Handle {
    value: int32;
}

extend Handle {
    func ~Handle(&var self) {}
}

enum Failure: int8 {
    Missing,
    Invalid
}

// Throws `Invalid` for a negative `value`.
func Checked(value: int32) -> int32 throws Failure {
    if value < 0 { throw Failure::Invalid; }
    return value;
}

func Main() -> int {
    // Which channel a native fallible holds, asked without unwrapping it.
    let success: int32 ! Failure = .Success(13);
    Assert(success is .Success(_) && !(success is .Failure(_)), "Success channel inspection");
    let failure: int32 ! Failure = .Failure(Failure::Invalid);
    Assert(failure is .Failure(_) && !(failure is .Success(_)), "Failure channel inspection");
    let completed: ! Failure = .Success(());
    Assert(completed is .Success(_), "Unit success inspection");

    // Asking borrows, so an outcome whose payload cannot be copied is still there to be matched afterwards.
    let held: Handle ! Failure = .Success(Handle { value: 23 });
    Assert(held is .Success(_), "A move-only outcome is asked without consuming it");
    let heldValue = match move held {
        .Success(handle) => handle.value,
        .Failure(_) => 0
    };
    Assert(heldValue == 23, "and is still there to be matched");

    // An outcome kept as a value is a `Result`, an ordinary variant built from what a `try` produced.
    let kept: Result<int32, Failure> = try .Success(Checked(5)) catch { error => .Failure(error) };
    Assert(kept is .Success(5), "A success kept as a result");
    let refused: Result<int32, Failure> = try .Success(Checked(-1)) catch { error => .Failure(error) };
    Assert(refused is .Failure(Failure::Invalid), "A failure kept as a result");
    let owned: Result<Handle, Failure> = .Success(Handle { value: 31 });
    Assert(owned is .Success(_) && !(owned is .Failure(_)), "Asking a result borrows it");
    let ownedValue = match move owned {
        .Success(handle) => handle.value,
        .Failure(_) => 0
    };
    Assert(ownedValue == 31, "so it can still be matched");

    Assert(Ordering::Less.IsLess(), "Less classification");
    Assert(Ordering::Equal.IsEqual(), "Equal classification");
    Assert(Ordering::Greater.IsGreater(), "Greater classification");
    Assert(Ordering::Less.Reverse() == Ordering::Greater, "Ordering reversal");
    Assert(Ordering::Equal.Reverse() == Ordering::Equal, "Equal reversal");
    Assert(Ordering::Greater.Reverse() == Ordering::Less, "Greater reversal");

    // The two derived classifications, which spare a caller from negating one.
    Assert(Ordering::Less.IsLessOrEqual(), "Less is less-or-equal");
    Assert(Ordering::Equal.IsLessOrEqual(), "Equal is less-or-equal");
    Assert(!Ordering::Greater.IsLessOrEqual(), "Greater is not less-or-equal");
    Assert(Ordering::Greater.IsGreaterOrEqual(), "Greater is greater-or-equal");
    Assert(Ordering::Equal.IsGreaterOrEqual(), "Equal is greater-or-equal");
    Assert(!Ordering::Less.IsGreaterOrEqual(), "Less is not greater-or-equal");

    // The discriminants are the comparison's sign, one byte wide.
    Assert(Ordering::Less as int8 == -1i8, "Less is -1");
    Assert(Ordering::Equal as int8 == 0, "Equal is 0");
    Assert(Ordering::Greater as int8 == 1, "Greater is 1");
    return 0;
}
