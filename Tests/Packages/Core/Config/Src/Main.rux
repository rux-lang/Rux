import Core::{ Assert, #config };

// Config's whole surface is the #config.Has and #config.Get intrinsics, which
// take a string literal and are answered while compiling. This test package
// defines no configuration values, so every name it asks about is absent.
func Main() -> int {
    // An arbitrary name is absent and its lookup comes back empty.
    Assert(!#config.Has("UNDEFINED_CONFIG_NAME"), "undefined name is absent");
    Assert(#config.Get("UNDEFINED_CONFIG_NAME").length == 0, "undefined name is empty");

    // Has and Get agree with each other: a name Has reports absent has nothing
    // for Get to return.
    let present = #config.Has("ANOTHER_UNDEFINED_NAME");
    let value = #config.Get("ANOTHER_UNDEFINED_NAME");
    Assert(!present, "second undefined name is absent");
    Assert(value.length == 0, "second undefined name is empty");
    return 0;
}
