
import Core::{ #source, Assert };

// A dependency-free slice comparison, so the test can check the exact strings
// the compiler fills in without pulling in Text for its String type.
func SliceEquals(a: char8[..], b: char8[..]) -> bool {
    if a.length != b.length {
        return false;
    }
    var i: uint = 0;
    while i < a.length {
        if a.data[i] != b.data[i] {
            return false;
        }
        i++;
    }
    return true;
}

module Tools {
    pub func ModuleName() -> char8[..] {
        return #source.module;
    }

    module Inner {
        pub func ModuleName() -> char8[..] {
            return #source.module;
        }
    }
}

func CallerLine(line: uint = #source.line) -> uint {
    return line;
}

func CallerColumn(column: uint = #source.column) -> uint {
    return column;
}

func Main() -> int {
    // The location is one-based, so both coordinates sit past zero.
    Assert(#source.line > 0, "line");
    Assert(#source.column == 12, "column is that of the reading expression's first character");

    // The file name and the name of the function reading the value are what the
    // compiler reports, exactly.
    Assert(SliceEquals(#source.fileName, "Main.rux"), "fileName");
    Assert(SliceEquals(#source.function, "Main"), "function");

    // The full paths are populated, and the module path names `module` blocks only, so it is empty at the top of a
    // file.
    Assert(#source.file.length > 0, "file");
    Assert(#source.filePath.length > 0, "filePath");
    Assert(SliceEquals(#source.module, ""), "module at the top of a file");
    Assert(SliceEquals(Tools::ModuleName(), "Tools"), "module inside a module block");
    Assert(SliceEquals(Tools::Inner::ModuleName(), "Tools::Inner"), "module inside nested module blocks");

    // A `#source` read in a default value reports the call, not the declaration.
    let callLine = #source.line;
    Assert(CallerLine() == callLine + 1, "a default value reads the line of the call");
    Assert(CallerColumn() == 12, "a default value reads the column of the call");

    // The value tracks the line it is read on: a read further down the file
    // reports a greater line than one above it.
    let first = #source.line;
    let second = #source.line;
    Assert(second > first, "line advances down the file");
    return 0;
}
