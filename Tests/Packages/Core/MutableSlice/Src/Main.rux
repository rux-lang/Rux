struct Pair {
    first: int32;
    second: int32;
}

func Main() -> int {
    // A new view borrows nothing and reports itself empty.
    let empty: var int32[..] = [];
    if empty.length != 0 || empty.length != 0 { return 10; }
    if empty.data != null { return 11; }

    // An explicit empty view has no backing storage.
    var storage: int32[6] = [10, 20, 30, 40, 50, 60];
    let none: var int32[..] = [];
    if none.length != 0 || none.data != null { return 12; }

    // Range indexing borrows the caller's storage without copying it.
    let view = storage[..];
    if view.length == 0 || view.length != 6 { return 20; }
    if view.data != @storage[0] { return 21; }
    if view[0] != 10 || view[5] != 60 { return 22; }
    let copied = view;
    if copied.data != view.data || copied.length != view.length { return 23; }

    // Assignment writes through to the borrowed storage.
    view[0] = 11;
    if view[0] != 11 || storage[0] != 11 { return 30; }

    // Explicit swapping exchanges two elements, and swapping an index with itself leaves
    // the element alone.
    let held1 = view[0];
    view[0] = view[5];
    view[5] = held1;
    if view[0] != 60 || view[5] != 11 { return 31; }
    let held2 = view[2];
    view[2] = view[2];
    view[2] = held2;
    if view[2] != 30 { return 32; }
    let held3 = view[0];
    view[0] = view[5];
    view[5] = held3;
    if view[0] != 11 || view[5] != 60 { return 33; }

    // A range covers part of the same storage, sharing it rather than copying.
    let middle = view[2..4];
    if middle.length != 2 || middle[0] != 30 || middle[1] != 40 { return 40; }
    middle[0] = 33;
    if view[2] != 33 || storage[2] != 33 { return 41; }

    // A sub-view of a sub-view stays inside the original storage.
    let nested = view[1..5][1..3];
    if nested.length != 2 || nested[0] != 33 { return 46; }

    // Weakening aliases the same storage read-only and tracks later writes.
    let borrowed: int32[..] = view;
    if borrowed.length != 6 || borrowed.data != view.data { return 50; }
    if borrowed[0] != 11 { return 51; }
    view[0] = 99;
    if borrowed[0] != 99 { return 52; }

    // An empty view converts to an empty slice.
    let emptyReadOnly: int32[..] = empty;
    if emptyReadOnly.length != 0 { return 53; }

    // Element size participates in pointer indexing and in range arithmetic.
    var pairs: Pair[3] = [Pair { first: 1, second: 2 },
                          Pair { first: 3, second: 4 },
                          Pair { first: 5, second: 6 }];
    let pairView = pairs[..];
    if pairView[1].second != 4 { return 60; }
    let pairTail = pairView[1..3];
    if pairTail.length != 2 || pairTail[0].first != 3 { return 61; }
    pairTail[0] = Pair { first: 7, second: 8 };
    if pairs[1].first != 7 || pairs[1].second != 8 { return 62; }
    let held4 = pairView[0];
    pairView[0] = pairView[2];
    pairView[2] = held4;
    if pairs[0].first != 5 || pairs[2].first != 1 { return 63; }

    return 0;
}
