import Core::{ #target, ApplicationBinaryInterface, Architecture, Assert, DataModel, Endianness, ObjectFormat };
import Core::{ OperatingSystem, TargetFeature };

func Main() -> int {
    // The #target is fully identified: OS, architecture, data model and object
    // format are all resolved rather than left Unknown.
    Assert(#target.os != OperatingSystem::Unknown, "os");
    Assert(#target.arch != Architecture::Unknown, "arch");
    Assert(#target.dataModel != DataModel::Unknown, "dataModel");
    Assert(#target.objectFormat != ObjectFormat::Unknown, "objectFormat");
    Assert(#target.triple.length > 0, "triple");

    // Endianness is one of the two the enum defines.
    Assert(#target.endian == Endianness::Little || #target.endian == Endianness::Big, "endian");

    // Both supported instruction sets are 64-bit, so the pointer width is 64
    // and agrees with the architecture.
    Assert(#target.pointerBits == 64, "pointerBits");

    let is64 = #target.arch == Architecture::AArch64
        || #target.arch == Architecture::X86_64;
    Assert(is64, "the target architecture is one of the two supported 64-bit sets");

    // The ABI is readable like every other field, and follows the operating system and architecture.
    Assert(#target.abi != ApplicationBinaryInterface::Unknown, "abi");
    if #target.arch == Architecture::X86_64 {
        let windows = #target.os == OperatingSystem::Windows;
        Assert(windows == (#target.abi == ApplicationBinaryInterface::WindowsX64), "the x86-64 ABI follows the OS");
    }

    // The feature query is answered while compiling and is a pure function of its argument.
    Assert(#target.HasFeature(TargetFeature::SSE2) == #target.HasFeature(TargetFeature::SSE2),
           "HasFeature deterministic");
    return 0;
}
