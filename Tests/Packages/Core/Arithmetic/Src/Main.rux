import Core::Primitives::*;
import Core::Arithmetic::{ MaximumOf, MinimumOf };
import Core::Diagnostics::Assert;

// Checked and saturating arithmetic is a method of each integer type, and wrapping arithmetic is the operators `+%`,
// `-%` and `*%`. The methods of every width are built on one generic helper, so the narrowest, a middle and the widest
// width of each signedness are checked at their limits, where a helper that is right for one width and wrong for
// another shows. The generic limits `MaximumOf` and `MinimumOf` are compared against each type's own constants.

func CheckUnsigned8() -> int32 {
    let maximum = uint8::Max;
    if MaximumOf<uint8>(0) != maximum || MinimumOf<uint8>(0) != 0 { return 1; }
    if 1u8.CheckedAdd(1) != .Some(2) { return 2; }
    if maximum.CheckedAdd(1) != none { return 3; }
    if 0u8.CheckedSub(1) != none { return 4; }
    if maximum.CheckedSub(maximum) != .Some(0) { return 5; }
    if maximum.CheckedMul(2) != none || maximum.CheckedMul(1) != .Some(maximum) { return 6; }
    if maximum.SaturatingAdd(1) != maximum || 0u8.SaturatingSub(1) != 0 { return 7; }
    if maximum.SaturatingMul(2) != maximum || 1u8.SaturatingMul(2) != 2 { return 8; }
    if maximum +% 1 != 0 || 0u8 -% 1 != maximum || maximum *% 2 != maximum - 1 { return 9; }
    return 0;
}

func CheckUnsigned64() -> int32 {
    let maximum = uint64::Max;
    if MaximumOf<uint64>(0) != maximum { return 1; }
    if maximum.CheckedAdd(1) != none || maximum.CheckedAdd(0) != .Some(maximum) { return 2; }
    if 0u64.CheckedSub(1) != none { return 3; }
    if maximum.CheckedMul(2) != none { return 4; }
    if maximum.SaturatingAdd(1) != maximum || maximum.SaturatingMul(2) != maximum { return 5; }
    if maximum +% 1 != 0 { return 6; }
    return 0;
}

func CheckUnsigned512() -> int32 {
    let maximum = uint512::Max;
    if MaximumOf<uint512>(0) != maximum { return 1; }
    if maximum.CheckedAdd(1) != none || 1u512.CheckedAdd(1) != .Some(2) { return 2; }
    if 0u512.CheckedSub(1) != none { return 3; }
    if maximum.CheckedMul(2) != none || maximum.CheckedMul(0) != .Some(0) { return 4; }
    if maximum.SaturatingAdd(1) != maximum || 0u512.SaturatingSub(1) != 0 { return 5; }
    if maximum +% 1 != 0 { return 6; }
    return 0;
}

func CheckSigned8() -> int32 {
    let maximum = int8::Max;
    let minimum = int8::Min;
    if MaximumOf<int8>(0) != maximum || MinimumOf<int8>(0) != minimum { return 1; }
    if maximum.CheckedAdd(1) != none || minimum.CheckedAdd(-1) != none { return 2; }
    if maximum.CheckedAdd(-1) != .Some(maximum - 1) { return 3; }
    if minimum.CheckedSub(1) != none || maximum.CheckedSub(-1) != none { return 4; }
    if 0i8.CheckedSub(maximum) != .Some(-maximum) { return 5; }
    if minimum.CheckedMul(-1) != none || (-1i8).CheckedMul(minimum) != none { return 6; }
    if minimum.CheckedMul(1) != .Some(minimum) || maximum.CheckedMul(2) != none { return 7; }
    if maximum.SaturatingAdd(1) != maximum || minimum.SaturatingAdd(-1) != minimum { return 8; }
    if minimum.SaturatingSub(1) != minimum || maximum.SaturatingSub(-1) != maximum { return 9; }
    if maximum.SaturatingMul(2) != maximum || minimum.SaturatingMul(2) != minimum { return 10; }
    if maximum.SaturatingMul(-1) != minimum + 1 || minimum.SaturatingMul(-1) != maximum { return 11; }
    if maximum +% 1 != minimum || minimum -% 1 != maximum || minimum *% -1 != minimum { return 12; }
    return 0;
}

func CheckSigned64() -> int32 {
    let maximum = int64::Max;
    let minimum = int64::Min;
    if MaximumOf<int64>(0) != maximum || MinimumOf<int64>(0) != minimum { return 1; }
    if maximum.CheckedAdd(1) != none || minimum.CheckedSub(1) != none { return 2; }
    if minimum.CheckedMul(-1) != none || maximum.CheckedMul(-1) != .Some(minimum + 1) { return 3; }
    if minimum.SaturatingMul(-1) != maximum { return 4; }
    if maximum +% 1 != minimum { return 5; }
    return 0;
}

func CheckSigned512() -> int32 {
    let maximum = int512::Max;
    let minimum = int512::Min;
    if MaximumOf<int512>(0) != maximum || MinimumOf<int512>(0) != minimum { return 1; }
    if maximum.CheckedAdd(1) != none || minimum.CheckedAdd(-1) != none { return 2; }
    if minimum.CheckedMul(-1) != none || (-1i512).CheckedMul(minimum) != none { return 3; }
    if maximum.SaturatingAdd(1) != maximum || minimum.SaturatingSub(1) != minimum { return 4; }
    if maximum +% 1 != minimum { return 5; }
    return 0;
}

func Main() -> int {
    Assert(CheckUnsigned8() == 0, "uint8 arithmetic");
    Assert(CheckUnsigned64() == 0, "uint64 arithmetic");
    Assert(CheckUnsigned512() == 0, "uint512 arithmetic");
    Assert(CheckSigned8() == 0, "int8 arithmetic");
    Assert(CheckSigned64() == 0, "int64 arithmetic");
    Assert(CheckSigned512() == 0, "int512 arithmetic");
    Assert(uint256::Min == 0, "an unsigned minimum is zero");
    Assert(int256::Bits == 256, "a width reports its own size in bits");
    Assert(int256::Bytes == 32, "a width reports its own size in bytes");
    return 0;
}
