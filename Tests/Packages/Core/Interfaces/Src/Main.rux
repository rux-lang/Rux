import Core::{ Assert, Comparable, Drop, Equatable, Hashable, Iterable, Iterator, Option, Ordering };

// A droppable value. Implementing Drop is what makes a type move-only, which is
// the part of the contract the compiler enforces today; the destructor itself is
// not emitted yet, so nothing here asserts that it ran.
struct Guard {
    value: int32;
}

extend Guard : Drop {
    func Drop(self: *var Guard) {
    }
}

// Consumes the guard, which is the only way to pass a move-only value.
func Spend(guard: Guard) -> int32 {
    return guard.value;
}

struct Card {
    value: int32;
}

extend Card : Equatable {
    func Equals(self: *Card, other: *Card) -> bool {
        return self.value == other.value;
    }
}

extend Card : Comparable {
    func Compare(self: *Card, other: *Card) -> Ordering {
        if self.value < other.value {
            return Ordering::Less;
        }
        if self.value > other.value {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }
}

extend Card : Hashable {
    func Hash(self: *Card) -> uint64 {
        return self.value as uint64;
    }
}

// A cursor over a half-open span of integers, which is the shape the compiler
// drives a `for` loop by: `Next` advances and reports the item or the end.
struct Counter {
    next: int32;
    limit: int32;
}

extend Counter : Iterator {
    func Next(self: *var Counter) -> Option<int32> {
        if self.next >= self.limit {
            return Option::None<int32>();
        }
        let current = self.next;
        self.next += 1;
        return Option::Some<int32>(current);
    }
}

struct Span {
    limit: int32;
}

extend Span : Iterable {
    func Iterate(self: *Span) -> Counter {
        return Counter { next: 0i32, limit: self.limit };
    }
}

// The bounds are what these interfaces exist for: each resolves `Self` to the
// type argument, so the operand and the result are that type.
func Matches<T: Equatable>(left: *T, right: *T) -> bool {
    return left.Equals(right);
}

func Ranks<T: Comparable>(left: *T, right: *T) -> Ordering {
    return left.Compare(right);
}

func Digest<T: Hashable>(value: *T) -> uint64 {
    return value.Hash();
}

func Main() -> int {
    // Equality is an equivalence: reflexive, symmetric, and agreeing with hashing.
    let low = Card { value: 3i32 };
    let alsoLow = Card { value: 3i32 };
    let high = Card { value: 9i32 };
    Assert(Matches<Card>(@low, @low), "Equality is reflexive");
    Assert(Matches<Card>(@low, @alsoLow), "Equal cards compare equal");
    Assert(Matches<Card>(@alsoLow, @low), "Equality reads the same in either order");
    Assert(!Matches<Card>(@low, @high), "Unequal cards compare unequal");

    // Comparison is a total order, and reversing the operands reverses it.
    Assert(Ranks<Card>(@low, @high).IsLess(), "A smaller card compares less");
    Assert(Ranks<Card>(@high, @low).IsGreater(), "A larger card compares greater");
    Assert(Ranks<Card>(@low, @alsoLow).IsEqual(), "Equal cards compare equal");
    Assert(Ranks<Card>(@low, @high).Reverse() == Ranks<Card>(@high, @low), "Reversing the operands reverses it");

    // Comparison and equality agree.
    Assert(Ranks<Card>(@low, @alsoLow).IsEqual() == Matches<Card>(@low, @alsoLow), "Compare agrees with Equals");
    Assert(Ranks<Card>(@low, @high).IsEqual() == Matches<Card>(@low, @high), "Compare disagrees where Equals does");

    // Hashing agrees with equality and is stable within a run.
    Assert(Digest<Card>(@low) == Digest<Card>(@alsoLow), "Equal cards hash the same");
    Assert(Digest<Card>(@low) == Digest<Card>(@low), "Hashing is stable within a run");

    // The iteration protocol, driven by shape: a `for` over an iterable, and the
    // cursor advanced by hand.
    var total = 0i32;
    let span = Span { limit: 5i32 };
    for value in span {
        total += value;
    }
    Assert(total == 10i32, "A for loop reads an iterable to its end");

    var cursor = Counter { next: 0i32, limit: 3i32 };
    var seen = 0i32;
    var count = 0i32;
    var item = cursor.Next();
    while item.IsSome() {
        seen += item.ValueOr(0i32);
        count += 1;
        item = cursor.Next();
    }
    Assert(seen == 3i32, "Advancing by hand yields every item");
    Assert(count == 3i32, "Advancing by hand stops at the end");
    Assert(cursor.Next().IsNone(), "An exhausted iterator keeps reporting the end");

    // An empty sequence reports the end immediately.
    var empty = Counter { next: 0i32, limit: 0i32 };
    Assert(empty.Next().IsNone(), "An empty iterator reports the end at once");

    // A droppable value is move-only: passing it by value consumes it, and the
    // value that was moved into the call is the one that arrives.
    let guard = Guard { value: 5i32 };
    Assert(Spend(guard) == 5i32, "A droppable value is passed by consuming it");

    // Reinitializing after a complete move gives a fresh value to consume.
    var reused = Guard { value: 7i32 };
    Assert(Spend(reused) == 7i32, "A move-only value can be consumed once");
    reused = Guard { value: 11i32 };
    Assert(Spend(reused) == 11i32, "And consumed again after being reinitialized");

    return 0;
}
