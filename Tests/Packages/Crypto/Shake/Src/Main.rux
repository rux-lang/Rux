// The published vectors, and the property that makes an extendable-output function what it is: the stream is
// continuous, so any sequence of reads totalling the same length gives the same bytes. A version that permuted
// once per call rather than once per exhausted rate would pass the vectors and fail that.

import Core::{ Assert, MutableSlice, Slice };
import Crypto::{ Equal, Shake, Shake128Of, Shake256Of, Sha3Of256 };

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: string) -> Slice<char8> {
    return Slice<char8> { data: text.data, length: text.length };
}

func FromHex(text: Slice<char8>, into: MutableSlice<char8>) {
    var index: uint = 0;
    while index < into.length {
        var value = 0u8;
        var half: uint = 0;
        while half < 2u {
            let c = text.data[index * 2u + half] as uint8;
            var digit = 0u8;
            if c >= 0x30u8 && c <= 0x39u8 {
                digit = c - 0x30u8;
            }
            else {
                digit = c - 0x61u8 + 10u8;
            }
            value = value * 16u8 + digit;
            half = half + 1;
        }
        into.data[index] = value as char8;
        index = index + 1;
    }
}

func Check(got: Slice<char8>, expectedHex: Slice<char8>, what: Slice<char8>) {
    var expected: char8[64];
    let room = MutableSlice::From<char8>(@expected[0], got.length);
    FromHex(expectedHex, room);
    let expectedBytes = Slice<char8> { data: @expected[0], length: got.length };
    Assert(Equal(got, expectedBytes), what);
}

// The same helper for text.
func Check(got: string, expectedHex: string, what: string) {
    Check(TextBytes(got), TextBytes(expectedHex), TextBytes(what));
}

func Main() -> int {
    var output: char8[256];

    // The published first thirty-two bytes for the empty message.
    Shake128Of("", MutableSlice::From<char8>(@output[0], 32));
    Check(Slice<char8> { data: @output[0], length: 32 },
          "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26",
          "SHAKE128 of the empty message");
    Shake256Of("", MutableSlice::From<char8>(@output[0], 32));
    Check(Slice<char8> { data: @output[0], length: 32 },
          "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f",
          "SHAKE256 of the empty message");

    // The stream is continuous: reading it in any pattern gives the same bytes. This is checked across the rate
    // boundary, which is where a version permuting per call rather than per exhausted rate would diverge.
    var whole: char8[512];
    var wholeState = Shake::New128();
    wholeState.Update("continuity");
    wholeState.Read(MutableSlice::From<char8>(@whole[0], 512));

    var chunkSize: uint = 1;
    while chunkSize <= 64u {
        var pieced: char8[512];
        var piecedState = Shake::New128();
        piecedState.Update("continuity");
        var taken: uint = 0;
        while taken < 512u {
            var step = chunkSize;
            if taken + step > 512u {
                step = 512u - taken;
            }
            piecedState.Read(MutableSlice::From<char8>(@pieced[taken], step));
            taken = taken + step;
        }
        let wholeBytes = Slice<char8> { data: @whole[0], length: 512 };
        let piecedBytes = Slice<char8> { data: @pieced[0], length: 512 };
        Assert(Equal(wholeBytes, piecedBytes), "reading the stream in pieces gives the same bytes as one read");
        chunkSize = chunkSize + 1;
    }

    // A longer read is an extension of a shorter one, not a different stream.
    var shortRead: char8[16];
    var shortState = Shake::New256();
    shortState.Update("prefix");
    shortState.Read(MutableSlice::From<char8>(@shortRead[0], 16));
    var longRead: char8[64];
    var longState = Shake::New256();
    longState.Update("prefix");
    longState.Read(MutableSlice::From<char8>(@longRead[0], 64));
    let shortBytes = Slice<char8> { data: @shortRead[0], length: 16 };
    let longPrefix = Slice<char8> { data: @longRead[0], length: 16 };
    Assert(Equal(shortBytes, longPrefix), "a short read is the start of a long one");

    // The message is absorbed in pieces exactly as a hash absorbs it.
    var oneShot: char8[64];
    Shake128Of("the quick brown fox", MutableSlice::From<char8>(@oneShot[0], 64));
    var split = Shake::New128();
    split.Update("the quick ");
    split.Update("brown fox");
    var splitOut: char8[64];
    split.Read(MutableSlice::From<char8>(@splitOut[0], 64));
    Assert(Equal(Slice<char8> { data: @oneShot[0], length: 64 },
                 Slice<char8> { data: @splitOut[0], length: 64 }),
           "absorbing in pieces gives the same stream");

    // Absorbing after reading has begun is ignored rather than silently changing a stream already handed out.
    var late = Shake::New128();
    late.Update("start");
    var first: char8[32];
    late.Read(MutableSlice::From<char8>(@first[0], 32));
    late.Update("too late");
    var second: char8[32];
    late.Read(MutableSlice::From<char8>(@second[0], 32));
    var reference = Shake::New128();
    reference.Update("start");
    var referenceOut: char8[64];
    reference.Read(MutableSlice::From<char8>(@referenceOut[0], 64));
    Assert(Equal(Slice<char8> { data: @second[0], length: 32 },
                 Slice<char8> { data: @referenceOut[32], length: 32 }),
           "a late absorb does not disturb the stream");

    // The domain byte keeps SHAKE and SHA-3 apart: the same message and the same rate would otherwise collide.
    var shakeOut: char8[32];
    Shake256Of("abc", MutableSlice::From<char8>(@shakeOut[0], 32));
    var sha3Out: char8[32];
    Sha3Of256("abc", MutableSlice::From<char8>(@sha3Out[0], 32));
    Assert(!Equal(Slice<char8> { data: @shakeOut[0], length: 32 },
                  Slice<char8> { data: @sha3Out[0], length: 32 }),
           "SHAKE256 and SHA3-256 of the same message differ");

    // The rates, which are what the security level buys.
    var narrow = Shake::New128();
    var wide = Shake::New256();
    Assert(narrow.Rate() == 168u, "SHAKE128 has the larger rate, since its capacity is smaller");
    Assert(wide.Rate() == 136u, "and SHAKE256 the smaller one");

    return 0;
}
