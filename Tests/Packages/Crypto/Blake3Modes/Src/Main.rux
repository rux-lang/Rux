// The property that matters for modes is separation: the same bytes under different modes, keys or contexts must
// give unrelated output, and a mode that quietly ignored its flag would produce identical results here. So most
// of this test is inequalities, which is unusual and is exactly right for what is being checked.

import Core::{ Assert, MutableSlice, Slice };
import Crypto::{ Blake3, Blake3DeriveKey, Blake3KeyedOf, Blake3Of, Digest, Equal };

func Main() -> int {
    var key: char8[32];
    var otherKey: char8[32];
    var index: uint = 0;
    while index < 32u {
        key[index] = (index as uint8) as char8;
        otherKey[index] = (index as uint8) as char8;
        index = index + 1;
    }
    otherKey[31] = (otherKey[31] as uint8 ^ 1u8) as char8;
    let keyBytes = Slice<char8> { data: @key[0], length: 32 };
    let otherKeyBytes = Slice<char8> { data: @otherKey[0], length: 32 };

    var unkeyed: char8[32];
    var keyed: char8[32];
    var otherKeyed: char8[32];
    Blake3Of("message", MutableSlice::From<char8>(@unkeyed[0], 32));
    Blake3KeyedOf(keyBytes, "message", MutableSlice::From<char8>(@keyed[0], 32));
    Blake3KeyedOf(otherKeyBytes, "message", MutableSlice::From<char8>(@otherKeyed[0], 32));

    let unkeyedBytes = Slice<char8> { data: @unkeyed[0], length: 32 };
    let keyedBytes = Slice<char8> { data: @keyed[0], length: 32 };
    let otherKeyedBytes = Slice<char8> { data: @otherKeyed[0], length: 32 };
    Assert(!Equal(unkeyedBytes, keyedBytes), "a keyed hash differs from the unkeyed hash of the same message");
    Assert(!Equal(keyedBytes, otherKeyedBytes), "and two keys one bit apart give unrelated results");

    // A keyed hash is deterministic and incremental like any other.
    var replay: char8[32];
    Blake3KeyedOf(keyBytes, "message", MutableSlice::From<char8>(@replay[0], 32));
    Assert(Equal(keyedBytes, Slice<char8> { data: @replay[0], length: 32 }), "a keyed hash repeats exactly");
    var incremental = Blake3::NewKeyed(keyBytes);
    incremental.Update("mes");
    incremental.Update("sage");
    var incrementalOut: char8[32];
    incremental.Finish(MutableSlice::From<char8>(@incrementalOut[0], 32));
    Assert(Equal(keyedBytes, Slice<char8> { data: @incrementalOut[0], length: 32 }),
           "and splits the same way an unkeyed one does");

    // Keyed hashing across a chunk boundary, so the key reaches the tree rather than only the first block.
    var long: char8[3000];
    index = 0;
    while index < 3000u {
        long[index] = ((index % 251u) as uint8) as char8;
        index = index + 1;
    }
    let longBytes = Slice<char8> { data: @long[0], length: 3000 };
    var longKeyed: char8[32];
    Blake3KeyedOf(keyBytes, longBytes, MutableSlice::From<char8>(@longKeyed[0], 32));
    var longUnkeyed: char8[32];
    Blake3Of(longBytes, MutableSlice::From<char8>(@longUnkeyed[0], 32));
    Assert(!Equal(Slice<char8> { data: @longKeyed[0], length: 32 },
                  Slice<char8> { data: @longUnkeyed[0], length: 32 }),
           "the key still separates a multi-chunk message");
    var longIncremental = Blake3::NewKeyed(keyBytes);
    index = 0;
    while index < 3000u {
        let single = Slice<char8> { data: @long[index], length: 1 };
        longIncremental.Update(single);
        index = index + 1;
    }
    var longIncrementalOut: char8[32];
    longIncremental.Finish(MutableSlice::From<char8>(@longIncrementalOut[0], 32));
    Assert(Equal(Slice<char8> { data: @longKeyed[0], length: 32 },
                 Slice<char8> { data: @longIncrementalOut[0], length: 32 }),
           "and a keyed byte-at-a-time hash agrees across chunk boundaries");

    // Key derivation: the context separates, the material separates, and neither resembles the other modes.
    var derivedOne: char8[32];
    var derivedTwo: char8[32];
    var derivedOther: char8[32];
    Blake3DeriveKey("example.com 2026-08-22 signing key", "material",
                    MutableSlice::From<char8>(@derivedOne[0], 32));
    Blake3DeriveKey("example.com 2026-08-22 signing key", "material",
                    MutableSlice::From<char8>(@derivedTwo[0], 32));
    Blake3DeriveKey("example.com 2026-08-22 encryption key", "material",
                    MutableSlice::From<char8>(@derivedOther[0], 32));
    let oneBytes = Slice<char8> { data: @derivedOne[0], length: 32 };
    let twoBytes = Slice<char8> { data: @derivedTwo[0], length: 32 };
    let otherBytes = Slice<char8> { data: @derivedOther[0], length: 32 };
    Assert(Equal(oneBytes, twoBytes), "the same context and material derive the same key");
    Assert(!Equal(oneBytes, otherBytes), "a different context derives an unrelated key from the same material");

    var differentMaterial: char8[32];
    Blake3DeriveKey("example.com 2026-08-22 signing key", "other material",
                    MutableSlice::From<char8>(@differentMaterial[0], 32));
    Assert(!Equal(oneBytes, Slice<char8> { data: @differentMaterial[0], length: 32 }),
           "and different material derives an unrelated key under the same context");

    // All three modes on the same bytes are mutually unrelated, which is the whole point of the flags.
    var asKeyed: char8[32];
    Blake3KeyedOf(keyBytes, "material", MutableSlice::From<char8>(@asKeyed[0], 32));
    var asPlain: char8[32];
    Blake3Of("material", MutableSlice::From<char8>(@asPlain[0], 32));
    let keyedOfMaterial = Slice<char8> { data: @asKeyed[0], length: 32 };
    let plainOfMaterial = Slice<char8> { data: @asPlain[0], length: 32 };
    Assert(!Equal(oneBytes, keyedOfMaterial), "a derived key is not the keyed hash of the same material");
    Assert(!Equal(oneBytes, plainOfMaterial), "nor its plain hash");
    Assert(!Equal(keyedOfMaterial, plainOfMaterial), "and those two differ from each other");

    // Derivation extends like any other BLAKE3 output.
    var longDerived: char8[128];
    Blake3DeriveKey("example.com 2026-08-22 signing key", "material",
                    MutableSlice::From<char8>(@longDerived[0], 128));
    Assert(Equal(oneBytes, Slice<char8> { data: @longDerived[0], length: 32 }),
           "a longer derived key starts with the shorter one");

    return 0;
}
