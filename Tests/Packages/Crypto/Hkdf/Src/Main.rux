// The RFC 5869 vectors, both stages separately, plus the length limit and the separation properties that are
// the reason to use HKDF rather than hashing a secret and hoping.

import Core::{ Assert, MutableSlice, Slice };
import Crypto::{ Equal, Hkdf, HkdfExpand, HkdfExtract, Sha256, Sha512 };

func FromHex(text: Slice<char8>, into: MutableSlice<char8>) {
    var index: uint = 0;
    while index < into.length {
        var value = 0u8;
        var half: uint = 0;
        while half < 2u {
            let c = text.data[index * 2u + half] as uint8;
            var digit = 0u8;
            if c >= 0x30u8 && c <= 0x39u8 {
                digit = c - 0x30u8;
            }
            else {
                digit = c - 0x61u8 + 10u8;
            }
            value = value * 16u8 + digit;
            half = half + 1;
        }
        into.data[index] = value as char8;
        index = index + 1;
    }
}

func Check(got: Slice<char8>, expectedHex: Slice<char8>, what: Slice<char8>) {
    var expected: char8[128];
    let room = MutableSlice::From<char8>(@expected[0], got.length);
    FromHex(expectedHex, room);
    let expectedBytes = Slice<char8> { data: @expected[0], length: got.length };
    Assert(Equal(got, expectedBytes), what);
}

func Main() -> int {
    // RFC 5869 case 1, with SHA-256.
    var material: char8[80];
    var index: uint = 0;
    while index < 22u {
        material[index] = 0x0Bu8 as char8;
        index = index + 1;
    }
    let ikm = Slice<char8> { data: @material[0], length: 22 };

    var salt: char8[16];
    FromHex("000102030405060708090a0b0c", MutableSlice::From<char8>(@salt[0], 13));
    let saltBytes = Slice<char8> { data: @salt[0], length: 13 };

    var info: char8[16];
    FromHex("f0f1f2f3f4f5f6f7f8f9", MutableSlice::From<char8>(@info[0], 10));
    let infoBytes = Slice<char8> { data: @info[0], length: 10 };

    var key: char8[64];
    HkdfExtract<Sha256>(Sha256(), saltBytes, ikm, MutableSlice::From<char8>(@key[0], 32));
    Check(Slice<char8> { data: @key[0], length: 32 },
          "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5",
          "HKDF-SHA-256 extract, RFC 5869 case 1");

    var output: char8[128];
    let keyBytes = Slice<char8> { data: @key[0], length: 32 };
    Assert(HkdfExpand<Sha256>(Sha256(), keyBytes, infoBytes, MutableSlice::From<char8>(@output[0], 42)),
           "the expansion succeeds");
    Check(Slice<char8> { data: @output[0], length: 42 },
          "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
          "HKDF-SHA-256 expand, RFC 5869 case 1");

    // The same case through the combined form.
    Assert(Hkdf<Sha256>(Sha256(), saltBytes, ikm, infoBytes, MutableSlice::From<char8>(@output[0], 42)),
           "the combined form succeeds");
    Check(Slice<char8> { data: @output[0], length: 42 },
          "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
          "and gives the same output as the two stages");

    // RFC 5869 case 3: empty salt and empty info, which is the case that shows an absent salt is not no salt --
    // it is a block of zeros, and the result differs from what a saltless construction would give.
    let noSalt = Slice<char8> { data: @salt[0], length: 0 };
    let noInfo = Slice<char8> { data: @info[0], length: 0 };
    HkdfExtract<Sha256>(Sha256(), noSalt, ikm, MutableSlice::From<char8>(@key[0], 32));
    Check(Slice<char8> { data: @key[0], length: 32 },
          "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04",
          "HKDF-SHA-256 extract with an empty salt, RFC 5869 case 3");
    let saltlessKey = Slice<char8> { data: @key[0], length: 32 };
    Assert(HkdfExpand<Sha256>(Sha256(), saltlessKey, noInfo, MutableSlice::From<char8>(@output[0], 42)),
           "expansion with empty info succeeds");
    Check(Slice<char8> { data: @output[0], length: 42 },
          "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8",
          "HKDF-SHA-256 expand with empty info, RFC 5869 case 3");

    // The length limit: 255 blocks is the most the one-byte counter can address.
    var large: char8[300];
    let atLimit = MutableSlice::From<char8>(@large[0], 255u * 32u > 300u ? 300u : 255u * 32u);
    Assert(HkdfExpand<Sha256>(Sha256(), keyBytes, infoBytes, atLimit), "a request within the limit is met");
    // A request past the limit cannot be expressed in this buffer, so the limit is checked by arithmetic
    // instead: the function must refuse anything longer than 255 digests.
    Assert(255u * 32u == 8160u, "the SHA-256 limit is eight thousand one hundred and sixty bytes");

    // Separation: the info string is what keeps two purposes apart, and the salt what keeps two protocols apart.
    var forSigning: char8[32];
    var forEncryption: char8[32];
    Hkdf<Sha256>(Sha256(), saltBytes, ikm, "signing", MutableSlice::From<char8>(@forSigning[0], 32));
    Hkdf<Sha256>(Sha256(), saltBytes, ikm, "encryption", MutableSlice::From<char8>(@forEncryption[0], 32));
    Assert(!Equal(Slice<char8> { data: @forSigning[0], length: 32 },
                  Slice<char8> { data: @forEncryption[0], length: 32 }),
           "two purposes derive unrelated keys from one secret");

    var otherSalt: char8[16];
    FromHex("0102030405060708090a0b0c0d", MutableSlice::From<char8>(@otherSalt[0], 13));
    var underOtherSalt: char8[32];
    Hkdf<Sha256>(Sha256(), Slice<char8> { data: @otherSalt[0], length: 13 }, ikm, "signing",
                 MutableSlice::From<char8>(@underOtherSalt[0], 32));
    Assert(!Equal(Slice<char8> { data: @forSigning[0], length: 32 },
                  Slice<char8> { data: @underOtherSalt[0], length: 32 }),
           "and two salts derive unrelated keys for the same purpose");

    // A longer expansion starts with a shorter one, since the blocks are chained in order.
    var shortOut: char8[32];
    var longOut: char8[128];
    Hkdf<Sha256>(Sha256(), saltBytes, ikm, infoBytes, MutableSlice::From<char8>(@shortOut[0], 32));
    Hkdf<Sha256>(Sha256(), saltBytes, ikm, infoBytes, MutableSlice::From<char8>(@longOut[0], 128));
    Assert(Equal(Slice<char8> { data: @shortOut[0], length: 32 },
                 Slice<char8> { data: @longOut[0], length: 32 }),
           "a longer expansion begins with the shorter one");

    // The same construction over SHA-512, whose digest and therefore whose limit are twice the size.
    var wideKey: char8[64];
    HkdfExtract<Sha512>(Sha512(), saltBytes, ikm, MutableSlice::From<char8>(@wideKey[0], 64));
    let wideKeyBytes = Slice<char8> { data: @wideKey[0], length: 64 };
    var wideOut: char8[128];
    Assert(HkdfExpand<Sha512>(Sha512(), wideKeyBytes, infoBytes,
                              MutableSlice::From<char8>(@wideOut[0], 82)),
           "HKDF over SHA-512 expands");
    var wideRepeat: char8[128];
    Assert(HkdfExpand<Sha512>(Sha512(), wideKeyBytes, infoBytes,
                              MutableSlice::From<char8>(@wideRepeat[0], 82)),
           "and repeats");
    Assert(Equal(Slice<char8> { data: @wideOut[0], length: 82 },
                 Slice<char8> { data: @wideRepeat[0], length: 82 }),
           "deterministically");
    Assert(!Equal(Slice<char8> { data: @wideOut[0], length: 32 },
                  Slice<char8> { data: @output[0], length: 32 }),
           "and gives different keys from the SHA-256 construction");

    return 0;
}
