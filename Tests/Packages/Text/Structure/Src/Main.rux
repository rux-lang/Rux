import Core::{ Assert, Failed, Panic, Succeeded };
import Text::{ BufferWriter, Debug, FormatError, FormatSpec, ParseFormatSpec, StringView, TextWriter, WriteAscii,
               WriteBytes, WriteFallibleDebug, WriteOptionalDebug, WriteSliceDebug };

// Showing an outcome or a run of elements without taking it apart.
//
// Three writers, and one property runs through all of them: they borrow. `??` and a match on a moved optional
// consume it because taking a payload out is a transfer of ownership — so the question a test has to answer is
// whether showing a value is also taking it. The tracked element below reports its own destruction, so the answer is
// counted rather than argued: an optional holding a move-only value is written twice, nothing is destroyed, and the
// optional still holds it.
//
// The other half is what the specification means. It reaches each element unchanged, because a sequence has no
// numeric or textual form of its own for a width or a precision to apply to — so a precision truncates each element
// and the brackets and commas are punctuation that is never padded. What an element makes of a specification is that
// element's own business, which is why the last of these cases is an element that reports what it was handed rather
// than one that renders a value.
//
// And a refused write stops the rendering. A destination that has already said no is not written to again, and what
// came after the failing element does not appear, which is the difference between a diagnostic that reports a full
// buffer and one that quietly loses its tail.

// An element that reports each of its own destructions, so "nothing was destroyed" is a count. Move-only, since a
// copy would be a second destruction of the same thing and would hide exactly the defect this is here to catch.
struct Tracked {
    counter: *var int32;
    tag: uint;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked);

    func ~Tracked(self: &var Tracked) {
        if self.counter != null {
            *self.counter = *self.counter + 1;
        }
    }
}

extend Tracked : Debug {
    func WriteDebug(self: &Tracked, writer: &var TextWriter, spec: FormatSpec) -> ! FormatError {
        WriteBytes(writer, "T(")?;
        WriteNumber(writer, self.tag)?;
        return WriteAscii(writer, c8')');
    }
}

// An element that reports the specification it was handed rather than any value, so what reaches an element can be
// read out of the output. Nothing else can show that: the elements a run is written from are the only place a
// specification could be applied or dropped, and a wrapper that quietly replaced it with a plain one would produce
// output identical to a correct one for every element type that ignores width.
struct Spy {}

extend Spy : Debug {
    func WriteDebug(self: &Spy, writer: &var TextWriter, spec: FormatSpec) -> ! FormatError {
        WriteAscii(writer, c8'w')?;
        WriteNumber(writer, spec.Width())?;
        WriteAscii(writer, c8'p')?;
        return WriteNumber(writer, spec.Precision());
    }
}

// A decimal count, written here because this package converts no numbers and depends on nothing that does.
func WriteNumber(writer: &var TextWriter, value: uint) -> ! FormatError {
    if value >= 10u {
        WriteNumber(writer, value / 10)?;
    }
    return WriteAscii(writer, ((value % 10) + 0x30) as char8);
}

func Same(actual: char8[..], expected: char8[..]) -> bool {
    if actual.length != expected.length { return false; }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] { return false; }
        index = index + 1;
    }
    return true;
}

func Spec(text: char8[..]) -> FormatSpec {
    var spec = FormatSpec::Plain();
    spec = ParseFormatSpec(text) catch { else => Panic("the spec parses") };
    return spec;
}

// Each shape rendered into a buffer of its own and compared, so one case cannot read another's output.
func ShownOptional(value: &StringView?, spec: FormatSpec, expected: char8[..]) -> bool {
    var storage: char8[128];
    var writer = BufferWriter((@storage[0])[..128]);
    if Failed(WriteOptionalDebug<StringView>(writer, value, spec)) { return false; }
    return Same(writer.Written(), expected);
}

func ShownFallible(value: &(StringView ! StringView), spec: FormatSpec, expected: char8[..]) -> bool {
    var storage: char8[128];
    var writer = BufferWriter((@storage[0])[..128]);
    if Failed(WriteFallibleDebug<StringView, StringView>(writer, value, spec)) { return false; }
    return Same(writer.Written(), expected);
}

func ShownSlice(items: StringView[..], spec: FormatSpec, expected: char8[..]) -> bool {
    var storage: char8[128];
    var writer = BufferWriter((@storage[0])[..128]);
    if Failed(WriteSliceDebug<StringView>(writer, items, spec)) { return false; }
    return Same(writer.Written(), expected);
}

func Main() -> int {
    let plain = FormatSpec::Plain();
    let hello = StringView::FromValidated("hello");

    // An optional names its case and shows its payload the way the payload shows itself — quoted, here, because
    // that is what a string's Debug is.
    var some: StringView? = .Some(hello);
    var absent: StringView? = none;
    Assert(ShownOptional(some, plain, "Some(\"hello\")"), "a present optional names its case around its payload");
    Assert(ShownOptional(absent, plain, "none"), "and an absent one is the absence alone");

    // The empty payload is where a wrapper that wrote nothing would be indistinguishable from one that worked.
    var empty: StringView? = .Some(StringView::FromValidated(""));
    Assert(ShownOptional(empty, plain, "Some(\"\")"), "an empty payload is still visibly a payload");

    // A fallible names the channel a reader would branch on, on both sides.
    var success: StringView ! StringView = .Success(hello);
    var failure: StringView ! StringView = .Failure(StringView::FromValidated("nope"));
    Assert(ShownFallible(success, plain, "Success(\"hello\")"), "a fallible names its success channel");
    Assert(ShownFallible(failure, plain, "Failure(\"nope\")"), "and its failure channel");

    // A run of elements, including the two edges: none at all, and exactly one, which is where a separator written
    // one position out would show.
    var three: StringView[3] = [hello, StringView::FromValidated("a"), StringView::FromValidated("")];
    Assert(ShownSlice(three[..], plain, "[\"hello\", \"a\", \"\"]"), "a run is bracketed and comma-separated");
    Assert(ShownSlice(three[..1], plain, "[\"hello\"]"), "one element carries no separator");
    Assert(ShownSlice(three[..0], plain, "[]"), "and none at all is a visible pair of brackets");

    // The specification describes the elements. A precision counts characters of each element, not of the
    // rendering, so the brackets and the comma survive a precision that is shorter than either.
    Assert(ShownOptional(some, Spec(".2"), "Some(\"he\")"), "a precision truncates the payload");
    Assert(ShownSlice(three[..2], Spec(".1"), "[\"h\", \"a\"]"), "and each element of a run");

    // What reaches an element is the specification the caller passed, unchanged. The spy writes what it was handed,
    // so a wrapper that substituted a plain specification would be caught here and nowhere else.
    var watchers: Spy[2] = [Spy {}, Spy {}];
    var spyStorage: char8[64];
    var spyWriter = BufferWriter((@spyStorage[0])[..64]);
    let spySink: &var TextWriter = spyWriter;
    Assert(Succeeded(WriteSliceDebug<Spy>(spySink, watchers[..], Spec("7.3"))), "a run of spies is shown");
    Assert(Same(spyWriter.Written(), "[w7p3, w7p3]"), "and every element was handed the caller's own specification");

    // Showing a value does not take it. The tracked element is move-only and reports its own destruction, so this
    // is the property counted rather than assumed.
    var destroyed: int32 = 0;
    var held: Tracked? = .Some(Tracked { counter: @destroyed, tag: 7 });
    var storage: char8[128];
    var writer = BufferWriter((@storage[0])[..128]);
    Assert(Succeeded(WriteOptionalDebug<Tracked>(writer, held, plain)), "a move-only payload is shown");
    Assert(destroyed == 0i32, "and nothing was destroyed to show it");
    Assert(Succeeded(WriteOptionalDebug<Tracked>(writer, held, plain)), "so it can be shown again");
    Assert(destroyed == 0i32, "still destroying nothing");
    Assert(held is Tracked, "and the optional still holds its value");
    Assert(Same(writer.Written(), "Some(T(7))Some(T(7))"), "twice, identically");

    // The same for a run of them: every element is reached through a borrow.
    var elements: Tracked[3] = [Tracked { counter: @destroyed, tag: 0 }, Tracked { counter: @destroyed, tag: 12 },
                                Tracked { counter: @destroyed, tag: 345 }];
    var runStorage: char8[128];
    var runWriter = BufferWriter((@runStorage[0])[..128]);
    let runSink: &var TextWriter = runWriter;
    Assert(Succeeded(WriteSliceDebug<Tracked>(runSink, elements[..], plain)), "a move-only run is shown");
    Assert(Same(runWriter.Written(), "[T(0), T(12), T(345)]"), "in order, each through a borrow");
    Assert(destroyed == 0i32, "and not one of them was destroyed");

    // A refused write stops the rendering where it was refused. Eleven bytes holds `[T(0), T(12)` up to the point
    // the third element needs room, so what appears is the prefix that fit and nothing after it.
    var small: char8[11];
    var tight = BufferWriter((@small[0])[..11]);
    let tightSink: &var TextWriter = tight;
    let refused = WriteSliceDebug<Tracked>(tightSink, elements[..], plain);
    let overflowed = match refused {
        .Success(_) => false,
        .Failure(reason) => match reason { .InsufficientCapacity => true, else => false }
    };
    Assert(overflowed, "a destination without room reports it");
    Assert(tight.Length() <= 11u, "having written no more than it had");
    Assert(destroyed == 0i32, "and a failed rendering destroys nothing either");

    return 0;
}
