import Allocator::{ Allocator, SystemAllocator };
import Core::Assert;
import Text::{ IsAsciiSpace, StringView };

// Searching is over bytes, and works out to searching over characters for free: UTF-8 is self-synchronising, so no
// character's encoding is a suffix of another's and no byte of a multi-byte character can be mistaken for the start
// of one. A match on bytes therefore always lands on a character boundary. That is the claim worth testing, so the
// text below is mixed-width and the needles are characters that take more than one byte.
//
// Nothing here allocates: every answer is a position, a boolean, or a borrow of bytes that were already there.

func View(bytes: char8[..]) -> StringView {
    return StringView::FromBytes(bytes) ?? StringView();
}

func Main() -> int {
    let text = View("one,two,,three");
    let empty = View("");
    let comma = View(",");

    Assert(text.StartsWith(View("one")), "text starts with its first characters");
    Assert(text.StartsWith(empty), "and with the empty view");
    Assert(!text.StartsWith(View("two")), "and not with something further in");
    Assert(!text.StartsWith(View("one,two,,three,and more")), "nor with something longer than itself");
    Assert(text.EndsWith(View("three")), "text ends with its last characters");
    Assert(text.EndsWith(empty), "and with the empty view");
    Assert(!text.EndsWith(View("two")), "and not with something earlier");

    Assert(text.IndexOf(View("two")) == .Some(4), "a needle is found where it is");
    Assert(text.IndexOf(comma) == .Some(3), "the first occurrence is the one reported");
    Assert(text.LastIndexOf(comma) == .Some(8), "and the last one by the other search");
    Assert(text.IndexOf(View("four")) == none, "a needle that is not there is not found");
    Assert(text.IndexOf(empty) == .Some(0), "the empty needle is at the start");
    Assert(text.Contains(View("three")) && !text.Contains(View("thirty")), "containment agrees with the search");

    // A multi-byte needle, where a byte search that did not respect characters could match a fragment.
    let mixed = View("aé€b😀");
    Assert(mixed.IndexOf(View("é")) == .Some(1), "a two-byte character is found at its first byte");
    Assert(mixed.IndexOf(View("€")) == .Some(3), "and a three-byte one");
    Assert(mixed.IndexOf(View("😀")) == .Some(7), "and a four-byte one");
    Assert(mixed.Part(1, 3) is StringView, "and every position found is a character boundary");
    Assert(mixed.Part(3, 6) is StringView, "for the three-byte one too");

    // Trimming takes ASCII whitespace off either end and borrows what is left.
    Assert(IsAsciiSpace(c8' ') && IsAsciiSpace(c8'\t') && IsAsciiSpace(c8'\n'), "the usual whitespace counts");
    Assert(!IsAsciiSpace(c8'x'), "and a letter does not");
    let padded = View("  hi \t ");
    Assert(padded.Trim().Length() == 2, "trimming takes the whitespace off both ends");
    Assert(padded.TrimStart().Length() == 5, "the front alone");
    Assert(padded.TrimEnd().Length() == 4, "and the back alone");
    Assert(View("   ").Trim().IsEmpty(), "text that is all whitespace trims to nothing");
    Assert(View("hi").Trim().Length() == 2, "and text with none is unchanged");

    // Splitting: the parts always number one more than the separators.
    var walker = text.Split(comma);
    var parts: uint = 0;
    var totalBytes: uint = 0;
    var walking = true;
    while walking {
        match walker.Next() {
            part? => {
                totalBytes = totalBytes + part.Length();
                parts = parts + 1;
            },
            none => {
                walking = false;
            }
        }
    }
    Assert(parts == 4, "three separators make four parts, counting the empty one between two of them");
    Assert(totalBytes == text.Length() - 3, "and the parts hold every byte that is not a separator");

    var single = View("nothing to split").Split(comma);
    Assert((single.Next() ?? empty).Length() == 16, "text without the separator is one whole part");
    Assert(!(single.Next() is StringView), "and there is nothing after it");

    var degenerate = View("abc").Split(empty);
    Assert((degenerate.Next() ?? empty).Length() == 3, "an empty separator gives the whole thing once");
    Assert(!(degenerate.Next() is StringView), "rather than an endless walk");

    return 0;
}
