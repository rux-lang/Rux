import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Text::{ String, StringBuilder, StringView, TextError };

// A builder exists so that assembling text is linear rather than quadratic, and so that the block it fills can be
// handed over at the end instead of copied. Both are ownership questions, so that is what is checked: what happens
// to the block when the builder is done with it, and whether the builder is still usable afterwards.
// The other half is the invariant. A builder holds well-formed UTF-8 at every moment, not only at the end, which is
// what lets `View` cost nothing and `IntoString` skip validation. It is kept by refusing anything that is not a
// whole character rather than by checking afterwards.

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    var builder = StringBuilder(allocator);
    Assert(builder.IsEmpty() && builder.Length() == 0, "a new builder holds nothing");
    Assert(builder.Capacity() == 0, "and has taken no room");

    try builder.AppendAscii(c8'h') catch { _ => Panic("an ASCII byte is appended") };
    try builder.AppendAscii(c8'i') catch { _ => Panic("and another") };
    Assert(builder.Length() == 2, "the builder holds both");
    Assert(builder.Capacity() >= 2, "with room for them");
    let firstCapacity = builder.Capacity();

    try builder.AppendScalar(0xE9u32 as char32) catch { _ => Panic("a two-byte character is appended") };
    Assert(builder.Length() == 4, "taking two bytes");
    try builder.AppendScalar(0x1F600u32 as char32) catch { _ => Panic("and a four-byte one") };
    Assert(builder.Length() == 8, "taking four");
    Assert(builder.View().ScalarCount() == 4, "so four characters sit in eight bytes");

    // What is not a whole character is refused, which is what keeps the invariant.
    try {
        builder.AppendAscii(0xC3u8 as char8);
        Panic("the operation was expected to fail");
    } catch {
        refusal => Assert(refusal == TextError::InvalidUtf8, "a lone byte above ASCII is refused"),
    }
    // Reinterpret raw storage to test the builder's rejection independently of checked character casts.
    var surrogate: uint32 = 0xD000;
    surrogate = surrogate + 0x0800;
    // Safety: `surrogate` is a live local `uint32`, and `char32` has the same size and alignment.
    let surrogateScalar = unsafe { *((@surrogate) as *char32) };
    try {
        builder.AppendScalar(surrogateScalar);
        Panic("the operation was expected to fail");
    } catch {
        refusal => Assert(refusal == TextError::InvalidUtf8, "and a surrogate half"),
    }
    var broken: char8[2];
    broken[0] = 0xE2u8 as char8;
    broken[1] = 0x82u8 as char8;
    try {
        builder.AppendBytes(broken[0..2]);
        Panic("the operation was expected to fail");
    } catch {
        refusal => Assert(refusal == TextError::InvalidUtf8, "and a sequence that runs out"),
    }
    Assert(builder.Length() == 8, "and none of them changed what the builder holds");

    // Growth is by doubling, so a run of appends does not reallocate on every one.
    var index: uint = 0;
    while index < 200 {
        try builder.AppendAscii(c8'x') catch { _ => Panic("there is room for every byte") };
        index = index + 1;
    }
    Assert(builder.Length() == 208, "the builder holds everything appended");
    Assert(builder.Capacity() > firstCapacity, "having taken more room to do it");

    // A full builder doubles its room rather than taking only what the append needs.
    var doubling = StringBuilder(allocator);
    doubling.Append("0123456789abcdef");
    Assert(doubling.Capacity() == 16, "filling the first block exactly");
    doubling.Append("xyz");
    Assert(doubling.Capacity() == 32, "the next append doubles the room");

    // Clearing keeps the room, which is what makes a builder used in a loop allocate once.
    let kept = builder.Capacity();
    builder.Clear();
    Assert(builder.IsEmpty() && builder.Capacity() == kept, "clearing forgets the bytes and keeps the room");

    builder.Append("hello");
    let copied = builder.ToString();
    Assert(copied.Length() == 5, "a copy of what it holds is made");
    Assert(builder.Length() == 5, "leaving the builder as it was");

    // Handing the block over: no copy, and the builder is left owning nothing.
    let handedFrom = builder.Bytes().data;
    let taken = builder.IntoString();
    Assert(taken.Length() == 5, "the string holds what the builder held");
    Assert(taken.Bytes().data == handedFrom, "in the very block the builder had, uncopied");
    Assert(builder.IsEmpty() && builder.Capacity() == 0, "and the builder owns nothing afterwards");

    builder.Append("again");
    Assert(builder.Length() == 5, "and holds what it is given");

    // Room asked for up front is room the appends do not have to find.
    var sized = StringBuilder::WithCapacity(allocator, 64);
    Assert(sized.Capacity() >= 64, "a builder can be sized up front");
    let sizedCapacity = sized.Capacity();
    index = 0;
    while index < 64 {
        try sized.AppendAscii(c8'y') catch { _ => Panic("the sized builder takes every byte") };
        index = index + 1;
    }
    Assert(sized.Capacity() == sizedCapacity, "and filling it exactly needs no more room");

    return 0;
}
