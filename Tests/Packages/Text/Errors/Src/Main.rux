import Allocator::AllocError;
import Core::Assert;
import Memory::PageError;
import Text::{ BufferWriter, Debug, Display, FormatError, FormatSpec, ParseFormatSpec, TextError, TextFailureKind,
               TextWriter, Utf8Error };

// What a program says when something goes wrong, in the two registers it has to say it in.
//
// `Display` is the description a reader sees, short enough to sit inside a sentence the program is already writing.
// `Debug` names the case and its payload, which is what a log is read for. Every case of every presented error is
// checked here rather than a representative sample, because the value of a stable description is that all of them
// are stable: one case nobody exercised is the one that renders as nothing.
//
// The two are checked to differ where they should and to agree where they must. `FormatError::TextFailure` and the
// `TextError` naming the same failure describe it with the same words, since a caller cannot be told "invalid
// UTF-8" by one and something else by the other. And the position an `InvalidSpecification` carries appears in
// `Debug` and not in `Display`, which is the whole of the split.

func Same(actual: char8[..], expected: char8[..]) -> bool {
    if actual.length != expected.length { return false; }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] { return false; }
        index = index + 1;
    }
    return true;
}

func Spec(text: char8[..]) -> FormatSpec {
    var spec = FormatSpec::Plain();
    Assert(ParseFormatSpec(text).TryIntoValue(@spec), "the spec parses");
    return spec;
}

// Whether `value` renders as exactly `expected` through `Display`.
func Shown(value: Display, expected: char8[..]) -> bool {
    var storage: char8[128];
    var writer = BufferWriter((@storage[0])[..128]);
    if value.WriteDisplay(writer, FormatSpec::Plain()).IsError() { return false; }
    return Same(writer.Written(), expected);
}

func Inspected(value: Debug, expected: char8[..]) -> bool {
    var storage: char8[128];
    var writer = BufferWriter((@storage[0])[..128]);
    if value.WriteDebug(writer, FormatSpec::Plain()).IsError() { return false; }
    return Same(writer.Written(), expected);
}

// Whether the specification is refused by both renderings rather than applied or ignored.
func Refused(shown: Display, inspected: Debug, spec: FormatSpec) -> bool {
    var storage: char8[128];
    var writer = BufferWriter((@storage[0])[..128]);
    if !shown.WriteDisplay(writer, spec).IsError() { return false; }
    var second = BufferWriter((@storage[0])[..128]);
    let other: &var TextWriter = second;
    return inspected.WriteDebug(other, spec).IsError();
}

func Main() -> int {
    // TextError: every case, in both registers. The success case renders as success rather than as nothing, since
    // a value that says "no error" is more useful in a log than an empty space.
    let none: Display = TextError::None;
    Assert(Shown(none, "no error"), "the success case says so");
    let noneDebug: Debug = TextError::None;
    Assert(Inspected(noneDebug, "TextError::None"), "and names itself");
    let outOfMemory: Display = TextError::OutOfMemory;
    Assert(Shown(outOfMemory, "out of memory"), "an allocation failure");
    let outOfMemoryDebug: Debug = TextError::OutOfMemory;
    Assert(Inspected(outOfMemoryDebug, "TextError::OutOfMemory"), "named");
    let overflow: Display = TextError::LengthOverflow;
    Assert(Shown(overflow, "length overflow"), "a length that does not fit");
    let overflowDebug: Debug = TextError::LengthOverflow;
    Assert(Inspected(overflowDebug, "TextError::LengthOverflow"), "named");
    let badUtf8: Display = TextError::InvalidUtf8;
    Assert(Shown(badUtf8, "invalid UTF-8"), "bytes that are not text");
    let badUtf8Debug: Debug = TextError::InvalidUtf8;
    Assert(Inspected(badUtf8Debug, "TextError::InvalidUtf8"), "named");
    let boundary: Display = TextError::NotABoundary;
    Assert(Shown(boundary, "not a character boundary"), "an offset text may not be cut at");
    let boundaryDebug: Debug = TextError::NotABoundary;
    Assert(Inspected(boundaryDebug, "TextError::NotABoundary"), "named");

    // TextFailureKind describes the same four failures, and must describe them with the same words.
    let kindMemory: Display = TextFailureKind::OutOfMemory;
    Assert(Shown(kindMemory, "out of memory"), "the failure-only kind agrees with the status enum");
    let kindUtf8: Display = TextFailureKind::InvalidUtf8;
    Assert(Shown(kindUtf8, "invalid UTF-8"), "on every case they share");
    let kindOverflow: Display = TextFailureKind::LengthOverflow;
    Assert(Shown(kindOverflow, "length overflow"), "including this one");
    let kindBoundary: Display = TextFailureKind::NotABoundary;
    Assert(Shown(kindBoundary, "not a character boundary"), "and this one");
    let kindUtf8Debug: Debug = TextFailureKind::InvalidUtf8;
    Assert(Inspected(kindUtf8Debug, "TextFailureKind::InvalidUtf8"), "while Debug says which type it came from");

    // FormatError: the description says what happened, and Debug adds the payload that says where.
    let malformed: Display = FormatError::InvalidSpecification(12);
    Assert(Shown(malformed, "malformed format specification"), "a bad specification describes itself");
    let malformedDebug: Debug = FormatError::InvalidSpecification(12);
    Assert(Inspected(malformedDebug, "FormatError::InvalidSpecification(12)"), "and Debug carries the offset");
    let atStart: Debug = FormatError::InvalidSpecification(0);
    Assert(Inspected(atStart, "FormatError::InvalidSpecification(0)"), "including an offset of zero");
    let unsupported: Display = FormatError::UnsupportedRequest;
    Assert(Shown(unsupported, "unsupported formatting request"), "a request the value cannot answer");
    let unsupportedDebug: Debug = FormatError::UnsupportedRequest;
    Assert(Inspected(unsupportedDebug, "FormatError::UnsupportedRequest"), "named");
    let mismatch: Display = FormatError::ArgumentCountMismatch(2, 3);
    Assert(Shown(mismatch, "argument count does not match the pattern"), "a pattern and its arguments disagreeing");
    let mismatchDebug: Debug = FormatError::ArgumentCountMismatch(2, 3);
    Assert(Inspected(mismatchDebug, "FormatError::ArgumentCountMismatch(2, 3)"), "with both counts, expected first");
    let capacity: Display = FormatError::InsufficientCapacity;
    Assert(Shown(capacity, "insufficient capacity"), "a destination too small");
    let capacityDebug: Debug = FormatError::InsufficientCapacity;
    Assert(Inspected(capacityDebug, "FormatError::InsufficientCapacity"), "named");
    let outOfRange: Display = FormatError::ValueOutOfRange;
    Assert(Shown(outOfRange, "value out of range for the form requested"), "a value the form cannot express");
    let outOfRangeDebug: Debug = FormatError::ValueOutOfRange;
    Assert(Inspected(outOfRangeDebug, "FormatError::ValueOutOfRange"), "named");
    let writerFailure: Display = FormatError::WriterFailure;
    Assert(Shown(writerFailure, "the destination failed"), "the destination failing on its own terms");
    let writerFailureDebug: Debug = FormatError::WriterFailure;
    Assert(Inspected(writerFailureDebug, "FormatError::WriterFailure"), "named");

    // A wrapped text failure describes itself exactly as the failure it wraps, and nests its name under Debug.
    let wrapped: Display = FormatError::TextFailure(TextFailureKind::InvalidUtf8);
    Assert(Shown(wrapped, "invalid UTF-8"), "a wrapped failure describes itself, not its wrapper");
    let wrappedDebug: Debug = FormatError::TextFailure(TextFailureKind::InvalidUtf8);
    Assert(Inspected(wrappedDebug, "FormatError::TextFailure(TextFailureKind::InvalidUtf8)"),
           "while Debug shows both names");
    let wrappedMemory: Display = FormatError::TextFailure(TextFailureKind::OutOfMemory);
    Assert(Shown(wrappedMemory, "out of memory"), "which holds for every kind it can wrap");

    // Utf8Error, whose success case is the well-formed one rather than an absence.
    let wellFormed: Display = Utf8Error::None;
    Assert(Shown(wellFormed, "well-formed UTF-8"), "the success case names what it found, not what it did not");
    let wellFormedDebug: Debug = Utf8Error::None;
    Assert(Inspected(wellFormedDebug, "Utf8Error::None"), "named");
    let truncated: Display = Utf8Error::Truncated;
    Assert(Shown(truncated, "truncated UTF-8 sequence"), "a sequence the bytes ran out of");
    let truncatedDebug: Debug = Utf8Error::Truncated;
    Assert(Inspected(truncatedDebug, "Utf8Error::Truncated"), "named");
    let badStart: Display = Utf8Error::InvalidStart;
    Assert(Shown(badStart, "invalid UTF-8 start byte"), "a byte that cannot open a sequence");
    let badStartDebug: Debug = Utf8Error::InvalidStart;
    Assert(Inspected(badStartDebug, "Utf8Error::InvalidStart"), "named");
    let badContinuation: Display = Utf8Error::InvalidContinuation;
    Assert(Shown(badContinuation, "invalid UTF-8 continuation byte"), "and one that cannot continue it");
    let badContinuationDebug: Debug = Utf8Error::InvalidContinuation;
    Assert(Inspected(badContinuationDebug, "Utf8Error::InvalidContinuation"), "named");

    // AllocError, presented here because the protocols live here and Allocator does not depend on this package.
    // The allocator's own distinctions survive: a layout it can never serve is not a shortage.
    let allocNone: Display = AllocError::None;
    Assert(Shown(allocNone, "no error"), "an allocation that happened");
    let allocNoneDebug: Debug = AllocError::None;
    Assert(Inspected(allocNoneDebug, "AllocError::None"), "named");
    let allocUnsupported: Display = AllocError::Unsupported;
    Assert(Shown(allocUnsupported, "layout this allocator cannot serve"), "a request retrying will never satisfy");
    let allocUnsupportedDebug: Debug = AllocError::Unsupported;
    Assert(Inspected(allocUnsupportedDebug, "AllocError::Unsupported"), "named");
    let allocMemory: Display = AllocError::OutOfMemory;
    Assert(Shown(allocMemory, "out of memory"), "and one that a smaller one might");
    let allocMemoryDebug: Debug = AllocError::OutOfMemory;
    Assert(Inspected(allocMemoryDebug, "AllocError::OutOfMemory"), "named");
    let allocBlock: Display = AllocError::InvalidBlock;
    Assert(Shown(allocBlock, "block this allocator did not hand out"), "a caller's mistake rather than a shortage");
    let allocBlockDebug: Debug = AllocError::InvalidBlock;
    Assert(Inspected(allocBlockDebug, "AllocError::InvalidBlock"), "named");

    // PageError, the other low-level type this package already depends on.
    let pageNone: Display = PageError::None;
    Assert(Shown(pageNone, "no error"), "a page operation that happened");
    let pageLength: Display = PageError::InvalidLength;
    Assert(Shown(pageLength, "invalid length"), "a length of zero or past the address space");
    let pageAddress: Display = PageError::InvalidAddress;
    Assert(Shown(pageAddress, "invalid address"), "an address that is not a page this process owns");
    let pageMemory: Display = PageError::OutOfMemory;
    Assert(Shown(pageMemory, "out of memory"), "no storage to back the request");
    let pagePermission: Display = PageError::PermissionDenied;
    Assert(Shown(pagePermission, "permission denied"), "a protection the system refused");
    let pageUnsupported: Display = PageError::Unsupported;
    Assert(Shown(pageUnsupported, "unsupported on this system"), "a combination this system does not offer");
    let pageFailed: Display = PageError::Failed;
    Assert(Shown(pageFailed, "the system reported an unnamed failure"), "and the case with no name of its own");
    let pagePermissionDebug: Debug = PageError::PermissionDenied;
    Assert(Inspected(pagePermissionDebug, "PageError::PermissionDenied"), "each named under Debug");
    let pageFailedDebug: Debug = PageError::Failed;
    Assert(Inspected(pageFailedDebug, "PageError::Failed"), "including the unnamed one");

    // Neither rendering answers to a style or a precision. A precision is worth refusing rather than applying: a
    // description cut in half is a sentence that says something else.
    let refusedShown: Display = TextError::InvalidUtf8;
    let refusedDebug: Debug = TextError::InvalidUtf8;
    Assert(Refused(refusedShown, refusedDebug, Spec(".4")),
           "a precision is refused rather than truncating a description");
    Assert(Refused(refusedShown, refusedDebug, Spec("short")), "and so is a style, invented");
    Assert(Refused(refusedShown, refusedDebug, Spec("rfc3339")), "or borrowed from another domain");
    let formatShown: Display = FormatError::WriterFailure;
    let formatDebug: Debug = FormatError::WriterFailure;
    Assert(Refused(formatShown, formatDebug, Spec(".0")), "which holds for the failure-only type as well");

    return 0;
}
