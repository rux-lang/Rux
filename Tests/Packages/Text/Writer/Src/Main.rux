import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Result, Unit };
import Text::{ BufferWriter, FormatError, FormatOk, String, StringBuilder, TextFailureKind, TextWriter, WriteAscii,
               WriteBytes, WriteScalar };

// What a `TextWriter` promises, checked at the promises rather than at one happy path.
//
// Three of them matter and none is observable from a successful write. A full write reports success and nothing
// else — not a count, not a partial. A writer may report only `InsufficientCapacity`, `TextFailure` or
// `WriterFailure`, so the failures belonging to the parser, the placeholder engine and the value cannot arrive from
// a destination. And a writer that promises to leave itself unchanged on a failed write must actually do so, which
// is only visible by failing one and looking at what is there afterwards.
//
// `BufferWriter` and `StringBuilder` are the two first-party writers reachable from here, and they differ in what
// they can refuse: a fixed buffer runs out of room, a builder runs out of memory. Both validate, so both can refuse
// bytes that are not text.

// Which failure a result carries, as a small code, so a check names the reason it expects rather than only that
// something failed: 0 success, 1 InsufficientCapacity, 2 TextFailure(InvalidUtf8), 3 some other TextFailure,
// 4 WriterFailure, 5 a category no writer may produce.
func FailureCode(outcome: Result<Unit, FormatError>) -> int {
    return match outcome {
        .Success(_) => 0,
        .Error(reason) => match reason {
            .InsufficientCapacity => 1,
            .TextFailure(kind) => match kind {
                .InvalidUtf8 => 2,
                else => 3
            },
            .WriterFailure => 4,
            else => 5
        }
    };
}

func Same(actual: char8[..], expected: char8[..]) -> bool {
    if actual.length != expected.length { return false; }
    var index: uint = 0;
    while index < actual.length {
        if actual.data[index] != expected.data[index] { return false; }
        index = index + 1;
    }
    return true;
}

func Main() -> int {
    var storage: char8[16];
    var writer = BufferWriter((@storage[0])[..16]);

    // A full write reports success and nothing more.
    Assert(FailureCode(writer.Write("abc")) == 0, "a write that fits succeeds");
    Assert(writer.Length() == 3u, "and its bytes landed");
    Assert(Same(writer.Written(), "abc"), "in order");
    Assert(writer.Remaining() == 13u, "leaving the rest of the room");

    // Writes concatenate.
    Assert(FailureCode(writer.Write("de")) == 0, "a second write succeeds");
    Assert(Same(writer.Written(), "abcde"), "and appends rather than replaces");

    // A run that does not fit is refused whole. This is the promise worth checking: after the refusal the buffer is
    // exactly what it was, so nothing partial has to be undone.
    Assert(FailureCode(writer.Write("0123456789ab")) == 1, "a run past the end reports InsufficientCapacity");
    Assert(writer.Length() == 5u, "and the buffer is unchanged");
    Assert(Same(writer.Written(), "abcde"), "with no prefix of the refused run left behind");

    // A run that fits exactly is not a run that does not fit.
    Assert(writer.Remaining() == 11u, "eleven bytes remain");
    Assert(FailureCode(writer.Write("01234567890")) == 0, "a run filling the room exactly succeeds");
    Assert(writer.Remaining() == 0u, "leaving none");
    Assert(Same(writer.Written(), "abcde01234567890"), "and the whole run landed");

    // A full buffer refuses more, and still accepts nothing.
    Assert(FailureCode(writer.Write("x")) == 1, "a full buffer refuses one more byte");
    Assert(writer.Length() == 16u, "and stays full rather than growing");
    // An empty write is not a write past the end, even at capacity.
    Assert(FailureCode(writer.Write("")) == 0, "an empty run succeeds even with no room");

    // Clearing keeps the room and drops the text.
    writer.Clear();
    Assert(writer.Length() == 0u && writer.Remaining() == 16u, "clearing returns the whole room");
    Assert(Same(writer.Written(), ""), "and reports no text");

    // Bytes that are not UTF-8 are refused, and refused whole. 0xC3 opens a two-byte sequence that never arrives.
    var invalid: char8[2];
    invalid[0] = 0xC3u8 as char8;
    invalid[1] = 0x28u8 as char8;
    Assert(FailureCode(writer.Write((@invalid[0])[..2])) == 2, "invalid UTF-8 reports TextFailure(InvalidUtf8)");
    Assert(writer.Length() == 0u, "and nothing landed");

    // A lone continuation byte, and a truncated sequence, are refused the same way.
    var lone: char8[1];
    lone[0] = 0x80u8 as char8;
    Assert(FailureCode(writer.Write((@lone[0])[..1])) == 2, "a lone continuation byte is not text");
    var truncated: char8[1];
    truncated[0] = 0xE2u8 as char8;
    Assert(FailureCode(writer.Write((@truncated[0])[..1])) == 2, "nor is a sequence that runs out");
    Assert(writer.Length() == 0u, "and neither left anything behind");

    // Multi-byte text is text, and its bytes are not split.
    Assert(FailureCode(writer.Write("héllo")) == 0, "a multi-byte run succeeds");
    Assert(writer.Length() == 6u, "occupying six bytes for five characters");

    // Capacity is decided before validity, so a run that is both too long and invalid reports the former: reading a
    // run that cannot land is work with no answer to give.
    writer.Clear();
    var long: char8[20];
    var fill: uint = 0;
    while fill < 20u {
        long[fill] = 0x80u8 as char8;
        fill = fill + 1u;
    }
    Assert(FailureCode(writer.Write((@long[0])[..20])) == 1, "too long and invalid reports the capacity failure");

    // The shared helpers reach a writer through the same contract.
    writer.Clear();
    Assert(FailureCode(WriteBytes(writer, "raw")) == 0, "WriteBytes forwards to the writer");
    Assert(FailureCode(WriteAscii(writer, c8'!')) == 0, "WriteAscii writes one byte");
    Assert(FailureCode(WriteScalar(writer, 0x20ACu32 as char32)) == 0, "WriteScalar encodes and writes");
    Assert(Same(writer.Written(), "raw!\u{20AC}"), "and all three landed in order");

    // WriteAscii refuses a byte that is not a whole character rather than writing half of one.
    Assert(FailureCode(WriteAscii(writer, 0xC3u8 as char8)) == 2, "a byte above 0x7F is not one ASCII character");

    // WriteScalar refuses a value that is not a scalar value. A surrogate half encodes nothing on its own, and the
    // compiler refuses to fold one into a char32 at all, so the value has to arrive at run time to be tested here.
    var half: uint32 = 0xD800u32;
    Assert(FailureCode(WriteScalar(writer, half as char32)) == 2, "a surrogate half is not a scalar value");

    // A helper's failure propagates the writer's own failure unchanged rather than replacing it.
    var tiny: char8[2];
    var small = BufferWriter((@tiny[0])[..2]);
    Assert(FailureCode(WriteScalar(small, 0x20ACu32 as char32)) == 1,
           "a three-byte character into two bytes is a capacity failure, not an encoding one");
    Assert(small.Length() == 0u, "and the buffer is untouched");

    // StringBuilder is the growing writer, so it refuses neither of the above; what it can refuse is allocation,
    // which cannot be provoked here. What is checked is that it accepts and concatenates through the same contract.
    var system = SystemAllocator();
    let allocator: Allocator = system;
    var builder = StringBuilder(allocator);
    Assert(FailureCode(builder.Write("grows")) == 0, "a builder accepts a write");
    Assert(FailureCode(WriteBytes(builder, " and grows")) == 0, "and another through the helper");
    Assert(builder.Length() == 15u, "concatenating both");

    // It validates too: a builder that accepted these would stop holding text.
    Assert(FailureCode(builder.Write((@invalid[0])[..2])) == 2, "a builder refuses bytes that are not text");
    Assert(builder.Length() == 15u, "and is unchanged by the refusal");

    return 0;
}
