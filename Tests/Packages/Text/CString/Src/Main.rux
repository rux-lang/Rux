import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Failed, Panic, Succeeded };
import Text::{ CString, StringView, TextError };

// A C string is a pointer and a promise, and both edges of the boundary need a check nothing else needs. Going out,
// text holding a zero byte is refused rather than truncated — truncation is how a name that passed a filter and
// the name C uses part company. Coming in, the terminator says how far to read, a limit says how far to look for
// it, and the bytes are validated because nothing about C promises text.

/// Why an operation the test expects to fail failed. One that succeeds instead panics, so an expected failure
/// cannot pass by accident.
func Refusal<T, E>(outcome: T ! E) -> E {
    return match <-outcome {
        .Failure(error) => error,
        .Success(_) => Panic("the operation was expected to fail")
    };
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // Out: ordinary text picks up its terminator, invisible from the Rux side.
    let text = StringView::FromValidated("hello");
    let kept = CString::FromView(allocator, text) catch { else => Panic("ordinary text crosses the boundary") };
    Assert(kept.Length() == 5, "the length counts the text alone");
    Assert((kept.Raw()[5] as uint32) == 0, "with the terminator sitting just past it");
    Assert((kept.Raw()[0] as uint32) == 0x68, "and the text itself unmoved");
    let roundTrip = kept.View();
    Assert(roundTrip.Equals(text), "the view reads back without the terminator");

    // Empty text is one byte of terminator, not a null pointer.
    Assert(Succeeded(CString::FromView(allocator, StringView())), "empty text crosses too");

    // A zero byte in the middle is refused, not truncated.
    var smuggled: char8[8];
    smuggled[0] = c8's';
    smuggled[1] = c8'a';
    smuggled[2] = c8'f';
    smuggled[3] = c8'e';
    smuggled[4] = 0u8 as char8;
    smuggled[5] = c8'e';
    smuggled[6] = c8'x';
    smuggled[7] = c8'e';
    let hidden = StringView::FromBytes(smuggled[0..8]) ?? StringView();
    Assert(hidden.Length() == 8, "a zero byte is valid UTF-8 and makes a view");
    Assert(Refusal(CString::FromView(allocator, hidden)) == TextError::InvalidUtf8,
        "but it does not cross the boundary, and the refusal says why");

    // In: reading back from a raw pointer, to the terminator and no further.
    let arrived = CString::FromRaw(allocator, kept.Raw(), 64)
        catch { else => Panic("C text with a terminator in reach comes in") };
    Assert(arrived.Length() == 5, "read to the terminator and no further");

    // A terminator out of reach is a broken promise, and costs the limit rather than a walk off the map.
    var unterminated: char8[4];
    unterminated[0] = c8'a';
    unterminated[1] = c8'b';
    unterminated[2] = c8'c';
    unterminated[3] = c8'd';
    Assert(Refusal(CString::FromRaw(allocator, @unterminated[0], 4)) == TextError::InvalidUtf8,
        "no terminator within the limit is refused");

    // Bytes from C that are not text are input, and input is validated.
    var mangled: char8[4];
    mangled[0] = 0xEDu8 as char8;
    mangled[1] = 0xA0u8 as char8;
    mangled[2] = 0x80u8 as char8;
    mangled[3] = 0u8 as char8;
    Assert(Refusal(CString::FromRaw(allocator, @mangled[0], 8)) == TextError::InvalidUtf8,
        "a surrogate half from C is refused");

    // Text crosses the boundary the same way a view does, since a view is what it becomes.
    let crossed = CString::FromText(allocator, "crossing") catch { else => Panic("text makes a C string") };
    Assert(crossed.Length() == 8, "spanning what it was given");
    Assert((crossed.Raw()[8] as uint32) == 0, "with the terminator sitting just past it");

    // Null is C's nothing, and nothing is not text.
    Assert(Failed(CString::FromRaw(allocator, null, 8)), "and a null pointer makes nothing");

    return 0;
}
