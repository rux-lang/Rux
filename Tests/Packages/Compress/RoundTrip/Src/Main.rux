const FixedStream: byte[16] = [0x78u8, 0x01u8, 0xCBu8, 0x48u8, 0xCDu8, 0xC9u8, 0xC9u8, 0x57u8, 0xC8u8, 0x40u8, 0x90u8, 0x00u8, 0x3Au8, 0x2Eu8, 0x06u8, 0x7Du8];

// Text as the bytes it is made of.
func AsBytes(text: char8[..]) -> byte[..] {
    return (text.data as *byte)[..text.length];
}

// The text the reference streams were made from.
func Fox() -> Vector<byte> {
    var text = Vector<byte>(SystemAllocator());
    let sentence = "The quick brown fox jumps over the lazy dog. ";
    var round: uint = 0;
    while round < 20u {
        text.PushSlice(AsBytes(sentence)) catch { else => {} };
        round = round + 1;
    }
    var value: uint = 0;
    while value < 256u {
        text.Push(value as byte) catch { else => {} };
        value = value + 1;
    }
    text.PushSlice(AsBytes("end")) catch { else => {} };
    return <-text;
}

func SameBytes(left: byte[..], right: byte[..]) -> bool {
    if left.length != right.length { return false; }
    var index: uint = 0;
    while index < left.length {
        if left[index] != right[index] { return false; }
        index = index + 1;
    }
    return true;
}

// Decompresses a reference stream and checks it is the fox text.
func DecodesToFox(stream: byte[..], format: Format) -> bool {
    let fox = Fox();
    match Decompress(SystemAllocator(), stream, format) {
        .Success(data) => return SameBytes(data.AsSlice(), fox.AsSlice()),
        .Failure(_) => return false
    }
}

// Compresses and decompresses `data`, and checks it comes back whole; returns the compressed size, or zero on failure.
func RoundTrip(data: byte[..], format: Format, level: Level) -> uint {
    let packed = Compress(SystemAllocator(), data, format, level) catch { else => return 0 };
    let unpacked = Decompress(SystemAllocator(), packed.AsSlice(), format) catch { else => return 0 };
    if !SameBytes(unpacked.AsSlice(), data) { return 0; }
    return packed.Length();
}

// Bytes from a small linear congruential generator: hard to compress.
func Noise(count: uint) -> Vector<byte> {
    var bytes = Vector<byte>(SystemAllocator());
    var state: uint32 = 12345;
    var index: uint = 0;
    while index < count {
        state = state * 1103515245u32 + 12345u32;
        bytes.Push((state >> 16) as byte) catch { else => {} };
        index = index + 1;
    }
    return <-bytes;
}

// Text with repeats far apart and close together, longer than the window and than one block.
func Prose(count: uint) -> Vector<byte> {
    var bytes = Vector<byte>(SystemAllocator());
    let words: char8[..] = "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu ";
    var index: uint = 0;
    var state: uint32 = 7;
    while index < count {
        state = state * 1664525u32 + 1013904223u32;
        let start = ((state >> 8) % 60u32) as uint;
        bytes.Push(words[start] as byte) catch { else => {} };
        if index % 1000u < 500u { bytes.Push(words[index % words.length] as byte) catch { else => {} }; }
        index = index + 1;
    }
    return <-bytes;
}

func Main() -> int {
    // zlib's own streams: dynamic codes, a raw stream, a gzip member with a file name, and fixed codes.
    Assert(DecodesToFox(ZlibStream[..], Format::Zlib), "a zlib stream decodes");
    Assert(DecodesToFox(RawStream[..], Format::Raw), "a raw Deflate stream decodes");
    Assert(DecodesToFox(GzipStream[..], Format::Gzip), "a gzip member decodes");
    let hello = Decompress(SystemAllocator(), FixedStream[..], Format::Zlib) catch { else => return 10 };
    Assert(SameBytes(hello.AsSlice(), AsBytes("hello hello hello")), "fixed codes decode");

    // Every format and level round-trips data of every shape.
    let fox = Fox();
    let noise = Noise(70000);
    let prose = Prose(300000);
    let empty = AsBytes("");
    let formats: Format[3] = [Format::Raw, Format::Zlib, Format::Gzip];
    let levels: Level[4] = [Level::Store, Level::Fastest, Level::Default, Level::Best];
    var f: uint = 0;
    while f < 3u {
        var l: uint = 0;
        while l < 4u {
            Assert(RoundTrip(empty, formats[f], levels[l]) != 0u, "empty data round-trips");
            Assert(RoundTrip(fox.AsSlice(), formats[f], levels[l]) != 0u, "text round-trips");
            Assert(RoundTrip(noise.AsSlice(), formats[f], levels[l]) != 0u, "noise round-trips");
            Assert(RoundTrip(prose.AsSlice(), formats[f], levels[l]) != 0u, "long text round-trips");
            l = l + 1;
        }
        f = f + 1;
    }

    // Compression pays: repeated text shrinks, noise barely grows, and higher levels are no larger.
    var repeated = Vector<byte>(SystemAllocator());
    var copy: uint = 0;
    while copy < 200u {
        repeated.PushSlice(fox.AsSlice()) catch { else => return 13 };
        copy = copy + 1;
    }
    let stored = RoundTrip(repeated.AsSlice(), Format::Raw, Level::Store);
    let fastest = RoundTrip(repeated.AsSlice(), Format::Raw, Level::Fastest);
    let best = RoundTrip(repeated.AsSlice(), Format::Raw, Level::Best);
    Assert(stored > repeated.Length() && fastest != 0u && fastest < repeated.Length() / 20u, "repeated text compresses");
    Assert(best <= fastest, "the best level is no larger than the fastest");
    let proseFastest = RoundTrip(prose.AsSlice(), Format::Raw, Level::Fastest);
    let proseBest = RoundTrip(prose.AsSlice(), Format::Raw, Level::Best);
    Assert(proseBest <= proseFastest && proseFastest < prose.Length(), "varied text compresses too");
    Assert(RoundTrip(noise.AsSlice(), Format::Raw, Level::Default) < noise.Length() + noise.Length() / 100u,
           "noise is stored rather than inflated");

    // Damage and truncation are caught.
    let packed = Compress(SystemAllocator(), fox.AsSlice(), Format::Gzip) catch { else => return 11 };
    var damaged = Vector<byte>(SystemAllocator());
    damaged.PushSlice(packed.AsSlice()) catch { else => return 12 };
    damaged.AsMutableSlice()[damaged.Length() - 6u] = damaged.AsSlice()[damaged.Length() - 6u] ^ 0x01u8;
    match Decompress(SystemAllocator(), damaged.AsSlice(), Format::Gzip) {
        .Success(_) => Assert(false, "a damaged checksum is caught"),
        .Failure(error) => Assert(error.kind == IoErrorKind::InvalidInput, "a damaged checksum is invalid input")
    }
    match Decompress(SystemAllocator(), packed.AsSlice()[..packed.Length() - 3u], Format::Gzip) {
        .Success(_) => Assert(false, "a truncated stream is caught"),
        .Failure(error) => Assert(error.kind == IoErrorKind::InvalidInput, "a truncated stream is invalid input")
    }
    match Decompress(SystemAllocator(), fox.AsSlice(), Format::Zlib) {
        .Success(_) => Assert(false, "text is not a zlib stream"),
        .Failure(error) => Assert(error.kind == IoErrorKind::InvalidInput, "text is not a zlib stream")
    }
    return 0;
}
