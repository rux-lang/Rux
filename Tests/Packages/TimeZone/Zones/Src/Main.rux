func Same(left: char8[..], right: char8[..]) -> bool {
    if left.length != right.length { return false; }
    var index: uint = 0;
    while index < left.length {
        if left[index] != right[index] { return false; }
        index = index + 1;
    }
    return true;
}

// Whether the zone's state at `seconds` is the expected one.
func Check(zone: &TimeZone, seconds: int64, offset: int32, daylight: bool, abbreviation: char8[..]) -> bool {
    let state = zone.StateAt(Timestamp::FromUnixSeconds(seconds));
    return state.offset.seconds == offset && state.daylight == daylight && Same(state.abbreviation, abbreviation);
}

func Local(year: int32, month: uint8, day: uint8, hour: uint8, minute: uint8) -> DateTime {
    return DateTime {
        date: Date::New(year, month, day) ?? Date { year: 1970, month: 1, day: 1 },
        time: TimeOfDay::New(hour, minute, 0, 0) ?? TimeOfDay::Midnight()
    };
}

func Main() -> int {
    let allocator = SystemAllocator();
    let berlin = TimeZone::FromTzif(allocator, "Europe/Berlin", BerlinData[..]) catch { else => return 10 };
    let sydney = TimeZone::FromTzif(allocator, "Australia/Sydney", SydneyData[..]) catch { else => return 11 };
    Assert(Same(berlin.Name(), "Europe/Berlin"), "a zone keeps its name");

    Assert(Check(berlin, -2208988800i64, 3600, false, "CET"), "Europe/Berlin at -2208988800");
    Assert(Check(berlin, -1690977600i64, 7200, true, "CEST"), "Europe/Berlin at -1690977600");
    Assert(Check(berlin, -775828800i64, 10800, true, "CEMT"), "Europe/Berlin at -775828800");
    Assert(Check(berlin, 0i64, 3600, false, "CET"), "Europe/Berlin at 0");
    Assert(Check(berlin, 331300800i64, 7200, true, "CEST"), "Europe/Berlin at 331300800");
    Assert(Check(berlin, 947894400i64, 3600, false, "CET"), "Europe/Berlin at 947894400");
    Assert(Check(berlin, 962452800i64, 7200, true, "CEST"), "Europe/Berlin at 962452800");
    Assert(Check(berlin, 1711843200i64, 3600, false, "CET"), "Europe/Berlin at 1711843200");
    Assert(Check(berlin, 1711846800i64, 7200, true, "CEST"), "Europe/Berlin at 1711846800");
    Assert(Check(berlin, 1729987200i64, 7200, true, "CEST"), "Europe/Berlin at 1729987200");
    Assert(Check(berlin, 1729990800i64, 3600, false, "CET"), "Europe/Berlin at 1729990800");
    Assert(Check(berlin, 2145913200i64, 3600, false, "CET"), "Europe/Berlin at 2145913200");
    Assert(Check(berlin, 2540289600i64, 7200, true, "CEST"), "Europe/Berlin at 2540289600");
    Assert(Check(berlin, 4102488000i64, 3600, false, "CET"), "Europe/Berlin at 4102488000");
    Assert(Check(berlin, 4118126400i64, 7200, true, "CEST"), "Europe/Berlin at 4118126400");
    Assert(Check(sydney, -2208988800i64, 36000, false, "AEST"), "Australia/Sydney at -2208988800");
    Assert(Check(sydney, -1690977600i64, 36000, false, "AEST"), "Australia/Sydney at -1690977600");
    Assert(Check(sydney, -775828800i64, 36000, false, "AEST"), "Australia/Sydney at -775828800");
    Assert(Check(sydney, 0i64, 36000, false, "AEST"), "Australia/Sydney at 0");
    Assert(Check(sydney, 331300800i64, 36000, false, "AEST"), "Australia/Sydney at 331300800");
    Assert(Check(sydney, 947894400i64, 39600, true, "AEDT"), "Australia/Sydney at 947894400");
    Assert(Check(sydney, 962452800i64, 36000, false, "AEST"), "Australia/Sydney at 962452800");
    Assert(Check(sydney, 1711843200i64, 39600, true, "AEDT"), "Australia/Sydney at 1711843200");
    Assert(Check(sydney, 1711846800i64, 39600, true, "AEDT"), "Australia/Sydney at 1711846800");
    Assert(Check(sydney, 1729987200i64, 39600, true, "AEDT"), "Australia/Sydney at 1729987200");
    Assert(Check(sydney, 1729990800i64, 39600, true, "AEDT"), "Australia/Sydney at 1729990800");
    Assert(Check(sydney, 2145913200i64, 39600, true, "AEDT"), "Australia/Sydney at 2145913200");
    Assert(Check(sydney, 2540289600i64, 36000, false, "AEST"), "Australia/Sydney at 2540289600");
    Assert(Check(sydney, 4102488000i64, 39600, true, "AEDT"), "Australia/Sydney at 4102488000");
    Assert(Check(sydney, 4118126400i64, 36000, false, "AEST"), "Australia/Sydney at 4118126400");
    // A POSIX rule, north and south of the equator.
    let paris = TimeZone::FromRule(allocator, "Paris", "CET-1CEST,M3.5.0,M10.5.0/3") catch { else => return 12 };
    let melbourne = TimeZone::FromRule(allocator, "Melbourne", "AEST-10AEDT,M10.1.0,M4.1.0/3")
        catch { else => return 13 };
    let winter = Local(2025, 1, 15, 12, 0).ToTimestamp(UtcOffset::Utc());
    let summer = Local(2025, 7, 15, 12, 0).ToTimestamp(UtcOffset::Utc());
    Assert(paris.OffsetAt(winter).seconds == 3600 && paris.OffsetAt(summer).seconds == 7200, "a northern rule");
    Assert(melbourne.OffsetAt(winter).seconds == 39600 && melbourne.OffsetAt(summer).seconds == 36000,
           "a southern rule has daylight time over the new year");
    Assert(Same(paris.StateAt(summer).abbreviation, "CEST"), "a rule's abbreviation");
    let quoted = TimeZone::FromRule(allocator, "Plus", "<+0330>-3:30") catch { else => return 14 };
    Assert(quoted.OffsetAt(winter).seconds == 12600 && Same(quoted.StateAt(winter).abbreviation, "+0330"),
           "a quoted abbreviation and a minute offset");
    let utc = TimeZone::Utc(allocator) catch { else => return 15 };
    Assert(utc.OffsetAt(summer).seconds == 0, "UTC has no offset");

    // Resolving local times around the 2024 changes in Berlin.
    let skipped = berlin.Resolve(Local(2024, 3, 31, 2, 30));
    Assert(skipped.kind == LocalTimeKind::Skipped, "02:30 on the last Sunday of March never happens");
    Assert(skipped.later.UnixSeconds() - skipped.earlier.UnixSeconds() == 3600i64, "a skipped hour spans an hour");
    let repeated = berlin.Resolve(Local(2024, 10, 27, 2, 30));
    Assert(repeated.kind == LocalTimeKind::Ambiguous, "02:30 on the last Sunday of October happens twice");
    Assert(berlin.OffsetAt(repeated.earlier).seconds == 7200 && berlin.OffsetAt(repeated.later).seconds == 3600,
           "first in summer time, then in winter time");
    let plain = berlin.Resolve(Local(2024, 6, 1, 12, 0));
    Assert(plain.kind == LocalTimeKind::Unique && plain.earlier.UnixSeconds() == plain.later.UnixSeconds(),
           "an ordinary time happens once");
    let back = berlin.ToLocal(plain.earlier);
    Assert(back.dateTime.time.hour == 12u8 && back.offset.seconds == 7200, "a resolved time converts back");

    // Errors.
    match TimeZone::FromRule(allocator, "Bad", "X5") {
        .Success(_) => Assert(false, "a short abbreviation is refused"),
        .Failure(_) => {}
    }
    match TimeZone::FromTzif(allocator, "Bad", BerlinData[..40]) {
        .Success(_) => Assert(false, "truncated TZif data is refused"),
        .Failure(_) => {}
    }
    match TimeZone::Load(allocator, "../etc/passwd") {
        .Success(_) => Assert(false, "a name that leaves the directory is refused"),
        .Failure(_) => {}
    }
    // The Unix systems keep the tz database where the zone can be loaded from by name.
    when #target.os == .Linux {
        let loaded = TimeZone::Load(allocator, "Europe/Berlin") catch { else => return 16 };
        Assert(loaded.OffsetAt(summer).seconds == 7200 && Same(loaded.Name(), "Europe/Berlin"),
               "a zone loads from the system database");
    }
    match TimeZone::Local(allocator) {
        .Success(zone) => Assert(zone.Name().length > 0u, "the local zone has a name"),
        .Failure(_) => {}
    }
    return 0;
}
