// The coverage that is about the package as a whole rather than about one part of it.
//
// The differential check is the valuable one. The tree parser and the streaming reader are two independent
// implementations of the same grammar, written separately, and requiring them to agree on every document is a
// far stronger statement than either passing its own tests — a misreading would have to be made twice, the
// same way, to survive it.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Result };
import Format::{ TextWriter };
import Io::{ IoError, IoErrorKind, Reader };
import Json::{ DuplicateKeyPolicy, JsonEvent, JsonEventReader, JsonKind, JsonLimits, JsonParseError, JsonStyle,
               JsonValue, JsonWriteError, Parse, ParseWith, WriteValue };
import Text::{ BufferWriter, FormatSpec, String, StringBuilder, StringView, TextError };

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: char8[..]) -> char8[..] {
    return (text.data)[..text.length];
}

struct SliceState {
    bytes: char8[..];
    offset: uint;
}

struct SliceHandle {
    state: *var SliceState;
}

extend SliceHandle : Reader {
    func Read(self: &var SliceHandle, into: var char8[..], filled: *var uint) -> IoError {
        *filled = 0;
        let state = self.state;
        let remaining = state.bytes.length - state.offset;
        if remaining == 0 {
            return IoError::Of(IoErrorKind::EndOfStream);
        }
        var give = remaining < 7u ? remaining : 7u;
        if into.length < give {
            give = into.length;
        }
        var index: uint = 0;
        while index < give {
            into.data[index] = state.bytes.data[state.offset + index];
            index = index + 1;
        }
        state.offset = state.offset + give;
        *filled = give;
        return IoError::Ok();
    }
}

// Counts the values a streaming read reports, which is a shape the tree can also be asked for.
func StreamCounts(allocator: Allocator, text: char8[..], scalars: *var uint, opens: *var uint,
                  names: *var uint) -> bool {
    var error = IoError::Ok();
    var state = SliceState { bytes: text, offset: 0 };
    let handle: Reader = SliceHandle { state: @state };
    var reader = JsonEventReader::New(allocator, handle, JsonLimits::Default(), @error);
    *scalars = 0;
    *opens = 0;
    *names = 0;
    var event = reader.Next();
    while event != JsonEvent::End && event != JsonEvent::Error {
        if event == JsonEvent::ObjectStart || event == JsonEvent::ArrayStart {
            *opens = *opens + 1u;
        }
        else if event == JsonEvent::Name {
            *names = *names + 1u;
        }
        else if event != JsonEvent::ObjectEnd && event != JsonEvent::ArrayEnd {
            *scalars = *scalars + 1u;
        }
        event = reader.Next();
    }
    let ok = event == JsonEvent::End;
    reader.Release();
    return ok;
}

// The same counts taken from a tree.
func TreeCounts(value: &JsonValue, scalars: *var uint, opens: *var uint, names: *var uint) {
    let kind = value.Kind();
    if kind == JsonKind::Array {
        *opens = *opens + 1u;
        var index: uint = 0;
        while index < value.Length() {
            TreeCounts(*value.At(index), scalars, opens, names);
            index = index + 1;
        }
        return;
    }
    if kind == JsonKind::Object {
        *opens = *opens + 1u;
        var index: uint = 0;
        while index < value.Length() {
            *names = *names + 1u;
            let member = value.MemberAt(index);
            TreeCounts((*member).value, scalars, opens, names);
            index = index + 1;
        }
        return;
    }
    *scalars = *scalars + 1u;
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    var wrote = JsonWriteError::None;

    // Well-formed documents: each parses, writes, parses again, and the two writings agree. That round
    // trip proves the writer and the parser agree about the document rather than each merely being
    // self-consistent. Each is also read by the streaming reader, which must see the same shape.
    CheckRoundTrip(allocator, "{}", @wrote);
    CheckRoundTrip(allocator, "[]", @wrote);
    CheckRoundTrip(allocator, "null", @wrote);
    CheckRoundTrip(allocator, "true", @wrote);
    CheckRoundTrip(allocator, "false", @wrote);
    CheckRoundTrip(allocator, "0", @wrote);
    CheckRoundTrip(allocator, "-0", @wrote);
    CheckRoundTrip(allocator, "123", @wrote);
    CheckRoundTrip(allocator, "-1.5e-3", @wrote);
    CheckRoundTrip(allocator, "1e999", @wrote);
    CheckRoundTrip(allocator, "[1,2,3]", @wrote);
    CheckRoundTrip(allocator, "[[[[1]]]]", @wrote);
    CheckRoundTrip(allocator, "{\"a\":1}", @wrote);
    CheckRoundTrip(allocator, "{\"a\":{\"b\":{\"c\":[1,2,{\"d\":null}]}}}", @wrote);
    CheckRoundTrip(allocator, "[\"\",  \"x\", \"\\n\", \"\\u0041\", \"\\ud83d\\ude00\"]", @wrote);
    CheckRoundTrip(allocator, "{\"\":1}", @wrote);
    CheckRoundTrip(allocator, "[null,true,false]", @wrote);
    CheckRoundTrip(allocator, "{\"a\":[],\"b\":{}}", @wrote);
    CheckRoundTrip(allocator, "[{\"x\":1},{\"x\":2},{\"x\":3}]", @wrote);
    CheckRoundTrip(allocator, "{\"n\":-0.0,\"m\":1e-400}", @wrote);

    // Malformed documents: every one refused, with no crash and no partial value handed back.
    CheckRefused(allocator, "");
    CheckRefused(allocator, "{");
    CheckRefused(allocator, "[");
    CheckRefused(allocator, "}");
    CheckRefused(allocator, "]");
    CheckRefused(allocator, "{}}");
    CheckRefused(allocator, "[]]");
    CheckRefused(allocator, "[1,]");
    CheckRefused(allocator, "{\"a\":1,}");
    CheckRefused(allocator, "{a:1}");
    CheckRefused(allocator, "{'a':1}");
    CheckRefused(allocator, "[1 2]");
    CheckRefused(allocator, "{\"a\" 1}");
    CheckRefused(allocator, "01");
    CheckRefused(allocator, "+1");
    CheckRefused(allocator, ".5");
    CheckRefused(allocator, "1.");
    CheckRefused(allocator, "1e");
    CheckRefused(allocator, "NaN");
    CheckRefused(allocator, "Infinity");
    CheckRefused(allocator, "-Infinity");
    CheckRefused(allocator, "tru");
    CheckRefused(allocator, "nul");
    CheckRefused(allocator, "\"unterminated");
    CheckRefused(allocator, "{\"a\":}");
    CheckRefused(allocator, "[,1]");
    CheckRefused(allocator, "{,}");
    CheckRefused(allocator, "1 2");
    CheckRefused(allocator, "[1][2]");
    CheckRefused(allocator, "{\"a\":1}{\"b\":2}");
    CheckRefused(allocator, "[[1],");
    CheckRefused(allocator, "\"\\q\"");
    CheckRefused(allocator, "\"\\u12\"");
    CheckRefused(allocator, "{\"a\":1,\"a\":2}");


    // Resource limits, each refused under its own reason rather than a general failure.
    var tight = JsonLimits::Default();
    tight.maximumDepth = 4;
    let tooDeep = ParseWith(allocator, "[[[[[1]]]]]", tight, DuplicateKeyPolicy::Reject);
    Assert(RefusedWith(tooDeep, "JsonParseError::TooDeep(5)"), "depth is bounded");

    tight = JsonLimits::Default();
    tight.maximumEntries = 3;
    let tooWide = ParseWith(allocator, "[1,2,3,4]", tight, DuplicateKeyPolicy::Reject);
    Assert(RefusedWith(tooWide, "JsonParseError::TooManyEntries(8)"), "entry counts are bounded");

    tight = JsonLimits::Default();
    tight.maximumBytes = 4;
    let tooBig = ParseWith(allocator, "[1,2,3,4]", tight, DuplicateKeyPolicy::Reject);
    Assert(RefusedWith(tooBig, "JsonParseError::Lexical(TooManyBytes, 0)"),
           "document size is bounded, with the size as the reason and the byte it was reached at");

    // A deeply nested document that would exhaust a stack is refused rather than crashing, which is the whole
    // reason the depth check happens before the descent.
    var nest: char8[600];
    var index: uint = 0;
    while index < 300u {
        nest[index] = 0x5Bu8 as char8;
        index = index + 1;
    }
    while index < 600u {
        nest[index] = 0x5Du8 as char8;
        index = index + 1;
    }
    let nested = Parse(allocator, (@nest[0])[..600]);
    Assert(RefusedWith(nested, "JsonParseError::TooDeep(129)"),
           "three hundred levels exceeds the default depth and is refused rather than descended into");

    return 0;
}

// Parses, writes, parses again, and requires the two writings to agree — then requires the streaming reader to
// see the same shape as the tree.
func CheckRoundTrip(allocator: Allocator, text: char8[..], wrote: *var JsonWriteError) {
    var outcome = Parse(allocator, text);
    var value = JsonValue::Null(allocator);
    Assert((<-outcome).TryIntoValue(@value), "a well-formed document parses");

    var builder = StringBuilder(allocator);
    let sink: &var TextWriter = builder;
    *wrote = WriteValue(sink, value, JsonStyle::Compact());
    Assert(*wrote == JsonWriteError::None, "and writes");
    var once = builder.IntoString();

    var second = Parse(allocator, once.View().Bytes());
    var again = JsonValue::Null(allocator);
    Assert((<-second).TryIntoValue(@again), "and the written form parses");
    var secondBuilder = StringBuilder(allocator);
    let secondSink: &var TextWriter = secondBuilder;
    *wrote = WriteValue(secondSink, again, JsonStyle::Compact());
    var twice = secondBuilder.IntoString();
    let twiceView = twice.View();
    Assert(once.View().Equals(twiceView), "to the same text, so the round trip is settled after one pass");

    // The two parsers must agree about the document's shape.
    var streamScalars: uint = 0;
    var streamOpens: uint = 0;
    var streamNames: uint = 0;
    Assert(StreamCounts(allocator, text, @streamScalars, @streamOpens, @streamNames),
           "the streaming reader reaches the end of the same document");
    var treeScalars: uint = 0;
    var treeOpens: uint = 0;
    var treeNames: uint = 0;
    TreeCounts(value, @treeScalars, @treeOpens, @treeNames);
    Assert(streamScalars == treeScalars, "and counts the same scalars as the tree");
    Assert(streamOpens == treeOpens, "the same containers");
    Assert(streamNames == treeNames, "and the same member names");
}

// Requires a document to be refused, and nothing at all to come back with the refusal.
//
// That second half is the shape rather than a check: the result carries either a document or a failure, so a
// refused parse cannot hand over a partial tree the way the old outcome-beside-a-value form could. What is left to
// check is that whatever the parser built before it stopped was released rather than leaked, and the allocator
// counting that is in the parser test.
func CheckRefused(allocator: Allocator, text: char8[..]) {
    let outcome = Parse(allocator, text);
    Assert(outcome.IsError(), "a malformed document is refused");
}

// Whether an outcome is the refusal it should be, by the failure's own rendering, which names the case and the
// byte it stopped at.
func RefusedWith(outcome: &Result<JsonValue, JsonParseError>, expected: char8[..]) -> bool {
    return match outcome {
        .Success(_) => false,
        .Error(reason) => {
            var storage: char8[96];
            var writer = BufferWriter((@storage[0])[..96]);
            let sink: &var TextWriter = writer;
            if reason.WriteDebug(sink, FormatSpec::Plain()).IsError() { return false; }
            let shown = writer.Written();
            if shown.length != expected.length { return false; }
            var index: uint = 0;
            while index < expected.length {
                if shown.data[index] != expected.data[index] { return false; }
                index = index + 1;
            }
            return true;
        }
    };
}
