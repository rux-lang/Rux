// The coverage that is about the package as a whole rather than about one part of it.
//
// The differential check is the valuable one. The tree parser and the streaming reader are two independent
// implementations of the same grammar, written separately, and requiring them to agree on every document is a
// far stronger statement than either passing its own tests -- a misreading would have to be made twice, the
// same way, to survive it.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, MutableSlice, Slice };
import Format::{ TextWriter };
import Io::{ IoError, IoErrorKind, Reader };
import Json::{ JsonEvent, JsonEventReader, JsonKind, JsonLexError, JsonLimits, JsonParseError, JsonParseOutcome,
               JsonStyle, JsonValue, JsonWriteError, DuplicateKeyPolicy, Parse, ParseWith, WriteValue };
import Text::{ String, StringBuilder, StringView, TextError };

// The bytes a string spans, which is how a text overload reaches the slice one.
func TextBytes(text: string) -> Slice<char8> {
    return Slice<char8> { data: text.data, length: text.length };
}

struct SliceState {
    bytes: Slice<char8>;
    offset: uint;
}

struct SliceHandle {
    state: *var SliceState;
}

extend SliceHandle : Reader {
    func Read(self: &var SliceHandle, into: MutableSlice<char8>, filled: *var uint) -> IoError {
        *filled = 0;
        let state = self.state;
        let remaining = state.bytes.length - state.offset;
        if remaining == 0 {
            return IoError::Of(IoErrorKind::EndOfStream);
        }
        var give = remaining < 7u ? remaining : 7u;
        if into.length < give {
            give = into.length;
        }
        var index: uint = 0;
        while index < give {
            into.data[index] = state.bytes.data[state.offset + index];
            index = index + 1;
        }
        state.offset = state.offset + give;
        *filled = give;
        return IoError::Ok();
    }
}

// Counts the values a streaming read reports, which is a shape the tree can also be asked for.
func StreamCounts(allocator: Allocator, text: Slice<char8>, scalars: *var uint, opens: *var uint,
                  names: *var uint) -> bool {
    var error = IoError::Ok();
    var state = SliceState { bytes: text, offset: 0 };
    let handle: Reader = SliceHandle { state: @state };
    var reader = JsonEventReader::New(allocator, handle, JsonLimits::Default(), @error);
    *scalars = 0;
    *opens = 0;
    *names = 0;
    var event = reader.Next();
    while event != JsonEvent::End && event != JsonEvent::Error {
        if event == JsonEvent::ObjectStart || event == JsonEvent::ArrayStart {
            *opens = *opens + 1u;
        }
        else if event == JsonEvent::Name {
            *names = *names + 1u;
        }
        else if event != JsonEvent::ObjectEnd && event != JsonEvent::ArrayEnd {
            *scalars = *scalars + 1u;
        }
        event = reader.Next();
    }
    let ok = event == JsonEvent::End;
    reader.Release();
    return ok;
}

// The same counts taken from a tree.
func TreeCounts(value: &JsonValue, scalars: *var uint, opens: *var uint, names: *var uint) {
    let kind = value.Kind();
    if kind == JsonKind::Array {
        *opens = *opens + 1u;
        var index: uint = 0;
        while index < value.Length() {
            TreeCounts(*value.At(index), scalars, opens, names);
            index = index + 1;
        }
        return;
    }
    if kind == JsonKind::Object {
        *opens = *opens + 1u;
        var index: uint = 0;
        while index < value.Length() {
            *names = *names + 1u;
            let member = value.MemberAt(index);
            TreeCounts((*member).value, scalars, opens, names);
            index = index + 1;
        }
        return;
    }
    *scalars = *scalars + 1u;
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    var parsed = JsonParseOutcome { error: JsonParseError::None, lexical: JsonLexError::None, position: 0 };
    var wrote = JsonWriteError::None;

    // Well-formed documents: each parses, writes, parses again, and the two writings agree. That round
    // trip proves the writer and the parser agree about the document rather than each merely being
    // self-consistent. Each is also read by the streaming reader, which must see the same shape.
    CheckRoundTrip(allocator, "{}", @parsed, @wrote);
    CheckRoundTrip(allocator, "[]", @parsed, @wrote);
    CheckRoundTrip(allocator, "null", @parsed, @wrote);
    CheckRoundTrip(allocator, "true", @parsed, @wrote);
    CheckRoundTrip(allocator, "false", @parsed, @wrote);
    CheckRoundTrip(allocator, "0", @parsed, @wrote);
    CheckRoundTrip(allocator, "-0", @parsed, @wrote);
    CheckRoundTrip(allocator, "123", @parsed, @wrote);
    CheckRoundTrip(allocator, "-1.5e-3", @parsed, @wrote);
    CheckRoundTrip(allocator, "1e999", @parsed, @wrote);
    CheckRoundTrip(allocator, "[1,2,3]", @parsed, @wrote);
    CheckRoundTrip(allocator, "[[[[1]]]]", @parsed, @wrote);
    CheckRoundTrip(allocator, "{\"a\":1}", @parsed, @wrote);
    CheckRoundTrip(allocator, "{\"a\":{\"b\":{\"c\":[1,2,{\"d\":null}]}}}", @parsed, @wrote);
    CheckRoundTrip(allocator, "[\"\",  \"x\", \"\\n\", \"\\u0041\", \"\\ud83d\\ude00\"]", @parsed, @wrote);
    CheckRoundTrip(allocator, "{\"\":1}", @parsed, @wrote);
    CheckRoundTrip(allocator, "[null,true,false]", @parsed, @wrote);
    CheckRoundTrip(allocator, "{\"a\":[],\"b\":{}}", @parsed, @wrote);
    CheckRoundTrip(allocator, "[{\"x\":1},{\"x\":2},{\"x\":3}]", @parsed, @wrote);
    CheckRoundTrip(allocator, "{\"n\":-0.0,\"m\":1e-400}", @parsed, @wrote);

    // Malformed documents: every one refused, with no crash and no partial value handed back.
    CheckRefused(allocator, "", @parsed);
    CheckRefused(allocator, "{", @parsed);
    CheckRefused(allocator, "[", @parsed);
    CheckRefused(allocator, "}", @parsed);
    CheckRefused(allocator, "]", @parsed);
    CheckRefused(allocator, "{}}", @parsed);
    CheckRefused(allocator, "[]]", @parsed);
    CheckRefused(allocator, "[1,]", @parsed);
    CheckRefused(allocator, "{\"a\":1,}", @parsed);
    CheckRefused(allocator, "{a:1}", @parsed);
    CheckRefused(allocator, "{'a':1}", @parsed);
    CheckRefused(allocator, "[1 2]", @parsed);
    CheckRefused(allocator, "{\"a\" 1}", @parsed);
    CheckRefused(allocator, "01", @parsed);
    CheckRefused(allocator, "+1", @parsed);
    CheckRefused(allocator, ".5", @parsed);
    CheckRefused(allocator, "1.", @parsed);
    CheckRefused(allocator, "1e", @parsed);
    CheckRefused(allocator, "NaN", @parsed);
    CheckRefused(allocator, "Infinity", @parsed);
    CheckRefused(allocator, "-Infinity", @parsed);
    CheckRefused(allocator, "tru", @parsed);
    CheckRefused(allocator, "nul", @parsed);
    CheckRefused(allocator, "\"unterminated", @parsed);
    CheckRefused(allocator, "{\"a\":}", @parsed);
    CheckRefused(allocator, "[,1]", @parsed);
    CheckRefused(allocator, "{,}", @parsed);
    CheckRefused(allocator, "1 2", @parsed);
    CheckRefused(allocator, "[1][2]", @parsed);
    CheckRefused(allocator, "{\"a\":1}{\"b\":2}", @parsed);
    CheckRefused(allocator, "[[1],", @parsed);
    CheckRefused(allocator, "\"\\q\"", @parsed);
    CheckRefused(allocator, "\"\\u12\"", @parsed);
    CheckRefused(allocator, "{\"a\":1,\"a\":2}", @parsed);


    // Resource limits, each refused under its own reason rather than a general failure.
    var tight = JsonLimits::Default();
    tight.maximumDepth = 4;
    var deepOutcome = JsonParseOutcome { error: JsonParseError::None, lexical: JsonLexError::None, position: 0 };
    var tooDeep = ParseWith(allocator, "[[[[[1]]]]]", tight, DuplicateKeyPolicy::Reject, @deepOutcome);
    Assert(deepOutcome.error == JsonParseError::TooDeep, "depth is bounded");

    tight = JsonLimits::Default();
    tight.maximumEntries = 3;
    var wideOutcome = JsonParseOutcome { error: JsonParseError::None, lexical: JsonLexError::None, position: 0 };
    var tooWide = ParseWith(allocator, "[1,2,3,4]", tight, DuplicateKeyPolicy::Reject, @wideOutcome);
    Assert(wideOutcome.error == JsonParseError::TooManyEntries, "entry counts are bounded");

    tight = JsonLimits::Default();
    tight.maximumBytes = 4;
    var bigOutcome = JsonParseOutcome { error: JsonParseError::None, lexical: JsonLexError::None, position: 0 };
    var tooBig = ParseWith(allocator, "[1,2,3,4]", tight, DuplicateKeyPolicy::Reject, @bigOutcome);
    Assert(bigOutcome.error == JsonParseError::Lexical, "document size is bounded");
    Assert(bigOutcome.lexical == JsonLexError::TooManyBytes, "with the size as the reason");

    // A deeply nested document that would exhaust a stack is refused rather than crashing, which is the whole
    // reason the depth check happens before the descent.
    var nest: char8[600];
    var index: uint = 0;
    while index < 300u {
        nest[index] = 0x5Bu8 as char8;
        index = index + 1;
    }
    while index < 600u {
        nest[index] = 0x5Du8 as char8;
        index = index + 1;
    }
    var nestOutcome = JsonParseOutcome { error: JsonParseError::None, lexical: JsonLexError::None, position: 0 };
    var nested = Parse(allocator, Slice<char8> { data: @nest[0], length: 600 }, @nestOutcome);
    Assert(nestOutcome.error == JsonParseError::TooDeep,
           "three hundred levels exceeds the default depth and is refused rather than descended into");

    return 0;
}

// Parses, writes, parses again, and requires the two writings to agree -- then requires the streaming reader to
// see the same shape as the tree.
func CheckRoundTrip(allocator: Allocator, text: Slice<char8>, parsed: *var JsonParseOutcome,
                    wrote: *var JsonWriteError) {
    var value = Parse(allocator, text, parsed);
    Assert(parsed.error == JsonParseError::None, "a well-formed document parses");

    var builder = StringBuilder(allocator);
    let sink: &var TextWriter = builder;
    *wrote = WriteValue(sink, value, JsonStyle::Compact());
    Assert(*wrote == JsonWriteError::None, "and writes");
    var once = builder.IntoString();

    var again = Parse(allocator, once.View().Bytes(), parsed);
    Assert(parsed.error == JsonParseError::None, "and the written form parses");
    var secondBuilder = StringBuilder(allocator);
    let secondSink: &var TextWriter = secondBuilder;
    *wrote = WriteValue(secondSink, again, JsonStyle::Compact());
    var twice = secondBuilder.IntoString();
    let twiceView = twice.View();
    Assert(once.View().Equals(twiceView), "to the same text, so the round trip is settled after one pass");

    // The two parsers must agree about the document's shape.
    var streamScalars: uint = 0;
    var streamOpens: uint = 0;
    var streamNames: uint = 0;
    Assert(StreamCounts(allocator, text, @streamScalars, @streamOpens, @streamNames),
           "the streaming reader reaches the end of the same document");
    var treeScalars: uint = 0;
    var treeOpens: uint = 0;
    var treeNames: uint = 0;
    TreeCounts(value, @treeScalars, @treeOpens, @treeNames);
    Assert(streamScalars == treeScalars, "and counts the same scalars as the tree");
    Assert(streamOpens == treeOpens, "the same containers");
    Assert(streamNames == treeNames, "and the same member names");
}

// The same helper for text.
func CheckRoundTrip(allocator: Allocator, text: string, parsed: *var JsonParseOutcome, wrote: *var JsonWriteError) {
    CheckRoundTrip(allocator, TextBytes(text), parsed, wrote);
}

// Requires a document to be refused, and the value handed back to be the empty one rather than a partial tree.
func CheckRefused(allocator: Allocator, text: Slice<char8>, parsed: *var JsonParseOutcome) {
    var value = Parse(allocator, text, parsed);
    Assert(parsed.error != JsonParseError::None, "a malformed document is refused");
}

// The same helper for text.
func CheckRefused(allocator: Allocator, text: string, parsed: *var JsonParseOutcome) {
    CheckRefused(allocator, TextBytes(text), parsed);
}
