// The number type is the interesting part: JSON declines to say what precision a number has, so the failure to
// test for is one that an implementation converting everything to a double would pass — an identifier past two
// to the fifty-third coming back as a different identifier.

import Allocator::{ Allocator, SystemAllocator };
import Core::Diagnostics::{ Assert, Panic };
import Json::{ JsonError, JsonKind, JsonNumber, JsonValue };
import Text::{ String, StringView };

func View(bytes: char8[..]) -> StringView {
    return StringView::FromBytes(bytes) ?? StringView::New();
}

// The number a value holds, which the test has just made it hold.
func Number(value: &JsonValue) -> &JsonNumber {
    return value.AsNumber() ?? Panic("the value is a number");
}

// Whether `text` is refused as a number by both public constructors, each for the grammar's reason.
func RefusedNumber(allocator: Allocator, text: char8[..]) -> bool {
    var number = false;
    match JsonNumber::New(allocator, text) {
        .Success(_) => {},
        .Failure(error) => { number = error == JsonError::MalformedNumber; },
    }
    var value = false;
    match JsonValue::Number(allocator, text) {
        .Success(_) => {},
        .Failure(error) => { value = error == JsonError::MalformedNumber; },
    }
    return number && value;
}

// Whether `text` is accepted as a number by both public constructors, keeping exactly the text it was given.
func AcceptedNumber(allocator: Allocator, text: char8[..]) -> bool {
    let want = View(text);
    let number = if let made? = (JsonNumber::New(allocator, text) !! none) { made.Text().Equals(want) } else { false };
    let value = if let made? = (JsonValue::Number(allocator, text) !! none) { made.Kind() == JsonKind::Number && Number(&made).Text().Equals(want) } else { false };
    return number && value;
}

func Main() -> int {
    let allocator = SystemAllocator::New();

    // The tags, each recognised as itself.
    var nullValue = JsonValue::Null(allocator);
    Assert(nullValue.Kind() == JsonKind::Null && nullValue.IsNull(), "null is null");
    var trueValue = JsonValue::Boolean(allocator, true);
    var falseValue = JsonValue::Boolean(allocator, false);
    Assert(trueValue.Kind() == JsonKind::Boolean && !trueValue.IsNull(), "a boolean is a boolean");
    Assert(trueValue.AsBoolean() == true, "and reads back as true");
    Assert(falseValue.AsBoolean() == false, "or as false");
    Assert(nullValue.AsBoolean() == none, "while null is not a boolean at all");

    // Numbers keep their text, which is what makes them exact.
    var large = JsonValue::Number(allocator, "9007199254740993") catch {
        _ => Panic("a large integer is stored")
    };
    Assert(Number(&large).AsUint64() == 9007199254740993,
           "and reads back exactly -- one past two to the fifty-third, which a double would have rounded away");
    let asFloat = Number(&large).AsFloat64() ?? Panic("it also reads as a float");
    Assert((asFloat as uint64) != 9007199254740993,
           "and that reading loses the last digit, which is why the exact one is offered separately");

    var written = JsonValue::Number(allocator, "1.2000") catch { _ => Panic("1.2000 is stored") };
    let writtenText = Number(&written).Text();
    let expectedText = View("1.2000");
    Assert(writtenText.Equals(expectedText), "a number keeps the text it was written with, trailing zeros too");

    // Integral means no fraction and no exponent, which is a statement about the text rather than the value.
    var whole = JsonValue::Number(allocator, "42") catch { _ => Panic("42 is stored") };
    var pointZero = JsonValue::Number(allocator, "42.0") catch { _ => Panic("42.0 is stored") };
    var exponent = JsonValue::Number(allocator, "4.2e1") catch { _ => Panic("4.2e1 is stored") };
    Assert(Number(&whole).IsIntegral(), "42 is integral");
    Assert(!Number(&pointZero).IsIntegral(), "42.0 is not, though its value is whole");
    Assert(!Number(&exponent).IsIntegral(), "and neither is 4.2e1");
    Assert(Number(&pointZero).AsInt64() == none,
           "so 42.0 does not read as an integer, which keeps a distinction the document was making");
    Assert(Number(&pointZero).AsFloat64() == 42.0, "while it reads fine as a float");

    var negative = JsonValue::Number(allocator, "-9223372036854775808") catch {
        _ => Panic("the most negative signed integer is stored")
    };
    Assert(Number(&negative).AsInt64() == -9223372036854775808i64,
           "the most negative signed integer reads back exactly");
    Assert(Number(&negative).AsUint64() == none, "and does not read as unsigned");

    // A number made by hand is held to the grammar a parsed one is, so nothing the tree holds is a number only this
    // package would read.
    Assert(RefusedNumber(allocator, "01"), "a leading zero is refused");
    Assert(RefusedNumber(allocator, "-01"), "after a minus too");
    Assert(RefusedNumber(allocator, "1e"), "an exponent with no digits is refused");
    Assert(RefusedNumber(allocator, "1e+"), "and so is one with only a sign");
    Assert(RefusedNumber(allocator, "1E-"), "in either case");
    Assert(RefusedNumber(allocator, "-"), "a lone minus is refused");
    Assert(RefusedNumber(allocator, "+1"), "a leading plus is refused");
    Assert(RefusedNumber(allocator, "--1"), "a doubled minus is refused");
    Assert(RefusedNumber(allocator, "--"), "and so is a pair of them alone");
    Assert(RefusedNumber(allocator, "e"), "an exponent with no number is refused");
    Assert(RefusedNumber(allocator, "e5"), "even with digits after it");
    Assert(RefusedNumber(allocator, ".5"), "a fraction with no integer part is refused");
    Assert(RefusedNumber(allocator, "5."), "and an integer part with an empty fraction");
    Assert(RefusedNumber(allocator, "5.e3"), "even when an exponent follows");
    Assert(RefusedNumber(allocator, ""), "empty text is refused");
    Assert(RefusedNumber(allocator, "NaN"), "a NaN is refused");
    Assert(RefusedNumber(allocator, "Infinity"), "and so is an infinity");
    Assert(RefusedNumber(allocator, "-Infinity"), "of either sign");
    Assert(RefusedNumber(allocator, "0x10"), "hexadecimal is refused");
    Assert(RefusedNumber(allocator, " 1"), "space before a number is refused");
    Assert(RefusedNumber(allocator, "1 "), "and after it");
    Assert(RefusedNumber(allocator, "1.5.2"), "a second fraction is refused");
    Assert(RefusedNumber(allocator, "1e5e5"), "and a second exponent");
    Assert(AcceptedNumber(allocator, "0"), "a lone zero is a number");
    Assert(AcceptedNumber(allocator, "-0"), "and so is a negative zero");
    Assert(AcceptedNumber(allocator, "0.5"), "a zero integer part takes a fraction");
    Assert(AcceptedNumber(allocator, "1e10"), "an exponent needs no sign");
    Assert(AcceptedNumber(allocator, "1E-5"), "may be upper case with a minus");
    Assert(AcceptedNumber(allocator, "-1.25e+3"), "and every part together is a number");
    Assert(AcceptedNumber(allocator, "0e0"), "a zero takes an exponent directly");
    Assert(AcceptedNumber(allocator, "10"), "and a zero after the first digit is no leading zero");

    // Strings.
    var text = JsonValue::Text(allocator, "hello") catch { _ => Panic("a string is stored") };
    Assert(text.Kind() == JsonKind::Text, "a string is a string");
    let expectedHello = View("hello");
    Assert(if let hello? = text.AsText() && hello.Equals(expectedHello) { true } else { false }, "and reads back");
    Assert(nullValue.AsText() == none, "while a non-string has no text rather than reinterpreting bytes");

    // Arrays own their elements and keep their order.
    var array = JsonValue::Array(allocator);
    Assert(array.Kind() == JsonKind::Array && array.Length() == 0, "a new array is empty");
    var index: uint = 0;
    while index < 5 {
        var element = JsonValue::Boolean(allocator, (index % 2) == 0);
        array.Push(element) catch { _ => Panic("elements append") };
        index = index + 1;
    }
    Assert(array.Length() == 5, "and the array grows");
    index = 0;
    while index < 5 {
        let element = array.At(index);
        Assert(element != none, "every index is reachable");
        let even = (index % 2) == 0;
        Assert(if let present? = element && present.AsBoolean() == even { true } else { false },
               "and the elements are in the order they were added");
        index = index + 1;
    }
    Assert(array.At(5) == none, "and one past the end is not");

    // Objects keep insertion order, which is what lets a document be written back recognisably.
    var object = JsonValue::Object(allocator);
    Assert(object.Kind() == JsonKind::Object && object.Length() == 0, "a new object is empty");
    var zetaName = String::FromBytes(allocator, "zeta") catch { _ => Panic("a name is built") };
    var zetaValue = JsonValue::Number(allocator, "1") catch { _ => Panic("1 is stored") };
    object.Insert(zetaName, zetaValue) catch { _ => Panic("a member inserts") };
    var alphaName = String::FromBytes(allocator, "alpha") catch { _ => Panic("a name is built") };
    var alphaValue = JsonValue::Number(allocator, "2") catch { _ => Panic("2 is stored") };
    object.Insert(alphaName, alphaValue) catch { _ => Panic("and another") };
    var muName = String::FromBytes(allocator, "mu") catch { _ => Panic("a name is built") };
    var muValue = JsonValue::Text(allocator, "found") catch { _ => Panic("a string is stored") };
    object.Insert(muName, muValue) catch { _ => Panic("and a third") };
    Assert(object.Length() == 3, "and the object grows");

    let zeta = View("zeta");
    Assert(if let firstMember? = object.MemberAt(0) && firstMember.name.View().Equals(zeta) { true } else { false },
           "the first member is the first one added, not the alphabetically first");
    let alpha = View("alpha");
    Assert(if let secondMember? = object.MemberAt(1) && secondMember.name.View().Equals(alpha) { true } else { false },
           "and insertion order is kept");

    // Lookup by name.
    let mu = View("mu");
    let found = object.Find(mu);
    Assert(if let member? = found && member.Kind() == JsonKind::Text { true } else { false }, "a member is found by name");
    let foundText = View("found");
    if let member? = found {
        if let value? = member.AsText() { Assert(value.Equals(foundText), "with the value it was given"); }
        else { Assert(false, "with the value it was given"); }
    }
    let missing = View("absent");
    Assert(object.Find(missing) == none, "and a name that is not there is not found");
    Assert(array.Find(mu) == none, "looking for a member in an array finds nothing rather than misreading it");

    // Wrong-kind accessors return none, and wrong-kind changes throw, rather than reinterpreting.
    Assert(array.At(0) != none && object.At(0) == none, "indexing works on arrays and not on objects");
    Assert(object.MemberAt(0) != none && array.MemberAt(0) == none, "and members the other way round");
    Assert(nullValue.Length() == none && text.Length() == none, "a scalar has no length");
    var pushRefused = JsonValue::Null(allocator);
    var pushWrongKind = false;
    match nullValue.Push(pushRefused) {
        .Success(_) => {},
        .Failure(error) => { pushWrongKind = error == JsonError::WrongKind; },
    }
    Assert(pushWrongKind, "pushing into a scalar is refused rather than ignored");
    var memberName = String::FromBytes(allocator, "late") catch { _ => Panic("a name is built") };
    var insertRefused = JsonValue::Null(allocator);
    var insertWrongKind = false;
    match array.Insert(memberName, insertRefused) {
        .Success(_) => {},
        .Failure(error) => { insertWrongKind = error == JsonError::WrongKind; },
    }
    Assert(insertWrongKind, "and so is inserting a member into an array");

    // Removing a member returns it, and removing one that is not there returns nothing.
    Assert(if let removed? = object.RemoveFirst(zeta) && removed.name.View().Equals(zeta) { true } else { false }, "a member is removed");
    Assert(object.RemoveFirst(zeta) == none && object.Length() == 2, "only once");
    Assert(array.RemoveFirst(zeta) == none, "and an array has no members to remove");

    return 0;
}
