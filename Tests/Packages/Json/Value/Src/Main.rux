// The number type is the interesting part: JSON declines to say what precision a number has, so the failure to
// test for is one that an implementation converting everything to a double would pass — an identifier past two
// to the fifty-third coming back as a different identifier.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Json::{ JsonError, JsonKind, JsonNumber, JsonValue };
import Text::{ String, StringView };

func View(bytes: char8[..]) -> StringView {
    return StringView::FromBytes(bytes) ?? StringView();
}

// Whether `text` is refused as a number by both public constructors, each for the grammar's reason.
func RefusedNumber(allocator: Allocator, text: char8[..]) -> bool {
    let number = match JsonNumber::New(allocator, text) {
        .Success(_) => false,
        .Failure(error) => error == JsonError::MalformedNumber
    };
    let value = match JsonValue::Number(allocator, text) {
        .Success(_) => false,
        .Failure(error) => error == JsonError::MalformedNumber
    };
    return number && value;
}

// Whether `text` is accepted as a number by both public constructors, keeping exactly the text it was given.
func AcceptedNumber(allocator: Allocator, text: char8[..]) -> bool {
    let want = View(text);
    let number = match JsonNumber::New(allocator, text) {
        .Success(made) => made.Text().Equals(want),
        .Failure(_) => false
    };
    let value = match JsonValue::Number(allocator, text) {
        // Safety: `AsNumber` points at the number payload inside `made`, which is live in this arm.
        .Success(made) => made.Kind() == JsonKind::Number && unsafe { (*made.AsNumber()).Text().Equals(want) },
        .Failure(_) => false
    };
    return number && value;
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // The tags, each recognised as itself.
    var nullValue = JsonValue::Null(allocator);
    Assert(nullValue.Kind() == JsonKind::Null && nullValue.IsNull(), "null is null");
    var trueValue = JsonValue::Boolean(allocator, true);
    var falseValue = JsonValue::Boolean(allocator, false);
    Assert(trueValue.Kind() == JsonKind::Boolean && !trueValue.IsNull(), "a boolean is a boolean");
    var flag = false;
    Assert(trueValue.AsBoolean(@flag) && flag, "and reads back as true");
    Assert(falseValue.AsBoolean(@flag) && !flag, "or as false");
    Assert(!nullValue.AsBoolean(@flag), "while null is not a boolean at all");

    // Numbers keep their text, which is what makes them exact.
    var large = JsonValue::Number(allocator, "9007199254740993") catch {
        else => Panic("a large integer is stored")
    };
    var exact: uint64 = 0;
    // Safety: `AsNumber` points at the number payload inside `large`, which is live.
    Assert(unsafe { (*large.AsNumber()).AsUint64(@exact) }, "and reads back as an unsigned integer");
    Assert(exact == 9007199254740993,
           "exactly -- one past two to the fifty-third, which a double would have rounded away");
    var asFloat = 0.0;
    // Safety: `AsNumber` points at the number payload inside `large`, which is live.
    Assert(unsafe { (*large.AsNumber()).AsFloat64(@asFloat) }, "it also reads as a float");
    Assert((asFloat as uint64) != 9007199254740993,
           "and that reading loses the last digit, which is why the exact one is offered separately");

    var written = JsonValue::Number(allocator, "1.2000") catch { else => Panic("1.2000 is stored") };
    // Safety: `AsNumber` points at the number payload inside `written`, which is live.
    let writtenText = unsafe { (*written.AsNumber()).Text() };
    let expectedText = View("1.2000");
    Assert(writtenText.Equals(expectedText), "a number keeps the text it was written with, trailing zeros too");

    // Integral means no fraction and no exponent, which is a statement about the text rather than the value.
    var whole = JsonValue::Number(allocator, "42") catch { else => Panic("42 is stored") };
    var pointZero = JsonValue::Number(allocator, "42.0") catch { else => Panic("42.0 is stored") };
    var exponent = JsonValue::Number(allocator, "4.2e1") catch { else => Panic("4.2e1 is stored") };
    // Safety: `AsNumber` points at the number payload inside `whole`, which is live.
    Assert(unsafe { (*whole.AsNumber()).IsIntegral() }, "42 is integral");
    // Safety: `AsNumber` points at the number payload inside `pointZero`, which is live.
    Assert(!unsafe { (*pointZero.AsNumber()).IsIntegral() }, "42.0 is not, though its value is whole");
    // Safety: `AsNumber` points at the number payload inside `exponent`, which is live.
    Assert(!unsafe { (*exponent.AsNumber()).IsIntegral() }, "and neither is 4.2e1");
    var pointZeroAsInt: int64 = 0;
    // Safety: `AsNumber` points at the number payload inside `pointZero`, which is live.
    Assert(!unsafe { (*pointZero.AsNumber()).AsInt64(@pointZeroAsInt) },
           "so 42.0 does not read as an integer, which keeps a distinction the document was making");
    var floatValue = 0.0;
    // Safety: `AsNumber` points at the number payload inside `pointZero`, which is live.
    Assert(unsafe { (*pointZero.AsNumber()).AsFloat64(@floatValue) } && floatValue == 42.0,
           "while it reads fine as a float");

    var negative = JsonValue::Number(allocator, "-9223372036854775808") catch {
        else => Panic("the most negative signed integer is stored")
    };
    var signedValue: int64 = 0;
    // Safety: `AsNumber` points at the number payload inside `negative`, which is live.
    Assert(unsafe { (*negative.AsNumber()).AsInt64(@signedValue) } && signedValue == -9223372036854775808i64,
           "the most negative signed integer reads back exactly");
    var negativeAsUnsigned: uint64 = 0;
    // Safety: `AsNumber` points at the number payload inside `negative`, which is live.
    Assert(!unsafe { (*negative.AsNumber()).AsUint64(@negativeAsUnsigned) }, "and does not read as unsigned");

    // A number made by hand is held to the grammar a parsed one is, so nothing the tree holds is a number only this
    // package would read.
    Assert(RefusedNumber(allocator, "01"), "a leading zero is refused");
    Assert(RefusedNumber(allocator, "-01"), "after a minus too");
    Assert(RefusedNumber(allocator, "1e"), "an exponent with no digits is refused");
    Assert(RefusedNumber(allocator, "1e+"), "and so is one with only a sign");
    Assert(RefusedNumber(allocator, "1E-"), "in either case");
    Assert(RefusedNumber(allocator, "-"), "a lone minus is refused");
    Assert(RefusedNumber(allocator, "+1"), "a leading plus is refused");
    Assert(RefusedNumber(allocator, "--1"), "a doubled minus is refused");
    Assert(RefusedNumber(allocator, "--"), "and so is a pair of them alone");
    Assert(RefusedNumber(allocator, "e"), "an exponent with no number is refused");
    Assert(RefusedNumber(allocator, "e5"), "even with digits after it");
    Assert(RefusedNumber(allocator, ".5"), "a fraction with no integer part is refused");
    Assert(RefusedNumber(allocator, "5."), "and an integer part with an empty fraction");
    Assert(RefusedNumber(allocator, "5.e3"), "even when an exponent follows");
    Assert(RefusedNumber(allocator, ""), "empty text is refused");
    Assert(RefusedNumber(allocator, "NaN"), "a NaN is refused");
    Assert(RefusedNumber(allocator, "Infinity"), "and so is an infinity");
    Assert(RefusedNumber(allocator, "-Infinity"), "of either sign");
    Assert(RefusedNumber(allocator, "0x10"), "hexadecimal is refused");
    Assert(RefusedNumber(allocator, " 1"), "space before a number is refused");
    Assert(RefusedNumber(allocator, "1 "), "and after it");
    Assert(RefusedNumber(allocator, "1.5.2"), "a second fraction is refused");
    Assert(RefusedNumber(allocator, "1e5e5"), "and a second exponent");
    Assert(AcceptedNumber(allocator, "0"), "a lone zero is a number");
    Assert(AcceptedNumber(allocator, "-0"), "and so is a negative zero");
    Assert(AcceptedNumber(allocator, "0.5"), "a zero integer part takes a fraction");
    Assert(AcceptedNumber(allocator, "1e10"), "an exponent needs no sign");
    Assert(AcceptedNumber(allocator, "1E-5"), "may be upper case with a minus");
    Assert(AcceptedNumber(allocator, "-1.25e+3"), "and every part together is a number");
    Assert(AcceptedNumber(allocator, "0e0"), "a zero takes an exponent directly");
    Assert(AcceptedNumber(allocator, "10"), "and a zero after the first digit is no leading zero");

    // Strings.
    var text = JsonValue::Text(allocator, "hello") catch { else => Panic("a string is stored") };
    Assert(text.Kind() == JsonKind::Text, "a string is a string");
    let expectedHello = View("hello");
    Assert(text.AsText().Equals(expectedHello), "and reads back");
    Assert(nullValue.AsText().IsEmpty(), "while a non-string reads as empty rather than reinterpreting bytes");

    // Arrays own their elements and keep their order.
    var array = JsonValue::Array(allocator);
    Assert(array.Kind() == JsonKind::Array && array.Length() == 0, "a new array is empty");
    var index: uint = 0;
    while index < 5 {
        var element = JsonValue::Boolean(allocator, (index % 2) == 0);
        Assert(array.Push(<-element), "elements append");
        index = index + 1;
    }
    Assert(array.Length() == 5, "and the array grows");
    index = 0;
    while index < 5 {
        let element = array.At(index);
        Assert(element != null, "every index is reachable");
        var value = false;
        // Safety: `element` is non-null, asserted above, and points into `array`, which is live.
        Assert(unsafe { (*element).AsBoolean(@value) } && value == ((index % 2) == 0),
               "and the elements are in the order they were added");
        index = index + 1;
    }
    Assert(array.At(5) == null, "and one past the end is not");

    // Objects keep insertion order, which is what lets a document be written back recognisably.
    var object = JsonValue::Object(allocator);
    Assert(object.Kind() == JsonKind::Object && object.Length() == 0, "a new object is empty");
    var zetaName = String::FromBytes(allocator, "zeta") catch { else => Panic("a name is built") };
    var zetaValue = JsonValue::Number(allocator, "1") catch { else => Panic("1 is stored") };
    Assert(object.Insert(move zetaName, <-zetaValue), "a member inserts");
    var alphaName = String::FromBytes(allocator, "alpha") catch { else => Panic("a name is built") };
    var alphaValue = JsonValue::Number(allocator, "2") catch { else => Panic("2 is stored") };
    Assert(object.Insert(move alphaName, <-alphaValue), "and another");
    var muName = String::FromBytes(allocator, "mu") catch { else => Panic("a name is built") };
    var muValue = JsonValue::Text(allocator, "found") catch { else => Panic("a string is stored") };
    Assert(object.Insert(move muName, <-muValue), "and a third");
    Assert(object.Length() == 3, "and the object grows");

    let firstMember = object.MemberAt(0);
    let zeta = View("zeta");
    // Safety: `firstMember` is dereferenced only when it is non-null, and it points into `object`, which is live.
    Assert(firstMember != null && unsafe { firstMember.name.View().Equals(zeta) },
           "the first member is the first one added, not the alphabetically first");
    let secondMember = object.MemberAt(1);
    let alpha = View("alpha");
    // Safety: `secondMember` is dereferenced only when it is non-null, and it points into `object`, which is live.
    Assert(secondMember != null && unsafe { secondMember.name.View().Equals(alpha) }, "and insertion order is kept");

    // Lookup by name.
    let mu = View("mu");
    let found = object.Find(mu);
    // Safety: `found` is dereferenced only when it is non-null, and it points into `object`, which is live.
    Assert(found != null && unsafe { (*found).Kind() } == JsonKind::Text, "a member is found by name");
    let foundText = View("found");
    // Safety: `found` is non-null, asserted above, and points into `object`, which is live.
    Assert(unsafe { (*found).AsText().Equals(foundText) }, "with the value it was given");
    let missing = View("absent");
    Assert(object.Find(missing) == null, "and a name that is not there is not found");
    Assert(array.Find(mu) == null, "looking for a member in an array finds nothing rather than misreading it");

    // Wrong-kind accessors report failure rather than reinterpreting.
    Assert(array.At(0) != null && object.At(0) == null, "indexing works on arrays and not on objects");
    Assert(object.MemberAt(0) != null && array.MemberAt(0) == null, "and members the other way round");
    Assert(nullValue.Length() == 0 && text.Length() == 0, "a scalar has no length");
    var pushRefused = JsonValue::Null(allocator);
    Assert(!nullValue.Push(<-pushRefused), "pushing into a scalar is refused rather than ignored");

    return 0;
}
