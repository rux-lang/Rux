// Writing is checked by round-tripping and by the exact text of the escapes, since an escape that is merely
// legal rather than conventional makes output differ from every other writer for no benefit.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Result, Unit };
import Format::{ TextWriter };
import Json::{ JsonKind, JsonStyle, JsonValue, Parse, WriteValue };
import Text::{ BufferWriter, FormatError, String, StringBuilder, StringView, TextError };

func View(bytes: char8[..]) -> StringView {
    return StringView::FromBytes(bytes).ValueOr(StringView());
}

// Writes a value and returns the text. `outcome` receives whether it went out; which failure it was, when it did
// not, is checked by `RefusedAs` instead.
func Written(allocator: Allocator, value: &JsonValue, style: JsonStyle, outcome: *var bool) -> String {
    var builder = StringBuilder(allocator);
    let sink: &var TextWriter = builder;
    *outcome = WriteValue(sink, value, style).IsSuccess();
    return builder.IntoString();
}

// Whether writing refused for the named reason. The failures are the ones every writer in this workspace reports
// now, rather than a status this package invented with one case standing for every destination.
func RefusedAs(allocator: Allocator, value: &JsonValue, style: JsonStyle, expected: &FormatError) -> bool {
    var builder = StringBuilder(allocator);
    let sink: &var TextWriter = builder;
    let outcome = WriteValue(sink, value, style);
    var discarded = builder.IntoString();
    return SameFailure(outcome, expected);
}

func SameFailure(outcome: &Result<Unit, FormatError>, expected: &FormatError) -> bool {
    return match outcome {
        .Success(_) => false,
        .Error(reason) => CaseOf(reason) == CaseOf(expected)
    };
}

// A number standing for each case, so two failures can be compared without an equality operator on the variant.
func CaseOf(reason: &FormatError) -> int32 {
    return match reason {
        .InvalidSpecification(_) => 1i32,
        .UnsupportedRequest => 2i32,
        .ArgumentCountMismatch(_, _) => 3i32,
        .InsufficientCapacity => 4i32,
        .ValueOutOfRange => 5i32,
        .TextFailure(_) => 6i32,
        .WriterFailure => 7i32
    };
}

// A document this test knows is well-formed, which is every one of them: what is under test here is the writer.
func Parsed(allocator: Allocator, text: char8[..]) -> JsonValue {
    var outcome = Parse(allocator, text);
    var value = JsonValue::Null(allocator);
    Assert((<-outcome).TryIntoValue(@value), "the document parses");
    return <-value;
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    var wrote = false;

    // The scalars.
    var nullValue = Parsed(allocator, "null");
    var nullText = Written(allocator, nullValue, JsonStyle::Compact(), @wrote);
    let expectNull = View("null");
    Assert(wrote && nullText.View().Equals(expectNull), "null writes as null");

    var number = Parsed(allocator, "-1.5e3");
    var numberText = Written(allocator, number, JsonStyle::Compact(), @wrote);
    let expectNumber = View("-1.5e3");
    Assert(numberText.View().Equals(expectNumber),
           "a number writes exactly as it was written, since its text was kept");

    // Escapes: the required ones and no others.
    var escaped = Parsed(allocator, "\"a\\nb\\t\"");
    var escapedText = Written(allocator, escaped, JsonStyle::Compact(), @wrote);
    let expectEscaped = View("\"a\\nb\\t\"");
    Assert(escapedText.View().Equals(expectEscaped), "and writes back with the short escapes");

    var solidus = Parsed(allocator, "\"a\\/b\"");
    var solidusText = Written(allocator, solidus, JsonStyle::Compact(), @wrote);
    let expectSolidus = View("\"a/b\"");
    Assert(solidusText.View().Equals(expectSolidus),
           "a solidus is written unescaped, which is legal and is what every other writer does");

    var control = Parsed(allocator, "\"a\\u0001b\"");
    var controlText = Written(allocator, control, JsonStyle::Compact(), @wrote);
    let expectControl = View("\"a\\u0001b\"");
    Assert(controlText.View().Equals(expectControl),
           "a control character with no short escape takes the four-digit form");

    // Compact output has no whitespace anywhere.
    var document = Parsed(allocator, "{\"a\":[1,2],\"b\":{\"c\":true}}");
    var compact = Written(allocator, document, JsonStyle::Compact(), @wrote);
    let expectCompact = View("{\"a\":[1,2],\"b\":{\"c\":true}}");
    Assert(compact.View().Equals(expectCompact), "and writes back byte for byte in the compact style");

    // Pretty output round-trips to the same value, which is the property that matters — the exact layout is a
    // presentation choice and the equality of the values is not.
    var pretty = Written(allocator, document, JsonStyle::Pretty(), @wrote);
    Assert(wrote, "the pretty style writes");
    Assert(pretty.Length() > compact.Length(), "producing more bytes, since it adds layout");
    var reparsed = Parsed(allocator, pretty.View().Bytes());
    var reflattened = Written(allocator, reparsed, JsonStyle::Compact(), @wrote);
    Assert(reflattened.View().Equals(expectCompact), "to exactly the document it started as");

    // Empty containers stay on one line even when indenting.
    var empties = Parsed(allocator, "{\"a\":[],\"b\":{}}");
    var prettyEmpties = Written(allocator, empties, JsonStyle::Pretty(), @wrote);
    let expectEmpties = View("{\n  \"a\": [],\n  \"b\": {}\n}");
    Assert(prettyEmpties.View().Equals(expectEmpties),
           "an empty container is not spread over three lines, since a line holding a bracket says nothing");

    // A non-finite number cannot be written, because JSON cannot spell one.
    var textError = TextError::None;
    let outOfRange = FormatError::ValueOutOfRange;
    var notANumber = JsonValue::Number(allocator, "NaN", @textError);
    Assert(RefusedAs(allocator, notANumber, JsonStyle::Compact(), outOfRange),
           "a NaN is refused as a value the requested form cannot hold");
    var infinite = JsonValue::Number(allocator, "Infinity", @textError);
    Assert(RefusedAs(allocator, infinite, JsonStyle::Compact(), outOfRange), "and so is an infinity");
    var ordinary = JsonValue::Number(allocator, "1e999", @textError);
    var written999 = Written(allocator, ordinary, JsonStyle::Compact(), @wrote);
    Assert(wrote,
           "while an exponent past what a float holds is still a number JSON can spell, and is written");

    // A destination that runs out of room says which of the two things went wrong. This is what the old shape
    // could not do: every destination failure was one case called `Failed`, so a buffer that was merely full and a
    // stream that had died arrived identically, and a caller who could have written the document somewhere larger
    // had no way to tell that was the problem.
    var wholeDocument = Parsed(allocator, "{\"a\":[1,2],\"b\":{\"c\":true}}");
    var room: char8[8];
    var bounded = BufferWriter((@room[0])[..8]);
    let boundedSink: &var TextWriter = bounded;
    let overflowed = WriteValue(boundedSink, wholeDocument, JsonStyle::Compact());
    let full = FormatError::InsufficientCapacity;
    Assert(SameFailure(overflowed, full), "a destination without room reports being full, not merely failing");
    Assert(bounded.Length() <= 8u, "having written no more than it had");

    // And the whole document goes out when there is room, so the check above is about the bound rather than about
    // a writer that refuses everything.
    var enough: char8[64];
    var roomy = BufferWriter((@enough[0])[..64]);
    let roomySink: &var TextWriter = roomy;
    Assert(WriteValue(roomySink, wholeDocument, JsonStyle::Compact()).IsSuccess(),
           "the same document writes whole into a destination that has room");
    Assert(roomy.Length() == 26u, "all twenty-six bytes of it");

    return 0;
}
