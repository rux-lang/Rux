// Strictness is the point, so most of this is documents that must be refused — and the ones worth writing down
// are the ones that are perfectly good JavaScript and are not JSON.
// A refusal is checked by its debug rendering, which names the case and the byte it happened at:
// `JsonParseError::Truncated(4)`. That is one assertion covering three things — that the right case was reported,
// that it was positioned where the document actually goes wrong, and that the failure can say so — and the
// position is the half that was easiest to get wrong while it lived in a structure beside the value.
// A refused parse hands back no value at all. That is the point of the shape: the old one answered a refusal with
// `null`, which is a perfectly good document, so a caller who forgot to read the outcome could not tell a document
// that said nothing from one that was not a document.

import Allocator::{ AllocError, Allocator, Layout, SystemAllocator };
import Core::{ Assert, Panic };
import Json::{
    DuplicateKeyPolicy, JsonKind, JsonLexError, JsonLimits, JsonMember, JsonNumber, JsonParseError, JsonParser,
    JsonValue, Parse, ParseWith
};
import Text::{ BufferWriter, FormatSpec, StringView, TextError, TextWriter };

func View(bytes: char8[..]) -> StringView {
    return StringView::FromBytes(bytes) ?? StringView();
}

// The number a value holds, which the test has just made it hold.
func Number(value: &JsonValue) -> &JsonNumber {
    return value.AsNumber() ?? Panic("the value is a number");
}

// The value of the member named `name`, which the test has just seen the object hold.
func Member(object: &JsonValue, name: StringView) -> &JsonValue {
    return object.Find(name) ?? Panic("the object holds the member");
}

// The member at `index`, which the test has just seen the object hold.
func MemberOf(object: &JsonValue, index: uint) -> &JsonMember {
    return object.MemberAt(index) ?? Panic("the object holds the member");
}

func Same(actual: char8[..], expected: char8[..]) -> bool {
    if actual.length != expected.length { return false; }
    var index: uint = 0;
    while index < actual.length {
        if actual[index] != expected[index] { return false; }
        index = index + 1;
    }
    return true;
}

// The debug rendering of a failure, into a caller's buffer, and how much of it was written. Empty for a parse that
// succeeded, which no case below expects.
func Rendered(reason: &JsonParseError, into: var char8[..]) -> uint {
    var writer = BufferWriter(into);
    let sink: &var TextWriter = writer;
    Assert((try? reason.WriteDebug(sink, FormatSpec::Plain())) is .Some(_), "a failure renders");
    return writer.Length();
}

// Parses, requires a refusal, and checks its rendering — the case and the offset together.
func Refuses(allocator: Allocator, text: char8[..], expected: char8[..], what: char8[..]) {
    try {
        Parse(allocator, text);
        Assert(false, what);
    } catch {
        refusal => Assert(Refusal(refusal, expected), what),
    }
}

func Accepts(allocator: Allocator, text: char8[..], what: char8[..]) -> JsonValue {
    return try Parse(allocator, text) catch { _ => Panic(what) };
}

// Whether an outcome a caller already holds is the refusal it should be, rendering and all.
func Refusal(reason: JsonParseError, expected: char8[..]) -> bool {
    var storage: char8[96];
    let length = Rendered(reason, storage[..96]);
    return Same(storage[..length], expected);
}

// A parser used directly, for the cases that need a limit or a policy the one-call form does not take.
func Built(allocator: Allocator, parser: &var JsonParser, what: char8[..]) -> JsonValue {
    return try parser.Parse() catch { _ => Panic(what) };
}


// An allocator that counts what is out, so a refused parse can be checked for having given back everything it took
// before it stopped. Everything mutable lives behind a pointer, since an interface adapter is copied.
struct CountState {
    inner: Allocator;
    live: int32;
}

struct CountingAllocator {
    state: *var CountState;
}

extend CountingAllocator : Allocator {
    func Allocate(&self, layout: Layout) -> *var opaque throws AllocError {
        // Safety: `state` points at the test's local `CountState`, which outlives every use of this allocator.
        let block = try (unsafe { self.state.inner.Allocate(layout) });
        // Safety: `state` points at the test's local `CountState`, which outlives every use of this allocator.
        unsafe { self.state.live = self.state.live + 1; }
        return block;
    }

    func Deallocate(&self, block: *var opaque, layout: Layout) throws AllocError {
        // Safety: `state` points at the test's local `CountState`, which outlives every use of this allocator.
        unsafe { try self.state.inner.Deallocate(block, layout); }
        // Safety: `state` points at the test's local `CountState`, which outlives every use of this allocator.
        unsafe { self.state.live = self.state.live - 1; }
    }

    func Reallocate(&self, block: *var opaque, oldLayout: Layout, newLayout: Layout)
        -> *var opaque throws AllocError {
        // Safety: `state` points at the test's local `CountState`, which outlives every use of this allocator.
        return try unsafe { self.state.inner.Reallocate(block, oldLayout, newLayout) };
    }
}

// A scope for a document, so its destruction happens somewhere the count can be read across. `whileHeld` reports
// what was out while the document was still whole, which is what separates "released" from "never allocated".
func ParseAndDrop(allocator: Allocator, text: char8[..], state: &CountState, whileHeld: &var int32) {
    var kept = Accepts(allocator, text, "a whole document parses");
    whileHeld = state.live;
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // The scalars.
    var nullValue = Accepts(allocator, "null", "null parses");
    Assert(nullValue.IsNull(), "as null");
    var trueValue = Accepts(allocator, "true", "true parses");
    Assert(trueValue.AsBoolean() is .Some(true), "as true");
    var number = Accepts(allocator, "-1.5e3", "a number parses");
    Assert(number.Kind() == JsonKind::Number, "as a number");
    var text = Accepts(allocator, "\"hello\"", "a string parses");
    let hello = View("hello");
    Assert(text.AsText() is .Some(t) && t.Equals(hello), "with its contents");

    // Containers.
    var array = Accepts(allocator, "[1,2,3]", "an array parses");
    Assert(array.Kind() == JsonKind::Array && array.Length() is .Some(3), "with three elements");
    var empty = Accepts(allocator, "[]", "an empty array parses");
    Assert(empty.Length() is .Some(0), "with none");
    var object = Accepts(allocator, "{\"a\":1,\"b\":2}", "an object parses");
    Assert(object.Kind() == JsonKind::Object && object.Length() is .Some(2), "with two members");
    let a = View("a");
    Assert(object.Find(a) is .Some(_), "which are findable by name");
    var emptyObject = Accepts(allocator, "{}", "an empty object parses");
    Assert(emptyObject.Length() is .Some(0), "with none");
    var nested = Accepts(allocator, "{\"a\":{\"b\":[1,{\"c\":null}]}}", "a nested document parses");
    Assert(nested.Length() is .Some(1), "and holds its structure");

    // Escapes are resolved, including the surrogate pairs JSON inherits from UTF-16.
    var escaped = Accepts(allocator, "\"a\\nb\"", "a string with escapes parses");
    Assert(escaped.AsText() is .Some(t) && t.Length() == 3, "and its escapes become the bytes they name");
    var unicode = Accepts(allocator, "\"\\u0041\"", "a unicode escape parses");
    Assert(unicode.AsText() is .Some(t) && t.Length() == 1, "into one byte for an ASCII scalar");
    var astral = Accepts(allocator, "\"\\ud83d\\ude00\"", "a surrogate pair parses");
    Assert(astral.AsText() is .Some(t) && t.Length() == 4, "into the four UTF-8 bytes of one astral character");

    // Half a pair is half a character, and JSON's escapes are the one place a JSON string is not simply scalar
    // values. This used to be handed to the string builder, which refused it as invalid text, and the parser
    // reported that as being out of memory — sending a caller to check the machine over a document that was wrong.
    Refuses(allocator, "\"\\ud83d\"", "JsonParseError::BadSurrogate(1)",
            "a high surrogate with no partner is refused");
    Refuses(allocator, "\"\\udc00x\"", "JsonParseError::BadSurrogate(1)",
            "and a low surrogate standing alone");
    Refuses(allocator, "\"\\ud83dA\"", "JsonParseError::BadSurrogate(1)",
            "and one followed by something that is not its partner");

    // The refusals: a document is one value, and these are all JavaScript rather than JSON.
    Refuses(allocator, "", "JsonParseError::Truncated(0)", "an empty document is not a value");
    Refuses(allocator, "[1,2", "JsonParseError::Truncated(4)", "an unclosed array is truncated");
    Refuses(allocator, "{\"a\":1", "JsonParseError::Truncated(6)", "and so is an unclosed object");
    Refuses(allocator, "[1,]", "JsonParseError::Unexpected(3)", "a trailing comma in an array is refused");
    Refuses(allocator, "{\"a\":1,}", "JsonParseError::Unexpected(7)", "and in an object");
    // An unquoted name never reaches the parser: `a` begins no JSON token, so the lexer refuses it first and
    // the failure is reported as lexical. That is the more precise answer, not a weaker one.
    Refuses(allocator, "{a:1}", "JsonParseError::Lexical(UnexpectedByte, 1)", "an unquoted member name is refused by the lexer");
    Refuses(allocator, "[1 2]", "JsonParseError::Unexpected(3)", "a missing comma is refused");
    Refuses(allocator, "{\"a\" 1}", "JsonParseError::Unexpected(5)", "as is a missing colon");
    Refuses(allocator, "1 2", "JsonParseError::TrailingContent(2)", "two values are not one document");
    Refuses(allocator, "{} []", "JsonParseError::TrailingContent(3)", "however well-formed each is");
    Refuses(allocator, "[1,2] trailing", "JsonParseError::TrailingContent(6)", "and text after a value is refused");

    // Duplicate names are refused by default, because a document containing them means different things to
    // different readers — which is the property that gets exploited.
    Refuses(allocator, "{\"a\":1,\"a\":2}", "JsonParseError::DuplicateName(12)", "a duplicate member name is refused");

    // The other policies exist because real documents contain duplicates and someone has to read them.
    var keepFirstParser = JsonParser(allocator, "{\"a\":1,\"a\":2}", JsonLimits::Default());
    keepFirstParser.SetDuplicatePolicy(DuplicateKeyPolicy::KeepFirst);
    var keptFirst = Built(allocator, keepFirstParser, "keeping the first accepts the document");
    Assert(keptFirst.Length() is .Some(1), "and leaves one member");
    let nameA = View("a");
    // Safety: `keptFirst` holds one member named `a`, so `Find` returns a non-null pointer into it, and
    // `AsNumber` points at that member's number payload.
    Assert(Number(Member(keptFirst, nameA)).AsInt64() is .Some(1),
           "which holds the first value");

    var keepLastParser = JsonParser(allocator, "{\"a\":1,\"a\":2}", JsonLimits::Default());
    keepLastParser.SetDuplicatePolicy(DuplicateKeyPolicy::KeepLast);
    var keptLast = Built(allocator, keepLastParser, "keeping the last accepts it too");
    Assert(keptLast.Length() is .Some(1), "and also leaves one member");
    // Safety: `keptLast` holds one member named `a`, so `Find` returns a non-null pointer into it, and
    // `AsNumber` points at that member's number payload.
    Assert(Number(Member(keptLast, nameA)).AsInt64() is .Some(2),
           "which holds the last value");

    var keepAllParser = JsonParser(allocator, "{\"a\":1,\"a\":2}", JsonLimits::Default());
    keepAllParser.SetDuplicatePolicy(DuplicateKeyPolicy::KeepAll);
    var keptAll = Built(allocator, keepAllParser, "keeping all accepts it");
    Assert(keptAll.Length() is .Some(2), "and keeps both members, so the document is preserved exactly");
    // Safety: `keptAll` holds members named `a`, so `Find` returns a non-null pointer into it, and
    // `AsNumber` points at that member's number payload.
    Assert(Number(Member(keptAll, nameA)).AsInt64() is .Some(1),
           "with lookup finding the first, which is what a reader encounters");

    // Insertion order is kept, which is what lets a document be written back recognisably.
    var ordered = Accepts(allocator, "{\"zeta\":1,\"alpha\":2}", "an object with several members parses");
    let zeta = View("zeta");
    let alpha = View("alpha");
    Assert(MemberOf(ordered, 0).name.View().Equals(zeta), "the first member is the first written");
    Assert(MemberOf(ordered, 1).name.View().Equals(alpha), "and the second the second");

    // The limits, reached through the parser rather than the lexer.
    var shallow = JsonLimits::Default();
    shallow.maximumDepth = 3;
    var deepParser = JsonParser(allocator, "[[[[1]]]]", shallow);
    try {
        deepParser.Parse();
        Assert(false,
           "nesting past the depth limit is refused before the stack is at risk");
    } catch {
        refusal => Assert(Refusal(refusal, "JsonParseError::TooDeep(4)"),
            "nesting past the depth limit is refused before the stack is at risk"),
    }
    var fittingParser = JsonParser(allocator, "[[[1]]]", shallow);
    var fitting = Built(allocator, fittingParser, "while nesting that fits is accepted");

    var few = JsonLimits::Default();
    few.maximumEntries = 2;
    var manyParser = JsonParser(allocator, "[1,2,3]", few);
    try {
        manyParser.Parse();
        Assert(false,
           "a container past the entry limit is refused");
    } catch {
        refusal => Assert(Refusal(refusal, "JsonParseError::TooManyEntries(6)"),
            "a container past the entry limit is refused"),
    }
    var enoughParser = JsonParser(allocator, "[1,2]", few);
    var enough = Built(allocator, enoughParser, "and one that fits is not");

    // A lexical failure carries the lexer's own reason inside it rather than in a second field a caller has to
    // know to read, which is what makes it impossible to hold half of one.
    var badParser = JsonParser(allocator, "[01]", JsonLimits::Default());
    try {
        badParser.Parse();
        Assert(false,
           "a lexical failure keeps the lexer's own reason and its position");
    } catch {
        refusal => Assert(Refusal(refusal, "JsonParseError::Lexical(MalformedNumber, 1)"),
            "a lexical failure keeps the lexer's own reason and its position"),
    }

    // The same choices through the one-call form, which is what most callers will reach for.
    let directAll = try ParseWith(allocator, "{\"a\":1,\"a\":2}", JsonLimits::Default(), DuplicateKeyPolicy::KeepAll)
        catch { _ => Panic("the one-call form honours a chosen policy") };
    Assert(directAll.Length() is .Some(2), "the one-call form honours a chosen policy");
    try {
        ParseWith(allocator, "{\"a\":1,\"a\":2}", JsonLimits::Default(), DuplicateKeyPolicy::Reject);
        Assert(false,
           "and refuses under the default one, so the choice is per call rather than per program");
    } catch {
        refusal => Assert(Refusal(refusal, "JsonParseError::DuplicateName(12)"),
            "and refuses under the default one, so the choice is per call rather than per program"),
    }

    // A refused parse gives back everything it took. This is the half of the shape that is not visible in the
    // types: a document that fails at its third element has already built two, and an object that fails on a
    // duplicate name is holding every member before it. Those were handed back beside the error before, which left
    // a caller holding a partial document; now they are released, and the count is what says so rather than the
    // absence of a crash.
    var state = CountState { inner: allocator, live: 0 };
    var counting = CountingAllocator { state: @state };
    let counted: Allocator = counting;

    Refuses(counted, "[1,2,\"three\",", "JsonParseError::Truncated(13)",
            "an array that fails partway through is refused");
    Assert(state.live == 0, "and everything the partial array held is released");

    Refuses(counted, "{\"a\":[1,2],\"b\":\"x\",\"a\":3}", "JsonParseError::DuplicateName(24)",
            "an object with a duplicate name is refused");
    Assert(state.live == 0, "and everything the partial object held is released");

    Refuses(counted, "[[[\"deep\",1,2],3],", "JsonParseError::Truncated(18)",
            "a nested document that fails is refused");
    Assert(state.live == 0, "and every level of it is released");

    // A document that parses and is then dropped ends at the same count, so the check above is measuring cleanup
    // rather than a parser that never allocated.
    var whileHeld: int32 = 0;
    ParseAndDrop(counted, "[1,2,\"three\"]", state, whileHeld);
    Assert(whileHeld > 0, "and the same document, whole, takes storage");
    Assert(state.live == 0, "which comes back when the document's life ends");

    // Insertion order survives everything, including a document whose names are already sorted the other way.
    var reversed = Accepts(allocator, "{\"three\":3,\"two\":2,\"one\":1}", "a reverse-sorted object parses");
    let three = View("three");
    let two = View("two");
    let one = View("one");
    Assert(MemberOf(reversed, 0).name.View().Equals(three), "with its first member first");
    Assert(MemberOf(reversed, 1).name.View().Equals(two), "its second second");
    Assert(MemberOf(reversed, 2).name.View().Equals(one), "and its third third");


    // A string carrying an escape and a raw character outside ASCII: the two together are what caught a
    // builder being fed one byte at a time, which refused half of a multi-byte scalar and dropped it.
    var accented = Accepts(allocator, "\"caf\u{E9}\\ttab\"",
                           "a string with an escape and an accent");
    Assert(accented.AsText() is .Some(t) && t.Length() == 9, "keeps the accent as well as the escape");
    return 0;
}
