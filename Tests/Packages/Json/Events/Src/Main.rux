// Streaming exists so a large document costs little, so the test that matters is the one measuring cost: a
// document far larger than the buffer must stream through it without the buffer growing.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Failed, Panic };
import Io::{ IoError, IoErrorKind, Reader };
import Json::{ JsonEvent, JsonEventReader, JsonLimits, JsonParseError };
import Text::{ BufferWriter, FormatSpec, TextWriter };

// The bytes a string spans, which is how a caller holding text reaches an entry point that takes bytes.
func TextBytes(text: char8[..]) -> char8[..] {
    return (text.data)[..text.length];
}

// A reader serving a fixed slice a few bytes at a time, so token boundaries fall inside reads.
struct SliceState {
    bytes: char8[..];
    offset: uint;
    step: uint;
}

struct SliceHandle {
    state: *var SliceState;
}

extend SliceHandle : Reader {
    func Read(self: &var SliceHandle, into: var char8[..]) -> uint ! IoError {
        let state = self.state;
        let remaining = state.bytes.length - state.offset;
        if remaining == 0 { fail IoError::Of(IoErrorKind::EndOfStream); }
        var give = remaining < state.step ? remaining : state.step;
        if into.length < give {
            give = into.length;
        }
        var index: uint = 0;
        while index < give {
            into.data[index] = state.bytes.data[state.offset + index];
            index = index + 1;
        }
        state.offset = state.offset + give;
        return give;
    }
}

// Whether a reader stopped for the named reason. The rendering carries the position too, which is checked by the
// parser test against exact documents; here what matters is that a streaming reader reports the same cases a
// whole-document parse does, and that it reports them through the same positioned failure rather than through a
// pair of fields a caller has to read in the right order.
func StoppedAt(failure: JsonParseError?, expected: char8[..]) -> bool {
    let reason = failure ?? return false;
    var storage: char8[96];
    var writer = BufferWriter((@storage[0])[..96]);
    let sink: &var TextWriter = writer;
    if Failed(reason.WriteDebug(sink, FormatSpec::Plain())) { return false; }
    let shown = writer.Written();
    if shown.length < expected.length { return false; }
    var index: uint = 0;
    while index < expected.length {
        if shown.data[index] != expected.data[index] { return false; }
        index = index + 1;
    }
    // What follows the case name is its offset in parentheses, which this check deliberately does not pin.
    return shown.data[expected.length] == c8'(';
}

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // A small document, event by event, served three bytes at a time so every token straddles a read.
    var state = SliceState { bytes: TextBytes("{\"name\":42,\"list\":[true,null,\"x\"]}"), offset: 0, step: 3 };
    let handle: Reader = SliceHandle { state: @state };
    var reader = JsonEventReader::New(allocator, handle, JsonLimits::Default()) catch {
        else => Panic("the reader starts")
    };
    Assert(reader.Next() == JsonEvent::ObjectStart, "the object opens");
    Assert(reader.Depth() == 1, "and the depth follows");
    Assert(reader.Next() == JsonEvent::Name, "a member name arrives");
    Assert(reader.Text().length == 4, "with its text");
    Assert(reader.Next() == JsonEvent::Number, "then its value");
    Assert(reader.Text().length == 2, "as a number, text intact across the reads");
    Assert(reader.Next() == JsonEvent::Name, "a second name");
    Assert(reader.Next() == JsonEvent::ArrayStart, "opening an array");
    Assert(reader.Depth() == 2, "nested one deeper");
    Assert(reader.Next() == JsonEvent::True, "a literal");
    Assert(reader.Next() == JsonEvent::Null, "another");
    Assert(reader.Next() == JsonEvent::Text, "and a string");
    Assert(reader.Next() == JsonEvent::ArrayEnd, "the array closes");
    Assert(reader.Next() == JsonEvent::ObjectEnd, "the object closes");
    Assert(reader.Depth() == 0, "back to the top");
    Assert(reader.Next() == JsonEvent::End, "and the document ends");
    Assert(!(reader.Failure() is JsonParseError), "with nothing wrong");
    reader.Release();

    // The point of streaming: a document far larger than the buffer streams through it. Ten thousand records,
    // read four bytes at a time, with nothing kept but the current token.
    var big: char8[120000];
    var written: uint = 0;
    big[written] = 0x5Bu8 as char8;
    written = written + 1;
    var record: uint = 0;
    while record < 10000 {
        if record > 0 {
            big[written] = 0x2Cu8 as char8;
            written = written + 1;
        }
        var digits = record;
        var scratch: char8[8];
        var count: uint = 0;
        if digits == 0 {
            scratch[0] = 0x30u8 as char8;
            count = 1;
        }
        while digits > 0 {
            scratch[count] = ((0x30 + (digits % 10) as uint8)) as char8;
            count = count + 1;
            digits = digits / 10;
        }
        while count > 0 {
            count = count - 1;
            big[written] = scratch[count];
            written = written + 1;
        }
        record = record + 1;
    }
    big[written] = 0x5Du8 as char8;
    written = written + 1;

    var bigState = SliceState { bytes: (@big[0])[..written], offset: 0, step: 4 };
    let bigHandle: Reader = SliceHandle { state: @bigState };
    var bigReader = JsonEventReader::New(allocator, bigHandle, JsonLimits::Default()) catch {
        else => Panic("the streaming reader starts")
    };
    Assert(bigReader.Next() == JsonEvent::ArrayStart, "the array opens");
    var seen: uint = 0;
    var event = bigReader.Next();
    while event == JsonEvent::Number {
        seen = seen + 1;
        event = bigReader.Next();
    }
    Assert(seen == 10000, "every record arrives as an event");
    Assert(event == JsonEvent::ArrayEnd, "and the array closes");
    Assert(bigReader.Next() == JsonEvent::End, "leaving the document finished");
    Assert(!(bigReader.Failure() is JsonParseError), "with nothing wrong");
    bigReader.Release();

    // Structural mistakes are still caught, which a reader that only emitted tokens would leave to the caller.
    var mismatchedState = SliceState { bytes: TextBytes("{\"a\":1]"), offset: 0, step: 16 };
    let mismatchedHandle: Reader = SliceHandle { state: @mismatchedState };
    var mismatched = JsonEventReader::New(allocator, mismatchedHandle, JsonLimits::Default()) catch {
        else => Panic("the reader starts")
    };
    Assert(mismatched.Next() == JsonEvent::ObjectStart, "the object opens");
    Assert(mismatched.Next() == JsonEvent::Name, "a name arrives");
    Assert(mismatched.Next() == JsonEvent::Number, "and a value");
    Assert(mismatched.Next() == JsonEvent::Error, "and a bracket closing a brace is refused");
    Assert(StoppedAt(mismatched.Failure(), "JsonParseError::Unexpected"), "as a structural mistake");
    mismatched.Release();

    // Depth is bounded here as it is in the tree parser.
    var shallow = JsonLimits::Default();
    shallow.maximumDepth = 2;
    var deepState = SliceState { bytes: TextBytes("[[[1]]]"), offset: 0, step: 16 };
    let deepHandle: Reader = SliceHandle { state: @deepState };
    var deep = JsonEventReader::New(allocator, deepHandle, shallow) catch { else => Panic("the reader starts") };
    Assert(deep.Next() == JsonEvent::ArrayStart, "the first level opens");
    Assert(deep.Next() == JsonEvent::ArrayStart, "and the second");
    Assert(deep.Next() == JsonEvent::Error, "and the third is refused");
    Assert(StoppedAt(deep.Failure(), "JsonParseError::TooDeep"), "for being too deep");
    deep.Release();

    return 0;
}
