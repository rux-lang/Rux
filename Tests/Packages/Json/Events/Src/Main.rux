// Streaming exists so a large document costs little, so the test that matters is the one measuring cost: a
// document far larger than the buffer must stream through it without the buffer growing.

import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Io::{ IoError, IoErrorKind, Reader };
import Json::{ JsonEvent, JsonEventReader, JsonLimits, JsonParseError, JsonReadError, Parse };
import Text::{ BufferWriter, FormatSpec, TextWriter };

// The bytes a string spans, which is how a caller holding text reaches an entry point that takes bytes.
func TextBytes(text: char8[..]) -> char8[..] {
    return text;
}

// A reader serving a fixed slice a few bytes at a time, so token boundaries fall inside reads.
struct SliceState {
    bytes: char8[..];
    offset: uint;
    step: uint;
}

struct SliceHandle {
    state: *var SliceState;
}

extend SliceHandle : Reader {
    func Read(&var self, into: var char8[..]) -> uint throws IoError {
        let state = self.state;
        // Safety: `state` points at the test's local `SliceState`, which outlives every read through it.
        let current = unsafe { *state };
        let remaining = current.bytes.length - current.offset;
        if remaining == 0 { throw IoError::Of(IoErrorKind::EndOfStream); }
        var give = if remaining < current.step { remaining } else { current.step };
        if into.length < give {
            give = into.length;
        }
        var index: uint = 0;
        while index < give {
            into[index] = current.bytes[current.offset + index];
            index = index + 1;
        }
        // Safety: `state` points at the test's local `SliceState`, which outlives every read through it.
        unsafe { state.offset = current.offset + give; }
        return give;
    }
}

// A reader that serves its slice four bytes at a time and then, instead of ending, fails as a broken stream does.
struct BrokenHandle {
    state: *var SliceState;
}

extend BrokenHandle : Reader {
    func Read(&var self, into: var char8[..]) -> uint throws IoError {
        let state = self.state;
        // Safety: `state` points at the test's local `SliceState`, which outlives every read through it.
        let current = unsafe { *state };
        let remaining = current.bytes.length - current.offset;
        if remaining == 0 { throw IoError { kind: IoErrorKind::PermissionDenied, raw: 13 }; }
        var give = if remaining < current.step { remaining } else { current.step };
        if into.length < give {
            give = into.length;
        }
        var index: uint = 0;
        while index < give {
            into[index] = current.bytes[current.offset + index];
            index = index + 1;
        }
        // Safety: `state` points at the test's local `SliceState`, which outlives every read through it.
        unsafe { state.offset = current.offset + give; }
        return give;
    }
}

// Whether the next event arrives and is `expected`.
func Arrives(reader: &var JsonEventReader, expected: JsonEvent) -> bool {
    let event = try reader.Next() catch { _ => return false };
    return event is .Some(arrived) && arrived == expected;
}

// Whether the document ends at the next call, with nothing wrong.
func Ends(reader: &var JsonEventReader) -> bool {
    let event = try reader.Next() catch { _ => return false };
    return event is none;
}

// The error the next call throws, or `none` when an event arrives or the document ends.
func Thrown(reader: &var JsonEventReader) -> JsonReadError? {
    try {
        reader.Next();
    } catch {
        error => { return error; }
    }
    return none;
}

// The error that stops a reader over `text`, served three bytes at a time, after whatever events arrive first.
func Refusal(allocator: Allocator, text: char8[..]) -> JsonReadError? {
    var state = SliceState { bytes: text, offset: 0, step: 3 };
    var handle = SliceHandle { state: @state };
    // Safety: `handle` is a local of this function that outlives every use of the handle.
    var reader = JsonEventReader(allocator, unsafe { @handle as Reader }, JsonLimits::Default());
    var steps: uint = 0;
    while steps < 64 {
        let event = try reader.Next() catch { error => return error };
        if event is none { return none; }
        steps = steps + 1;
    }
    return none;
}

// How a failure renders: its case and, in parentheses, its offset.
func Rendered(failure: &JsonParseError, writer: &var BufferWriter) -> char8[..] {
    let sink: &var TextWriter = writer;
    if (try? failure.WriteDebug(sink, FormatSpec::Plain())) is none { return ""; }
    return writer.Written();
}

// Whether a reader stopped for the named reason. The rendering carries the position too, which is checked by the
// parser test against exact documents; here what matters is that a streaming reader reports the same cases a
// whole-document parse does, through the same positioned failure.
func StoppedAt(failure: JsonReadError?, expected: char8[..]) -> bool {
    let thrown = failure ?? return false;
    let reason = match thrown { .Malformed(reason) => reason, .Source(_, _) => return false };
    var storage: char8[96];
    var writer = BufferWriter(storage[..96]);
    let shown = Rendered(reason, writer);
    if shown.length <= expected.length { return false; }
    var index: uint = 0;
    while index < expected.length {
        if shown[index] != expected[index] { return false; }
        index = index + 1;
    }
    // What follows the case name is its offset in parentheses, which this check deliberately does not pin.
    return shown[expected.length] == c8'(';
}

// Whether the reader refuses `text` with exactly the case and offset the tree parser reports for it.
func SameAsParser(allocator: Allocator, text: char8[..]) -> bool {
    let thrown = Refusal(allocator, text) ?? return false;
    let streamed = match thrown { .Malformed(reason) => reason, .Source(_, _) => return false };
    var parsedValue = try? Parse(allocator, text);
    if parsedValue is .Some(_) { return false; }
    var parsed = JsonParseError::Unexpected(0);
    try {
        Parse(allocator, text);
    } catch {
        error => { parsed = error; }
    }
    var streamedStorage: char8[96];
    var streamedWriter = BufferWriter(streamedStorage[..96]);
    var parsedStorage: char8[96];
    var parsedWriter = BufferWriter(parsedStorage[..96]);
    let left = Rendered(streamed, streamedWriter);
    let right = Rendered(parsed, parsedWriter);
    if left.length == 0 || left.length != right.length { return false; }
    var index: uint = 0;
    while index < left.length {
        if left[index] != right[index] { return false; }
        index = index + 1;
    }
    return true;
}

func Main() -> int {
    let allocator = SystemAllocator();

    // A small document, event by event, served three bytes at a time so every token straddles a read.
    var state = SliceState { bytes: TextBytes("{\"name\":42,\"list\":[true,null,\"x\"]}"), offset: 0, step: 3 };
    var handle = SliceHandle { state: @state };
    // Safety: `handle` is a local of this function that outlives every use of the handle.
    var reader = JsonEventReader(allocator, unsafe { @handle as Reader }, JsonLimits::Default());
    Assert(Arrives(reader, JsonEvent::ObjectStart), "the object opens");
    Assert(reader.Depth() == 1, "and the depth follows");
    Assert(Arrives(reader, JsonEvent::Name), "a member name arrives");
    Assert(reader.Text().length == 4, "with its text");
    Assert(Arrives(reader, JsonEvent::Number), "then its value");
    Assert(reader.Text().length == 2, "as a number, text intact across the reads");
    Assert(Arrives(reader, JsonEvent::Name), "a second name");
    Assert(Arrives(reader, JsonEvent::ArrayStart), "opening an array");
    Assert(reader.Depth() == 2, "nested one deeper");
    Assert(Arrives(reader, JsonEvent::True), "a literal");
    Assert(Arrives(reader, JsonEvent::Null), "another");
    Assert(Arrives(reader, JsonEvent::Text), "and a string");
    Assert(Arrives(reader, JsonEvent::ArrayEnd), "the array closes");
    Assert(Arrives(reader, JsonEvent::ObjectEnd), "the object closes");
    Assert(reader.Depth() == 0, "back to the top");
    Assert(Ends(reader), "and the document ends with nothing wrong");
    Assert(Ends(reader), "and stays ended");
    reader.Release();

    // The point of streaming: a document far larger than the buffer streams through it. Ten thousand records,
    // read four bytes at a time, with nothing kept but the current token.
    var big: char8[120000];
    var written: uint = 0;
    big[written] = 0x5Bu8 as char8;
    written = written + 1;
    var record: uint = 0;
    while record < 10000 {
        if record > 0 {
            big[written] = 0x2Cu8 as char8;
            written = written + 1;
        }
        var digits = record;
        var scratch: char8[8];
        var count: uint = 0;
        if digits == 0 {
            scratch[0] = 0x30u8 as char8;
            count = 1;
        }
        while digits > 0 {
            scratch[count] = ((0x30 + (digits % 10) as uint8)) as char8;
            count = count + 1;
            digits = digits / 10;
        }
        while count > 0 {
            count = count - 1;
            big[written] = scratch[count];
            written = written + 1;
        }
        record = record + 1;
    }
    big[written] = 0x5Du8 as char8;
    written = written + 1;

    var bigState = SliceState { bytes: big[..written], offset: 0, step: 4 };
    var bigHandle = SliceHandle { state: @bigState };
    // Safety: `bigHandle` is a local of this function that outlives every use of the handle.
    var bigReader = JsonEventReader(allocator, unsafe { @bigHandle as Reader }, JsonLimits::Default());
    Assert(Arrives(bigReader, JsonEvent::ArrayStart), "the array opens");
    var seen: uint = 0;
    while Arrives(bigReader, JsonEvent::Number) {
        seen = seen + 1;
    }
    Assert(seen == 10000, "every record arrives as an event, and the array then closes");
    Assert(Ends(bigReader), "leaving the document finished with nothing wrong");
    bigReader.Release();

    // Structural mistakes are still caught, which a reader that only emitted tokens would leave to the caller.
    var mismatchedState = SliceState { bytes: TextBytes("{\"a\":1]"), offset: 0, step: 16 };
    var mismatchedHandle = SliceHandle { state: @mismatchedState };
    // Safety: `mismatchedHandle` is a local of this function that outlives every use of the handle.
    var mismatched = JsonEventReader(allocator, unsafe { @mismatchedHandle as Reader }, JsonLimits::Default());
    Assert(Arrives(mismatched, JsonEvent::ObjectStart), "the object opens");
    Assert(Arrives(mismatched, JsonEvent::Name), "a name arrives");
    Assert(Arrives(mismatched, JsonEvent::Number), "and a value");
    Assert(StoppedAt(Thrown(mismatched), "JsonParseError::Unexpected"),
           "and a bracket closing a brace is refused as a structural mistake");
    mismatched.Release();

    // Depth is bounded here as it is in the tree parser.
    var shallow = JsonLimits::Default();
    shallow.maximumDepth = 2;
    var deepState = SliceState { bytes: TextBytes("[[[1]]]"), offset: 0, step: 16 };
    var deepHandle = SliceHandle { state: @deepState };
    // Safety: `deepHandle` is a local of this function that outlives every use of the handle.
    var deep = JsonEventReader(allocator, unsafe { @deepHandle as Reader }, shallow);
    Assert(Arrives(deep, JsonEvent::ArrayStart), "the first level opens");
    Assert(Arrives(deep, JsonEvent::ArrayStart), "and the second");
    Assert(StoppedAt(Thrown(deep), "JsonParseError::TooDeep"), "and the third is refused for being too deep");
    deep.Release();

    // A failure is positioned in the document rather than in the buffer, however many refills dropped the bytes
    // before it: the brace is byte 14 of the document, though only byte 2 of the last read.
    var offsetState = SliceState { bytes: TextBytes("[1, 2, 3, 4, 5}"), offset: 0, step: 4 };
    var offsetHandle = SliceHandle { state: @offsetState };
    // Safety: `offsetHandle` is a local of this function that outlives every use of the handle.
    var offsets = JsonEventReader(allocator, unsafe { @offsetHandle as Reader }, JsonLimits::Default());
    Assert(Arrives(offsets, JsonEvent::ArrayStart), "the array opens");
    var numbers: uint = 0;
    while Arrives(offsets, JsonEvent::Number) {
        numbers = numbers + 1;
    }
    Assert(numbers == 5, "five numbers arrive before the brace is refused");
    let misplaced = Thrown(offsets) ?? Panic("the reader stays stopped and throws again");
    let reason = match misplaced { .Malformed(reason) => reason, .Source(_, _) => Panic("the source did not fail") };
    Assert(reason is JsonParseError::Unexpected(14), "as a structural mistake at the brace's offset in the document");
    offsets.Release();

    // A source that breaks is reported as itself, not as a byte the lexer did not expect.
    var brokenState = SliceState { bytes: TextBytes("[1, 2"), offset: 0, step: 4 };
    var brokenHandle = BrokenHandle { state: @brokenState };
    // Safety: `brokenHandle` is a local of this function that outlives every use of the handle.
    var broken = JsonEventReader(allocator, unsafe { @brokenHandle as Reader }, JsonLimits::Default());
    Assert(Arrives(broken, JsonEvent::ArrayStart), "the array opens");
    Assert(Arrives(broken, JsonEvent::Number), "and its first number arrives");
    let stopped = Thrown(broken) ?? Panic("then the broken source stops the reader");
    Assert(stopped is .Source(reported, 4) && reported.kind == IoErrorKind::PermissionDenied && reported.raw == 13,
           "with the source's own failure, exactly as reported, where the unfinished token starts");
    Assert(Thrown(broken) is .Some(.Source(_, _)), "and the reader stays stopped");
    broken.Release();

    // One that breaks before the first byte is an error too, not an empty document.
    var silentState = SliceState { bytes: TextBytes(""), offset: 0, step: 4 };
    var silentHandle = BrokenHandle { state: @silentState };
    // Safety: `silentHandle` is a local of this function that outlives every use of the handle.
    var silent = JsonEventReader(allocator, unsafe { @silentHandle as Reader }, JsonLimits::Default());
    Assert(Thrown(silent) is .Some(.Source(_, 0)), "a source broken from the start is not an empty document");
    silent.Release();

    // Malformed input is refused with the case and offset the tree parser reports for the same text: separators,
    // text after the document, a second top-level value, an empty document, and numbers the grammar refuses.
    Assert(SameAsParser(allocator, "[1 2]"), "a missing comma");
    Assert(SameAsParser(allocator, "[1,,2]"), "a doubled comma");
    Assert(SameAsParser(allocator, "[1,]"), "a comma before the closer");
    Assert(SameAsParser(allocator, "[,1]"), "a comma before the first element");
    Assert(SameAsParser(allocator, "{\"a\" 1}"), "a name without its colon");
    Assert(SameAsParser(allocator, "{\"a\"::1}"), "a doubled colon");
    Assert(SameAsParser(allocator, "{1:2}"), "a member name that is not a string");
    Assert(SameAsParser(allocator, "{\"a\":1,}"), "a comma before the closing brace");
    Assert(SameAsParser(allocator, "[1] x"), "text after the document");
    Assert(SameAsParser(allocator, "1 2"), "a second top-level value");
    Assert(SameAsParser(allocator, ""), "an empty document");
    Assert(SameAsParser(allocator, "   "), "a document of whitespace");
    Assert(SameAsParser(allocator, "[1"), "an unclosed array");
    Assert(SameAsParser(allocator, "01"), "a leading zero");
    Assert(SameAsParser(allocator, "[1e]"), "an empty exponent");
    Assert(SameAsParser(allocator, "[tru]"), "a misspelled literal");
    Assert(Refusal(allocator, " [1, {\"a\": [true, null]}] ") is none, "while a well-formed document reads to its end");

    return 0;
}
