import Core::Assert;
import C::{ abs, atof, atoi, atol, atoll, calloc, free, labs, llabs, malloc, rand, realloc, srand };

func Main() -> int {
    // malloc hands back a writable block; every byte reads back what was written.
    // Safety: `malloc` takes only a byte count.
    let block = unsafe { malloc(64) as *var uint8 };
    Assert(block != null as *uint8, "malloc(64)");
    // Safety: `block` is a non-null 64-byte block from `malloc`, so offsets 0 through 63 are in it, and it is freed
    // once, last.
    unsafe {
        *block = 0x5A;
        *(block + 63) = 0xC3;
        Assert(*block == 0x5A, "malloc first byte");
        Assert(*(block + 63) == 0xC3, "malloc last byte");
        free(block as *var opaque);
    }

    // calloc zero-initializes the whole array of num * size bytes.
    // Safety: `calloc` takes only an element count and size.
    let zeroed = unsafe { calloc(4, 8) as *uint8 };
    Assert(zeroed != null as *uint8, "calloc(4, 8)");
    // Safety: `zeroed` is a non-null 32-byte block from `calloc`, so offsets 0 through 31 are in it, and it is freed
    // once, last.
    unsafe {
        Assert(*zeroed == 0, "calloc first byte is zero");
        Assert(*(zeroed + 31) == 0, "calloc last byte is zero");
        free(zeroed as *var opaque);
    }

    // realloc grows a block while preserving the bytes already stored in it.
    // Safety: `malloc` returns an 8-byte block, offsets 0 and 7 are inside it, and `realloc` takes over that block.
    let bigger = unsafe {
        let grow = malloc(8) as *var uint8;
        *grow = 0x11;
        *(grow + 7) = 0x22;
        realloc(grow as *var opaque, 32) as *uint8
    };
    Assert(bigger != null as *uint8, "realloc(32)");
    // Safety: `bigger` is a non-null 32-byte block from `realloc`, holding the 8 bytes it was grown from, and it is
    // freed once, last.
    unsafe {
        Assert(*bigger == 0x11, "realloc preserves first byte");
        Assert(*(bigger + 7) == 0x22, "realloc preserves last byte");
        free(bigger as *var opaque);
    }

    // Integer absolute value across the three widths.
    // Safety: the `abs` family takes plain integers and reads no memory.
    unsafe {
        Assert(abs(-7) == 7, "abs(-7)");
        Assert(abs(7) == 7, "abs(7)");
        Assert(labs(-100000) == 100000, "labs(-100000)");
        Assert(llabs(-5000000000) == 5000000000, "llabs(-5000000000)");
    }

    // String-to-number conversion for each width.
    // Safety: every argument is a null-terminated string literal.
    unsafe {
        Assert(atoi("12345".data) == 12345, "atoi(\"12345\")");
        Assert(atoi("-42".data) == -42, "atoi(\"-42\")");
        Assert(atol("2000000000".data) == 2000000000, "atol(\"2000000000\")");
        Assert(atoll("9000000000".data) == 9000000000, "atoll(\"9000000000\")");
    }

    // atof parses a value that is exact in binary floating point.
    // Safety: the argument is a null-terminated string literal.
    Assert(unsafe { atof("2.5".data) } == 2.5, "atof(\"2.5\")");

    // rand stays within its non-negative range, and seeding with the same value
    // reproduces the same sequence.
    // Safety: `rand` and `srand` take and return plain integers, and this test runs on one thread.
    unsafe {
        Assert(rand() >= 0, "rand() is non-negative");
        srand(1);
        let first = rand();
        srand(1);
        let second = rand();
        Assert(first == second, "srand reseeds a reproducible sequence");
    }
    return 0;
}
