// Import placement must not decide whether the generic sees inferred constant types.
pub func Read<T>() -> float64 {
    return Untyped + Typed + (Units as float64) + (sizeof(T) as float64);
}

pub func Nested<T>() -> float64 {
    return Read<T>() + (Numbers::Offset as float64);
}

import Provider::{ Untyped, Typed, Units, Numbers };
