pub intrinsic type int8;
extend int8 {
    pub const Min: int8 = -128i8;
    pub const Max: int8 = 127i8;
    pub const Bits: uint = 8u;
    pub const Bytes: uint = 1u;
}
pub type Tiny = int8;

pub intrinsic type uint;
extend uint {
    pub const Bits: uint = sizeof(uint) * 8u;
    pub const Max: uint = ~0u;
}

pub intrinsic type float64;
extend float64 {
    pub const Epsilon: float64 = 2.220446049250313e-16f64;
    pub intrinsic const Infinity: float64;
    pub intrinsic const NaN: float64;
}

pub type Utf8 = char8[..];

pub struct Target { pub pointerBits: uint; }
pub intrinsic #target: Target;
