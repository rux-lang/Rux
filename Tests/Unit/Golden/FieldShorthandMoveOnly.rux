// A field written as a name alone is an ordinary use of that binding: a move-only binding is given away, as it would
// be written in full, and a copyable one is copied.

struct Buffer {
    size: int32;
}

extend Buffer {

    func ~(&var self) {}
}

struct Holder {
    buffer: Buffer;
    size: int32;
}

variant Slot {
    Empty,
    Full { buffer: Buffer; },
}

func Hold(buffer: Buffer) -> Holder {
    let size = buffer.size;
    return Holder { buffer, size };
}

func Fill(buffer: Buffer) -> Slot {
    return Slot::Full { buffer };
}

func Twice(buffer: Buffer) -> Holder {
    let first = Holder { buffer, size: 1 };
    return Holder { buffer, size: 2 };
}

func Main() -> int {
    return 0;
}
