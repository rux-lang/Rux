// The native handling forms parse ahead of their semantics. Each spelling is rejected once, where it is written,
// until the change that gives it meaning removes it from this file.

struct NotFound {}

func Read() -> int32 ! NotFound {
    return 1;
}

func Handling() -> int32 ! NotFound {
    let recovered = 1i32;
    let mapped = Read()? else (e => NotFound {});
    let present = .Some(1i32);
    let absent = none;
    match recovered {
        1 => return 1,
        else => {}
    }
    fail NotFound {};
}
