// Native sum, optional, and fallible types parse ahead of their semantics. Each spelling is rejected once, at the
// written type, until the task that gives it meaning removes its line from this file.

struct Options {}
struct Defaults {}
struct ParseError {}

func Sum(value: Options | Defaults) {}

func Optional(value: int32?, nested: int32??) {}

func Fallible(value: Options ! ParseError, completion: ! ParseError) {}

func Grouped(value: (Options | Defaults)?, data: *(int32?)) {}

func Main() -> int {
    let unit: () = ();
    return 0;
}
