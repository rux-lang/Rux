func Main() {
    // A suffixed literal names its own type, so nothing else checks it and the
    // magnitude has to be checked against the width the suffix chose.
    let past8 = 256u8;
    let past16 = 65536u16;
    let pastSigned8 = 128i8;
    let pastNegative8 = -129i8;
    let past64 = 18446744073709551616u64;

    // The boundary values themselves are in range, including the most negative
    // one, which is written as a magnitude one past the largest positive one.
    let last8 = 255u8;
    let lastSigned8 = 127i8;
    let leastSigned8 = -128i8;

    // An unsuffixed literal is checked against whatever it is assigned to.
    let target: uint8 = 256;
    let negativeTarget: uint16 = -1;

    // A literal beside an integer operand takes that operand's type, so it is
    // checked against that type on either side of the operator.
    let count: uint64 = 7;
    let narrow: uint8 = 3;
    let negativeCompared = count == -1;
    let negativeOnLeft = -1 < count;
    let pastNarrowSum = narrow + 300;
    let pastNarrowMask = 0x1FF & narrow;

    // Values the operand's type holds are accepted at both of its ends.
    let inRange = count > 0 && narrow == 255 && narrow != 0;
}

func Unannotated() {
    let tooWide = 1000000000000000000000;
}
