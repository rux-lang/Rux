// A move inside a loop body reaches the next pass: a value one pass moved out is not there for the next.
struct Token {
    id: int;
}

extend Token {
    func ~Token(&var self) {}
}

struct Holder {
    token: Token;
}

func Take(token: Token) {}

func ForBody(first: Token) {
    var held = move first;
    for i in 0..2 {
        let id = held.id;
        Take(move held);
    }
}

func WhileBody(first: Token, more: bool) {
    var held = move first;
    while more {
        Take(move held);
    }
}

func LoopBody(first: Token) {
    var held = move first;
    loop {
        Take(move held);
    }
}

func DoWhileBody(first: Token, more: bool) {
    var held = move first;
    do {
        Take(move held);
    } while more;
}

func ContinuePath(first: Token, skip: bool) {
    var held = move first;
    for i in 0..2 {
        if skip {
            Take(move held);
            continue;
        }
        let id = held.id;
    }
}

func ParameterEachPass(next: Token) {
    var holder = Holder { token: Token { id: 0 } };
    for i in 0..2 {
        holder.token = move next;
    }
}

// Accepted: each pass that moves the value gives it a new one before the next pass, leaves the loop, or moves the
// pass's own loop variable.
func Replenished(first: Token) {
    var held = move first;
    for i in 0..2 {
        Take(move held);
        held = Token { id: i };
    }
}

func LeavesAfterMove(first: Token) {
    var held = move first;
    loop {
        Take(move held);
        break;
    }
}

func ReturnsAfterMove(first: Token, done: bool) {
    var held = move first;
    while true {
        if done {
            Take(move held);
            return;
        }
    }
}

// Hands out tokens it makes, so the loop owns each item.
struct Tokens {
    next: int;
}

extend Tokens {
    func Next(&var self) -> Token? {
        if self.next == 2 {
            return none;
        }
        self.next = self.next + 1;
        return Token { id: self.next };
    }
}

func MovesItsItem() {
    for item in (Tokens { next: 0 }) {
        Take(move item);
    }
}

func MovesInnerLocal() {
    for i in 0..2 {
        let local = Token { id: i };
        Take(move local);
    }
}
