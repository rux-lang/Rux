// A receiver is written by how the method takes it, so the parser rejects the long form that named the receiver's
// type and a receiver on a function that is not a method at all.

struct Vector {
    x: float64;
}

extend Vector {
    func Long(self: &Vector) -> float64 {
        return self.x;
    }
}

func Free(&self) -> float64 {
    return 0.0;
}

func Main() -> int {
    return 0;
}
