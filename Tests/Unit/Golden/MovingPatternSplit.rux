struct Handle { code: int32; }

extend Handle {
    func ~Handle(&var self) {}
}

struct Holder { handle: Handle; extra: int32; }

func MakeHandle() -> Handle {
    return Handle { code: 1 };
}

func Fails() -> int32 throws Handle {
    throw Handle { code: 2 };
}

func SplitNamed(handle: Handle) -> int32 {
    return match move handle { Handle { code: code } => code };
}

func SplitTemporary() -> int32 {
    return match MakeHandle() { Handle { code: code } => code };
}

func SplitTupleMember(pair: (Handle, int32)) -> int32 {
    return match move pair { (Handle { code: code }, extra) => code + extra };
}

func SplitCaught() -> int32 {
    return try Fails() catch { Handle { code: code } => code };
}

func TestWithoutSplitting(pair: (Handle, int32)) -> int32 {
    return match move pair { (Handle { code: 1 }, extra) => extra, (_, extra) => -extra };
}

func ReadBorrowed(handle: &Handle) -> int32 {
    return match handle { Handle { code: code } => code };
}

func SplitHolder(holder: Holder) -> int32 {
    return match move holder { Holder { handle: handle, extra: extra } => extra };
}

struct Counter { count: int32; }

extend Counter {
    func Clone(&self) -> Counter { return Counter { count: self.count }; }
    func ~Counter(&var self) {}
}

func SplitCloned(counter: Counter) -> int32 {
    return match counter.Clone() { Counter { count: count } => count };
}

func ReadCloned(counter: Counter) -> int32 {
    return match counter.Clone() { whole => whole.count };
}
