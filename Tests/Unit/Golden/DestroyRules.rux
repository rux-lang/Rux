// `destroy place;` ends a local or a parameter, or destroys a value in place through a raw pointer. A part of a live value
// and a value reached through a loan are not destroyed by themselves, a temporary needs no ending, and an ended value
// is not used again.
struct Tracked {
    id: int;
}

extend Tracked {
    destructor {}
}

struct Pair {
    first: Tracked;
    second: Tracked;
}

func Lent(value: &Tracked) {
    destroy value;
}

func Make() -> Tracked {
    return Tracked { id: 1 };
}

func Main() -> int {
    let pair = Pair { first: Tracked { id: 1 }, second: Tracked { id: 2 } };
    destroy pair.first;
    destroy Make();
    let ended = Tracked { id: 3 };
    destroy ended;
    return ended.id;
}
