func Mismatch(value: int32) -> int32? {
    return match value {
        0 => .Some(1i32),
        _ => .Some(true)
    };
}

func Late(value: int32) -> int32? {
    return match value {
        0 => .Failure(true),
        1 => none,
        _ => .Some(1i32)
    };
}

func Refused(value: int32) -> int32? {
    return match value {
        0 => none,
        _ => .Failure(true)
    };
}

func Open(value: int32) {
    let open = match value {
        0 => .Success(1i32),
        _ => .Failure(true)
    };
}

func Accepted(value: int32) -> int32? {
    let annotated: int32? = match value {
        0 => none,
        _ => .Some(value)
    };
    return match value {
        0 => none,
        _ => annotated
    };
}

struct DigitError {}
struct RangeError {}

func Nothing() {}

func Parse() -> int throws DigitError | RangeError {
    return 1;
}

func Spelled(value: int32) -> int {
    let partial = try Parse() catch {
        _: DigitError => 0
    };
    return match value {
        0 => partial,
        _ => Nothing()
    };
}
