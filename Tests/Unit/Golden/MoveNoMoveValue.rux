// A '#NoMove' value stays where it was built: it is created in place from a temporary, but a named one cannot be
// given away, alone or as part of a value that holds it.
#NoMove
struct Node {
    next: *var Node;
}

struct Holder {
    node: Node;
}

func Take(node: Node) {}

func Build() -> Node {
    return Node { next: null };
}

func Moves() {
    let first = Build();
    let second = first;
    let third = first;
    Take(first);
}

func Nested() -> Holder {
    let holder = Holder { node: Node { next: null } };
    return holder;
}

func Main() -> int {
    return 0;
}
