// A bare owning value is given away, so a name that only borrows passes the loan on, and an owner cannot be given away
// while a loan of it is still in use.
struct Buffer {
    size: int32;
}

extend Buffer {

    destructor {}
}

func FromReference(buffer: &Buffer) -> int32 {
    let local = buffer;
    return local.size;
}

func WhileBorrowed(buffer: Buffer) -> int32 {
    let view: &Buffer = buffer;
    let moved = buffer;
    return view.size;
}

func Main() -> int {
    return 0;
}
