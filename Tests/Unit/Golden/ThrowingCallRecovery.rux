// A call that can fail whose arguments are refused still reads as its success under `!`, so the uses that follow name
// the type the program would have had, and the `!` is not reported as passing on nothing.
enum Oops { Bad }

struct Token {
    id: int;
}

extend Token {
    func ~(&var self) {}
}

struct Meter {
    count: int;
}

func Open(token: Token) -> Meter ! Oops { return Meter { count: token.id }; }

func Close(meter: Meter) -> !Oops {}

func Run() -> int ! Oops {
    let token = Token { id: 1 };
    let meter = Open(token)!;
    Close(true)!;
    Close(false) catch { _ => {} };
    return token.id + meter.Missing;
}
