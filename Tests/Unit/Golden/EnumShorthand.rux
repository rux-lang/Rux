// A case written without its type takes the type its context expects, here the match's return type, so a case that
// type does not declare is reported even when another enum in scope declares it.
enum Direction { North, South }

enum Pole { North, South }

enum Turn { Left, Right }

func Flip(d: Direction) -> Direction {
    return match d { Direction::North => .Left, Direction::South => .North };
}
