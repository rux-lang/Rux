// Literal code units remain read-only, and different encodings do not convert implicitly.
func Main() {
    var text = c8"text";
    var wide = c16"text";

    // Slicing code units is valid, even when a range could split an encoded scalar.
    let part = text[0..2];

    // The descriptor can change; the literal code units remain read-only.
    text.length = 0;
    text[0] = c8'x';

    // 'data' and 'length' are all a string has.
    let size = text.size;

    // Comparing two views would compare the addresses they hold, not the text they name.
    let same = text == c8"other";

    // The encodings are separate types, in either direction.
    let narrowed: char8[..] = wide;
}
