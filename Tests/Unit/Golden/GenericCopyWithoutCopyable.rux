// A value of a type parameter is owning inside generic code, so a bare one is given away and a second use of it is
// an error for every type argument. Under 'T: Copyable' it copies, and a move-only type argument is refused where it
// is passed.
interface Copyable {}

struct Owner {
    value: int32;
}

extend Owner {
    destructor {}
}

func Duplicate<T>(value: T) -> (T, T) {
    let first = value;
    return (first, value);
}

func Bounded<T: Copyable>(value: T) -> (T, T) {
    return (value, value);
}

func Main() -> int {
    let numbers = Duplicate<int32>(1);
    let owners = Duplicate<Owner>(Owner { value: 2 });
    let bounded = Bounded<int32>(3);
    let refused = Bounded<Owner>(Owner { value: 4 });
    return numbers.0 + bounded.1;
}
