// '_' is the default arm, and it comes last.
func Main() -> int {
    let first = match 7 {
        0 => 1,
        _ => 2
    };
    let second = match 7 {
        0 => 1,
        _ => 2,
    };
    let misplaced = match 7 {
        _ => 1,
        0 => 2
    };
    return first + second + misplaced;
}
