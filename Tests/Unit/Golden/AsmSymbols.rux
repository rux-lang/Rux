// rux:target linux-x86_64
// A name in an asm body becomes a relocation, so it must be a label of the body, a function or a module variable.
// One that names nothing, or names something with no address of its own, is reported where it is written.
const Limit: int64 = 10;

var Counter: int64 = 0;

thread var Depth: int64 = 0;

#Link("libc.so.6")
extern opterr: int32;

asm func Helper() -> int64 {
    mov rax, 1
    ret
}

asm func Names(x: int64) -> int64 {
    call Helper
    mov rax, qword [rip + Counter]
    test rax, rax
    jz done
    call dnoe
    call Limit
    mov rax, qword [rip + Depth]
    mov rax, qword [rip + opterr]
    call x
    call dnoe
done:
    ret
}

func Main() -> int {
    return 0;
}
