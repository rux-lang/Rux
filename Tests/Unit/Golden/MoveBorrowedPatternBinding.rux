// A pattern over a borrowed subject binds names to the subject's own storage, so nothing may be given away from them;
// a pattern over a subject the match takes binds values it may give away.
struct Token { id: int; }

extend Token {
    destructor {}
}

func Take(token: Token) -> int { return token.id; }

func FromReference(holder: &(Token?)) -> int {
    if let token? = holder { return Take(token); }
    return 0;
}

func FromOwned(holder: Token?) -> int {
    return match holder { token? => Take(token), none => 0 };
}

func Main() -> int {
    return 0;
}
