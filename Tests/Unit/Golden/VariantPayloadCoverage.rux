// A case is covered when its arms together take every payload, as '.Light(true)' and '.Light(false)' do for a 'bool'
// payload; one of them alone, or literals of an integer payload, leave the case open.
variant Signal {
    Off,
    Light(bool),
    Level(int32)
}

func Both(signal: Signal) -> int {
    return match signal {
        .Off => 0,
        .Light(true) => 1,
        .Light(false) => 2,
        .Level(_) => 3
    };
}

func One(signal: Signal) -> int {
    return match signal {
        .Off => 0,
        .Light(true) => 1,
        .Level(_) => 3
    };
}

func Levels(signal: Signal) -> int {
    return match signal {
        .Off => 0,
        .Light(_) => 1,
        .Level(0) => 2,
        .Level(1) => 3
    };
}

func Main() -> int {
    return Both(Signal::Off) + One(Signal::Off) + Levels(Signal::Off);
}
