set(group_filters "@RUX_UNIT_FILTERS@")

function(inventory output)
    execute_process(COMMAND "${RUX_TEST_EXECUTABLE}" --list-test-cases --reporters=xml --no-skip=true ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE listing ERROR_VARIABLE errors)
    if (NOT status EQUAL 0)
        message(FATAL_ERROR "Could not enumerate doctest cases: ${errors}")
    endif ()
    # XML entities contain semicolons, which CMake otherwise treats as list separators.
    string(REPLACE ";" "__RUX_SEMICOLON__" listing "${listing}")
    string(REGEX MATCHALL "<TestCase[^>]+/>" cases "${listing}")
    set(${output} "${cases}" PARENT_SCOPE)
endfunction()

inventory(expected)
if (NOT expected)
    message(FATAL_ERROR "The unit-test executable registered no cases")
endif ()
set(actual)
foreach (filter IN LISTS group_filters)
    inventory(group_cases "--source-file=${filter}")
    foreach (test_case IN LISTS group_cases)
        if (test_case IN_LIST actual)
            message(FATAL_ERROR "A case belongs to more than one CTest group: ${test_case}")
        endif ()
        list(APPEND actual "${test_case}")
    endforeach ()
endforeach ()
list(SORT expected)
list(SORT actual)
if (NOT actual STREQUAL expected)
    set(missing "${expected}")
    list(REMOVE_ITEM missing ${actual})
    message(FATAL_ERROR "CTest groups do not cover every registered doctest case: ${missing}")
endif ()
list(LENGTH actual count)
message(STATUS "Verified ${count} doctest cases, each in exactly one CTest group")
