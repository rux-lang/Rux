// The name alone does not bind the compiler's view representation.
struct OrdinaryRecord<T> { pub length: T; }
extend OrdinaryRecord<T> { func Value(self: &OrdinaryRecord<T>) -> T { return self.length; } }

func Main() -> int {
    let text = "hello";
    let utf16 = c16"hello";
    let utf32 = c32"hello";
    let values = [1, 2, 3];
    var total: int = 0;
    for index in 0..values.length { total += values[index]; }
    let scalar: int8 = 7i8;
    if total != 6 || scalar * 2i8 != 14i8 { return 1; }
    let ordinary = OrdinaryRecord<uint8> { length: 7u8 };
    if ordinary.length != 7u8 || ordinary.Value() != 7u8 || sizeof(OrdinaryRecord<uint8>) != 1 { return 2; }
    return 0;
}
