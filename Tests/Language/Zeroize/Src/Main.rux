import Core::{ Assert, Zeroize };

func Sum(bytes: *var uint8, length: uint64) -> uint64 {
    var total = 0u64;
    var index = 0u64;
    while index < length {
        total = total + bytes[index] as uint64;
        index = index + 1u64;
    }
    return total;
}

// A secret cleared before the function returns: nothing reads the bytes back, which is what makes the guarantee matter.
func Cleared() -> uint64 {
    var secret: uint8[4] = [1u8, 2u8, 3u8, 4u8];
    let before = Sum(@secret[0], 4u64);
    Zeroize(@secret[0], 4u64);
    return before + Sum(@secret[0], 4u64);
}

func Partial() -> uint64 {
    var secret: uint8[4] = [9u8, 9u8, 9u8, 9u8];
    Zeroize(@secret[0], 2u64);
    return Sum(@secret[0], 4u64);
}

func Empty() -> uint64 {
    var secret: uint8[2] = [7u8, 7u8];
    Zeroize(@secret[0], 0u64);
    return Sum(@secret[0], 2u64);
}

func Main() -> int {
    Assert(Cleared() == 10u64, "Expected the bytes to be cleared after they were summed");
    Assert(Partial() == 18u64, "Expected only the requested prefix to be cleared");
    Assert(Empty() == 14u64, "Expected a zero length to clear nothing");
    return 0;
}
