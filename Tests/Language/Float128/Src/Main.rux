// float128: IEEE 754 binary128, with 113 bits of significand and 15 of exponent, in 16 bytes.
// No target has float128 arithmetic in hardware, so every operation below runs in a helper the compiler synthesizes.
// The compiler also folds float128 while compiling, so each check compares a result computed at run time against a
// `const` the compiler folded: the two must agree bit for bit. A value is passed through a function to make the
// operation run, and its bits are read through a pointer, since `==` would call -0 and +0 the same and every NaN
// different. A NaN result is only checked to be a NaN, because its sign and payload are not specified at run time.

import Core::Assert;
import Core::{ float128, float256, float32, float512, float64, float80, int128, int256, int512, int64, uint128,
               uint256, uint512, uint64 };

const Zero: float128 = 0.0f128;
const NegativeZero: float128 = -0.0f128;
const One: float128 = 1.0f128;
const Two: float128 = 2.0f128;
const Three: float128 = 3.0f128;
const Tenth: float128 = 0.1f128;
const Fifth: float128 = 0.2f128;
const Infinity: float128 = float128::Infinity;
const NaN: float128 = float128::NaN;

// Folded results, each the reference for one run-time operation below.
const TenthPlusFifth: float128 = 0.1f128 + 0.2f128;
const TenthMinusThird: float128 = 0.1f128 - 1.0f128 / 3.0f128;
const Third: float128 = 1.0f128 / 3.0f128;
const TenthTimesThird: float128 = 0.1f128 * (1.0f128 / 3.0f128);
const TenAndAHalfModThree: float128 = 10.5f128 % 3.0f128;
const NegativeTenAndAHalfModThree: float128 = -10.5f128 % 3.0f128;
const MaxModThree: float128 = float128::Max % 3.0f128;
const MaxModTenth: float128 = float128::Max % 0.1f128;
const HalfEpsilon: float128 = float128::Epsilon / 2.0f128;
const OnePlusEpsilon: float128 = 1.0f128 + float128::Epsilon;
const ThreeQuarterEpsilon: float128 = float128::Epsilon * 0.75f128;
const HalfMinPositive: float128 = float128::MinPositive / 2.0f128;
const Chained: float128 = ((1.0f128 + 0.1f128) * 3.0f128 - 0.2f128) / 3.0f128 % 0.25f128;
const TenTenths: float128 = 0.1f128 + 0.1f128 + 0.1f128 + 0.1f128 + 0.1f128 + 0.1f128 + 0.1f128 + 0.1f128 +
                            0.1f128 + 0.1f128;
const Largest: float128 = float128::Max;
const Table: float128[4] = [Tenth, NegativeZero, Largest, Infinity];

func Bits(value: float128) -> uint128 {
    let address = (@value) as *uint128;
    return *address;
}

func Same(left: float128, right: float128) -> bool {
    return Bits(left) == Bits(right);
}

func IsNan(value: float128) -> bool {
    return value != value;
}

func Add(left: float128, right: float128) -> float128 {
    return left + right;
}

func Subtract(left: float128, right: float128) -> float128 {
    return left - right;
}

func Multiply(left: float128, right: float128) -> float128 {
    return left * right;
}

func Divide(left: float128, right: float128) -> float128 {
    return left / right;
}

func Remainder(left: float128, right: float128) -> float128 {
    return left % right;
}

func Negate(value: float128) -> float128 {
    return -value;
}

func Less(left: float128, right: float128) -> bool {
    return left < right;
}

func LessOrEqual(left: float128, right: float128) -> bool {
    return left <= right;
}

func Greater(left: float128, right: float128) -> bool {
    return left > right;
}

func GreaterOrEqual(left: float128, right: float128) -> bool {
    return left >= right;
}

func Equal(left: float128, right: float128) -> bool {
    return left == right;
}

func NotEqual(left: float128, right: float128) -> bool {
    return left != right;
}

func Truth(value: float128) -> bool {
    return value as bool;
}

func Compound(start: float128) -> float128 {
    var value = start;
    value += 0.1f128;
    value *= 3.0f128;
    value -= 0.2f128;
    value /= 3.0f128;
    value %= 0.25f128;
    return value;
}

func FromInt64(value: int64) -> float128 {
    return value as float128;
}

func FromUint64(value: uint64) -> float128 {
    return value as float128;
}

func FromInt128(value: int128) -> float128 {
    return value as float128;
}

func FromUint128(value: uint128) -> float128 {
    return value as float128;
}

func FromInt256(value: int256) -> float128 {
    return value as float128;
}

func FromUint512(value: uint512) -> float128 {
    return value as float128;
}

func ToInt64(value: float128) -> int64 {
    return value as int64;
}

func ToUint64(value: float128) -> uint64 {
    return value as uint64;
}

func ToInt128(value: float128) -> int128 {
    return value as int128;
}

func ToUint256(value: float128) -> uint256 {
    return value as uint256;
}

func FromFloat32(value: float32) -> float128 {
    return value as float128;
}

func FromFloat64(value: float64) -> float128 {
    return value as float128;
}

func FromFloat80(value: float80) -> float128 {
    return value as float128;
}

func FromFloat256(value: float256) -> float128 {
    return value as float128;
}

func FromFloat512(value: float512) -> float128 {
    return value as float128;
}

func ToFloat32(value: float128) -> float32 {
    return value as float32;
}

func ToFloat64(value: float128) -> float64 {
    return value as float64;
}

func ToFloat80(value: float128) -> float80 {
    return value as float80;
}

func ToFloat256(value: float128) -> float256 {
    return value as float256;
}

func ToFloat512(value: float128) -> float512 {
    return value as float512;
}

struct Sample {
    tag: int8;
    value: float128;
}

func Scaled(sample: Sample, factor: float128) -> Sample {
    return Sample { tag: sample.tag + 1i8, value: sample.value * factor };
}

func Main() -> int {
    Assert(float128::Bits == 128u && float128::Bytes == 16u, "float128 is 128 bits in 16 bytes");
    Assert(sizeof(float128) == 16u, "sizeof agrees with Bytes");

    // Each operation, against the folded result.
    Assert(Same(Add(Tenth, Fifth), TenthPlusFifth), "addition rounds as the folded sum does");
    Assert(Add(Tenth, Fifth) != 0.3f128, "and a tenth plus a fifth is not three tenths here either");
    Assert(Same(Subtract(Tenth, Divide(One, Three)), TenthMinusThird), "subtraction");
    Assert(Same(Divide(One, Three), Third), "division");
    Assert(Same(Multiply(Tenth, Third), TenthTimesThird), "multiplication");
    Assert(Same(Remainder(10.5f128, Three), TenAndAHalfModThree), "remainder");
    Assert(Same(Remainder(-10.5f128, Three), NegativeTenAndAHalfModThree), "remainder keeps the dividend's sign");
    Assert(Remainder(10.5f128, Three) == 1.5f128, "and is exact");
    Assert(Same(Remainder(float128::Max, Three), MaxModThree), "remainder across the whole exponent range");
    Assert(Same(Remainder(float128::Max, Tenth), MaxModTenth), "and by a divisor that is not a power of two");
    Assert(Same(Negate(Tenth), -0.1f128), "negation flips the sign");

    // Rounding at the last of the 113 bits: an exact sum, a tie to even, and a sum just past the tie.
    Assert(Same(Add(One, float128::Epsilon), OnePlusEpsilon), "one plus epsilon is exact");
    Assert(Add(One, float128::Epsilon) != One, "and differs from one");
    Assert(Same(Add(One, HalfEpsilon), One), "half an epsilon is a tie, and rounds to the even one");
    Assert(Same(Add(OnePlusEpsilon, HalfEpsilon), Add(One, Multiply(float128::Epsilon, Two))),
           "the same tie from an odd significand rounds up");
    Assert(Same(Add(One, ThreeQuarterEpsilon), OnePlusEpsilon), "past the tie rounds up");

    // The ends of the range.
    Assert(Same(Multiply(float128::Max, Two), Infinity), "overflow gives the infinity");
    Assert(Same(Add(float128::Max, float128::Max), Infinity), "and so does a sum past the maximum");
    Assert(Same(Divide(float128::MinPositive, Two), HalfMinPositive), "halving the smallest normal gives a subnormal");
    Assert(Greater(HalfMinPositive, Zero), "which is above zero");
    Assert(Same(Multiply(float128::MinPositive, float128::MinPositive), Zero), "and a deep underflow gives zero");
    Assert(Same(Subtract(float128::Lowest, float128::Max), -Infinity), "and below the lowest, the negative infinity");

    // Zeros: their sign survives where it should and only there.
    Assert(Same(Negate(Zero), NegativeZero), "negating zero gives minus zero");
    Assert(Same(Subtract(Tenth, Tenth), Zero), "an exact cancellation gives plus zero");
    Assert(Same(Add(NegativeZero, NegativeZero), NegativeZero), "minus zero plus minus zero stays negative");
    Assert(Same(Add(NegativeZero, Zero), Zero), "and with a plus zero becomes positive");
    Assert(Same(Divide(One, NegativeZero), -Infinity), "one over minus zero is the negative infinity");
    Assert(Same(Divide(One, Infinity), Zero), "one over the infinity is zero");
    Assert(Equal(NegativeZero, Zero) && !Less(NegativeZero, Zero) && LessOrEqual(NegativeZero, Zero),
           "the two zeros compare equal");
    Assert(!NotEqual(Zero, NegativeZero) && GreaterOrEqual(Zero, NegativeZero), "from both sides");

    // NaN: every operation that has no answer gives one, and every comparison against one is false.
    Assert(IsNan(Divide(Zero, Zero)), "zero over zero is a NaN");
    Assert(IsNan(Subtract(Infinity, Infinity)), "the infinity minus itself is a NaN");
    Assert(IsNan(Multiply(Zero, Infinity)), "zero times the infinity is a NaN");
    Assert(IsNan(Remainder(One, Zero)), "a remainder by zero is a NaN");
    Assert(IsNan(Remainder(Infinity, Three)), "and so is the infinity's remainder");
    Assert(IsNan(Add(NaN, One)) && IsNan(Multiply(Two, NaN)), "a NaN operand gives a NaN");
    Assert(!Less(NaN, One) && !Greater(NaN, One) && !LessOrEqual(NaN, NaN) && !GreaterOrEqual(One, NaN),
           "no ordering holds against a NaN");
    Assert(!Equal(NaN, NaN) && NotEqual(NaN, NaN), "and a NaN is unequal even to itself");
    Assert(Less(-Infinity, float128::Lowest) && Greater(Infinity, float128::Max), "the infinities bound the range");
    Assert(Less(Tenth, Fifth) && Greater(Fifth, Tenth) && LessOrEqual(Tenth, Tenth) && GreaterOrEqual(Tenth, Tenth),
           "the ordinary orderings");
    Assert(Less(Negate(Fifth), Tenth) && !Less(Tenth, Negate(Fifth)), "and across the sign");

    // A cast to bool tests for non-zero: either zero is false, and a NaN is true.
    Assert(!Truth(Zero) && !Truth(NegativeZero), "both zeros are false");
    Assert(Truth(One) && Truth(HalfMinPositive) && Truth(-Infinity) && Truth(NaN), "everything else is true");

    // Integers in. A float128 holds every int64 and uint64 exactly, and rounds wider ones to 113 bits.
    Assert(Same(FromInt64(-7i64), -7.0f128), "a small negative int64");
    Assert(Same(FromInt64(-9223372036854775808i64), -9223372036854775808.0f128), "int64::Min is exact");
    Assert(Same(FromUint64(18446744073709551615u64), 18446744073709551615.0f128), "uint64::Max is exact");
    Assert(Same(FromInt128(-170141183460469231731687303715884105728i128),
                (-170141183460469231731687303715884105728i128) as float128),
           "int128::Min is exactly -2^127");
    Assert(Same(FromUint128(uint128::Max), uint128::Max as float128), "uint128::Max rounds up to 2^128");
    Assert(Same(FromUint128(uint128::Max), 340282366920938463463374607431768211456.0f128), "which is that power");
    Assert(Same(FromUint128((1u128 << 113) + 1u128), (1u128 << 113) as float128), "a tie rounds to even");
    Assert(Same(FromUint128((1u128 << 113) + 3u128), ((1u128 << 113) + 4u128) as float128), "and the next one up");
    let wide: int256 = -(1i256 << 200) - 1i256;
    Assert(Same(FromInt256(wide), (-(1i256 << 200) - 1i256) as float128), "an int256 rounds to 113 bits");
    Assert(Same(FromUint512(~0u512), (~0u512) as float128), "and a uint512 to 2^512");
    Assert(Same(FromInt64(0i64), Zero), "zero converts to plus zero");

    // Integers out: truncation toward zero, saturation, and zero for a NaN.
    Assert(ToInt64(-7.9f128) == -7i64 && ToInt64(7.9f128) == 7i64, "truncation toward zero");
    Assert(ToInt64(1e30f128) == int64::Max && ToInt64(-1e30f128) == int64::Min, "saturation at 64 bits");
    Assert(ToUint64(18446744073709551615.0f128) == uint64::Max, "uint64::Max converts back exactly");
    Assert(ToUint64(-1.5f128) == 0u64 && ToUint64(Infinity) == uint64::Max, "and an unsigned target saturates");
    Assert(ToInt128(-170141183460469231731687303715884105728.0f128) == int128::Min, "-2^127 converts to int128::Min");
    Assert(ToInt128(1e39f128) == int128::Max, "and past the range saturates");
    Assert(ToUint256(340282366920938463463374607431768211456.0f128) == 1u256 << 128, "a wider target takes 2^128");
    Assert(ToInt64(NaN) == 0i64 && ToInt128(NaN) == 0i128, "a NaN converts to zero");

    // Other floats in and out.
    Assert(Same(FromFloat32(0.1f32), 0.1f32 as float128), "a float32 widens exactly");
    Assert(Same(FromFloat64(0.1), 0.1 as float128), "and so does a float64");
    Assert(FromFloat64(0.1) != Tenth, "which carries the float64's own tenth, not this one");
    Assert(ToFloat64(Tenth) == 0.1 && ToFloat32(Tenth) == 0.1f32, "narrowing rounds to the nearest");
    Assert(ToFloat64(float128::Max) == float64::Infinity, "past the float64 range narrows to the infinity");
    Assert(ToFloat32(HalfMinPositive) == 0.0f32, "and below it to zero");
    Assert(Same(ToFloat256(Tenth) as float128, Tenth), "a float256 holds every float128");
    Assert(ToFloat256(Tenth) != 0.1f256, "though not the float256 tenth");
    Assert(Same(FromFloat256(0.1f256), Tenth), "which rounds back to this one");
    Assert(Same(FromFloat512(0.1f512), Tenth), "and so does the float512 tenth");
    Assert(Same(ToFloat512(Third) as float128, Third), "a float512 holds every float128 too");
    Assert(Same(FromFloat80(0.1f80), 0.1f80 as float128), "a float80 widens exactly");
    Assert(Same(ToFloat80(Tenth) as float128, (0.1f128 as float80) as float128), "and a float128 narrows to it");
    let narrowed = ToFloat64(NaN);
    Assert(narrowed != narrowed && IsNan(ToFloat256(NaN) as float128), "a NaN stays a NaN");
    Assert(ToFloat64(-Infinity) == -float64::Infinity, "and an infinity an infinity");
    Assert(Same(FromFloat64(-0.0), NegativeZero), "and minus zero minus zero");

    // Fields, arguments, returns and static data.
    let sample = Sample { tag: 1i8, value: Tenth };
    let scaled = Scaled(sample, Third);
    Assert(scaled.tag == 2i8 && Same(scaled.value, TenthTimesThird), "a struct field passes through a call");
    var samples: Sample[2];
    samples[0] = sample;
    samples[1] = scaled;
    Assert(Same(samples[1].value, TenthTimesThird) && Same(samples[0].value, Tenth), "and through an array");
    for i in 0..4 {
        Assert(Same(Multiply(Table[i], One), Table[i]), "a constant table keeps every element");
    }
    Assert(Same(Table[0], Tenth) && Same(Table[1], NegativeZero), "with its rounding and its sign");
    Assert(Same(Table[2], float128::Max) && Same(Table[3], Infinity), "and its limits");

    // Compound assignment runs the same operations as the folded chain.
    Assert(Same(Compound(One), Chained), "compound assignment");
    var accumulated = Zero;
    for i in 0..10 {
        accumulated += Tenth;
    }
    Assert(Same(accumulated, TenTenths), "a sum accumulated in a loop rounds at every step as the folded one does");
    Assert(accumulated != One, "so ten tenths are not one");
    return 0;
}
