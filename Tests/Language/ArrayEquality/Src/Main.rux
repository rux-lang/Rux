// Two fixed arrays are equal when their elements are, compared one by one with the element type's own equality,
// whatever their width; an array literal is built as the other operand's type.
import Core::Assert;

struct Pair {
    a: int32;
    b: int32;
}

extend Pair {
    func ==(self: &Pair, other: &Pair) -> bool {
        return self.a == other.a;
    }
}

func Main() -> int {
    let values: int32[2] = [1, 2];
    Assert(values == [1, 2], "literal equal");
    Assert(values != [1, 3], "literal differs");
    let wide: int64[4] = [1, 2, 3, 4];
    let other: int64[4] = [1, 2, 3, 5];
    Assert(wide != other, "wide arrays differ in the last element");
    Assert(wide == [1, 2, 3, 4], "wide equal");
    let nested: int32[2][2] = [[1, 2], [3, 4]];
    let nested2: int32[2][2] = [[1, 2], [3, 5]];
    Assert(nested != nested2, "nested differ");
    let pairs: Pair[2] = [Pair { a: 1, b: 9 }, Pair { a: 2, b: 8 }];
    let pairs2: Pair[2] = [Pair { a: 1, b: 0 }, Pair { a: 2, b: 0 }];
    Assert(pairs == pairs2, "element == operator is used");
    return 0;
}
