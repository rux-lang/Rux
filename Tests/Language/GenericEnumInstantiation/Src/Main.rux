import Core::Assert;

// An Option-shaped variant of the test's own, which the legacy protocol recognizes by its cases.
variant Option<T> {
    Some(T),
    None
}

// `Option<V>` is named only inside a generic body. The concrete `Option<Tracked>` instantiation therefore has to
// receive its layout and destruction glue through substitution rather than from a concrete source declaration.

struct Tracked {
    counter: *var int32;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked);

    func ~Tracked(self: &var Tracked) {
        if self.counter != null {
            *self.counter += 1i32;
        }
    }
}

struct Shelf<K, V> {
    held: Option<V>;
    label: K;
}

extend Shelf<K, V> {
    func Shelf(label: K, value: V) -> Shelf<K, V> {
        return Shelf<K, V> { held: Option::Some<V>(<-value), label: label };
    }
}

func Hold(counter: *var int32) {
    let shelf = Shelf<int32, Tracked>(1i32, Tracked { counter: counter });
    match shelf.held {
        .Some(_) => {
        },
        .None => {
            Assert(false, "the generic constructor stored its value");
        }
    }
}

// A case written without type arguments takes them from where the value goes.
variant Reading<T> {
    Exact(T),
    Missing
}

func ReadingValue(reading: Reading<int32>) -> int32 {
    return match reading {
        Reading::Exact(value) => value,
        Reading::Missing => -1i32
    };
}

func MakeReading(present: bool) -> Reading<int32> {
    if present {
        return Reading::Exact(9);
    }
    return Reading::Missing;
}

func Main() -> int {
    var counter = 0i32;
    Hold(@counter);
    Assert(counter == 1i32, "a generic variant payload receives destruction glue after substitution");

    let exact: Reading<int32> = Reading::Exact(7);
    let missing: Reading<int32> = Reading::Missing;
    Assert(ReadingValue(exact) == 7i32, "an annotation supplies a case constructor's type arguments");
    Assert(ReadingValue(missing) == -1i32, "and a unit case's");
    Assert(ReadingValue(MakeReading(true)) == 9i32 && ReadingValue(MakeReading(false)) == -1i32,
           "and so does a return type");
    return 0;
}
