import Core::string8;
import Core::Assert;

// A function value has only ever appeared as a parameter or a local in this
// repository, never as a struct field. A hash table has to hold its hasher and
// its equality test for as long as it holds its keys, so the field form is what
// decides whether `HashMap<K, V>` can own its callbacks or has to be handed
// them again on every call.
//
// Three separate questions, because they can fail independently:
//   1. a field of function type in a plain struct, called through the receiver
//   2. the same field in a generic struct, typed by the struct's parameter
//   3. a pointer-to-pointer out-parameter, which is how a lookup would hand
//      back a pointer to the value it found

func HashInt32(value: int32) -> uint {
    return (value as uint) * 2654435761u;
}

func HashDoubled(value: int32) -> uint {
    return (value as uint) * 2u;
}

func EqualsInt32(a: int32, b: int32) -> bool {
    return a == b;
}

// A free generic function taking the callbacks the way Algorithms already
// does, so a field-held value can be checked against a shape that is known to
// work when it is passed directly.
func ApplyHash<K>(hash: func(K) -> uint, key: K) -> uint {
    return hash(key);
}

func ApplyEquals<K>(equals: func(K, K) -> bool, a: K, b: K) -> bool {
    return equals(a, b);
}

// 1. A plain struct owning two callbacks.
struct Hasher {
    hash: func(int32) -> uint;
    equals: func(int32, int32) -> bool;
    salt: uint;
}

extend Hasher {
    func Hasher(hash: func(int32) -> uint, equals: func(int32, int32) -> bool) -> Hasher {
        return Hasher { hash: hash, equals: equals, salt: 7u };
    }

    // Calling straight through the receiver. This is the form a container would
    // actually use, and the one that could plausibly be read as a method
    // lookup for a method named `hash` rather than a call of a field.
    func Apply(self: &Hasher, value: int32) -> uint {
        return self.hash(value);
    }

    // The same call routed through a local first, which is the fallback if the
    // direct form above does not resolve.
    func ApplyViaLocal(self: &Hasher, value: int32) -> uint {
        let hash = self.hash;
        return hash(value);
    }

    // Handing a field-held callback to a generic function, which is what the
    // shared probing kernel would do.
    func ApplyViaGeneric(self: &Hasher, value: int32) -> uint {
        return ApplyHash<int32>(self.hash, value);
    }

    func Same(self: &Hasher, a: int32, b: int32) -> bool {
        return self.equals(a, b);
    }

    // A callback stored after construction, so the field is written as well as
    // read.
    func Retarget(self: &var Hasher, hash: func(int32) -> uint) {
        self.hash = hash;
    }
}

// 2. A generic struct whose callback types name its own type parameter.
struct Table<K> {
    hash: func(K) -> uint;
    equals: func(K, K) -> bool;
    length: uint;
}

extend Table<K> {
    func Table(hash: func(K) -> uint, equals: func(K, K) -> bool) -> Table<K> {
        return Table<K> { hash: hash, equals: equals, length: 0 };
    }

    func Apply(self: &Table<K>, key: K) -> uint {
        return self.hash(key);
    }

    func Same(self: &Table<K>, a: K, b: K) -> bool {
        return self.equals(a, b);
    }

    func ApplyViaGeneric(self: &Table<K>, key: K) -> uint {
        return ApplyHash<K>(self.hash, key);
    }

    func SameViaGeneric(self: &Table<K>, a: K, b: K) -> bool {
        return ApplyEquals<K>(self.equals, a, b);
    }
}

// 3. A pointer-to-pointer out-parameter. `TryGetPointer` on a map would write
// a pointer into the map's own storage through one of these.
struct Store {
    values: int32[4];
    length: uint;
}

extend Store {
    func TryPointerTo(self: &var Store, index: uint, value: *var *var int32) -> bool {
        if value == null || index >= self.length {
            return false;
        }

        *value = @self.values[index];
        return true;
    }
}

func Main() -> int {
    // 1. A field of function type, in a plain struct.
    var hasher = Hasher(HashInt32, EqualsInt32);
    Assert(hasher.Apply(3) == HashInt32(3), "a callback field is callable through the receiver");
    Assert(hasher.ApplyViaLocal(3) == HashInt32(3), "a callback field is callable through a local");
    Assert(hasher.ApplyViaGeneric(3) == HashInt32(3), "a callback field passes to a generic function");
    Assert(hasher.Same(4, 4), "an equality field accepts a matching pair");
    Assert(!hasher.Same(4, 5), "an equality field rejects a differing pair");
    Assert(hasher.salt == 7u, "an ordinary field beside two callback fields keeps its value");

    // The struct copies whole, callbacks included.
    let copied = hasher;
    Assert(copied.Apply(9) == HashInt32(9), "a copied struct carries its callback");

    // A callback field is writable like any other field.
    hasher.Retarget(HashDoubled);
    Assert(hasher.Apply(3) == 6u, "a callback field can be replaced");
    Assert(copied.Apply(3) == HashInt32(3), "replacing one copy's callback leaves the other alone");

    // 2. The same, typed by a struct type parameter.
    var table = Table<int32>(HashInt32, EqualsInt32);
    Assert(table.Apply(5) == HashInt32(5), "a generic callback field is callable through the receiver");
    Assert(table.ApplyViaGeneric(5) == HashInt32(5), "a generic callback field passes to a generic function");
    Assert(table.Same(6, 6), "a generic equality field accepts a matching pair");
    Assert(!table.Same(6, 7), "a generic equality field rejects a differing pair");
    Assert(table.SameViaGeneric(6, 6), "a generic equality field passes to a generic function");
    Assert(table.length == 0, "an ordinary field beside two generic callback fields keeps its value");

    // 3. A pointer-to-pointer out-parameter.
    var store = Store { values: [10, 20, 30, 40], length: 3 };
    var found: *var int32 = null;
    Assert(store.TryPointerTo(1, @found), "an in-range index reports success");
    Assert(found != null && *found == 20, "the out-parameter received a pointer to the element");

    *found = 25;
    Assert(store.values[1] == 25, "a write through the returned pointer reaches the storage");

    var missing: *var int32 = null;
    Assert(!store.TryPointerTo(3, @missing), "an index past the length reports failure");
    Assert(missing == null, "a failed lookup leaves the out-parameter untouched");
    Assert(!store.TryPointerTo(0, null), "a null out-parameter reports failure rather than writing");

    return 0;
}
