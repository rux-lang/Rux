// Contextual cases: `.Case` and `.Case(...)` name a case without its type wherever the type is already known -- an
// annotated binding, a parameter, a field, a return value, a `throw` operand, an assignment to a typed place, or an arm
// of a match whose type is known. The expected type is the only place the case is looked up. A user variant that is
// itself the expected type takes over `.Some(...)` when it declares a `Some` case, and `.Success(...)` and
// `.Failure(...)` when it declares those; the type a `try` expression is expected to have is its operand's and its
// `catch` arms' too.

import Core::{ Assert };

enum Color {
    Red,
    Green,
    Blue,
}

variant Shape {
    Dot,
    Circle(int32),
    Rect(int32, int32),
}

variant Maybe<T> {
    Some(T),
    Nothing,
}

variant Slot {
    Some(int32),
    Empty,
}

variant Frame {
    Framed(Shape),
    Bare,
}

variant Problem {
    NotFound,
    Invalid(int32),
}

variant Kept<T, E> {
    Success(T),
    Failure(E),
}

struct Brush {
    color: Color;
    shape: Shape;
}

struct Palette {
    total: int32;
}

extend Palette {
    pub func Add(&var self, color: Color) {
        self.total += Weight(color);
    }
}

func Weight(color: Color) -> int32 {
    return match color {
        .Red => 1i32,
        .Green => 10i32,
        .Blue => 100i32,
    };
}

func Area(shape: Shape) -> int32 {
    return match shape {
        .Dot => 0i32,
        .Circle(radius) => radius * 3i32,
        .Rect(width, height) => width * height,
    };
}

func Make(size: int32) -> Shape {
    if size == 0i32 {
        return .Dot;
    }
    if size < 0i32 {
        return .Rect(-size, 2i32);
    }
    return .Circle(size);
}

func Lift<T>(value: T) -> Maybe<T> {
    return .Some(value);
}

func Nothing<T>() -> Maybe<T> {
    return .Nothing;
}

func Fill(value: int32) -> Slot {
    if value == 0i32 {
        return .Empty;
    }
    return .Some(value);
}

func Load(value: int32) -> int32 throws Problem {
    if value == 0i32 {
        throw .NotFound;
    }
    if value < 0i32 {
        throw .Invalid(value);
    }
    return value;
}

func Choose(warm: bool) -> Color {
    let chosen: Color = match warm {
        true => .Red,
        false => .Blue,
    };
    return chosen;
}

// Throws for a negative `value`.
func Checked(value: int32) -> int32 throws Problem {
    if value < 0i32 { throw Problem::Invalid(value); }
    return value;
}

// The outcome of `Checked`, kept as a value: the cases take their type from the return type through the `try`.
func Keep(value: int32) -> Kept<int32, Problem> {
    return try .Success(Checked(value)) catch { error => .Failure(error) };
}

func Main() -> int {
    let annotated: Color = .Green;
    Assert(Weight(annotated) == 10i32, "an annotated binding gives the case its type");
    Assert(Weight(.Blue) == 100i32, "so does a parameter");

    Assert(Area(Make(0i32)) == 0i32, "a returned unit case");
    Assert(Area(Make(2i32)) == 6i32 && Area(Make(-3i32)) == 6i32, "a returned case with a payload");
    Assert(Area(.Rect(2i32, 5i32)) == 10i32, "an argument case with a payload");

    var brush = Brush { color: .Red, shape: .Circle(1i32) };
    Assert(Weight(brush.color) == 1i32 && Area(brush.shape) == 3i32, "a field initializer gives the case its type");
    brush.color = .Blue;
    brush.shape = .Rect(3i32, 3i32);
    Assert(Weight(brush.color) == 100i32 && Area(brush.shape) == 9i32, "so does an assignment to a typed place");

    var palette = Palette { total: 0i32 };
    palette.Add(.Green);
    palette.Add(.Red);
    Assert(palette.total == 11i32, "a method parameter gives the case its type");

    Assert(Weight(Choose(true)) == 1i32 && Weight(Choose(false)) == 100i32, "an arm of a typed match");

    let framed: Frame = .Framed(.Circle(4i32));
    let radius = match framed {
        .Framed(.Circle(value)) => value,
        _ => 0i32,
    };
    Assert(radius == 4i32, "a case payload gives a nested case its type");

    let maybeColor: Color? = .Red;
    Assert((match maybeColor { .Some(color) => Weight(color), none => 0i32 }) == 1i32,
           "an optional destination names the type of its present value");

    let lifted = Lift(5i32);
    Assert((match lifted { .Some(value) => value, .Nothing => -1i32 }) == 5i32,
           "a generic variant takes its arguments from the expected type");
    let empty = Nothing<int32>();
    Assert((match empty { .Some(value) => value, .Nothing => -1i32 }) == -1i32, "and so does its unit case");

    let filled = Fill(7i32);
    Assert((match filled { .Some(value) => value, .Empty => -1i32 }) == 7i32,
           "a variant that is the expected type takes '.Some' over the native constructor");
    Assert((match Fill(0i32) { .Some(value) => value, .Empty => -1i32 }) == -1i32, "and its other cases still work");
    let native: int32? = .Some(3i32);
    Assert((native ?? 0i32) == 3i32, "without such a variant '.Some' is the native optional");

    Assert((try Load(0i32) catch { .NotFound => 1i32, _ => 0i32 }) == 1i32, "a 'throw' operand");
    Assert((try Load(-2i32) catch { .Invalid(value) => value, _ => 0i32 }) == -2i32,
           "a 'throw' operand with a payload");
    Assert((try Load(4i32) catch { _ => 0i32 }) == 4i32, "a success passes through");

    Assert(Keep(6i32) is .Success(6i32), "a 'try' operand takes the expected type");
    Assert(Keep(-3i32) is .Failure(.Invalid(-3i32)), "and so does a 'catch' arm");
    let annotatedKeep: Kept<int32, Problem> = try .Success(Checked(1i32)) catch { error => .Failure(error) };
    Assert(annotatedKeep is .Success(1i32), "an annotated binding gives a 'try' its type");
    var assigned: Kept<int32, Problem> = .Success(0i32);
    assigned = try .Success(Checked(-1i32)) catch { error => .Failure(error) };
    Assert(assigned is .Failure(_), "and so does an assignment");
    let optional: Kept<int32, Problem>? = try? .Success(Checked(2i32));
    Assert(optional is .Some(.Success(2i32)), "and 'try?' expects the optional's payload");
    return 0;
}
