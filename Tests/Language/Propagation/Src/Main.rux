import Core::Assert;

enum ParseError: int32 {
    Empty,
    Bad
}

// `?` propagates the outer level of a native fallible or optional: the payload continues, and a failure or an absence
// returns from the enclosing function.

func Read(ok: bool) -> int32 ! ParseError {
    if ok {
        return 7i32;
    }
    fail ParseError::Bad;
}

func Lookup(ok: bool) -> int32? {
    if ok {
        return 4i32;
    }
    return none;
}

// The success payload becomes the value of the expression; a failure returns from here unchanged.
func Doubled(ok: bool) -> int32 ! ParseError {
    let value = Read(ok)?;
    return value * 2i32;
}

// Two propagations in one expression, each evaluated once and bound separately.
func Sum(first: bool, second: bool) -> int32 ! ParseError {
    let total = Read(first)? + Read(second)?;
    return total;
}

// Propagation through a second function: the failure travels out of both without being rewritten.
func Chained(ok: bool) -> int32 ! ParseError {
    let value = Doubled(ok)?;
    return value + 1i32;
}

func Present(ok: bool) -> int32? {
    let value = Lookup(ok)?;
    return value * 3i32;
}

func Payload(outcome: int32 ! ParseError) -> int32 {
    return match outcome {
        .Success(value) => value,
        .Failure(error) => -1i32
    };
}

func Held(outcome: int32?) -> int32 {
    return outcome ?? -1i32;
}

func Main() -> int {
    Assert(Payload(Doubled(true)) == 14i32, "Expected the success payload to reach the caller doubled");
    Assert(Payload(Doubled(false)) == -1i32, "Expected the failure to propagate out of Doubled");

    Assert(Payload(Sum(true, true)) == 14i32, "Expected both propagations to contribute their payloads");
    Assert(Payload(Sum(false, true)) == -1i32, "Expected the first failure to leave before the second call");
    Assert(Payload(Sum(true, false)) == -1i32, "Expected the second failure to propagate too");

    Assert(Payload(Chained(true)) == 15i32, "Expected a payload propagated through two functions");
    Assert(Payload(Chained(false)) == -1i32, "Expected a failure propagated through two functions");

    Assert(Held(Present(true)) == 12i32, "Expected an optional payload to reach the caller");
    Assert(Held(Present(false)) == -1i32, "Expected an absent optional to propagate as none");
    return 0;
}
