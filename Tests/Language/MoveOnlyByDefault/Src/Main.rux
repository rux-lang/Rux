// Plain data copies; a type that owns resources moves.
// A type with no destructor anywhere inside it is plain data, and `=` from a named one copies its bytes: the copy and
// the source are independent and nothing runs. A type with a destructor, or one holding such a value, is move-only:
// `move` hands it over without running anything, and the value is destroyed exactly once, by its last owner. A copy
// of an owning value is an explicit `Clone`, which runs the type's own method exactly once per call. Generic code
// copies its type parameter under `Copyable` and duplicates it under `Cloneable`.

import Core::{ Assert, Cloneable, Copyable };

struct Point {
    x: int32;
    y: int32;
}

struct Segment {
    from: Point;
    to: Point;
    weights: int32[2];
}

struct Counter {
    clones: int32;
    drops: int32;
}

struct Resource {
    counter: *var Counter;
    id: int32;
}

extend Resource {
    func ~Resource(&var self) {
        // Safety: `self.counter` points at the `Counter` local of `Main`, which outlives every `Resource`.
        unsafe { self.counter.drops = self.counter.drops + 1; }
    }
}

extend Resource : Cloneable {
    func Clone(&self) -> Resource {
        // Safety: `self.counter` points at the `Counter` local of `Main`, which outlives every `Resource`.
        unsafe { self.counter.clones = self.counter.clones + 1; }
        return Resource { counter: self.counter, id: self.id + 100 };
    }
}

// Holds an owning value, so it owns resources too, though it declares no destructor of its own.
struct Holder {
    resource: Resource;
    tag: int32;
}

func Consume(resource: Resource) -> int32 {
    return resource.id;
}

func Pair<T: Copyable>(value: T) -> (T, T) {
    return (value, value);
}

func Duplicate<T: Cloneable>(value: &T) -> T {
    return value.Clone();
}

func PlainCopies() {
    let first = Point { x: 1, y: 2 };
    var second = first;
    second.x = 9;
    Assert(first.x == 1 && second.x == 9, "a copy of plain data is independent of its source");

    let segment = Segment { from: first, to: second, weights: [3, 4] };
    var copied = segment;
    copied.weights[0] = 7;
    Assert(segment.weights[0] == 3 && copied.weights[0] == 7, "nested arrays and structures copy their bytes");

    let pair = Pair<Point>(first);
    Assert(pair.0.y == 2 && pair.1.y == 2, "generic code copies a 'Copyable' type parameter");
    let numbers = Pair<(int32, bool)>((5, true));
    Assert(numbers.1.0 == 5 && numbers.1.1, "a tuple of plain data is copyable");
}

func Moves(counter: *var Counter) {
    let resource = Resource { counter: counter, id: 1 };
    let moved = move resource;
    // Safety: `counter` is `Main`'s pointer to its live `Counter` local.
    Assert(unsafe { counter.drops } == 0, "a move runs no destructor for its source");
    Assert(Consume(move moved) == 1, "a moved value keeps its state");
    // Safety: `counter` is `Main`'s pointer to its live `Counter` local.
    Assert(unsafe { counter.drops } == 1, "the last owner destroys it exactly once");

    let holder = Holder { resource: Resource { counter: counter, id: 2 }, tag: 3 };
    let other = move holder;
    Assert(other.tag == 3 && other.resource.id == 2, "a value holding an owning field moves whole");
    // Safety: `counter` is `Main`'s pointer to its live `Counter` local.
    Assert(unsafe { counter.drops } == 1, "and moving it destroys nothing");
}

func Clones(counter: *var Counter) {
    let original = Resource { counter: counter, id: 4 };
    let clone = original.Clone();
    // Safety: `counter` is `Main`'s pointer to its live `Counter` local.
    Assert(unsafe { counter.clones } == 1, "Clone runs the type's own method exactly once");
    Assert(clone.id == 104 && original.id == 4, "and leaves the source as it was");
    let generic = Duplicate<Resource>(original);
    // Safety: `counter` is `Main`'s pointer to its live `Counter` local.
    Assert(unsafe { counter.clones } == 2 && generic.id == 104, "generic code clones under 'Cloneable'");
}

func Main() -> int {
    PlainCopies();

    var counter = Counter { clones: 0, drops: 0 };
    Moves(@counter);
    Assert(counter.drops == 2, "every owning value is destroyed once when its scope ends");

    counter = Counter { clones: 0, drops: 0 };
    Clones(@counter);
    Assert(counter.clones == 2 && counter.drops == 3, "the original and each clone are destroyed exactly once");
    return 0;
}
