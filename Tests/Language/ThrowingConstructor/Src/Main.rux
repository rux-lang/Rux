// A constructor that can fail returns `Self ! E`, and its call is a fallible like any other: it is handled with `!`,
// `!!` or `catch`, and a value is only made when the constructor returns.

import Core::Diagnostics::Assert;

enum RangeError: int32 {
    Negative = 1
}

struct Positive {
    value: int32;
}

extend Positive {
    func New(value: int32) -> Self ! RangeError {
        if value < 0 { throw .Negative; }
        return Self { value };
    }
}

func Doubled(value: int32) -> int32 ! RangeError {
    let positive = Positive::New(value)!;
    return positive.value * 2;
}

func Main() -> int {
    let made = Positive::New(3) catch { _ => Positive { value: 0 } };
    Assert(made.value == 3, "a constructor that returns makes its value");
    Assert((Positive::New(-1) !! none) is none, "a constructor that throws makes nothing");
    Assert((Doubled(-4) catch { .Negative => -1 }) == -1, "the error passes to the caller with '!'");
    Assert((Doubled(4) catch { _ => 0 }) == 8, "and the value continues when it returns");
    return 0;
}
