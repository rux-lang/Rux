import Core::Assert;

struct Point {
    x: char8;
    y: float64;
    z: uint16;
}

struct Packet {
    tag: uint8;
    payload: uint32[];
}

// A constant computed from a layout query is a compile-time integer wherever one is required.
const PointBytes = sizeof(Point);

struct Frame {
    header: uint8[sizeof(Point)];
    words: uint16[alignof(float64)];
}

func Main() -> int {
    Assert(sizeof(int8) == 1, "Expected size of int8 to be 1 byte");
    Assert(sizeof(int16) == 2, "Expected size of int16 to be 2 bytes");
    Assert(sizeof(int32) == 4, "Expected size of int32 to be 4 bytes");
    Assert(sizeof(int64) == 8, "Expected size of int64 to be 8 bytes");

    Assert(sizeof(uint8) == 1, "Expected size of uint8 to be 1 byte");
    Assert(sizeof(uint16) == 2, "Expected size of uint16 to be 2 bytes");
    Assert(sizeof(uint32) == 4, "Expected size of uint32 to be 4 bytes");
    Assert(sizeof(uint64) == 8, "Expected size of uint64 to be 8 bytes");

    Assert(sizeof(char8) == 1, "Expected size of char8 to be 1 byte");
    Assert(sizeof(char16) == 2, "Expected size of char16 to be 2 bytes");
    Assert(sizeof(char32) == 4, "Expected size of char32 to be 4 bytes");

    Assert(sizeof(float32) == 4, "Expected size of float32 to be 4 bytes");
    Assert(sizeof(float64) == 8, "Expected size of float64 to be 8 bytes");

    Assert(sizeof(Point) == 24, "Expected size of Point to be 24 bytes");
    Assert(sizeof(uint8[10]) == 10, "Expected inline uint8 array to occupy 10 bytes");
    Assert(sizeof(uint32[3]) == 12, "Expected inline uint32 array to occupy 12 bytes");
    Assert(sizeof(Packet) == 4, "Expected a flexible tail to contribute alignment but no storage");

    let raw: uint8[sizeof(int64)] = [0; sizeof(int64)];
    let copy: uint8[PointBytes] = [7; PointBytes];
    Assert(raw.length == 8, "Expected sizeof to give an array length");
    Assert(copy.length == 24 && copy[23] == 7, "Expected a sizeof constant to give an array length and a repeat count");
    Assert(sizeof(Frame) == 40, "Expected layout queries in field array lengths");
    return 0;
}
