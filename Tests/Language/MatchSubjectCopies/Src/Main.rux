// Destroying the copy a by-value match makes of its subject.
// A match whose arms bind from a named copyable value matches a copy of it: the original stays with its owner and the
// arms own the copy, exactly as if it had been handed over with `<-`. Each binding is destroyed when its arm ends, a
// part the arm leaves is destroyed at the top of the arm, and a copy no arm takes is destroyed as the match ends. A
// copy gets the id of its source plus 10, and each tracked value appends its id to a log as it is destroyed, while
// each check appends 00 where it stands, so the log is the exact order of events.

import Core::Assert;

struct Log {
    copies: int32;
    drops: int32;
    order: int64;
}

struct Tracked {
    log: *var Log;
    id: int32;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked) {
        self.log = other.log;
        self.id = other.id + 10;
        self.log.copies = self.log.copies + 1;
    }

    func ~Tracked(self: &var Tracked) {
        self.log.drops = self.log.drops + 1;
        self.log.order = self.log.order * 100 + (self.id as int64);
    }
}

// No destructor of its own, so a pattern may take its fields apart.
struct Holder {
    item: Tracked;
    count: int32;
}

variant Parcel {
    Single(Tracked),
    Double(Tracked, Tracked),
    Empty
}

func Mark(log: *var Log) {
    log.order = log.order * 100;
}

func Track(log: *var Log, id: int32) -> Tracked {
    return Tracked { log: log, id: id };
}

func MakePair(log: *var Log) -> (Tracked, int32) {
    return (Track(log, 1), 2i32);
}

func Fail(log: *var Log, id: int32) -> int32 ! Tracked {
    fail Track(log, id);
}

func Reset(log: *var Log) {
    log.copies = 0;
    log.drops = 0;
    log.order = 1;
}

func TupleStatement(log: *var Log) {
    let pair = (Track(log, 1), 2i32);
    match pair {
        (item, count) => {
            Mark(log);
            Assert(item.id == 11 && count == 2, "the arm binds the copy");
        }
    }
    Mark(log);
}

func TupleExpression(log: *var Log) {
    let pair = (Track(log, 1), 2i32);
    let id = match pair { (item, _) => item.id };
    Mark(log);
    Assert(id == 11, "the arm reads the copy");
}

func TupleLeavesPart(log: *var Log) {
    let pair = (Track(log, 1), 2i32);
    match pair {
        (_, count) => {
            Mark(log);
            Assert(count == 2, "the arm binds the count");
        }
    }
}

func StructBindsField(log: *var Log) {
    let holder = Holder { item: Track(log, 1), count: 2i32 };
    match holder {
        Holder { item: item, count: count } => {
            Mark(log);
            Assert(item.id == 11 && count == 2, "the arm binds both fields of the copy");
        }
    }
}

func StructOmitsField(log: *var Log) {
    let holder = Holder { item: Track(log, 1), count: 2i32 };
    match holder {
        Holder { count: count } => {
            Mark(log);
            Assert(count == 2, "the arm binds the count");
        }
    }
}

func VariantPayload(log: *var Log) {
    let parcel = Parcel::Double(Track(log, 1), Track(log, 2));
    match parcel {
        .Single(_) => Assert(false, "the parcel holds two items"),
        .Double(first, _) => {
            Mark(log);
            Assert(first.id == 11, "the arm binds the copy of the first payload");
        },
        .Empty => Assert(false, "the parcel holds two items")
    }
}

func OptionalPayload(log: *var Log) {
    let maybe: Tracked? = Track(log, 1);
    match maybe {
        item? => {
            Mark(log);
            Assert(item.id == 11, "the arm binds the copy of the payload");
        },
        none => Assert(false, "the optional is present")
    }
}

func SumMember(log: *var Log) {
    let either: Tracked | int32 = Track(log, 1);
    match either {
        item: Tracked => {
            Mark(log);
            Assert(item.id == 11, "the arm binds the copy of the member");
        },
        _: int32 => Assert(false, "the sum holds a tracked value")
    }
}

// The guard refutes the first arm after it bound the copy; only the arm that is taken destroys it.
func GuardRefutesArm(log: *var Log) {
    let pair = (Track(log, 1), 2i32);
    match pair {
        (item, count) if count > 5 => Assert(item.id < 0, "the guard refutes the first arm"),
        (item, _) => {
            Mark(log);
            Assert(item.id == 11, "the second arm binds the copy");
        }
    }
}

// No arm takes the copy, so the match destroys it as it ends.
func GuardRefutesEveryArm(log: *var Log) {
    let pair = (Track(log, 1), 2i32);
    match pair {
        (item, count) if count > 5 => Assert(item.id < 0, "the guard refutes the only arm")
    }
    Mark(log);
}

// An arm that binds nothing from the copy destroys it whole at its top.
func ArmBindsNothing(log: *var Log) {
    let pair = (Track(log, 1), 2i32);
    match pair {
        (item, 7) => Assert(item.id < 0, "the count is not 7"),
        else => Mark(log)
    }
}

// A match that binds nothing makes no copy, and the subject stays with its owner.
func NothingBound(log: *var Log) {
    let pair = (Track(log, 1), 2i32);
    match pair {
        (_, 2) => Mark(log),
        else => Assert(false, "the count is 2")
    }
}

// A temporary has no other owner, so the match takes it without a copy.
func TemporarySubject(log: *var Log) {
    match MakePair(log) {
        (item, _) => {
            Mark(log);
            Assert(item.id == 1, "the arm binds the temporary itself");
        }
    }
}

// A value handed over that no arm takes is destroyed as the match ends.
func MovedSubjectNotTaken(log: *var Log) {
    let pair = (Track(log, 1), 2i32);
    match <-pair {
        (item, count) if count > 5 => Assert(item.id < 0, "the guard refutes the only arm")
    }
    Mark(log);
}

func CatchNamed(log: *var Log) {
    let outcome = Fail(log, 1);
    let id = outcome catch { error => error.id };
    Mark(log);
    Assert(id == 11, "the arm binds the copy of the error");
}

func CatchTemporary(log: *var Log) {
    let value = Fail(log, 1) catch { else => 0i32 };
    Mark(log);
    Assert(value == 0, "the arm recovers");
}

func Main() -> int {
    var log = Log { copies: 0, drops: 0, order: 1 };

    TupleStatement(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 100110001, "a bound copy is destroyed as the arm ends");

    Reset(@log);
    TupleExpression(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1110001, "a match expression destroys its copy");

    Reset(@log);
    TupleLeavesPart(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1110001, "an unbound part of the copy is destroyed");

    Reset(@log);
    StructBindsField(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1001101, "a bound field of the copy is destroyed");

    Reset(@log);
    StructOmitsField(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1110001, "an omitted field of the copy is destroyed");

    Reset(@log);
    VariantPayload(@log);
    Assert(log.copies == 2 && log.drops == 4 && log.order == 11200110201, "the copied payloads are destroyed");

    Reset(@log);
    OptionalPayload(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1001101, "a copied optional payload is destroyed");

    Reset(@log);
    SumMember(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1001101, "a copied sum member is destroyed");

    Reset(@log);
    GuardRefutesArm(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1001101, "a refuted arm destroys nothing");

    Reset(@log);
    GuardRefutesEveryArm(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1110001, "a copy no arm takes is destroyed");

    Reset(@log);
    ArmBindsNothing(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1110001, "an arm that binds nothing destroys the copy");

    Reset(@log);
    NothingBound(@log);
    Assert(log.copies == 0 && log.drops == 1 && log.order == 10001, "a match that binds nothing makes no copy");

    Reset(@log);
    TemporarySubject(@log);
    Assert(log.copies == 0 && log.drops == 1 && log.order == 10001, "a temporary subject is taken without a copy");

    Reset(@log);
    MovedSubjectNotTaken(@log);
    Assert(log.copies == 0 && log.drops == 1 && log.order == 10100, "a subject no arm takes is destroyed");

    Reset(@log);
    CatchNamed(@log);
    Assert(log.copies == 1 && log.drops == 2 && log.order == 1110001, "a caught copy is destroyed");

    Reset(@log);
    CatchTemporary(@log);
    Assert(log.copies == 0 && log.drops == 1 && log.order == 10100, "a caught temporary is destroyed");
    return 0;
}
