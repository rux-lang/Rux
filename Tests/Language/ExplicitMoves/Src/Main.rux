func Take(value: int32) -> int32 {
    return value;
}

// Plain data: `=` copies its bytes, runs no user code, and leaves the source usable.
struct CopyOnly {
    value: int32;
    flag: bool;
}

struct MoveOnly {
    value: int32;
}

extend MoveOnly {
    func =(self: &var MoveOnly, other: &MoveOnly);

    func MoveOnly(value: int32) -> MoveOnly {
        return MoveOnly { value: value };
    }

    func ~MoveOnly(self: &var MoveOnly) {}
}

#NoMove
struct Immovable {
    value: int32;
}

func Consume(value: MoveOnly) -> int32 {
    return value.value;
}

func MoveNamed() -> int32 {
    let source = MoveOnly { value: 17i32 };
    let moved <- source;
    return moved.value;
}

// A copy through a by-value parameter is the caller's bytes; changing it leaves the caller's value alone.
func CopyFrom(source: CopyOnly) -> int32 {
    var local = CopyOnly { value: 0i32, flag: false };
    local = source;
    local.flag = !local.flag;
    return local.value;
}

func Main() -> int {
    let first = 40i32;
    let second <- first;
    var destination = 0i32;
    destination <- second;
    if Take(<-destination) != 40i32 {
        return 1;
    }

    let original = CopyOnly { value: 11i32, flag: true };
    let copied = original;
    if copied.value != 11i32 || original.value != 11i32 || !copied.flag {
        return 2;
    }

    if MoveNamed() != 17i32 {
        return 3;
    }
    if Consume(MoveOnly(23i32)) != 23i32 {
        return 4;
    }
    if sizeof(Immovable) != sizeof(int32) {
        return 5;
    }
    if CopyFrom(original) != 11i32 || !original.flag {
        return 6;
    }
    return 0;
}
