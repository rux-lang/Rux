// Field shorthand in construction and in patterns, and omitted fields in structure and case patterns.
// `Point { x, y }` binds each field to a variable of the same name, in a match arm and in `let`, as `.Circle { radius }`
// does for a case payload. A payload written with field names may leave fields out, as a structure pattern may; an
// omitted field matches anything, and over a consumed subject it is destroyed at the top of the arm. A struct or case
// literal reads the same way: `Point { x, y }` is `Point { x: x, y: y }`, and a move-only binding is still moved with
// `move` written out.

import Core::Assert;

struct Point {
    x: int32;
    y: int32;
}

variant Shape {
    Point,
    Circle { radius: int32; },
    Rectangle { width: int32; height: int32; }
}

struct Log {
    count: int32;
    order: int64;
}

struct Tracked {
    log: *var Log;
    id: int32;
}

extend Tracked {
    func ~Tracked(&var self) {
        // Safety: every `Tracked` in this test holds a pointer to a `Log` local of `Main` that outlives it.
        unsafe {
            self.log.count = self.log.count + 1;
            self.log.order = self.log.order * 10 + (self.id as int64);
        }
    }
}

variant Parcel {
    Empty,
    Boxed { label: Tracked; contents: Tracked; }
}

func Mark(log: *var Log) {
    // Safety: every caller passes a pointer to a `Log` local of `Main`.
    unsafe { log.order = log.order * 10; }
}

func Track(log: *var Log, id: int32) -> Tracked {
    return Tracked { log, id };
}

func Make(x: int32, y: int32) -> Point {
    return Point { y, x };
}

func Box(width: int32, height: int32) -> Shape {
    return Shape::Rectangle { width, height };
}

func Pack(log: *var Log) -> Parcel {
    let label = Track(log, 3);
    let contents = Track(log, 4);
    return Parcel::Boxed { label: move label, contents: move contents };
}

func DropPacked(log: *var Log) {
    let parcel = Pack(log);
}

func OnAxis(p: Point) -> int32 {
    return match p {
        Point { x: 0, y } => y,
        Point { x, y: 0 } => x,
        _ => -1i32
    };
}

func Width(shape: Shape) -> int32 {
    return match shape {
        .Rectangle { width } => width,
        .Circle { radius } => radius * 2i32,
        .Point => 0i32
    };
}

func Tall(shape: Shape) -> bool {
    return match shape {
        .Rectangle { height: 0 } => false,
        .Rectangle { } => true,
        _ => false
    };
}

func MatchOmitsCaseField(log: *var Log) {
    let parcel = Parcel::Boxed { label: Track(log, 1), contents: Track(log, 2) };
    match move parcel {
        .Boxed { label } => {
            Mark(log);
            Assert(label.id == 1, "the arm binds the label");
        },
        .Empty => {}
    }
}

func Main() -> int {
    Assert(OnAxis(Point { x: 0, y: 7 }) == 7, "the shorthand binds y beside a tested x");
    Assert(OnAxis(Point { x: 5, y: 0 }) == 5, "the shorthand binds x beside a tested y");
    Assert(OnAxis(Point { x: 1, y: 1 }) == -1, "a point off both axes takes the else arm");

    let p = Point { x: 3, y: 4 };
    let Point { x, y } = p;
    Assert(x == 3 && y == 4, "a destructuring let binds both fields by shorthand");
    let Point { y: height } = p;
    Assert(height == 4, "a destructuring let may leave a field out");

    Assert(Width(Shape::Rectangle { width: 6, height: 2 }) == 6, "a case pattern may leave a named field out");
    Assert(Width(Shape::Circle { radius: 3 }) == 6, "the case shorthand still binds its field");
    Assert(Tall(Shape::Rectangle { width: 1, height: 2 }), "a case pattern may test one named field");
    Assert(!Tall(Shape::Rectangle { width: 1, height: 0 }), "the tested field selects the first arm");

    let built = Make(3, 4);
    Assert(built.x == 3 && built.y == 4, "a struct literal takes each field from the binding of its name");
    let rebuilt = Point { x, y };
    Assert(rebuilt.x == 3 && rebuilt.y == 4, "a literal rebuilds what a destructuring let took apart");
    let mixed = Point { x: 8, y };
    Assert(mixed.x == 8 && mixed.y == 4, "a literal may mix shorthand and written-out fields");
    Assert(Width(Box(5, 2)) == 5, "a case literal takes each named field from the binding of its name");

    var packed = Log { count: 0, order: 0 };
    DropPacked(@packed);
    Assert(packed.count == 2, "move-only bindings are moved into a case literal with '<-' written out");

    var log = Log { count: 0, order: 0 };
    MatchOmitsCaseField(@log);
    Assert(log.count == 2 && log.order == 201, "an omitted payload field is destroyed at the top of the arm");
    return 0;
}
