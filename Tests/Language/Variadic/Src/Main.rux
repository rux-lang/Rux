import Core::Assert;

func Sum(args: float...) -> float {
    var sum: float = 0.0;
    for val in args {
        sum += val;
    }
    return sum;
}

func Calc(args: float...) -> float {
    return Sum(args...);
}

func Main() -> int {
    var res = Sum();
    Assert(res < 0.001, "Expected sum to be 0.0 for no arguments");

    res = Sum(5.0);
    Assert(res - 5.0 < 0.001, "Expected sum to be 5.0 for single argument");

    res = Sum(1.0, 2.0, 3.0);
    Assert(res - 6.0 < 0.001, "Expected sum to be 6.0 for three arguments");

    res = Calc(1.5, 2.5, 3.0, 5.0);
    Assert(res - 12.0 < 0.001, "Expected sum to be 12.0 for four arguments");

    // A spread operand converts to the variadic slice like any other argument: an array is viewed as one.
    let scores: float[3] = [1.0, 2.0, 4.0];
    res = Sum(scores...);
    Assert(res - 7.0 < 0.001, "Expected an array to spread into the variadic parameter");
    var writable: float[2] = [0.5, 0.25];
    res = Sum(writable[..]...);
    Assert(res - 0.75 < 0.001, "Expected a writable slice to spread as a read-only one");

    return 0;
}
