// A case written without its type takes it from the type its context expects. Inside `.Some(...)` that is the
// optional's payload. Passed to a generic function, it is the parameter's type once the type arguments written at the
// call and the arguments before it decide that type; a `try` marking such a case passes the type on to it.

import Core::{ Assert, Result };

variant Shape {
    Dot,
    Circle(int),
}

func Radius(shape: Shape?) -> int {
    return match shape {
        .Some(.Circle(radius)) => radius,
        _ => 0,
    };
}

func ValueOr<T, E>(outcome: Result<T, E>, fallback: T) -> T {
    return match outcome {
        .Success(value) => value,
        .Failure(_) => fallback,
    };
}

func Second<T>(first: T, second: T) -> T {
    return second;
}

func Half(value: int) -> int throws bool {
    if value % 2 != 0 { throw true; }
    return value / 2;
}

func Succeeded(outcome: Result<int, bool>) -> bool {
    return outcome is .Success(_);
}

func Main() -> int {
    let maybe: Shape? = .Some(.Circle(4));
    Assert(Radius(maybe) == 4, "an annotated optional");
    Assert(Radius(.Some(.Circle(5))) == 5 && Radius(.Some(.Dot)) == 0, "an optional parameter");

    Assert(ValueOr<int, bool>(.Success(4), 0) == 4, "written type arguments");
    Assert(ValueOr<int, bool>(.Failure(true), 7) == 7, "a failure");
    Assert(ValueOr<int, bool>(try .Success(Half(8)) catch { error => .Failure(error) }, 0) == 4, "through 'try'");
    Assert(ValueOr<int, bool>(try .Success(Half(3)) catch { error => .Failure(error) }, 9) == 9, "its failure");
    let dot = Shape::Dot;
    Assert(Second(dot, .Circle(3)) is .Circle(3), "an argument before it");

    Assert(Succeeded(.Success(3)) && !Succeeded(.Failure(true)), "a parameter of an ordinary function");
    Assert(Succeeded(try .Success(Half(2)) catch { error => .Failure(error) }), "through 'try' there too");
    return 0;
}
