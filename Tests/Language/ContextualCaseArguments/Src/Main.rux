// A case written without its type takes it from the type its context expects. Inside `.Some(...)` that is the
// optional's payload. Passed to a generic function, it is the parameter's type once the type arguments written at the
// call and the arguments before it decide that type. A success value converts to a fallible parameter the same way.

import Core::Diagnostics::Assert;

variant Shape {
    Dot,
    Circle(int),
}

func Radius(shape: Shape?) -> int {
    return match shape {
        .Circle(radius)? => radius,
        _ => 0,
    };
}

func ValueOr<T, E>(outcome: T ! E, fallback: T) -> T {
    return match &outcome {
        .Success(value) => value,
        .Failure(_) => fallback,
    };
}

func Second<T>(first: T, second: T) -> T {
    return second;
}

func Half(value: int) -> int ! bool {
    if value % 2 != 0 { throw true; }
    return value / 2;
}

func Succeeded(outcome: int ! bool) -> bool {
    return outcome is .Success(_);
}

func Main() -> int {
    let maybe: Shape? = .Circle(4);
    Assert(Radius(maybe) == 4, "an annotated optional");
    Assert(Radius(.Circle(5)) == 5 && Radius(.Dot) == 0, "an optional parameter");

    Assert(ValueOr<int, bool>(4, 0) == 4, "a success converts to the written type arguments");
    Assert(ValueOr<int, bool>(Half(8), 0) == 4, "a fallible argument");
    Assert(ValueOr<int, bool>(Half(3), 9) == 9, "its failure");
    let dot = Shape::Dot;
    Assert(Second(dot, .Circle(3)) is .Circle(3), "an argument before it");

    Assert(Succeeded(3) && !Succeeded(Half(3)), "a parameter of an ordinary function");
    Assert(Succeeded(Half(2)), "a fallible argument there too");
    return 0;
}
