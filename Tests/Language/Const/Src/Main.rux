

// A constant of slice type is addressed rather than inlined, so it must exist
// in read-only data with a {data, length} header. Reading one used to follow a
// header that was never filled in.

const SCALAR: uint32 = 5;
const RATIO: float64 = 1.5;

const WORDS: uint32[4] = [0xA2F9836Eu32, 0x4E441529u32, 0u32, 0xFFFFFFFFu32];
const SIGNED: int64[3] = [-1i64, 0i64, 9223372036854775807i64];
const REALS: float64[3] = [1.5, -2.5, 1e300];
const SMALL: uint8[3] = [1u8, 2u8, 255u8];
const NAMED: uint32[2] = [SCALAR, 7u32];
const TEXT: char8[..] = "abc";

// An element naming a constant computed from an expression is folded to that constant's value. Such a table used to be
// laid out as zeros, literal elements included.
const SUM: int32 = 2i32 + 3i32;
const NEGATED: int32 = -SUM * 4i32;
const THIRD: float64 = 1.0 / 3.0;
const WIDE: uint128 = (1u128 << 100u32) + 7u128;
const COMPUTED: int32[3] = [7i32, SUM, NEGATED];
const COMPUTED_REALS: float64[2] = [THIRD, RATIO];
const COMPUTED_WIDE: uint128[2] = [WIDE, 1u128];
const COMPUTED_REPEAT: int32[3] = [SUM; 3];

// A named constant is a compile-time integer, so it can size an array, count a
// repeat, and feed another constant.
const LIMIT: uint = 100;
const HALF = LIMIT / 2u;

func Sum(values: uint32[..]) -> uint32 {
    var total: uint32 = 0;
    for value in values {
        total += value;
    }
    return total;
}

func Main() -> int {
    // Scalar constants are inlined and were never affected.
    if SCALAR != 5u32 {
        return 1;
    }
    if RATIO != 1.5 {
        return 2;
    }

    // Elements survive at every width, including the ends of each range.
    if WORDS[0] != 0xA2F9836Eu32 {
        return 3;
    }
    if WORDS[3] != 0xFFFFFFFFu32 {
        return 4;
    }
    if SIGNED[0] != -1i64 {
        return 5;
    }
    if SIGNED[2] != 9223372036854775807i64 {
        return 6;
    }
    if REALS[1] != -2.5 {
        return 7;
    }
    if REALS[2] != 1e300 {
        return 8;
    }
    if SMALL[2] != 255u8 {
        return 9;
    }

    // An element may name another constant.
    if NAMED[0] != 5u32 {
        return 10;
    }

    // The length comes from the header, not from the data pointer.
    if WORDS.length != 4 {
        return 11;
    }
    if TEXT.length != 3 {
        return 12;
    }
    if TEXT[2] != c8'c' {
        return 13;
    }

    // Iterating and passing a constant array as a slice.
    var iterated: uint32 = 0;
    for value in WORDS {
        iterated += value;
    }
    if iterated != Sum(WORDS) {
        return 14;
    }

    // Indexing with a computed index reaches the same data.
    var index: uint = 0;
    var total: uint32 = 0;
    while index < WORDS.length {
        total += WORDS[index];
        index += 1;
    }
    if total != iterated {
        return 15;
    }

    // A named constant sizes an array and counts its repeat.
    var flags: bool[LIMIT] = [false; LIMIT];
    flags[LIMIT - 1] = true;
    if flags.length != 100 || !flags[99] || flags[0] {
        return 16;
    }
    const EXTRA = 3;
    let halves: uint8[HALF + EXTRA] = [7u8; EXTRA + HALF];
    if halves.length != 53 || halves[52] != 7u8 {
        return 17;
    }

    // Elements naming computed constants carry their values, and the literals beside them survive.
    if COMPUTED[0] != 7i32 || COMPUTED[1] != 5i32 || COMPUTED[2] != -20i32 {
        return 18;
    }
    if COMPUTED_REALS[0] != THIRD || COMPUTED_REALS[1] != 1.5 {
        return 19;
    }
    if COMPUTED_WIDE[0] != WIDE || COMPUTED_WIDE[1] != 1u128 {
        return 20;
    }
    if COMPUTED_REPEAT[0] != 5i32 || COMPUTED_REPEAT[2] != 5i32 {
        return 21;
    }

    return 0;
}
