// Named placeholders in format strings: `{name}` and `{name:spec}` write the binding or field path they name, as `{}`
// and `{:spec}` would write an argument passed for them. The compiler rewrites such a literal, passed to a `#Format`
// parameter, into the positional literal and the values its names stand for, so the formatter is the same one either
// way: these checks compare a named call with the positional call it stands for.

import Allocator::{ Allocator, SystemAllocator };
import Core::Assert;
import Format::Render;
import Text::{ FormatError, String, StringView };

struct Point {
    x: int32;
    y: int32;
}

struct Labeled {
    name: StringView;
    at: Point;
}

const Greeting: int32 = 42;

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    let key = 7;
    let value = 2.5;
    Expect(allocator, Render(allocator, "{key} = {value}"), "7 = 2.5", "two bindings");
    Expect(allocator, Render(allocator, "{key} = {value}"), Rendered(allocator, Render(allocator, "{} = {}", key, value)),
           "as the positional call");

    let point = Point { x: 3, y: -4 };
    Expect(allocator, Render(allocator, "({point.x}, {point.y})"), "(3, -4)", "field paths");
    Expect(allocator, Render(allocator, "[{point.x:>4}]"), "[   3]", "a field path with a spec");
    let labeled = Labeled { name: StringView::FromValidated("origin"), at: Point { x: 0, y: 1 } };
    Expect(allocator, Render(allocator, "{labeled.name} at {labeled.at.y}"), "origin at 1", "a nested field path");

    Expect(allocator, Render(allocator, "{{key}} is {key}"), "{key} is 7", "doubled braces stay literal");
    Expect(allocator, Render(allocator, "{Greeting}!"), "42!", "a module constant");
    Expect(allocator, Render(allocator, "{key}{key}"), "77", "a name written twice");
    Expect(allocator, Render(allocator, "no placeholders"), "no placeholders", "a literal without placeholders");
    return 0;
}

func Expect(allocator: Allocator, outcome: String ! FormatError, expected: char8[..], message: char8[..]) {
    let rendered = Rendered(allocator, move outcome);
    Assert(rendered.View().Equals(StringView::FromValidated(expected)), message);
}

func Expect(allocator: Allocator, outcome: String ! FormatError, expected: String, message: char8[..]) {
    let rendered = Rendered(allocator, move outcome);
    Assert(rendered.View().Equals(expected.View()), message);
}

// The rendered text, or an empty string when rendering failed, which no expected text matches.
func Rendered(allocator: Allocator, outcome: String ! FormatError) -> String {
    return (move outcome) catch { _ => String(allocator) };
}
