// Named placeholders in format strings: `{name}` and `{name:spec}` write the binding or field path they name, as `{}`
// and `{:spec}` would write an argument passed for them. The compiler rewrites such a literal, passed to a `#Format`
// parameter, into the positional literal and the values its names stand for, so the formatter is the same one either
// way: these checks compare a named call with the positional call it stands for.

import Allocator::{ Allocator, SystemAllocator };
import Core::Diagnostics::Assert;
import Format::Render;
import Text::{ String, StringView };
import Text::Formatting::FormatError;

struct Point {
    x: int32;
    y: int32;
}

struct Labeled {
    name: StringView;
    at: Point;
}

const Greeting: int32 = 42;

func Main() -> int {
    let allocator = SystemAllocator::New();

    let key = 7;
    let value = 2.5;
    Expect(allocator, Render(allocator, "{key} = {value}") !! none, "7 = 2.5", "two bindings");
    Expect(allocator, Render(allocator, "{key} = {value}") !! none,
           Rendered(allocator, Render(allocator, "{} = {}", key, value) !! none),
           "as the positional call");

    let point = Point { x: 3, y: -4 };
    Expect(allocator, Render(allocator, "({point.x}, {point.y})") !! none, "(3, -4)", "field paths");
    Expect(allocator, Render(allocator, "[{point.x:>4}]") !! none, "[   3]", "a field path with a spec");
    let labeled = Labeled { name: StringView::FromValidated("origin"), at: Point { x: 0, y: 1 } };
    Expect(allocator, Render(allocator, "{labeled.name} at {labeled.at.y}") !! none, "origin at 1", "a nested field path");

    Expect(allocator, Render(allocator, "{{key}} is {key}") !! none, "{key} is 7", "doubled braces stay literal");
    Expect(allocator, Render(allocator, "{Greeting}!") !! none, "42!", "a module constant");
    Expect(allocator, Render(allocator, "{key}{key}") !! none, "77", "a name written twice");
    Expect(allocator, Render(allocator, "no placeholders") !! none, "no placeholders", "a literal without placeholders");
    return 0;
}

func Expect(allocator: Allocator, outcome: String?, expected: char8[..], message: char8[..]) {
    let rendered = Rendered(allocator, outcome);
    Assert(rendered.View().Equals(StringView::FromValidated(expected)), message);
}

func Expect(allocator: Allocator, outcome: String?, expected: String, message: char8[..]) {
    let rendered = Rendered(allocator, outcome);
    Assert(rendered.View().Equals(expected.View()), message);
}

// The rendered text, or an empty string when rendering failed, which no expected text matches.
func Rendered(allocator: Allocator, outcome: String?) -> String {
    return (outcome) ?? String::New(allocator);
}
