import Core::{ #target };

struct Bytes9 { bytes: uint8[9]; }
struct Bytes10 { bytes: uint8[10]; }
struct Bytes11 { bytes: uint8[11]; }
struct Bytes12 { bytes: uint8[12]; }
struct Bytes13 { bytes: uint8[13]; }
struct Bytes14 { bytes: uint8[14]; }
struct Bytes15 { bytes: uint8[15]; }

func Echo<T>(value: T) -> T { return value; }
func Spill<T>(a: int, b: int, c: int, d: int, e: int, value: T, tail: int, last: int) -> bool {
    return a == 1 && b == 2 && c == 3 && d == 4 && e == 5 && tail == 6 && last == 7 && Echo(value) == value;
}

when #target.arch {
    .X86_64 => {
        #Abi(.SysV)
        func SysVEcho<T>(value: T) -> T { return value; }

        #Abi(.SysV)
        func SysVSpill<T>(a: int, b: int, c: int, d: int, e: int, value: T, tail: int, last: int) -> bool {
            return a == 1 && b == 2 && c == 3 && d == 4 && e == 5 && tail == 6 && last == 7 &&
                SysVEcho(value) == value;
        }

        #Abi(.SysV)
        func SysVPairs<T>(a: T, b: T, c: T, d: T, tail: int) -> bool {
            return a == b && b == c && c == d && tail == 41;
        }

        func CheckSysV<T>(value: T) -> bool {
            return SysVEcho(value) == value && SysVSpill(1, 2, 3, 4, 5, value, 6, 7) &&
                SysVPairs(value, value, value, value, 41);
        }
    },
    .AArch64 => { func CheckSysV<T>(value: T) -> bool { return true; } }
}

func Return9(value: Bytes9) -> Bytes9 { return value; }
func Check9() -> bool {
    let value = Bytes9 { bytes: [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8] };
    let callback = Return9;
    let direct = Echo(value);
    let indirect = callback(value);
    let spilled = Spill(1, 2, 3, 4, 5, value, 6, 7);
    return direct == value && indirect == value && spilled && CheckSysV(value);
}

