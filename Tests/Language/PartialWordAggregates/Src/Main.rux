func Return15(value: Bytes15) -> Bytes15 { return value; }
func Check15() -> bool {
    let value = Bytes15 { bytes: [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8] };
    let callback = Return15;
    let direct = Echo(value);
    let indirect = callback(value);
    let spilled = Spill(1, 2, 3, 4, 5, value, 6, 7);
    return direct == value && indirect == value && spilled && CheckSysV(value);
}

func Main() -> int {
    if !Check9() { return 9; }
    if !Check10() { return 10; }
    if !Check11() { return 11; }
    if !Check12() { return 12; }
    if !Check13() { return 13; }
    if !Check14() { return 14; }
    if !Check15() { return 15; }
    return 0;
}
