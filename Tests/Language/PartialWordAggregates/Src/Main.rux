func Return14(value: Bytes14) -> Bytes14 { return value; }
func Check14() -> bool {
    let value = Bytes14 { bytes: [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8] };
