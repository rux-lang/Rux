import Core::Assert;

interface Measured {
    func Measure() -> int;
}

interface Scaled {
    func Times(factor: int) -> int;
}

// An interface that requires nothing: every type argument satisfies it, so the bound only documents intent.
interface Marker {}

struct Square {
    size: int;
}

extend Square : Measured {
    func Measure(self: *Square) -> int {
        return self.size * self.size;
    }
}

extend Square : Scaled {
    func Times(self: *Square, factor: int) -> int {
        return self.size * factor;
    }
}

struct Segment {
    length: int;
}

// Conformance by declaring the required method: no `extend Segment : Measured` is written, and the bound below is
// still satisfied, because the operations a constraint names are the ones a constrained generic can call.
extend Segment {
    func Measure(self: *Segment) -> int {
        return self.length;
    }
}

// Each instantiation calls the method of its own type argument, resolved statically: no vtable is involved, and the
// symbolic form of this function is never emitted at all.
func Total<T: Measured>(value: T) -> int {
    return value.Measure();
}

// A bound is satisfied by a type parameter that carries it, so the constraint travels through this call unchanged and
// the inner instantiation reaches the same concrete method.
func Doubled<U: Measured>(value: U) -> int {
    return Total<U>(value) * 2;
}

// Two bounds on one parameter, each contributing its own operation.
func Both<T: Measured + Scaled>(value: T, factor: int) -> int {
    return value.Measure() + value.Times(factor);
}

func Tagged<T: Marker>(value: T) -> int {
    return 11;
}

struct Cell<T: Measured> {
    item: T;
}

// A method of a generic extend block calls the bound the extended type declared.
extend Cell<T> {
    func Inside(self: *Cell<T>) -> int {
        return self.item.Measure();
    }
}

// `Self` names whichever type implements the interface, which is the only way an
// interface can say that an operand is the same type as its receiver: there are
// no generic interfaces, so `Equatable<T>` cannot be written.
interface Equatable {
    func Equals(other: *Self) -> bool;
}

interface Ranked {
    func Rank() -> int;
    func Better(other: *Self) -> Self;
}

struct Card {
    value: int;
}

extend Card : Equatable {
    func Equals(self: *Card, other: *Card) -> bool {
        return self.value == other.value;
    }
}

extend Card : Ranked {
    func Rank(self: *Card) -> int {
        return self.value;
    }

    func Better(self: *Card, other: *Card) -> Card {
        return self.value >= other.value ? *self : *other;
    }
}

// The bound carries the operation, and `Self` in it resolves to the type argument.
func Matches<T: Equatable>(left: *T, right: *T) -> bool {
    return left.Equals(right);
}

// `Self` as a return type as well as a parameter, and a second bound alongside it.
func Best<T: Ranked>(left: *T, right: *T) -> int {
    let winner = left.Better(right);
    return winner.Rank();
}

func Main() -> int {
    var square = Square { size: 5 };
    Assert(square.Measure() == 25, "Expected the nominal implementation to measure the square");
    Assert(Total<Square>(square) == 25, "Expected the bound operation to resolve to the square's method");
    Assert(Doubled<Square>(square) == 50, "Expected a forwarded bound to reach the same method");
    Assert(Both<Square>(square, 3) == 40, "Expected each bound to contribute its own operation");

    var segment = Segment { length: 9 };
    Assert(Total<Segment>(segment) == 9, "Expected a structurally conforming type to satisfy the bound");
    Assert(Doubled<Segment>(segment) == 18, "Expected the second instantiation to call its own method");

    var cell = Cell<Square> { item: square };
    Assert(cell.Inside() == 25, "Expected a generic extend block to call the bound of the type it extends");

    Assert(Tagged<int>(1) == 11, "Expected an interface requiring nothing to accept any type argument");

    // `Self` resolves to the type argument at each instantiation, so the operand
    // and the result are that type rather than the interface.
    let low = Card { value: 3 };
    let alsoLow = Card { value: 3 };
    let high = Card { value: 9 };
    Assert(Matches<Card>(@low, @alsoLow), "Self-typed operand compares equal");
    Assert(!Matches<Card>(@low, @high), "Self-typed operand compares unequal");
    Assert(Best<Card>(@low, @high) == 9, "Self-typed result keeps the type argument");
    Assert(Best<Card>(@high, @low) == 9, "Self-typed result is order independent");

    return 0;
}
