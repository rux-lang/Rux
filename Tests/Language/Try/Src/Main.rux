import Core::Assert;

// `?` on an optional leaves through the enclosing optional, and `try` passes an error to the caller.

func ParseVal(x: int) -> int? {
    if x > 0 {
        return x * 2;
    }
    return none;
}

func ComputeOption(x: int) -> int? {
    let v = ParseVal(x)?;
    return v + 10;
}

func ParseResult(x: int) -> int throws int {
    if x > 0 {
        return x * 2;
    }
    throw -1;
}

func ComputeResult(x: int) -> int throws int {
    let v = try ParseResult(x);
    return v + 10;
}

func Main() -> int {
    let resSome = ComputeOption(5);
    Assert(match resSome { .Some(v) => v == 20, none => false }, "ComputeOption(5) should be present with 20");

    let resNone = ComputeOption(-1);
    Assert(!(resNone is int), "ComputeOption(-1) should be absent");

    let resSuccess = try ComputeResult(5) catch { _ => 0 };
    Assert(resSuccess == 20, "ComputeResult(5) should succeed with 20");

    let resError = try ComputeResult(-1) catch { e => e };
    Assert(resError == -1, "ComputeResult(-1) should fail with -1");

    return 0;
}
