import Core::Assert;

// `?` on an optional and on a fallible, each leaving through the enclosing function's own form.

func ParseVal(x: int) -> int? {
    if x > 0 {
        return x * 2;
    }
    return none;
}

func ComputeOption(x: int) -> int? {
    let v = ParseVal(x)?;
    return v + 10;
}

func ParseResult(x: int) -> int ! int {
    if x > 0 {
        return x * 2;
    }
    fail -1;
}

func ComputeResult(x: int) -> int ! int {
    let v = ParseResult(x)?;
    return .Success(v + 10);
}

func Main() -> int {
    let resSome = ComputeOption(5);
    Assert(match resSome { v? => v == 20, none => false }, "ComputeOption(5) should be present with 20");

    let resNone = ComputeOption(-1);
    Assert(!(resNone is int), "ComputeOption(-1) should be absent");

    let resSuccess = ComputeResult(5);
    Assert(match resSuccess { .Success(v) => v == 20, .Failure(_) => false }, "ComputeResult(5) should succeed with 20");

    let resError = ComputeResult(-1);
    Assert(match resError { .Success(_) => false, .Failure(e) => e == -1 }, "ComputeResult(-1) should fail with -1");

    return 0;
}
