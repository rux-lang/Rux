import Core::Assert;

// An Option-shaped variant of the test's own, which the legacy protocol recognizes by its cases.
variant Option<T> {
    Some(T),
    None
}

// A Result-shaped variant of the test's own, which the legacy protocol recognizes by its cases.
variant Result<T, E> {
    Success(T),
    Error(E)
}

func ParseVal(x: int) -> Option<int> {
    if x > 0 {
        return Option::Some<int>(x * 2);
    }
    return Option::None<int>();
}

func ComputeOption(x: int) -> Option<int> {
    let v = ParseVal(x)?;
    return Option::Some<int>(v + 10);
}

func ParseResult(x: int) -> Result<int, int> {
    if x > 0 {
        return Result::Success<int, int>(x * 2);
    }
    return Result::Error<int, int>(-1);
}

func ComputeResult(x: int) -> Result<int, int> {
    let v = ParseResult(x)?;
    return Result::Success<int, int>(v + 10);
}

func Main() -> int {
    let resSome = ComputeOption(5);
    Assert(match resSome { .Some(v) => v == 20, .None => false }, "ComputeOption(5) should be Some(20)");

    let resNone = ComputeOption(-1);
    Assert(match resNone { .Some(_) => false, .None => true }, "ComputeOption(-1) should be None");

    let resSuccess = ComputeResult(5);
    Assert(match resSuccess { .Success(v) => v == 20, .Error(_) => false },
           "ComputeResult(5) should be Success(20)");

    let resError = ComputeResult(-1);
    Assert(match resError { .Success(_) => false, .Error(e) => e == -1 }, "ComputeResult(-1) should be Error(-1)");

    return 0;
}
