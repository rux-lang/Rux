import Allocator::{ Allocator, SystemAllocator };
import Core::Assert;
import Format::Format;
import Text::{ StringView, TextError };

// A format call reached the way a program reaches one: literal text, two placeholders, two values of different
// types, and the result checked as text rather than byte by byte.

func Main() -> int {
    var system = SystemAllocator::New();
    let allocator: Allocator = system;
    var error = TextError::None;

    let rendered = Format(allocator, "Integer: {}, Float: {}", @error, 255, 3.141592653589793);
    Assert(error == TextError::None, "the format call succeeds");

    let expected = StringView::FromValidated("Integer: 255, Float: 3.14159265358979");
    let renderedView = rendered.View();
    Assert(renderedView.Equals(expected), "and fills both placeholders in order");

    return 0;
}
