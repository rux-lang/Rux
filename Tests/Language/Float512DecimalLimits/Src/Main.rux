import Core::{ Assert, float512 };

const Maximum: float512 = 2065063539835887924399119494581650169527436049302967034784166417680004155333565293605750967753552715142786823706457493482454929376754635907792000880558e1262461f512;
const Minimum: float512 = 1936986403971803627488623572428543460963250743569242152976820404263225780984727937030763605544545579208354072281172669513916893467785427815424510311479e-1262761f512;

func Main() -> int {
    Assert(Maximum == float512::Max, "extreme decimal rounds to maximum");
    Assert(Minimum == float512::MinPositive, "extreme decimal rounds to minimum normal");
    Assert(-Minimum == -float512::MinPositive, "negative extreme keeps its sign");
    return 0;
}
