// A native optional: a present value or absence, asked about, recovered from, and matched.

import Core::Assert;

func Main() -> int {
    let optSome: int? = .Some(42);
    let optNone: int? = none;

    Assert(optSome is int, "optSome should be present");
    Assert(!(optNone is int), "optNone should be absent");

    Assert((optSome ?? 0) == 42, "?? should return 42");
    Assert((optNone ?? 100) == 100, "?? should return fallback 100");

    let val = match optSome {
        v? => v,
        none => 0
    };
    Assert(val == 42, "match on optSome should be 42");

    let noneVal = match optNone {
        .Some(v) => v,
        none => 999
    };
    Assert(noneVal == 999, "match on optNone should be 999");

    return 0;
}
