interface SliceValue { func Hash() -> int; }
interface TextConsumer { func Read(text: char8[..]) -> int; }
struct Consumer {}
func TextHash(text: char8[..]) -> int {
    var result = text.length as int;
    for unit in text { result += unit as int; }
    return result;
}
extend char8[..] : SliceValue {
    // Safety: `data` and `length` are the receiver slice's own address and length.
    func Hash(&self) -> int { return TextHash(unsafe { self.data[..self.length] }); }
}
extend int[..] : SliceValue {
    func Hash(&self) -> int {
        var result = self.length as int;
        for value in self { result += value; }
        return result;
    }
}
extend Consumer : TextConsumer {
    func Read(&self, text: char8[..]) -> int { return TextHash(text); }
}
func ThroughInterface(value: SliceValue) -> int { return value.Hash(); }
func ThroughBorrow(value: &SliceValue) -> int { return value.Hash(); }
func ThroughVariadic(values: SliceValue...) -> int {
    var result = 0;
    for value in values { result += value.Hash(); }
    return result;
}
func Pair(left: char8[..], right: char8[..]) -> int { return TextHash(left) * 1000 + TextHash(right); }
func Select(flag: bool) -> char8[..] { return if flag { "alpha" } else { "B" }; }
func Echo<T>(value: T) -> T { return value; }
func Condition(calls: *var int, result: bool) -> bool {
    // Safety: every caller passes `@calls`, a live local of `Main`.
    unsafe { *calls += 1; }
    return result;
}
func Selected(visits: *var int, digit: int, value: char8[..]) -> char8[..] {
    // Safety: every caller passes `@visits`, a live local of `Main`.
    unsafe { *visits = *visits * 10 + digit; }
    return value;
}
func Same(left: char8[..], right: char8[..]) -> bool {
    if left.length != right.length { return false; }
    var index = 0u;
    while index < left.length {
        if left[index] != right[index] { return false; }
        index += 1u;
    }
    return true;
}
func Check(flag: bool) -> int {
    let bound = if flag { "alpha" } else { "B" };
    let expected = TextHash(bound);
    if TextHash(if flag { "alpha" } else { "B" }) != expected { return 1; }
    if ThroughInterface(if flag { "alpha" } else { "B" }) != expected { return 2; }
    if ThroughBorrow(bound) != expected { return 3; }
    if ThroughInterface("alpha") != TextHash("alpha") { return 4; }
    if ThroughInterface(if flag { "" } else { "B" }) != TextHash(if flag { "" } else { "B" }) { return 5; }
    if ThroughInterface(if flag { "alpha" } else { "" }) != TextHash(if flag { "alpha" } else { "" }) { return 6; }
    if !Same(Select(flag), bound) || !Same(Echo(if flag { "alpha" } else { "B" }), bound) { return 7; }
    if ThroughInterface(Select(flag)) != expected { return 8; }
    if ThroughVariadic(if flag {
        "alpha"
    } else {
        "B"
    }, if flag { "alpha" } else { "B" }, "", bound) != expected * 3 { return 9; }
    let reverse = if flag { "B" } else { "alpha" };
    if Pair(if flag { "alpha" } else { "B" }, if flag {
        "B"
    } else {
        "alpha"
    }) != expected * 1000 + TextHash(reverse) { return 10; }
    let consumer: TextConsumer = Consumer {};
    if consumer.Read(if flag { "alpha" } else { "B" }) != expected { return 11; }
    let nested = if flag { if flag { "alpha" } else { "wrong" } } else if flag { "wrong" } else { "B" };
    if ThroughInterface(if flag {
        if flag { "alpha" } else { "wrong" }
    } else if flag {
        "wrong"
    } else {
        "B"
    }) != TextHash(nested) { return 12; }

    var calls = 0;
    var visits = 0;
    let chosen = ThroughInterface(if Condition(@calls, flag) {
        Selected(@visits, 1, "alpha")
    } else {
        Selected(@visits, 2, "B")
    });
    if chosen != expected || calls != 1 || visits != (if flag { 1 } else { 2 }) { return 13; }
    calls = 0;
    visits = 0;
    let repeated = ThroughVariadic(
        if Condition(@calls, flag) { Selected(@visits, 1, "alpha") } else { Selected(@visits, 2, "B") },
        if Condition(@calls, !flag) { Selected(@visits, 3, "B") } else { Selected(@visits, 4, "alpha") });
    if repeated != expected * 2 || calls != 2 || visits != (if flag { 14 } else { 23 }) { return 14; }

    var first: int[3] = [11, 17, 23];
    var second: int[2] = [31, 37];
    // Safety: `first` is a live local array of three elements.
    let firstView: int[..] = unsafe { (@first[0])[..3] };
    // Safety: `second` is a live local array of two elements.
    let secondView: int[..] = unsafe { (@second[0])[..2] };
    if ThroughInterface(firstView) != 54 || ThroughInterface(secondView) != 70 { return 19; }
    if ThroughInterface(if flag { firstView } else { secondView }) != (if flag { 54 } else { 70 }) { return 15; }
    if ThroughInterface(if flag {
        firstView[1..3]
    } else {
        secondView[0..1]
    }) != (if flag { 42 } else { 32 }) { return 16; }
    let empty = firstView[0..0];
    if ThroughVariadic(if flag { firstView } else { empty }, if flag { empty } else { secondView }) != (if flag {
        54
    } else {
        70
    }) { return 17; }
    first[2] = 29;
    if ThroughInterface(if flag { firstView } else { secondView }) != (if flag { 60 } else { 70 }) { return 18; }
    return 0;
}
func Main() -> int {
    var iteration = 0;
    while iteration < 64 {
        let result = Check(iteration % 2 == 0);
        if result != 0 { return result; }
        iteration += 1;
    }
    return 0;
}
