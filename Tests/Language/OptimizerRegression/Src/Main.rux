import Core::{ Assert, #target, Architecture, OperatingSystem };
import OptimizerRegression::Support::CrossModule;

interface ValueSource {
    func Value() -> int;
}

struct StoredValue {
    value: int;
}

extend StoredValue : ValueSource {
    func Value(self: &StoredValue) -> int {
        return self.value;
    }
}

func Increment(value: int) -> int {
    return value + 1;
}

func Apply(operation: func(int) -> int, value: int) -> int {
    return operation(value);
}

func Observe(counter: *var int) -> int {
    *counter += 1;
    return 7;
}

func UnusedPrivateCode(value: int) -> int {
    return value * 101;
}

func LoopRegisterValues(limit: int, seed: int) -> int {
    var total = seed;
    var first = 3;
    var second = 5;
    var floating = 1.0;
    for i in 0..limit {
        let old = first;
        first = second;
        second = old;
        for j in 0..3 {
            total += Apply(Increment, first + second + j);
            floating += 0.5;
        }
        if i == 4 { continue; }
        total += seed;
    }
    Assert(floating == 16.0, "floating values survive nested back edges and calls");
    Assert(first == 3 && second == 5, "simultaneous loop-carried values survive calls");
    return total;
}

func Rotate64(value: uint64) -> uint64 {
    return (value >> 19) | (value << 45);
}

func Rotate32(value: uint32) -> uint32 {
    return (value << 7) | (value >> 25);
}

func DynamicDivide(value: uint64, divisor: uint64) -> uint64 {
    return value / divisor;
}

func DynamicRemainder(value: uint64, divisor: uint64) -> uint64 {
    return value % divisor;
}

func VerifyWordOperations(limit: uint64) {
    for bit in 0u64..64u64 {
        let value = 1u64 << bit;
        let expected = bit < 19 ? 1u64 << (bit + 45) : 1u64 << (bit - 19);
        Assert(Rotate64(value) == expected, "uint64 rotation preserves every bit");
    }
    for bit in 0u32..32u32 {
        let value = 1u32 << bit;
        let expected = bit < 25 ? 1u32 << (bit + 7) : 1u32 << (bit - 25);
        Assert(Rotate32(value) == expected, "uint32 rotation wraps at bit 32");
    }
    var state = 0x8000000000000000u64;
    for i in 0u64..limit {
        state = state * 6364136223846793005u64 + i + 1;
        Assert(state / 8 == DynamicDivide(state, 8), "unsigned division matches hardware division");
        Assert(state % 16 == DynamicRemainder(state, 16), "unsigned remainder matches hardware division");
    }
}

func Main() -> int {
    Assert(CheckFloatPreservation() == 1, "Win64 preserves all 128 bits of every allocated XMM register");
    VerifyFloatRegisters(25);
    let outer = 1;
    if true {
        let inner = 2;
        Assert(inner == 2, "inner lexical scope");
    }
    Assert(outer == 1, "outer lexical scope");

    var observations = 0;
    let ignored = Observe(@observations);
    Assert(observations == 1 && ignored == 7, "observable call is preserved");

    let maximum: int8 = 127i8;
    let wrapped: int8 = maximum + 1i8;
    Assert(wrapped == -128i8, "signed overflow wraps at its declared width");

    let operation: func(int) -> int = Increment;
    Assert(Apply(operation, 40) == 41, "indirect call remains reachable");

    let stored = StoredValue { value: 42 };
    let source: ValueSource = stored;
    Assert(source.Value() == 42, "interface vtable dispatch remains reachable");
    Assert(CrossModule(41) == 42, "cross-module private dependency remains reachable");
    Assert(LoopRegisterValues(10, 7) == 370, "nested loop values and indirect calls");
    VerifyWordOperations(5000);
    return 0;
}

func ManyFloats(a: float64, b: float64, c: float64, d: float64, e: float64,
                f: float64, g: float64, h: float64, i: float64, j: float64) -> float64 {
    var total = a + b + c + d + e + f + g + h + i + j;
    for index in 0..2 { total += index as float64; }
    return total;
}

func VerifyFloatRegisters(limit: int) {
    var first = 1.25;
    var second = 2.5;
    var sum = 0.0;
    var single: float32 = 0.25f32;
    for index in 0..limit {
        let old = first;
        first = second;
        second = old;
        let result = ManyFloats(first, second, 3.0, 4.0, 5.0, 6.0, 7.0, 8.0, 9.0, 10.0);
        Assert(result == 56.75, "floating arguments survive register and stack placement");
        sum += first + second;
        single += 0.5f32;
        Assert((result % 4.0) == 0.75, "x87 remainder reads and writes allocated scalar floats");
        Assert((single % 1.0f32) == 0.75f32 || (single % 1.0f32) == 0.25f32,
               "float32 remainder preserves register values");
    }
    Assert(sum == 93.75 && single == 12.75f32, "floating recurrences survive calls and phi copies");
    Assert(first == 2.5 && second == 1.25, "floating phi copies preserve simultaneous values");
}

when #target.os == OperatingSystem::Windows && #target.arch == Architecture::X86_64 {
    // The generated callee uses all eight allocated XMM registers. Check both halves of each nonvolatile register.
    asm func CheckFloatPreservation() -> int {
        sub rsp, 360
        movups [rsp + 80], xmm8
        movups [rsp + 96], xmm9
        movups [rsp + 112], xmm10
        movups [rsp + 128], xmm11
        movups [rsp + 144], xmm12
        movups [rsp + 160], xmm13
        movups [rsp + 176], xmm14
        movups [rsp + 192], xmm15
        mov rax, 0x0123456789abcdef
        mov [rsp + 208], rax
        mov rax, 0xfedcba9876543210
        mov [rsp + 216], rax
        movups xmm8, [rsp + 208]
        movups xmm9, [rsp + 208]
        movups xmm10, [rsp + 208]
        movups xmm11, [rsp + 208]
        movups xmm12, [rsp + 208]
        movups xmm13, [rsp + 208]
        movups xmm14, [rsp + 208]
        movups xmm15, [rsp + 208]
        xorps xmm0, xmm0
        xorps xmm1, xmm1
        xorps xmm2, xmm2
        xorps xmm3, xmm3
        mov qword [rsp + 32], 0
        mov qword [rsp + 40], 0
        mov qword [rsp + 48], 0
        mov qword [rsp + 56], 0
        mov qword [rsp + 64], 0
        mov qword [rsp + 72], 0
        call ManyFloats
        movups [rsp + 224], xmm8
        movups [rsp + 240], xmm9
        movups [rsp + 256], xmm10
        movups [rsp + 272], xmm11
        movups [rsp + 288], xmm12
        movups [rsp + 304], xmm13
        movups [rsp + 320], xmm14
        movups [rsp + 336], xmm15
        movups xmm8, [rsp + 80]
        movups xmm9, [rsp + 96]
        movups xmm10, [rsp + 112]
        movups xmm11, [rsp + 128]
        movups xmm12, [rsp + 144]
        movups xmm13, [rsp + 160]
        movups xmm14, [rsp + 176]
        movups xmm15, [rsp + 192]
        mov r10, 0x0123456789abcdef
        mov r11, 0xfedcba9876543210
        mov rax, [rsp + 224]
        cmp rax, r10
        jne preserve_failed
        mov rax, [rsp + 232]
        cmp rax, r11
        jne preserve_failed
        mov rax, [rsp + 240]
        cmp rax, r10
        jne preserve_failed
        mov rax, [rsp + 248]
        cmp rax, r11
        jne preserve_failed
        mov rax, [rsp + 256]
        cmp rax, r10
        jne preserve_failed
        mov rax, [rsp + 264]
        cmp rax, r11
        jne preserve_failed
        mov rax, [rsp + 272]
        cmp rax, r10
        jne preserve_failed
        mov rax, [rsp + 280]
        cmp rax, r11
        jne preserve_failed
        mov rax, [rsp + 288]
        cmp rax, r10
        jne preserve_failed
        mov rax, [rsp + 296]
        cmp rax, r11
        jne preserve_failed
        mov rax, [rsp + 304]
        cmp rax, r10
        jne preserve_failed
        mov rax, [rsp + 312]
        cmp rax, r11
        jne preserve_failed
        mov rax, [rsp + 320]
        cmp rax, r10
        jne preserve_failed
        mov rax, [rsp + 328]
        cmp rax, r11
        jne preserve_failed
        mov rax, [rsp + 336]
        cmp rax, r10
        jne preserve_failed
        mov rax, [rsp + 344]
        cmp rax, r11
        jne preserve_failed
        mov eax, 1
        add rsp, 360
        ret
    preserve_failed:
        xor eax, eax
        add rsp, 360
        ret
    }
} else {
    func CheckFloatPreservation() -> int { return 1; }
}
