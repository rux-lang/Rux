import Allocator::{ Allocator, SystemAllocator };
import Core::{ Assert, Panic };
import Text::{ Concat, String, StringView };

// Joining two owned strings through the package: the join borrows views of both, copies once into a fresh block,
// and both inputs stay whole and are destroyed exactly once when the function ends.

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    let first = String::FromBytes(allocator, "One") catch { else => Panic("the first string is built") };
    let second = String::FromBytes(allocator, "Two") catch { else => Panic("and the second") };

    let opening = Concat(allocator, first.View(), StringView::FromValidated(" join "))
        catch { else => Panic("the first join is made") };
    let joined = Concat(allocator, opening.View(), second.View()) catch { else => Panic("and the second") };

    let expected = StringView::FromValidated("One join Two");
    let joinedView = joined.View();
    Assert(joinedView.Equals(expected), "the joined text reads left to right");
    Assert(first.Length() == 3 && second.Length() == 3, "and both inputs are untouched");

    return 0;
}
