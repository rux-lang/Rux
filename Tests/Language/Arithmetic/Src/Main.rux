func Take(value: uint) -> uint {
    return value;
}

func Main() -> int {
    let value = 1 + 2 * (3 + 4) - 10 / 2;
    if value != 10 {
        return 1;
    }

    // An unsuffixed literal carries the default `int`, and takes the other
    // operand's type whichever side it is written on, so `2 * count` and
    // `count * 2` are both a `uint`.
    let count: uint = 5;
    let doubledLeft: uint = 2 * count;
    let doubledRight: uint = count * 2;
    if doubledLeft != 10 || doubledRight != 10 {
        return 2;
    }

    // Every arithmetic operator, with the literal on the left.
    if 8 - count != 3 {
        return 3;
    }
    if 7 + count != 12 {
        return 4;
    }
    if 20 / count != 4 {
        return 5;
    }
    if 7 % count != 2 {
        return 6;
    }

    // The result is usable where a uint is required, not merely assignable to
    // one, which is where this first showed up.
    if Take(2 * count) != 10 {
        return 7;
    }

    // Other widths behave the same way.
    let wide: uint64 = 5u64;
    if 2 * wide != 10u64 {
        return 8;
    }
    let narrow: int32 = 5i32;
    if 2 * narrow != 10i32 {
        return 9;
    }

    // Two literals still settle on int, and a typed int operand is untouched.
    let both = 2 * 3;
    let plain: int = 4;
    let scaled: int = 2 * plain;
    if both != 6 || scaled != 8 {
        return 10;
    }

    // Operands of one signedness and different widths widen to the wider
    // type, as an assignment would, so neither order wraps the narrow one.
    let small: int32 = 1;
    let big: int64 = 5000000000;
    let sum: int64 = small + big;
    let mirrored: int64 = big + small;
    if sum != 5000000001 || mirrored != 5000000001 {
        return 12;
    }
    var running: int64 = 0;
    running += small;
    running = running * big;
    if running != 5000000000 || !(small < big) || small == big {
        return 13;
    }
    let byte: uint8 = 200;
    let word: uint32 = 100000;
    let masked: uint32 = byte | word;
    let added: uint32 = byte + word;
    if masked != 100072 || added != 100200 {
        return 14;
    }
    let tiny: int8 = -100;
    let huge: int128 = 170141183460469231731687303715884105727;
    if tiny + huge != 170141183460469231731687303715884105627 {
        return 15;
    }

    // Adjacent stars have no exponent meaning. They are the same ordinary
    // multiplication and dereference tokens as the spaced spelling.
    let pointed = 3;
    let pointer = @pointed;
    if 2 ** pointer != 6 || 2 * *pointer != 6 {
        return 11;
    }

    return 0;
}
