func SignedRemainder64_M3(n: int64) -> int64 { return n % (-3i64); }
func SignedQuotient64_M7(n: int64) -> int64 { return n / (-7i64); }
func SignedRemainder64_M7(n: int64) -> int64 { return n % (-7i64); }
func SignedQuotient64_MA(n: int64) -> int64 { return n / (-10i64); }
func SignedRemainder64_MA(n: int64) -> int64 { return n % (-10i64); }
func SignedQuotient64_M8(n: int64) -> int64 { return n / (-8i64); }
func SignedRemainder64_M8(n: int64) -> int64 { return n % (-8i64); }
func SignedQuotient64_M3B9ACA07(n: int64) -> int64 { return n / (-1000000007i64); }
func SignedRemainder64_M3B9ACA07(n: int64) -> int64 { return n % (-1000000007i64); }
func SignedQuotient64_M7FFFFFFFFFFFFFFF(n: int64) -> int64 { return n / (-9223372036854775807i64); }
func SignedRemainder64_M7FFFFFFFFFFFFFFF(n: int64) -> int64 { return n % (-9223372036854775807i64); }
func SignedQuotient64_M10000000000(n: int64) -> int64 { return n / (-1099511627776i64); }
func SignedRemainder64_M10000000000(n: int64) -> int64 { return n % (-1099511627776i64); }
func SignedQuotient32_3(n: int32) -> int32 { return n / (3i32); }
func SignedRemainder32_3(n: int32) -> int32 { return n % (3i32); }
func SignedQuotient32_7(n: int32) -> int32 { return n / (7i32); }
func SignedRemainder32_7(n: int32) -> int32 { return n % (7i32); }
func SignedQuotient32_A(n: int32) -> int32 { return n / (10i32); }
func SignedRemainder32_A(n: int32) -> int32 { return n % (10i32); }
