func SignedRemainder64_2(n: int64) -> int64 { return n % (2i64); }
func SignedQuotient64_3(n: int64) -> int64 { return n / (3i64); }
func SignedRemainder64_3(n: int64) -> int64 { return n % (3i64); }
func SignedQuotient64_5(n: int64) -> int64 { return n / (5i64); }
func SignedRemainder64_5(n: int64) -> int64 { return n % (5i64); }
func SignedQuotient64_7(n: int64) -> int64 { return n / (7i64); }
func SignedRemainder64_7(n: int64) -> int64 { return n % (7i64); }
func SignedQuotient64_A(n: int64) -> int64 { return n / (10i64); }
func SignedRemainder64_A(n: int64) -> int64 { return n % (10i64); }
func SignedQuotient64_281(n: int64) -> int64 { return n / (641i64); }
func SignedRemainder64_281(n: int64) -> int64 { return n % (641i64); }
func SignedQuotient64_3B9ACA07(n: int64) -> int64 { return n / (1000000007i64); }
func SignedRemainder64_3B9ACA07(n: int64) -> int64 { return n % (1000000007i64); }
func SignedQuotient64_7FFFFFFFFFFFFFFF(n: int64) -> int64 { return n / (9223372036854775807i64); }
func SignedRemainder64_7FFFFFFFFFFFFFFF(n: int64) -> int64 { return n % (9223372036854775807i64); }
func SignedQuotient64_10000000000(n: int64) -> int64 { return n / (1099511627776i64); }
func SignedRemainder64_10000000000(n: int64) -> int64 { return n % (1099511627776i64); }
