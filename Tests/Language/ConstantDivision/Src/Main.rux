    Assert(SignedRemainder64_281(n) == n % SignedDivisor64, "a signed 64-bit remainder by 641 matches division");
    SignedDivisor64 = (1000000007i64);
    Assert(SignedQuotient64_3B9ACA07(n) == n / SignedDivisor64, "a signed 64-bit quotient by 1000000007 matches division");
    Assert(SignedRemainder64_3B9ACA07(n) == n % SignedDivisor64, "a signed 64-bit remainder by 1000000007 matches division");
    SignedDivisor64 = (9223372036854775807i64);
    Assert(SignedQuotient64_7FFFFFFFFFFFFFFF(n) == n / SignedDivisor64, "a signed 64-bit quotient by 9223372036854775807 matches division");
    Assert(SignedRemainder64_7FFFFFFFFFFFFFFF(n) == n % SignedDivisor64, "a signed 64-bit remainder by 9223372036854775807 matches division");
    SignedDivisor64 = (1099511627776i64);
    Assert(SignedQuotient64_10000000000(n) == n / SignedDivisor64, "a signed 64-bit quotient by 1099511627776 matches division");
    Assert(SignedRemainder64_10000000000(n) == n % SignedDivisor64, "a signed 64-bit remainder by 1099511627776 matches division");
    SignedDivisor64 = (1i64);
    Assert(SignedQuotient64_1(n) == n / SignedDivisor64, "a signed 64-bit quotient by 1 matches division");
    Assert(SignedRemainder64_1(n) == n % SignedDivisor64, "a signed 64-bit remainder by 1 matches division");
    SignedDivisor64 = (-2i64);
    Assert(SignedQuotient64_M2(n) == n / SignedDivisor64, "a signed 64-bit quotient by -2 matches division");
    Assert(SignedRemainder64_M2(n) == n % SignedDivisor64, "a signed 64-bit remainder by -2 matches division");
    SignedDivisor64 = (-3i64);
    Assert(SignedQuotient64_M3(n) == n / SignedDivisor64, "a signed 64-bit quotient by -3 matches division");
    Assert(SignedRemainder64_M3(n) == n % SignedDivisor64, "a signed 64-bit remainder by -3 matches division");
    SignedDivisor64 = (-7i64);
    Assert(SignedQuotient64_M7(n) == n / SignedDivisor64, "a signed 64-bit quotient by -7 matches division");
    Assert(SignedRemainder64_M7(n) == n % SignedDivisor64, "a signed 64-bit remainder by -7 matches division");
    SignedDivisor64 = (-10i64);
    Assert(SignedQuotient64_MA(n) == n / SignedDivisor64, "a signed 64-bit quotient by -10 matches division");
    Assert(SignedRemainder64_MA(n) == n % SignedDivisor64, "a signed 64-bit remainder by -10 matches division");
    SignedDivisor64 = (-8i64);
