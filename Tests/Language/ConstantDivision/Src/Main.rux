func CheckSigned64(n: int64) {
    SignedDivisor64 = (2i64);
    Assert(SignedQuotient64_2(n) == n / SignedDivisor64, "a signed 64-bit quotient by 2 matches division");
    Assert(SignedRemainder64_2(n) == n % SignedDivisor64, "a signed 64-bit remainder by 2 matches division");
    SignedDivisor64 = (3i64);
    Assert(SignedQuotient64_3(n) == n / SignedDivisor64, "a signed 64-bit quotient by 3 matches division");
    Assert(SignedRemainder64_3(n) == n % SignedDivisor64, "a signed 64-bit remainder by 3 matches division");
    SignedDivisor64 = (5i64);
