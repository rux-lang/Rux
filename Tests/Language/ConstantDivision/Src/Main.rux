    Assert(SignedRemainder64_M8(n) == n % SignedDivisor64, "a signed 64-bit remainder by -8 matches division");
    SignedDivisor64 = (-1000000007i64);
    Assert(SignedQuotient64_M3B9ACA07(n) == n / SignedDivisor64, "a signed 64-bit quotient by -1000000007 matches division");
    Assert(SignedRemainder64_M3B9ACA07(n) == n % SignedDivisor64, "a signed 64-bit remainder by -1000000007 matches division");
    SignedDivisor64 = (-9223372036854775807i64);
