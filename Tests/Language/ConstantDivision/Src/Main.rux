func CheckSigned32(n: int32) {
    SignedDivisor32 = (3i32);
    Assert(SignedQuotient32_3(n) == n / SignedDivisor32, "a signed 32-bit quotient by 3 matches division");
    Assert(SignedRemainder32_3(n) == n % SignedDivisor32, "a signed 32-bit remainder by 3 matches division");
    SignedDivisor32 = (7i32);
    Assert(SignedQuotient32_7(n) == n / SignedDivisor32, "a signed 32-bit quotient by 7 matches division");
    Assert(SignedRemainder32_7(n) == n % SignedDivisor32, "a signed 32-bit remainder by 7 matches division");
    SignedDivisor32 = (10i32);
    Assert(SignedQuotient32_A(n) == n / SignedDivisor32, "a signed 32-bit quotient by 10 matches division");
    Assert(SignedRemainder32_A(n) == n % SignedDivisor32, "a signed 32-bit remainder by 10 matches division");
    SignedDivisor32 = (16i32);
    Assert(SignedQuotient32_10(n) == n / SignedDivisor32, "a signed 32-bit quotient by 16 matches division");
    Assert(SignedRemainder32_10(n) == n % SignedDivisor32, "a signed 32-bit remainder by 16 matches division");
    SignedDivisor32 = (2147483647i32);
    Assert(SignedQuotient32_7FFFFFFF(n) == n / SignedDivisor32, "a signed 32-bit quotient by 2147483647 matches division");
    Assert(SignedRemainder32_7FFFFFFF(n) == n % SignedDivisor32, "a signed 32-bit remainder by 2147483647 matches division");
    SignedDivisor32 = (-3i32);
    Assert(SignedQuotient32_M3(n) == n / SignedDivisor32, "a signed 32-bit quotient by -3 matches division");
    Assert(SignedRemainder32_M3(n) == n % SignedDivisor32, "a signed 32-bit remainder by -3 matches division");
    SignedDivisor32 = (-16i32);
    Assert(SignedQuotient32_M10(n) == n / SignedDivisor32, "a signed 32-bit quotient by -16 matches division");
    Assert(SignedRemainder32_M10(n) == n % SignedDivisor32, "a signed 32-bit remainder by -16 matches division");
    SignedDivisor32 = (-2147483647i32);
    Assert(SignedQuotient32_M7FFFFFFF(n) == n / SignedDivisor32, "a signed 32-bit quotient by -2147483647 matches division");
    Assert(SignedRemainder32_M7FFFFFFF(n) == n % SignedDivisor32, "a signed 32-bit remainder by -2147483647 matches division");
}

func CheckSigned8(n: int8) {
    SignedDivisor8 = (3i8);
    Assert(SignedQuotient8_3(n) == n / SignedDivisor8, "a signed 8-bit quotient by 3 matches division");
    Assert(SignedRemainder8_3(n) == n % SignedDivisor8, "a signed 8-bit remainder by 3 matches division");
    SignedDivisor8 = (7i8);
    Assert(SignedQuotient8_7(n) == n / SignedDivisor8, "a signed 8-bit quotient by 7 matches division");
    Assert(SignedRemainder8_7(n) == n % SignedDivisor8, "a signed 8-bit remainder by 7 matches division");
    SignedDivisor8 = (127i8);
    Assert(SignedQuotient8_7F(n) == n / SignedDivisor8, "a signed 8-bit quotient by 127 matches division");
    Assert(SignedRemainder8_7F(n) == n % SignedDivisor8, "a signed 8-bit remainder by 127 matches division");
    SignedDivisor8 = (-3i8);
    Assert(SignedQuotient8_M3(n) == n / SignedDivisor8, "a signed 8-bit quotient by -3 matches division");
    Assert(SignedRemainder8_M3(n) == n % SignedDivisor8, "a signed 8-bit remainder by -3 matches division");
    SignedDivisor8 = (-128i8);
    Assert(SignedQuotient8_M80(n) == n / SignedDivisor8, "a signed 8-bit quotient by -128 matches division");
    Assert(SignedRemainder8_M80(n) == n % SignedDivisor8, "a signed 8-bit remainder by -128 matches division");
}

func Main() -> int {
    var state: uint64 = 7u64;
    for i in 0u64..4096u64 {
        let n = Next(state);
        Check64(n);
        Check64(n >> (i % 64u64));
        Check64(i);
        Check64(0u64 - 1u64 - i);
        Check32(n as uint32);
        Check32((n >> (i % 32u64)) as uint32);
        Check32(0xFFFFFFFFu32 - (i as uint32));
        CheckSigned64(n as int64);
        CheckSigned64((n as int64) >> ((i % 64u64) as int64));
        CheckSigned64(i as int64);
        CheckSigned64(0i64 - (i as int64));
        CheckSigned64((0x8000000000000000u64 + i) as int64);
        CheckSigned64((0x7FFFFFFFFFFFFFFFu64 - i) as int64);
        CheckSigned32(n as uint32 as int32);
        CheckSigned32((0x80000000u32 + (i as uint32)) as int32);
    }
    for d in [3u64, 7u64, 641u64, 1000000007u64, 0xFFFFFFFFu64, 0x8000000000000001u64] {
        for k in 0u64..64u64 {
            let multiple = d * (k + 1u64);
            Check64(multiple);
            Check64(multiple - 1u64);
            Check64(multiple + 1u64);
            CheckSigned64(multiple as int64);
            CheckSigned64(0i64 - (multiple as int64));
            CheckSigned64(1i64 - (multiple as int64));
        }
    }
    for n in 0u..256u {
        Check8(n as uint8);
        CheckSigned8(n as uint8 as int8);
    }
    return 0;
}
