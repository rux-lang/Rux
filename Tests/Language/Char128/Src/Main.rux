// char128: one Unicode scalar value in 16 bytes, two machine words wide.
// The narrowest wide character: the first width no general-purpose register holds, so it is the one where a scalar
// value is passed and stored as a pair of words. What it holds is decided by Unicode, not by the width, so every value
// sits in the low word and every word above it is zero. The cases below are the ones that would notice a word left
// over: a narrower character widened into one, a literal folded into static data, and a value carried through fields,
// elements, arguments and returns.

import Core::Assert;
import Core::{ char128, uint128 };

const Face = c128'😀';
const Last: char128 = c128'\u{10FFFF}';
const Table: char128[4] = [c128'A', c128'λ', c128'😀', c128'\u{10FFFF}'];
const CastTable: char128[2] = [c128'a', 0x41u32 as char128];
const CastCopies: char256[3] = [0x1F600u128 as char256; 3];

func InLetterRange(value: char128) -> bool {
    return match value { c128'a'..=c128'z' => true, else => false };
}

func InWideRange(value: char512) -> bool {
    return match value { c512'A'..c512'Z' => true, else => false };
}

func Identity<T>(value: T) -> T { return value; }
func Width<T>(value: T) -> uint { return sizeof(T); }
func Echo(value: char128) -> char128 { return value; }

// Reads the whole storage, so a value whose upper word is not zero does not compare equal to its code point.
func Storage(value: char128) -> uint128 {
    let address = (@value) as *uint128;
    return *address;
}

// A runtime char32 and char64, so the widening below is not folded away while compiling.
func Narrow(value: char32) -> char32 { return value; }
func Narrow64(value: char64) -> char64 { return value; }

// A narrower scalar value widens on its way into a parameter and into a return.
func FromNarrow(value: char32) -> char128 { return value; }
func FromWide(value: char64) -> char128 { return value; }

// Enough arguments that some of them leave the registers.
func Fifth(first: char128, second: char128, third: char128, fourth: char128, fifth: char128) -> char128 {
    return fifth;
}

// Wide arguments between narrow ones keep their own values and leave their neighbours alone.
func Between(before: int32, value: char128, after: int32) -> int {
    return before as int + (value as int) + after as int;
}

func Classify(value: char128) -> int {
    return match value {
        c128'\0' => 1,
        c128'A' => 2,
        c128'λ' => 3,
        c128'\u{1F600}' => 4,
        c128'\u{10FFFF}' => 5,
        else => 9
    };
}

struct Pair {
    first: char128;
    second: char128;
}

struct Tagged {
    tag: char8;
    value: char128;
}

func Main() -> int {
    // char128 carries a Unicode scalar value, the same thing char32 carries, in four times the room. Its ceiling is
    // the last code point rather than its own last value.
    Assert(char128::Bits == 128u && char128::Bytes == 16u, "char128 is 128 bits in 16 bytes");
    Assert(sizeof(char128) == 16u, "sizeof agrees with Bytes");
    Assert(sizeof(char128) == sizeof(uint128), "it is as wide as uint128");
    Assert(char128::Min as uint128 == 0u128, "char128 starts at zero");
    Assert(char128::Max as uint128 == 0x10FFFFu128, "char128 stops at the last code point");
    Assert(Storage(char128::Max) == 0x10FFFFu128, "and its constant stores nothing above it");

    // The values a scalar-valued width holds, across the planes.
    let letter: char128 = c128'A';
    Assert(letter as uint128 == 65u128, "char128 'A' is 65");
    let lambda: char128 = c128'λ';
    Assert(lambda as uint128 == 0x3BBu128, "char128 holds literal non-ASCII source text");
    let euro: char128 = c128'\u{20AC}';
    Assert(euro as uint128 == 0x20ACu128, "char128 holds a first-plane code point");
    let face: char128 = c128'\u{1F600}';
    Assert(face as uint128 == 0x1F600u128, "char128 holds a code point above the first plane");
    Assert(c128'😀' == face, "a supplementary character in source text is the same scalar as its escape");
    let last: char128 = c128'\u{10FFFF}';
    Assert(last as uint128 == 0x10FFFFu128, "char128 holds the last code point");
    Assert(Storage(face) == 0x1F600u128 && Storage(last) == 0x10FFFFu128, "with the upper word zero");

    // Escapes decode to the same scalar values as at every other width.
    Assert(c128'\0' as uint128 == 0u128, "NUL remains a scalar value");
    Assert(c128'\n' as uint128 == 10u128 && c128'\r' as uint128 == 13u128, "line escapes decode");
    Assert(c128'\t' as uint128 == 9u128 && c128'\v' as uint128 == 11u128, "spacing escapes decode");
    Assert(c128'\a' as uint128 == 7u128 && c128'\b' as uint128 == 8u128, "control escapes decode");
    Assert(c128'\f' as uint128 == 12u128, "form feed decodes");
    Assert(c128'\\' as uint128 == 92u128 && c128'\'' as uint128 == 39u128, "quoted escapes decode");
    Assert(c128'\"' as uint128 == 34u128, "a double quote escape decodes");
    Assert(c128'\u{00000041}' == letter, "zero-padded Unicode escapes decode");

    // A scalar value widens implicitly into a wider scalar value, because every such width holds the same code
    // points and the widening cannot lose one. The words above the source are zero, not left over.
    let fromLiteral: char128 = c32'\u{1F600}';
    Assert(fromLiteral == face && Storage(fromLiteral) == 0x1F600u128, "a char32 literal widens to char128");
    let fromWideLiteral: char128 = c64'\u{10FFFF}';
    Assert(fromWideLiteral == last && Storage(fromWideLiteral) == 0x10FFFFu128, "a char64 literal widens to char128");
    let widened: char128 = Narrow('😀');
    Assert(widened == face && Storage(widened) == 0x1F600u128, "a runtime char32 widens with the upper word zero");
    let widened64: char128 = Narrow64(c64'λ');
    Assert(widened64 == lambda && Storage(widened64) == 0x3BBu128, "a runtime char64 widens with the upper word zero");
    Assert(FromNarrow('😀') == face && Storage(FromNarrow('😀')) == 0x1F600u128, "a char32 widens into a return");
    Assert(FromWide(c64'A') == letter && Storage(FromWide(c64'A')) == 65u128, "and so does a char64");
    Assert(Echo(Narrow('λ')) == lambda, "a char32 argument widens to the parameter");
    Assert(Storage(Echo(Narrow64(c64'😀'))) == 0x1F600u128, "and so does a char64 argument, upper word zero");

    // Comparison and ordering follow the code points, as at every other width.
    Assert(letter == c128'A', "char128 equality");
    Assert(letter != euro, "char128 inequality");
    Assert(letter < euro && letter <= euro, "char128 less-than follows the code point");
    Assert(face > euro && face >= euro, "char128 orders a later plane above an earlier one");
    Assert(last >= face && !(face > last), "char128 greater-than-or-equal");

    // Casting to the integer widths and back.
    Assert(face as int == 128512, "char128 casts to int");
    Assert(face as int128 == 128512i128, "char128 casts to int128");
    Assert(face as uint32 == 0x1F600u32 && face as uint64 == 0x1F600u64, "and to the narrower unsigned widths");
    Assert(0x1F600u128 as char128 == face, "uint128 casts to char128");
    Assert(0x1F600u128 as char128 as uint128 == 0x1F600u128, "and back");
    var code: int = 0x3BB;
    Assert(code as char128 == lambda && Storage(code as char128) == 0x3BBu128, "a runtime int casts to char128");
    let wideCode: uint128 = 0x10FFFFu128;
    Assert(wideCode as char128 == last, "a runtime uint128 casts to char128");

    // Narrowing to a narrower scalar value keeps the low bits rather than re-encoding, which is what every other
    // narrowing character cast does.
    Assert(face as char32 == '😀', "char128 narrows to char32 when it fits");
    Assert(face as char32 as uint32 == 0x1F600u32, "keeping the code point");
    Assert(last as char64 == c64'\u{10FFFF}', "char128 narrows to char64");
    Assert((face as char64) as char128 == face, "a round trip through char64 keeps the value");

    // Assignment and mutation.
    var cursor: char128 = c128'a';
    Assert(cursor as uint128 == 97u128, "a char128 var starts at its initializer");
    cursor = face;
    Assert(cursor == face && Storage(cursor) == 0x1F600u128, "char128 var mutation");
    cursor = Narrow('λ');
    Assert(cursor == lambda && Storage(cursor) == 0x3BBu128, "assigning a narrower value widens it");

    // Prefix recognition does not reserve ordinary identifiers.
    let c128 = 17;
    let c128Value = 19;
    Assert(c128 + c128Value == 36, "c128 remains an ordinary identifier");
    let inferred = c128'😀';
    Assert(Width(inferred) == 16u, "the literal infers char128 storage");
    Assert(Face == inferred && Last == last, "typed and inferred constants keep their width");
    Assert(Storage(Face) == 0x1F600u128, "an inferred constant stores nothing above its code point");
    Assert(Identity(c128'😀') == face, "generic inference keeps the literal type");
    Assert(Echo(c128'λ') == c128'\u{3BB}', "calls and returns preserve source Unicode");

    // Storage: fields, padding and elements.
    Assert(sizeof(Pair) == 32u, "two char128 fields occupy 32 bytes");
    Assert(sizeof(Tagged) == 32u, "a char8 beside a char128 is padded to its sixteen-byte alignment");
    Assert(alignof(Tagged) == 16u && alignof(char128) == 16u, "and the struct takes the char128 alignment");
    let pair = Pair { first: letter, second: face };
    Assert(pair.first == letter && pair.second == face, "each field keeps its own value");
    Assert(Storage(pair.second) == 0x1F600u128, "with the upper word zero");
    var tagged = Tagged { tag: c8'x', value: last };
    Assert(tagged.tag == c8'x' && tagged.value == last, "and so does a field after the padding");
    tagged.value = Narrow('A');
    Assert(tagged.tag == c8'x' && tagged.value == letter, "a field write widens and leaves its neighbour alone");
    Assert(Storage(tagged.value) == 65u128, "the stored field has its upper word zero");
    let elements = [c128'A', c128'λ', c128'😀'];
    Assert(Width(elements[0]) == 16u, "inferred array elements are char128");
    Assert(elements[0] == letter && elements[1] == lambda && elements[2] == face, "each element keeps its value");
    var buffer: char128[4];
    buffer[0] = letter;
    buffer[1] = Narrow('😀');
    buffer[2] = last;
    buffer[3] = c128'\0';
    Assert(sizeof(char128[4]) == 64u, "an array of four is 64 bytes");
    Assert(buffer[0] == letter && buffer[1] == face && buffer[2] == last && buffer[3] == c128'\0',
           "each written element keeps its value");
    Assert(Storage(buffer[1]) == 0x1F600u128 && Storage(buffer[3]) == 0u128, "with the upper word zero");
    var above = 0;
    for element in buffer {
        if element > c128'z' {
            above += 1;
        }
    }
    Assert(above == 2, "a loop over the elements compares each one");

    // Static data: a constant is its code point followed by zero words.
    Assert(Table[0] == letter && Table[1] == lambda && Table[2] == face && Table[3] == last,
           "a constant array keeps each element");
    Assert(Storage(Table[2]) == 0x1F600u128 && Storage(Table[3]) == 0x10FFFFu128, "with the upper word zero");

    // Passed and returned at its own width.
    Assert(Echo(face) == face && Storage(Echo(face)) == 0x1F600u128, "a value survives an argument and a return");
    Assert(Fifth(letter, lambda, euro, last, face) == face, "the fifth char128 argument arrives intact");
    Assert(Fifth(face, face, face, face, letter) == letter, "and does not take a neighbour's value");
    Assert(Between(3i32, letter, 4i32) == 72, "a char128 between two int32 arguments keeps all three");

    // Conditional selection: ternary, match and when.
    var chooseFirst = false;
    let selected = chooseFirst ? c128'A' : c128'😀';
    Assert(selected == face, "a char128 ternary keeps its selected code point");
    chooseFirst = true;
    Assert((chooseFirst ? letter : face) == letter, "and the other arm");
    Assert(Classify(c128'\0') == 1, "a NUL subject does not match another character");
    Assert(Classify(letter) == 2 && Classify(c128'\u{41}') == 2, "an escape matches plain text");
    Assert(Classify(Narrow('λ')) == 3, "a widened subject matches");
    Assert(Classify(face) == 4 && Classify(last) == 5, "a supplementary and the last scalar match");
    Assert(Classify(c128'B') == 9, "an unmatched char128 takes the default");
    when c128'A' == c128'\u{41}' && c128'😀' == c128'\u{1F600}' {
        Assert(true, "constant evaluation uses the same decoded scalar");
    } else {
        Assert(false, "character spellings must agree at compile time");
    }
    Assert(CastTable[0] == c128'a' && CastTable[1] == c128'A', "inline casts keep their constant bytes");
    Assert(CastCopies[2] == c256'😀', "a repeated inline cast keeps its wide character value");
    Assert(InLetterRange(c128'a') && InLetterRange(c128'z') && !InLetterRange(c128'A'), "inclusive character ranges");
    Assert(InWideRange(c512'A') && !InWideRange(c512'Z'), "exclusive wide character ranges");
    when (1u64 as uint128) << 100u == 1267650600228229401496703205376u128 &&
         (-1i64 as int256) == -1i256 && (65u512 as char128) == c128'A' &&
         (0x1F600u128 as char512) == c512'😀' {
        Assert(true, "wide integer casts and character casts fold exactly");
    } else {
        Assert(false, "wide constant casts must retain their value");
    }
    return 0;
}
