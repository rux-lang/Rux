// `throw`: an error leaving the function through its error side.
// `-> T ! E` names the error, or `-> !E` when there is no value, and `E` may be a sum. `throw value` is a statement,
// and also a whole arm body or the right side of `??`, where it produces no value. A case written without its type
// takes the function's error type. A `throw` always leaves the function, from a `catch` arm as from anywhere else, and
// the caller's arms receive it like a failed call's error.

import Core::Diagnostics::Assert;

variant DigitError {
    Blank,
    NotADigit(char)
}

struct NotFound {
    key: int32;
}

func ReadDigit(c: char) -> int ! DigitError {
    if c == ' ' {
        throw .Blank;
    }
    if c < '0' || c > '9' {
        throw .NotADigit(c);
    }
    return (c as int) - ('0' as int);
}

func Check(ok: bool) -> !DigitError {
    if !ok {
        throw DigitError::Blank;
    }
}

func Lookup(key: int32) -> int32 ! NotFound | DigitError {
    let found: int32? = if key > 0i32 { key * 2i32 } else { none };
    if key == 7i32 {
        throw DigitError::NotADigit('7');
    }
    return found ?? throw NotFound { key };
}

func Classify(c: char) -> int32 ! DigitError {
    return match c {
        'a' => 1i32,
        ' ' => throw .Blank,
        _ => throw DigitError::NotADigit(c),
    };
}

func Code(error: DigitError) -> int32 {
    return match error {
        .Blank => 1i32,
        .NotADigit(c) => (c as int32),
    };
}

func CheckBoth() -> !DigitError {
    Check(true)!;
    Check(false)!;
}

// A `throw` after a call takes the type the function's error side has.
func ThrowAfterRead() -> int32 ! DigitError {
    let value = ReadDigit('2')!;
    if value == 2 {
        throw .NotADigit('x');
    }
    return 50i32;
}

func ThrowOwner() -> !DigitError {
    throw DigitError::Blank;
}

func Main() -> int {
    Assert((ReadDigit('3') !! none) == 3, "a digit is read");
    Assert((ReadDigit(' ') !! none) == none, "a blank throws");
    var thrown = 0i32;
    CheckBoth() catch { e => { thrown = Code(e); } };
    Assert(thrown == 1i32, "a throws clause without a return type throws through it");

    // A sum error: each member leaves as itself.
    let found = Lookup(4i32) catch { _ => -1i32 };
    Assert(found == 8i32, "a present value is returned");
    let missing = Lookup(-3i32) catch {
        e: NotFound => e.key,
        _: DigitError => 0i32,
    };
    Assert(missing == -3i32, "'?? throw' throws the fallback error");
    let digit = Lookup(7i32) catch {
        _: NotFound => 0i32,
        e: DigitError => Code(e),
    };
    Assert(digit == ('7' as int32), "the other member of the sum is thrown");

    // A `throw` arm body.
    Assert((Classify('a') !! none) == .Some(1i32), "a value arm");
    Assert((Classify(' ') catch { e => Code(e) }) == 1i32, "a throw arm");

    // A `throw` reaches the caller's arms like a failed call.
    let caught = ThrowAfterRead() catch {
        .NotADigit(c) => (c as int32),
        .Blank => -1i32,
    };
    Assert(caught == ('x' as int32), "a throw after a call is caught by the caller's arms");

    // A `throw` written with the owner, with no call before it.
    var owner = 0i32;
    ThrowOwner() catch { e => { owner = Code(e); } };
    Assert(owner == 1i32, "a qualified throw needs no call before it");
    return 0;
}
