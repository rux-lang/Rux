// A generic extension implements its interface for every instantiation: a `Box<int32>` and a `Box<bool>` become
// `Named` handles or borrowed views, each through a table of its own instance's methods.
import Core::Assert;

interface Named {
    func Id(&self) -> int;
}

struct Box<T> {
    value: T;
    id: int;
}

extend Box<T> : Named {
    func Id(&self) -> int {
        return self.id;
    }
}

func Read(value: &Named) -> int {
    return value.Id();
}

func Borrowed(value: &Named) -> int {
    return value.Id();
}

func Main() -> int {
    let box = Box<int32> { value: 3, id: 7 };
    // Safety: `box` is a local of `Main` that outlives `named` and is never moved.
    let named = unsafe { @box as Named };
    Assert(named.Id() == 7, "interface value");
    Assert(Read(Box<bool> { value: true, id: 9 }) == 9, "argument");
    Assert(Borrowed(box) == 7, "borrowed");
    Assert(OtherId() == 11, "another module's instance vtable");
    return 0;
}
