// `x !! none`: turning an error into `none`.
// The result is the success made optional, or `none` when the operand fails, so its type is `T?`; several calls are
// gathered in a function and its result is replaced. `!!` and `??` are grouped, as in `(F() !! none) ?? fallback`. A
// success that is already optional keeps its level, so `none` stands for both a missing value and an error, unless the
// context expects one more level. A thrown error that owns resources is destroyed where it is dropped.

import Core::Diagnostics::Assert;

struct Counter {
    count: int32;
}

struct Problem {
    counter: *var Counter;
    code: int32;
}

extend Problem {
    func ~(&var self) {
        // Safety: every `Problem` in this test holds `@counter`, a local of `Main` that outlives it.
        self.counter.count = self.counter.count + 1i32;
    }
}

struct Small {
    value: int32;
}

func Check(counter: *var Counter, value: int32) -> int32 ! Problem {
    if value < 0i32 {
        throw Problem { counter, code: value };
    }
    return value;
}

func Touch(counter: *var Counter, fails: bool) -> !Small {
    // Safety: every caller passes `@counter`, a live local of `Main`.
    counter.count = counter.count + 100i32;
    if fails {
        throw Small { value: 1i32 };
    }
}

func Lookup(key: int32) -> int32? ! Small {
    if key < 0i32 {
        throw Small { value: key };
    }
    if key == 0i32 {
        return none;
    }
    return key;
}

func SumOfThree(counter: *var Counter) -> int32 ! Problem {
    return Check(counter, 1i32)! + Check(counter, -2i32)! + Check(counter, 3i32)!;
}

func SumOfTwo(counter: *var Counter) -> int32 ! Problem {
    return Check(counter, 1i32)! + Check(counter, 2i32)!;
}

func Main() -> int {
    var counter = Counter { count: 0i32 };
    Assert((Check(@counter, 4i32) !! none) == 4i32, "a success is present");
    Assert((Check(@counter, -4i32) !! none) == none, "an error is none");
    Assert(counter.count == 1i32, "the dropped error is destroyed once");

    // Several calls in one function: the first that throws ends it.
    let sum: int32? = SumOfThree(@counter) !! none;
    Assert(sum == none && counter.count == 2i32, "one error, destroyed once");
    let total = (SumOfTwo(@counter) !! none) ?? 0i32;
    Assert(total == 3i32, "a fallback after the parentheses");

    // A call with no success value gives `()?`.
    counter.count = 0i32;
    let ran: ()? = Touch(@counter, false) !! none;
    Assert(ran != none && counter.count == 100i32, "a unit success is present");
    Assert((Touch(@counter, true) !! none) == none, "a unit failure is none");

    // An optional success gains a level only where the context expects one.
    let present: int32?? = Lookup(5i32) !! none;
    Assert(present == 5i32, "present and present");
    Assert((Lookup(0i32) !! -1i32) == none, "present and absent");
    Assert((Lookup(-1i32) !! none) == none, "thrown");
    if let found? = (Lookup(9i32) !! none) {
        Assert(found == 9i32, "a binding test reads the result");
    }
    else {
        Assert(false, "the binding test matches");
    }
    return 0;
}
