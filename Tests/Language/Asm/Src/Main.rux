import Core::{ #Error, #target };

// The same five functions on both architectures, so that `Main` below is one
// program rather than two. On x86-64 they carry an explicit Win64 convention,
// which exercises the calling-convention override; AArch64 has one convention
// and nothing to override, so its bodies take their arguments where AAPCS64
// leaves them, in x0 and x1, and return in x0.
// A module variable an asm body reads and writes in place, reached by its address like any other symbol.
var Counter: int64 = 42;

when #target.arch {
    .X86_64 => {
        #Abi(.Win64)
        asm func Add(a: int64, b: int64) -> int64 {
            mov rax, rcx
            add rax, rdx
            ret
        }

        #Abi(.Win64)
        asm func MulSub(a: int64, b: int64) -> int64 {
            mov rax, rcx
            imul rax, rdx
            sub rax, 1
            ret
        }

        // Loop with a local label, a conditional jump and a decrement.
        #Abi(.Win64)
        asm func SumTo(n: int64) -> int64 {
            xor rax, rax
            mov rdx, rcx
        next:
            test rdx, rdx
            jz done
            add rax, rdx
            dec rdx
            jmp next
        done:
            ret
        }

        // Spill and reload through the stack, then shift.
        #Abi(.Win64)
        asm func DoubleViaStack(a: int64) -> int64 {
            mov qword [rsp - 8], rcx
            mov rax, qword [rsp - 8]
            shl rax, 1
            ret
        }

        // Calls another asm function; preserves the argument across the call.
        #Abi(.Win64)
        asm func Triple(x: int64) -> int64 {
            mov rax, rcx
            imul rax, 3
            ret
        }

        #Abi(.Win64)
        asm func TripleThenAdd(x: int64) -> int64 {
            push rcx
            call Triple
            pop rcx
            add rax, rcx
            ret
        }

        // A module variable is reached relative to the instruction after the access.
        #Abi(.Win64)
        asm func ReadCounter() -> int64 {
            mov rax, qword [rip + Counter]
            ret
        }

        #Abi(.Win64)
        asm func WriteCounter(value: int64) {
            mov qword [rip + Counter], rcx
            ret
        }
    },
    .AArch64 => {
        asm func Add(a: int64, b: int64) -> int64 {
            add x0, x0, x1
            ret
        }

        asm func MulSub(a: int64, b: int64) -> int64 {
            mul x0, x0, x1
            sub x0, x0, #1
            ret
        }

        // Loop with a local label, a conditional branch and a decrement.
        asm func SumTo(n: int64) -> int64 {
            mov x1, x0
            mov x0, xzr
        next:
            cbz x1, done
            add x0, x0, x1
            sub x1, x1, #1
            b next
        done:
            ret
        }

        // Spill and reload through the stack, then shift. AAPCS64 promises no
        // red zone, so the slot is one the function opens for itself.
        asm func DoubleViaStack(a: int64) -> int64 {
            sub sp, sp, #16
            str x0, [sp]
            ldr x0, [sp]
            add sp, sp, #16
            lsl x0, x0, #1
            ret
        }

        // Calls another asm function; preserves the argument and the link
        // register across the call, which is what a leaf body does not have to.
        asm func Triple(x: int64) -> int64 {
            mov x1, #3
            mul x0, x0, x1
            ret
        }

        asm func TripleThenAdd(x: int64) -> int64 {
            stp x0, x30, [sp, #-16]!
            bl Triple
            ldp x1, x30, [sp], #16
            add x0, x0, x1
            ret
        }

        // A module variable is reached through the page `adrp` finds and the offset within it the access adds.
        asm func ReadCounter() -> int64 {
            adrp x0, Counter
            ldr x0, [x0, Counter]
            ret
        }

        asm func WriteCounter(value: int64) {
            adrp x1, Counter
            str x0, [x1, Counter]
            ret
        }
    },
    _ => #Error("Unsupported architecture for the inline-assembly test")
}

func Main() -> int {
    // Safety: `Add` reads its two argument registers and writes only the result register.
    if (unsafe { Add(40, 2) } != 42) {
        return 1;
    }
    // Safety: `MulSub` reads its two argument registers and writes only the result register.
    if (unsafe { MulSub(6, 7) } != 41) {
        return 2;
    }
    // Safety: `SumTo` touches only caller-saved scratch registers and ends its loop when the counter reaches zero.
    if (unsafe { SumTo(100) } != 5050) {
        return 3;
    }
    // Safety: `DoubleViaStack` spills only to a stack slot it owns (the red zone or a slot it opens) and restores `sp`.
    if (unsafe { DoubleViaStack(21) } != 42) {
        return 4;
    }
    // Safety: `TripleThenAdd` saves the argument (and the link register) on the stack around its call and pops it back.
    if (unsafe { TripleThenAdd(10) } != 40) {
        return 5;
    }
    // Safety: `Sqrt` computes in place in the first float argument register.
    if (unsafe { Sqrt(16.0) } != 4.0) {
        return 6;
    }
    // Safety: `MulAdd` reads three float argument registers and writes only the float result register.
    if (unsafe { MulAdd(3.0, 4.0, 5.0) } != 17.0) {
        return 7;
    }
    // Safety: `MinOf` reads two float argument registers and writes only the float result register.
    if (unsafe { MinOf(2.5, 9.0) } != 2.5) {
        return 8;
    }
    // Safety: `IntToFloat` converts its integer argument register into the float result register.
    if (unsafe { IntToFloat(42) } != 42.0) {
        return 9;
    }
    // Safety: `FloatToInt` converts its float argument register into the integer result register.
    if (unsafe { FloatToInt(7.9) } != 7) {
        return 10;
    }
    if (PlatformAbiCheck() != 0) {
        return 11;
    }
    // Safety: `ReadCounter` only loads the module variable `Counter`, an `int64` that lives for the whole program.
    if (unsafe { ReadCounter() } != 42) {
        return 12;
    }
    // Safety: `WriteCounter` stores one `int64` into the module variable `Counter`, which nothing else is using.
    unsafe { WriteCounter(7); }
    // Safety: `ReadCounter` only loads the module variable `Counter`, an `int64` that lives for the whole program.
    if (Counter != 7 || unsafe { ReadCounter() } != 7) {
        return 13;
    }
    return 0;
}
