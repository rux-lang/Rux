import Core::Assert;

// `option ?? fallback` on a native optional: the payload of one present level, or the fallback evaluated only for
// absence, with every payload moved exactly once.

struct Wide {
    first: int64;
    second: int64;
    third: int64;
}

struct Tracked {
    value: int32;
    drops: *var int32;
}

extend Tracked {
    func =(self: &var Tracked, other: &Tracked);

    func ~Tracked(self: &var Tracked) {
        *self.drops += 1;
    }
}

func CountedOption(value: int32, calls: *var int32) -> int32? {
    *calls += 1;
    return value;
}

func CountedFallback(value: int32, calls: *var int32) -> int32 {
    *calls += 1;
    return value;
}

func CountedTracked(value: int32, calls: *var int32, drops: *var int32) -> Tracked {
    *calls += 1;
    return Tracked { value: value, drops: drops };
}

func Generic<T>(option: T?, fallback: T) -> T {
    return (<-option) ?? <-fallback;
}

func Nested(present: bool) -> int32?? {
    if present {
        return .Some(none);
    }
    return none;
}

func PropagateThenCoalesce(present: bool) -> int32? {
    let value = Nested(present)? ?? 17i32;
    return value;
}

func Held(option: int32?) -> int32 {
    return (<-option) ?? -1i32;
}

func SomeDropCase(drops: *var int32, fallbackCalls: *var int32) {
    let option: Tracked? = .Some(Tracked { value: 7i32, drops: drops });
    let selected = (<-option) ?? CountedTracked(9i32, fallbackCalls, drops);
    Assert(selected.value == 7i32, "a present value should transfer its payload");
}

func NoneDropCase(drops: *var int32, fallbackCalls: *var int32) {
    let option: Tracked? = none;
    let selected = (<-option) ?? CountedTracked(9i32, fallbackCalls, drops);
    Assert(selected.value == 9i32, "absence should produce the fallback");
}

func Main() -> int {
    var leftCalls = 0i32;
    var fallbackCalls = 0i32;
    Assert((CountedOption(7i32, @leftCalls) ?? CountedFallback(9i32, @fallbackCalls)) == 7i32,
           "a present value should select its payload");
    Assert(leftCalls == 1i32, "the coalescing operand should be evaluated once");
    Assert(fallbackCalls == 0i32, "a present value should not evaluate the fallback");

    let absent: int32? = none;
    Assert((absent ?? CountedFallback(11i32, @fallbackCalls)) == 11i32, "absence should select its fallback");
    Assert(fallbackCalls == 1i32, "absence should evaluate the fallback exactly once");

    let reusable: int32? = .Some(3i32);
    Assert((reusable ?? 0i32) == 3i32, "a copyable named optional should be reusable");
    Assert((reusable ?? 0i32) == 3i32, "coalescing should copy a copyable named optional");

    let later: int32? = .Some(4i32);
    Assert((absent ?? later ?? 5i32) == 4i32, "coalescing chains should associate to the right");

    let generic = Generic<int32>(none, 13i32);
    Assert(generic == 13i32, "generic optionals should coalesce after substitution");

    let wideOption: Wide? = .Some(Wide { first: 1, second: 2, third: 3 });
    let wide = wideOption ?? Wide { first: 4, second: 5, third: 6 };
    Assert(wide.third == 3, "wide payloads should transfer through match lowering");
    let nothing: ()? = none;
    let unit = nothing ?? ();

    var pointee = 21i32;
    let pointerOption: (*var int32)? = .Some(@pointee);
    let pointer = pointerOption ?? null;
    Assert(pointer != null && *pointer == 21i32, "raw pointers should work as optional payloads");

    Assert(Held(PropagateThenCoalesce(true)) == 17i32, "postfix propagation should compose with coalescing");
    Assert(Held(PropagateThenCoalesce(false)) == -1i32, "propagation should still return none early");

    var drops = 0i32;
    var trackedFallbackCalls = 0i32;
    SomeDropCase(@drops, @trackedFallbackCalls);
    Assert(trackedFallbackCalls == 0i32, "unused move-only fallback should never be constructed");
    Assert(drops == 1i32, "the selected present payload should be destroyed exactly once");
    NoneDropCase(@drops, @trackedFallbackCalls);
    Assert(trackedFallbackCalls == 1i32, "the move-only fallback should be constructed once for absence");
    Assert(drops == 2i32, "the selected fallback should be destroyed exactly once");
    return 0;
}
