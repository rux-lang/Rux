import Core::{ Assert, CheckedAdd, CheckedMul, CheckedSub };

struct Header {
    tag: uint32;
    payload: uint64;
}

struct Packed {
    first: uint8;
    second: uint8;
}

enum ByteCode: uint8 {
    Empty = 0,
    Full = 1
}

variant UnitState {
    Empty,
    Full
}

variant Maybe<T> {
    None,
    Some(T)
}

variant Envelope {
    Empty,
    Header(Header)
}

// The shape of an allocation: a count times an element size, refused rather than wrapped.
func ByteCount(count: uint64, elementSize: uint64, bytes: *var uint64) -> bool {
    return CheckedMul(count, elementSize, bytes);
}

// Both queries asked of a type parameter, which is where a generic container asks them: the type is not known where
// the question is written, so it is answered at each instantiation instead.
func SizeOfElement<T>() -> uint64 {
    return sizeof(T);
}

func AlignOfElement<T>() -> uint64 {
    return alignof(T);
}

func Main() -> int {
    Assert(sizeof(uint8) == 1u64, "Expected sizeof(uint8) to be 1");
    Assert(sizeof(uint32) == 4u64, "Expected sizeof(uint32) to be 4");
    Assert(sizeof(Header) == 16u64, "Expected the padded struct size");
    Assert(sizeof(Packed) == 2u64, "Expected the unpadded struct size");

    Assert(alignof(uint8) == 1u64, "Expected alignof(uint8) to be 1");
    Assert(alignof(uint32) == 4u64, "Expected alignof(uint32) to be 4");
    Assert(alignof(Header) == 8u64, "Expected the struct alignment to be its widest field's");
    Assert(alignof(Packed) == 1u64, "Expected a byte-aligned struct");
    Assert(alignof(Header[4]) == 8u64, "Expected an array to keep its element alignment");

    Assert(sizeof(ByteCode) == 1u64, "Expected a scalar enum to use its uint8 base layout");
    Assert(alignof(ByteCode) == 1u64, "Expected a scalar enum to use its uint8 base alignment");
    Assert(sizeof(UnitState) == 8u64, "Expected an all-unit variant to retain its private tag");
    Assert(alignof(UnitState) == 8u64, "Expected an all-unit variant to retain tag alignment");
    Assert(sizeof(Maybe<uint8>) == 16u64, "Expected a generic variant to include tag and payload storage");
    Assert(alignof(Maybe<uint8>) == 8u64, "Expected a generic variant tag to set minimum alignment");
    Assert(sizeof(Envelope) == 24u64, "Expected a named payload to follow the private tag");
    Assert(alignof(Envelope) == 8u64, "Expected the widest named payload field to set alignment");
    Assert(sizeof(Maybe<Header>) == 24u64, "Expected generic payload layout to follow its concrete argument");

    // The same answers through a type parameter. A struct whose size and alignment differ is what separates the two
    // questions: Header is sixteen bytes aligned to eight, so an implementation answering either with the other is
    // visible here and nowhere else.
    Assert(SizeOfElement<uint32>() == 4u64, "Expected sizeof through a type parameter");
    Assert(AlignOfElement<uint32>() == 4u64, "Expected alignof through a type parameter");
    Assert(SizeOfElement<Header>() == 16u64, "Expected the struct size through a type parameter");
    Assert(AlignOfElement<Header>() == 8u64, "Expected the struct alignment through a type parameter");
    Assert(SizeOfElement<Packed>() == 2u64, "Expected the unpadded size through a type parameter");
    Assert(AlignOfElement<Packed>() == 1u64, "Expected the unpadded alignment through a type parameter");

    var sum = 0u64;
    Assert(!CheckedAdd(2u64, 3u64, @sum), "Expected 2 + 3 not to overflow");
    Assert(sum == 5u64, "Expected the checked sum");
    Assert(CheckedAdd(18446744073709551615u64, 1u64, @sum), "Expected the sum to overflow");
    Assert(sum == 0u64, "Expected the wrapped sum to be written anyway");

    var difference = 0u64;
    Assert(!CheckedSub(9u64, 4u64, @difference), "Expected 9 - 4 not to overflow");
    Assert(difference == 5u64, "Expected the checked difference");
    Assert(CheckedSub(4u64, 9u64, @difference), "Expected a negative difference to be reported");

    var bytes = 0u64;
    Assert(!ByteCount(4u64, sizeof(Header), @bytes), "Expected a small allocation size to be exact");
    Assert(bytes == 64u64, "Expected four headers to need 64 bytes");
    Assert(ByteCount(18446744073709551615u64, 2u64, @bytes), "Expected an impossible allocation to be refused");
    Assert(!ByteCount(0u64, 18446744073709551615u64, @bytes), "Expected an empty allocation not to overflow");
    Assert(bytes == 0u64, "Expected an empty allocation to need no bytes");
    Assert(!ByteCount(18446744073709551615u64, 1u64, @bytes), "Expected the largest exact product to be accepted");
    Assert(bytes == 18446744073709551615u64, "Expected the largest exact product");
    return 0;
}
