// bool128: one of two values in 16 bytes, two machine words wide.
// The narrowest wide boolean: the first width no general-purpose register holds, so it is the one where a
// boolean is passed and stored as a pair of words rather than as a single value.
// Boolean logic is pinned once in `Bool`; what belongs to a width is its storage, what a cast into it stores, and
// whether conversion to another width preserves meaning. A wide boolean holds one or zero in its low word and zero in
// every other word, so the cases below are the ones that would notice a word left over: a source whose only set bit
// is far from the low word, `~` flipping the value rather than every bit, and a narrow boolean widened on its way into
// a parameter.

import Core::Assert;
import Core::{ bool128, bool16, bool256, bool32, bool512, bool64, bool8, int128, uint128 };

const On: bool128 = true;
const Off: bool128 = false;
const Pattern: bool128[3] = [true, false, true];

func Echo(value: bool128) -> bool128 {
    return value;
}

func Both(left: bool128, right: bool128) -> bool128 {
    return left && right;
}

func Narrowed(value: bool128) -> bool8 {
    return value as bool8;
}

// Counts the turns of a loop whose condition is a bool128, clearing it after the first.
func Turns(flag: bool128) -> int {
    var turns = 0;
    var remaining = flag;
    while remaining {
        turns += 1;
        remaining = false;
    }
    return turns;
}

struct Pair {
    first: bool128;
    second: bool128;
}

struct Tagged {
    tag: bool8;
    flag: bool128;
}

func Main() -> int {
    Assert(bool128::Bits == 128u && bool128::Bytes == 16u, "bool128 is 128 bits in 16 bytes");
    Assert(sizeof(bool128) == 16u, "sizeof agrees with Bytes");
    Assert(sizeof(bool128) == sizeof(int128), "it is as wide as int128");

    let yes: bool128 = true;
    let no: bool128 = false;
    Assert(yes, "a true bool128 passes an assertion");
    Assert(!no, "and a false one negates to true");

    // The operators, over both values. `!` produces a bool8; `~`, `&`, `|` and `^` keep the width.
    Assert(yes && !(yes && no) && !(no && yes), "the conjunction");
    Assert((yes || no) && (no || yes) && !(no || no), "the disjunction");
    Assert(!(~yes) && (~no), "~ flips the value");
    Assert((~yes) as int128 == 0i128 && (~no) as int128 == 1i128, "and leaves every word above the low one zero");
    Assert((yes & yes) && !(yes & no), "bitwise and");
    Assert((yes | no) && !(no | no), "bitwise or");
    Assert((yes ^ no) && !(yes ^ yes), "bitwise exclusive or");
    Assert((yes ^ no) as int128 == 1i128, "an exclusive or of the two values is exactly one");
    Assert(yes == yes && no == no && yes != no, "equality compares values");
    Assert(yes == true && no == false && no != true, "and a literal takes the width of the other side");

    // A cast tests the whole source for non-zero, at the full width of the source.
    let topBit: uint128 = 1u128 << 127;
    let farWord: int128 = 1i128 << 64;
    Assert((topBit as bool128), "a source whose only set bit is the top one is true");
    Assert((farWord as bool128), "and so is one whose only set bit is in the upper word");
    Assert(((1u128 << 127) as bool128), "and so is the same value folded while compiling");
    Assert((topBit as bool8) && (farWord as bool64), "a narrower boolean also tests every word of the source");
    Assert((farWord as bool128) as int128 == 1i128, "what is stored is one, not the source bits");
    Assert(!((0 as int128) as bool128), "a wide zero source is false");
    Assert((yes as uint128) == 1u128 && (no as uint128) == 0u128, "true reads back as exactly one, false as zero");
    Assert((yes as int8) == 1i8 && (yes as int64) == 1i64, "and so it does at a narrower integer");

    // Conversion to every other width preserves meaning rather than bits.
    Assert((yes as bool8) && (yes as bool16) && (yes as bool32) && (yes as bool64) && (yes as bool256) && (yes as bool512),
           "true converts to every width as true");
    Assert(!(no as bool8) && !(no as bool16) && !(no as bool32) && !(no as bool64) && !(no as bool256) && !(no as bool512),
           "false converts to every width as false");
    let widenedByte: bool128 = (true as bool8) as bool128;
    Assert(widenedByte as int128 == 1i128, "a widened bool8 is one with every higher word zero");
    Assert(((true as bool64) as bool128) as int128 == 1i128, "and so is a widened bool64");
    Assert(((yes as bool512) as bool128) && !((no as bool512) as bool128), "a round trip through bool512 keeps both");

    // Conditions read the value, wherever it sits.
    var reached = false;
    if yes {
        reached = true;
    }
    Assert(reached, "a true bool128 enters an if");
    if no {
        reached = false;
    }
    Assert(reached, "and a false one skips it");
    Assert(Turns(yes) == 1 && Turns(no) == 0, "a bool128 drives a while loop");
    let matched = match yes {
        true => 1,
        false => 0
    };
    Assert(matched == 1, "a match on a bool128 takes the true arm");
    Assert(match no { true => false, false => true }, "and the false one");
    Assert((yes ? 7 : 9) == 7 && (no ? 7 : 9) == 9, "a bool128 chooses a ternary arm");
    let chosen: bool128 = reached ? no : yes;
    Assert(!chosen, "and both arms of a bool128 ternary keep their value");

    // Storage: fields, padding and elements.
    Assert(sizeof(Pair) == 32u, "two bool128 fields occupy 32 bytes");
    Assert(sizeof(Tagged) == 32u, "a bool8 beside a bool128 is padded to its sixteen-byte alignment");
    Assert(alignof(Tagged) == 16u && alignof(bool128) == 16u, "and the struct takes the bool128 alignment");
    let pair = Pair { first: true, second: false };
    Assert(pair.first && !pair.second, "each field keeps its own value");
    let tagged = Tagged { tag: false, flag: yes };
    Assert(!tagged.tag && tagged.flag, "and so does a field after the padding");
    var flags: bool128[4];
    flags[0] = true;
    flags[1] = false;
    flags[2] = yes;
    flags[3] = ~yes;
    Assert(sizeof(bool128[4]) == 64u, "an array of four is 64 bytes");
    Assert(flags[0] && !flags[1] && flags[2] && !flags[3], "each element keeps its own value");

    // Static data: a constant true is one followed by zero words.
    Assert(On && !Off, "constants hold their values");
    Assert((On as int128) == 1i128 && (Off as int128) == 0i128, "and their stored words are canonical");
    Assert(Pattern[0] && !Pattern[1] && Pattern[2], "a constant array keeps each element");

    // Passed and returned at its own width, from a bool128 or from a narrower boolean.
    Assert(Echo(yes) && !Echo(no), "both values survive an argument and a return");
    Assert(Echo(yes) as int128 == 1i128, "and the returned true is canonical");
    Assert(Echo(true) && !Echo(false), "a literal argument takes the parameter width");
    let narrow: bool8 = true;
    Assert(Echo(narrow) && Echo(3 > 2) && !Echo(2 > 3), "a bool8 argument widens to the parameter");
    Assert(Echo(narrow) as int128 == 1i128, "with every higher word zero");
    Assert(Both(yes, yes) && !Both(yes, no) && !Both(no, yes), "two bool128 arguments arrive intact");
    Assert(Narrowed(yes) && !Narrowed(no), "a bool128 narrows on its way out");
    return 0;
}
