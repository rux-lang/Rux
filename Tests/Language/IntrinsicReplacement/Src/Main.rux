import Foundation::{ #target, Tiny, Utf8, float64, uint };

when Tiny::Max == 127i8 && Tiny::Bits == 8u && uint::Bits == #target.pointerBits {
    func Selected() -> int { return 1; }
} else {
    func Selected() -> int { return Missing; }
}

func First<T>(values: T[..]) -> T { return values[0]; }

func Main() -> int {
    let text: Utf8 = "hello";
    let wide: char16[..] = c16"hello";
    let widest: char32[..] = c32"hello";
    if text.length != 5 || wide.length != 5 || widest.length != 5 { return 1; }
    let units = (text.data)[..text.length];
    if First(units) != c8'h' { return 2; }
    let bounds = 1..4;
    if bounds.start != 1 || bounds.end != 4 { return 3; }
    var sum: int = 0;
    for value in bounds { sum += value; }
    if sum != 6 || Selected() != 1 { return 4; }
    if Tiny::Min != -128i8 || Tiny::Max != 127i8 { return 5; }
    if !(float64::Infinity > 1.0) { return 6; }
    if float64::NaN == float64::NaN { return 7; }
    return 0;
}
