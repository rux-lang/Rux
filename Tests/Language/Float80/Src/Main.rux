// float80 is a reserved primitive type: the catalog names it, and this compiler does not implement it.
//
// This directory exists so the primitive matrix under Tests/Language is complete by inspection rather than
// by inference. Every entry in Compiler/Types/PrimitiveCatalog.cpp has a directory here, and
// LanguageTestMatrixTests checks that the two agree, so a width cannot reach the catalog without somewhere
// to exercise it.
//
// A program using float80 cannot be that exercise, because it does not compile: the compiler reports that the
// type is reserved but not implemented in this version. A refusal is not something an executable test can
// assert, since one passes by exiting zero. It is asserted in Tests/Unit/Golden/ReservedPrimitiveTypes.rux
// instead, where an expected compile failure is the whole point.
//
// What is left to check here is the boundary: float64 is the widest implemented float, and this
// file pins that it is the one carrying the constants. When float80 is implemented, replace this placeholder
// with the real case rather than adding a directory.

import Core::Assert;
import Core::float64;

func Main() -> int {
    Assert(float64::Bits == 64u, "float64 is the implemented width beside reserved float80");
    Assert(float64::Bytes * 8u == float64::Bits, "its byte and bit counts agree");
    return 0;
}
