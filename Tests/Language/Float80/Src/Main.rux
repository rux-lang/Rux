// float80: x87 extended precision, with a 64-bit significand whose integer bit is explicit and 15 bits of exponent,
// ten bytes held in sixteen.
// On x86-64 the x87 unit runs its arithmetic, comparisons, float32 and float64 conversions, and the conversion from a
// signed integer of up to 64 bits, with the precision control set to 64 bits around each one; everything else, and
// every operation on other targets, runs in a helper the compiler synthesizes. Both must agree with the compiler's own
// folding, so each check compares a result computed at run time against a `const` the compiler folded, bit for bit.
// A value is passed through a function to make the operation run, and its ten value bytes are read through a pointer,
// since `==` would call -0 and +0 the same and every NaN different. A NaN result is only checked to be a NaN, because
// its sign and payload are not specified at run time.

import Core::{ Assert, #config };
import Core::{ float128, float256, float32, float512, float64, float80, int128, int256, int32, int64, int8, uint128,
               uint32, uint512, uint64, uint8 };

const Zero: float80 = 0.0f80;
const NegativeZero: float80 = -0.0f80;
const One: float80 = 1.0f80;
const Two: float80 = 2.0f80;
const Three: float80 = 3.0f80;
const Tenth: float80 = 0.1f80;
const Fifth: float80 = 0.2f80;
const Infinity: float80 = float80::Infinity;
const NaN: float80 = float80::NaN;

// Folded results, each the reference for one run-time operation below.
const TenthPlusFifth: float80 = 0.1f80 + 0.2f80;
const TenthMinusThird: float80 = 0.1f80 - 1.0f80 / 3.0f80;
const Third: float80 = 1.0f80 / 3.0f80;
const TenthTimesThird: float80 = 0.1f80 * (1.0f80 / 3.0f80);
const TenAndAHalfModThree: float80 = 10.5f80 % 3.0f80;
const NegativeTenAndAHalfModThree: float80 = -10.5f80 % 3.0f80;
const MaxModThree: float80 = float80::Max % 3.0f80;
const MaxModTenth: float80 = float80::Max % 0.1f80;
const HalfEpsilon: float80 = float80::Epsilon / 2.0f80;
const OnePlusEpsilon: float80 = 1.0f80 + float80::Epsilon;
const ThreeQuarterEpsilon: float80 = float80::Epsilon * 0.75f80;
const HalfMinPositive: float80 = float80::MinPositive / 2.0f80;
const Chained: float80 = ((1.0f80 + 0.1f80) * 3.0f80 - 0.2f80) / 3.0f80 % 0.25f80;
const TenTenths: float80 = 0.1f80 + 0.1f80 + 0.1f80 + 0.1f80 + 0.1f80 + 0.1f80 + 0.1f80 + 0.1f80 +
                            0.1f80 + 0.1f80;
const Largest: float80 = float80::Max;
const Table: float80[4] = [Tenth, NegativeZero, Largest, Infinity];

// The ten value bytes; the six above them are storage padding and not part of the value.
func Bits(value: float80) -> uint128 {
    let address = (@value) as *uint128;
    return *address & ((1u128 << 80) - 1u128);
}

func Same(left: float80, right: float80) -> bool {
    return Bits(left) == Bits(right);
}

func IsNan(value: float80) -> bool {
    return value != value;
}

func Add(left: float80, right: float80) -> float80 {
    return left + right;
}

func Subtract(left: float80, right: float80) -> float80 {
    return left - right;
}

func Multiply(left: float80, right: float80) -> float80 {
    return left * right;
}

func Divide(left: float80, right: float80) -> float80 {
    return left / right;
}

func Remainder(left: float80, right: float80) -> float80 {
    return left % right;
}

func Negate(value: float80) -> float80 {
    return -value;
}

func Less(left: float80, right: float80) -> bool {
    return left < right;
}

func LessOrEqual(left: float80, right: float80) -> bool {
    return left <= right;
}

func Greater(left: float80, right: float80) -> bool {
    return left > right;
}

func GreaterOrEqual(left: float80, right: float80) -> bool {
    return left >= right;
}

func Equal(left: float80, right: float80) -> bool {
    return left == right;
}

func NotEqual(left: float80, right: float80) -> bool {
    return left != right;
}

func Truth(value: float80) -> bool {
    return value as bool;
}

func Compound(start: float80) -> float80 {
    var value = start;
    value += 0.1f80;
    value *= 3.0f80;
    value -= 0.2f80;
    value /= 3.0f80;
    value %= 0.25f80;
    return value;
}

func FromInt8(value: int8) -> float80 {
    return value as float80;
}

func FromInt32(value: int32) -> float80 {
    return value as float80;
}

func FromInt64(value: int64) -> float80 {
    return value as float80;
}

func FromInt(value: int) -> float80 {
    return value as float80;
}

func FromUint32(value: uint32) -> float80 {
    return value as float80;
}

func FromUint64(value: uint64) -> float80 {
    return value as float80;
}

func FromInt128(value: int128) -> float80 {
    return value as float80;
}

func FromUint128(value: uint128) -> float80 {
    return value as float80;
}

func FromInt256(value: int256) -> float80 {
    return value as float80;
}

func FromUint512(value: uint512) -> float80 {
    return value as float80;
}

func ToInt32(value: float80) -> int32 {
    return value as int32;
}

func ToInt64(value: float80) -> int64 {
    return value as int64;
}

func ToUint64(value: float80) -> uint64 {
    return value as uint64;
}

func ToInt128(value: float80) -> int128 {
    return value as int128;
}

func ToUint8(value: float80) -> uint8 {
    return value as uint8;
}

func FromFloat32(value: float32) -> float80 {
    return value as float80;
}

func FromFloat64(value: float64) -> float80 {
    return value as float80;
}

func FromFloat128(value: float128) -> float80 {
    return value as float80;
}

func FromFloat256(value: float256) -> float80 {
    return value as float80;
}

func FromFloat512(value: float512) -> float80 {
    return value as float80;
}

func ToFloat32(value: float80) -> float32 {
    return value as float32;
}

func ToFloat64(value: float80) -> float64 {
    return value as float64;
}

func ToFloat128(value: float80) -> float128 {
    return value as float128;
}

func ToFloat256(value: float80) -> float256 {
    return value as float256;
}

func ToFloat512(value: float80) -> float512 {
    return value as float512;
}

struct Sample {
    tag: int8;
    value: float80;
}

func Scaled(sample: Sample, factor: float80) -> Sample {
    return Sample { tag: sample.tag + 1i8, value: sample.value * factor };
}

func Main() -> int {
    Assert(float80::Bits == 80u && float80::Bytes == 16u, "float80 is 80 bits in 16 bytes");
    Assert(sizeof(float80) == 16u, "sizeof agrees with Bytes");

    // Each operation, against the folded result.
    Assert(Same(Add(Tenth, Fifth), TenthPlusFifth), "addition rounds as the folded sum does");
    Assert(Add(Tenth, Fifth) == 0.3f80, "and at 64 bits a tenth plus a fifth happens to round to three tenths");
    Assert(Same(Subtract(Tenth, Divide(One, Three)), TenthMinusThird), "subtraction");
    Assert(Same(Divide(One, Three), Third), "division");
    Assert(Same(Multiply(Tenth, Third), TenthTimesThird), "multiplication");
    Assert(Same(Remainder(10.5f80, Three), TenAndAHalfModThree), "remainder");
    Assert(Same(Remainder(-10.5f80, Three), NegativeTenAndAHalfModThree), "remainder keeps the dividend's sign");
    Assert(Remainder(10.5f80, Three) == 1.5f80, "and is exact");
    Assert(Same(Remainder(float80::Max, Three), MaxModThree), "remainder across the whole exponent range");
    Assert(Same(Remainder(float80::Max, Tenth), MaxModTenth), "and by a divisor that is not a power of two");
    Assert(Same(Negate(Tenth), -0.1f80), "negation flips the sign");

    // Rounding at the last of the 64 bits: an exact sum, a tie to even, and a sum just past the tie.
    Assert(Same(Add(One, float80::Epsilon), OnePlusEpsilon), "one plus epsilon is exact");
    Assert(Add(One, float80::Epsilon) != One, "and differs from one");
    Assert(Same(Add(One, HalfEpsilon), One), "half an epsilon is a tie, and rounds to the even one");
    Assert(Same(Add(OnePlusEpsilon, HalfEpsilon), Add(One, Multiply(float80::Epsilon, Two))),
           "the same tie from an odd significand rounds up");
    Assert(Same(Add(One, ThreeQuarterEpsilon), OnePlusEpsilon), "past the tie rounds up");

    // The ends of the range.
    Assert(Same(Multiply(float80::Max, Two), Infinity), "overflow gives the infinity");
    Assert(Same(Add(float80::Max, float80::Max), Infinity), "and so does a sum past the maximum");
    Assert(Same(Divide(float80::MinPositive, Two), HalfMinPositive), "halving the smallest normal gives a subnormal");
    Assert(Greater(HalfMinPositive, Zero), "which is above zero");
    Assert(Same(Multiply(float80::MinPositive, float80::MinPositive), Zero), "and a deep underflow gives zero");
    Assert(Same(Subtract(float80::Lowest, float80::Max), -Infinity), "and below the lowest, the negative infinity");

    // Zeros: their sign survives where it should and only there.
    Assert(Same(Negate(Zero), NegativeZero), "negating zero gives minus zero");
    Assert(Same(Subtract(Tenth, Tenth), Zero), "an exact cancellation gives plus zero");
    Assert(Same(Add(NegativeZero, NegativeZero), NegativeZero), "minus zero plus minus zero stays negative");
    Assert(Same(Add(NegativeZero, Zero), Zero), "and with a plus zero becomes positive");
    Assert(Same(Divide(One, NegativeZero), -Infinity), "one over minus zero is the negative infinity");
    Assert(Same(Divide(One, Infinity), Zero), "one over the infinity is zero");
    Assert(Equal(NegativeZero, Zero) && !Less(NegativeZero, Zero) && LessOrEqual(NegativeZero, Zero),
           "the two zeros compare equal");
    Assert(!NotEqual(Zero, NegativeZero) && GreaterOrEqual(Zero, NegativeZero), "from both sides");

    // NaN: every operation that has no answer gives one, and every comparison against one is false.
    Assert(IsNan(Divide(Zero, Zero)), "zero over zero is a NaN");
    Assert(IsNan(Subtract(Infinity, Infinity)), "the infinity minus itself is a NaN");
    Assert(IsNan(Multiply(Zero, Infinity)), "zero times the infinity is a NaN");
    Assert(IsNan(Remainder(One, Zero)), "a remainder by zero is a NaN");
    Assert(IsNan(Remainder(Infinity, Three)), "and so is the infinity's remainder");
    Assert(IsNan(Add(NaN, One)) && IsNan(Multiply(Two, NaN)), "a NaN operand gives a NaN");
    Assert(!Less(NaN, One) && !Greater(NaN, One) && !LessOrEqual(NaN, NaN) && !GreaterOrEqual(One, NaN),
           "no ordering holds against a NaN");
    Assert(!Equal(NaN, NaN) && NotEqual(NaN, NaN), "and a NaN is unequal even to itself");
    Assert(Less(-Infinity, float80::Lowest) && Greater(Infinity, float80::Max), "the infinities bound the range");
    Assert(Less(Tenth, Fifth) && Greater(Fifth, Tenth) && LessOrEqual(Tenth, Tenth) && GreaterOrEqual(Tenth, Tenth),
           "the ordinary orderings");
    Assert(Less(Negate(Fifth), Tenth) && !Less(Tenth, Negate(Fifth)), "and across the sign");

    // A cast to bool tests for non-zero: either zero is false, and a NaN is true.
    Assert(!Truth(Zero) && !Truth(NegativeZero), "both zeros are false");
    Assert(Truth(One) && Truth(HalfMinPositive) && Truth(-Infinity) && Truth(NaN), "everything else is true");

    // Integers in. A float80 holds every int64 and uint64 exactly, and rounds wider ones to 64 bits. On x86-64 a
    // signed integer of up to 64 bits is loaded by the x87 unit, and the others convert in software.
    Assert(Same(FromInt8(-7i8), -7.0f80) && Same(FromInt32(-2147483648i32), -2147483648.0f80), "narrow signed integers");
    Assert(Same(FromInt64(-9223372036854775808i64), -9223372036854775808.0f80), "int64::Min is exact");
    Assert(Same(FromInt64(9223372036854775807i64), 9223372036854775807.0f80), "and so is int64::Max");
    Assert(Same(FromInt(-3), -3.0f80), "and an int");
    Assert(Same(FromUint32(4294967295u32), 4294967295.0f80), "uint32::Max is exact");
    Assert(Same(FromUint64(18446744073709551615u64), 18446744073709551615.0f80), "and so is uint64::Max");
    Assert(Same(FromUint64(9223372036854775808u64), 9223372036854775808.0f80), "and 2^63 stays positive");
    Assert(Same(FromInt128(-170141183460469231731687303715884105728i128),
                -170141183460469231731687303715884105728.0f80),
           "int128::Min is exactly -2^127");
    Assert(Same(FromUint128(uint128::Max), uint128::Max as float80), "uint128::Max rounds up to 2^128");
    Assert(Same(FromUint128(uint128::Max), 340282366920938463463374607431768211456.0f80), "which is that power");
    Assert(Same(FromUint128((1u128 << 64) + 1u128), (1u128 << 64) as float80), "a tie rounds to even");
    Assert(Same(FromUint128((1u128 << 64) + 3u128), ((1u128 << 64) + 4u128) as float80), "and the next one up");
    let wide: int256 = -(1i256 << 200) - 1i256;
    Assert(Same(FromInt256(wide), (-(1i256 << 200) - 1i256) as float80), "an int256 rounds to 64 bits");
    Assert(Same(FromUint512(~0u512), (~0u512) as float80), "and a uint512 to 2^512");
    Assert(Same(FromInt64(0i64), Zero) && Same(FromUint64(0u64), Zero), "zero converts to plus zero");

    // Integers out, always in software: truncation toward zero, saturation, and zero for a NaN.
    Assert(ToInt64(-7.9f80) == -7i64 && ToInt64(7.9f80) == 7i64, "truncation toward zero");
    Assert(ToInt32(1e10f80) == 2147483647i32 && ToInt32(-1e10f80) == -2147483648i32, "saturation at 32 bits");
    Assert(ToInt64(9223372036854775807.0f80) == 9223372036854775807i64, "int64::Max converts back exactly");
    Assert(ToInt64(1e30f80) == int64::Max && ToInt64(-1e30f80) == int64::Min, "and past it saturates");
    Assert(ToUint64(18446744073709551615.0f80) == uint64::Max, "uint64::Max converts back exactly");
    Assert(ToUint64(-1.5f80) == 0u64 && ToUint64(Infinity) == uint64::Max, "and an unsigned target saturates");
    Assert(ToUint8(255.9f80) == 255u8 && ToUint8(256.0f80) == 255u8, "at every width");
    Assert(ToInt128(1e30f80) == 1e30f80 as int128, "a value past 64 bits converts to a wide target");
    Assert(ToInt128(-1e39f80) == int128::Min, "and past its range saturates");
    Assert(ToInt64(NaN) == 0i64 && ToInt128(NaN) == 0i128 && ToUint8(NaN) == 0u8, "a NaN converts to zero");

    // Other floats in and out. float32 and float64 go through the x87 unit, the software widths through helpers.
    Assert(Same(FromFloat32(0.1f32), 0.1f32 as float80), "a float32 widens exactly");
    Assert(Same(FromFloat64(0.1), 0.1 as float80), "and so does a float64");
    Assert(FromFloat64(0.1) != Tenth, "which carries the float64's own tenth, not this one");
    Assert(ToFloat64(Tenth) == 0.1 && ToFloat32(Tenth) == 0.1f32, "narrowing rounds to the nearest");
    Assert(ToFloat64(Third) == Third as float64, "as the folded narrowing does");
    Assert(ToFloat64(float80::Max) == float64::Infinity, "past the float64 range narrows to the infinity");
    Assert(ToFloat64(HalfMinPositive) == 0.0, "and below it to zero");
    Assert(Same(FromFloat64(float64::Infinity), Infinity), "an infinity widens to the infinity");
    Assert(Same(FromFloat32(-0.0f32), NegativeZero), "and minus zero to minus zero");
    let widened = FromFloat64(float64::NaN);
    Assert(widened != widened, "and a NaN to a NaN");
    Assert(Same(FromFloat128(0.1f128), Tenth) && Same(FromFloat256(0.1f256), Tenth), "wider tenths round to this one");
    Assert(Same(FromFloat512(0.1f512), Tenth), "from every width");
    Assert(ToFloat128(Tenth) == 0.1f80 as float128 && Same(ToFloat128(Tenth) as float80, Tenth),
           "a float128 holds every float80");
    Assert(ToFloat128(Tenth) != 0.1f128, "though not the float128 tenth");
    Assert(Same(ToFloat256(Third) as float80, Third) && Same(ToFloat512(Third) as float80, Third), "nor do wider ones");
    Assert(Same(FromFloat128(float128::Max), Infinity), "past the float80 range narrows to the infinity");
    Assert(Same(FromFloat128(float128::MinPositive), float80::MinPositive), "the two share an exponent range");
    Assert(Same(FromFloat256(float256::MinPositive), Zero), "and far below it narrows to zero");
    Assert(Same(ToFloat128(HalfMinPositive) as float80, HalfMinPositive), "a subnormal float80 is normal in float128");
    let narrowed = ToFloat64(NaN);
    Assert(narrowed != narrowed && IsNan(FromFloat128(float128::NaN)), "a NaN stays a NaN");
    let wider = ToFloat128(NaN);
    Assert(wider != wider, "in both directions");
    Assert(ToFloat64(-Infinity) == -float64::Infinity, "and an infinity an infinity");
    Assert(Same(FromFloat64(-0.0), NegativeZero), "and minus zero minus zero");

    // Fields, arguments, returns and static data. The call's product is the one rounding here the optimizer cannot
    // fold, so a host whose x87 only approximates, as Prism on Windows on Arm does, defines ApproximateX87.
    when !#config.Has("ApproximateX87") {
        let sample = Sample { tag: 1i8, value: Tenth };
        let scaled = Scaled(sample, Third);
        Assert(scaled.tag == 2i8 && Same(scaled.value, TenthTimesThird), "a struct field passes through a call");
        var samples: Sample[2];
        samples[0] = sample;
        samples[1] = scaled;
        Assert(Same(samples[1].value, TenthTimesThird) && Same(samples[0].value, Tenth), "and through an array");
    }
    for i in 0..4 {
        Assert(Same(Multiply(Table[i], One), Table[i]), "a constant table keeps every element");
    }
    Assert(Same(Table[0], Tenth) && Same(Table[1], NegativeZero), "with its rounding and its sign");
    Assert(Same(Table[2], float80::Max) && Same(Table[3], Infinity), "and its limits");

    // Compound assignment runs the same operations as the folded chain.
    Assert(Same(Compound(One), Chained), "compound assignment");
    var accumulated = Zero;
    for i in 0..10 {
        accumulated += Tenth;
    }
    Assert(Same(accumulated, TenTenths), "a sum accumulated in a loop rounds at every step as the folded one does");
    Assert(accumulated != One, "so ten tenths are not one");
    return 0;
}
