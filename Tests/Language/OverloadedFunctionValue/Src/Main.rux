// An overloaded function named as a value, rather than called, is the overload whose type its destination expects:
// an annotated binding, an assignment, a function-typed parameter or a return type chooses it, for a plain name and
// a module path alike.
import Core::Assert;

func Scale(value: int32) -> int32 {
    return value * 2i32;
}

func Scale(value: int64) -> int64 {
    return value * 3;
}

module Ops {
    pub func Twice(value: int32) -> int32 {
        return value * 2i32;
    }

    pub func Twice(value: float64) -> float64 {
        return value * 2.0;
    }
}

func Same(value: int64) -> int64 {
    return value;
}

func Apply(f: func(int64) -> int64, value: int64) -> int64 {
    return f(value);
}

func Pick() -> func(int32) -> int32 {
    return Scale;
}

func Main() -> int {
    let narrow: func(int32) -> int32 = Scale;
    var wide: func(int64) -> int64 = Same;
    wide = Scale;
    Assert(narrow(5i32) == 10i32, "the int32 overload");
    Assert(wide(5) == 15, "the int64 overload");
    Assert(Apply(Scale, 7) == 21, "an argument's parameter type picks it");
    Assert(Pick()(4i32) == 8i32, "a return type picks it");
    let twice: func(float64) -> float64 = Ops::Twice;
    Assert(twice(1.5) == 3.0, "a module path picks it too");
    let twiceInt: func(int32) -> int32 = Ops::Twice;
    Assert(twiceInt(4i32) == 8i32, "the other module overload");
    Assert(Scale(2i32) == 4i32 && Scale(2i64) == 6, "calls are unchanged");
    return 0;
}
