import Core::Assert;

func Aliasing(first: *var int, second: *var int, input: int) -> int {
    *first = input;
    *second = 42;
    return *first;
}

func Choose(test: bool, pointer: *var int, a: int, b: int) -> int {
    let first = a + b;
    *pointer = first;
    if test { return (a + b) * first; }
    return (a + b) - first;
}

func Main() -> int {
    CheckGuardedLoops();
    var first = 0;
    var second = 0;
    for input in -30..30 {
        Assert(Aliasing(@first, @first, input) == 42, "an aliasing write invalidates forwarding");
        Assert(Aliasing(@first, @second, input) == input, "independent writes preserve the source");
        Assert(Choose(true, @first, input, 7) == (input + 7) * (input + 7), "dominated arithmetic");
        Assert(first == input + 7, "stores are retained");
        Assert(Choose(false, @first, input, 7) == 0, "sibling arithmetic");
        Assert(Repeated(input, 0) == (input < 0 ? 7 : 17), "repeated branch facts follow each path");
    }
    for value in 0u64..256u64 {
        let narrow = value as uint8;
        Assert(Masked(narrow) < 64u64, "masked values have a proven upper bound");
        Assert(Wrapped(narrow) == (value != 255u64), "uint8 addition wraps before comparison");
        Assert(Subtracted(narrow) == (value != 0u64), "uint8 subtraction wraps before comparison");
        Assert(SmallProduct(narrow), "widened multiplication has no overflow");
        Assert(Narrowed(value + 256u64) == (value != 255u64), "narrow casts retain modulo semantics");
    }
    Assert(!WideWrapped(18446744073709551615u64), "uint64 maximum wraps to zero");
    Assert(WideWrapped(0u64), "uint64 zero increments to one");
    var pair = BorrowedPair { first: 0, second: 0 };
    for amount in -20..21 { UpdatePair(pair, amount); }
    Assert(pair.first == 210 && pair.second == 210, "inlined void helper retains early-return edges");
    AliasPair(@pair, @pair);
    Assert(pair.first == 42 && pair.second == 42, "borrowed aggregate helper preserves aliases");
    return 0;
}

func GuardedWalk(limit: uint, row: uint, bound: uint, result: *var uint) -> uint {
    for i in 0u..limit {
        let index = row + i;
        if index < bound { *result += index; }
        else { return 123u; }
    }
    return *result;
}

func ReferenceWalk(limit: uint, row: uint, bound: uint, result: *var uint) -> uint {
    var remaining = limit;
    var index = row;
    while remaining != 0u {
        if index >= bound { return 123u; }
        *result += index;
        index += 1u;
        remaining -= 1u;
    }
    return *result;
}

func CheckGuardedLoops() {
    for limit in 0u..13u {
        for row in 0u..13u {
            for bound in 0u..13u {
                var actual = 7u;
                var expected = 7u;
                Assert(GuardedWalk(limit, row, bound, @actual) == ReferenceWalk(limit, row, bound, @expected),
                    "guarded traversal agrees with independent countdown loop");
                Assert(actual == expected, "guard failure preserves writes before an early exit");
            }
        }
    }
    let maximum = 18446744073709551615u;
    for row in [0u, maximum - 1u, maximum] {
        for limit in [0u, 1u, 2u, maximum] {
            var actual = 7u;
            var expected = 7u;
            let bound = row == 0u ? 2u : maximum;
            Assert(GuardedWalk(limit, row, bound, @actual) == ReferenceWalk(limit, row, bound, @expected),
                "maximum endpoints and wrapping offsets retain checked behavior");
            Assert(actual == expected, "extreme guard fallback preserves side effects");
        }
    }
}

struct BorrowedPair { first: int; second: int; }

func UpdatePair(value: &var BorrowedPair, amount: int) {
    if amount < 0 { value.first -= amount; return; }
    value.second += amount;
}

func AliasPair(first: *var BorrowedPair, second: *var BorrowedPair) {
    first.first = 7;
    second.first = 42;
    first.second = first.first;
}

func Masked(value: uint8) -> uint64 { return (value & 63u8) as uint64; }
func Wrapped(value: uint8) -> bool { return value + 1u8 > 0u8; }
func Subtracted(value: uint8) -> bool { return value - 1u8 < 255u8; }
func SmallProduct(value: uint8) -> bool { return (value as uint64) * 2u64 < 511u64; }
func Narrowed(value: uint64) -> bool { return (value as uint8) < 255u8; }
func WideWrapped(value: uint64) -> bool { return value + 1u64 > 0u64; }

func Repeated(a: int, b: int) -> int {
    if a < b {
        if a < b { return 7; }
        return 11;
    }
    if a < b { return 13; }
    return 17;
}
