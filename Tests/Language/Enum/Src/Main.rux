import Core::Assert;

enum Direction {
    North = 10,
    South = 20,
    East = 30,
    West = 40
}

enum Color: uint8 {
    Red = 0,
    Green = 10,
    Blue = 20
}

// A tag is stored at the enum's declared width, so a match has to read it back
// at that width. Reading it as a full word instead picked up whatever sat
// beside it, and the mask that cleared those bits was itself 32 bits wide, so
// matching an enum based on a narrower type used to select no arm at all.
enum Narrow: int8 {
    Low = 0,
    High = 1
}

enum Ordering: int8 {
    Less = -1,
    Equal = 0,
    Greater = 1
}

enum Halfword: int16 {
    Low = 0,
    High = 1
}

func Classify(value: int32) -> Ordering {
    if value < 0 {
        return Ordering::Less;
    }
    if value > 0 {
        return Ordering::Greater;
    }
    return Ordering::Equal;
}

func IdentityDirection(direction: Direction) -> Direction {
    return direction;
}

func DecodeDirection(value: int) -> Direction {
    return value as Direction;
}

func EncodeDirection(value: Direction) -> int {
    return value as int;
}

func Main() -> int {
    Assert(IdentityDirection(Direction::North) == Direction::North,
           "Expected enum argument and return types to match");
    Assert(EncodeDirection(Direction::East) == 30, "Expected an enum to expose its scalar representation explicitly");
    Assert(DecodeDirection(40) == Direction::West, "Expected an integer to decode through an explicit enum cast");
    Assert(Direction::North < Direction::South, "Expected scalar enum ordering to follow discriminants");
    Assert((Color::Green as uint8) == 10u8, "Expected a narrow enum cast to retain its declared width");
    Assert((-1i8 as Ordering) == Ordering::Less, "Expected signed enum casts to retain negative discriminants");
    let fallback = match 7 {
        0 => 1,
        else => 2
    };
    Assert(fallback == 2, "Expected the else match arm");

    // A tag narrower than a word still selects the right arm.
    let narrow = Narrow::High;
    Assert((match narrow { .Low => 10, .High => 20 }) == 20, "Expected an int8 tag to match its arm");
    let halfword = Halfword::High;
    Assert((match halfword { .Low => 10, .High => 20 }) == 20, "Expected an int16 tag to match its arm");
    let byteColor = Color::Green;
    Assert((match byteColor { .Red => 1, .Green => 2, .Blue => 3 }) == 2, "Expected a uint8 tag to match its arm");

    // Negative discriminants survive being read back and compared.
    Assert((match Classify(-5) { .Less => 1, .Equal => 2, .Greater => 3 }) == 1,
           "Expected a negative discriminant to match its arm");
    Assert((match Classify(0) { .Less => 1, .Equal => 2, .Greater => 3 }) == 2,
           "Expected a zero discriminant to match its arm");
    Assert((match Classify(5) { .Less => 1, .Equal => 2, .Greater => 3 }) == 3,
           "Expected a positive discriminant to match its arm");

    // The tag is unaffected by a neighbouring local, which is what a full-width
    // read used to pick up.
    let before: int64 = -1i64;
    let neighbour = Narrow::Low;
    let after: int64 = -1i64;
    Assert((match neighbour { .Low => 10, .High => 20 }) == 10, "Expected a tag to ignore its neighbours");
    Assert(before == -1i64 && after == -1i64, "Expected the neighbours themselves to be intact");

    return 0;
}
