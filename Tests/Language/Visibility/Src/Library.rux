// Package-private declarations remain available from every source file in the
// same package.
struct PackageCounter {
    value: int;
}

extend PackageCounter {
    func PackageCounter(value: int) -> PackageCounter {
        return PackageCounter { value: value };
    }

    func Read(self: &PackageCounter) -> int {
        return self.value;
    }
}

func MakePackageCounter(value: int) -> PackageCounter {
    return PackageCounter(value);
}

// Public declarations still choose their public members individually.
pub struct PublicCounter {
    pub value: int;
    hidden: int;
}

extend PublicCounter {
    pub func PublicCounter(value: int) -> PublicCounter {
        return PublicCounter { value: value, hidden: 1 };
    }

    pub func Zero() -> PublicCounter {
        return PublicCounter(0);
    }

    pub func Read(self: &PublicCounter) -> int {
        return self.value + self.hidden;
    }

    pub func +(self: &PublicCounter, other: PublicCounter) -> PublicCounter {
        return PublicCounter(self.value + other.value);
    }
}

pub union PublicBits {
    pub signed: int32,
    raw: uint32
}

// `pub` on the remaining declaration kinds. A type being public does not make its members public, and a member
// being public does not make its type public: each declaration chooses for itself.
pub enum Level: int32 {
    Low = 1,
    High = 2
}

pub variant Reading {
    Absent,
    Present(int32)
}

pub const Ceiling: int32 = 99i32;

pub type Measure = int32;

pub interface Readable {
    func Value(self: &Self) -> int32;
}

extend PublicCounter : Readable {
    pub func Value(self: &PublicCounter) -> int32 {
        return self.value as int32;
    }
}

// A public function returning a package-private type is still callable from this package; what it returns simply
// cannot be named outside it.
pub func LevelOf(reading: &Reading) -> Level {
    return match reading {
        .Absent => Level::Low,
        .Present(value) => value > Ceiling ? Level::High : Level::Low
    };
}
