// This native ABI fixture provides its own literal view declaration.
intrinsic struct string8 { pub data: *char8; pub length: uint; }

#Link("libc.so.7")
extern {
    func dlopen(path: *char8, mode: int32) -> *opaque;
    func dlsym(handle: *opaque, symbol: *char8) -> *opaque;
    func dlclose(handle: *opaque) -> int32;
}

func Main() -> int {
    let library = dlopen("./libFreeBSDAArch64Fixture.so".data, 2);
    if library == null { return 1; }

    let address = dlsym(library, "Answer".data);
    if address == null {
        dlclose(library);
        return 2;
    }

    let answer = address as func() -> int;
    let result = answer();
    if dlclose(library) != 0 { return 3; }
    return result == 42 ? 0 : 4;
}
