// This native ABI fixture provides its own literal view declaration.

#Link("libc.so.7")
extern {
    func strlen(text: *char8) -> uint;
    func printf(format: *char8, ...) -> int32;
}

func Main() -> int {
    // Safety: the argument is a NUL-terminated string literal.
    if unsafe { strlen("fixed-call".data) } != 10u { return 1; }

    // Safety: the format is a NUL-terminated literal whose two conversions match the `int` and `double` passed.
    let written = unsafe { printf("freebsd-aarch64:%d:%.1f\n".data, 42, 2.5) };
    return if written == 23 { 0 } else { 2 };
}
