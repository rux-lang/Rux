// Ready-made hash and equality callbacks for the key types a table is usually keyed on.
//
// A table takes its hash as a function rather than through an interface, because Rux has no closures and an
// interface value would have to be stored and dispatched through per lookup. The signature carries the table's seed
// alongside the key, which is what makes the hashing randomized: two tables in one program hash the same key
// differently, and neither is predictable to anyone who has not seen the seed.
//
// Every hash here is `SipHash`, which is the one in `Rux/Hash` designed for exactly this. An adversary who chooses
// keys can find collisions in any of the others by hand, and a table full of colliding keys is a table whose every
// lookup is a linear scan -- a denial of service against anything keyed on input it did not write. `SipHash` makes
// finding those collisions as hard as guessing the seed.
//
// A caller keying on a type not listed here writes the pair itself: a hash that reads the whole key and mixes the
// seed in, and an equality that agrees with it. The one rule is the usual one -- two keys that compare equal must
// hash the same.

import Hash::{ SipHash24, SipHash24Of, WriteUint64 };

/// The seeded hash of a `uint`.
///
/// `value`, `low` and `high` are read by value. The seed is the table's, and two tables with different seeds hash
/// the same value differently.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/collections/hash-uint
func HashUint(value: uint, low: uint64, high: uint64) -> uint64 {
    var hasher = SipHash24::WithKey(low, high);
    WriteUint64<SipHash24>(@hasher, value as uint64);
    return hasher.Finish();
}

/// The seeded hash of a `uint64`.
///
/// https://rux-lang.dev/docs/api/collections/hash-uint64
func HashUint64(value: uint64, low: uint64, high: uint64) -> uint64 {
    var hasher = SipHash24::WithKey(low, high);
    WriteUint64<SipHash24>(@hasher, value);
    return hasher.Finish();
}

/// The seeded hash of a `uint32`.
///
/// https://rux-lang.dev/docs/api/collections/hash-uint32
func HashUint32(value: uint32, low: uint64, high: uint64) -> uint64 {
    var hasher = SipHash24::WithKey(low, high);
    WriteUint64<SipHash24>(@hasher, value as uint64);
    return hasher.Finish();
}

/// The seeded hash of an `int64`.
///
/// https://rux-lang.dev/docs/api/collections/hash-int64
func HashInt64(value: int64, low: uint64, high: uint64) -> uint64 {
    var hasher = SipHash24::WithKey(low, high);
    WriteUint64<SipHash24>(@hasher, value as uint64);
    return hasher.Finish();
}

/// The seeded hash of an `int32`.
///
/// https://rux-lang.dev/docs/api/collections/hash-int32
func HashInt32(value: int32, low: uint64, high: uint64) -> uint64 {
    var hasher = SipHash24::WithKey(low, high);
    WriteUint64<SipHash24>(@hasher, (value as int64) as uint64);
    return hasher.Finish();
}

/// The seeded hash of a `char8`.
///
/// https://rux-lang.dev/docs/api/collections/hash-char8
func HashChar8(value: char8, low: uint64, high: uint64) -> uint64 {
    var hasher = SipHash24::WithKey(low, high);
    WriteUint64<SipHash24>(@hasher, (value as uint8) as uint64);
    return hasher.Finish();
}

/// The seeded hash of a run of characters, which is what a string key comes to.
///
/// `text` is borrowed and read. Two slices holding the same characters hash the same however they were built, which
/// is what makes a text key usable at all.
///
/// Runs in time proportional to the length and allocates nothing.
///
/// https://rux-lang.dev/docs/api/collections/hash-slice
func HashSlice(text: Slice<char8>, low: uint64, high: uint64) -> uint64 {
    return SipHash24Of(text.data as *byte, text.length, low, high);
}

/// Whether two `uint` keys are the same.
///
/// https://rux-lang.dev/docs/api/collections/equals-uint
func EqualsUint(left: uint, right: uint) -> bool {
    return left == right;
}

/// Whether two `uint64` keys are the same.
///
/// https://rux-lang.dev/docs/api/collections/equals-uint64
func EqualsUint64(left: uint64, right: uint64) -> bool {
    return left == right;
}

/// Whether two `uint32` keys are the same.
///
/// https://rux-lang.dev/docs/api/collections/equals-uint32
func EqualsUint32(left: uint32, right: uint32) -> bool {
    return left == right;
}

/// Whether two `int64` keys are the same.
///
/// https://rux-lang.dev/docs/api/collections/equals-int64
func EqualsInt64(left: int64, right: int64) -> bool {
    return left == right;
}

/// Whether two `int32` keys are the same.
///
/// https://rux-lang.dev/docs/api/collections/equals-int32
func EqualsInt32(left: int32, right: int32) -> bool {
    return left == right;
}

/// Whether two `char8` keys are the same.
///
/// https://rux-lang.dev/docs/api/collections/equals-char8
func EqualsChar8(left: char8, right: char8) -> bool {
    return left == right;
}

/// Whether two runs of characters hold the same characters.
///
/// Both are borrowed and read. Different lengths are never equal, and two empty slices are, whatever their data
/// pointers hold.
///
/// https://rux-lang.dev/docs/api/collections/equals-slice
func EqualsSlice(left: Slice<char8>, right: Slice<char8>) -> bool {
    if left.length != right.length {
        return false;
    }
    var index: uint = 0;
    while index < left.length {
        if left.data[index] != right.data[index] {
            return false;
        }
        index++;
    }
    return true;
}
