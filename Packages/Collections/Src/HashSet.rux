// A set of distinct values, in no particular order, with constant expected time for everything.
//
// The same `Table` kernel as `HashMap`, with nothing stored alongside each key. A set is a map whose values carry no
// information, and saying so in the type rather than duplicating the probing is what keeps the two in step: a fix to
// the displacement or the deletion is a fix to both.
//
// The hash and equality are supplied for the same reason they are there, and the seed is drawn the same way.
//
// A set owns its elements, so it prohibits copying and is move-only.

import Allocator::Allocator;
import Core::{ Iterator, Option, Unit };

/// A hash table of distinct values.
///
/// Move-only: it owns its elements and its storage.
///
/// https://rux-lang.dev/docs/api/collections/hash-set
struct HashSet<T> {
    /// The slots and the elements. The value side carries nothing, which is what makes this a set.
    table: Table<T, Unit>;
    /// What an element's hash is, given the table's seed.
    hash: func(T, uint64, uint64) -> uint64;
    /// Whether two elements are the same element.
    equals: func(T, T) -> bool;
}

extend HashSet<T> {
    /// Copying a set would give two owners of its table and elements.
    func =(self: &var HashSet<T>, other: &HashSet<T>);

    /// An empty set that has not allocated anything, with a seed drawn from the operating system.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/new
    func HashSet(allocator: Allocator, hash: func(T, uint64, uint64) -> uint64,
                 equals: func(T, T) -> bool) -> HashSet<T> {
        return HashSet::WithSeed<T>(allocator, TableSeed::Random(), hash, equals);
    }

    /// An empty set that has not allocated anything, hashing with `seed`.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/with-seed
    func WithSeed(allocator: Allocator, seed: TableSeed, hash: func(T, uint64, uint64) -> uint64,
                  equals: func(T, T) -> bool) -> HashSet<T> {
        return HashSet<T> { table: Table<T, Unit>(allocator, seed), hash: hash, equals: equals };
    }

    /// An empty set with room for `capacity` elements already taken.
    ///
    /// `error` is written with why the room could not be taken.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/with-capacity
    func WithCapacity(allocator: Allocator, capacity: uint, hash: func(T, uint64, uint64) -> uint64,
                      equals: func(T, T) -> bool, error: *var CollectionError) -> HashSet<T> {
        var set = HashSet<T>(allocator, hash, equals);
        *error = set.Reserve(capacity);
        return <-set;
    }

    /// How many elements the set holds.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/length
    func Length(self: &HashSet<T>) -> uint {
        return self.table.Length();
    }

    /// How many slots the table has.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/capacity
    func Capacity(self: &HashSet<T>) -> uint {
        return self.table.Capacity();
    }

    /// Whether the set holds no elements.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/is-empty
    func IsEmpty(self: &HashSet<T>) -> bool {
        return self.table.IsEmpty();
    }

    /// Whether `value` is in the set.
    ///
    /// `self` is borrowed; `value` is read by value.
    ///
    /// Runs in constant expected time and allocates nothing.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/contains
    func Contains(self: &HashSet<T>, value: T) -> bool {
        return self.table.Find(value, self.hash, self.equals).IsSome();
    }

    /// Adds `value` to the set, reporting whether it was not already there.
    ///
    /// `self` is borrowed mutably; `value` is moved in when it is added and destroyed when it was already present --
    /// a set holds one of each, and the one it already had is the one it keeps. `added` receives whether the set
    /// grew, and may be null.
    ///
    /// A failure leaves the set exactly as it was.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/insert
    func Insert(self: &var HashSet<T>, value: T, added: *var bool) -> CollectionError {
        if self.table.Find(value, self.hash, self.equals).IsSome() {
            if added != null {
                *added = false;
            }
            return CollectionError::None;
        }

        let room = self.table.EnsureRoom(self.hash);
        if room.IsError() {
            return room;
        }
        // Named first: a struct literal cannot appear inside an `if` condition, since its brace opens the body.
        let nothing = Unit {};
        if self.table.Place(<-value, nothing, self.hash).IsNone() {
            return CollectionError::Unsupported;
        }
        if added != null {
            *added = true;
        }
        return CollectionError::None;
    }

    /// Takes `value` out of the set and hands it back.
    ///
    /// `self` is borrowed mutably. The element is moved out rather than destroyed, so one that owns something leaves
    /// intact. Reports `None` when the set did not have it.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/remove
    func Remove(self: &var HashSet<T>, value: T) -> Option<T> {
        var slot: uint = 0;
        if !self.table.Find(value, self.hash, self.equals).TryIntoValue(@slot) {
            return Option::None<T>();
        }
        let taken = self.table.keys[slot];
        self.table.Vacate(slot);
        return Option::Some<T>(<-taken);
    }

    /// Makes room for `additional` more elements on top of those already present.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/reserve
    func Reserve(self: &var HashSet<T>, additional: uint) -> CollectionError {
        return self.table.Reserve(additional, self.hash);
    }

    /// Releases the capacity the element count does not need.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/shrink-to-fit
    func ShrinkToFit(self: &var HashSet<T>) -> CollectionError {
        return self.table.ShrinkToFit(self.hash);
    }

    /// Destroys every element, keeping the storage.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/clear
    func Clear(self: &var HashSet<T>) {
        self.table.Clear();
    }

    /// Walks to the next occupied slot at or after `cursor`, reporting the element it holds.
    ///
    /// `self` is borrowed; `cursor` is read and advanced past whatever is reported. The order is the table's, which
    /// is the seed's and not the insertion's, and nothing may be inserted or removed while a walk is in progress.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/try-next
    func TryNext(self: &HashSet<T>, cursor: *var uint, value: *var T) -> bool {
        var index = *cursor;
        while index < self.table.Capacity() {
            if self.table.IsOccupied(index) {
                if value != null {
                    *value = self.table.keys[index];
                }
                *cursor = index + 1;
                return true;
            }
            index++;
        }
        *cursor = index;
        return false;
    }
}

/// An iterator over the elements of a set, by copy.
///
/// Borrows the set, so the set must outlive it and must not be inserted into or removed from while it is alive.
///
/// https://rux-lang.dev/docs/api/collections/hash-set-iterator
struct HashSetIterator<T> {
    /// Raw borrowed table storage. Kept raw because references cannot be fields.
    keys: *T;
    states: *uint8;
    capacity: uint;
    /// The slot to look at next.
    cursor: uint;
}

extend HashSetIterator<T> {
    /// The next element, or `None` once every slot has been looked at.
    ///
    /// `self` is borrowed mutably and advanced. The element is a copy; a set of things that own something is walked
    /// with `TryNext` instead.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set-iterator/next
    func Next(self: &var HashSetIterator<T>) -> Option<T> {
        var index = self.cursor;
        while index < self.capacity {
            if self.states[index] != SlotEmpty {
                self.cursor = index + 1;
                return Option::Some<T>(self.keys[index]);
            }
            index++;
        }
        self.cursor = index;
        return Option::None<T>();
    }
}

extend HashSetIterator<T> : Iterator {}

/// An iterator that takes a set apart, yielding each element by value.
///
/// Move-only: it owns the storage the set owned. Whatever is left when its life ends is destroyed with it.
///
/// https://rux-lang.dev/docs/api/collections/hash-set-into-iterator
struct HashSetIntoIterator<T> {
    /// The table taken from the set.
    table: Table<T, Unit>;
    /// The slot to look at next.
    cursor: uint;
}

extend HashSetIntoIterator<T> {
    /// Copying a consuming iterator would give two owners of its table.
    func =(self: &var HashSetIntoIterator<T>, other: &HashSetIntoIterator<T>);

    /// The next element, moved out, or `None` once every slot has been looked at.
    ///
    /// `self` is borrowed mutably and advanced. The slot is emptied as the element leaves, so what remains for the
    /// destructor is exactly what nobody took.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set-into-iterator/next
    func Next(self: &var HashSetIntoIterator<T>) -> Option<T> {
        var index = self.cursor;
        while index < self.table.Capacity() {
            if self.table.IsOccupied(index) {
                let taken = self.table.keys[index];
                self.table.states[index] = SlotEmpty;
                self.table.length = self.table.length - 1;
                self.cursor = index + 1;
                return Option::Some<T>(<-taken);
            }
            index++;
        }
        self.cursor = index;
        return Option::None<T>();
    }
}

extend HashSetIntoIterator<T> : Iterator {}

extend HashSet<T> {
    /// An iterator over the elements, by copy.
    ///
    /// `self` is borrowed and must outlive the iterator. This is the method a `for` loop finds. The order is the
    /// table's, which is the seed's.
    ///
    /// # Safety
    ///
    /// Nothing may be inserted or removed while the iterator is alive.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/iterate
    func Iterate(self: &HashSet<T>) -> HashSetIterator<T> {
        return HashSetIterator<T> {
            keys: self.table.keys,
            states: self.table.states,
            capacity: self.table.capacity,
            cursor: 0
        };
    }

    /// Takes the set apart into an iterator over its elements.
    ///
    /// Consumes the set: it is moved into the iterator, and the storage goes with it. Whatever is not taken is
    /// destroyed when the iterator's life ends.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/into-iterator
    func IntoIterator(self: HashSet<T>) -> HashSetIntoIterator<T> {
        var set <- self;
        let taken = HashSetIntoIterator<T> {
            table: Table<T, Unit> {
                keys: set.table.keys,
                values: set.table.values,
                states: set.table.states,
                length: set.table.length,
                capacity: set.table.capacity,
                seed: set.table.seed,
                allocator: set.table.allocator
            },
            cursor: 0
        };
        set.table.keys = null;
        set.table.values = null;
        set.table.states = null;
        set.table.length = 0;
        set.table.capacity = 0;
        return <-taken;
    }
}

extend HashSet<T> {
    /// Whether every element of this set is also in `other`.
    ///
    /// Both are borrowed. A set is a subset of itself, and the empty set is a subset of everything -- there is no
    /// element of it to be missing.
    ///
    /// `other` is asked about each of this set's elements, so it decides identity: two sets with different hashes
    /// for the same values would disagree, which is a caller error rather than something checkable here.
    ///
    /// Allocates nothing. Runs in time proportional to this set's size.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/is-subset-of
    func IsSubsetOf(self: &HashSet<T>, other: &HashSet<T>) -> bool {
        if self.Length() > other.Length() {
            return false;
        }
        var walker = self.Iterate();
        var walking = true;
        while walking {
            match walker.Next() {
                .Some(value) => {
                    if !other.Contains(value) {
                        return false;
                    }
                },
                .None => {
                    walking = false;
                }
            }
        }
        return true;
    }

    /// Whether every element of `other` is also in this set.
    ///
    /// Both are borrowed. The mirror of `IsSubsetOf`, which is what it calls.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/is-superset-of
    func IsSupersetOf(self: &HashSet<T>, other: &HashSet<T>) -> bool {
        return other.IsSubsetOf(self);
    }

    /// Whether the two sets have no element in common.
    ///
    /// Both are borrowed. Two empty sets are disjoint, and so is any set with an empty one.
    ///
    /// Walks the smaller of the two, since an element of either that is in both would be found from whichever side
    /// it is looked for.
    ///
    /// Allocates nothing.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/is-disjoint-from
    func IsDisjointFrom(self: &HashSet<T>, other: &HashSet<T>) -> bool {
        if self.Length() > other.Length() {
            return other.IsDisjointFrom(self);
        }
        if self.Length() == 0 {
            return true;
        }
        var walker = self.Iterate();
        var walking = true;
        while walking {
            match walker.Next() {
                .Some(value) => {
                    if other.Contains(value) {
                        return false;
                    }
                },
                .None => {
                    walking = false;
                }
            }
        }
        return true;
    }

    /// Whether the two sets hold exactly the same elements.
    ///
    /// Both are borrowed. Equal sizes and one containment, which together are containment both ways.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/equals
    func Equals(self: &HashSet<T>, other: &HashSet<T>) -> bool {
        return self.Length() == other.Length() && self.IsSubsetOf(other);
    }
}

extend HashSet<T> {
    /// Adds every element of `other` that this set does not already have.
    ///
    /// `self` is borrowed mutably; `other` is borrowed and left alone. Elements are copied out of `other`, which is
    /// what makes this usable only where copying an element means what it says.
    ///
    /// Room for the worst case is taken first, so this either adds every element or none: a failure part-way would
    /// leave a set that is neither what it was nor the union, and there is nothing useful a caller could do with
    /// that. Reserving more than it needs is the price, and it is given back by `ShrinkToFit`.
    ///
    /// Runs in time proportional to `other`.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/union-with
    func UnionWith(self: &var HashSet<T>, other: &HashSet<T>) -> CollectionError {
        if other.Length() == 0 {
            return CollectionError::None;
        }
        let room = self.Reserve(other.Length());
        if room.IsError() {
            return room;
        }

        var walker = other.Iterate();
        var walking = true;
        var added = false;
        while walking {
            match walker.Next() {
                .Some(value) => {
                    let error = self.Insert(value, @added);
                    if error.IsError() {
                        return error;
                    }
                },
                .None => {
                    walking = false;
                }
            }
        }
        return CollectionError::None;
    }

    /// Removes every element this set has that `other` does not.
    ///
    /// `self` is borrowed mutably; `other` is borrowed and left alone. Whatever leaves is destroyed, since nobody
    /// asked for it back.
    ///
    /// Allocates nothing, so it cannot fail: a set only ever gets smaller here.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/intersect-with
    func IntersectWith(self: &var HashSet<T>, other: &HashSet<T>) {
        if self.Length() == 0 {
            return;
        }
        // Removing shifts the entries that follow a slot back into it, and a chain that runs past the end of the
        // table shifts them past the end too -- so no single sweep in either direction can be sure it looked at
        // everything, and which entries move depends on where the seed happened to put them. Staying on a slot that
        // was just emptied covers what shifted into it, and a whole sweep that removes nothing is the proof that
        // there is nothing left to remove.
        var sweeping = true;
        while sweeping {
            sweeping = false;
            var index: uint = 0;
            while index < self.table.Capacity() {
                if self.table.IsOccupied(index) && !other.Contains(self.table.keys[index]) {
                    let taken = self.table.keys[index];
                    self.table.Vacate(index);
                    sweeping = true;
                }
                else {
                    index = index + 1;
                }
            }
        }
    }

    /// Removes every element this set has that `other` also has.
    ///
    /// `self` is borrowed mutably; `other` is borrowed and left alone. Whatever leaves is destroyed.
    ///
    /// Allocates nothing, so it cannot fail.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/subtract
    func Subtract(self: &var HashSet<T>, other: &HashSet<T>) {
        if self.Length() == 0 || other.Length() == 0 {
            return;
        }
        // Swept the way `IntersectWith` is, and for the same reason.
        var sweeping = true;
        while sweeping {
            sweeping = false;
            var index: uint = 0;
            while index < self.table.Capacity() {
                if self.table.IsOccupied(index) && other.Contains(self.table.keys[index]) {
                    let taken = self.table.keys[index];
                    self.table.Vacate(index);
                    sweeping = true;
                }
                else {
                    index = index + 1;
                }
            }
        }
    }

    /// Keeps the elements that are in exactly one of the two sets.
    ///
    /// `self` is borrowed mutably; `other` is borrowed and left alone. Elements shared by both leave and are
    /// destroyed; elements only `other` has are copied in.
    ///
    /// Room for the worst case is taken first, for the same reason `UnionWith` takes it: a failure part-way would
    /// leave a set that is neither operand nor the answer.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/symmetric-difference-with
    func SymmetricDifferenceWith(self: &var HashSet<T>, other: &HashSet<T>) -> CollectionError {
        if other.Length() == 0 {
            return CollectionError::None;
        }
        let room = self.Reserve(other.Length());
        if room.IsError() {
            return room;
        }

        var walker = other.Iterate();
        var walking = true;
        var added = false;
        while walking {
            match walker.Next() {
                .Some(value) => {
                    var slot: uint = 0;
                    if self.table.Find(value, self.hash, self.equals).TryIntoValue(@slot) {
                        let taken = self.table.keys[slot];
                        self.table.Vacate(slot);
                    }
                    else {
                        let error = self.Insert(value, @added);
                        if error.IsError() {
                            return error;
                        }
                    }
                },
                .None => {
                    walking = false;
                }
            }
        }
        return CollectionError::None;
    }

    /// An independent set holding a copy of every element of this one.
    ///
    /// `self` is borrowed and left alone; `error` is written with why the copy could not be made. The copy has its
    /// own storage from the same allocator and the same seed, so the two lay their elements out alike.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-set/clone
    func Clone(self: &HashSet<T>, error: *var CollectionError) -> HashSet<T> {
        var copy = HashSet::WithSeed<T>(self.table.allocator, self.table.seed, self.hash, self.equals);
        let room = copy.Reserve(self.Length());
        if room.IsError() {
            *error = room;
            return <-copy;
        }
        var walker = self.Iterate();
        var walking = true;
        var added = false;
        while walking {
            match walker.Next() {
                .Some(value) => {
                    let failure = copy.Insert(value, @added);
                    if failure.IsError() {
                        *error = failure;
                        return <-copy;
                    }
                },
                .None => {
                    walking = false;
                }
            }
        }
        *error = CollectionError::None;
        return <-copy;
    }
}
