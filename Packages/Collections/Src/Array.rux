import Core::MutableSlice;
import Memory::{ Alloc, Copy, Free };

// A fixed-length collection owning one contiguous heap allocation. The length
// is decided at construction and never changes; reach for Vector when elements
// must be appended or removed.
//
// Rux names a run of elements four ways, and this is the one that owns heap
// storage whose length is a run-time value:
//
//   T[N]             a built-in array, length fixed at compile time
//   Slice<T>         a borrowed read-only view, owning nothing
//   MutableSlice<T>  a borrowed writable view, owning nothing
//   Array<T>         this: owned heap storage, run-time length
//
// Ownership is manual, because Rux has no destructors and no move semantics.
// Assignment copies the Array value and therefore shares its allocation, so
// Clone when both copies must be freed, and Free exactly once for every
// allocation. Clone copies element bytes verbatim: an element that owns a
// resource ends up referenced by both copies, and releasing it stays the
// element owner's job.
//
// Every fallible operation reports a CollectionError and leaves the receiver
// unchanged unless it returns None. A constructor's `result` out-parameter is
// written only on None, and must not be null.
struct Array<T> {
    data: *var T;
    length: uint;
}

extend Array<T> {
    // The empty Array. Owns nothing, allocates nothing, and is safe to Free.
    func New() -> Array<T> {
        return Array<T> { data: null, length: 0 };
    }

    // An Array of `length` elements whose contents are whatever the allocator
    // returned. Every element must be written before it is read. A zero length
    // yields the empty Array without allocating.
    func NewUninitialized(length: uint, result: *var Array<T>) -> CollectionError {
        if length == 0 {
            *result = Array<T> { data: null, length: 0 };
            return CollectionError::None;
        }

        var bytes: uint = 0;
        let sizing = ByteSize(length, sizeof(T), @bytes);
        if !(sizing == CollectionError::None) {
            return sizing;
        }

        let ptr = Alloc(bytes) as *var T;
        if ptr == null {
            return CollectionError::OutOfMemory;
        }

        *result = Array<T> { data: ptr, length: length };
        return CollectionError::None;
    }

    // Copies a slice into an independently owned Array, leaving the source
    // untouched.
    func FromSlice(items: Slice<T>, result: *var Array<T>) -> CollectionError {
        if items.length == 0 {
            *result = Array<T> { data: null, length: 0 };
            return CollectionError::None;
        }

        var bytes: uint = 0;
        let sizing = ByteSize(items.length, sizeof(T), @bytes);
        if !(sizing == CollectionError::None) {
            return sizing;
        }

        let ptr = Alloc(bytes) as *var T;
        if ptr == null {
            return CollectionError::OutOfMemory;
        }

        Copy(ptr, items.data, bytes);
        *result = Array<T> { data: ptr, length: items.length };
        return CollectionError::None;
    }

    // An independent copy of this Array's storage. Element values are copied
    // byte for byte, so allocations owned by individual elements are shared
    // with the original rather than duplicated.
    func Clone(self: *Array<T>, result: *var Array<T>) -> CollectionError {
        if self.length == 0 {
            *result = Array<T> { data: null, length: 0 };
            return CollectionError::None;
        }

        var bytes: uint = 0;
        let sizing = ByteSize(self.length, sizeof(T), @bytes);
        if !(sizing == CollectionError::None) {
            return sizing;
        }

        let ptr = Alloc(bytes) as *var T;
        if ptr == null {
            return CollectionError::OutOfMemory;
        }

        Copy(ptr, self.data, bytes);
        *result = Array<T> { data: ptr, length: self.length };
        return CollectionError::None;
    }

    // Releases the allocation and leaves the empty Array behind, so calling
    // Free again is a no-op. Every pointer and view into this Array is
    // invalidated.
    func Free(self: *var Array<T>) {
        Free(self.data);
        self.data = null;
        self.length = 0;
    }

    // The owned allocation, read-only. Valid until Free.
    func Data(self: *Array<T>) -> *T {
        return self.data;
    }

    // The owned allocation, writable. Valid until Free.
    func MutableData(self: *var Array<T>) -> *var T {
        return self.data;
    }

    // The fixed number of elements. Never changes for the life of the Array.
    func Length(self: *Array<T>) -> uint {
        return self.length;
    }

    func IsEmpty(self: *Array<T>) -> bool {
        return self.length == 0;
    }

    // The element at `index`. Unchecked, like pointer and slice indexing:
    // an index at or past Length is undefined behavior, not a reported error.
    // TryGet is the checked form.
    func At(self: *Array<T>, index: uint) -> T {
        return self.data[index];
    }

    // Reads the element at `index`, reporting whether the index was in range.
    // On a rejected index `value` is left untouched, so a caller may seed it
    // with a fallback. A null `value` reports failure rather than reading.
    func TryGet(self: *Array<T>, index: uint, value: *var T) -> bool {
        if value == null || index >= self.length {
            return false;
        }

        *value = self.data[index];
        return true;
    }

    // Replaces the element at `index`. Unchecked, as in At.
    func Set(self: *var Array<T>, index: uint, value: T) {
        self.data[index] = value;
    }

    // Replaces the element at `index`, reporting whether the index was in
    // range. A rejected index writes nothing.
    func TrySet(self: *var Array<T>, index: uint, value: T) -> bool {
        if index >= self.length {
            return false;
        }

        self.data[index] = value;
        return true;
    }

    // Borrows every element read-only, without copying. The view must not
    // outlive this Array's allocation; nothing enforces that.
    func AsSlice(self: *Array<T>) -> Slice<T> {
        return Slice<T> { data: self.data, length: self.length };
    }

    // Borrows every element writably, without copying. Takes a writable
    // receiver because it hands out the ability to write. Like AsSlice, the
    // view must not outlive the allocation, and Free invalidates it.
    func AsMutableSlice(self: *var Array<T>) -> MutableSlice<T> {
        return MutableSlice<T> { data: self.data, length: self.length };
    }
}
