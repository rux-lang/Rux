// Walking a run of contiguous elements, which every container in this package can hand out a view of.
//
// The compiler drives a `for` loop by shape: anything with a `Next` returning an `Option` is an iterator, and the
// item type is whatever that option carries. That leaves the choice of item to the iterator, and there are three
// worth having.
//
// `ValueIterator` yields elements by copy, which is what reading a sequence of numbers wants and what a move-only
// element type must not be walked with -- copying one would give two owners to a value that promises one.
// `ReferenceIterator` yields a pointer to each element, which works for any element type at all and is how a
// move-only one is read without being moved.
//
// There is no iterator yielding a writable pointer, though the shape is obvious and the use is real. A generic
// iterator whose `Next` reports `Option<*var T>` does not survive lowering: the instantiation is named one way where
// its layout is recorded and another where it is looked up, and the two disagree over whether the pointee's `var`
// is part of the name. Until that is fixed, changing elements while walking is done by asking the container for a
// `MutableSlice<T>` and indexing it, which is what `Rux/Algorithms` does throughout. See Docs/CompilerDefects.md.
//
// Both borrow. Neither owns the storage it walks, and neither may outlive the container it came from or survive that
// container growing, rehashing or being freed -- which is the one thing about iteration in this package worth
// remembering.
//
// A consuming iterator, which moves elements out of a container and leaves it empty, belongs to the container that
// can be emptied rather than here.

import Core::{ Iterator, Option };

/// An iterator that yields each element of a run by copy.
///
/// The element type must be copyable: a move-only element yielded by value would leave the container holding
/// something it no longer owns. Use `ReferenceIterator` for those.
///
/// https://rux-lang.dev/docs/api/collections/value-iterator
pub struct ValueIterator<T> {
    /// The run being walked. Borrowed, never owned.
    data: *T;
    /// How many elements it holds.
    length: uint;
    /// How many have been yielded.
    position: uint;
}

extend ValueIterator<T> {
    /// An iterator over `items`, positioned before the first element.
    ///
    /// `items` is borrowed and must outlive the iterator.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// # Safety
    ///
    /// The storage must not be grown, freed or otherwise moved while this is alive.
    ///
    /// https://rux-lang.dev/docs/api/collections/value-iterator/new
    pub func ValueIterator(items: Slice<T>) -> ValueIterator<T> {
        return ValueIterator<T> { data: items.data, length: items.length, position: 0 };
    }

    /// The next element, or `None` once the run is exhausted.
    ///
    /// `self` is borrowed mutably and advanced. An exhausted iterator keeps reporting `None`.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// https://rux-lang.dev/docs/api/collections/value-iterator/next
    pub func Next(self: &var ValueIterator<T>) -> Option<T> {
        if self.position >= self.length { return Option::None<T>(); }
        let value = self.data[self.position];
        self.position = self.position + 1;
        return Option::Some<T>(value);
    }
}

extend ValueIterator<T> : Iterator {}

/// An iterator that yields a pointer to each element of a run.
///
/// Works for any element type, including one that owns something and may not be copied: the pointer borrows the
/// element where it sits rather than taking it.
///
/// https://rux-lang.dev/docs/api/collections/reference-iterator
pub struct ReferenceIterator<T> {
    /// The run being walked. Borrowed, never owned.
    data: *T;
    /// How many elements it holds.
    length: uint;
    /// How many have been yielded.
    position: uint;
}

extend ReferenceIterator<T> {
    /// An iterator over `items`, positioned before the first element.
    ///
    /// `items` is borrowed and must outlive the iterator.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// # Safety
    ///
    /// Every pointer this yields points into the storage, so the storage must not be grown, freed or moved while
    /// this or any pointer it yielded is still in use.
    ///
    /// https://rux-lang.dev/docs/api/collections/reference-iterator/new
    pub func ReferenceIterator(items: Slice<T>) -> ReferenceIterator<T> {
        return ReferenceIterator<T> { data: items.data, length: items.length, position: 0 };
    }

    /// A pointer to the next element, or `None` once the run is exhausted.
    ///
    /// `self` is borrowed mutably and advanced. The pointer borrows the element and takes ownership of nothing.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// https://rux-lang.dev/docs/api/collections/reference-iterator/next
    pub func Next(self: &var ReferenceIterator<T>) -> Option<*T> {
        if self.position >= self.length { return Option::None<*T>(); }
        let element = @self.data[self.position];
        self.position = self.position + 1;
        return Option::Some<*T>(element);
    }
}

extend ReferenceIterator<T> : Iterator {}
