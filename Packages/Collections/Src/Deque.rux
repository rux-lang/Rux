// A double-ended queue over a circular buffer.
// Elements go on and come off at either end in constant time, which is what a vector cannot offer at the front:
// shifting every element along costs a linear pass per removal. This is the queue — `PushBack` and `PopFront` are
// first in, first out — as `Vector` is the stack.
// The capacity is always a power of two, or zero. That is what lets the ring wrap with a mask rather than a
// division: logical element `i` lives at physical `(head + i) & (capacity - 1)`. Because the elements can straddle
// the end of the block, a deque cannot always hand out one contiguous view; `AsSlices` gives the two runs without
// moving anything, and `MakeContiguous` rotates them back together where one view is what a caller needs.
// A deque owns its storage and its elements, so copying is prohibited and it is move-only. The allocator is
// injected at construction and kept. Destruction destroys every element it holds and then releases the block.
// Running out of memory terminates the program, as everywhere in this package. Growth allocates a fresh block,
// relocates the elements into it, and only then releases the old one, so the elements are never anywhere but one
// block. An operation given an index the deque does not have throws `IndexOutOfRange` and changes nothing.
// The ring invariant, which every `Safety:` comment below leans on: `data` is null with `capacity` zero, or a block
// from `AllocateBlock` with room for `capacity` elements, a power of two; `head < capacity`, `length <= capacity`, and
// the `length` slots from `head` onward, wrapping, are initialized, so `SlotOf(i)` names one of them for `i < length`.

import Algorithms::Rotate;
import Allocator::{ AllocationFailed, Allocator };
import Memory::Copy;

/// The capacity a deque takes when it first has to allocate.
/// Four slots, and a power of two like every capacity after it.
/// @see https://rux-lang.dev/docs/api/collections/deque#minimum-deque-capacity
pub const MinimumDequeCapacity: uint = 4;

/// A double-ended queue over a circular buffer.
/// Move-only: it owns its elements and storage, prohibits copying, and destroys both with `~Deque`.
/// @typeParam T the element type
/// @see https://rux-lang.dev/docs/api/collections/deque
pub struct Deque<T> {
    /// The ring. Null for a deque that has not allocated yet.
    data: *var T;
    /// Where the first element sits physically. Always below the capacity, and zero when there is no capacity.
    head: uint;
    /// How many elements the deque holds.
    length: uint;
    /// How many the ring could hold. A power of two, or zero.
    capacity: uint;
    /// Where the storage came from, and where it goes back to.
    allocator: Allocator;
}

extend Deque<T> {
    /// Copying a deque would give two owners of one allocation and its elements.
    func =(self: &var Deque<T>, other: &Deque<T>);

    /// An empty deque that has not allocated anything.
    /// `allocator` is borrowed for the call and kept. Costs nothing: a deque that is never pushed to never allocates.
    /// Cannot fail. Runs in constant time.
    /// @param allocator where the storage comes from
    /// @returns an empty collection that has taken no storage yet
    /// @see https://rux-lang.dev/docs/api/collections/deque#new
    pub func Deque(allocator: Allocator) -> Deque<T> {
        return Deque<T> { data: null, head: 0, length: 0, capacity: 0, allocator: allocator };
    }

    /// An empty deque with room for `capacity` elements already taken.
    /// `allocator` is borrowed for the call and kept. The capacity actually taken is rounded up to a power of two,
    /// since that is what the ring's masking needs. Terminates the program when the storage cannot be had.
    /// @param allocator where the storage comes from
    /// @param capacity how many elements to make room for
    /// @returns an empty deque with room for that many elements already taken
    /// @see https://rux-lang.dev/docs/api/collections/deque#with-capacity
    pub func WithCapacity(allocator: Allocator, capacity: uint) -> Deque<T> {
        var deque = Deque<T>(allocator);
        if capacity == 0 {
            return <-deque;
        }
        deque.Grow(capacity);
        return <-deque;
    }

    /// A deque holding a copy of every element of `items`, front to back.
    /// `allocator` is borrowed for the call and kept; `items` is borrowed and read. Copies its elements, so a move-only
    /// element type is built with `PushBack` instead. Terminates the program when the storage cannot be had.
    /// @param allocator where the storage comes from
    /// @param items the elements to take
    /// @returns a deque holding a copy of those elements
    /// @see https://rux-lang.dev/docs/api/collections/deque#from-slice
    pub func FromSlice(allocator: Allocator, items: T[..]) -> Deque<T> {
        var deque = Deque<T>(allocator);
        if items.length == 0 {
            return <-deque;
        }

        deque.Grow(items.length);
        var index: uint = 0;
        while index < items.length {
            // Safety: `index < items.length`, checked by the loop; the slice holds that many elements and `Grow` gave
            // the ring room for as many, starting at a head of zero.
            unsafe { deque.data[index] = items.data[index]; }
            index++;
        }
        deque.length = items.length;
        return <-deque;
    }

    /// An independent deque holding a copy of every element of this one, in order.
    /// `self` is borrowed and left alone. The copy starts contiguous whatever this one's elements were doing.
    /// Elements are copied with `=`, so the element type must be plain data that `Core::Copyable` describes; an
    /// owning element type is rejected while compiling, at the copy. Terminates the program when the storage cannot
    /// be had.
    /// @returns an independent copy
    /// @see https://rux-lang.dev/docs/api/collections/deque#clone
    pub func Clone(self: &Deque<T>) -> Deque<T> {
        var copy = Deque<T> { data: null, head: 0, length: 0, capacity: 0, allocator: self.allocator };
        if self.length == 0 {
            return <-copy;
        }
        copy.Grow(self.length);
        // Safety: `Grow` gave `copy.data` room for `self.length` elements, and it is a fresh block apart from this
        // ring.
        unsafe { self.CopyInto(copy.data); }
        copy.length = self.length;
        return <-copy;
    }

    /// How many elements the deque holds.
    /// `self` is borrowed.
    /// @returns how many elements it holds
    /// @see https://rux-lang.dev/docs/api/collections/deque#length
    pub func Length(self: &Deque<T>) -> uint {
        return self.length;
    }

    /// How many elements the ring could hold without growing.
    /// `self` is borrowed. A power of two, or zero.
    /// @returns how many elements fit before the next growth
    /// @see https://rux-lang.dev/docs/api/collections/deque#capacity
    pub func Capacity(self: &Deque<T>) -> uint {
        return self.capacity;
    }

    /// Whether the deque holds no elements.
    /// `self` is borrowed.
    /// @returns whether it holds nothing
    /// @see https://rux-lang.dev/docs/api/collections/deque#is-empty
    pub func IsEmpty(self: &Deque<T>) -> bool {
        return self.length == 0;
    }

    // The physical slot logical element `index` occupies. The mask is why the capacity is a power of two.
    func SlotOf(self: &Deque<T>, index: uint) -> uint {
        return (self.head + index) & (self.capacity - 1);
    }

    // Relocates every element into `block`, front first, unwrapping the ring in the process. A relocation rather
    // than a copy: the bytes move and the originals are not destroyed, because there is exactly one of each
    // afterwards.
    // Safety: `block` must have room for `self.length` elements and must not overlap the ring.
    unsafe func CopyInto(self: &Deque<T>, block: *var T) {
        if self.length == 0 { return; }

        var front = self.capacity - self.head;
        if front > self.length {
            front = self.length;
        }

        // Both products are bounded by `capacity * sizeof(T)`, which was checked before the block was allocated, so
        // neither multiply here can wrap.
        Copy(block as *var opaque, @self.data[self.head] as *opaque, front * sizeof(T));
        if front < self.length {
            Copy(@block[front] as *var opaque, self.data as *opaque, (self.length - front) * sizeof(T));
        }
    }

    // Grows the ring to hold at least `required` elements, leaving one that is already large enough alone.
    // Internal: `Reserve` is the public way to ask for room, because it counts from the current length.
    func Grow(self: &var Deque<T>, required: uint) {
        if required <= self.capacity { return; }

        var capacity = try PowerOfTwoCapacity(required, MinimumDequeCapacity, sizeof(T)) catch { error => AllocationFailed(error) };

        // A fresh block rather than a reallocation: the elements may wrap, and unwrapping them in place would need a
        // rotation the new block gets for free. Nothing is released until the relocation has happened.
        var block = AllocateBlock<T>(self.allocator, capacity);

        // Safety: `block` is fresh from `AllocateBlock` with room for `capacity` elements, above the old capacity
        // and so above the length.
        unsafe { self.CopyInto(block); }
        if self.data != null {
            ReleaseBlock<T>(self.allocator, self.data, self.capacity);
        }
        self.data = block;
        self.head = 0;
        self.capacity = capacity;
    }

    /// Makes room for `additional` more elements on top of those already present.
    /// `self` is borrowed mutably; the length does not change. Terminates the program when the storage cannot be
    /// had.
    /// @param additional how many more elements to make room for
    /// @see https://rux-lang.dev/docs/api/collections/deque#reserve
    pub func Reserve(self: &var Deque<T>, additional: uint) {
        self.Grow(try AddLength(self.length, additional) catch { error => AllocationFailed(error) });
    }

    /// Releases the capacity the length does not need.
    /// `self` is borrowed mutably. The capacity stays a power of two, so this gives back what rounding leaves spare
    /// rather than everything above the length. An empty deque gives up its storage entirely. Terminates the program
    /// when the smaller block cannot be had.
    /// @see https://rux-lang.dev/docs/api/collections/deque#shrink-to-fit
    pub func ShrinkToFit(self: &var Deque<T>) {
        if self.length == 0 {
            if self.data != null {
                ReleaseBlock<T>(self.allocator, self.data, self.capacity);
                self.data = null;
                self.capacity = 0;
                self.head = 0;
            }
            return;
        }

        var capacity = try PowerOfTwoCapacity(self.length, MinimumDequeCapacity, sizeof(T)) catch { error => AllocationFailed(error) };
        if capacity == self.capacity { return; }

        var block = AllocateBlock<T>(self.allocator, capacity);

        // Safety: `block` is fresh from `AllocateBlock` with room for `capacity` elements, which `PowerOfTwoCapacity`
        // made at least the length.
        unsafe { self.CopyInto(block); }
        ReleaseBlock<T>(self.allocator, self.data, self.capacity);
        self.data = block;
        self.head = 0;
        self.capacity = capacity;
    }

    /// Destroys every element, keeping the storage.
    /// `self` is borrowed mutably. The front returns to physical zero, so the next run of additions does not wrap.
    /// Runs in time proportional to the length.
    /// @see https://rux-lang.dev/docs/api/collections/deque#clear
    pub func Clear(self: &var Deque<T>) {
        var index: uint = 0;
        while index < self.length {
            // Moving each element into a local destroys it when the local's life ends, which is the only way a
            // container has to destroy an element it does not know is droppable.
            // Safety: the ring invariant: `index < self.length`, checked by the loop, so the slot is initialized;
            // each is moved out once, and the length drops to zero right after.
            unsafe { let taken <- self.data[self.SlotOf(index)]; }
            index++;
        }
        self.head = 0;
        self.length = 0;
    }

    /// Destroys every element and releases the storage.
    /// Runs when the deque's life ends. The elements go first and the block second, since an element destroyed after
    /// its storage was released would be read from freed memory.
    /// @see https://rux-lang.dev/docs/api/collections/deque#destructor
    func ~Deque(self: &var Deque<T>) {
        self.Clear();
        if self.data != null {
            ReleaseBlock<T>(self.allocator, self.data, self.capacity);
            self.data = null;
            self.capacity = 0;
        }
    }

    /// Adds an element at the front, growing the ring when it is full.
    /// `self` is borrowed mutably; `value` is moved in. Terminates the program when the ring cannot grow.
    /// Amortized constant time.
    /// @param value the value to act on
    /// @see https://rux-lang.dev/docs/api/collections/deque#push-front
    pub func PushFront(self: &var Deque<T>, value: T) {
        self.Grow(try AddLength(self.length, 1) catch { error => AllocationFailed(error) });

        // One step back around the ring, which for a head of zero is the last slot.
        self.head = (self.head + self.capacity - 1) & (self.capacity - 1);
        // Safety: the ring invariant: `Grow` left `length < capacity`, so the slot one step before the old head is
        // allocated and holds nothing.
        unsafe { self.data[self.head] <- value; }
        self.length = self.length + 1;
    }

    /// Adds an element at the back, growing the ring when it is full.
    /// `self` is borrowed mutably; `value` is moved in. Terminates the program when the ring cannot grow.
    /// Amortized constant time.
    /// @param value the value to act on
    /// @see https://rux-lang.dev/docs/api/collections/deque#push-back
    pub func PushBack(self: &var Deque<T>, value: T) {
        self.Grow(try AddLength(self.length, 1) catch { error => AllocationFailed(error) });

        // Safety: the ring invariant: `Grow` left `length < capacity`, so the slot just past the last element is
        // allocated and holds nothing.
        unsafe { self.data[self.SlotOf(self.length)] <- value; }
        self.length = self.length + 1;
    }

    /// Takes the front element out.
    /// `self` is borrowed mutably. The element is moved out and handed to the caller rather than destroyed, so one
    /// that owns something leaves intact. Reports `none` for an empty deque.
    /// The storage is kept, so a deque emptied this way costs nothing to refill.
    /// @returns the element taken from the front, or `none` when empty
    /// @see https://rux-lang.dev/docs/api/collections/deque#pop-front
    pub func PopFront(self: &var Deque<T>) -> T? {
        if self.length == 0 { return none; }
        // Safety: the ring invariant: the deque is not empty, checked above, so the slot at `head` is initialized; the
        // head moves past it at once.
        let taken <- unsafe { <-self.data[self.head] };
        self.head = (self.head + 1) & (self.capacity - 1);
        self.length = self.length - 1;
        return <-taken;
    }

    /// Takes the back element out.
    /// `self` is borrowed mutably. The element is moved out and handed to the caller. Reports `none` for an empty
    /// deque.
    /// @returns the element taken from the back, or `none` when empty
    /// @see https://rux-lang.dev/docs/api/collections/deque#pop-back
    pub func PopBack(self: &var Deque<T>) -> T? {
        if self.length == 0 { return none; }
        self.length = self.length - 1;
        // Safety: the ring invariant: the slot of the old last element is initialized, and the length has just
        // dropped below it.
        return unsafe { <-self.data[self.SlotOf(self.length)] };
    }

    /// The front element, borrowed where it sits, or `none` for an empty deque.
    /// `self` stays borrowed while the reference is in use, so the deque cannot grow, shrink, or be made contiguous
    /// under it.
    /// @returns a reference to the first element, or `none` when empty
    /// @see https://rux-lang.dev/docs/api/collections/deque#front
    pub func Front(self: &Deque<T>) -> &T? {
        return self.At(0);
    }

    /// The back element, borrowed where it sits, or `none` for an empty deque.
    /// `self` stays borrowed while the reference is in use.
    /// @returns a reference to the last element, or `none` when empty
    /// @see https://rux-lang.dev/docs/api/collections/deque#back
    pub func Back(self: &Deque<T>) -> &T? {
        if self.length == 0 { return none; }
        return self.At(self.length - 1);
    }

    /// The element at `index`, counting from the front, or `none` when there is no such index.
    /// `self` is borrowed; the element is returned by copy. The index is logical: element zero is the front wherever
    /// it happens to sit physically.
    /// @param index which one, counting from zero
    /// @returns a copy of the element, or `none` when the index is out of range
    /// @see https://rux-lang.dev/docs/api/collections/deque#get
    pub func Get(self: &Deque<T>, index: uint) -> T? {
        if index >= self.length { return none; }
        // Safety: the ring invariant: `index < self.length`, checked above, so its slot is initialized.
        return unsafe { self.data[self.SlotOf(index)] };
    }

    /// The element at `index`, counting from the front, borrowed where it sits, or `none` when there is no such
    /// index.
    /// `self` stays borrowed while the reference is in use.
    /// @param index which one, counting from zero
    /// @returns a reference to the element, or `none` when the index is out of range
    /// @see https://rux-lang.dev/docs/api/collections/deque#at
    pub func At(self: &Deque<T>, index: uint) -> &T? {
        if index >= self.length { return none; }
        // Safety: the ring invariant: `index < self.length`, checked above, so its slot is initialized.
        unsafe { return self.data[self.SlotOf(index)]; }
    }

    /// The element at `index`, counting from the front, borrowed to be written where it sits, or `none` when there
    /// is no such index.
    /// `self` stays borrowed exclusively while the reference is in use.
    /// @param index which one, counting from zero
    /// @returns a writable reference to the element, or `none` when the index is out of range
    /// @see https://rux-lang.dev/docs/api/collections/deque#at-mutable
    pub func AtMutable(self: &var Deque<T>, index: uint) -> &var T? {
        if index >= self.length { return none; }
        // Safety: the ring invariant: `index < self.length`, checked above, so its slot is initialized.
        unsafe { return self.data[self.SlotOf(index)]; }
    }

    /// Replaces the element at `index` with `value`, destroying the element that was there.
    /// `self` is borrowed mutably; `value` is moved in. The old element is destroyed once the new one is in place,
    /// so an element that owns something is released rather than leaked; `Replace` hands it back instead. Reports
    /// `IndexOutOfRange` and changes nothing when there is no such index, and `value` is then destroyed here.
    /// @param index which one, counting from zero
    /// @param value the element to store
    /// @returns nothing when the element was written, or `IndexOutOfRange`
    /// @see https://rux-lang.dev/docs/api/collections/deque#set
    pub func Set(self: &var Deque<T>, index: uint, value: T) -> ! CollectionError {
        if index >= self.length { fail CollectionError::IndexOutOfRange; }
        let slot = self.SlotOf(index);
        // Moved into a local, the old element is destroyed when the local's life ends, after the new one is stored.
        // Safety: the ring invariant: `index < self.length`, checked above, so the slot is initialized; the slot
        // emptied by the move is refilled at once.
        unsafe {
            let previous <- self.data[slot];
            self.data[slot] <- value;
        }
        return;
    }

    /// Replaces the element at `index` with `value` and hands back the element that was there.
    /// `self` is borrowed mutably; `value` is moved in and the old element is moved out to the caller rather than
    /// destroyed. Reports `IndexOutOfRange` and changes nothing when there is no such index, and `value` is then
    /// destroyed here.
    /// @param index which one, counting from zero
    /// @param value the element to store
    /// @returns the element that was at `index`, or `IndexOutOfRange`
    /// @see https://rux-lang.dev/docs/api/collections/deque#replace
    pub func Replace(self: &var Deque<T>, index: uint, value: T) -> T ! CollectionError {
        if index >= self.length { fail CollectionError::IndexOutOfRange; }
        let slot = self.SlotOf(index);
        // Safety: the ring invariant: `index < self.length`, checked above, so the slot is initialized; the slot
        // emptied by the move is refilled at once.
        unsafe {
            let previous <- self.data[slot];
            self.data[slot] <- value;
            return <-previous;
        }
    }

    /// Whether the elements occupy one unbroken run.
    /// `self` is borrowed. True for an empty deque and for one whose elements have not wrapped past the end of the
    /// ring. This is what says whether `AsSlice` will move anything.
    /// @returns whether the elements sit in one run, which is what `AsSlice` needs
    /// @see https://rux-lang.dev/docs/api/collections/deque#is-contiguous
    pub func IsContiguous(self: &Deque<T>) -> bool {
        if self.capacity == 0 { return true; }
        return self.head + self.length <= self.capacity;
    }

    /// The elements as at most two runs, front run first, without moving anything.
    /// `self` is borrowed. The second run is empty whenever the storage is already contiguous, so joining the two
    /// always gives the elements in order.
    /// This is the view that costs nothing. `AsSlice` gives one run instead, and pays a rotation for it.
    /// Both views are valid until the deque grows, shrinks, or is made contiguous.
    /// @returns the first run of elements and the second, which is empty when the storage is contiguous
    /// @see https://rux-lang.dev/docs/api/collections/deque#as-slices
    pub func AsSlices(self: &Deque<T>) -> (T[..], T[..]) {
        if self.length == 0 { return ([], []); }

        var frontLength = self.capacity - self.head;
        if frontLength > self.length {
            frontLength = self.length;
        }
        // Safety: the ring invariant: the `frontLength` slots from `head`, which stop at the end of the block, are
        // initialized.
        let front: T[..] = unsafe { (@self.data[self.head])[..frontLength] };
        if frontLength == self.length { return (front, []); }
        // Safety: the ring invariant: the elements that wrapped occupy the first `length - frontLength` slots.
        let back: T[..] = unsafe { (self.data)[..self.length - frontLength] };
        return (front, back);
    }

    /// Moves the elements so they occupy one unbroken run starting at physical zero.
    /// `self` is borrowed mutably. Allocates nothing: rotating the whole ring left by the head brings the front
    /// element to zero and preserves cyclic order for every slot at once, so no element has to be tracked
    /// individually.
    /// Every pointer and view into the deque is invalidated, and so is any physical index a caller recorded.
    /// @see https://rux-lang.dev/docs/api/collections/deque#make-contiguous
    pub func MakeContiguous(self: &var Deque<T>) {
        if self.capacity == 0 || self.head == 0 { return; }
        // Safety: the ring invariant: `data` has room for `capacity` elements, nonzero, checked above. `Rotate` only
        // exchanges slots, so the spare ones are carried along without being read as elements.
        Rotate<T>(unsafe { self.data[..self.capacity] }, self.head);
        self.head = 0;
    }

    /// Every element as one borrowed read-only view, moving them together first.
    /// `self` is borrowed mutably — unlike a vector's, producing a single view can move the elements, which is why
    /// this asks for a writable receiver rather than a read-only one.
    /// The view is valid until the deque grows, shrinks, or is made contiguous again.
    /// @returns the elements, borrowed; empty unless the storage is contiguous
    /// @see https://rux-lang.dev/docs/api/collections/deque#as-slice
    pub func AsSlice(self: &var Deque<T>) -> T[..] {
        self.MakeContiguous();
        // Safety: the ring invariant: `MakeContiguous` put the head at zero, so the first `length` slots are the
        // initialized elements.
        return unsafe { (self.data)[..self.length] };
    }

    /// Every element as one borrowed writable view, moving them together first.
    /// `self` is borrowed mutably.
    /// The view is valid until the deque grows, shrinks, or is made contiguous again.
    /// @returns the elements borrowed for writing; empty unless the storage is contiguous
    /// @see https://rux-lang.dev/docs/api/collections/deque#as-mutable-slice
    pub func AsMutableSlice(self: &var Deque<T>) -> var T[..] {
        self.MakeContiguous();
        // Safety: the ring invariant: `MakeContiguous` put the head at zero, so the first `length` slots are the
        // initialized elements.
        return unsafe { (self.data)[..self.length] };
    }

    /// An iterator over the elements, front to back, by copy.
    /// `self` is borrowed mutably and must outlive the iterator, and the elements are moved together first so one
    /// run can be walked. This is the method a `for` loop finds.
    /// The deque must not grow or shrink while the iterator is alive.
    /// @returns a cursor yielding copies of the elements, front to back
    /// @see https://rux-lang.dev/docs/api/collections/deque#iterate
    pub func Iterate(self: &var Deque<T>) -> ValueIterator<T> {
        return ValueIterator<T>(self.AsSlice());
    }

    /// An iterator over pointers to the elements, front to back.
    /// `self` is borrowed mutably and must outlive the iterator, and the elements are moved together first.
    /// @returns a cursor yielding the elements' addresses, front to back
    /// @see https://rux-lang.dev/docs/api/collections/deque#references
    pub func References(self: &var Deque<T>) -> ReferenceIterator<T> {
        return ReferenceIterator<T>(self.AsSlice());
    }
}
