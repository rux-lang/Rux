// Talking to an allocator in elements rather than bytes.
// Every container here holds a run of `T` and needs three things from an allocator: storage for a count of them,
// storage of a different count with the old contents carried over, and the storage given back. Doing that by hand
// means computing a layout at each site, and a layout computed wrongly is the defect that writes past the end of a
// block the allocator thought was smaller. These helpers exist so it is computed once.
// The layout comes from `sizeof(T)` and `alignof(T)`, asked of the element type at each instantiation. That is what
// makes these usable by a container that has never seen an element and has none to hand: nothing here needs a sample
// value.
// A count of zero is not an error. It asks the allocator for a zero-sized block, which every allocator here answers
// with a shared non-null aligned address, so an empty container is not a special shape and needs no null checks
// downstream. That block must still be released, exactly like any other.
// Internal to this package, and package-private so that it stays that way: these are the plumbing every container
// shares, not something a caller reaches for. What a caller reaches for is a container, and what the plumbing does
// is visible through one — a zero-sized element, a growth the allocator refuses, and the destruction of everything
// held all show up at that surface, which is where Tests/Packages/Collections/ContainerStorage checks them.
// Each request comes in two forms. `TryAllocateBlock` and `TryReallocateBlock` throw the `AllocError` for a container's
// `Try*` operations to hand on; `AllocateBlock` and `ReallocateBlock` terminate the program instead, which is what
// every other operation does when storage cannot be had.

import Allocator::{ AllocError, AllocationFailed, Allocator, Layout };

// The layout of `count` elements of `T`, or `Unsupported` when no such layout can be represented.
func ElementLayout<T>(count: uint) -> Layout throws AllocError {
    // An element occupying nothing still needs somewhere to be. A run of them would otherwise be a zero-sized
    // request, which every allocator here answers with the shared empty address — and a store into that address
    // faults, however few bytes it writes. One byte apiece gives the run a real address; every index lands on the
    // same one, which is exactly right for a type with nothing to distinguish.
    let elementSize = sizeof(T) == 0 ? 1u : sizeof(T);
    let bytes = try ByteSize(count, elementSize);

    let alignment = alignof(T) == 0 ? 1u : alignof(T);
    // A layout the allocator's own rules reject has a rounded size past the end of the address space. The element's
    // alignment is whatever the compiler gave it, so it is a power of two by construction.
    return Layout::New(bytes, alignment) ?? throw AllocError::Unsupported;
}

// Storage for `count` elements, uninitialized, or why there is none. Nothing is written to it: a container fills
// what it hands out.
func TryAllocateBlock<T>(allocator: Allocator, count: uint) -> (*var T) throws AllocError {
    let layout = try ElementLayout<T>(count);
    let block = try allocator.Allocate(layout);
    // Safety: the allocator answered `ElementLayout<T>(count)`, so the block is aligned for `T` and has room for
    // `count` of them.
    return unsafe { block as *var T };
}

// Storage for `count` elements, uninitialized; terminates the program when there is none.
func AllocateBlock<T>(allocator: Allocator, count: uint) -> *var T {
    return try TryAllocateBlock<T>(allocator, count) catch { error => AllocationFailed(error) };
}

// Storage for `newCount` elements holding what the first `min(oldCount, newCount)` of the old block held. On failure
// the old block is untouched and still the caller's, which is what lets a `Try*` operation report a failed growth
// and leave its container as it was.
func TryReallocateBlock<T>(allocator: Allocator, block: *var T, oldCount: uint, newCount: uint)
    -> (*var T) throws AllocError {
    let oldLayout = try ElementLayout<T>(oldCount);
    let newLayout = try ElementLayout<T>(newCount);
    let moved = try allocator.Reallocate(block as *var opaque, oldLayout, newLayout);
    // Safety: the allocator answered `ElementLayout<T>(newCount)`, so the block is aligned for `T` and has room for
    // `newCount` of them.
    return unsafe { moved as *var T };
}

// Storage for `newCount` elements holding what the old block held; terminates the program when there is none.
func ReallocateBlock<T>(allocator: Allocator, block: *var T, oldCount: uint, newCount: uint) -> *var T {
    return try TryReallocateBlock<T>(allocator, block, oldCount, newCount) catch { error => AllocationFailed(error) };
}

// Gives back storage this package took for `count` elements. The elements themselves are the container's business:
// whatever they own must already have been dealt with, because this frees the block and nothing else.
func ReleaseBlock<T>(allocator: Allocator, block: *var T, count: uint) {
    // The layout that allocated it computed cleanly, so this one does too; there is no honest way to release a block
    // whose size cannot be named, and nothing to report it to.
    let layout = try ElementLayout<T>(count) catch { _ => return };
    // The block came from this allocator with this layout, and there is no caller to report a refusal to.
    allocator.Deallocate(block as *var opaque, layout) catch { else => {} };
}
