import Core::MutableSlice;
import Memory::{ Alloc, Copy, Free, Realloc };

// Four slots is where growth starts. Below that a doubling sequence spends more
// reallocations than it saves.
const MinimumVectorCapacity: uint = 4;

// A growable collection owning one contiguous heap allocation. Capacity grows
// geometrically as elements are appended, while length counts only the
// initialized ones.
//
// This is also the stack: Push and TryPop work at the end, which is the end
// that costs nothing to reach. Deque is the double-ended counterpart, and is
// what to reach for when elements have to leave from the front.
//
// Ownership is manual, because Rux has no destructors and no move semantics.
// Assignment copies the Vector value and therefore shares its allocation, so
// Clone when both copies must be freed, and Free exactly once for every
// allocation. Clone copies element bytes verbatim: an element that owns a
// resource ends up referenced by both copies, and releasing it stays the
// element owner's job.
//
// Every fallible operation reports a CollectionError and leaves the receiver
// unchanged unless it returns None. Operations that cannot allocate report an
// ordinary miss with a bool instead, so an exhausted allocator is never
// confused with an empty container or a rejected index.
//
// Any growth may move the allocation. Every pointer and every view into a
// Vector is invalidated by Push, PushSlice, Insert, Reserve, ShrinkToFit,
// IntoArray, and Free.
struct Vector<T> {
    data: *var T;
    length: uint;
    capacity: uint;
}

extend Vector<T> {
    // The empty Vector. Owns nothing until the first element is added.
    func New() -> Vector<T> {
        return Vector<T> { data: null, length: 0, capacity: 0 };
    }

    // An empty Vector with room for `capacity` elements reserved up front, so
    // a known number of appends does not reallocate. A zero capacity allocates
    // nothing.
    func WithCapacity(capacity: uint, result: *var Vector<T>) -> CollectionError {
        if capacity == 0 {
            *result = Vector<T> { data: null, length: 0, capacity: 0 };
            return CollectionError::None;
        }

        var bytes: uint = 0;
        let sizing = ByteSize(capacity, sizeof(T), @bytes);
        if !(sizing == CollectionError::None) {
            return sizing;
        }

        let ptr = Alloc(bytes) as *var T;
        if ptr == null {
            return CollectionError::OutOfMemory;
        }

        *result = Vector<T> { data: ptr, length: 0, capacity: capacity };
        return CollectionError::None;
    }

    // Copies a slice into an independently owned Vector whose capacity is
    // exactly its length. The source is left untouched.
    func FromSlice(items: Slice<T>, result: *var Vector<T>) -> CollectionError {
        if items.length == 0 {
            *result = Vector<T> { data: null, length: 0, capacity: 0 };
            return CollectionError::None;
        }

        var bytes: uint = 0;
        let sizing = ByteSize(items.length, sizeof(T), @bytes);
        if !(sizing == CollectionError::None) {
            return sizing;
        }

        let ptr = Alloc(bytes) as *var T;
        if ptr == null {
            return CollectionError::OutOfMemory;
        }

        Copy(ptr, items.data, bytes);
        *result = Vector<T> { data: ptr, length: items.length, capacity: items.length };
        return CollectionError::None;
    }

    // An independent copy of the initialized elements, with capacity trimmed to
    // length. Element values are copied byte for byte, so allocations owned by
    // individual elements are shared with the original rather than duplicated.
    func Clone(self: *Vector<T>, result: *var Vector<T>) -> CollectionError {
        if self.length == 0 {
            *result = Vector<T> { data: null, length: 0, capacity: 0 };
            return CollectionError::None;
        }

        var bytes: uint = 0;
        let sizing = ByteSize(self.length, sizeof(T), @bytes);
        if !(sizing == CollectionError::None) {
            return sizing;
        }

        let ptr = Alloc(bytes) as *var T;
        if ptr == null {
            return CollectionError::OutOfMemory;
        }

        Copy(ptr, self.data, bytes);
        *result = Vector<T> { data: ptr, length: self.length, capacity: self.length };
        return CollectionError::None;
    }

    // Releases the allocation and leaves the empty Vector behind, so calling
    // Free again is a no-op.
    func Free(self: *var Vector<T>) {
        Free(self.data);
        self.data = null;
        self.length = 0;
        self.capacity = 0;
    }

    // The allocation holding the initialized elements and the spare capacity
    // after them, read-only. A growth may move it; Free invalidates it.
    func Data(self: *Vector<T>) -> *T {
        return self.data;
    }

    // The same allocation, writable.
    func MutableData(self: *var Vector<T>) -> *var T {
        return self.data;
    }

    // The number of initialized elements, which is not the capacity.
    func Length(self: *Vector<T>) -> uint {
        return self.length;
    }

    // The number of elements the allocation holds before it has to grow.
    func Capacity(self: *Vector<T>) -> uint {
        return self.capacity;
    }

    func IsEmpty(self: *Vector<T>) -> bool {
        return self.length == 0;
    }

    // Grows the allocation to hold at least `required` elements, leaving a
    // Vector that is already large enough alone.
    //
    // Internal helper; not part of the package API. Reserve is the public way
    // to ask for room, because it counts from the current length rather than
    // from zero.
    func Grow(self: *var Vector<T>, required: uint) -> CollectionError {
        if required <= self.capacity {
            return CollectionError::None;
        }

        var capacity: uint = 0;
        let planned = GrowCapacity(self.capacity, required, MinimumVectorCapacity, sizeof(T), @capacity);
        if !(planned == CollectionError::None) {
            return planned;
        }

        var bytes: uint = 0;
        let sizing = ByteSize(capacity, sizeof(T), @bytes);
        if !(sizing == CollectionError::None) {
            return sizing;
        }

        // Into a local first. Memory::Realloc leaves the original block valid
        // when it fails, so assigning its null return straight to self.data
        // would drop the only pointer to the elements and leave a capacity the
        // Vector does not own.
        let resized = self.data == null
            ? Alloc(bytes) as *var T
            : Realloc(self.data, bytes) as *var T;
        if resized == null {
            return CollectionError::OutOfMemory;
        }

        self.data = resized;
        self.capacity = capacity;
        return CollectionError::None;
    }

    // Makes room for `additional` more elements on top of those already
    // present, without changing Length. Capacity only ever grows here;
    // ShrinkToFit is what hands it back.
    func Reserve(self: *var Vector<T>, additional: uint) -> CollectionError {
        var required: uint = 0;
        let total = AddLength(self.length, additional, @required);
        if !(total == CollectionError::None) {
            return total;
        }

        return self.Grow(required);
    }

    // Releases the capacity beyond Length. An empty Vector becomes
    // allocation-free. A failure leaves the Vector usable at its current
    // capacity.
    func ShrinkToFit(self: *var Vector<T>) -> CollectionError {
        if self.capacity == self.length {
            return CollectionError::None;
        }
        if self.length == 0 {
            self.Free();
            return CollectionError::None;
        }

        var bytes: uint = 0;
        let sizing = ByteSize(self.length, sizeof(T), @bytes);
        if !(sizing == CollectionError::None) {
            return sizing;
        }

        let resized = Realloc(self.data, bytes) as *var T;
        if resized == null {
            return CollectionError::OutOfMemory;
        }

        self.data = resized;
        self.capacity = self.length;
        return CollectionError::None;
    }

    // Drops every element while keeping the allocation, so the Vector can be
    // refilled without allocating again. Free is what releases it.
    func Clear(self: *var Vector<T>) {
        self.length = 0;
    }

    // Drops the elements past `length`, keeping the allocation. A `length` at
    // or past the current one changes nothing, so this never grows.
    //
    // This is the other half of the Rux/Algorithms seam: Unique, RemoveIf,
    // RemoveValue and Partition compact survivors toward the front and return
    // the surviving length without resizing anything, and this is how a Vector
    // is told about it.
    func Truncate(self: *var Vector<T>, length: uint) {
        if length < self.length {
            self.length = length;
        }
    }

    // Appends one element, growing the allocation when it is full.
    func Push(self: *var Vector<T>, value: T) -> CollectionError {
        var required: uint = 0;
        let total = AddLength(self.length, 1, @required);
        if !(total == CollectionError::None) {
            return total;
        }

        let grown = self.Grow(required);
        if !(grown == CollectionError::None) {
            return grown;
        }

        self.data[self.length] = value;
        self.length++;
        return CollectionError::None;
    }

    // Appends every element of a slice. The slice must not borrow this
    // Vector's own storage: the copy runs front to back and would read
    // elements it had already overwritten.
    //
    // A separate name rather than an overload of Push, because Rux resolves an
    // untyped integer literal against a single candidate but not against an
    // overload set, so a second Push would stop `numbers.Push(1)` compiling.
    func PushSlice(self: *var Vector<T>, items: Slice<T>) -> CollectionError {
        if items.length == 0 {
            return CollectionError::None;
        }

        var required: uint = 0;
        let total = AddLength(self.length, items.length, @required);
        if !(total == CollectionError::None) {
            return total;
        }

        let grown = self.Grow(required);
        if !(grown == CollectionError::None) {
            return grown;
        }

        var bytes: uint = 0;
        let sizing = ByteSize(items.length, sizeof(T), @bytes);
        if !(sizing == CollectionError::None) {
            return sizing;
        }

        Copy(@self.data[self.length], items.data, bytes);
        self.length = required;
        return CollectionError::None;
    }

    // Inserts before `index`, shifting the elements after it to the right. An
    // index equal to Length appends; a larger one is rejected, and is reported
    // separately from an exhausted allocator.
    func Insert(self: *var Vector<T>, index: uint, value: T) -> CollectionError {
        if index > self.length {
            return CollectionError::IndexOutOfRange;
        }

        var required: uint = 0;
        let total = AddLength(self.length, 1, @required);
        if !(total == CollectionError::None) {
            return total;
        }

        let grown = self.Grow(required);
        if !(grown == CollectionError::None) {
            return grown;
        }

        // A backward element loop rather than Memory::Copy: that one copies
        // front to back and would overwrite the tail while still reading it.
        var i = self.length;
        while i > index {
            self.data[i] = self.data[i - 1];
            i--;
        }

        self.data[index] = value;
        self.length++;
        return CollectionError::None;
    }

    // Removes the last element and hands it back, reporting whether there was
    // one. Capacity is retained. A null `value` discards the element rather
    // than refusing to pop.
    func TryPop(self: *var Vector<T>, value: *var T) -> bool {
        if self.length == 0 {
            return false;
        }

        self.length--;
        if value != null {
            *value = self.data[self.length];
        }
        return true;
    }

    // Reads the first element without removing it.
    func TryFirst(self: *Vector<T>, value: *var T) -> bool {
        if value == null || self.length == 0 {
            return false;
        }

        *value = self.data[0];
        return true;
    }

    // Reads the last element without removing it.
    func TryLast(self: *Vector<T>, value: *var T) -> bool {
        if value == null || self.length == 0 {
            return false;
        }

        *value = self.data[self.length - 1];
        return true;
    }

    // Removes the element at `index` and closes the gap, preserving the order
    // of the rest. Capacity is retained so later additions reuse the
    // allocation. Rejects an index at or past Length.
    func RemoveAt(self: *var Vector<T>, index: uint) -> bool {
        if index >= self.length {
            return false;
        }

        var i = index;
        while i + 1 < self.length {
            self.data[i] = self.data[i + 1];
            i++;
        }

        self.length--;
        return true;
    }

    // Removes the element at `index` by moving the last element into its
    // place. Constant time, and it does not preserve order — reach for
    // RemoveAt when order matters. Removing the last element is a plain pop.
    func SwapRemoveAt(self: *var Vector<T>, index: uint) -> bool {
        if index >= self.length {
            return false;
        }

        self.length--;
        if index != self.length {
            self.data[index] = self.data[self.length];
        }
        return true;
    }

    // The element at `index`. Unchecked, like pointer and slice indexing: an
    // index at or past Length is undefined behavior, not a reported error.
    // TryGet is the checked form.
    func At(self: *Vector<T>, index: uint) -> T {
        return self.data[index];
    }

    // Reads the element at `index`, reporting whether the index was in range.
    // A rejected index leaves `value` untouched, so a caller may seed it with
    // a fallback. A null `value` reports failure rather than reading.
    func TryGet(self: *Vector<T>, index: uint, value: *var T) -> bool {
        if value == null || index >= self.length {
            return false;
        }

        *value = self.data[index];
        return true;
    }

    // Replaces the element at `index`. Unchecked, as in At.
    func Set(self: *var Vector<T>, index: uint, value: T) {
        self.data[index] = value;
    }

    // Replaces the element at `index`, reporting whether it was in range. A
    // rejected index writes nothing.
    func TrySet(self: *var Vector<T>, index: uint, value: T) -> bool {
        if index >= self.length {
            return false;
        }

        self.data[index] = value;
        return true;
    }

    // Borrows the initialized elements read-only, never the spare capacity.
    // The view must not outlive the allocation, and any growth invalidates it.
    func AsSlice(self: *Vector<T>) -> Slice<T> {
        return Slice<T> { data: self.data, length: self.length };
    }

    // Borrows the initialized elements writably, again never the spare
    // capacity. Takes a writable receiver because it hands out the ability to
    // write.
    func AsMutableSlice(self: *var Vector<T>) -> MutableSlice<T> {
        return MutableSlice<T> { data: self.data, length: self.length };
    }

    // ToArray and IntoArray are gone until this type takes an allocator of its own. An Array now carries the
    // allocator its storage came from, and a Vector that still calls Memory::Alloc directly has none to give it.
}
