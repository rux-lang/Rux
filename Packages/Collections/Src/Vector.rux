// A contiguous run of elements that grows as things are appended to it.
//
// `Vector<T>` is the container to reach for by default. It is the stack -- `Push` and `TryPop` work at the end that
// costs nothing to reach -- and it is what a sequence of unknown length is built into before anything else looks at
// it. `Array<T>` is what it becomes when the length stops changing.
//
// A vector owns its storage and its elements, so it implements `Drop` and is move-only. Handing one to a function
// transfers it, and reading the source afterwards is rejected while compiling. Destruction destroys every element it
// holds and then releases the block; the spare capacity past the length holds nothing and is not touched.
//
// The allocator is injected at construction and kept, so a vector built from an arena disappears with the arena.
//
// Capacity doubles rather than growing by a constant, which is what makes a run of appends cost an amortized
// constant each rather than a reallocation every time. Capacity is never reduced except by `ShrinkToFit`, so a
// vector that has been large stays cheap to refill.
//
// `Push` moves its argument in rather than copying it, so a vector is how a sequence of elements that own something
// is built: each is moved in exactly once and destroyed exactly once, when the vector is.
//
// Two failure shapes, as everywhere in this package: an operation that may allocate reports a `CollectionError`, and
// one that cannot allocate reports an ordinary miss with a `bool` and an out-parameter. A reported failure means the
// vector is exactly as it was.

import Allocator::Allocator;
import Core::{ Drop, Iterator, MutableSlice, Option };

/// The capacity a vector takes when it first has to allocate.
///
/// Four elements rather than one: the first few appends are the common case, and three reallocations to reach four
/// elements is three more than the work is worth.
///
/// https://rux-lang.dev/docs/api/collections/minimum-vector-capacity
const MinimumVectorCapacity: uint = 4;

/// A growable contiguous run of elements on storage this vector owns.
///
/// Move-only: it owns its elements and its storage, so it implements `Drop`.
///
/// https://rux-lang.dev/docs/api/collections/vector
struct Vector<T> {
    /// The storage. Null for a vector that has not allocated yet.
    data: *var T;
    /// How many elements are initialized, counting from the front.
    length: uint;
    /// How many the storage could hold. Never below `length`.
    capacity: uint;
    /// Where the storage came from, and where it goes back to.
    allocator: Allocator;
}

extend Vector<T> {
    /// An empty vector that has not allocated anything.
    ///
    /// `allocator` is borrowed for the call and kept. Costs nothing: a vector that is never pushed to never
    /// allocates, which is what makes one cheap to have and to return.
    ///
    /// Cannot fail. Runs in constant time.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/new
    func New(allocator: Allocator) -> Vector<T> {
        return Vector<T> { data: null, length: 0, capacity: 0, allocator: allocator };
    }

    /// An empty vector with room for `capacity` elements already taken.
    ///
    /// `allocator` is borrowed for the call and kept; `error` is written with why the room could not be taken. The
    /// vector is empty either way -- capacity is not length -- and on failure it has no storage, so destroying it is
    /// harmless.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/with-capacity
    func WithCapacity(allocator: Allocator, capacity: uint, error: *var CollectionError) -> Vector<T> {
        var vector = Vector<T> { data: null, length: 0, capacity: 0, allocator: allocator };
        if capacity == 0 {
            *error = CollectionError::None;
            return vector;
        }
        *error = vector.Grow(capacity);
        return vector;
    }

    /// A vector holding a copy of every element of `items`, in order.
    ///
    /// `allocator` is borrowed for the call and kept; `items` is borrowed and read; `error` is written with why the
    /// vector could not be made. Copies its elements, so a move-only element type is built with `Push` instead.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/from-slice
    func FromSlice(allocator: Allocator, items: Slice<T>, error: *var CollectionError) -> Vector<T> {
        var vector = Vector<T> { data: null, length: 0, capacity: 0, allocator: allocator };
        if items.length == 0 {
            *error = CollectionError::None;
            return vector;
        }

        let room = vector.Grow(items.length);
        if room.IsError() {
            *error = room;
            return vector;
        }
        var index: uint = 0;
        while index < items.length {
            vector.data[index] = items.data[index];
            index++;
        }
        vector.length = items.length;
        *error = CollectionError::None;
        return vector;
    }

    /// An independent vector holding a copy of every element of this one.
    ///
    /// `self` is borrowed and left alone; `error` is written with why the copy could not be made. The copy takes
    /// exactly the room it needs rather than matching this one's capacity, since the spare holds nothing worth
    /// reproducing.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/clone
    func Clone(self: *Vector<T>, error: *var CollectionError) -> Vector<T> {
        return Vector::FromSlice<T>(self.allocator, self.AsSlice(), error);
    }
}

extend Vector<T> {
    /// How many elements the vector holds.
    ///
    /// `self` is borrowed.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/length
    func Length(self: *Vector<T>) -> uint {
        return self.length;
    }

    /// How many elements the storage could hold without growing.
    ///
    /// `self` is borrowed. Never below the length, and never reduced except by `ShrinkToFit`.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/capacity
    func Capacity(self: *Vector<T>) -> uint {
        return self.capacity;
    }

    /// Whether the vector holds no elements.
    ///
    /// `self` is borrowed. A vector with capacity and no elements is empty: capacity is not length.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/is-empty
    func IsEmpty(self: *Vector<T>) -> bool {
        return self.length == 0;
    }

    // Grows the storage to hold at least `required` elements, leaving a vector that is already large enough alone.
    //
    // Internal: `Reserve` is the public way to ask for room, because it counts from the current length rather than
    // from zero, which is what a caller about to append that many actually means.
    func Grow(self: *var Vector<T>, required: uint) -> CollectionError {
        if required <= self.capacity {
            return CollectionError::None;
        }

        var capacity: uint = 0;
        let planned = GrowCapacity(self.capacity, required, MinimumVectorCapacity, sizeof(T), @capacity);
        if planned.IsError() {
            return planned;
        }

        // Into a local first. A failed reallocation leaves the original block valid and the vector's own, so writing
        // the result straight into the field would drop the only pointer to the elements on failure.
        var resized: *var T = null;
        let moved = self.data == null ? AllocateBlock<T>(self.allocator, capacity, @resized)
                                      : ReallocateBlock<T>(self.allocator, self.data, self.capacity, capacity,
                                                           @resized);
        if moved.IsError() {
            return moved;
        }

        self.data = resized;
        self.capacity = capacity;
        return CollectionError::None;
    }

    /// Makes room for `additional` more elements on top of those already present.
    ///
    /// `self` is borrowed mutably; the length does not change. Capacity only grows here; `ShrinkToFit` is what hands
    /// it back. A failure leaves the vector exactly as it was.
    ///
    /// Reports `CapacityOverflow` when the current length plus `additional` cannot be represented, which is what
    /// turns a `Reserve(uint::Max)` on a non-empty vector into a reported error rather than a silently tiny capacity.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/reserve
    func Reserve(self: *var Vector<T>, additional: uint) -> CollectionError {
        var required: uint = 0;
        let total = AddLength(self.length, additional, @required);
        if total.IsError() {
            return total;
        }
        return self.Grow(required);
    }

    /// Releases the capacity past the length.
    ///
    /// `self` is borrowed mutably. A vector with nothing in it gives up its storage entirely and becomes as cheap as
    /// a new one. A failure leaves the vector usable at its current capacity, since failing to hand memory back is
    /// never a reason to stop working.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/shrink-to-fit
    func ShrinkToFit(self: *var Vector<T>) -> CollectionError {
        if self.capacity == self.length {
            return CollectionError::None;
        }
        if self.length == 0 {
            if self.data != null {
                ReleaseBlock<T>(self.allocator, self.data, self.capacity);
                self.data = null;
                self.capacity = 0;
            }
            return CollectionError::None;
        }

        var resized: *var T = null;
        let moved = ReallocateBlock<T>(self.allocator, self.data, self.capacity, self.length, @resized);
        if moved.IsError() {
            return moved;
        }
        self.data = resized;
        self.capacity = self.length;
        return CollectionError::None;
    }

    /// Destroys every element, keeping the storage.
    ///
    /// `self` is borrowed mutably. The vector is empty afterwards and can be refilled without allocating again.
    ///
    /// Runs in time proportional to the length.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/clear
    func Clear(self: *var Vector<T>) {
        self.Truncate(0);
    }

    /// Destroys the elements past `length`, keeping the storage.
    ///
    /// `self` is borrowed mutably. A `length` at or past the current one changes nothing, so this never grows.
    ///
    /// This is the other half of the `Rux/Algorithms` seam: `Unique`, `RemoveWhere`, `RemoveValue` and `Partition`
    /// compact survivors toward the front and report the surviving length without resizing anything, and this is how
    /// a vector is told about it.
    ///
    /// Runs in time proportional to how many elements go.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/truncate
    func Truncate(self: *var Vector<T>, length: uint) {
        if length >= self.length {
            return;
        }
        var index = length;
        while index < self.length {
            // Moving each element into a local destroys it when the local's life ends -- the same mechanism `Array`
            // uses, and the only one a container has for an element it does not know is droppable.
            let taken = self.data[index];
            index++;
        }
        self.length = length;
    }
}

extend Vector<T> : Drop {
    /// Destroys every element and releases the storage.
    ///
    /// Runs when the vector's life ends. The spare capacity past the length holds nothing and is not touched; the
    /// elements go first and the block second, since an element destroyed after its storage was released would be
    /// read from freed memory.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/drop
    func Drop(self: *var Vector<T>) {
        self.Truncate(0);
        if self.data != null {
            ReleaseBlock<T>(self.allocator, self.data, self.capacity);
            self.data = null;
            self.capacity = 0;
        }
    }
}

extend Vector<T> {
    /// Appends one element, growing the storage when it is full.
    ///
    /// `self` is borrowed mutably; `value` is read by value and moved into the vector. A failure leaves the vector
    /// exactly as it was and the value with the caller.
    ///
    /// Amortized constant time: the doubling is what spreads the cost of growing across the appends that caused it.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/push
    func Push(self: *var Vector<T>, value: T) -> CollectionError {
        if self.length == self.capacity {
            var required: uint = 0;
            let total = AddLength(self.length, 1, @required);
            if total.IsError() {
                return total;
            }
            let room = self.Grow(required);
            if room.IsError() {
                return room;
            }
        }
        self.data[self.length] = value;
        self.length = self.length + 1;
        return CollectionError::None;
    }

    /// Appends a copy of every element of `items`, in order.
    ///
    /// `self` is borrowed mutably; `items` is borrowed and read. Room for all of them is taken first, so this either
    /// appends every element or none of them.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/push-slice
    func PushSlice(self: *var Vector<T>, items: Slice<T>) -> CollectionError {
        if items.length == 0 {
            return CollectionError::None;
        }
        let room = self.Reserve(items.length);
        if room.IsError() {
            return room;
        }
        var index: uint = 0;
        while index < items.length {
            self.data[self.length + index] = items.data[index];
            index++;
        }
        self.length = self.length + items.length;
        return CollectionError::None;
    }

    /// Takes the last element out of the vector.
    ///
    /// `self` is borrowed mutably; `value` receives the element, which is moved out rather than copied, so this is
    /// how an element that owns something leaves a vector without being destroyed. Reports false and writes nothing
    /// when the vector is empty.
    ///
    /// The storage is kept, so a vector emptied this way costs nothing to refill.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/try-pop
    func TryPop(self: *var Vector<T>, value: *var T) -> bool {
        if self.length == 0 || value == null {
            return false;
        }
        self.length = self.length - 1;
        *value = self.data[self.length];
        return true;
    }

    /// The element at `index`, or `None` when there is no such index.
    ///
    /// `self` is borrowed; the element is returned by copy.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/get
    func Get(self: *Vector<T>, index: uint) -> Option<T> {
        if index >= self.length {
            return Option::None<T>();
        }
        return Option::Some<T>(self.data[index]);
    }

    /// A pointer to the element at `index`, or `None` when there is no such index.
    ///
    /// `self` is borrowed; the pointer borrows the element where it sits.
    ///
    /// # Safety
    ///
    /// The pointer is valid until the vector grows, shrinks, or is destroyed.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/reference
    func Reference(self: *Vector<T>, index: uint) -> Option<*T> {
        if index >= self.length {
            return Option::None<*T>();
        }
        return Option::Some<*T>(@self.data[index]);
    }

    /// Replaces the element at `index` with `value`.
    ///
    /// `self` is borrowed mutably. Reports `IndexOutOfRange` and changes nothing when there is no such index.
    ///
    /// # Safety
    ///
    /// The old element is overwritten rather than destroyed. For an element that owns something, take it out first.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/set
    func Set(self: *var Vector<T>, index: uint, value: T) -> CollectionError {
        if index >= self.length {
            return CollectionError::IndexOutOfRange;
        }
        self.data[index] = value;
        return CollectionError::None;
    }

    /// The initialized elements as a borrowed read-only view.
    ///
    /// `self` is borrowed. Never the spare capacity, which holds nothing.
    ///
    /// # Safety
    ///
    /// The view is valid until the vector grows, shrinks, or is destroyed.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/as-slice
    func AsSlice(self: *Vector<T>) -> Slice<T> {
        return Slice<T> { data: self.data, length: self.length };
    }

    /// The initialized elements as a borrowed writable view.
    ///
    /// `self` is borrowed mutably. Never the spare capacity.
    ///
    /// # Safety
    ///
    /// The view is valid until the vector grows, shrinks, or is destroyed.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/as-mutable-slice
    func AsMutableSlice(self: *var Vector<T>) -> MutableSlice<T> {
        return MutableSlice<T> { data: self.data, length: self.length };
    }

    /// An iterator over the elements, by copy.
    ///
    /// `self` is borrowed and must outlive the iterator. This is the method a `for` loop finds.
    ///
    /// # Safety
    ///
    /// The vector must not grow or shrink while the iterator is alive.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/iterate
    func Iterate(self: *Vector<T>) -> ValueIterator<T> {
        return ValueIterator::New<T>(self.AsSlice());
    }

    /// An iterator over pointers to the elements.
    ///
    /// `self` is borrowed and must outlive the iterator.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/references
    func References(self: *Vector<T>) -> ReferenceIterator<T> {
        return ReferenceIterator::New<T>(self.AsSlice());
    }
}

extend Vector<T> {
    /// Inserts `value` at `index`, moving everything from there on one place along.
    ///
    /// `self` is borrowed mutably; `value` is moved in. An `index` equal to the length appends, which is what makes
    /// the rejection above it a boundary rather than a blanket refusal; anything past that reports
    /// `IndexOutOfRange` and changes nothing.
    ///
    /// Runs in time proportional to how many elements follow the insertion point.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/insert
    func Insert(self: *var Vector<T>, index: uint, value: T) -> CollectionError {
        if index > self.length {
            return CollectionError::IndexOutOfRange;
        }
        if index == self.length {
            return self.Push(value);
        }

        let room = self.Reserve(1);
        if room.IsError() {
            return room;
        }
        // Backwards, so each element is read before the one that overwrites it.
        var position = self.length;
        while position > index {
            self.data[position] = self.data[position - 1];
            position = position - 1;
        }
        self.data[index] = value;
        self.length = self.length + 1;
        return CollectionError::None;
    }

    /// Takes the element at `index` out, moving everything after it one place back.
    ///
    /// `self` is borrowed mutably. The element is moved out and handed to the caller rather than destroyed, so an
    /// element that owns something leaves intact. Reports `None` and changes nothing when there is no such index.
    ///
    /// Order is preserved, which is what separates this from `SwapRemoveAt`. Runs in time proportional to how many
    /// elements follow the one removed.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/remove-at
    func RemoveAt(self: *var Vector<T>, index: uint) -> Option<T> {
        if index >= self.length {
            return Option::None<T>();
        }
        let removed = self.data[index];
        var position = index;
        while position + 1 < self.length {
            self.data[position] = self.data[position + 1];
            position = position + 1;
        }
        self.length = self.length - 1;
        return Option::Some<T>(removed);
    }

    /// Takes the element at `index` out and moves the last one into its place.
    ///
    /// `self` is borrowed mutably. The element is moved out and handed to the caller. Reports `None` and changes
    /// nothing when there is no such index.
    ///
    /// Order is *not* preserved -- whatever was last now sits where the removed element was -- and that is the whole
    /// point: this is constant time where `RemoveAt` is linear, and for a sequence nobody is reading in order the
    /// difference is free.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/swap-remove-at
    func SwapRemoveAt(self: *var Vector<T>, index: uint) -> Option<T> {
        if index >= self.length {
            return Option::None<T>();
        }
        let removed = self.data[index];
        let last = self.length - 1;
        if index != last {
            self.data[index] = self.data[last];
        }
        self.length = last;
        return Option::Some<T>(removed);
    }

    /// A pointer to the first element, or `None` for an empty vector.
    ///
    /// `self` is borrowed; the pointer borrows the element where it sits.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/first
    func First(self: *Vector<T>) -> Option<*T> {
        return self.Reference(0);
    }

    /// A pointer to the last element, or `None` for an empty vector.
    ///
    /// `self` is borrowed; the pointer borrows the element where it sits.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/last
    func Last(self: *Vector<T>) -> Option<*T> {
        if self.length == 0 {
            return Option::None<*T>();
        }
        return self.Reference(self.length - 1);
    }

    /// A borrowed read-only view of `count` elements starting at `start`.
    ///
    /// `self` is borrowed. A `start` at or past the length gives an empty view, and a `count` running past the end is
    /// clamped, so the result never covers storage the vector does not hold.
    ///
    /// # Safety
    ///
    /// The view is valid until the vector grows, shrinks, or is destroyed.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/slice
    func Slice(self: *Vector<T>, start: uint, count: uint) -> Slice<T> {
        if start >= self.length || count == 0 {
            return Slice<T> { data: null, length: 0 };
        }
        var taken = count;
        let available = self.length - start;
        if taken > available {
            taken = available;
        }
        return Slice<T> { data: @self.data[start], length: taken };
    }

    /// A borrowed writable view of `count` elements starting at `start`.
    ///
    /// `self` is borrowed mutably. Clamped exactly as `Slice` is.
    ///
    /// # Safety
    ///
    /// The view is valid until the vector grows, shrinks, or is destroyed.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/mutable-slice
    func MutableSliceOf(self: *var Vector<T>, start: uint, count: uint) -> MutableSlice<T> {
        if start >= self.length || count == 0 {
            return MutableSlice<T> { data: null, length: 0 };
        }
        var taken = count;
        let available = self.length - start;
        if taken > available {
            taken = available;
        }
        return MutableSlice<T> { data: @self.data[start], length: taken };
    }
}

/// An iterator that takes a vector apart, yielding each element by value.
///
/// Move-only: it owns the storage the vector owned, so it implements `Drop`. This is how a vector of elements that
/// own something is emptied into somewhere else -- each element is moved out rather than copied, and whatever is
/// left when the iterator's life ends is destroyed with it.
///
/// https://rux-lang.dev/docs/api/collections/vector-into-iterator
struct VectorIntoIterator<T> {
    /// The storage taken from the vector.
    data: *var T;
    /// How many elements it holds.
    length: uint;
    /// How many the storage could hold, kept so the block is released with the layout it was taken under.
    capacity: uint;
    /// How many have been yielded.
    position: uint;
    /// Where the storage goes back to.
    allocator: Allocator;
}

extend VectorIntoIterator<T> {
    /// The next element, moved out, or `None` once every element has been yielded.
    ///
    /// `self` is borrowed mutably and advanced. The element is moved rather than copied, so it is the caller's to
    /// keep or destroy; an exhausted iterator keeps reporting `None`.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector-into-iterator/next
    func Next(self: *var VectorIntoIterator<T>) -> Option<T> {
        if self.position >= self.length {
            return Option::None<T>();
        }
        let taken = self.data[self.position];
        self.position = self.position + 1;
        return Option::Some<T>(taken);
    }
}

extend VectorIntoIterator<T> : Iterator {}

extend VectorIntoIterator<T> : Drop {
    /// Destroys whatever was not yielded and releases the storage.
    ///
    /// Runs when the iterator's life ends. Everything already yielded belongs to whoever took it and is not touched
    /// here, which is what makes stopping part-way through safe.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector-into-iterator/drop
    func Drop(self: *var VectorIntoIterator<T>) {
        var index = self.position;
        while index < self.length {
            let taken = self.data[index];
            index++;
        }
        if self.data != null {
            ReleaseBlock<T>(self.allocator, self.data, self.capacity);
            self.data = null;
        }
        self.length = 0;
        self.position = 0;
    }
}

extend Vector<T> {
    /// Takes the vector apart into an iterator over its elements.
    ///
    /// Consumes the vector: it is moved into the iterator, and the storage goes with it, so nothing is copied and
    /// nothing is reallocated. Each element comes out by value, which is how one that owns something leaves.
    ///
    /// Whatever is not taken is destroyed when the iterator's life ends.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/into-iterator
    func IntoIterator(self: Vector<T>) -> VectorIntoIterator<T> {
        // Into a local first, and emptied before it goes out of scope. The receiver is a live binding until the
        // function ends, so a vector left holding the pointer would have its destructor release the very storage the
        // iterator was just handed.
        var vector = self;
        let taken = VectorIntoIterator<T> {
            data: vector.data,
            length: vector.length,
            capacity: vector.capacity,
            position: 0,
            allocator: vector.allocator
        };
        vector.data = null;
        vector.length = 0;
        vector.capacity = 0;
        return taken;
    }

    /// Copies the elements into a fixed-length array.
    ///
    /// `self` is borrowed and keeps its own storage, so both are released independently; `error` is written with why
    /// the array could not be made. Copies its elements, so this is for element types where copying means what it
    /// says -- `IntoArray` is what moves them.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/to-array
    func ToArray(self: *Vector<T>, error: *var CollectionError) -> Array<T> {
        return Array::FromSlice<T>(self.allocator, self.AsSlice(), error);
    }

    /// Hands the storage itself to a fixed-length array, copying nothing.
    ///
    /// Consumes the vector; `error` is written with why the transfer could not happen. The spare capacity is trimmed
    /// first, and the trim has to succeed: an array releases its block with the layout of its length, so a block
    /// still carrying spare capacity would be given back under a layout it was not taken with.
    ///
    /// A failed trim is a failed transfer, and the vector is gone either way -- it was consumed by the call -- so
    /// its elements are destroyed and an empty array comes back. That costs the elements, which is why it is
    /// reported rather than silent; a shrink refused by an allocator is close to impossible, since it asks for less
    /// than it already holds.
    ///
    /// https://rux-lang.dev/docs/api/collections/vector/into-array
    func IntoArray(self: Vector<T>, error: *var CollectionError) -> Array<T> {
        var vector = self;
        let trimmed = vector.ShrinkToFit();
        if trimmed.IsError() {
            *error = trimmed;
            return Array<T> { data: null, length: 0, allocator: vector.allocator };
        }

        let taken = Array<T> { data: vector.data, length: vector.length, allocator: vector.allocator };
        vector.data = null;
        vector.length = 0;
        vector.capacity = 0;
        *error = CollectionError::None;
        return taken;
    }
}
