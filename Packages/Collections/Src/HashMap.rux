// An associative table: keys to values, in no particular order, with constant expected time for everything.
//
// Built on the `Table` kernel, so the probing, the displacement and the deletion are described there rather than
// here. What this adds is the pair of callbacks that give a key type its identity, and the operations a caller
// actually names.
//
// The hash and equality are supplied rather than taken from the key type, because Rux has no closures and an
// interface value would be stored and dispatched through on every lookup. `Hashing` has ready-made pairs for the
// usual key types; a caller keying on its own type writes them, and the one rule is that keys comparing equal must
// hash the same.
//
// The hash is seeded, and the seed is drawn from `Rux/Entropy` unless the caller supplies one. That is what stops an
// adversary who chooses keys from computing a few thousand that collide and turning every lookup into a scan.
//
// A map owns its keys and values, so it implements `Drop` and is move-only. Entries are destroyed when the map is,
// when they are cleared, and when they are replaced -- but not when they are removed, which hands the value back
// instead.

import Allocator::Allocator;
import Core::{ Iterator, Option };

/// A hash table from keys to values.
///
/// Move-only: it owns its entries and its storage, so it implements `Drop`.
///
/// https://rux-lang.dev/docs/api/collections/hash-map
struct HashMap<K, V> {
    /// The slots, the probing and the entries.
    table: Table<K, V>;
    /// What a key's hash is, given the table's seed.
    hash: func(K, uint64, uint64) -> uint64;
    /// Whether two keys are the same key.
    equals: func(K, K) -> bool;
}

extend HashMap<K, V> {
    /// An empty map that has not allocated anything, with a seed drawn from the operating system.
    ///
    /// `allocator` is borrowed for the call and kept. A program making many maps should draw one seed with
    /// `TableSeed::Random` and use `WithSeed`, since each draw here is a system call.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/new
    func New(allocator: Allocator, hash: func(K, uint64, uint64) -> uint64,
             equals: func(K, K) -> bool) -> HashMap<K, V> {
        return HashMap::WithSeed<K, V>(allocator, TableSeed::Random(), hash, equals);
    }

    /// An empty map that has not allocated anything, hashing with `seed`.
    ///
    /// `allocator` is borrowed for the call and kept; `seed` is read by value. Two maps sharing a seed hash alike,
    /// which is what a caller drawing one seed for many maps wants and what a test needing the same table twice
    /// needs.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/with-seed
    func WithSeed(allocator: Allocator, seed: TableSeed, hash: func(K, uint64, uint64) -> uint64,
                  equals: func(K, K) -> bool) -> HashMap<K, V> {
        return HashMap<K, V> { table: Table::New<K, V>(allocator, seed), hash: hash, equals: equals };
    }

    /// An empty map with room for `capacity` entries already taken.
    ///
    /// `error` is written with why the room could not be taken. The capacity actually taken is rounded up to a power
    /// of two above the load factor, so it is larger than asked for.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/with-capacity
    func WithCapacity(allocator: Allocator, capacity: uint, hash: func(K, uint64, uint64) -> uint64,
                      equals: func(K, K) -> bool, error: *var CollectionError) -> HashMap<K, V> {
        var map = HashMap::New<K, V>(allocator, hash, equals);
        *error = map.Reserve(capacity);
        return map;
    }

    /// How many entries the map holds.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/length
    func Length(self: *HashMap<K, V>) -> uint {
        return self.table.Length();
    }

    /// How many slots the table has.
    ///
    /// Not how many entries fit: a quarter of the slots are kept free, because a table run fuller spends its time
    /// displacing entries rather than storing them.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/capacity
    func Capacity(self: *HashMap<K, V>) -> uint {
        return self.table.Capacity();
    }

    /// Whether the map holds no entries.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/is-empty
    func IsEmpty(self: *HashMap<K, V>) -> bool {
        return self.table.IsEmpty();
    }

    /// Whether the map has an entry for `key`.
    ///
    /// `self` is borrowed; `key` is read by value.
    ///
    /// Runs in constant expected time and allocates nothing.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/contains-key
    func ContainsKey(self: *HashMap<K, V>, key: K) -> bool {
        return self.table.Find(key, self.hash, self.equals).IsSome();
    }

    /// The value stored under `key`, or `None` when there is no such entry.
    ///
    /// `self` is borrowed; the value is returned by copy.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/get
    func Get(self: *HashMap<K, V>, key: K) -> Option<V> {
        var slot: uint = 0;
        if !self.table.Find(key, self.hash, self.equals).TryIntoValue(@slot) {
            return Option::None<V>();
        }
        return Option::Some<V>(self.table.values[slot]);
    }

    /// A pointer to the value stored under `key`, or `None` when there is no such entry.
    ///
    /// `self` is borrowed; the pointer borrows the value where it sits, which is how one that owns something is read
    /// without being taken.
    ///
    /// # Safety
    ///
    /// The pointer is valid until the map grows, shrinks, or has anything inserted or removed.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/reference
    func Reference(self: *HashMap<K, V>, key: K) -> Option<*V> {
        var slot: uint = 0;
        if !self.table.Find(key, self.hash, self.equals).TryIntoValue(@slot) {
            return Option::None<*V>();
        }
        return Option::Some<*V>(@self.table.values[slot]);
    }

    /// Points `value` at the stored value for `key`, so it can be changed in place.
    ///
    /// `self` is borrowed mutably; `value` receives the pointer and is left alone when there is no such entry.
    /// Reports whether there was one.
    ///
    /// An out-parameter rather than an `Option<*var V>`, which does not survive lowering inside a generic today.
    ///
    /// # Safety
    ///
    /// The pointer is valid until the map grows, shrinks, or has anything inserted or removed. Overwriting through
    /// it replaces the value without destroying what was there.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/try-reference-mutable
    func TryReferenceMutable(self: *var HashMap<K, V>, key: K, value: *var *var V) -> bool {
        var slot: uint = 0;
        if !self.table.Find(key, self.hash, self.equals).TryIntoValue(@slot) {
            return false;
        }
        *value = @self.table.values[slot];
        return true;
    }
}

extend HashMap<K, V> {
    /// Stores `value` under `key`, replacing whatever was there.
    ///
    /// `self` is borrowed mutably; both are moved in. A key already present keeps its stored key and takes the new
    /// value, and the value it had is destroyed -- use `Remove` first where the old one is wanted.
    ///
    /// A failure leaves the map exactly as it was and both arguments with the caller.
    ///
    /// Runs in constant expected time.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/insert
    func Insert(self: *var HashMap<K, V>, key: K, value: V) -> CollectionError {
        var slot: uint = 0;
        if self.table.Find(key, self.hash, self.equals).TryIntoValue(@slot) {
            // Reading the old value into a local destroys it when the local's life ends, which is what keeps a
            // replaced value from being leaked.
            let replaced = self.table.values[slot];
            self.table.values[slot] = value;
            return CollectionError::None;
        }

        let room = self.table.EnsureRoom(self.hash);
        if room.IsError() {
            return room;
        }
        if self.table.Place(key, value, self.hash).IsNone() {
            // The table has room and the probe still ran past what a distance byte holds, so these keys collide
            // badly enough that a larger table would spread the same collisions over more slots.
            return CollectionError::Unsupported;
        }
        return CollectionError::None;
    }

    /// Takes the entry for `key` out and hands back its value.
    ///
    /// `self` is borrowed mutably. The value is moved out rather than destroyed, so one that owns something leaves
    /// intact; the key is destroyed, having no other owner. Reports `None` when there is no such entry.
    ///
    /// The gap closes behind the entry, so the table is left exactly as if it had never been inserted.
    ///
    /// Runs in constant expected time.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/remove
    func Remove(self: *var HashMap<K, V>, key: K) -> Option<V> {
        var slot: uint = 0;
        if !self.table.Find(key, self.hash, self.equals).TryIntoValue(@slot) {
            return Option::None<V>();
        }
        let takenKey = self.table.keys[slot];
        let takenValue = self.table.values[slot];
        self.table.Vacate(slot);
        return Option::Some<V>(takenValue);
    }

    /// Makes room for `additional` more entries on top of those already present.
    ///
    /// `self` is borrowed mutably; the length does not change. A failure leaves the map exactly as it was.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/reserve
    func Reserve(self: *var HashMap<K, V>, additional: uint) -> CollectionError {
        return self.table.Reserve(additional, self.hash);
    }

    /// Releases the capacity the entry count does not need.
    ///
    /// `self` is borrowed mutably. An empty map gives up its storage entirely.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/shrink-to-fit
    func ShrinkToFit(self: *var HashMap<K, V>) -> CollectionError {
        return self.table.ShrinkToFit(self.hash);
    }

    /// Destroys every entry, keeping the storage.
    ///
    /// `self` is borrowed mutably. Runs in time proportional to the capacity.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/clear
    func Clear(self: *var HashMap<K, V>) {
        self.table.Clear();
    }

    /// Walks to the next occupied slot at or after `cursor`, reporting the entry it holds.
    ///
    /// `self` is borrowed; `cursor` is read and advanced past whatever is reported, so a caller starts it at zero
    /// and keeps calling. `key` and `value` receive copies and are left alone when this reports false.
    ///
    /// The order is the table's, which is the seed's and not the insertion's. Nothing may be inserted or removed
    /// while a walk is in progress: either moves entries between slots, and a cursor is a slot.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/try-next-entry
    func TryNextEntry(self: *HashMap<K, V>, cursor: *var uint, key: *var K, value: *var V) -> bool {
        var index = *cursor;
        while index < self.table.Capacity() {
            if self.table.IsOccupied(index) {
                if key != null {
                    *key = self.table.keys[index];
                }
                if value != null {
                    *value = self.table.values[index];
                }
                *cursor = index + 1;
                return true;
            }
            index++;
        }
        *cursor = index;
        return false;
    }
}

/// One entry of a map, as a value a caller can hold.
///
/// What a walk yields and what a consuming iteration hands back. Two fields rather than a pair, because `entry.key`
/// says which is which and `entry.0` does not.
///
/// https://rux-lang.dev/docs/api/collections/key-value
struct KeyValue<K, V> {
    /// The key the entry was stored under.
    key: K;
    /// The value stored under it.
    value: V;
}

extend HashMap<K, V> {
    /// Points `existing` at the value stored under `key`, inserting `value` first when there is none.
    ///
    /// `self` is borrowed mutably; `key` and `value` are moved in only when there was no entry, and destroyed
    /// otherwise -- the map keeps what it already had. `existing` receives a pointer to the stored value either way,
    /// and `inserted` receives whether the map grew; both may be null.
    ///
    /// This is what an entry API is for, without pretending Rux has closures: a caller that wants to read a value or
    /// put one there gets one operation instead of a lookup followed by an insertion, and does not have to name the
    /// key twice.
    ///
    /// A failure leaves the map exactly as it was.
    ///
    /// # Safety
    ///
    /// The pointer is valid until the map grows, shrinks, or has anything inserted or removed.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/get-or-insert
    func GetOrInsert(self: *var HashMap<K, V>, key: K, value: V, existing: *var *var V,
                     inserted: *var bool) -> CollectionError {
        var slot: uint = 0;
        if self.table.Find(key, self.hash, self.equals).TryIntoValue(@slot) {
            if existing != null {
                *existing = @self.table.values[slot];
            }
            if inserted != null {
                *inserted = false;
            }
            return CollectionError::None;
        }

        let room = self.table.EnsureRoom(self.hash);
        if room.IsError() {
            return room;
        }
        var placed: uint = 0;
        if !self.table.Place(key, value, self.hash).TryIntoValue(@placed) {
            return CollectionError::Unsupported;
        }
        if existing != null {
            *existing = @self.table.values[placed];
        }
        if inserted != null {
            *inserted = true;
        }
        return CollectionError::None;
    }

    /// Stores `value` under `key` and hands back the value that was there.
    ///
    /// `self` is borrowed mutably; both are moved in. The old value is moved out rather than destroyed, which is the
    /// difference between this and `Insert`: one hands the previous value back and the other throws it away.
    /// Reports `None` when there was no entry, having inserted this one.
    ///
    /// `error` receives why the insertion could not happen, and is `None` otherwise. A failure leaves the map
    /// exactly as it was and reports `None`, which is why the error is worth reading rather than inferring from the
    /// absence.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/replace
    func Replace(self: *var HashMap<K, V>, key: K, value: V, error: *var CollectionError) -> Option<V> {
        var slot: uint = 0;
        if self.table.Find(key, self.hash, self.equals).TryIntoValue(@slot) {
            let previous = self.table.values[slot];
            self.table.values[slot] = value;
            *error = CollectionError::None;
            return Option::Some<V>(previous);
        }

        let room = self.table.EnsureRoom(self.hash);
        if room.IsError() {
            *error = room;
            return Option::None<V>();
        }
        if self.table.Place(key, value, self.hash).IsNone() {
            *error = CollectionError::Unsupported;
            return Option::None<V>();
        }
        *error = CollectionError::None;
        return Option::None<V>();
    }

    /// Takes the entry for `key` out and hands back both halves of it.
    ///
    /// `self` is borrowed mutably. Both the stored key and the value are moved out, so a key that owns something
    /// leaves intact too -- which `Remove` does not offer, since it destroys the key. Reports `None` when there is
    /// no such entry.
    ///
    /// The stored key is handed back rather than the one that was looked up: the two compare equal, but a key type
    /// carrying anything the equality ignores makes them different values, and the map's is the one that was kept.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/remove-entry
    func RemoveEntry(self: *var HashMap<K, V>, key: K) -> Option<KeyValue<K, V>> {
        var slot: uint = 0;
        if !self.table.Find(key, self.hash, self.equals).TryIntoValue(@slot) {
            return Option::None<KeyValue<K, V>>();
        }
        let takenKey = self.table.keys[slot];
        let takenValue = self.table.values[slot];
        self.table.Vacate(slot);
        return Option::Some<KeyValue<K, V>>(KeyValue<K, V> { key: takenKey, value: takenValue });
    }
}

/// An iterator over the entries of a map, by copy.
///
/// Borrows the map, so the map must outlive it and must not be inserted into or removed from while it is alive:
/// either moves entries between slots, and this walks slots.
///
/// https://rux-lang.dev/docs/api/collections/hash-map-iterator
struct HashMapIterator<K, V> {
    /// The map being walked. Borrowed, never owned.
    map: *HashMap<K, V>;
    /// The slot to look at next.
    cursor: uint;
}

extend HashMapIterator<K, V> {
    /// The next entry, or `None` once every slot has been looked at.
    ///
    /// `self` is borrowed mutably and advanced. The key and value are copies; a map of things that own something is
    /// walked with `TryNextEntry` and a pointer instead.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map-iterator/next
    func Next(self: *var HashMapIterator<K, V>) -> Option<KeyValue<K, V>> {
        var index = self.cursor;
        while index < self.map.table.Capacity() {
            if self.map.table.IsOccupied(index) {
                self.cursor = index + 1;
                return Option::Some<KeyValue<K, V>>(
                    KeyValue<K, V> { key: self.map.table.keys[index], value: self.map.table.values[index] });
            }
            index++;
        }
        self.cursor = index;
        return Option::None<KeyValue<K, V>>();
    }
}

extend HashMapIterator<K, V> : Iterator {}

/// An iterator that takes a map apart, yielding each entry by value.
///
/// Move-only: it owns the storage the map owned. Whatever is left when its life ends is destroyed with it, which is
/// what makes stopping part-way safe.
///
/// https://rux-lang.dev/docs/api/collections/hash-map-into-iterator
struct HashMapIntoIterator<K, V> {
    /// The table taken from the map.
    table: Table<K, V>;
    /// The slot to look at next.
    cursor: uint;
}

extend HashMapIntoIterator<K, V> {
    /// The next entry, moved out, or `None` once every slot has been looked at.
    ///
    /// `self` is borrowed mutably and advanced. The slot is emptied as the entry leaves, so what remains for the
    /// destructor is exactly what nobody took.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map-into-iterator/next
    func Next(self: *var HashMapIntoIterator<K, V>) -> Option<KeyValue<K, V>> {
        var index = self.cursor;
        while index < self.table.Capacity() {
            if self.table.IsOccupied(index) {
                let takenKey = self.table.keys[index];
                let takenValue = self.table.values[index];
                self.table.states[index] = SlotEmpty;
                self.table.length = self.table.length - 1;
                self.cursor = index + 1;
                return Option::Some<KeyValue<K, V>>(KeyValue<K, V> { key: takenKey, value: takenValue });
            }
            index++;
        }
        self.cursor = index;
        return Option::None<KeyValue<K, V>>();
    }
}

extend HashMapIntoIterator<K, V> : Iterator {}

extend HashMap<K, V> {
    /// An iterator over the entries, by copy.
    ///
    /// `self` is borrowed and must outlive the iterator. This is the method a `for` loop finds. The order is the
    /// table's, which is the seed's and not the insertion's.
    ///
    /// # Safety
    ///
    /// Nothing may be inserted or removed while the iterator is alive.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/iterate
    func Iterate(self: *HashMap<K, V>) -> HashMapIterator<K, V> {
        return HashMapIterator<K, V> { map: self, cursor: 0 };
    }

    /// Takes the map apart into an iterator over its entries.
    ///
    /// Consumes the map: it is moved into the iterator, and the storage goes with it, so nothing is copied and
    /// nothing is reallocated. Each entry comes out by value, which is how one whose key or value owns something
    /// leaves.
    ///
    /// Whatever is not taken is destroyed when the iterator's life ends.
    ///
    /// https://rux-lang.dev/docs/api/collections/hash-map/into-iterator
    func IntoIterator(self: HashMap<K, V>) -> HashMapIntoIterator<K, V> {
        // Into a local first, and emptied before it goes out of scope: the receiver is a live binding until the
        // function ends, and a map left holding the runs would have its destructor release the very storage the
        // iterator was handed.
        var map = self;
        let taken = HashMapIntoIterator<K, V> {
            table: Table<K, V> {
                keys: map.table.keys,
                values: map.table.values,
                states: map.table.states,
                length: map.table.length,
                capacity: map.table.capacity,
                seed: map.table.seed,
                allocator: map.table.allocator
            },
            cursor: 0
        };
        map.table.keys = null;
        map.table.values = null;
        map.table.states = null;
        map.table.length = 0;
        map.table.capacity = 0;
        return taken;
    }
}
