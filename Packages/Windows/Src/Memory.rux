// Virtual memory: reserving and committing address space, and changing what may be done with it.
//
// Windows separates two things every other supported system runs together. Reserving takes address space without
// backing it; committing gives the reserved range storage. A single call may do both, and an allocator that wants a
// large arena without paying for it up front does them separately.
//
// A failing call here reports null rather than `InvalidHandleValue`, which is the opposite of the file interface.
// The reason is in `GetLastError`.

import Windows::{ Dword, Handle };

/// `MEM_COMMIT`: back the range with storage.
///
/// https://rux-lang.dev/docs/api/windows/mem-commit
#Allow("naming.const")
const MEM_COMMIT: uint32 = 0x00001000;

/// `MEM_RESERVE`: take the address space without backing it.
///
/// A reserved page cannot be touched. Touching one faults exactly as an unmapped page does, which is what makes
/// reservation a cheap way to hold a range for later.
///
/// https://rux-lang.dev/docs/api/windows/mem-reserve
#Allow("naming.const")
const MEM_RESERVE: uint32 = 0x00002000;

/// `MEM_RESET`: the contents are no longer of interest and need not be written to the page file.
///
/// https://rux-lang.dev/docs/api/windows/mem-reset
#Allow("naming.const")
const MEM_RESET: uint32 = 0x00080000;

/// `MEM_RELEASE`: give back the whole reservation, which `VirtualFree` requires a size of zero for.
///
/// https://rux-lang.dev/docs/api/windows/mem-release
#Allow("naming.const")
const MEM_RELEASE: uint32 = 0x00008000;

/// `MEM_DECOMMIT`: take back the storage but keep the reservation.
///
/// https://rux-lang.dev/docs/api/windows/mem-decommit
#Allow("naming.const")
const MEM_DECOMMIT: uint32 = 0x00004000;

/// `PAGE_NOACCESS`: the pages may not be touched at all.
///
/// https://rux-lang.dev/docs/api/windows/page-no-access
#Allow("naming.const")
const PAGE_NOACCESS: uint32 = 0x01;

/// `PAGE_READONLY`: the pages may be read.
///
/// https://rux-lang.dev/docs/api/windows/page-read-only
#Allow("naming.const")
const PAGE_READONLY: uint32 = 0x02;

/// `PAGE_READWRITE`: the pages may be read and written.
///
/// https://rux-lang.dev/docs/api/windows/page-read-write
#Allow("naming.const")
const PAGE_READWRITE: uint32 = 0x04;

/// `PAGE_EXECUTE`: the pages may be executed.
///
/// https://rux-lang.dev/docs/api/windows/page-execute
#Allow("naming.const")
const PAGE_EXECUTE: uint32 = 0x10;

/// `PAGE_EXECUTE_READ`: the pages may be executed and read.
///
/// https://rux-lang.dev/docs/api/windows/page-execute-read
#Allow("naming.const")
const PAGE_EXECUTE_READ: uint32 = 0x20;

/// `PAGE_EXECUTE_READWRITE`: the pages may be executed, read and written.
///
/// What a hardened process refuses, and what an exploit needs. Prefer writing through one protection and executing
/// through another.
///
/// https://rux-lang.dev/docs/api/windows/page-execute-read-write
#Allow("naming.const")
const PAGE_EXECUTE_READWRITE: uint32 = 0x40;

/// `PAGE_GUARD`: the next touch raises a one-shot guard exception and then clears the flag.
///
/// Combined with another protection. This is how a stack grows on Windows.
///
/// https://rux-lang.dev/docs/api/windows/page-guard
#Allow("naming.const")
const PAGE_GUARD: uint32 = 0x100;

#Link("Kernel32.dll")
extern {
    // Reserves, commits, or changes the state of a region of pages
    //
    // Returns the base address of the region, or null on failure. A null address argument lets the system choose,
    // which it does at 64 KiB granularity rather than page granularity.
    // https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtualalloc
    func VirtualAlloc(address: *var opaque, size: uint, allocationType: uint32, protect: uint32) -> *var opaque;

    // Releases, decommits, or both, a region of pages
    //
    // Returns zero on failure. MEM_RELEASE requires a size of zero and the exact base address VirtualAlloc returned;
    // giving it anything else fails rather than releasing part of the region.
    // https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtualfree
    func VirtualFree(address: *var opaque, size: uint, freeType: uint32) -> int32;

    // Changes the protection on a region of committed pages
    //
    // Writes the previous protection through oldProtect, which must not be null. Returns zero on failure.
    // https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtualprotect
    func VirtualProtect(address: *var opaque, size: uint, newProtect: uint32,
                        oldProtect: *var uint32) -> int32;

    // Locks a region into physical memory so it is never written to the page file
    //
    // The way to keep a secret off the disk. The process working-set limit bounds how much may be locked, so this
    // fails for a large region rather than succeeding slowly.
    // https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtuallock
    func VirtualLock(address: *var opaque, size: uint) -> int32;

    // Unlocks a region previously locked into physical memory
    // https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtualunlock
    func VirtualUnlock(address: *var opaque, size: uint) -> int32;
}
