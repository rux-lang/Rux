import Core::{ #target, #Error };
import Sync::SpinLoopHint;

when #target.os {
    .Windows => import Windows::{ GetCurrentThreadId, Sleep, SwitchToThread },
    else => {}
}

/// Suspends the current thread for at least the specified duration in milliseconds.
///
/// https://rux-lang.dev/docs/api/thread/sleep-millis
pub func SleepMillis(milliseconds: uint32) {
    when #target.os {
        .Windows => {
            Sleep(milliseconds);
        },
        else => {
            SpinLoopHint();
        }
    }
}

/// Cooperatively yields the remaining time slice of the current thread to other ready threads.
///
/// https://rux-lang.dev/docs/api/thread/yield
pub func Yield() {
    when #target.os {
        .Windows => {
            SwitchToThread();
        },
        else => {
            SpinLoopHint();
        }
    }
}

/// Returns the unique numeric identifier of the calling thread.
///
/// https://rux-lang.dev/docs/api/thread/current-id
pub func CurrentId() -> uint64 {
    when #target.os {
        .Windows => {
            return GetCurrentThreadId() as uint64;
        },
        else => {
            return 1u64;
        }
    }
}
