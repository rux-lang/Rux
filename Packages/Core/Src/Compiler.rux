// The compiler performing the build, and the version type it reports itself with.
//
// `#compiler` is what a package uses to require a language feature rather than to guess at one from a version
// number, which is what `HasFeature` is for. `SemanticVersion` lives here because the compiler's version is the
// first thing that needed one; it is an ordinary value type usable for any version.

/// A semantic version, as its three numeric core components.
///
/// Carries the core only: a pre-release tag or build metadata is not represented, so two versions differing only in
/// those compare equal. Copy, owns nothing, and allocates nothing.
///
/// Ordered by precedence, major component first, as semantic versioning defines it.
///
/// @see https://rux-lang.dev/docs/api/core/semantic-version
pub struct SemanticVersion {
    /// The major component, which changes when compatibility does.
    pub major: uint;
    /// The minor component.
    pub minor: uint;
    /// The patch component.
    pub patch: uint;
}

extend SemanticVersion {
    /// Constructs a version with the given components.
    ///
    /// All three are read by value; the version is returned by copy and borrows nothing.
    ///
    /// Cannot fail: every triple of components is a version. Runs in constant time and allocates nothing.
    ///
    /// @param major the major version
    /// @param minor the minor version
    /// @param patch the patch version
    /// @returns the version
    /// @see https://rux-lang.dev/docs/api/core/semantic-version
    pub func SemanticVersion(major: uint, minor: uint, patch: uint) -> SemanticVersion {
        return SemanticVersion { major: major, minor: minor, patch: patch };
    }

    /// Compares precedence with `other`.
    ///
    /// `self` is borrowed and `other` is read by value. Returns a negative value when `self` precedes `other`, zero
    /// when the two have the same precedence, and a positive value when `self` follows it. Components are compared
    /// major first, and the first difference decides.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns how this value orders against `other`
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/compare
    pub func Compare(self: &SemanticVersion, other: SemanticVersion) -> int {
        if self.major < other.major { return -1; }
        if self.major > other.major { return 1; }
        if self.minor < other.minor { return -1; }
        if self.minor > other.minor { return 1; }
        if self.patch < other.patch { return -1; }
        if self.patch > other.patch { return 1; }
        return 0;
    }

    /// Whether the two versions have the same precedence.
    ///
    /// `self` is borrowed and `other` is read by value. Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether the two versions are the same
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/is-equal-to
    pub func IsEqualTo(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) == 0;
    }

    /// Whether this version precedes `other`.
    ///
    /// `self` is borrowed and `other` is read by value. Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether this version is older
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/is-less-than
    pub func IsLessThan(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) < 0;
    }

    /// Whether this version precedes `other` or matches it.
    ///
    /// `self` is borrowed and `other` is read by value. Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether this version is the same or older
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/is-at-most
    pub func IsAtMost(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) <= 0;
    }

    /// Whether this version follows `other`.
    ///
    /// `self` is borrowed and `other` is read by value. Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether this version is newer
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/is-greater-than
    pub func IsGreaterThan(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) > 0;
    }

    /// Whether this version follows `other` or matches it, which is how a minimum requirement is written.
    ///
    /// `self` is borrowed and `other` is read by value. Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether this version is the same or newer
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/is-at-least
    pub func IsAtLeast(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) >= 0;
    }

    /// Equality by precedence, the operator spelling of `IsEqualTo`.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether the two are equal
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/equals
    pub func ==(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) == 0;
    }

    /// Inequality by precedence.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether the two differ
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/not-equals
    pub func !=(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) != 0;
    }

    /// Precedence ordering, the operator spelling of `IsLessThan`.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether this one is less
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/less-than
    pub func <(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) < 0;
    }

    /// Precedence ordering, the operator spelling of `IsAtMost`.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether this one is less or equal
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/less-than-or-equal
    pub func <=(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) <= 0;
    }

    /// Precedence ordering, the operator spelling of `IsGreaterThan`.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether this one is greater
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/greater-than
    pub func >(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) > 0;
    }

    /// Precedence ordering, the operator spelling of `IsAtLeast`.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param other the value to compare against
    /// @returns whether this one is greater or equal
    /// @see https://rux-lang.dev/docs/api/core/semantic-version/greater-than-or-equal
    pub func >=(self: &SemanticVersion, other: SemanticVersion) -> bool {
        return self.Compare(other) >= 0;
    }
}

/// Properties of the compiler performing the build.
///
/// Fixed when compiling begins. Reading a field produces no runtime code.
///
/// @see https://rux-lang.dev/docs/api/core/compiler
pub struct Compiler {
    /// The compiler's own version.
    pub version: SemanticVersion;
}

extend Compiler {
    /// Whether this compiler provides the named language or library feature.
    ///
    /// `self` is borrowed and `feature` must be a string literal, since this is answered while compiling. Prefer it
    /// to comparing `version`: a feature name says what the code needs, and stays right when the feature arrives in a
    /// release the comparison did not anticipate.
    ///
    /// Cannot fail: an unknown name is absent rather than an error. Costs nothing in the built program.
    ///
    /// @param feature the feature's name
    /// @returns whether this compiler reports that feature
    /// @see https://rux-lang.dev/docs/api/core/compiler/has-feature
    pub intrinsic func HasFeature(self: &Compiler, feature: char8[..]) -> bool;
}

/// The compiler performing the build, as a compile-time value.
///
/// @see https://rux-lang.dev/docs/api/core/compiler
pub intrinsic #compiler: Compiler;
