// A borrowed, writable view over a run of contiguous elements. It owns
// nothing, so the storage has to outlive the view. Slice is the read-only
// counterpart and AsSlice converts to it; the reverse is deliberately not
// offered, because widening a read-only pointer would discard its guarantee.
//
// Unlike Slice, this is an ordinary struct rather than a compiler built-in: it
// has no `values[i]` indexing, no `values[1..3]` sub-slicing and no `for x in`
// support. Use At, Set and Sub, or index the data pointer directly.
struct MutableSlice<T> {
    data: *var T;
    length: uint;
}

extend MutableSlice<T> {
    // An empty view over no storage.
    func New() -> MutableSlice<T> {
        return MutableSlice<T> { data: null, length: 0 };
    }

    // A view over length elements starting at data. The caller guarantees the
    // range is initialized and outlives the view.
    func From(data: *var T, length: uint) -> MutableSlice<T> {
        if length == 0 {
            return MutableSlice<T> { data: null, length: 0 };
        }

        return MutableSlice<T> { data: data, length: length };
    }

    func Length(self) -> uint {
        return self.length;
    }

    func IsEmpty(self) -> bool {
        return self.length == 0;
    }

    // Returns the element at index. Like pointer and slice indexing, this is
    // unchecked; callers must keep index below Length.
    func At(self, index: uint) -> T {
        return self.data[index];
    }

    // Replaces the element at index. Indexing is unchecked, as in At.
    func Set(self, index: uint, value: T) {
        self.data[index] = value;
    }

    // Exchanges two elements. Both indices are unchecked, and swapping an
    // index with itself is a no-op.
    func Swap(self, first: uint, second: uint) {
        if first == second {
            return;
        }

        let temp = self.data[first];
        self.data[first] = self.data[second];
        self.data[second] = temp;
    }

    // A view over part of the same storage. A start at or past the end gives
    // an empty view, and a length running past the end is clamped, so the
    // result never covers storage this view does not.
    func Sub(self, start: uint, length: uint) -> MutableSlice<T> {
        if start >= self.length || length == 0 {
            return MutableSlice<T> { data: null, length: 0 };
        }

        var count = length;
        let available = self.length - start;
        if count > available {
            count = available;
        }

        // `@self.data[start]` rather than `self.data + start`: pointer
        // arithmetic does not scale by the pointee size for struct element
        // types, while indexing does. See BACKLOG.md.
        return MutableSlice<T> { data: @self.data[start], length: count };
    }

    // Borrows the same storage read-only, without copying it.
    func AsSlice(self) -> Slice<T> {
        return Slice<T> { data: self.data, length: self.length };
    }
}
