/// The compiler representation of int64.
pub intrinsic type int64;

extend int64 {
    /// The number of bits in the representation.
    pub const Bits: uint = 64u;
    /// The number of bytes in the representation.
    pub const Bytes: uint = 8u;
    /// The smallest representable value.
    pub const Min: int64 = -9223372036854775808i64;
    /// The largest representable value.
    pub const Max: int64 = 9223372036854775807i64;
}
