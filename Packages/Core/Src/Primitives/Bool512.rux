// `bool512`: one of two values, stored in 512 bits.
// Every boolean width holds exactly zero or one whatever its size, so a cast into one asks whether the whole source
// value is non-zero rather than truncating to the width first.

/// One of two values, stored in 512 bits.
/// @see https://rux-lang.dev/docs/api/core/booleans#bool512
extend bool512 {
    /// The number of bits in the representation.
    /// @see https://rux-lang.dev/docs/api/core/booleans#bool512-bits
    pub const Bits: uint = 512;
    /// The number of bytes in the representation.
    /// @see https://rux-lang.dev/docs/api/core/booleans#bool512-bytes
    pub const Bytes: uint = 64;
}
