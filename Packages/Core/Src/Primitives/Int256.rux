// `int256`: a signed integer in 256 bits, two's complement.
// The range is asymmetric, as it is at every signed width: the most negative value has no positive counterpart, which
// is behind nearly every edge case in checked arithmetic.

/// A signed integer in 256 bits, two's complement.
/// @see https://rux-lang.dev/docs/api/core/integers#int256
extend int256 {
    /// The number of bits in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-bits
    pub const Bits: uint = 256u;
    /// The number of bytes in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-bytes
    pub const Bytes: uint = 32u;
    /// The smallest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-min
    pub const Min: int256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968i256;
    /// The largest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-max
    pub const Max: int256 = 57896044618658097711785492504343953926634992332820282019728792003956564819967i256;

    // Checked, saturating and truncating arithmetic. `+`, `-`, `*` and `as` stop the program when the value does not
    // fit; these hand that case to the caller instead.

    /// Adds `other` to this value, or reports that the sum does not fit.
    /// Never stops the program: where `+` would, this returns none and the caller decides what an overflow means.
    /// @param other the value to add
    /// @returns the sum, or none when it lies outside the range of `int256`
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-checked-add
    pub func CheckedAdd(&self, other: int256) -> int256? {
        var sum: int256 = 0;
        if AddChecked<int256>(self, other, @sum) { return none; }
        return sum;
    }

    /// Subtracts `other` from this value, or reports that the difference does not fit.
    /// Never stops the program: where `-` would, this returns none.
    /// @param other the value to subtract
    /// @returns the difference, or none when it lies outside the range of `int256`
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-checked-sub
    pub func CheckedSub(&self, other: int256) -> int256? {
        var difference: int256 = 0;
        if SubChecked<int256>(self, other, @difference) { return none; }
        return difference;
    }

    /// Multiplies this value by `other`, or reports that the product does not fit.
    /// Never stops the program: where `*` would, this returns none, which is how a size computed from a count is
    /// checked before it is used.
    /// @param other the value to multiply by
    /// @returns the product, or none when it lies outside the range of `int256`
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-checked-mul
    pub func CheckedMul(&self, other: int256) -> int256? {
        var product: int256 = 0;
        if MulChecked<int256>(self, other, @product) { return none; }
        return product;
    }

    /// Adds `other` to this value, clamping a sum that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to add
    /// @returns the sum, or the limit of `int256` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-saturating-add
    pub func SaturatingAdd(&self, other: int256) -> int256 {
        return AddSaturating<int256>(self, other);
    }

    /// Subtracts `other` from this value, clamping a difference that does not fit to whichever limit it ran past.
    /// Never stops the program.
    /// @param other the value to subtract
    /// @returns the difference, or the limit of `int256` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-saturating-sub
    pub func SaturatingSub(&self, other: int256) -> int256 {
        return SubSaturating<int256>(self, other);
    }

    /// Multiplies this value by `other`, clamping a product that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to multiply by
    /// @returns the product, or the limit of `int256` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-saturating-mul
    pub func SaturatingMul(&self, other: int256) -> int256 {
        return MulSaturating<int256>(self, other);
    }

    /// The low bits of this value at the width of `T`, in two's complement, whether or not the value fits.
    /// Where `as` keeps the value or stops the program, this keeps the bits on purpose, as a hash or an encoder taking
    /// the low byte of a word does. A wider `T` extends the value by the signedness of `int256`, as `as` does.
    /// @typeParam T the integer type to convert to
    /// @returns the low bits of this value as a `T`
    /// @see https://rux-lang.dev/docs/api/core/integers#int256-truncate
    pub intrinsic func Truncate<T>(&self) -> T;
}
