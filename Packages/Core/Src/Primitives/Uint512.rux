// `uint512`: an unsigned integer in 512 bits.
// Wrapping is defined at this width and `Min` is zero, so a subtraction that would go below it wraps rather than
// trapping. Core's checked arithmetic is what reports instead of wrapping.

/// An unsigned integer in 512 bits.
/// @see https://rux-lang.dev/docs/api/core/integers#uint512
extend uint512 {
    /// The number of bits in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-bits
    pub const Bits: uint = 512u;
    /// The number of bytes in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-bytes
    pub const Bytes: uint = 64u;
    /// The smallest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-min
    pub const Min: uint512 = 0u512;
    /// The largest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-max
    pub const Max: uint512 = 13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095u512;

    // Checked, saturating and truncating arithmetic. `+`, `-`, `*` and `as` stop the program when the value does not
    // fit; these hand that case to the caller instead.

    /// Adds `other` to this value, or reports that the sum does not fit.
    /// Never stops the program: where `+` would, this returns none and the caller decides what an overflow means.
    /// @param other the value to add
    /// @returns the sum, or none when it lies outside the range of `uint512`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-checked-add
    pub func CheckedAdd(self: &uint512, other: uint512) -> uint512? {
        var sum: uint512 = 0;
        if AddChecked<uint512>(self, other, @sum) { return none; }
        return sum;
    }

    /// Subtracts `other` from this value, or reports that the difference does not fit.
    /// Never stops the program: where `-` would, this returns none.
    /// @param other the value to subtract
    /// @returns the difference, or none when it lies outside the range of `uint512`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-checked-sub
    pub func CheckedSub(self: &uint512, other: uint512) -> uint512? {
        var difference: uint512 = 0;
        if SubChecked<uint512>(self, other, @difference) { return none; }
        return difference;
    }

    /// Multiplies this value by `other`, or reports that the product does not fit.
    /// Never stops the program: where `*` would, this returns none, which is how a size computed from a count is
    /// checked before it is used.
    /// @param other the value to multiply by
    /// @returns the product, or none when it lies outside the range of `uint512`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-checked-mul
    pub func CheckedMul(self: &uint512, other: uint512) -> uint512? {
        var product: uint512 = 0;
        if MulChecked<uint512>(self, other, @product) { return none; }
        return product;
    }

    /// Adds `other` to this value, clamping a sum that does not fit to the maximum.
    /// Never stops the program.
    /// @param other the value to add
    /// @returns the sum, or the limit of `uint512` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-saturating-add
    pub func SaturatingAdd(self: &uint512, other: uint512) -> uint512 {
        return AddSaturating<uint512>(self, other);
    }

    /// Subtracts `other` from this value, clamping a difference that does not fit to zero.
    /// Never stops the program.
    /// @param other the value to subtract
    /// @returns the difference, or the limit of `uint512` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-saturating-sub
    pub func SaturatingSub(self: &uint512, other: uint512) -> uint512 {
        return SubSaturating<uint512>(self, other);
    }

    /// Multiplies this value by `other`, clamping a product that does not fit to the maximum.
    /// Never stops the program.
    /// @param other the value to multiply by
    /// @returns the product, or the limit of `uint512` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-saturating-mul
    pub func SaturatingMul(self: &uint512, other: uint512) -> uint512 {
        return MulSaturating<uint512>(self, other);
    }

    /// The low bits of this value at the width of `T`, in two's complement, whether or not the value fits.
    /// Where `as` keeps the value or stops the program, this keeps the bits on purpose, as a hash or an encoder taking
    /// the low byte of a word does. A wider `T` extends the value by the signedness of `uint512`, as `as` does.
    /// @typeParam T the integer type to convert to
    /// @returns the low bits of this value as a `T`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint512-truncate
    pub intrinsic func Truncate<T>(self: &uint512) -> T;
}
