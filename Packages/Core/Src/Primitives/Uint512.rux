/// The compiler representation of uint512.
pub intrinsic type uint512;

extend uint512 {
    /// The number of bits in the representation.
    pub const Bits: uint = 512u;
    /// The number of bytes in the representation.
    pub const Bytes: uint = 64u;
    /// The smallest representable value.
    pub const Min: uint512 = 0u512;
    /// The largest representable value.
    pub const Max: uint512 = 13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095u512;
}
