// `int8`: a signed integer in 8 bits, two's complement.
// The range is asymmetric, as it is at every signed width: the most negative value has no positive counterpart, which
// is behind nearly every edge case in checked arithmetic.

/// A signed integer in 8 bits, two's complement.
/// @see https://rux-lang.dev/docs/api/core/integers#int8
extend int8 {
    /// The number of bits in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-bits
    pub const Bits: uint = 8;
    /// The number of bytes in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-bytes
    pub const Bytes: uint = 1;
    /// The smallest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-min
    pub const Min: int8 = -128;
    /// The largest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-max
    pub const Max: int8 = 127;

    // Checked, saturating and truncating arithmetic. `+`, `-`, `*` and `as` stop the program when the value does not
    // fit; these hand that case to the caller instead.

    /// Adds `other` to this value, or reports that the sum does not fit.
    /// Never stops the program: where `+` would, this returns none and the caller decides what an overflow means.
    /// @param other the value to add
    /// @returns the sum, or none when it lies outside the range of `int8`
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-checked-add
    pub func CheckedAdd(self: &int8, other: int8) -> int8? {
        var sum: int8 = 0;
        if AddChecked<int8>(self, other, @sum) { return none; }
        return sum;
    }

    /// Subtracts `other` from this value, or reports that the difference does not fit.
    /// Never stops the program: where `-` would, this returns none.
    /// @param other the value to subtract
    /// @returns the difference, or none when it lies outside the range of `int8`
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-checked-sub
    pub func CheckedSub(self: &int8, other: int8) -> int8? {
        var difference: int8 = 0;
        if SubChecked<int8>(self, other, @difference) { return none; }
        return difference;
    }

    /// Multiplies this value by `other`, or reports that the product does not fit.
    /// Never stops the program: where `*` would, this returns none, which is how a size computed from a count is
    /// checked before it is used.
    /// @param other the value to multiply by
    /// @returns the product, or none when it lies outside the range of `int8`
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-checked-mul
    pub func CheckedMul(self: &int8, other: int8) -> int8? {
        var product: int8 = 0;
        if MulChecked<int8>(self, other, @product) { return none; }
        return product;
    }

    /// Adds `other` to this value, clamping a sum that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to add
    /// @returns the sum, or the limit of `int8` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-saturating-add
    pub func SaturatingAdd(self: &int8, other: int8) -> int8 {
        return AddSaturating<int8>(self, other);
    }

    /// Subtracts `other` from this value, clamping a difference that does not fit to whichever limit it ran past.
    /// Never stops the program.
    /// @param other the value to subtract
    /// @returns the difference, or the limit of `int8` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-saturating-sub
    pub func SaturatingSub(self: &int8, other: int8) -> int8 {
        return SubSaturating<int8>(self, other);
    }

    /// Multiplies this value by `other`, clamping a product that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to multiply by
    /// @returns the product, or the limit of `int8` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-saturating-mul
    pub func SaturatingMul(self: &int8, other: int8) -> int8 {
        return MulSaturating<int8>(self, other);
    }

    /// The low bits of this value at the width of `T`, in two's complement, whether or not the value fits.
    /// Where `as` keeps the value or stops the program, this keeps the bits on purpose, as a hash or an encoder taking
    /// the low byte of a word does. A wider `T` extends the value by the signedness of `int8`, as `as` does.
    /// @typeParam T the integer type to convert to
    /// @returns the low bits of this value as a `T`
    /// @see https://rux-lang.dev/docs/api/core/integers#int8-truncate
    pub intrinsic func Truncate<T>(self: &int8) -> T;
}
