// `bool32`: one of two values, stored in 32 bits.
//
// Every boolean width holds exactly zero or one whatever its size, so a cast into one asks whether the whole source
// value is non-zero rather than truncating to the width first.

/// The compiler representation of bool32.
///
/// @see https://rux-lang.dev/docs/api/core/bool32
pub intrinsic type bool32;

extend bool32 {
    /// The number of bits in the representation.
    ///
    /// @see https://rux-lang.dev/docs/api/core/bool32/bits
    pub const Bits: uint = 32u;
    /// The number of bytes in the representation.
    ///
    /// @see https://rux-lang.dev/docs/api/core/bool32/bytes
    pub const Bytes: uint = 4u;
}
