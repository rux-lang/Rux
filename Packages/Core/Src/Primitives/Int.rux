// `int`: a signed integer the width of a pointer on the target.
// Sixty-four bits on every currently supported target, and one of the two integer types whose width follows the target
// rather than its name. A value that must keep its width across targets should name one that says it.

/// A target pointer-sized signed integer.
/// @see https://rux-lang.dev/docs/api/core/integers#int
extend int {
    /// The target representation width in bits.
    /// @see https://rux-lang.dev/docs/api/core/integers#int-bits
    pub const Bits: uint = sizeof(int) * 8u;
    /// The target representation size in bytes.
    /// @see https://rux-lang.dev/docs/api/core/integers#int-bytes
    pub const Bytes: uint = sizeof(int);
    /// The smallest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int-min
    pub const Min: int = -(((~0u) >> 1u) as int) - 1;
    /// The largest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int-max
    pub const Max: int = ((~0u) >> 1u) as int;

    // Checked, saturating and truncating arithmetic. `+`, `-`, `*` and `as` stop the program when the value does not
    // fit; these hand that case to the caller instead.

    /// Adds `other` to this value, or reports that the sum does not fit.
    /// Never stops the program: where `+` would, this returns none and the caller decides what an overflow means.
    /// @param other the value to add
    /// @returns the sum, or none when it lies outside the range of `int`
    /// @see https://rux-lang.dev/docs/api/core/integers#int-checked-add
    pub func CheckedAdd(&self, other: int) -> int? {
        var sum: int = 0;
        if AddChecked<int>(self, other, @sum) { return none; }
        return sum;
    }

    /// Subtracts `other` from this value, or reports that the difference does not fit.
    /// Never stops the program: where `-` would, this returns none.
    /// @param other the value to subtract
    /// @returns the difference, or none when it lies outside the range of `int`
    /// @see https://rux-lang.dev/docs/api/core/integers#int-checked-sub
    pub func CheckedSub(&self, other: int) -> int? {
        var difference: int = 0;
        if SubChecked<int>(self, other, @difference) { return none; }
        return difference;
    }

    /// Multiplies this value by `other`, or reports that the product does not fit.
    /// Never stops the program: where `*` would, this returns none, which is how a size computed from a count is
    /// checked before it is used.
    /// @param other the value to multiply by
    /// @returns the product, or none when it lies outside the range of `int`
    /// @see https://rux-lang.dev/docs/api/core/integers#int-checked-mul
    pub func CheckedMul(&self, other: int) -> int? {
        var product: int = 0;
        if MulChecked<int>(self, other, @product) { return none; }
        return product;
    }

    /// Adds `other` to this value, clamping a sum that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to add
    /// @returns the sum, or the limit of `int` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int-saturating-add
    pub func SaturatingAdd(&self, other: int) -> int {
        return AddSaturating<int>(self, other);
    }

    /// Subtracts `other` from this value, clamping a difference that does not fit to whichever limit it ran past.
    /// Never stops the program.
    /// @param other the value to subtract
    /// @returns the difference, or the limit of `int` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int-saturating-sub
    pub func SaturatingSub(&self, other: int) -> int {
        return SubSaturating<int>(self, other);
    }

    /// Multiplies this value by `other`, clamping a product that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to multiply by
    /// @returns the product, or the limit of `int` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int-saturating-mul
    pub func SaturatingMul(&self, other: int) -> int {
        return MulSaturating<int>(self, other);
    }

    /// The low bits of this value at the width of `T`, in two's complement, whether or not the value fits.
    /// Where `as` keeps the value or stops the program, this keeps the bits on purpose, as a hash or an encoder taking
    /// the low byte of a word does. A wider `T` extends the value by the signedness of `int`, as `as` does.
    /// @typeParam T the integer type to convert to
    /// @returns the low bits of this value as a `T`
    /// @see https://rux-lang.dev/docs/api/core/integers#int-truncate
    pub intrinsic func Truncate<T>(&self) -> T;
}
