// `uint`: an unsigned integer the width of a pointer on the target.
// Sixty-four bits on every currently supported target. This is the type a length, an index and a size are spelled in.

/// A target pointer-sized unsigned integer.
/// @see https://rux-lang.dev/docs/api/core/integers#uint
extend uint {
    /// The target representation width in bits.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-bits
    pub const Bits: uint = sizeof(uint) * 8u;
    /// The target representation size in bytes.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-bytes
    pub const Bytes: uint = sizeof(uint);
    /// The smallest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-min
    pub const Min: uint = 0u;
    /// The largest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-max
    pub const Max: uint = ~0u;

    // Checked, saturating and truncating arithmetic. `+`, `-`, `*` and `as` stop the program when the value does not
    // fit; these hand that case to the caller instead.

    /// Adds `other` to this value, or reports that the sum does not fit.
    /// Never stops the program: where `+` would, this returns none and the caller decides what an overflow means.
    /// @param other the value to add
    /// @returns the sum, or none when it lies outside the range of `uint`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-checked-add
    pub func CheckedAdd(self: &uint, other: uint) -> uint? {
        var sum: uint = 0;
        if AddChecked<uint>(self, other, @sum) { return none; }
        return sum;
    }

    /// Subtracts `other` from this value, or reports that the difference does not fit.
    /// Never stops the program: where `-` would, this returns none.
    /// @param other the value to subtract
    /// @returns the difference, or none when it lies outside the range of `uint`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-checked-sub
    pub func CheckedSub(self: &uint, other: uint) -> uint? {
        var difference: uint = 0;
        if SubChecked<uint>(self, other, @difference) { return none; }
        return difference;
    }

    /// Multiplies this value by `other`, or reports that the product does not fit.
    /// Never stops the program: where `*` would, this returns none, which is how a size computed from a count is
    /// checked before it is used.
    /// @param other the value to multiply by
    /// @returns the product, or none when it lies outside the range of `uint`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-checked-mul
    pub func CheckedMul(self: &uint, other: uint) -> uint? {
        var product: uint = 0;
        if MulChecked<uint>(self, other, @product) { return none; }
        return product;
    }

    /// Adds `other` to this value, clamping a sum that does not fit to the maximum.
    /// Never stops the program.
    /// @param other the value to add
    /// @returns the sum, or the limit of `uint` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-saturating-add
    pub func SaturatingAdd(self: &uint, other: uint) -> uint {
        return AddSaturating<uint>(self, other);
    }

    /// Subtracts `other` from this value, clamping a difference that does not fit to zero.
    /// Never stops the program.
    /// @param other the value to subtract
    /// @returns the difference, or the limit of `uint` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-saturating-sub
    pub func SaturatingSub(self: &uint, other: uint) -> uint {
        return SubSaturating<uint>(self, other);
    }

    /// Multiplies this value by `other`, clamping a product that does not fit to the maximum.
    /// Never stops the program.
    /// @param other the value to multiply by
    /// @returns the product, or the limit of `uint` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-saturating-mul
    pub func SaturatingMul(self: &uint, other: uint) -> uint {
        return MulSaturating<uint>(self, other);
    }

    /// The low bits of this value at the width of `T`, in two's complement, whether or not the value fits.
    /// Where `as` keeps the value or stops the program, this keeps the bits on purpose, as a hash or an encoder taking
    /// the low byte of a word does. A wider `T` extends the value by the signedness of `uint`, as `as` does.
    /// @typeParam T the integer type to convert to
    /// @returns the low bits of this value as a `T`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint-truncate
    pub intrinsic func Truncate<T>(self: &uint) -> T;
}
