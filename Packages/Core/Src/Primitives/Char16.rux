/// The compiler representation of char16.
pub intrinsic type char16;

extend char16 {
    /// The number of bits in the representation.
    pub const Bits: uint = 16u;
    /// The number of bytes in the representation.
    pub const Bytes: uint = 2u;
    /// The first code unit or Unicode scalar value.
    pub const Min: char16 = 0u32 as char16;
    /// The last code unit or Unicode scalar value.
    pub const Max: char16 = 65535u32 as char16;
}
