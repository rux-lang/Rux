// `uint128`: an unsigned integer in 128 bits.
// Wrapping is defined at this width and `Min` is zero, so a subtraction that would go below it wraps rather than
// trapping. Core's checked arithmetic is what reports instead of wrapping.

/// An unsigned integer in 128 bits.
/// @see https://rux-lang.dev/docs/api/core/integers#uint128
extend uint128 {
    /// The number of bits in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-bits
    pub const Bits: uint = 128u;
    /// The number of bytes in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-bytes
    pub const Bytes: uint = 16u;
    /// The smallest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-min
    pub const Min: uint128 = 0u128;
    /// The largest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-max
    pub const Max: uint128 = 340282366920938463463374607431768211455u128;

    // Checked, saturating and truncating arithmetic. `+`, `-`, `*` and `as` stop the program when the value does not
    // fit; these hand that case to the caller instead.

    /// Adds `other` to this value, or reports that the sum does not fit.
    /// Never stops the program: where `+` would, this returns none and the caller decides what an overflow means.
    /// @param other the value to add
    /// @returns the sum, or none when it lies outside the range of `uint128`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-checked-add
    pub func CheckedAdd(self: &uint128, other: uint128) -> uint128? {
        var sum: uint128 = 0;
        if AddChecked<uint128>(self, other, @sum) { return none; }
        return sum;
    }

    /// Subtracts `other` from this value, or reports that the difference does not fit.
    /// Never stops the program: where `-` would, this returns none.
    /// @param other the value to subtract
    /// @returns the difference, or none when it lies outside the range of `uint128`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-checked-sub
    pub func CheckedSub(self: &uint128, other: uint128) -> uint128? {
        var difference: uint128 = 0;
        if SubChecked<uint128>(self, other, @difference) { return none; }
        return difference;
    }

    /// Multiplies this value by `other`, or reports that the product does not fit.
    /// Never stops the program: where `*` would, this returns none, which is how a size computed from a count is
    /// checked before it is used.
    /// @param other the value to multiply by
    /// @returns the product, or none when it lies outside the range of `uint128`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-checked-mul
    pub func CheckedMul(self: &uint128, other: uint128) -> uint128? {
        var product: uint128 = 0;
        if MulChecked<uint128>(self, other, @product) { return none; }
        return product;
    }

    /// Adds `other` to this value, clamping a sum that does not fit to the maximum.
    /// Never stops the program.
    /// @param other the value to add
    /// @returns the sum, or the limit of `uint128` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-saturating-add
    pub func SaturatingAdd(self: &uint128, other: uint128) -> uint128 {
        return AddSaturating<uint128>(self, other);
    }

    /// Subtracts `other` from this value, clamping a difference that does not fit to zero.
    /// Never stops the program.
    /// @param other the value to subtract
    /// @returns the difference, or the limit of `uint128` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-saturating-sub
    pub func SaturatingSub(self: &uint128, other: uint128) -> uint128 {
        return SubSaturating<uint128>(self, other);
    }

    /// Multiplies this value by `other`, clamping a product that does not fit to the maximum.
    /// Never stops the program.
    /// @param other the value to multiply by
    /// @returns the product, or the limit of `uint128` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-saturating-mul
    pub func SaturatingMul(self: &uint128, other: uint128) -> uint128 {
        return MulSaturating<uint128>(self, other);
    }

    /// The low bits of this value at the width of `T`, in two's complement, whether or not the value fits.
    /// Where `as` keeps the value or stops the program, this keeps the bits on purpose, as a hash or an encoder taking
    /// the low byte of a word does. A wider `T` extends the value by the signedness of `uint128`, as `as` does.
    /// @typeParam T the integer type to convert to
    /// @returns the low bits of this value as a `T`
    /// @see https://rux-lang.dev/docs/api/core/integers#uint128-truncate
    pub intrinsic func Truncate<T>(self: &uint128) -> T;
}
