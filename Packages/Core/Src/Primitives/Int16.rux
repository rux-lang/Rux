// `int16`: a signed integer in 16 bits, two's complement.
//
// The range is asymmetric, as it is at every signed width: the most negative value has no positive counterpart, which
// is behind nearly every edge case in checked arithmetic.

/// The compiler representation of int16.
///
/// @see https://rux-lang.dev/docs/api/core/int16
pub intrinsic type int16;

extend int16 {
    /// The number of bits in the representation.
    ///
    /// @see https://rux-lang.dev/docs/api/core/int16/bits
    pub const Bits: uint = 16u;
    /// The number of bytes in the representation.
    ///
    /// @see https://rux-lang.dev/docs/api/core/int16/bytes
    pub const Bytes: uint = 2u;
    /// The smallest representable value.
    ///
    /// @see https://rux-lang.dev/docs/api/core/int16/min
    pub const Min: int16 = -32768i16;
    /// The largest representable value.
    ///
    /// @see https://rux-lang.dev/docs/api/core/int16/max
    pub const Max: int16 = 32767i16;
}
