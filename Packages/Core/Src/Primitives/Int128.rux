// `int128`: a signed integer in 128 bits, two's complement.
// The range is asymmetric, as it is at every signed width: the most negative value has no positive counterpart, which
// is behind nearly every edge case in checked arithmetic.

/// A signed integer in 128 bits, two's complement.
/// @see https://rux-lang.dev/docs/api/core/integers#int128
extend int128 {
    /// The number of bits in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-bits
    pub const Bits: uint = 128u;
    /// The number of bytes in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-bytes
    pub const Bytes: uint = 16u;
    /// The smallest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-min
    pub const Min: int128 = -170141183460469231731687303715884105728i128;
    /// The largest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-max
    pub const Max: int128 = 170141183460469231731687303715884105727i128;

    // Checked, saturating and truncating arithmetic. `+`, `-`, `*` and `as` stop the program when the value does not
    // fit; these hand that case to the caller instead.

    /// Adds `other` to this value, or reports that the sum does not fit.
    /// Never stops the program: where `+` would, this returns none and the caller decides what an overflow means.
    /// @param other the value to add
    /// @returns the sum, or none when it lies outside the range of `int128`
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-checked-add
    pub func CheckedAdd(&self, other: int128) -> int128? {
        var sum: int128 = 0;
        if AddChecked<int128>(self, other, @sum) { return none; }
        return sum;
    }

    /// Subtracts `other` from this value, or reports that the difference does not fit.
    /// Never stops the program: where `-` would, this returns none.
    /// @param other the value to subtract
    /// @returns the difference, or none when it lies outside the range of `int128`
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-checked-sub
    pub func CheckedSub(&self, other: int128) -> int128? {
        var difference: int128 = 0;
        if SubChecked<int128>(self, other, @difference) { return none; }
        return difference;
    }

    /// Multiplies this value by `other`, or reports that the product does not fit.
    /// Never stops the program: where `*` would, this returns none, which is how a size computed from a count is
    /// checked before it is used.
    /// @param other the value to multiply by
    /// @returns the product, or none when it lies outside the range of `int128`
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-checked-mul
    pub func CheckedMul(&self, other: int128) -> int128? {
        var product: int128 = 0;
        if MulChecked<int128>(self, other, @product) { return none; }
        return product;
    }

    /// Adds `other` to this value, clamping a sum that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to add
    /// @returns the sum, or the limit of `int128` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-saturating-add
    pub func SaturatingAdd(&self, other: int128) -> int128 {
        return AddSaturating<int128>(self, other);
    }

    /// Subtracts `other` from this value, clamping a difference that does not fit to whichever limit it ran past.
    /// Never stops the program.
    /// @param other the value to subtract
    /// @returns the difference, or the limit of `int128` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-saturating-sub
    pub func SaturatingSub(&self, other: int128) -> int128 {
        return SubSaturating<int128>(self, other);
    }

    /// Multiplies this value by `other`, clamping a product that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to multiply by
    /// @returns the product, or the limit of `int128` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-saturating-mul
    pub func SaturatingMul(&self, other: int128) -> int128 {
        return MulSaturating<int128>(self, other);
    }

    /// The low bits of this value at the width of `T`, in two's complement, whether or not the value fits.
    /// Where `as` keeps the value or stops the program, this keeps the bits on purpose, as a hash or an encoder taking
    /// the low byte of a word does. A wider `T` extends the value by the signedness of `int128`, as `as` does.
    /// @typeParam T the integer type to convert to
    /// @returns the low bits of this value as a `T`
    /// @see https://rux-lang.dev/docs/api/core/integers#int128-truncate
    pub intrinsic func Truncate<T>(&self) -> T;
}
