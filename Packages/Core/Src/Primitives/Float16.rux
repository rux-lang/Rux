// `float16`: IEEE 754 binary16.
// Eleven bits of significand, so about three decimal digits. Its arithmetic runs in software on every target.

/// An IEEE 754 binary16 floating-point number.
/// @see https://rux-lang.dev/docs/api/core/floating-point#float16
extend float16 {
    /// The number of bits in the representation.
    /// @see https://rux-lang.dev/docs/api/core/floating-point#float16-bits
    pub const Bits: uint = 16;
    /// The number of bytes in the representation.
    /// @see https://rux-lang.dev/docs/api/core/floating-point#float16-bytes
    pub const Bytes: uint = 2;
    /// The lowest finite value.
    /// @see https://rux-lang.dev/docs/api/core/floating-point#float16-lowest
    pub const Lowest: float16 = -65504.0f16;
    /// The highest finite value.
    /// @see https://rux-lang.dev/docs/api/core/floating-point#float16-max
    pub const Max: float16 = 65504.0f16;
    /// The smallest positive normal value.
    /// @see https://rux-lang.dev/docs/api/core/floating-point#float16-min-positive
    pub const MinPositive: float16 = 6.103515625e-05f16;
    /// The difference between one and the next representable value.
    /// @see https://rux-lang.dev/docs/api/core/floating-point#float16-epsilon
    pub const Epsilon: float16 = 0.0009765625f16;
    /// Positive infinity.
    /// @see https://rux-lang.dev/docs/api/core/floating-point#float16-infinity
    pub intrinsic const Infinity: float16;
    /// A quiet not-a-number value.
    /// @see https://rux-lang.dev/docs/api/core/floating-point#float16-nan
    pub intrinsic const NaN: float16;
}
