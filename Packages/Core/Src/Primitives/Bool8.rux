// `bool8`: one of two values, stored in 8 bits.
// Every boolean width holds exactly zero or one whatever its size, so a cast into one asks whether the whole source
// value is non-zero rather than truncating to the width first. This is the width `bool` names.

/// One of two values, stored in 8 bits.
/// @see https://rux-lang.dev/docs/api/core/booleans#bool8
extend bool8 {
    /// The number of bits in the representation.
    /// @see https://rux-lang.dev/docs/api/core/booleans#bool8-bits
    pub const Bits: uint = 8;
    /// The number of bytes in the representation.
    /// @see https://rux-lang.dev/docs/api/core/booleans#bool8-bytes
    pub const Bytes: uint = 1;
}
