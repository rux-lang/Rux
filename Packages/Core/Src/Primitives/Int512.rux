// `int512`: a signed integer in 512 bits, two's complement.
// The range is asymmetric, as it is at every signed width: the most negative value has no positive counterpart, which
// is behind nearly every edge case in checked arithmetic.

/// A signed integer in 512 bits, two's complement.
/// @see https://rux-lang.dev/docs/api/core/integers#int512
extend int512 {
    /// The number of bits in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-bits
    pub const Bits: uint = 512u;
    /// The number of bytes in the representation.
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-bytes
    pub const Bytes: uint = 64u;
    /// The smallest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-min
    pub const Min: int512 = -6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042048i512;
    /// The largest representable value.
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-max
    pub const Max: int512 = 6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042047i512;

    // Checked, saturating and truncating arithmetic. `+`, `-`, `*` and `as` stop the program when the value does not
    // fit; these hand that case to the caller instead.

    /// Adds `other` to this value, or reports that the sum does not fit.
    /// Never stops the program: where `+` would, this returns none and the caller decides what an overflow means.
    /// @param other the value to add
    /// @returns the sum, or none when it lies outside the range of `int512`
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-checked-add
    pub func CheckedAdd(self: &int512, other: int512) -> int512? {
        var sum: int512 = 0;
        if AddChecked<int512>(self, other, @sum) { return none; }
        return sum;
    }

    /// Subtracts `other` from this value, or reports that the difference does not fit.
    /// Never stops the program: where `-` would, this returns none.
    /// @param other the value to subtract
    /// @returns the difference, or none when it lies outside the range of `int512`
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-checked-sub
    pub func CheckedSub(self: &int512, other: int512) -> int512? {
        var difference: int512 = 0;
        if SubChecked<int512>(self, other, @difference) { return none; }
        return difference;
    }

    /// Multiplies this value by `other`, or reports that the product does not fit.
    /// Never stops the program: where `*` would, this returns none, which is how a size computed from a count is
    /// checked before it is used.
    /// @param other the value to multiply by
    /// @returns the product, or none when it lies outside the range of `int512`
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-checked-mul
    pub func CheckedMul(self: &int512, other: int512) -> int512? {
        var product: int512 = 0;
        if MulChecked<int512>(self, other, @product) { return none; }
        return product;
    }

    /// Adds `other` to this value, clamping a sum that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to add
    /// @returns the sum, or the limit of `int512` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-saturating-add
    pub func SaturatingAdd(self: &int512, other: int512) -> int512 {
        return AddSaturating<int512>(self, other);
    }

    /// Subtracts `other` from this value, clamping a difference that does not fit to whichever limit it ran past.
    /// Never stops the program.
    /// @param other the value to subtract
    /// @returns the difference, or the limit of `int512` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-saturating-sub
    pub func SaturatingSub(self: &int512, other: int512) -> int512 {
        return SubSaturating<int512>(self, other);
    }

    /// Multiplies this value by `other`, clamping a product that does not fit to the minimum or the maximum.
    /// Never stops the program.
    /// @param other the value to multiply by
    /// @returns the product, or the limit of `int512` it ran past
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-saturating-mul
    pub func SaturatingMul(self: &int512, other: int512) -> int512 {
        return MulSaturating<int512>(self, other);
    }

    /// The low bits of this value at the width of `T`, in two's complement, whether or not the value fits.
    /// Where `as` keeps the value or stops the program, this keeps the bits on purpose, as a hash or an encoder taking
    /// the low byte of a word does. A wider `T` extends the value by the signedness of `int512`, as `as` does.
    /// @typeParam T the integer type to convert to
    /// @returns the low bits of this value as a `T`
    /// @see https://rux-lang.dev/docs/api/core/integers#int512-truncate
    pub intrinsic func Truncate<T>(self: &int512) -> T;
}
