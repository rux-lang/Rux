// The machine being compiled for, as ordinary values available while compiling.
//
// `#target` answers questions about the target rather than about the host running the compiler, which is what makes a
// cross-build produce the right code: a package selecting a syscall or a struct layout branches on these and never on
// where it happens to be built.
//
// Each variant names one system rather than a family, so the BSDs are told apart. A `when` on one of these keeps only
// the branch that applies, so the untaken side is never resolved and may name declarations this target does not have.

/// An operating system a build can target.
///
/// Named per system rather than per family, so a package can tell FreeBSD from Linux where their interfaces differ.
///
/// https://rux-lang.dev/docs/api/core/operating-system
#Allow("naming.type")
enum OperatingSystem: uint8 {
    /// A target the compiler has no name for, which no supported build produces.
    Unknown = 0,
    FreeBSD = 1,
    Linux = 2,
    macOS = 3,
    Windows = 4
}

/// A processor architecture a build can target.
///
/// https://rux-lang.dev/docs/api/core/architecture
#Allow("naming.type")
enum Architecture: uint8 {
    /// An architecture the compiler has no name for, which no supported build produces.
    Unknown = 0,
    AArch64 = 1,
    X86_64 = 2
}

/// The calling and layout conventions a target's code follows.
///
/// This is what decides how arguments are passed and how aggregates are laid out, so a declaration that has to match
/// a foreign interface branches on it rather than on the operating system.
///
/// https://rux-lang.dev/docs/api/core/application-binary-interface
enum ApplicationBinaryInterface: uint8 {
    /// An ABI the compiler has no name for, which no supported build produces.
    Unknown = 0,
    /// The AArch64 procedure call standard.
    AAPCS64 = 1,
    /// The System V AMD64 ABI, used by Linux, FreeBSD, and macOS on x86-64.
    SystemV = 2,
    /// The Windows x64 calling convention.
    WindowsX64 = 3
}

/// A processor feature a target may be built with.
///
/// Presence is asked about with `Target::HasFeature` rather than read as a field, because a build enables a set
/// rather than a single one.
///
/// https://rux-lang.dev/docs/api/core/target-feature
enum TargetFeature: uint8 {
    AVX = 0,
    AVX2 = 1,
    AVX512 = 2,
    NEON = 3,
    SSE2 = 4,
    SSE3 = 5,
    SSE41 = 6,
    SSE42 = 7,
    SSSE3 = 8,
    SVE = 9
}

/// The order a target stores a multi-byte value's bytes in.
///
/// https://rux-lang.dev/docs/api/core/endianness
enum Endianness: uint8 {
    /// Most significant byte first, which is network byte order.
    Big = 0,
    /// Least significant byte first, which every currently supported target uses.
    Little = 1
}

/// The widths a target's C environment assigns to `long` and to a pointer.
///
/// This is what a raw C declaration needs to get `long` right, since the two models disagree about it.
///
/// https://rux-lang.dev/docs/api/core/data-model
enum DataModel: uint8 {
    /// A model the compiler has no name for, which no supported build produces.
    Unknown = 0,
    /// 32-bit `long`, 64-bit pointer. Windows.
    LLP64 = 1,
    /// 64-bit `long`, 64-bit pointer. Every supported Unix target.
    LP64 = 2
}

/// The object-file format a target's compiled code is emitted in.
///
/// https://rux-lang.dev/docs/api/core/object-format
enum ObjectFormat: uint8 {
    /// A format the compiler has no name for, which no supported build produces.
    Unknown = 0,
    /// The format Windows links, carried in a PE image.
    COFF = 1,
    /// The format Linux and FreeBSD link.
    ELF = 2,
    /// The format macOS links.
    MachO = 3
}

/// Properties of the machine the build targets.
///
/// Every field is fixed when compiling begins. Reading one produces no runtime code, so a branch on a field is
/// decided while compiling and the untaken side is not emitted.
///
/// https://rux-lang.dev/docs/api/core/target
struct Target {
    /// The operating system.
    os: OperatingSystem;
    /// The processor architecture.
    arch: Architecture;
    /// The calling and layout conventions the target's code follows.
    abi: ApplicationBinaryInterface;
    /// The order the target stores a multi-byte value's bytes in.
    endian: Endianness;
    /// How many bits a pointer occupies.
    pointerBits: uint;
    /// The widths the target's C environment assigns to `long` and to a pointer.
    dataModel: DataModel;
    /// The object-file format compiled code is emitted in.
    objectFormat: ObjectFormat;
    /// The canonical target name, spelled `<os>-<arch>`, which is what `--target` accepts.
    triple: Slice<char8>;
}

extend Target {
    /// Whether the build enables `feature` on this target.
    ///
    /// `self` is borrowed and `feature` is read by value. Answered while compiling, so a branch on it emits only the
    /// side that applies and a body using an instruction the feature provides is never emitted without it.
    ///
    /// Cannot fail: a feature the target does not have is absent rather than an error. Costs nothing in the built
    /// program.
    ///
    /// https://rux-lang.dev/docs/api/core/target/has-feature
    intrinsic func HasFeature(self: *Target, feature: TargetFeature) -> bool;
}

/// The machine being compiled for, as a compile-time value.
///
/// Reading a field produces no runtime code. A `when` on one keeps only the branch that applies, so the untaken side
/// is never resolved or type-checked and may name declarations this target does not have.
///
/// https://rux-lang.dev/docs/api/core/target
intrinsic #target: Target;
