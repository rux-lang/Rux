// C's `<math.h>`: the elementary functions, in both the `double` and `float` forms C declares them in.
//
// Bound rather than implemented, which is the point: a program that already links a C runtime and wants the same
// answers its C code gets should ask the same library for them. `Rux/Math` computes these without a C runtime and
// is the portable answer; this is here for interoperating with existing native code.
//
// Two families are absent on purpose. `fabsf`, `frexpf`, `ldexpf` and `hypotf` are header inlines in the Universal
// CRT rather than exported symbols, so declaring them would link on Unix and fail on Windows. The `nexttoward` pair
// takes a `long double`, which is a different type on every target — 64 bits under the Universal CRT, an 80-bit
// x87 value on x86-64 Unix, a 128-bit quad on AArch64 — so no one declaration is right everywhere.

import Core::{ float32, float64 };
import Core::{ #target, #Error };
import C::c_long;

// C's `<math.h>`: the elementary functions, in the `double` form C names plainly and the `float` form it suffixes.
//
// Complete for what the supported runtimes actually export, which is not the same as what the standard lists. Four
// `float` variants are deliberately absent — `fabsf`, `frexpf`, `ldexpf` and `hypotf` — because the Universal CRT
// does not export them: they are header inlines there over the `double` forms and over compiler intrinsics, so a
// declaration of them would link on Unix and fail on Windows. `Rux/Math` computes at every width without asking a C
// runtime, and is the portable answer.
//
// The `nexttoward` pair is absent for a different reason: its second argument is a `long double`, which is a
// different type on every target — 64 bits under the Universal CRT, an 80-bit x87 value on x86-64 Unix, and a
// 128-bit quad on AArch64. No one declaration is right everywhere, so this package does not pretend otherwise.
//
// The C math library's shared object differs by platform.
when #target.os {
    .FreeBSD => const MathLib = "libm.so.5";
    .Linux => const MathLib = "libm.so.6";
    .macOS => const MathLib = "libSystem.B.dylib";
    .Windows => const MathLib = "ucrtbase.dll";
    else => #Error("Unsupported operating system")
}

#Link(MathLib)
extern {
    /// Computes arc cosine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/acos
    func acosf(x: float32) -> float32;

    /// Computes arc cosine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/acos
    func acos(x: float64) -> float64;

    /// Computes inverse hyperbolic cosine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/acosh
    func acoshf(x: float32) -> float32;

    /// Computes inverse hyperbolic cosine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/acosh
    func acosh(x: float64) -> float64;

    /// Computes arc sine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/asin
    func asinf(x: float32) -> float32;

    /// Computes arc sine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/asin
    func asin(x: float64) -> float64;

    /// Computes inverse hyperbolic sine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/asinh
    func asinhf(x: float32) -> float32;

    /// Computes inverse hyperbolic sine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/asinh
    func asinh(x: float64) -> float64;

    /// Computes arc tangent.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/atan
    func atanf(x: float32) -> float32;

    /// Computes arc tangent.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/atan
    func atan(x: float64) -> float64;

    /// Computes arc tangent, using signs to determine quadrants.
    ///
    /// @param y the second argument
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/atan2
    func atan2f(y: float32, x: float32) -> float32;

    /// Computes arc tangent, using signs to determine quadrants.
    ///
    /// @param y the second argument
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/atan2
    func atan2(y: float64, x: float64) -> float64;

    /// Computes inverse hyperbolic tangent.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/atanh
    func atanhf(x: float32) -> float32;

    /// Computes inverse hyperbolic tangent.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/atanh
    func atanh(x: float64) -> float64;

    /// Computes cube root.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/cbrt
    func cbrtf(x: float32) -> float32;

    /// Computes cube root.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/cbrt
    pub func cbrt(x: float64) -> float64;

    /// Computes smallest integer not less than the given value.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/ceil
    func ceilf(x: float32) -> float32;

    /// Computes smallest integer not less than the given value.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/ceil
    pub func ceil(x: float64) -> float64;

    /// Copies the sign of a floating-point value.
    ///
    /// @param x the argument
    /// @param y the second argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/copysign
    func copysignf(x: float32, y: float32) -> float32;

    /// Copies the sign of a floating-point value.
    ///
    /// @param x the argument
    /// @param y the second argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/copysign
    pub func copysign(x: float64, y: float64) -> float64;

    /// Computes cosine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/cos
    func cosf(x: float32) -> float32;

    /// Computes cosine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/cos
    pub func cos(x: float64) -> float64;

    /// Computes hyperbolic cosine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/cosh
    func coshf(x: float32) -> float32;

    /// Computes hyperbolic cosine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/cosh
    func cosh(x: float64) -> float64;

    /// Computes error function.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/erf
    func erff(x: float32) -> float32;

