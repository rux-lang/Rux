    /// @see https://en.cppreference.com/c/numeric/math/remquo
    func remquof(x: float32, y: float32, quo: *int32) -> float32;

    /// Computes signed remainder as well as the three last bits of the division operation.
    ///
    /// @param x the argument
    /// @param y the second argument
    /// @param quo receives the low bits of the quotient
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/remquo
    func remquo(x: float64, y: float64, quo: *int32) -> float64;

    /// Rounds to nearest integer using current rounding mode.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/rint
    func rintf(x: float32) -> float32;

    /// Rounds to nearest integer using current rounding mode.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/rint
    func rint(x: float64) -> float64;

    /// Rounds to nearest integer, rounding away from zero in halfway cases.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/round
    func roundf(x: float32) -> float32;

    /// Rounds to nearest integer, rounding away from zero in halfway cases.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/round
    pub func round(x: float64) -> float64;

    /// Multiplies a number by FLT_RADIX raised to an integer power.
    ///
    /// @param x the argument
    /// @param n the power of `FLT_RADIX` to multiply by
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/scalbn
    func scalbnf(x: float32, n: int32) -> float32;

    /// Multiplies a number by FLT_RADIX raised to an integer power.
    ///
    /// @param x the argument
    /// @param n the power of `FLT_RADIX` to multiply by
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/scalbn
    func scalbn(x: float64, n: int32) -> float64;

    /// Computes sine.
    /// https://en.cppreference.com/c/numeric/math/sin
    /// Multiplies a floating-point value by an integral power of two, with a long exponent
    ///
    /// @param arg the value to convert
    /// @param exp the exponent
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/scalbn
    pub func scalbln(arg: float64, exp: c_long) -> float64;

    /// Multiplies a floating-point value by an integral power of two, with a long exponent.
    ///
    /// @param arg the value to convert
    /// @param exp the exponent
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/scalbn
    pub func scalblnf(arg: float32, exp: c_long) -> float32;

    func sinf(x: float32) -> float32;

    /// Computes sine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/sin
    pub func sin(x: float64) -> float64;

    /// Computes hyperbolic sine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/sinh
    func sinhf(x: float32) -> float32;

    /// Computes hyperbolic sine.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/sinh
    func sinh(x: float64) -> float64;

    /// Computes square root.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/sqrt
    pub func sqrtf(x: float32) -> float32;

    /// Computes square root.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/sqrt
    pub func sqrt(x: float64) -> float64;

    /// Computes tangent.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/tan
    func tanf(x: float32) -> float32;

    /// Computes tangent.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/tan
    pub func tan(x: float64) -> float64;

    /// Computes hyperbolic tangent.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/tanh
    func tanhf(x: float32) -> float32;

    /// Computes hyperbolic tangent.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/tanh
    func tanh(x: float64) -> float64;

    /// Computes gamma function.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/tgamma
    func tgammaf(x: float32) -> float32;

    /// Computes gamma function.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/tgamma
    func tgamma(x: float64) -> float64;

    /// Rounds to nearest integer not greater in magnitude than the given value.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/trunc
    func truncf(x: float32) -> float32;

    /// Rounds to nearest integer not greater in magnitude than the given value.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/trunc
    pub func trunc(x: float64) -> float64;
}

// The constants below are annotated with their primitive types rather than `c_double` and `c_float`: a `const` cannot
// name a type alias declared in another file of the package. The width is the same thing said twice.

/// `HUGE_VAL`: what a `double` function returns when the true result is too large to express.
///
/// An infinity on every supported target, which is what the standard permits and what every one of them chooses.
///
/// @see https://rux-lang.dev/docs/api/c/huge-val
#Allow("naming.const")
pub const HUGE_VAL: float64 = float64::Infinity;

/// `HUGE_VALF`: the `float` form of `HUGE_VAL`.
///
/// @see https://rux-lang.dev/docs/api/c/huge-valf
#Allow("naming.const")
pub const HUGE_VALF: float32 = float32::Infinity;

/// `INFINITY`: a positive infinity, for building a value rather than for testing one.
///
/// Comparing against it is not how a caller asks whether a result overflowed; `Core::IsInfinite` answers that without
/// naming a width.
///
/// @see https://rux-lang.dev/docs/api/c/infinity
#Allow("naming.const")
pub const INFINITY: float32 = float32::Infinity;

/// `NAN`: a quiet not-a-number, for building a value rather than for testing one.
///
/// It equals nothing, itself included, so `value == NAN` is always false and is never the test a caller wants;
/// `Core::IsNaN` is.
///
/// @see https://rux-lang.dev/docs/api/c/nan
#Allow("naming.const")
pub const NAN: float32 = float32::NaN;
