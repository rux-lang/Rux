    /// @see https://en.cppreference.com/c/numeric/math/exp2
    func exp2f(x: float32) -> float32;

    /// Computes 2 raised to the given power.
    ///
    /// @param x the argument
    /// @returns the computed value; the linked reference lists every special case
    /// @see https://en.cppreference.com/c/numeric/math/exp2
    func exp2(x: float64) -> float64;

    /// Computes e raised to the given power, minus one.
