// Waiting for a whole span, and saying so when the wait did not happen.
//
// Sleeping looks like the simplest thing in this package and has three ways to be quietly wrong, all of which this
// module used to have.
//
// A signal can cut a Unix wait short. The loop goes back for the remainder rather than returning early, because a
// caller asked for a span, not for a span unless the process happened to receive a signal.
//
// Windows takes its interval as a 32-bit millisecond count, which runs out after about 49.7 days. Clamping a longer
// span to that ceiling is what the previous version did, and it returned as though it had slept for the whole
// hundred days it was asked for. A span longer than the ceiling is now waited for in chunks.
//
// And a wait can simply fail. `nanosleep` reports `EINVAL` for a request it will not honor, and the previous
// version could not tell that from a completed sleep — both left the remainder at zero — so it returned success
// having waited for nothing at all. The wait now reports a `TimeError`, and a caller that ignores it is at least
// making that choice.
//
// The system wait is reached through the `Waiter` interface so that the chunking and the retry loop can be tested
// against an injected one. A test for a hundred-day sleep must not take a hundred days, and a test for an
// interrupted sleep cannot arrange a signal.

import Core::{ #target, #Error, Option };
import Time::Duration;

when #target.os {
    .FreeBSD => import FreeBSD::{ EINTR, Errno, IsError, Nanosleep, Timespec },
    .Linux => import Linux::{ EINTR, Errno, IsError, Nanosleep, Timespec },
    .macOS => import macOS::{ EINTR, Errno, IsError, Nanosleep, Timespec },
    .Windows => import Windows::Sleep,
    else => #Error("Unsupported operating system")
}

/// Why a wait did not complete. `Copy`.
///
/// `Interrupted` is reported only by a caller-supplied `Waiter`; `SleepFor` retries an interruption itself and
/// never reports it, because a caller that asked for a span asked for the whole span.
///
/// @see https://rux-lang.dev/docs/api/time/time-error
pub enum TimeError: uint8 {
    /// The wait completed. This is what a successful call reports, so it is not an error case.
    None = 0,
    /// A signal cut the wait short. The remainder says how much is left.
    Interrupted = 1,
    /// The system refused the request itself, rather than being unable to finish it.
    InvalidDuration = 2,
    /// The system reported a failure this module has no name for.
    Failed = 3
}

/// The longest interval one system wait may be asked for, in milliseconds.
///
/// Windows takes a 32-bit count and reserves `0xFFFFFFFF` to mean "wait forever", so the largest finite request is
/// one less. Every system's wait is chunked to this so that the loop is the same everywhere and so that a test of
/// the chunking is a test of what actually runs.
///
/// About 49.7 days. A span longer than this is waited for in more than one chunk.
///
/// @see https://rux-lang.dev/docs/api/time/maximum-wait-milliseconds
pub const MaximumWaitMilliseconds: int64 = 4294967294;

/// How long the next single wait should be asked for, given how much of the span is left.
///
/// Returns the whole millisecond count to ask the system for: the remaining span rounded **up**, since a wait
/// promises at least what was asked and never less, or `MaximumWaitMilliseconds` when the remainder is longer than
/// one wait can express. Never zero for a positive span, so a loop driven by this always makes progress.
///
/// A negative or zero span gives zero, which is the value a caller uses to stop.
///
/// This is where the old clamp was, and it is public so that the hundred-day case can be checked without waiting a
/// hundred days.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// @param span how much of the wait is left
/// @returns the milliseconds to ask the system for
/// @see https://rux-lang.dev/docs/api/time/wait-chunk-milliseconds
pub func WaitChunkMilliseconds(span: Duration) -> int64 {
    if span.IsNegative() || span.IsZero() { return 0; }

    // A span too long to count in milliseconds at all is certainly longer than one wait, so it takes the ceiling
    // without the arithmetic below having to represent it.
    let total = span.TotalMilliseconds();
    var whole = MaximumWaitMilliseconds;
    match total {
        .Some(value) => { whole = value; },
        .None => { return MaximumWaitMilliseconds; }
    }
    if whole >= MaximumWaitMilliseconds { return MaximumWaitMilliseconds; }

    // Rounding up is what makes the promise "at least this long" true: a sub-millisecond remainder still costs a
    // whole millisecond of waiting rather than being dropped.
    if span.SubsecondNanoseconds() % 1000000u32 != 0u32 { whole = whole + 1; }
    return whole == 0 ? 1 : whole;
}

/// One wait, however the caller reaches the system.
///
/// An implementation waits for at most `span` and reports what is left of it. Reporting less than the whole span as
/// remaining is how a wait says it did some of the work; reporting `Interrupted` is how it says a signal stopped it
/// early. `SleepFor` drives whichever implementation it is given until nothing is left.
///
/// @see https://rux-lang.dev/docs/api/time/waiter
pub interface Waiter {
    /// Waits for at most `span`, and writes what remains of it.
    ///
    /// `remaining` receives the unwaited part, which is zero when the whole span was waited for. It must not be
    /// null and is written whether or not this reports `None`, so a caller can always see how far the wait got.
    ///
    /// # Failures
    ///
    /// Reports `Interrupted` when something stopped the wait early with time still to go, and any other case when
    /// the system refused. An implementation must not report `None` unless the span really elapsed.
    ///
    /// @param span how much time to wait for
    /// @param remaining receives what is left of `span`
    /// @returns `None` when the whole span elapsed
    /// @see https://rux-lang.dev/docs/api/time/waiter/wait-for
    func WaitFor(span: Duration, remaining: *var Duration) -> TimeError;
}

/// The wait every supported system actually provides. `Copy`.
///
/// Holds nothing: the system is the state. Construct one with `SystemWaiter()` and hand it to `SleepUsing`, or use
/// `SleepFor`, which does that.
///
/// @see https://rux-lang.dev/docs/api/time/system-waiter
pub struct SystemWaiter {
    /// Present because a struct with no fields has no address to distinguish two of, and this type is passed by
    /// reference to a generic. It is never read.
    reserved: uint8;
}

extend SystemWaiter {
    /// A waiter that reaches the operating system.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @returns the waiter
    /// @see https://rux-lang.dev/docs/api/time/system-waiter/new
    pub func SystemWaiter() -> SystemWaiter {
        return SystemWaiter { reserved: 0 };
    }
}

extend SystemWaiter : Waiter {
    func WaitFor(self: &var SystemWaiter, span: Duration, remaining: *var Duration) -> TimeError {
        *remaining = Duration::Zero();
        let chunk = WaitChunkMilliseconds(span);
        if chunk == 0 { return TimeError::None; }

        // What is left over once this chunk is waited for. A chunk shorter than the span means the span was longer
        // than one wait can express, and the loop above will come back for the rest.
        let asked = Duration::FromMilliseconds(chunk);
        let rest = span.Minus(asked).ValueOr(Duration::Zero());
        let leftover = rest.IsNegative() ? Duration::Zero() : rest;

        when #target.os == .Windows {
            // Rounded up above, so this waits at least as long as asked and never less.
            Sleep(chunk as uint32);
            *remaining = leftover;
            return TimeError::None;
        }
        else {
            var request = Timespec {
                seconds: asked.WholeSeconds(),
                nanoseconds: asked.SubsecondNanoseconds() as int64
            };
            var unslept = Timespec { seconds: 0, nanoseconds: 0 };
            let status = Nanosleep(@request, @unslept);
            if !IsError(status) {
                *remaining = leftover;
                return TimeError::None;
            }
            if Errno(status) != EINTR {
                // The request itself was refused. Nothing was waited for, so the whole span is still outstanding —
                // which the previous version could not tell from a completed sleep, since both leave the remainder
                // at zero.
                *remaining = span;
                return TimeError::InvalidDuration;
            }
            // A signal stopped it with time to go. What the kernel left in `unslept` belongs to this chunk, so the
            // rest of the span is that plus whatever the chunking held back.
            let cutShort = Duration::FromSeconds(unslept.seconds);
            var short = cutShort;
            short.nanoseconds = unslept.nanoseconds as uint32;
            *remaining = short.Plus(leftover).ValueOr(leftover);
            return TimeError::Interrupted;
        }
    }
}

/// How many waits `SleepFor` will make before giving up on a span that never shrinks.
///
/// A `Waiter` that reports success without waiting and without reducing the remainder would spin forever. This is
/// not a limit any real wait reaches: the system waiter always either advances or fails.
///
/// @see https://rux-lang.dev/docs/api/time/maximum-wait-attempts
pub const MaximumWaitAttempts: uint = 4096;

/// Waits out `span` through `waiter`, retrying interruptions and chunking what one wait cannot express.
///
/// A negative or zero span returns at once, having waited for nothing. Otherwise this calls `waiter` until it
/// reports that nothing is left, so an interruption is invisible to the caller and a span longer than one wait
/// takes several.
///
/// # Failures
///
/// Reports whatever the waiter reported for anything other than an interruption, having stopped there rather than
/// asking again. Reports `Failed` when the waiter neither advanced nor failed `MaximumWaitAttempts` times running,
/// which no real wait does and which is what keeps a broken implementation from hanging a program.
///
/// @typeParam W the waiter's type
/// @param waiter how to reach the wait
/// @param span how long to wait for
/// @returns `None` when the whole span was waited out
/// @see https://rux-lang.dev/docs/api/time/sleep-using
pub func SleepUsing<W: Waiter>(waiter: &var W, span: Duration) -> TimeError {
    if span.IsNegative() || span.IsZero() { return TimeError::None; }

    var left = span;
    var attempts: uint = 0;
    while attempts < MaximumWaitAttempts {
        attempts = attempts + 1;
        var remaining = Duration::Zero();
        let error = waiter.WaitFor(left, @remaining);
        if error != TimeError::None && error != TimeError::Interrupted { return error; }
        if remaining.IsZero() || remaining.IsNegative() { return TimeError::None; }
        // A waiter that hands back everything it was given, without failing, has not waited. Counting the attempt
        // rather than trusting it is what bounds the loop.
        left = remaining;
    }
    return TimeError::Failed;
}

/// Stops the calling thread for at least `span`.
///
/// At least: the system wakes the thread no earlier, and how much later is the scheduler's business. A negative or
/// zero span returns at once.
///
/// A signal can interrupt the wait on the Unix systems, and this goes back for the remainder until the whole span
/// has passed — the interruption is invisible, which is what makes this safe to use for pacing. A span longer than
/// one system wait can express is waited for in chunks rather than clamped, so a hundred-day sleep is a hundred
/// days.
///
/// # Failures
///
/// Reports `InvalidDuration` when the system refused the request, which a normalized non-negative span should not
/// produce, and `Failed` for anything else. A caller with nothing to do about a failed wait may ignore the result;
/// the point is that it is no longer indistinguishable from success.
///
/// @param span how long to wait for
/// @returns `None` when the whole span was waited out
/// @see https://rux-lang.dev/docs/api/time/sleep
pub func SleepFor(span: Duration) -> TimeError {
    var waiter = SystemWaiter();
    // A named value auto-borrows into the generic's `&var W`; taking its address would be a pointer.
    return SleepUsing<SystemWaiter>(waiter, span);
}
