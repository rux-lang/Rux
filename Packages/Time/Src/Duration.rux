// A span of time, exact to the nanosecond.
//
// A duration is seconds plus a nanosecond fraction, and the fraction is always in [0, 1e9): the value is
// `seconds + nanoseconds / 1e9` with the sign carried entirely by the seconds. That single invariant is what makes
// equality bytewise, ordering two comparisons, and arithmetic a carry -- minus one and a half seconds is seconds
// -2 and half a billion nanoseconds, not two fields that each carry a sign and can disagree.
//
// The arithmetic is checked. A duration overflows at about 292 billion years, which no honest computation reaches,
// so an overflow is a bug in the caller's arithmetic -- and the answer to a bug is a report, not a wrap that turns
// a timeout into a deadline in the past.

import Core::{ AddChecked, MulChecked, Option, Ordering, SubChecked };

/// How many nanoseconds one second holds.
///
/// https://rux-lang.dev/docs/api/time/nanoseconds-per-second
pub const NanosecondsPerSecond: uint32 = 1000000000;

/// A span of time: seconds and a fraction, normalized.
///
/// `Copy`. The value is `seconds + nanoseconds / 1e9`, and `nanoseconds` is always in [0, 1e9).
///
/// https://rux-lang.dev/docs/api/time/duration
pub struct Duration {
    /// The whole seconds, carrying the sign.
    pub seconds: int64;
    /// The fraction, in nanoseconds, always in [0, 1e9).
    nanoseconds: uint32;
}

extend Duration {
    /// No time at all.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/zero
    pub func Zero() -> Duration {
        return Duration { seconds: 0, nanoseconds: 0 };
    }

    /// Exactly `seconds` seconds.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/from-seconds
    pub func FromSeconds(seconds: int64) -> Duration {
        return Duration { seconds: seconds, nanoseconds: 0 };
    }

    /// Exactly `minutes` minutes, or `None` past the range.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/from-minutes
    pub func FromMinutes(minutes: int64) -> Option<Duration> {
        var seconds: int64 = 0;
        if MulChecked<int64>(minutes, 60i64, @seconds) { return Option::None<Duration>(); }
        return Option::Some<Duration>(Duration::FromSeconds(seconds));
    }

    /// Exactly `hours` hours, or `None` past the range.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/from-hours
    pub func FromHours(hours: int64) -> Option<Duration> {
        var seconds: int64 = 0;
        if MulChecked<int64>(hours, 3600i64, @seconds) { return Option::None<Duration>(); }
        return Option::Some<Duration>(Duration::FromSeconds(seconds));
    }

    /// Exactly `milliseconds` milliseconds.
    ///
    /// Cannot overflow: every `int64` count of milliseconds fits.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/from-milliseconds
    pub func FromMilliseconds(milliseconds: int64) -> Duration {
        return Duration::FromScaled(milliseconds, 1000000u32);
    }

    /// Exactly `microseconds` microseconds.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/from-microseconds
    pub func FromMicroseconds(microseconds: int64) -> Duration {
        return Duration::FromScaled(microseconds, 1000u32);
    }

    /// Exactly `nanoseconds` nanoseconds.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/from-nanoseconds
    pub func FromNanoseconds(nanoseconds: int64) -> Duration {
        return Duration::FromScaled(nanoseconds, 1u32);
    }

    // `count` units of `scale` nanoseconds each: floor-divide into seconds so the fraction comes out non-negative,
    // which is the normalization working for negative counts too.
    func FromScaled(count: int64, scale: uint32) -> Duration {
        let perSecond = (NanosecondsPerSecond / scale) as int64;
        var seconds = count / perSecond;
        var rest = count % perSecond;
        if rest < 0i64 {
            seconds = seconds - 1i64;
            rest = rest + perSecond;
        }
        return Duration { seconds: seconds, nanoseconds: (rest as uint32) * scale };
    }
}

extend Duration {
    /// Whether this span is exactly nothing.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/is-zero
    pub func IsZero(self: &Duration) -> bool {
        return self.seconds == 0i64 && self.nanoseconds == 0u32;
    }

    /// Whether this span is negative.
    ///
    /// The sign lives in the seconds alone, which the normalization guarantees.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/is-negative
    pub func IsNegative(self: &Duration) -> bool {
        return self.seconds < 0i64;
    }

    /// The whole seconds, rounded toward negative infinity.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/whole-seconds
    pub func WholeSeconds(self: &Duration) -> int64 {
        return self.seconds;
    }

    /// The fraction beyond the whole seconds, in nanoseconds, always in [0, 1e9).
    ///
    /// https://rux-lang.dev/docs/api/time/duration/subsecond-nanoseconds
    pub func SubsecondNanoseconds(self: &Duration) -> uint32 {
        return self.nanoseconds;
    }

    /// This span as milliseconds, truncated toward zero, or `None` where an `int64` of them cannot hold it.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/total-milliseconds
    pub func TotalMilliseconds(self: &Duration) -> Option<int64> {
        return self.Total(1000000u32);
    }

    /// This span as microseconds, truncated toward zero.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/total-microseconds
    pub func TotalMicroseconds(self: &Duration) -> Option<int64> {
        return self.Total(1000u32);
    }

    /// This span as nanoseconds, or `None` where an `int64` of them cannot hold it -- about 292 years.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/total-nanoseconds
    pub func TotalNanoseconds(self: &Duration) -> Option<int64> {
        return self.Total(1u32);
    }

    // The count of `scale`-nanosecond units, truncated toward zero, checked.
    func Total(self: &Duration, scale: uint32) -> Option<int64> {
        let perSecond = (NanosecondsPerSecond / scale) as int64;
        var whole: int64 = 0;
        if MulChecked<int64>(self.seconds, perSecond, @whole) { return Option::None<int64>(); }
        var sum: int64 = 0;
        if AddChecked<int64>(whole, (self.nanoseconds / scale) as int64, @sum) { return Option::None<int64>(); }
        return Option::Some<int64>(sum);
    }

    /// The sum of two spans, or `None` past the range.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/plus
    pub func Plus(self: &Duration, other: Duration) -> Option<Duration> {
        var seconds: int64 = 0;
        if AddChecked<int64>(self.seconds, other.seconds, @seconds) { return Option::None<Duration>(); }
        var nanoseconds = self.nanoseconds + other.nanoseconds;
        if nanoseconds >= NanosecondsPerSecond {
            nanoseconds = nanoseconds - NanosecondsPerSecond;
            if AddChecked<int64>(seconds, 1i64, @seconds) { return Option::None<Duration>(); }
        }
        return Option::Some<Duration>(Duration { seconds: seconds, nanoseconds: nanoseconds });
    }

    /// The difference of two spans, or `None` past the range.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/minus
    pub func Minus(self: &Duration, other: Duration) -> Option<Duration> {
        var seconds: int64 = 0;
        if SubChecked<int64>(self.seconds, other.seconds, @seconds) { return Option::None<Duration>(); }
        var nanoseconds = self.nanoseconds;
        if nanoseconds < other.nanoseconds {
            if SubChecked<int64>(seconds, 1i64, @seconds) { return Option::None<Duration>(); }
            nanoseconds = nanoseconds + NanosecondsPerSecond;
        }
        return Option::Some<Duration>(Duration { seconds: seconds, nanoseconds: nanoseconds - other.nanoseconds });
    }

    /// This span negated, or `None` for the one value whose negation does not fit.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/negated
    pub func Negated(self: &Duration) -> Option<Duration> {
        let zero = Duration::Zero();
        return zero.Minus(Duration { seconds: self.seconds, nanoseconds: self.nanoseconds });
    }

    /// This span scaled by a whole factor, or `None` past the range.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/times
    pub func Times(self: &Duration, factor: int64) -> Option<Duration> {
        // The fraction times the factor is nanoseconds that may carry whole seconds; the carry rides along
        // checked, so the largest representable spans still refuse rather than wrap.
        var wholePart: int64 = 0;
        if MulChecked<int64>(self.seconds, factor, @wholePart) { return Option::None<Duration>(); }
        var fractionTotal: int64 = 0;
        if MulChecked<int64>(self.nanoseconds as int64, factor, @fractionTotal) { return Option::None<Duration>(); }
        let scaled = Duration::FromScaled(fractionTotal, 1u32);
        var seconds: int64 = 0;
        if AddChecked<int64>(wholePart, scaled.seconds, @seconds) { return Option::None<Duration>(); }
        return Option::Some<Duration>(Duration { seconds: seconds, nanoseconds: scaled.nanoseconds });
    }

    /// Whether two spans are the same time.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/equals
    pub func Equals(self: &Duration, other: Duration) -> bool {
        return self.seconds == other.seconds && self.nanoseconds == other.nanoseconds;
    }

    /// How this span orders against `other`.
    ///
    /// Two comparisons, which the normalization pays for: the seconds decide, and the fractions only tie-break.
    ///
    /// https://rux-lang.dev/docs/api/time/duration/compare
    pub func Compare(self: &Duration, other: Duration) -> Ordering {
        if self.seconds < other.seconds { return Ordering::Less; }
        if self.seconds > other.seconds { return Ordering::Greater; }
        if self.nanoseconds < other.nanoseconds { return Ordering::Less; }
        if self.nanoseconds > other.nanoseconds { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
