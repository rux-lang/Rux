// A point on the clock that only moves forward.
//
// The monotonic clock answers one question — how much time passed between two readings — and answers it even
// while somebody sets the wall clock, which is exactly when the wall clock answers it wrongly. An `Instant` means
// nothing as a number: it has no epoch, no calendar, and no meaning in another process. What it has is that a
// later reading minus an earlier one is the time that really elapsed.
//
// Sleeping used to live here, because it is the same clock's other direction. It moved to `Sleep.rux` when it
// grew a failure to report and a chunking loop to drive, which is more than a clock reading needs next to it.

import Core::{ #target, #Error, Option };

when #target.os {
    .FreeBSD => import FreeBSD::{ ClockGetTime, ClockMonotonic, Timespec },
    .Linux => import Linux::{ ClockGetTime, ClockMonotonic, Timespec },
    .macOS => import macOS::{ ClockGetTime, ClockMonotonic, Timespec },
    .Windows => import Windows::{ QueryPerformanceCounter, QueryPerformanceFrequency },
    else => #Error("Unsupported operating system")
}

/// A reading of the monotonic clock.
///
/// `Copy`. Meaningful only against another reading from the same process: there is no epoch and no calendar here,
/// which is the point — nothing anybody does to the wall clock changes what `Since` answers.
///
/// https://rux-lang.dev/docs/api/time/instant
pub struct Instant {
    /// Nanoseconds since some origin fixed for the life of the process.
    ticks: uint64;
}

extend Instant {
    /// The clock, read now.
    ///
    /// Cannot fail on any supported system: the monotonic clock exists from boot and needs no permission.
    ///
    /// https://rux-lang.dev/docs/api/time/instant/now
    pub func Now() -> Instant {
        when #target.os == .Windows {
            // The counter runs in units the machine chooses, so the frequency turns it into nanoseconds. Splitting
            // the division keeps the intermediate product inside a uint64 for centuries of uptime.
            var count: int64 = 0;
            var frequency: int64 = 0;
            QueryPerformanceCounter(@count);
            QueryPerformanceFrequency(@frequency);
            let ticks = count as uint64;
            let rate = frequency as uint64;
            let whole = ticks / rate;
            let rest = ticks % rate;
            return Instant { ticks: whole * 1000000000u64 + rest * 1000000000u64 / rate };
        }
        else {
            var time = Timespec { seconds: 0, nanoseconds: 0 };
            ClockGetTime(ClockMonotonic, @time);
            return Instant { ticks: (time.seconds as uint64) * 1000000000u64 + time.nanoseconds as uint64 };
        }
    }

    /// The time between `earlier` and this reading, or `None` when `earlier` is not earlier.
    ///
    /// Refusing the reversed pair rather than answering with garbage is what makes a mixed-up argument order a
    /// visible bug instead of a wildly large duration.
    ///
    /// https://rux-lang.dev/docs/api/time/instant/since
    pub func Since(self: &Instant, earlier: Instant) -> Option<Duration> {
        if self.ticks < earlier.ticks { return Option::None<Duration>(); }
        let gap = self.ticks - earlier.ticks;
        var result = Duration::FromSeconds((gap / 1000000000u64) as int64);
        result.nanoseconds = (gap % 1000000000u64) as uint32;
        return Option::Some<Duration>(result);
    }

    /// The time from this reading to now.
    ///
    /// https://rux-lang.dev/docs/api/time/instant/elapsed
    pub func Elapsed(self: &Instant) -> Duration {
        let now = Instant::Now();
        return now.Since(Instant { ticks: self.ticks }).ValueOr(Duration::Zero());
    }
}
