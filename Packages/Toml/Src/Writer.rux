// Writing a document back out, deterministically.
//
// The same tree always produces the same bytes. That is not an aesthetic preference: configuration files live in
// version control, and a writer whose output depends on hash order or on how the tree was built produces a diff
// every time it runs, which trains everyone to stop reading the diffs.
//
// So entries are written in the order the table holds them, keys are bare whenever TOML allows a bare key and
// quoted otherwise, and strings are always basic strings. A writer that guessed between the four string forms
// would produce output that changed shape when a value gained a backslash, which is the sort of churn nobody
// asked for; a basic string is always valid and always round-trips.
//
// Tables are written as headers rather than inline, except inside an array where TOML offers no other spelling.
// A document written, read and written again produces the same bytes the second time.
//
// What this cannot do is reproduce a file. The tree has no comments in it, no blank lines, and no memory of
// whether a number was written in hexadecimal or a string in a literal form, so the output is the writer's
// layout of the same values rather than the layout it was read from. That is fine for generating configuration
// and for writing back a file this program owns; running it over a file someone else wrote and hand-formatted
// will produce a diff of the whole file.
//
// Failures are the ones every writer in this workspace reports, so a document goes into anything a `TextWriter`
// reaches with no translation at the seam. What the destination said travels unchanged: a buffer that is merely
// full reports `InsufficientCapacity` and a stream that has died reports `WriterFailure`, where the status this
// replaced had one case, `Failed`, standing for both — and a caller who could have written the document somewhere
// larger had no way to know that was the problem. A header path that will not fit the buffer is `ValueOutOfRange`,
// which is what that case is for: the document is good and the form asked for cannot hold it.

import Format::{ ByteCursor, ParseFloat64, WriteDecimal };
import Text::{ FormatError, TextWriter };

/// How long a table's header path may be, in bytes.
///
/// A header is written as text, so the path is assembled into a fixed buffer rather than a list of names, and this
/// is that buffer. It is far past any path a person writes: reaching it takes a nesting of tables whose names add
/// up to a kilobyte, which a document built in memory can do and one that was parsed effectively cannot.
/// @see https://rux-lang.dev/docs/api/toml/maximum-header-path
pub const MaximumHeaderPath: uint = 1024;

// The key path of the table being written, as the bytes a header would spell it with. Kept as text rather than
// as a list of names because that is what the header needs, and building it once per table beats building it
// once per line.
struct TomlPath {
    room: var char8[..];
    length: uint;
}

extend TomlPath {
    func Append(self: &var TomlPath, bytes: char8[..]) -> bool {
        if self.length + bytes.length > self.room.length { return false; }
        var index: uint = 0;
        while index < bytes.length {
            self.room.data[self.length + index] = bytes.data[index];
            index = index + 1;
        }
        self.length = self.length + bytes.length;
        return true;
    }

    func Bytes(self: &TomlPath) -> char8[..] {
        return (self.room.data)[..self.length];
    }
}

// Whether `name` may be written without quotes: letters, digits, underscores and hyphens, and not empty.
func IsBareKey(name: char8[..]) -> bool {
    if name.length == 0 { return false; }
    var index: uint = 0;
    while index < name.length {
        let c = name.data[index] as uint8;
        let allowed = (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) ||
                      (c >= 0x30 && c <= 0x39) || c == 0x5F || c == 0x2D;
        if !allowed { return false; }
        index = index + 1;
    }
    return true;
}

func Emit(writer: &var TextWriter, bytes: char8[..]) -> ! FormatError {
    var sink = writer;
    return sink.Write(bytes);
}

func EmitByte(writer: &var TextWriter, byte: uint8) -> ! FormatError {
    var one: char8[1];
    one[0] = byte as char8;
    return Emit(writer, one[0..1]);
}

// A basic string: the quote, the backslash and every control character escaped, and nothing else. The short
// escapes are used where TOML defines them, and a four-digit form otherwise.
func EmitBasicString(writer: &var TextWriter, text: char8[..]) -> ! FormatError {
    EmitByte(writer, 0x22)?;
    var index: uint = 0;
    while index < text.length {
        let c = text.data[index] as uint8;
        if c == 0x22 || c == 0x5C {
            EmitByte(writer, 0x5C)?;
            EmitByte(writer, c)?;
        }
        else if c == 0x08 {
            Emit(writer, "\\b")?;
        }
        else if c == 0x09 {
            Emit(writer, "\\t")?;
        }
        else if c == 0x0A {
            Emit(writer, "\\n")?;
        }
        else if c == 0x0C {
            Emit(writer, "\\f")?;
        }
        else if c == 0x0D {
            Emit(writer, "\\r")?;
        }
        else if c < 0x20 || c == 0x7F {
            // The escape character has a short form in TOML 1.1, but the four-digit one is understood by 1.0
            // readers too, and choosing the older spelling costs nothing here.
            Emit(writer, "\\u00")?;
            EmitByte(writer, HexDigit(c >> 4))?;
            EmitByte(writer, HexDigit(c & 0x0F))?;
        }
        else {
            EmitByte(writer, c)?;
        }
        index = index + 1;
    }
    return EmitByte(writer, 0x22);
}

func HexDigit(value: uint8) -> uint8 {
    return value < 10 ? 0x30u8 + value : 0x41u8 + value - 10u8;
}

// A key, bare where TOML allows it and quoted where it does not.
func EmitKey(writer: &var TextWriter, name: char8[..]) -> ! FormatError {
    if IsBareKey(name) { return Emit(writer, name); }
    return EmitBasicString(writer, name);
}

// A float, at the fewest digits that read back as the same value. Fifteen digits is what a float64 always
// carries cleanly, and seventeen is what always round-trips; trying the three in order gives text that is both
// short and exact, and the same value always produces the same text.
func EmitFloat(writer: &var TextWriter, value: float64) -> ! FormatError {
    if value != value { return Emit(writer, "nan"); }
    if value > 1.7976931348623157e308 { return Emit(writer, "inf"); }
    if value < -1.7976931348623157e308 { return Emit(writer, "-inf"); }
    var storage: char8[64];
    var length: uint = 0;
    var significant: uint = 15;
    while significant <= 17 {
        var cursor = ByteCursor((@storage[0])[..64]);
        WriteDecimal(cursor, value, significant);
        let rendered = cursor.Written();
        length = rendered.length;
        let parsed = ParseFloat64(rendered) catch { else => 0.0 };
        if parsed == value {
            significant = 18;
        }
        else {
            significant = significant + 1;
        }
    }
    let text = (@storage[0])[..length];
        Emit(writer, text)?;
    // TOML tells a float from an integer by its point or its exponent, so a whole value needs one written out or
    // it would read back as an integer and stop being the same document.
    var index: uint = 0;
    while index < length {
        let c = text.data[index] as uint8;
        if c == 0x2E || c == 0x65 || c == 0x45 { return .Success(()); }
        index = index + 1;
    }
    return Emit(writer, ".0");
}

// An integer, in decimal. The other three bases are spellings of the same value, and picking one of them would
// make the output depend on how the value was written rather than on what it is.
func EmitInteger(writer: &var TextWriter, value: int64) -> ! FormatError {
    var storage: char8[24];
    var length: uint = 0;
    var negative = value < 0;
    // The most negative integer has no positive counterpart, so the magnitude is taken unsigned.
    var rest = negative ? (~(value as uint64) + 1u64) : value as uint64;
    if rest == 0 {
        storage[0] = c8'0';
        length = 1;
    }
    while rest > 0 {
        storage[length] = ((rest % 10) + 0x30) as char8;
        length = length + 1;
        rest = rest / 10;
    }
    if negative {
        storage[length] = c8'-';
        length = length + 1;
    }
    var reversed: char8[24];
    var index: uint = 0;
    while index < length {
        reversed[index] = storage[length - index - 1];
        index = index + 1;
    }
    return Emit(writer, reversed[0..length]);
}

// Two digits, which every part of a date and a time is written with except the year and the fraction.
func EmitPadded(writer: &var TextWriter, value: uint32, width: uint) -> ! FormatError {
    var storage: char8[10];
    var index = width;
    var rest = value;
    while index > 0 {
        index = index - 1;
        storage[index] = ((rest % 10) + 0x30) as char8;
        rest = rest / 10;
    }
    return Emit(writer, storage[0..width]);
}

// A date-time in whichever of the four forms the kind names, which is what keeps a local reading local.
func EmitDateTime(writer: &var TextWriter, value: &TomlValue) -> ! FormatError {
    let kind = value.Kind();
    if kind != TomlKind::LocalTime {
        EmitPadded(writer, value.date.year as uint32, 4)?;
        EmitByte(writer, 0x2D)?;
        EmitPadded(writer, value.date.month as uint32, 2)?;
        EmitByte(writer, 0x2D)?;
        EmitPadded(writer, value.date.day as uint32, 2)?;
        if kind == TomlKind::LocalDate { return .Success(()); }
        EmitByte(writer, 0x54)?;
    }
    EmitPadded(writer, value.time.hour as uint32, 2)?;
    EmitByte(writer, 0x3A)?;
    EmitPadded(writer, value.time.minute as uint32, 2)?;
    EmitByte(writer, 0x3A)?;
    EmitPadded(writer, value.time.second as uint32, 2)?;
    if value.time.nanosecond != 0 {
        EmitByte(writer, 0x2E)?;
        // Nine digits always, rather than the shortest that survives: a fixed width is what makes two documents
        // with the same instant produce the same bytes.
        EmitPadded(writer, value.time.nanosecond, 9)?;
    }
    if kind != TomlKind::OffsetDateTime { return .Success(()); }
    let seconds = value.offset.TotalSeconds();
    if seconds == 0 { return EmitByte(writer, 0x5A); }
    let magnitude = seconds < 0i32 ? -seconds : seconds;
    EmitByte(writer, seconds < 0 ? 0x2D : 0x2B)?;
    EmitPadded(writer, (magnitude / 3600) as uint32, 2)?;
    EmitByte(writer, 0x3A)?;
    return EmitPadded(writer, ((magnitude % 3600) / 60) as uint32, 2);
}

// A value written where a value belongs: on the right of an equals sign, or inside an array. A table reached
// this way is written inline, because inside an array TOML has no other spelling for one.
func EmitValue(writer: &var TextWriter, value: &TomlValue) -> ! FormatError {
    let kind = value.Kind();
    if kind == TomlKind::Boolean { return Emit(writer, value.boolean ? "true" : "false"); }
    if kind == TomlKind::Integer { return EmitInteger(writer, value.integer); }
    if kind == TomlKind::Float { return EmitFloat(writer, value.number); }
    if kind == TomlKind::Text { return EmitBasicString(writer, value.AsText().Bytes()); }
    if kind == TomlKind::Array {
                EmitByte(writer, 0x5B)?;
        var index: uint = 0;
        while index < value.Length() {
            if index > 0 {
                Emit(writer, ", ")?;
            }
            EmitValue(writer, *value.At(index))?;
            index = index + 1;
        }
        return EmitByte(writer, 0x5D);
    }
    if kind == TomlKind::Table {
        // An empty inline table is `{}` rather than `{ }`: the space belongs between entries, and there are
        // none.
        if value.Length() == 0 { return Emit(writer, "{}"); }
                Emit(writer, "{ ")?;
        var index: uint = 0;
        while index < value.Length() {
            if index > 0 {
                Emit(writer, ", ")?;
            }
            let entry = value.EntryAt(index);
            EmitKey(writer, (*entry).key.View().Bytes())?;
            Emit(writer, " = ")?;
            EmitValue(writer, (*entry).value)?;
            index = index + 1;
        }
        return Emit(writer, " }");
    }
    return EmitDateTime(writer, value);
}

// Whether an entry belongs to the body of a table — written as `key = value` — rather than to a header of its
// own. A table and an array of tables get headers; everything else, including a static array of tables, is a
// value.
func IsBodyEntry(value: &TomlValue) -> bool {
    if value.Kind() == TomlKind::Table { return false; }
    if value.Kind() == TomlKind::Array && value.tableArray { return false; }
    return true;
}

// The entries of a table that are written as `key = value` lines, in the order the table holds them.
func EmitBody(writer: &var TextWriter, table: &TomlValue) -> ! FormatError {
    var index: uint = 0;
    while index < table.Length() {
        let entry = table.EntryAt(index);
        if IsBodyEntry((*entry).value) {
                        EmitKey(writer, (*entry).key.View().Bytes())?;
            Emit(writer, " = ")?;
            EmitValue(writer, (*entry).value)?;
            EmitByte(writer, 0x0A)?;
        }
        index = index + 1;
    }
    return;
}

// A header, `[path]` or `[[path]]`, followed by a newline.
func EmitHeader(writer: &var TextWriter, path: &TomlPath, array: bool, first: bool) -> ! FormatError {
    if !first {
        // A blank line before every header but the first, which is what makes a configuration file readable and
        // is also the only whitespace this writer ever produces.
        EmitByte(writer, 0x0A)?;
    }
    Emit(writer, array ? "[[" : "[")?;
    Emit(writer, path.Bytes())?;
    Emit(writer, array ? "]]" : "]")?;
    return EmitByte(writer, 0x0A);
}

// The sub-tables of a table, each under a header of its own, after the body has been written. The order is the
// table's own, so the output of a tree is the same every time.
func EmitSections(writer: &var TextWriter, table: &TomlValue, path: &var TomlPath, written: *var uint,
                  root: bool) -> ! FormatError {
    var index: uint = 0;
    while index < table.Length() {
        let entry = table.EntryAt(index);
        if IsBodyEntry((*entry).value) {
            index = index + 1;
            continue;
        }
        let mark = path.length;
        if !root {
            if !path.Append(".") { return PathTooLong(); }
        }
        KeyIntoPath(path, (*entry).key.View().Bytes())?;
        if (*entry).value.Kind() == TomlKind::Table {
            EmitHeader(writer, path, false, *written == 0)?;
            *written = *written + 1;
            EmitBody(writer, (*entry).value)?;
            EmitSections(writer, (*entry).value, path, written, false)?;
        }
        else {
            var element: uint = 0;
            while element < (*entry).value.Length() {
                let held = (*entry).value.At(element);
                EmitHeader(writer, path, true, *written == 0)?;
                *written = *written + 1;
                EmitBody(writer, *held)?;
                EmitSections(writer, *held, path, written, false)?;
                element = element + 1;
            }
        }
        path.length = mark;
        index = index + 1;
    }
    return;
}

// A path that will not fit: the document is one this writer cannot spell a header for, which is a fact about the
// form rather than about the destination.
func PathTooLong() -> ! FormatError {
    fail FormatError::ValueOutOfRange;
}

// A key appended to the header path, in the form a header would spell it.
func KeyIntoPath(path: &var TomlPath, name: char8[..]) -> ! FormatError {
    if IsBareKey(name) { return path.Append(name) ? .Success(()) : PathTooLong(); }
    var storage: char8[512];
    var cursor = ByteCursor((@storage[0])[..512]);
    let quoted: &var TextWriter = cursor;
    EmitBasicString(quoted, name)?;
    return path.Append(cursor.Written()) ? .Success(()) : PathTooLong();
}

/// Writes `table` as a TOML document.
///
/// The same tree always produces the same bytes, and a document written, read and written again produces the
/// same bytes the second time — which is what makes this safe to run repeatedly over a file this program owns.
///
/// It is not safe in the sense of preserving one it does not: comments, blank lines, indentation and the
/// spelling of a number are not in the tree, so they cannot come out of it. The output is these values laid out
/// by this writer, which is an equivalent document and not the same file.
///
/// The document is borrowed and nothing is allocated: it writes itself into the destination as it is walked.
///
/// # Failures
/// Reports whatever the destination reported, unchanged, so a buffer that is merely full stays distinguishable
/// from a stream that has died — and stops at the first refusal rather than writing the rest of a document into a
/// destination that has already said no. Reports `ValueOutOfRange` for a table whose header path is longer than
/// `MaximumHeaderPath`.
/// @param writer the destination
/// @param table the document to write, borrowed for the call
/// @returns success when the whole document was accepted
/// @see https://rux-lang.dev/docs/api/toml/write-document
pub func TomlWriteDocument(writer: &var TextWriter, table: &TomlValue) -> ! FormatError {
    if table.Kind() != TomlKind::Table { return EmitValue(writer, table); }
    var storage: char8[1024];
    var path = TomlPath { room: (@storage[0])[..MaximumHeaderPath], length: 0 };
    EmitBody(writer, table)?;
    // The root's own lines come first, so a header needs a blank line before it unless nothing has been
    // written yet.
    var written = CountBodyEntries(table);
    return EmitSections(writer, table, path, @written, true);
}

// How many of a table's entries are written as lines rather than as sections.
func CountBodyEntries(table: &TomlValue) -> uint {
    var count: uint = 0;
    var index: uint = 0;
    while index < table.Length() {
        if IsBodyEntry((*table.EntryAt(index)).value) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}
