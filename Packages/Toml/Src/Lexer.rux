// Turning TOML text into tokens, with the position of each one.
//
// TOML has more lexical surface than JSON and almost all of it is string and number forms. There are four ways
// to write a string — basic, multi-line basic, literal, multi-line literal — and they differ in whether
// escapes are honoured and whether newlines are allowed, which is exactly the sort of distinction an
// implementation collapses and then surprises someone whose Windows path lost its backslashes.
//
// Spans are carried on every token because TOML is a configuration format, and a configuration error that does
// not say where it is costs more than the parse itself. Every diagnostic this package produces can point at a
// line and column because the token knew.

import Allocator::Allocator;
import Text::{ String, StringBuilder, TextError };

/// What kind of token this is.
/// @see https://rux-lang.dev/docs/api/toml/token-kind
pub enum TomlTokenKind: int32 {
    /// The input is exhausted.
    End = 0,
    /// A bare key: letters, digits, underscores and hyphens.
    BareKey = 1,
    /// A quoted key or a string value; the span excludes the quotes and the text may need unescaping.
    Text = 2,
    /// An integer, in any of the four bases.
    Integer = 3,
    /// A float, including the infinities and NaN that TOML — unlike JSON — can spell.
    Float = 4,
    /// `true` or `false`.
    Boolean = 5,
    /// An offset date-time, a local date-time, a local date, or a local time.
    DateTime = 6,
    /// `=`
    Equals = 7,
    /// `.`
    Dot = 8,
    /// `,`
    Comma = 9,
    /// `[`
    LeftBracket = 10,
    /// `]`
    RightBracket = 11,
    /// `{`
    LeftBrace = 12,
    /// `}`
    RightBrace = 13,
    /// One or more newlines, which TOML treats as significant.
    Newline = 14,
    /// Something that is not TOML.
    Error = 15
}

/// Which of the four string forms a text token was written in.
/// @see https://rux-lang.dev/docs/api/toml/text-form
pub enum TomlTextForm: int32 {
    /// Not a text token.
    NotText = 0,
    /// A basic string: escapes honoured, no raw newlines.
    Basic = 1,
    /// A multi-line basic string: escapes honoured, newlines allowed, a leading newline trimmed.
    MultiLineBasic = 2,
    /// A literal string: no escapes at all, which is what makes it right for Windows paths and regular
    /// expressions.
    Literal = 3,
    /// A multi-line literal string: no escapes, newlines allowed.
    MultiLineLiteral = 4,
    /// A bare key, which has no quotes and no escapes.
    Bare = 5
}

/// Why lexing stopped.
/// @see https://rux-lang.dev/docs/api/toml/lex-error
pub enum TomlLexError: int32 {
    /// Nothing went wrong.
    None = 0,
    /// A byte that begins no token.
    UnexpectedByte = 1,
    /// A string the input ended before closing.
    UnterminatedText = 2,
    /// An escape sequence TOML does not define.
    BadEscape = 3,
    /// A unicode escape that is not the right number of digits, or names no scalar value.
    BadUnicodeEscape = 4,
    /// A number whose shape TOML grammar does not allow.
    MalformedNumber = 5,
    /// A raw newline inside a single-line string.
    NewlineInText = 6,
    /// A control character appearing unescaped where TOML forbids it.
    UnescapedControl = 7,
    /// A date or time that is not the shape RFC 3339 defines.
    MalformedDateTime = 8
}

/// One token, and where it came from.
/// @see https://rux-lang.dev/docs/api/toml/token
pub struct TomlToken {
    /// What kind of token this is.
    pub kind: TomlTokenKind;
    /// Which string form, for a text token.
    pub form: TomlTextForm;
    /// Where its text starts, as a byte offset.
    pub start: uint;
    /// Where its text ends.
    pub end: uint;
    /// Which line it starts on, counting from one.
    pub line: uint;
    /// Which column it starts at, counting from one, in bytes.
    pub column: uint;
    /// Why lexing stopped, when the kind is `Error`.
    pub error: TomlLexError;
}

/// A TOML lexer over a byte slice.
/// @see https://rux-lang.dev/docs/api/toml/lexer
pub struct TomlLexer {
    /// The document.
    input: char8[..];
    /// How far reading has reached.
    position: uint;
    /// Which line that is on.
    pub line: uint;
    /// Where the current line started, so a column is a subtraction.
    lineStart: uint;
}

extend TomlLexer {
    /// A lexer over `input`.
    /// @param input the text to read
    /// @returns a lexer positioned at the start of the input
    /// @see https://rux-lang.dev/docs/api/toml/lexer/new
    pub func TomlLexer(input: char8[..]) -> TomlLexer {
        return TomlLexer { input: input, position: 0, line: 1, lineStart: 0 };
    }

    func Make(self: &TomlLexer, kind: TomlTokenKind, form: TomlTextForm, start: uint, end: uint) -> TomlToken {
        return TomlToken {
            kind: kind, form: form, start: start, end: end, line: self.line,
            column: start - self.lineStart + 1, error: TomlLexError::None
        };
    }

    func Fail(self: &TomlLexer, reason: TomlLexError) -> TomlToken {
        return TomlToken {
            kind: TomlTokenKind::Error, form: TomlTextForm::NotText, start: self.position, end: self.position,
            line: self.line, column: self.position - self.lineStart + 1, error: reason
        };
    }

    func At(self: &TomlLexer, offset: uint) -> uint8 {
        if self.position + offset >= self.input.length { return 0; }
        return self.input.data[self.position + offset] as uint8;
    }

    // Comments run to the end of the line and are not tokens: nothing above the lexer ever sees one, which is
    // also why a document read and written back loses them.
    func SkipSpaceAndComments(self: &var TomlLexer) {
        while self.position < self.input.length {
            let c = self.input.data[self.position] as uint8;
            if c == 0x20 || c == 0x09 {
                self.position = self.position + 1;
            }
            else if c == 0x23 {
                while self.position < self.input.length && (self.input.data[self.position] as uint8) != 0x0A {
                    self.position = self.position + 1;
                }
            }
            else {
                return;
            }
        }
    }

    func IsBareKeyByte(c: uint8) -> bool {
        return (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) ||
               (c >= 0x30 && c <= 0x39) || c == 0x5F || c == 0x2D;
    }

    // A string in whichever of the four forms the quotes announce. The span excludes the delimiters, and the
    // form travels with the token so the parser knows whether escapes are its business.
    func LexText(self: &var TomlLexer, quote: uint8) -> TomlToken {
        let opening = self.position;
        var multiline = false;
        if self.At(1u) == quote && self.At(2u) == quote {
            multiline = true;
            self.position = self.position + 3u;
        }
        else {
            self.position = self.position + 1u;
        }
        // A multi-line string ignores a newline immediately after its opening delimiter, which is what lets the
        // content start on the next line without gaining a leading blank.
        if multiline && self.position < self.input.length {
            if (self.input.data[self.position] as uint8) == 0x0D &&
                self.position + 1u < self.input.length &&
                (self.input.data[self.position + 1u] as uint8) == 0x0A {
                self.position = self.position + 2u;
                self.line = self.line + 1u;
                self.lineStart = self.position;
            }
            else if (self.input.data[self.position] as uint8) == 0x0A {
                self.position = self.position + 1u;
                self.line = self.line + 1u;
                self.lineStart = self.position;
            }
        }
        let start = self.position;
        let escapes = quote == 0x22;
        while self.position < self.input.length {
            let c = self.input.data[self.position] as uint8;
            if c == quote {
                if !multiline {
                    let token = self.Make(TomlTokenKind::Text, escapes ? TomlTextForm::Basic
                                                                       : TomlTextForm::Literal,
                                          start, self.position);
                    self.position = self.position + 1u;
                    return token;
                }
                if self.At(1u) == quote && self.At(2u) == quote {
                    let token = self.Make(TomlTokenKind::Text, escapes ? TomlTextForm::MultiLineBasic
                                                                       : TomlTextForm::MultiLineLiteral,
                                          start, self.position);
                    self.position = self.position + 3u;
                    return token;
                }
            }
            if c == 0x0A {
                if !multiline {
                    // A raw newline inside a single-line string is its own error, rather than being reported as
                    // an unterminated one, because it says what the writer probably meant to do.
                    return self.Fail(TomlLexError::NewlineInText);
                }
                self.line = self.line + 1u;
                self.lineStart = self.position + 1u;
            }
            else if c < 0x20 && c != 0x09 {
                return self.Fail(TomlLexError::UnescapedControl);
            }
            if escapes && c == 0x5C {
                let next = self.At(1u);
                if next == 0x75 || next == 0x55 || next == 0x78 {
                    // TOML 1.1 adds the two-digit escape, which names the same scalar values as the short form
                    // and spells the ones below 256 in half the characters.
                    var digits: uint = 8;
                    if next == 0x75 {
                        digits = 4u;
                    }
                    else if next == 0x78 {
                        digits = 2u;
                    }
                    var digit: uint = 1;
                    while digit <= digits {
                        let h = self.At(1u + digit);
                        let isDigit = (h >= 0x30 && h <= 0x39) || (h >= 0x61 && h <= 0x66) ||
                                      (h >= 0x41 && h <= 0x46);
                        if !isDigit { return self.Fail(TomlLexError::BadUnicodeEscape); }
                        digit = digit + 1u;
                    }
                    self.position = self.position + 1u + digits;
                }
                else if next == 0x22 || next == 0x5C || next == 0x62 || next == 0x66 ||
                        next == 0x6E || next == 0x72 || next == 0x74 || next == 0x65 {
                    // TOML 1.1 adds \e for escape to the set JSON defines.
                    self.position = self.position + 1u;
                }
                else if multiline && (next == 0x0A || next == 0x20 || next == 0x09 || next == 0x0D) {
                    // A line-ending backslash in a multi-line string swallows the whitespace that follows it,
                    // which is how a long string is wrapped without gaining the wrapping.
                    self.position = self.position + 1u;
                }
                else {
                    return self.Fail(TomlLexError::BadEscape);
                }
            }
            self.position = self.position + 1u;
        }
        self.position = opening;
        return self.Fail(TomlLexError::UnterminatedText);
    }

    // A bare token: a key, a keyword, a number, or a date-time. TOML does not separate these lexically — the
    // run of characters has to be scanned and then classified — because `1979-05-27` is a date and `1979` is
    // an integer and both start the same way.
    func LexBare(self: &var TomlLexer) -> TomlToken {
        let start = self.position;
        var sawColon = false;
        var sawDash = false;
        var sawDot = false;
        var sawExponent = false;
        var allDigits = true;
        var index = self.position;
        while index < self.input.length {
            let c = self.input.data[index] as uint8;
            let isWord = (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) ||
                         (c >= 0x30 && c <= 0x39) || c == 0x5F;
            if isWord {
                // An underscore between digits is a separator inside a number, so it does not end the run of
                // digits a decimal point may follow — otherwise `224_617.445` would lex as two tokens and a
                // dot. One at the very start begins a bare key instead, and does end it.
                let digit = c >= 0x30 && c <= 0x39;
                let separator = c == 0x5F && index != start && allDigits;
                if !digit && !separator {
                    allDigits = false;
                }
                index = index + 1;
                continue;
            }
            // A sign at the very start belongs to the number, so it does not stop the run of digits that a
            // decimal point is allowed to follow: without this, `-0.01` would lex as `-0`, a dot and `01`.
            if c == 0x2D {
                if index != start {
                    sawDash = true;
                    allDigits = false;
                }
                index = index + 1;
                continue;
            }
            if c == 0x2B {
                if index != start {
                    allDigits = false;
                }
                index = index + 1;
                continue;
            }
            if c == 0x3A {
                sawColon = true;
                allDigits = false;
                index = index + 1;
                continue;
            }
            // A dot continues the token only when it looks like part of a number or the fraction of a time;
            // otherwise it is the dotted-key separator and belongs to the parser. A colon can only have come
            // from a time, since a colon in a key means the key was quoted and did not reach here.
            if c == 0x2E && (allDigits || sawColon) {
                sawDot = true;
                allDigits = false;
                index = index + 1;
                continue;
            }
            // A space continues the token only between a date and a time, which is the one place TOML lets a
            // value contain one.
            if c == 0x20 && sawDash && !sawColon && index + 1 < self.input.length {
                let after = self.input.data[index + 1] as uint8;
                if after >= 0x30 && after <= 0x39 && self.LooksLikeTime(index + 1) {
                    sawColon = true;
                    index = index + 2;
                    continue;
                }
            }
            break;
        }
        let end = index;
        if end == start { return self.Fail(TomlLexError::UnexpectedByte); }
        let first = self.input.data[start] as uint8;
        let digitLike = (first >= 0x30 && first <= 0x39) || first == 0x2B || first == 0x2D;
        var kind = TomlTokenKind::BareKey;
        if self.Matches(start, end, "true") || self.Matches(start, end, "false") {
            kind = TomlTokenKind::Boolean;
        }
        else if self.Matches(start, end, "inf") || self.Matches(start, end, "nan") ||
                self.Matches(start, end, "+inf") || self.Matches(start, end, "-inf") ||
                self.Matches(start, end, "+nan") || self.Matches(start, end, "-nan") {
            kind = TomlTokenKind::Float;
        }
        else if digitLike && (sawColon || self.LooksLikeDate(start, end)) {
            kind = TomlTokenKind::DateTime;
        }
        else if digitLike {
            kind = sawDot || sawExponent || self.HasExponent(start, end) ? TomlTokenKind::Float
                                                                        : TomlTokenKind::Integer;
        }
        let token = self.Make(kind, kind == TomlTokenKind::BareKey ? TomlTextForm::Bare : TomlTextForm::NotText,
                              start, end);
        self.position = end;
        return token;
    }

    // A date opens with four digits and a hyphen. Requiring the shape rather than merely the presence of a
    // hyphen is what keeps `6.626e-34` a float: its hyphen belongs to the exponent, not to a month.
    func LooksLikeDate(self: &TomlLexer, start: uint, end: uint) -> bool {
        if end - start < 5 { return false; }
        var index: uint = 0;
        while index < 4 {
            let c = self.input.data[start + index] as uint8;
            if c < 0x30 || c > 0x39 { return false; }
            index = index + 1;
        }
        return (self.input.data[start + 4] as uint8) == 0x2D;
    }

    func LooksLikeTime(self: &TomlLexer, at: uint) -> bool {
        // `HH:MM`, the shortest thing that can follow a date across a space.
        if at + 4 >= self.input.length { return false; }
        return (self.input.data[at + 2] as uint8) == 0x3A;
    }

    // A hexadecimal float is not TOML, so an `e` that could be a hex digit only counts as an exponent when the
    // number is decimal — which is why this looks at the prefix first.
    func HasExponent(self: &TomlLexer, start: uint, end: uint) -> bool {
        if end - start > 2 && (self.input.data[start] as uint8) == 0x30 {
            let radix = self.input.data[start + 1] as uint8;
            if radix == 0x78 || radix == 0x6F || radix == 0x62 { return false; }
        }
        var index = start;
        while index < end {
            let c = self.input.data[index] as uint8;
            if c == 0x65 || c == 0x45 { return true; }
            index = index + 1;
        }
        return false;
    }

    func Matches(self: &TomlLexer, start: uint, end: uint, word: char8[..]) -> bool {
        if end - start != word.length { return false; }
        var index: uint = 0;
        while index < word.length {
            if self.input.data[start + index] != word.data[index] { return false; }
            index = index + 1;
        }
        return true;
    }

    /// The next token, or `End` at the end of the input.
    /// @returns the next token, or the end-of-input token
    /// @see https://rux-lang.dev/docs/api/toml/lexer/next
    pub func Next(self: &var TomlLexer) -> TomlToken {
        self.SkipSpaceAndComments();
        if self.position >= self.input.length {
            return self.Make(TomlTokenKind::End, TomlTextForm::NotText, self.position, self.position);
        }
        let c = self.input.data[self.position] as uint8;
        if c == 0x0D || c == 0x0A {
            let start = self.position;
            let token = self.Make(TomlTokenKind::Newline, TomlTextForm::NotText, start, start + 1);
            if c == 0x0D {
                self.position = self.position + 1;
                if self.position < self.input.length && (self.input.data[self.position] as uint8) == 0x0A {
                    self.position = self.position + 1;
                }
            }
            else {
                self.position = self.position + 1;
            }
            self.line = self.line + 1;
            self.lineStart = self.position;
            return token;
        }
        if c == 0x22 || c == 0x27 { return self.LexText(c); }
        if c == 0x3D {
            let token = self.Make(TomlTokenKind::Equals, TomlTextForm::NotText, self.position,
                                  self.position + 1);
            self.position = self.position + 1;
            return token;
        }
        if c == 0x2E {
            let token = self.Make(TomlTokenKind::Dot, TomlTextForm::NotText, self.position, self.position + 1);
            self.position = self.position + 1;
            return token;
        }
        if c == 0x2C {
            let token = self.Make(TomlTokenKind::Comma, TomlTextForm::NotText, self.position,
                                  self.position + 1);
            self.position = self.position + 1;
            return token;
        }
        if c == 0x5B {
            let token = self.Make(TomlTokenKind::LeftBracket, TomlTextForm::NotText, self.position,
                                  self.position + 1);
            self.position = self.position + 1;
            return token;
        }
        if c == 0x5D {
            let token = self.Make(TomlTokenKind::RightBracket, TomlTextForm::NotText, self.position,
                                  self.position + 1);
            self.position = self.position + 1;
            return token;
        }
        if c == 0x7B {
            let token = self.Make(TomlTokenKind::LeftBrace, TomlTextForm::NotText, self.position,
                                  self.position + 1);
            self.position = self.position + 1;
            return token;
        }
        if c == 0x7D {
            let token = self.Make(TomlTokenKind::RightBrace, TomlTextForm::NotText, self.position,
                                  self.position + 1);
            self.position = self.position + 1;
            return token;
        }
        if TomlLexer::IsBareKeyByte(c) || c == 0x2B { return self.LexBare(); }
        return self.Fail(TomlLexError::UnexpectedByte);
    }

    /// The bytes a token spans, which for a text token excludes the quotes and is still escaped.
    /// @param token the token to read
    /// @returns the token's text, borrowed from the input
    /// @see https://rux-lang.dev/docs/api/toml/lexer/text-of
    pub func TextOf(self: &TomlLexer, token: &TomlToken) -> char8[..] {
        return (self.input.data + token.start)[..token.end - token.start];
    }
}

/// Decodes a text token's span into an owned string, honouring the escapes its form allows.
///
/// A literal string is copied unchanged — that is what makes it the right form for a Windows path — while a
/// basic string has its escapes resolved, including the line-ending backslash that lets a multi-line string be
/// wrapped in the source without the wrapping appearing in the value.
/// @param allocator where the storage comes from
/// @param span the raw text the token covers
/// @param form which quoting form the text was written in
/// @param bad receives the offset of the first byte that could not be decoded
/// @returns the decoded text, or why it could not be stored
/// @see https://rux-lang.dev/docs/api/toml/decode-text
pub func TomlDecodeText(allocator: Allocator, span: char8[..], form: TomlTextForm,
                    bad: *var bool) -> String ! TextError {
    *bad = false;
    if form == TomlTextForm::Literal || form == TomlTextForm::MultiLineLiteral || form == TomlTextForm::Bare {
        return String::FromBytes(allocator, span);
    }
    let multiline = form == TomlTextForm::MultiLineBasic;
    var builder = StringBuilder(allocator);
    var index: uint = 0;
    while index < span.length {
        let c = span.data[index] as uint8;
        if c != 0x5C {
            // The run up to the next escape goes in one piece. Byte at a time would split a multi-byte scalar
            // across two appends, and a builder that validates what it is given refuses half of one — so an
            // accented letter beside an escape would quietly disappear.
            var run = index;
            while run < span.length && (span.data[run] as uint8) != 0x5C {
                run = run + 1;
            }
            let piece = (@span.data[index])[..run - index];
            builder.AppendBytes(piece)?;
            index = run;
            continue;
        }
        index = index + 1;
        if index >= span.length {
            *bad = true;
            break;
        }
        let kind = span.data[index] as uint8;
        index = index + 1;
        if kind == 0x75 || kind == 0x55 || kind == 0x78 {
            var digits: uint = 8;
            if kind == 0x75 {
                digits = 4;
            }
            else if kind == 0x78 {
                digits = 2;
            }
            if index + digits > span.length {
                *bad = true;
                break;
            }
            let scalar = TomlHexRun(span, index, digits);
            index = index + digits;
            // TOML escapes name scalar values, not UTF-16 code units, so a surrogate is simply not one of them
            // and there is no pairing rule to get wrong.
            if scalar > 0x10FFFF || (scalar >= 0xD800 && scalar <= 0xDFFF) {
                *bad = true;
                break;
            }
            builder.AppendScalar(scalar as char32)?;
        }
        else if kind == 0x62 {
            builder.AppendAscii(0x08u8 as char8)?;
        }
        else if kind == 0x66 {
            builder.AppendAscii(0x0Cu8 as char8)?;
        }
        else if kind == 0x6E {
            builder.AppendAscii(0x0Au8 as char8)?;
        }
        else if kind == 0x72 {
            builder.AppendAscii(0x0Du8 as char8)?;
        }
        else if kind == 0x74 {
            builder.AppendAscii(0x09u8 as char8)?;
        }
        else if kind == 0x65 {
            builder.AppendAscii(0x1Bu8 as char8)?;
        }
        else if kind == 0x22 || kind == 0x5C {
            builder.AppendAscii(kind as char8)?;
        }
        else if multiline && (kind == 0x0A || kind == 0x0D || kind == 0x20 || kind == 0x09) {
            index = index - 1;
            while index < span.length {
                let w = span.data[index] as uint8;
                if w != 0x20 && w != 0x09 && w != 0x0A && w != 0x0D { break; }
                index = index + 1;
            }
        }
        else {
            *bad = true;
            break;
        }
    }
    return builder.IntoString();
}

// A run of hexadecimal digits at `at`, as a value. The lexer has already established they are digits.
func TomlHexRun(span: char8[..], at: uint, count: uint) -> uint32 {
    var value: uint32 = 0;
    var index: uint = 0;
    while index < count {
        let c = span.data[at + index] as uint8;
        var digit: uint32 = 0;
        if c >= 0x30 && c <= 0x39 {
            digit = (c - 0x30) as uint32;
        }
        else if c >= 0x61 && c <= 0x66 {
            digit = (c - 0x61 + 10) as uint32;
        }
        else {
            digit = (c - 0x41 + 10) as uint32;
        }
        value = (value << 4) | digit;
        index = index + 1;
    }
    return value;
}
