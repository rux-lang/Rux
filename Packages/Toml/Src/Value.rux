// What a TOML value is, and what a table remembers about how it was made.
// TOML has real types where JSON has one number and a great deal of hope: an integer is an integer, a float is a
// float, and a date is a date. That is most of what makes TOML pleasant to write configuration in, and it is why
// a value here carries a `Date` and a `TimeOfDay` from `Time` rather than the text it was written with.
// A table also remembers how it came to exist. TOML forbids defining the same table twice, and forbids adding to
// one that was written inline or reached through a dotted key — three different mistakes with three different
// reasons. The flags below are what let the parser say which one happened instead of reporting a duplicate and
// leaving the writer to work out why.

import Allocator::Allocator;
import Collections::Vector;
import Text::{ String, StringView, TextError };
import Time::{ Date, TimeOfDay, UtcOffset };

/// Which kind of TOML value this is.
/// @see https://rux-lang.dev/docs/api/toml/toml-value#toml-kind
pub enum TomlKind: int32 {
    /// A string, whichever of the four forms it was written in.
    Text = 0,
    /// A 64-bit signed integer.
    Integer = 1,
    /// A 64-bit float, which unlike JSON may be an infinity or a NaN.
    Float = 2,
    /// `true` or `false`.
    Boolean = 3,
    /// A date and time with a known offset from UTC, which names a moment.
    OffsetDateTime = 4,
    /// A date and time with no offset, which names a reading of a wall clock.
    LocalDateTime = 5,
    /// A date with no time.
    LocalDate = 6,
    /// A time with no date.
    LocalTime = 7,
    /// An ordered sequence of values.
    Array = 8,
    /// A table of entries, in the order they were seen.
    Table = 9
}

/// One entry of a table: its key and its value.
/// @see https://rux-lang.dev/docs/api/toml/toml-value#toml-entry
pub struct TomlEntry {
    /// The key, already unquoted and unescaped.
    pub key: String;
    /// The value.
    pub value: TomlValue;
}

/// A TOML value: one of the ten kinds, owning whatever it holds.
/// Move-only, because it owns strings and nested values. The allocator it was built with travels with it, so a
/// subtree can be released without the caller having to remember where it came from.
/// @see https://rux-lang.dev/docs/api/toml/toml-value
pub struct TomlValue {
    /// Which of the ten kinds this is.
    pub kind: TomlKind;
    /// The payload of a `Boolean`.
    boolean: bool;
    /// The payload of an `Integer`.
    pub integer: int64;
    /// The payload of a `Float`.
    number: float64;
    /// The payload of a `Text`.
    text: String;
    /// The date part, for the three kinds that have one.
    date: Date;
    /// The time part, for the three kinds that have one.
    time: TimeOfDay;
    /// The offset, for an `OffsetDateTime`.
    offset: UtcOffset;
    /// The elements of an `Array`.
    elements: Vector<TomlValue>;
    /// The entries of a `Table`, in the order they were seen.
    entries: Vector<TomlEntry>;
    /// Whether a table was written out — as a header or an inline table — rather than merely implied by a
    /// longer key passing through it.
    defined: bool;
    /// Whether a table was written inline, which closes it to any later addition.
    inlined: bool;
    /// Whether a table was created by a dotted key, which closes it to any later header.
    dotted: bool;
    /// Whether an array was built from `[[name]]` headers, which is the one kind of array a later line may
    /// append to.
    tableArray: bool;
    /// Where everything above came from.
    allocator: Allocator;
}

extend TomlValue {
    /// An empty table, which is also the shape every other kind is built from: TOML has no null to start from.
    /// @param allocator where the storage comes from
    /// @returns an empty table
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#table
    pub func Table(allocator: Allocator) -> Self {
        return Self {
            kind: TomlKind::Table,
            boolean: false,
            integer: 0,
            number: 0.0,
            text: String(allocator),
            date: Date { year: 1970, month: 1, day: 1 },
            time: TimeOfDay { hour: 0, minute: 0, second: 0, nanosecond: 0 },
            offset: UtcOffset::Utc(),
            elements: Vector<Self>(allocator),
            entries: Vector<TomlEntry>(allocator),
            defined: false,
            inlined: false,
            dotted: false,
            tableArray: false,
            allocator
        };
    }

    /// An empty array.
    /// @param allocator where the storage comes from
    /// @returns an empty array
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#array
    pub func Array(allocator: Allocator) -> Self {
        var held = Self::Table(allocator);
        held.kind = TomlKind::Array;
        return move held;
    }

    /// A string value, whose bytes are copied and validated as UTF-8.
    /// @param allocator where the storage comes from
    /// @param value the value to act on
    /// @returns that text as a string value, or `InvalidUtf8` when it is not text
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#text
    pub func Text(allocator: Allocator, value: char8[..]) -> Self ! TextError {
        var held = Self::Table(allocator);
        held.kind = TomlKind::Text;
        held.text = String::FromBytes(allocator, value)?;
        return move held;
    }

    /// A string value copying an already-built string.
    /// @param allocator where the storage comes from
    /// @param value the value to act on
    /// @returns that owned string as a string value
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#from-string
    pub func FromString(allocator: Allocator, value: String) -> Self {
        var held = Self::Table(allocator);
        held.kind = TomlKind::Text;
        held.text.Clear();
        held.text = move value;
        return move held;
    }

    /// An integer value.
    /// @param allocator where the storage comes from
    /// @param value the value to act on
    /// @returns that integer as a value
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#integer
    pub func Integer(allocator: Allocator, value: int64) -> Self {
        var held = Self::Table(allocator);
        held.kind = TomlKind::Integer;
        held.integer = value;
        return move held;
    }

    /// A float value, which TOML — unlike JSON — allows to be an infinity or a NaN.
    /// @param allocator where the storage comes from
    /// @param value the value to act on
    /// @returns that float as a value
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#float
    pub func Float(allocator: Allocator, value: float64) -> Self {
        var held = Self::Table(allocator);
        held.kind = TomlKind::Float;
        held.number = value;
        return move held;
    }

    /// A boolean value.
    /// @param allocator where the storage comes from
    /// @param value the value to act on
    /// @returns that boolean as a value
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#boolean
    pub func Boolean(allocator: Allocator, value: bool) -> Self {
        var held = Self::Table(allocator);
        held.kind = TomlKind::Boolean;
        held.boolean = value;
        return move held;
    }

    /// A date and time with a known offset, which names a moment on the timeline.
    /// @param allocator where the storage comes from
    /// @param date the calendar date
    /// @param time the time of day
    /// @param offset the offset from UTC
    /// @returns a value carrying the date, the time and the offset from UTC
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#offset-date-time
    pub func OffsetDateTime(allocator: Allocator, date: Date, time: TimeOfDay, offset: UtcOffset) -> Self {
        var held = Self::Table(allocator);
        held.kind = TomlKind::OffsetDateTime;
        held.date = date;
        held.time = time;
        held.offset = offset;
        return move held;
    }

    /// A date and time with no offset, which names a wall clock reading rather than a moment.
    /// @param allocator where the storage comes from
    /// @param date the calendar date
    /// @param time the time of day
    /// @returns a value carrying the date and the time, with no offset
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#local-date-time
    pub func LocalDateTime(allocator: Allocator, date: Date, time: TimeOfDay) -> Self {
        var held = Self::Table(allocator);
        held.kind = TomlKind::LocalDateTime;
        held.date = date;
        held.time = time;
        return move held;
    }

    /// A date with no time.
    /// @param allocator where the storage comes from
    /// @param date the calendar date
    /// @returns a value carrying the date alone
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#local-date
    pub func LocalDate(allocator: Allocator, date: Date) -> Self {
        var held = Self::Table(allocator);
        held.kind = TomlKind::LocalDate;
        held.date = date;
        return move held;
    }

    /// A time with no date.
    /// @param allocator where the storage comes from
    /// @param time the time of day
    /// @returns a value carrying the time alone
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#local-time
    pub func LocalTime(allocator: Allocator, time: TimeOfDay) -> Self {
        var held = Self::Table(allocator);
        held.kind = TomlKind::LocalTime;
        held.time = time;
        return move held;
    }

    /// Which kind this value is.
    /// @returns which of the TOML kinds this is
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#kind
    pub func Kind(&self) -> TomlKind {
        return self.kind;
    }

    /// The boolean payload, or `false` when this is not a boolean — which `Kind` distinguishes from a genuine
    /// `false`.
    /// @param result receives the value when this reports true
    /// @returns whether this is a boolean
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#as-boolean
    pub func AsBoolean(&self, result: *var bool) -> bool {
        if self.kind != TomlKind::Boolean { return false; }
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `bool`.
        unsafe { *result = self.boolean; }
        return true;
    }

    /// The integer payload, or `false` when this is not an integer.
    /// A float is not converted, even when its value happens to be whole: TOML distinguishes `1` from `1.0` and
    /// collapsing them here would throw away a distinction the document was making.
    /// @param result receives the value when this reports true
    /// @returns whether this is an integer
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#as-integer
    pub func AsInteger(&self, result: *var int64) -> bool {
        if self.kind != TomlKind::Integer { return false; }
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `int64`.
        unsafe { *result = self.integer; }
        return true;
    }

    /// The float payload, or `false` when this is not a float.
    /// @param result receives the value when this reports true
    /// @returns whether this is a float
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#as-float
    pub func AsFloat(&self, result: *var float64) -> bool {
        if self.kind != TomlKind::Float { return false; }
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `float64`.
        unsafe { *result = self.number; }
        return true;
    }

    /// The string payload, or an empty view when this is not a string.
    /// @returns the string, or an empty view when this is not one
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#as-text
    pub func AsText(&self) -> StringView {
        if self.kind != TomlKind::Text { return StringView(); }
        return self.text.View();
    }

    /// The date part, or `false` when this kind has none.
    /// @param result receives the value when this reports true
    /// @returns whether this carries a date
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#as-date
    pub func AsDate(&self, result: *var Date) -> bool {
        if self.kind != TomlKind::OffsetDateTime && self.kind != TomlKind::LocalDateTime &&
            self.kind != TomlKind::LocalDate {
            return false;
        }
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `Date`.
        unsafe { *result = self.date; }
        return true;
    }

    /// The time part, or `false` when this kind has none.
    /// @param result receives the value when this reports true
    /// @returns whether this carries a time
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#as-time
    pub func AsTime(&self, result: *var TimeOfDay) -> bool {
        if self.kind != TomlKind::OffsetDateTime && self.kind != TomlKind::LocalDateTime &&
            self.kind != TomlKind::LocalTime {
            return false;
        }
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `TimeOfDay`.
        unsafe { *result = self.time; }
        return true;
    }

    /// The offset, or `false` when this is not an offset date-time.
    /// A local date-time deliberately has none: it names a wall clock reading, and inventing an offset for it is
    /// how a meeting ends up an hour out.
    /// @param result receives the value when this reports true
    /// @returns whether this carries an offset from UTC
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#as-offset
    pub func AsOffset(&self, result: *var UtcOffset) -> bool {
        if self.kind != TomlKind::OffsetDateTime { return false; }
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `UtcOffset`.
        unsafe { *result = self.offset; }
        return true;
    }

    /// How many elements an array holds, or entries a table holds; zero for anything else.
    /// @returns how many elements or entries this holds; zero for anything else
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#length
    pub func Length(&self) -> uint {
        if self.kind == TomlKind::Array { return self.elements.Length(); }
        if self.kind == TomlKind::Table { return self.entries.Length(); }
        return 0;
    }

    /// Appends `value` to an array, taking ownership of it.
    /// Reports `false` when this is not an array; `value` is consumed either way, so a
    /// caller does not have to decide who owns it on failure.
    /// @param value the value to act on
    /// @returns whether the element was appended
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#push
    pub func Push(&var self, value: Self) -> bool {
        if self.kind != TomlKind::Array { return false; }
        self.elements.Push(move value);
        return true;
    }

    /// Appends an entry to a table, copying the key and taking ownership of the value.
    /// The order entries are added in is the order they are kept and written, which is what makes a document
    /// round-trip recognisably. Nothing here rejects a repeated key — that is the parser's business, where the
    /// three different ways of repeating one can be told apart.
    /// @param key the key to look up
    /// @param value the value to act on
    /// @returns whether the entry was added
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#insert
    pub func Insert(&var self, key: String, value: Self) -> bool {
        if self.kind != TomlKind::Table { return false; }
        var entry = TomlEntry { key: move key, value: move value };
        self.entries.Push(move entry);
        return true;
    }

    /// The element at `index`, borrowed, or `none` when there is none.
    /// `self` stays borrowed while the reference is in use.
    /// @param index which one, counting from zero
    /// @returns the element at `index`, or `none` when there is none
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#at
    pub func At(&self, index: uint) -> &Self? {
        if self.kind != TomlKind::Array { return none; }
        return self.elements.At(index);
    }

    /// The element at `index`, borrowed for modification, or `none` when there is none.
    /// This is how an array of tables grows: the header that opens a new one appends, and the lines under it
    /// are written into the last element in place.
    /// @param index which one, counting from zero
    /// @returns the element at `index` for writing, or `none` when there is none
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#at-mutable
    pub func AtMutable(&var self, index: uint) -> &var Self? {
        if self.kind != TomlKind::Array { return none; }
        return self.elements.AtMutable(index);
    }

    /// The value under `key`, borrowed, or `none` when the table has none.
    /// @param key the key to look up
    /// @returns the value under that key, or `none` when there is none
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#find
    pub func Find(&self, key: StringView) -> &Self? {
        if self.kind != TomlKind::Table { return none; }
        var index: uint = 0;
        while index < self.entries.Length() {
            var held = key;
            if self.entries.At(index) is .Some(entry) && entry.key.View().Equals(held) { return entry.value; }
            index = index + 1;
        }
        return none;
    }

    /// The value under `key`, borrowed for modification, or `none` when the table has none.
    /// @param key the key to look up
    /// @returns the value under that key for writing, or `none` when there is none
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#find-mutable
    pub func FindMutable(&var self, key: StringView) -> &var Self? {
        if self.kind != TomlKind::Table { return none; }
        var index: uint = 0;
        while index < self.entries.Length() {
            var held = key;
            if self.entries.AtMutable(index) is .Some(entry) && entry.key.View().Equals(held) { return entry.value; }
            index = index + 1;
        }
        return none;
    }

    /// The entry at `index`, borrowed, or `none` when there is none.
    /// @param index which one, counting from zero
    /// @returns the entry at `index`, or `none` when there is none
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#entry-at
    pub func EntryAt(&self, index: uint) -> &TomlEntry? {
        if self.kind != TomlKind::Table { return none; }
        return self.entries.At(index);
    }

    // The address of the value under `key`, or null when the table has none. The parser walks the document with a
    // cursor it carries from one table to the next while it inserts into them, which a reference cannot be, so it
    // keeps an address instead; the address stays valid until the table that holds the value grows.
    func FindAddress(&var self, key: StringView) -> *var Self {
        if self.kind != TomlKind::Table { return null; }
        var slice = self.entries.AsMutableSlice();
        var index: uint = 0;
        while index < slice.length {
            var held = key;
            // Safety: `index` is below `slice.length`, checked by the loop.
            if unsafe { slice.data[index].key.View().Equals(held) } { return unsafe { @slice.data[index].value }; }
            index = index + 1;
        }
        return null;
    }

    // The address of the last element of an array, or null when it has none, for the parser's cursor as above.
    func LastAddress(&var self) -> *var Self {
        if self.kind != TomlKind::Array || self.elements.Length() == 0 { return null; }
        var slice = self.elements.AsMutableSlice();
        // Safety: the array is not empty, checked above, so its last index is below `slice.length`.
        return unsafe { @slice.data[slice.length - 1] };
    }

    /// Releases everything this value owns.
    /// Written out rather than left to the compiler, because a value owns its string and its children own
    /// theirs: the recursion here is the shape of the document, and stating it makes the ownership of a nested
    /// tree something a reader can check.
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#destructor
    func ~TomlValue(&var self) {
        self.text.Clear();
        // Each element taken out dies at the end of its test, taking its own children with it.
        while self.elements.Pop() is .Some(_) {}
        self.entries.Clear();
    }
}

extend TomlEntry {
    /// Releases the key and the value.
    /// @see https://rux-lang.dev/docs/api/toml/toml-value#toml-entry-destructor
    func ~TomlEntry(&var self) {
        self.key.Clear();
    }
}
