// Turning a scalar token's text into a value, with TOML's grammar applied rather than assumed.
// Every rule here is one a permissive reader would let through and a strict one would not: an underscore has to
// sit between two digits, a decimal integer may not carry a leading zero, a float needs digits on both sides of
// its point. None of that is decoration. `010` meaning eight to one reader and ten to another is how a port
// number becomes the wrong port number, and TOML's answer is that it means neither — it is simply not a TOML
// integer, and saying so is the job of this file.
// Each refusal says where. A scalar is short, so a reader given only "malformed" has to find the offending
// character themselves — and the reader most often given one is a person looking at a configuration file that
// stopped a program starting. The offsets are into the scalar's own text, counted in bytes from its first
// character, and the parser adds the token's own position to reach a line and a column in the document.
// Getting that right takes one piece of bookkeeping: underscores are stripped before the digits are checked, so
// an offset into the stripped text is not an offset into what the caller wrote. `Stripped` keeps, for each byte
// it copies, where that byte came from, and every offset reported below is mapped back through it. `1_0_x0` must
// point at the `x`, not at the fourth character of something the caller never saw.

import Format::{ ParseError, ParseFloat64, ParseInt64 };
import Math::{ PositiveInfinity64, QuietNan64 };
import Text::{ Debug, Display, FormatError, FormatSpec, ParseFailure, RejectStyle, TextWriter, WriteAscii, WriteBytes };
import Time::{ Date, TimeOfDay, UtcOffset };

/// Why a scalar could not be read, and where in it.
/// Failure-only: there is no case meaning nothing went wrong, because a scalar that read hands back its value
/// instead. Every offset is a zero-based byte offset into the scalar's own text, as the caller wrote it —
/// underscores included — and reachable through `Text::ParseFailure`.
/// @see https://rux-lang.dev/docs/api/toml/toml-scalar-error
pub variant TomlScalarError {
    /// The text does not have the shape TOML defines, at the byte carried. That is the first character that
    /// cannot be part of what was being read: a digit the base does not have, a point with nothing after it, an
    /// underscore that is not between two digits, or the end of the text when it stops early.
    Malformed(uint),
    /// The value is outside what an `int64`, a `float64` or the calendar can hold. The offset is the start of the
    /// text, since it is the whole value that does not fit rather than any one character of it.
    OutOfRange(uint),
    /// The text is longer than any TOML scalar needs. The offset is the first character past the bound.
    TooLong(uint)
}

extend TomlScalarError : ParseFailure {
    /// Where in the scalar's text the failure was found.
    /// Borrows the failure and leaves it untouched. Cannot fail; runs in constant time and allocates nothing.
    /// @returns the zero-based byte offset into the scalar's own text
    /// @see https://rux-lang.dev/docs/api/toml/toml-scalar-error#offset
    pub func Offset(&self) -> uint {
        return match self {
            .Malformed(at) => at,
            .OutOfRange(at) => at,
            .TooLong(at) => at
        };
    }
}

extend TomlScalarError : Display {
    /// Writes the description of why the scalar could not be read, without the position.
    /// The offset is a number a caller places where it makes sense for them — beside a line and column, or not at
    /// all — so it is not written into the middle of a sentence here. `Debug` carries it.
    /// Reports whatever the writer reported, and `UnsupportedRequest` for any style or precision.
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the whole description was accepted
    /// @see https://rux-lang.dev/docs/api/toml/toml-scalar-error#write-display
    pub func WriteDisplay(&self, writer: &var TextWriter,
                          spec: FormatSpec) throws FormatError {
        try RejectStyle(spec);
        if spec.HasPrecision() { throw FormatError::UnsupportedRequest; }
        return match self {
            .Malformed(_) => try WriteBytes(writer, "not the shape TOML defines"),
            .OutOfRange(_) => try WriteBytes(writer, "value outside what its type can hold"),
            .TooLong(_) => try WriteBytes(writer, "longer than any TOML scalar needs")
        };
    }
}

extend TomlScalarError : Debug {
    /// Names the case and its position: `TomlScalarError::Malformed(3)`.
    /// Reports whatever the writer reported, and `UnsupportedRequest` for any style or precision.
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the whole name was accepted
    /// @see https://rux-lang.dev/docs/api/toml/toml-scalar-error#write-debug
    pub func WriteDebug(&self, writer: &var TextWriter,
                        spec: FormatSpec) throws FormatError {
        try RejectStyle(spec);
        if spec.HasPrecision() { throw FormatError::UnsupportedRequest; }
        try WriteBytes(writer, "TomlScalarError::");
        match self {
            .Malformed(_) => try WriteBytes(writer, "Malformed"),
            .OutOfRange(_) => try WriteBytes(writer, "OutOfRange"),
            .TooLong(_) => try WriteBytes(writer, "TooLong")
        }
        try WriteAscii(writer, c8'(');
        let at: Display = self.Offset();
        try at.WriteDisplay(writer, FormatSpec::Plain());
        return try WriteAscii(writer, c8')');
    }
}

// The longest number TOML can spell that this will accept: sixty-four binary digits, a prefix, a sign and a
// generous allowance of underscores. Anything longer is out of range for an int64 anyway, so the bound costs no
// document that was going to parse.
const ScalarCapacity: uint = 160;

// The digits with underscores removed, and where each of them came from, so an offset found in the stripped text
// can be reported against the text the caller actually wrote.
struct Stripped {
    digits: char8[160];
    origin: uint[160];
    length: uint;
    // How long the original was, which is where an offset at the end of the digits points.
    source: uint;
}

extend Stripped {
    // The byte of the original text that stripped byte `at` came from. At the end of the digits, the end of the
    // original — which is where "it stopped early" points.
    func Source(&self, at: uint) -> uint {
        if at >= self.length { return self.source; }
        return self.origin[at];
    }
}

// Copies `text` into `into`, dropping underscores and refusing any that is not surrounded by digits of the base.
// A refused underscore reports its own position in the original, since that is the character at fault.
func StripUnderscores(text: char8[..], into: &var Stripped, at: &var uint) -> bool {
    into.length = 0;
    into.source = text.length;
    var index: uint = 0;
    while index < text.length {
        // Safety: `index` is below `text.length`, checked by the loop.
        let c = unsafe { text.data[index] } as uint8;
        if c == 0x5F {
            if index == 0 || index + 1 == text.length {
                at = index;
                return false;
            }
            // Safety: `index` is neither zero nor the last index, checked above, so both neighbours lie inside `text`.
            let before = unsafe { text.data[index - 1] } as uint8;
            // Safety: as above, `index + 1` is below `text.length`.
            let after = unsafe { text.data[index + 1] } as uint8;
            if !IsBaseDigit(before) || !IsBaseDigit(after) {
                at = index;
                return false;
            }
            index = index + 1;
            continue;
        }
        // Safety: `index` is below `text.length`, checked by the loop.
        into.digits[into.length] = unsafe { text.data[index] };
        into.origin[into.length] = index;
        into.length = into.length + 1;
        index = index + 1;
    }
    return true;
}

// Whether `c` is a digit in any base TOML writes, which is all an underscore's neighbours have to be.
func IsBaseDigit(c: uint8) -> bool {
    return (c >= 0x30 && c <= 0x39) || (c >= 0x61 && c <= 0x66) || (c >= 0x41 && c <= 0x46);
}

/// Reads an integer, in any of the four bases TOML writes.
/// A leading zero is refused for a decimal integer, because `010` is eight in one language and ten in another
/// and TOML declines to pick: it is not an integer at all. A sign is refused on a based integer for the same
/// reason — the grammar does not offer one, so accepting it would be inventing a dialect.
/// `Malformed` at the first character that cannot be part of the integer, `TooLong` past the length bound, and
/// `OutOfRange` at the start when the digits are a number `int64` cannot hold. Every offset is into `text` as
/// written, underscores included.
/// @param text the scalar's own bytes
/// @returns the integer, or why it could not be read and where
/// @see https://rux-lang.dev/docs/api/toml/scalars#toml-parse-integer
pub func TomlParseInteger(text: char8[..]) -> int64 throws TomlScalarError {
    if text.length == 0 { throw TomlScalarError::Malformed(0); }
    if text.length > ScalarCapacity {
        throw .TooLong(ScalarCapacity);
    }
    var stripped = Stripped { digits: [c8'0'; 160], origin: [0; 160], length: 0, source: 0 };
    var badUnderscore: uint = 0;
    if !StripUnderscores(text, stripped, badUnderscore) {
        throw .Malformed(badUnderscore);
    }
    let digits = stripped.digits[..stripped.length];
    var start: uint = 0;
    var signed = false;
    if digits.length > 0 {
        // Safety: `digits.length` is above zero, checked just above.
        let sign = unsafe { digits.data[0] } as uint8;
        if sign == 0x2B || sign == 0x2D {
            signed = true;
            start = 1;
        }
    }
    if start >= digits.length {
        throw .Malformed(stripped.Source(start));
    }
    var based = false;
    // Safety: the reads happen only when two bytes remain at `start`, tested first.
    if digits.length - start > 1 && (unsafe { digits.data[start] } as uint8) == 0x30 {
        // Safety: `start + 1` is below `digits.length`, checked just above.
        let mark = unsafe { digits.data[start + 1] } as uint8;
        based = mark == 0x78 || mark == 0x6F || mark == 0x62;
        // A sign on a based integer is a dialect the grammar does not offer; the sign is the character at fault.
        if based && signed {
            throw .Malformed(stripped.Source(0));
        }
        // A leading zero is only ever a base prefix; `010` is not a TOML integer in any base, and the zero is
        // where a reader has to look.
        if !based {
            throw .Malformed(stripped.Source(start));
        }
    }
    var index = if based { start + 2 } else { start };
    if index >= digits.length {
        throw .Malformed(stripped.Source(index));
    }
    // Safety: `based` is set only when two bytes remain at `start`, checked above.
    let radix = if based { BaseOf(unsafe { digits.data[start + 1] } as uint8) } else { 10 };
    while index < digits.length {
        // Safety: `index` is below `digits.length`, checked by the loop.
        if !DigitFits(unsafe { digits.data[index] } as uint8, radix) {
            throw .Malformed(stripped.Source(index));
        }
        index = index + 1;
    }
    let parsed = try ParseInt64(digits) catch {
        _ => throw TomlScalarError::OutOfRange(0)
    };
    return parsed;
}

// The base a prefix letter names.
func BaseOf(mark: uint8) -> uint8 {
    if mark == 0x78 { return 16; }
    if mark == 0x6F { return 8; }
    return 2;
}

// Whether `c` is a digit of `radix`. TOML writes hexadecimal in either case but nothing else above nine.
func DigitFits(c: uint8, radix: uint8) -> bool {
    if radix == 16 {
        return (c >= 0x30 && c <= 0x39) || (c >= 0x61 && c <= 0x66) || (c >= 0x41 && c <= 0x46);
    }
    if radix == 8 { return c >= 0x30 && c <= 0x37; }
    if radix == 2 { return c == 0x30 || c == 0x31; }
    return c >= 0x30 && c <= 0x39;
}

/// Reads a float, including the infinities and NaN that TOML can spell and JSON cannot.
/// A point needs a digit on either side of it, which is what refuses `.7` and `7.` — both of which some readers
/// accept and some do not, so a document containing one means different things in different places.
/// `Malformed` at the first character that cannot be part of the float, `TooLong` past the length bound, and
/// `OutOfRange` at the start when the digits are a number `float64` cannot hold. Every offset is into `text` as
/// written, underscores included.
/// @param text the scalar's own bytes
/// @returns the float, or why it could not be read and where
/// @see https://rux-lang.dev/docs/api/toml/scalars#toml-parse-float
pub func TomlParseFloat(text: char8[..]) -> float64 throws TomlScalarError {
    if text.length == 0 { throw TomlScalarError::Malformed(0); }
    if text.length > ScalarCapacity {
        throw .TooLong(ScalarCapacity);
    }
    var stripped = Stripped { digits: [c8'0'; 160], origin: [0; 160], length: 0, source: 0 };
    var badUnderscore: uint = 0;
    if !StripUnderscores(text, stripped, badUnderscore) {
        throw .Malformed(badUnderscore);
    }
    let digits = stripped.digits[..stripped.length];
    var start: uint = 0;
    var negative = false;
    // Safety: `text` is not empty and `StripUnderscores` refuses an underscore at its start, so `digits` holds at
    // least one byte.
    let sign = unsafe { digits.data[0] } as uint8;
    if sign == 0x2B || sign == 0x2D {
        negative = sign == 0x2D;
        start = 1;
    }
    if start >= digits.length {
        throw .Malformed(stripped.Source(start));
    }
    // The three named values, which have no digits to check.
    if MatchesWord(digits, start, "inf") {
        return if negative { -PositiveInfinity64() } else { PositiveInfinity64() };
    }
    if MatchesWord(digits, start, "nan") {
        // The sign of a NaN is not a value, so `-nan` is the same NaN as `nan` — which is what TOML means when
        // it says the sign is allowed but carries no information.
        return QuietNan64();
    }
    var shapeAt: uint = 0;
    if !CheckFloatShape(digits, start, shapeAt) {
        throw .Malformed(stripped.Source(shapeAt));
    }
    // The shape is a float's; what the reader refused is the magnitude, which is the whole value rather than any
    // character of it.
    let parsed = try ParseFloat64(digits) catch {
        _ => throw TomlScalarError::OutOfRange(0)
    };
    return parsed;
}

// Whether `digits` from `start` is exactly `word`.
func MatchesWord(digits: char8[..], start: uint, word: char8[..]) -> bool {
    if digits.length - start != word.length { return false; }
    var index: uint = 0;
    while index < word.length {
        // Safety: `digits.length - start` equals `word.length`, checked above, so `start + index` is below
        // `digits.length`, and `index` is below `word.length`.
        if unsafe { digits.data[start + index] != word.data[index] } { return false; }
        index = index + 1;
    }
    return true;
}

// TOML's float shape: digits, optionally a point with digits after it, optionally an exponent with digits after
// its own optional sign. A leading zero is allowed only as the whole integer part, exactly as for an integer.
func CheckFloatShape(digits: char8[..], start: uint, at: &var uint) -> bool {
    var index = start;
    var whole: uint = 0;
    // Safety: the read happens only when `index` is below `digits.length`, tested first.
    while index < digits.length && IsDecimal(unsafe { digits.data[index] } as uint8) {
        whole = whole + 1;
        index = index + 1;
    }
    at = index;
    if whole == 0 { return false; }
    // Safety: `whole` digits were read from `start`, so `start` is below `digits.length`.
    if whole > 1 && (unsafe { digits.data[start] } as uint8) == 0x30 {
        // The leading zero is the character at fault, not wherever the digits happened to stop.
        at = start;
        return false;
    }
    var fraction = false;
    // Safety: the read happens only when `index` is below `digits.length`, tested first.
    if index < digits.length && (unsafe { digits.data[index] } as uint8) == 0x2E {
        index = index + 1;
        var after: uint = 0;
        // Safety: the read happens only when `index` is below `digits.length`, tested first.
        while index < digits.length && IsDecimal(unsafe { digits.data[index] } as uint8) {
            after = after + 1;
            index = index + 1;
        }
        at = index;
        if after == 0 { return false; }
        fraction = true;
    }
    var exponent = false;
    if index < digits.length {
        // Safety: `index` is below `digits.length`, checked just above.
        let mark = unsafe { digits.data[index] } as uint8;
        at = index;
        if mark != 0x65 && mark != 0x45 { return false; }
        index = index + 1;
        if index < digits.length {
            // Safety: `index` is below `digits.length`, checked just above.
            let sign = unsafe { digits.data[index] } as uint8;
            if sign == 0x2B || sign == 0x2D {
                index = index + 1;
            }
        }
        var after: uint = 0;
        // Safety: the read happens only when `index` is below `digits.length`, tested first.
        while index < digits.length && IsDecimal(unsafe { digits.data[index] } as uint8) {
            after = after + 1;
            index = index + 1;
        }
        at = index;
        if after == 0 { return false; }
        exponent = true;
    }
    // Without one or the other it is an integer, and the caller has already decided which it is reading.
    at = index;
    return index == digits.length && (fraction || exponent);
}

func IsDecimal(c: uint8) -> bool {
    return c >= 0x30 && c <= 0x39;
}

/// Which of the four date-time shapes a token turned out to be.
/// There is no case for "not a date-time": text that is none of the four is a failure with a position, not a
/// fifth shape a caller has to remember to check for before reading the fields beside it.
/// @see https://rux-lang.dev/docs/api/toml/scalars#toml-date-time-shape
pub enum TomlDateTimeShape: int32 {
    /// A date and a time with an offset, which names a moment.
    Offset = 1,
    /// A date and a time with no offset, which names a wall clock reading.
    Local = 2,
    /// A date alone.
    DateOnly = 3,
    /// A time alone.
    TimeOnly = 4
}

/// A date-time as TOML writes it: which of the four shapes it is, and the parts that shape carries.
/// The parts that the shape does not carry are present and meaningless — a `DateOnly` has a time of midnight
/// because the fields have to hold something — so `shape` is what decides which of them to read. That is why the
/// shape travels with the value rather than being returned beside it.
/// @see https://rux-lang.dev/docs/api/toml/scalars#toml-date-time
pub struct TomlDateTime {
    /// Which of the four forms the text was.
    pub shape: TomlDateTimeShape;
    /// The date, for every shape but `TimeOnly`.
    pub date: Date;
    /// The time, for every shape but `DateOnly`.
    pub time: TimeOfDay;
    /// The offset, for `Offset` alone. UTC otherwise, which means nothing there.
    pub offset: UtcOffset;
}

/// Reads any of TOML's four date-time forms, reporting which one it was.
/// The four are genuinely different things and the difference matters: an offset date-time names a moment, and a
/// local date-time names a reading of a wall clock that different places reach at different moments. Collapsing
/// them by assuming UTC is how a meeting ends up an hour out, so nothing here supplies an offset that the text
/// did not.
/// `Malformed` at the byte where the text stops being one of the four forms — the separator that is not one, the
/// field the calendar rejects, or the end of the text when it stops early. The calendar's own refusals arrive
/// here too: the thirty-first of February is four correct digit pairs and not a date.
/// @param text the scalar's own bytes
/// @returns the date-time and which shape it is, or why it could not be read and where
/// @see https://rux-lang.dev/docs/api/toml/scalars#toml-parse-date-time
pub func TomlParseDateTime(text: char8[..]) -> TomlDateTime throws TomlScalarError {
    var built = TomlDateTime {
        shape: TomlDateTimeShape::DateOnly,
        date: Date { year: 1970, month: 1, day: 1 },
        time: TimeOfDay { hour: 0, minute: 0, second: 0, nanosecond: 0 },
        offset: UtcOffset::Utc()
    };
    var at: uint = 0;
    // Safety: the read happens only when `text.length` is at least 5, tested first.
    if text.length >= 5 && (unsafe { text.data[2] } as uint8) == 0x3A {
        var consumed: uint = 0;
        if !ReadTime(text, 0, built.time, consumed, at) {
            throw .Malformed(at);
        }
        if consumed != text.length {
            throw .Malformed(consumed);
        }
        built.shape = TomlDateTimeShape::TimeOnly;
        return built;
    }
    if text.length < 10 {
        throw .Malformed(text.length);
    }
    if !ReadDate(text, 0, built.date, at) {
        throw .Malformed(at);
    }
    if text.length == 10 { return built; }
    // Safety: `text.length` is more than 10: it is at least 10 and not 10, checked above.
    let separator = unsafe { text.data[10] } as uint8;
    if separator != 0x54 && separator != 0x74 && separator != 0x20 {
        throw .Malformed(10);
    }
    var consumed: uint = 0;
    if !ReadTime(text, 11, built.time, consumed, at) {
        throw .Malformed(at);
    }
    if consumed == text.length {
        built.shape = TomlDateTimeShape::Local;
        return built;
    }
    // Safety: `ReadTime` reads no further than the end of `text`, so `consumed` is at most `text.length`, and it is
    // not equal, checked above.
    if !unsafe { ReadOffset(text, consumed, built.offset, at) } {
        throw .Malformed(at);
    }
    built.shape = TomlDateTimeShape::Offset;
    return built;
}

// `YYYY-MM-DD` at `at`, validated by the calendar rather than by digit ranges: the thirty-first of February is
// four correct digit pairs and not a date.
func ReadDate(text: char8[..], at: uint, date: &var Date, stopped: &var uint) -> bool {
    stopped = at;
    if at + 10 > text.length {
        stopped = text.length;
        return false;
    }
    var year: uint32 = 0;
    var month: uint32 = 0;
    var day: uint32 = 0;
    if !Digits(text, at, 4, year) { return false; }
    stopped = at + 5;
    if !Digits(text, at + 5, 2, month) { return false; }
    stopped = at + 8;
    if !Digits(text, at + 8, 2, day) { return false; }
    // Safety: `at + 10` is at most `text.length`, checked above.
    if (unsafe { text.data[at + 4] } as uint8) != 0x2D {
        stopped = at + 4;
        return false;
    }
    // Safety: `at + 10` is at most `text.length`, checked above.
    if (unsafe { text.data[at + 7] } as uint8) != 0x2D {
        stopped = at + 7;
        return false;
    }
    let made = Date::FromParts(year as int32, month as uint8, day as uint8);
    if !(made is Date) {
        // Four correct digit pairs that name no day. The month is where a reader has to look, since that is what
        // decides how many days there are.
        stopped = at + 5;
        return false;
    }
    date = made ?? Date { year: 1970, month: 1, day: 1 };
    return true;
}

// `HH:MM` with optional seconds and an optional fraction, reporting how far it read.
// TOML 1.1 lets the seconds be left off, which is the shape a person writes when they mean a time of day rather
// than an instant. They are read as zero, since that is what the shorter text names.
func ReadTime(text: char8[..], at: uint, time: &var TimeOfDay, consumed: &var uint,
              stopped: &var uint) -> bool {
    stopped = at;
    if at + 5 > text.length {
        stopped = text.length;
        return false;
    }
    var hour: uint32 = 0;
    var minute: uint32 = 0;
    var second: uint32 = 0;
    if !Digits(text, at, 2, hour) { return false; }
    stopped = at + 3;
    if !Digits(text, at + 3, 2, minute) { return false; }
    // Safety: `at + 5` is at most `text.length`, checked above.
    if (unsafe { text.data[at + 2] } as uint8) != 0x3A {
        stopped = at + 2;
        return false;
    }
    var index = at + 5;
    // Safety: the read happens only when `index` is below `text.length`, tested first.
    if index < text.length && (unsafe { text.data[index] } as uint8) == 0x3A {
        stopped = index + 1;
        if !Digits(text, index + 1, 2, second) { return false; }
        index = index + 3;
    }
    var nanosecond: uint32 = 0;
    // Safety: the read happens only when `index` is below `text.length`, tested first.
    if index < text.length && (unsafe { text.data[index] } as uint8) == 0x2E {
        index = index + 1;
        var place: uint = 0;
        var scale: uint32 = 100000000;
        // Safety: the read happens only when `index` is below `text.length`, tested first.
        while index < text.length && IsDecimal(unsafe { text.data[index] } as uint8) {
            // Digits past the ninth are dropped rather than refused: they are more precision than a nanosecond
            // holds, and refusing a document over precision nobody can represent helps no one.
            if place < 9 {
                // Safety: `index` is below `text.length`, checked by the loop.
                nanosecond = nanosecond + ((unsafe { text.data[index] } as uint8) - 0x30) as uint32 * scale;
                scale = scale / 10;
            }
            place = place + 1;
            index = index + 1;
        }
        if place == 0 {
            stopped = index;
            return false;
        }
    }
    // Second sixty is a leap second, which the calendar does not represent; it folds to the last nanosecond of
    // fifty-nine, the same policy `Time` states for RFC 3339.
    if second == 60 {
        second = 59;
        nanosecond = 999999999;
    }
    let made = TimeOfDay::FromParts(hour as uint8, minute as uint8, second as uint8, nanosecond);
    if !(made is TimeOfDay) {
        stopped = at;
        return false;
    }
    time = made ?? TimeOfDay { hour: 0, minute: 0, second: 0, nanosecond: 0 };
    consumed = index;
    return true;
}

// `Z`, or `+HH:MM` and its negative.
// Safety: `at` must be below `text.length`; the offset's bytes are read without a bounds check.
unsafe func ReadOffset(text: char8[..], at: uint, offset: &var UtcOffset, stopped: &var uint) -> bool {
    stopped = at;
    let mark = text.data[at] as uint8;
    if mark == 0x5A || mark == 0x7A {
        offset = UtcOffset::Utc();
        stopped = at + 1;
        return at + 1 == text.length;
    }
    if mark != 0x2B && mark != 0x2D { return false; }
    if at + 6 != text.length {
        stopped = text.length;
        return false;
    }
    var hours: uint32 = 0;
    var minutes: uint32 = 0;
    stopped = at + 1;
    if !Digits(text, at + 1, 2, hours) { return false; }
    stopped = at + 4;
    if !Digits(text, at + 4, 2, minutes) { return false; }
    if (text.data[at + 3] as uint8) != 0x3A {
        stopped = at + 3;
        return false;
    }
    var signedHours = hours as int32;
    var signedMinutes = minutes as int32;
    if mark == 0x2D {
        signedHours = -signedHours;
        signedMinutes = -signedMinutes;
    }
    let made = UtcOffset::Of(signedHours, signedMinutes);
    if !(made is UtcOffset) {
        stopped = at + 1;
        return false;
    }
    offset = made ?? UtcOffset::Utc();
    return true;
}

// Exactly `count` decimal digits at `at`, as a value.
func Digits(text: char8[..], at: uint, count: uint, value: &var uint32) -> bool {
    if at + count > text.length { return false; }
    value = 0;
    var index: uint = 0;
    while index < count {
        // Safety: `at + count` is at most `text.length`, checked above, and `index` is below `count`.
        let c = unsafe { text.data[at + index] } as uint8;
        if !IsDecimal(c) { return false; }
        value = value * 10 + (c - 0x30) as uint32;
        index = index + 1;
    }
    return true;
}
