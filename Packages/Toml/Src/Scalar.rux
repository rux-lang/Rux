// Turning a scalar token's text into a value, with TOML's grammar applied rather than assumed.
//
// Every rule here is one a permissive reader would let through and a strict one would not: an underscore has to
// sit between two digits, a decimal integer may not carry a leading zero, a float needs digits on both sides of
// its point. None of that is decoration. `010` meaning eight to one reader and ten to another is how a port
// number becomes the wrong port number, and TOML's answer is that it means neither -- it is simply not a TOML
// integer, and saying so is the job of this file.

import Core::{ MutableSlice, Slice };
import Format::{ ParseFloat64, ParseInt64, ParseError };
import Math::{ PositiveInfinity64, QuietNan64 };
import Time::{ Date, TimeOfDay, UtcOffset };

/// Why a scalar could not be read.
///
/// https://rux-lang.dev/docs/api/toml/scalar-error
enum TomlScalarError: int32 {
    /// Nothing went wrong.
    None = 0,
    /// The digits do not form a number of the shape TOML defines.
    Malformed = 1,
    /// The value is outside what an `int64` or the calendar can hold.
    OutOfRange = 2,
    /// The number has more characters than any TOML number needs.
    TooLong = 3
}

// The longest number TOML can spell that this will accept: sixty-four binary digits, a prefix, a sign and a
// generous allowance of underscores. Anything longer is out of range for an int64 anyway, so the bound costs no
// document that was going to parse.
const ScalarCapacity: uint = 160;

// Copies `text` into `into`, dropping underscores and refusing any that is not surrounded by digits of the base.
func StripUnderscores(text: Slice<char8>, into: MutableSlice<char8>, length: *var uint) -> bool {
    *length = 0u;
    if text.length > into.length {
        return false;
    }
    var index: uint = 0;
    while index < text.length {
        let c = text.data[index] as uint8;
        if c == 0x5Fu8 {
            if index == 0u || index + 1u == text.length {
                return false;
            }
            if !IsBaseDigit(text.data[index - 1u] as uint8) || !IsBaseDigit(text.data[index + 1u] as uint8) {
                return false;
            }
            index = index + 1u;
            continue;
        }
        into.data[*length] = text.data[index];
        *length = *length + 1u;
        index = index + 1u;
    }
    return true;
}

// Whether `c` is a digit in any base TOML writes, which is all an underscore's neighbours have to be.
func IsBaseDigit(c: uint8) -> bool {
    return (c >= 0x30u8 && c <= 0x39u8) || (c >= 0x61u8 && c <= 0x66u8) || (c >= 0x41u8 && c <= 0x46u8);
}

/// Reads an integer, in any of the four bases TOML writes.
///
/// A leading zero is refused for a decimal integer, because `010` is eight in one language and ten in another
/// and TOML declines to pick: it is not an integer at all. A sign is refused on a based integer for the same
/// reason -- the grammar does not offer one, so accepting it would be inventing a dialect.
///
/// https://rux-lang.dev/docs/api/toml/parse-integer
func TomlParseInteger(text: Slice<char8>, result: *var int64) -> TomlScalarError {
    if text.length == 0u {
        return TomlScalarError::Malformed;
    }
    var storage: char8[160];
    let buffer = MutableSlice<char8> { data: @storage[0], length: ScalarCapacity };
    var length: uint = 0;
    if text.length > ScalarCapacity {
        return TomlScalarError::TooLong;
    }
    if !StripUnderscores(text, buffer, @length) {
        return TomlScalarError::Malformed;
    }
    let digits = Slice<char8> { data: @storage[0], length: length };
    var start: uint = 0;
    var signed = false;
    if digits.length > 0u {
        let sign = digits.data[0] as uint8;
        if sign == 0x2Bu8 || sign == 0x2Du8 {
            signed = true;
            start = 1u;
        }
    }
    if start >= digits.length {
        return TomlScalarError::Malformed;
    }
    var based = false;
    if digits.length - start > 1u && (digits.data[start] as uint8) == 0x30u8 {
        let mark = digits.data[start + 1u] as uint8;
        based = mark == 0x78u8 || mark == 0x6Fu8 || mark == 0x62u8;
        if based && signed {
            return TomlScalarError::Malformed;
        }
        // A leading zero is only ever a base prefix; `010` is not a TOML integer in any base.
        if !based {
            return TomlScalarError::Malformed;
        }
    }
    var index = based ? start + 2u : start;
    if index >= digits.length {
        return TomlScalarError::Malformed;
    }
    let radix = based ? BaseOf(digits.data[start + 1u] as uint8) : 10u8;
    while index < digits.length {
        if !DigitFits(digits.data[index] as uint8, radix) {
            return TomlScalarError::Malformed;
        }
        index = index + 1u;
    }
    let parsed = ParseInt64(digits);
    var failure = ParseError::Empty;
    if parsed.TryIntoError(@failure) {
        return TomlScalarError::OutOfRange;
    }
    *result = parsed.ValueOr(0i64);
    return TomlScalarError::None;
}

// The base a prefix letter names.
func BaseOf(mark: uint8) -> uint8 {
    if mark == 0x78u8 {
        return 16u8;
    }
    if mark == 0x6Fu8 {
        return 8u8;
    }
    return 2u8;
}

// Whether `c` is a digit of `radix`. TOML writes hexadecimal in either case but nothing else above nine.
func DigitFits(c: uint8, radix: uint8) -> bool {
    if radix == 16u8 {
        return (c >= 0x30u8 && c <= 0x39u8) || (c >= 0x61u8 && c <= 0x66u8) || (c >= 0x41u8 && c <= 0x46u8);
    }
    if radix == 8u8 {
        return c >= 0x30u8 && c <= 0x37u8;
    }
    if radix == 2u8 {
        return c == 0x30u8 || c == 0x31u8;
    }
    return c >= 0x30u8 && c <= 0x39u8;
}

/// Reads a float, including the infinities and NaN that TOML can spell and JSON cannot.
///
/// A point needs a digit on either side of it, which is what refuses `.7` and `7.` -- both of which some readers
/// accept and some do not, so a document containing one means different things in different places.
///
/// https://rux-lang.dev/docs/api/toml/parse-float
func TomlParseFloat(text: Slice<char8>, result: *var float64) -> TomlScalarError {
    if text.length == 0u {
        return TomlScalarError::Malformed;
    }
    if text.length > ScalarCapacity {
        return TomlScalarError::TooLong;
    }
    var storage: char8[160];
    let buffer = MutableSlice<char8> { data: @storage[0], length: ScalarCapacity };
    var length: uint = 0;
    if !StripUnderscores(text, buffer, @length) {
        return TomlScalarError::Malformed;
    }
    let digits = Slice<char8> { data: @storage[0], length: length };
    var start: uint = 0;
    var negative = false;
    let sign = digits.data[0] as uint8;
    if sign == 0x2Bu8 || sign == 0x2Du8 {
        negative = sign == 0x2Du8;
        start = 1u;
    }
    if start >= digits.length {
        return TomlScalarError::Malformed;
    }
    // The three named values, which have no digits to check.
    if MatchesWord(digits, start, "inf") {
        *result = negative ? -PositiveInfinity64() : PositiveInfinity64();
        return TomlScalarError::None;
    }
    if MatchesWord(digits, start, "nan") {
        // The sign of a NaN is not a value, so `-nan` is the same NaN as `nan` -- which is what TOML means when
        // it says the sign is allowed but carries no information.
        *result = QuietNan64();
        return TomlScalarError::None;
    }
    if !CheckFloatShape(digits, start) {
        return TomlScalarError::Malformed;
    }
    let parsed = ParseFloat64(digits);
    var failure = ParseError::Empty;
    if parsed.TryIntoError(@failure) {
        return TomlScalarError::Malformed;
    }
    *result = parsed.ValueOr(0.0);
    return TomlScalarError::None;
}

// Whether `digits` from `start` is exactly `word`.
func MatchesWord(digits: Slice<char8>, start: uint, word: Slice<char8>) -> bool {
    if digits.length - start != word.length {
        return false;
    }
    var index: uint = 0;
    while index < word.length {
        if digits.data[start + index] != word.data[index] {
            return false;
        }
        index = index + 1u;
    }
    return true;
}

// TOML's float shape: digits, optionally a point with digits after it, optionally an exponent with digits after
// its own optional sign. A leading zero is allowed only as the whole integer part, exactly as for an integer.
func CheckFloatShape(digits: Slice<char8>, start: uint) -> bool {
    var index = start;
    var whole: uint = 0;
    while index < digits.length && IsDecimal(digits.data[index] as uint8) {
        whole = whole + 1u;
        index = index + 1u;
    }
    if whole == 0u {
        return false;
    }
    if whole > 1u && (digits.data[start] as uint8) == 0x30u8 {
        return false;
    }
    var fraction = false;
    if index < digits.length && (digits.data[index] as uint8) == 0x2Eu8 {
        index = index + 1u;
        var after: uint = 0;
        while index < digits.length && IsDecimal(digits.data[index] as uint8) {
            after = after + 1u;
            index = index + 1u;
        }
        if after == 0u {
            return false;
        }
        fraction = true;
    }
    var exponent = false;
    if index < digits.length {
        let mark = digits.data[index] as uint8;
        if mark != 0x65u8 && mark != 0x45u8 {
            return false;
        }
        index = index + 1u;
        if index < digits.length {
            let sign = digits.data[index] as uint8;
            if sign == 0x2Bu8 || sign == 0x2Du8 {
                index = index + 1u;
            }
        }
        var after: uint = 0;
        while index < digits.length && IsDecimal(digits.data[index] as uint8) {
            after = after + 1u;
            index = index + 1u;
        }
        if after == 0u {
            return false;
        }
        exponent = true;
    }
    // Without one or the other it is an integer, and the caller has already decided which it is reading.
    return index == digits.length && (fraction || exponent);
}

func IsDecimal(c: uint8) -> bool {
    return c >= 0x30u8 && c <= 0x39u8;
}

/// Which of the four date-time shapes a token turned out to be.
///
/// https://rux-lang.dev/docs/api/toml/date-time-shape
enum TomlDateTimeShape: int32 {
    /// The text is not a date-time at all.
    NotDateTime = 0,
    /// A date and a time with an offset, which names a moment.
    Offset = 1,
    /// A date and a time with no offset, which names a wall clock reading.
    Local = 2,
    /// A date alone.
    DateOnly = 3,
    /// A time alone.
    TimeOnly = 4
}

/// Reads any of TOML's four date-time forms, reporting which one it was.
///
/// The four are genuinely different things and the difference matters: an offset date-time names a moment, and a
/// local date-time names a reading of a wall clock that different places reach at different moments. Collapsing
/// them by assuming UTC is how a meeting ends up an hour out, so nothing here supplies an offset that the text
/// did not.
///
/// https://rux-lang.dev/docs/api/toml/parse-date-time
func TomlParseDateTime(text: Slice<char8>, date: *var Date, time: *var TimeOfDay,
                       offset: *var UtcOffset) -> TomlDateTimeShape {
    *offset = UtcOffset::Utc();
    if text.length >= 5u && (text.data[2] as uint8) == 0x3Au8 {
        var consumed: uint = 0;
        if !ReadTime(text, 0u, time, @consumed) || consumed != text.length {
            return TomlDateTimeShape::NotDateTime;
        }
        return TomlDateTimeShape::TimeOnly;
    }
    if text.length < 10u {
        return TomlDateTimeShape::NotDateTime;
    }
    if !ReadDate(text, 0u, date) {
        return TomlDateTimeShape::NotDateTime;
    }
    if text.length == 10u {
        return TomlDateTimeShape::DateOnly;
    }
    let separator = text.data[10] as uint8;
    if separator != 0x54u8 && separator != 0x74u8 && separator != 0x20u8 {
        return TomlDateTimeShape::NotDateTime;
    }
    var consumed: uint = 0;
    if !ReadTime(text, 11u, time, @consumed) {
        return TomlDateTimeShape::NotDateTime;
    }
    if consumed == text.length {
        return TomlDateTimeShape::Local;
    }
    if !ReadOffset(text, consumed, offset) {
        return TomlDateTimeShape::NotDateTime;
    }
    return TomlDateTimeShape::Offset;
}

// `YYYY-MM-DD` at `at`, validated by the calendar rather than by digit ranges: the thirty-first of February is
// four correct digit pairs and not a date.
func ReadDate(text: Slice<char8>, at: uint, date: *var Date) -> bool {
    if at + 10u > text.length {
        return false;
    }
    var year: uint32 = 0;
    var month: uint32 = 0;
    var day: uint32 = 0;
    if !Digits(text, at, 4u, @year) || !Digits(text, at + 5u, 2u, @month) || !Digits(text, at + 8u, 2u, @day) {
        return false;
    }
    if (text.data[at + 4u] as uint8) != 0x2Du8 || (text.data[at + 7u] as uint8) != 0x2Du8 {
        return false;
    }
    let made = Date::New(year as int32, month as uint8, day as uint8);
    if made.IsNone() {
        return false;
    }
    *date = made.ValueOr(Date { year: 1970, month: 1u8, day: 1u8 });
    return true;
}

// `HH:MM` with optional seconds and an optional fraction, reporting how far it read.
//
// TOML 1.1 lets the seconds be left off, which is the shape a person writes when they mean a time of day rather
// than an instant. They are read as zero, since that is what the shorter text names.
func ReadTime(text: Slice<char8>, at: uint, time: *var TimeOfDay, consumed: *var uint) -> bool {
    if at + 5u > text.length {
        return false;
    }
    var hour: uint32 = 0;
    var minute: uint32 = 0;
    var second: uint32 = 0;
    if !Digits(text, at, 2u, @hour) || !Digits(text, at + 3u, 2u, @minute) {
        return false;
    }
    if (text.data[at + 2u] as uint8) != 0x3Au8 {
        return false;
    }
    var index = at + 5u;
    if index < text.length && (text.data[index] as uint8) == 0x3Au8 {
        if !Digits(text, index + 1u, 2u, @second) {
            return false;
        }
        index = index + 3u;
    }
    var nanosecond: uint32 = 0;
    if index < text.length && (text.data[index] as uint8) == 0x2Eu8 {
        index = index + 1u;
        var place: uint = 0;
        var scale: uint32 = 100000000u32;
        while index < text.length && IsDecimal(text.data[index] as uint8) {
            // Digits past the ninth are dropped rather than refused: they are more precision than a nanosecond
            // holds, and refusing a document over precision nobody can represent helps no one.
            if place < 9u {
                nanosecond = nanosecond + ((text.data[index] as uint8) - 0x30u8) as uint32 * scale;
                scale = scale / 10u32;
            }
            place = place + 1u;
            index = index + 1u;
        }
        if place == 0u {
            return false;
        }
    }
    // Second sixty is a leap second, which the calendar does not represent; it folds to the last nanosecond of
    // fifty-nine, the same policy `Time` states for RFC 3339.
    if second == 60u32 {
        second = 59u32;
        nanosecond = 999999999u32;
    }
    let made = TimeOfDay::New(hour as uint8, minute as uint8, second as uint8, nanosecond);
    if made.IsNone() {
        return false;
    }
    *time = made.ValueOr(TimeOfDay { hour: 0u8, minute: 0u8, second: 0u8, nanosecond: 0u32 });
    *consumed = index;
    return true;
}

// `Z`, or `+HH:MM` and its negative.
func ReadOffset(text: Slice<char8>, at: uint, offset: *var UtcOffset) -> bool {
    let mark = text.data[at] as uint8;
    if mark == 0x5Au8 || mark == 0x7Au8 {
        *offset = UtcOffset::Utc();
        return at + 1u == text.length;
    }
    if mark != 0x2Bu8 && mark != 0x2Du8 {
        return false;
    }
    if at + 6u != text.length {
        return false;
    }
    var hours: uint32 = 0;
    var minutes: uint32 = 0;
    if !Digits(text, at + 1u, 2u, @hours) || !Digits(text, at + 4u, 2u, @minutes) {
        return false;
    }
    if (text.data[at + 3u] as uint8) != 0x3Au8 {
        return false;
    }
    var signedHours = hours as int32;
    var signedMinutes = minutes as int32;
    if mark == 0x2Du8 {
        signedHours = -signedHours;
        signedMinutes = -signedMinutes;
    }
    let made = UtcOffset::Of(signedHours, signedMinutes);
    if made.IsNone() {
        return false;
    }
    *offset = made.ValueOr(UtcOffset::Utc());
    return true;
}

// Exactly `count` decimal digits at `at`, as a value.
func Digits(text: Slice<char8>, at: uint, count: uint, value: *var uint32) -> bool {
    if at + count > text.length {
        return false;
    }
    *value = 0u32;
    var index: uint = 0;
    while index < count {
        let c = text.data[at + index] as uint8;
        if !IsDecimal(c) {
            return false;
        }
        *value = *value * 10u32 + (c - 0x30u8) as uint32;
        index = index + 1u;
    }
    return true;
}
