// Building a document from tokens, and refusing the three different ways of defining a table twice.
//
// Most of a TOML parser is bookkeeping about tables. `[a.b]` creates `a` implicitly and `b` deliberately, and
// what may happen to each of them afterwards is different: a later `[a]` is fine because `a` was only implied,
// while a later `[a.b]` is a redefinition. A table written inline is closed the moment its brace shuts, and one
// reached through a dotted key is closed as soon as the line ends. Three rules, three reasons, three separate
// errors — because "duplicate key" tells a writer nothing about which of them they broke.
//
// The recursion of inline tables and arrays is bounded by the depth limit rather than by the stack, checked
// before descending, so a document built to exhaust the stack is refused while there is still stack to refuse
// it with.
//
// What this produces is a tree of values and nothing else. Comments are skipped by the lexer and never arrive
// here, so no amount of care further down could keep them; the same goes for blank lines, for indentation, and
// for whether a number was written in hexadecimal. Reading a document and writing it back gives an equivalent
// document, not the same file, and this package is not the one to reach for when the file belongs to someone
// else.

import Allocator::Allocator;
import Core::{ Option, Result, Unit };
import Collections::{ CollectionError, Vector };
import Text::{ Display, FormatError, FormatSpec, ParseFailure, RejectStyle, String, StringView,
               TextError, TextWriter, WriteAscii, WriteBytes };
import Time::{ Date, TimeOfDay, UtcOffset };

/// Why parsing stopped.
///
/// Failure-only: a parse that did not stop hands back a document instead. The distinctions between the four
/// table-definition cases are the ones worth keeping — `DuplicateKey`, `RedefinedTable`, `ExtendedInlineTable`
/// and `ExtendedDottedTable` are four different mistakes with four different fixes, and a reader told only that
/// a key was defined twice would have to work out which rule they had met.
///
/// The two cases that have something more to say carry it rather than reporting it beside themselves, so a caller
/// holding the failure cannot be holding half of one.
///
/// @see https://rux-lang.dev/docs/api/toml/parse-error
pub variant TomlParseError {
    /// The lexer refused the input, for the reason carried.
    Lexical(TomlLexError),
    /// A token that cannot appear where it did.
    Unexpected,
    /// The document ended in the middle of something.
    Truncated,
    /// A key given a value twice in the same table.
    DuplicateKey,
    /// A table defined by a header that had already been defined by one.
    RedefinedTable,
    /// An attempt to add to a table that was written inline, which its closing brace ended.
    ExtendedInlineTable,
    /// An attempt to add to a table that a dotted key created, which its line ended.
    ExtendedDottedTable,
    /// A key path that runs through something that is not a table.
    NotATable,
    /// A `[[name]]` header naming an array that was not built from headers, or a table.
    NotATableArray,
    /// A scalar whose text is not the number or date TOML's grammar defines, for the reason carried. The scalar
    /// failure's own offset is into the scalar's text; the failure around it is positioned in the document.
    BadValue(TomlScalarError),
    /// A string whose escapes name no scalar value.
    BadText,
    /// Values nested deeper than the limit allowed.
    TooDeep,
    /// The allocator refused.
    OutOfMemory
}

/// Why a document was refused, and where in it.
///
/// Three positions for one place, because the three are wanted by different readers: `offset` is what a program
/// slices the input with, and `line` and `column` are what a person is shown. They always name the same byte.
///
/// @see https://rux-lang.dev/docs/api/toml/parse-failure
pub struct TomlParseFailure {
    /// Why parsing stopped.
    pub reason: TomlParseError;
    /// The zero-based byte offset into the document where it stopped.
    pub offset: uint;
    /// Which line, counting from one.
    pub line: uint;
    /// Which column, counting from one, in bytes.
    pub column: uint;
}

extend TomlParseFailure : ParseFailure {
    /// Where in the document parsing stopped.
    ///
    /// Borrows the failure and leaves it untouched. Cannot fail; runs in constant time and allocates nothing.
    ///
    /// @returns the zero-based byte offset into the document
    /// @see https://rux-lang.dev/docs/api/toml/parse-failure/offset
    pub func Offset(self: &TomlParseFailure) -> uint {
        return self.offset;
    }
}

// The description of a lexical refusal, which a parse failure quotes rather than restates.
func WriteLexicalDescription(writer: &var TextWriter, reason: &TomlLexError) -> Result<Unit, FormatError> {
    return match reason {
        .None => WriteBytes(writer, "no error"),
        .UnexpectedByte => WriteBytes(writer, "byte that begins no token"),
        .UnterminatedText => WriteBytes(writer, "string the document ended before closing"),
        .BadEscape => WriteBytes(writer, "escape sequence TOML does not define"),
        .BadUnicodeEscape => WriteBytes(writer, "unicode escape naming no scalar value"),
        .UnescapedControl => WriteBytes(writer, "unescaped control character inside a string"),
        .MalformedNumber => WriteBytes(writer, "number whose shape TOML does not allow"),
        .NewlineInText => WriteBytes(writer, "newline inside a string that cannot hold one"),
        .MalformedDateTime => WriteBytes(writer, "date or time TOML does not spell that way")
    };
}

extend TomlParseFailure : Display {
    /// Writes the description of why parsing stopped, without the position.
    ///
    /// The line and column are numbers a caller places where it makes sense for them, so they are not written into
    /// the middle of a sentence here. `Debug` carries them.
    ///
    /// # Failures
    /// Reports whatever the writer reported, and `UnsupportedRequest` for any style or precision.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the whole description was accepted
    /// @see https://rux-lang.dev/docs/api/toml/parse-failure/write-display
    pub func WriteDisplay(self: &TomlParseFailure, writer: &var TextWriter,
                          spec: FormatSpec) -> Result<Unit, FormatError> {
        RejectStyle(spec)?;
        if spec.HasPrecision() { return Result::Error<Unit, FormatError>(FormatError::UnsupportedRequest); }
        return match self.reason {
            .Lexical(reason) => WriteLexicalDescription(writer, reason),
            .Unexpected => WriteBytes(writer, "token that cannot appear here"),
            .Truncated => WriteBytes(writer, "document ended in the middle of something"),
            .DuplicateKey => WriteBytes(writer, "key given a value twice in the same table"),
            .RedefinedTable => WriteBytes(writer, "table defined by a header twice"),
            .ExtendedInlineTable => WriteBytes(writer, "table written inline and added to afterwards"),
            .ExtendedDottedTable => WriteBytes(writer, "table made by a dotted key and added to on another line"),
            .NotATable => WriteBytes(writer, "key path running through something that is not a table"),
            .NotATableArray => WriteBytes(writer, "header naming something that is not an array of tables"),
            .BadValue(reason) => reason.WriteDisplay(writer, spec),
            .BadText => WriteBytes(writer, "string whose escapes name no scalar value"),
            .TooDeep => WriteBytes(writer, "values nested deeper than the limit allows"),
            .OutOfMemory => WriteBytes(writer, "out of memory")
        };
    }
}

// The case name alone, which the debug rendering puts the position after.
func WriteReasonName(writer: &var TextWriter, reason: &TomlParseError,
                     spec: FormatSpec) -> Result<Unit, FormatError> {
    return match reason {
        .Lexical(cause) => WriteNested(writer, "Lexical", cause),
        .Unexpected => WriteBytes(writer, "Unexpected"),
        .Truncated => WriteBytes(writer, "Truncated"),
        .DuplicateKey => WriteBytes(writer, "DuplicateKey"),
        .RedefinedTable => WriteBytes(writer, "RedefinedTable"),
        .ExtendedInlineTable => WriteBytes(writer, "ExtendedInlineTable"),
        .ExtendedDottedTable => WriteBytes(writer, "ExtendedDottedTable"),
        .NotATable => WriteBytes(writer, "NotATable"),
        .NotATableArray => WriteBytes(writer, "NotATableArray"),
        .BadValue(cause) => WriteScalarCase(writer, cause, spec),
        .BadText => WriteBytes(writer, "BadText"),
        .TooDeep => WriteBytes(writer, "TooDeep"),
        .OutOfMemory => WriteBytes(writer, "OutOfMemory")
    };
}

// `Lexical(BadEscape)`, whose payload is a scalar enum with a name of its own.
func WriteNested(writer: &var TextWriter, name: char8[..], cause: &TomlLexError) -> Result<Unit, FormatError> {
    WriteBytes(writer, name)?;
    WriteAscii(writer, c8'(')?;
    WriteLexicalName(writer, cause)?;
    return WriteAscii(writer, c8')');
}

// `BadValue(TomlScalarError::Malformed(4))`, whose payload renders itself.
func WriteScalarCase(writer: &var TextWriter, cause: &TomlScalarError,
                     spec: FormatSpec) -> Result<Unit, FormatError> {
    WriteBytes(writer, "BadValue(")?;
    cause.WriteDebug(writer, spec)?;
    return WriteAscii(writer, c8')');
}

func WriteLexicalName(writer: &var TextWriter, reason: &TomlLexError) -> Result<Unit, FormatError> {
    return match reason {
        .None => WriteBytes(writer, "None"),
        .UnexpectedByte => WriteBytes(writer, "UnexpectedByte"),
        .UnterminatedText => WriteBytes(writer, "UnterminatedText"),
        .BadEscape => WriteBytes(writer, "BadEscape"),
        .BadUnicodeEscape => WriteBytes(writer, "BadUnicodeEscape"),
        .UnescapedControl => WriteBytes(writer, "UnescapedControl"),
        .MalformedNumber => WriteBytes(writer, "MalformedNumber"),
        .NewlineInText => WriteBytes(writer, "NewlineInText"),
        .MalformedDateTime => WriteBytes(writer, "MalformedDateTime")
    };
}

extend TomlParseFailure : Debug {
    /// Names the case and where it happened: `TomlParseError::DuplicateKey at 2:1`.
    ///
    /// A case that carries something names that too, so nothing has to be looked up elsewhere:
    /// `TomlParseError::BadValue(TomlScalarError::Malformed(4)) at 1:8`.
    ///
    /// # Failures
    /// Reports whatever the writer reported, and `UnsupportedRequest` for any style or precision.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the whole rendering was accepted
    /// @see https://rux-lang.dev/docs/api/toml/parse-failure/write-debug
    pub func WriteDebug(self: &TomlParseFailure, writer: &var TextWriter,
                        spec: FormatSpec) -> Result<Unit, FormatError> {
        RejectStyle(spec)?;
        if spec.HasPrecision() { return Result::Error<Unit, FormatError>(FormatError::UnsupportedRequest); }
        WriteBytes(writer, "TomlParseError::")?;
        WriteReasonName(writer, self.reason, FormatSpec::Plain())?;
        WriteBytes(writer, " at ")?;
        let line: Display = self.line;
        line.WriteDisplay(writer, FormatSpec::Plain())?;
        WriteAscii(writer, c8':')?;
        let column: Display = self.column;
        return column.WriteDisplay(writer, FormatSpec::Plain());
    }
}

// Why the parser stopped, without anything it carries, which the parser tracks beside it. The public failure is
// built from these once, where the parse ends.
enum TomlStop: int32 {
    None = 0,
    Lexical = 1,
    Unexpected = 2,
    Truncated = 3,
    DuplicateKey = 4,
    RedefinedTable = 5,
    ExtendedInlineTable = 6,
    ExtendedDottedTable = 7,
    NotATable = 8,
    NotATableArray = 9,
    BadValue = 10,
    BadText = 11,
    TooDeep = 12,
    OutOfMemory = 13
}

/// What a parse will accept.
///
/// @see https://rux-lang.dev/docs/api/toml/limits
pub struct TomlLimits {
    /// How deeply arrays and inline tables may nest.
    maximumDepth: uint;
}

extend TomlLimits {
    /// Limits that suit a configuration file: deep enough for anything written by hand, shallow enough that a
    /// document built to exhaust the stack does not.
    ///
    /// @returns the limits an ordinary parse uses
    /// @see https://rux-lang.dev/docs/api/toml/limits/default
    pub func Default() -> TomlLimits {
        return TomlLimits { maximumDepth: 64 };
    }

    /// Limits that refuse nothing, for input already known to be trustworthy.
    ///
    /// @returns limits that refuse nothing, for input that is already trusted
    /// @see https://rux-lang.dev/docs/api/toml/limits/unlimited
    pub func Unlimited() -> TomlLimits {
        return TomlLimits { maximumDepth: 18446744073709551615u };
    }
}

// Why the parser stopped and where, as its parts. The public failure is built from these once, where the parse
// ends, so nothing inside has to carry a payload around.
struct TomlStopped {
    stop: TomlStop;
    lexical: TomlLexError;
    scalar: TomlScalarError;
    offset: uint;
    line: uint;
    column: uint;
}

// The public failure, assembled from the parts. One place, so every refusal is positioned the same way.
func BuiltFailure(stopped: &TomlStopped) -> TomlParseFailure {
    let reason = match stopped.stop {
        .Lexical => TomlParseError::Lexical(stopped.lexical),
        .Unexpected => TomlParseError::Unexpected,
        .Truncated => TomlParseError::Truncated,
        .DuplicateKey => TomlParseError::DuplicateKey,
        .RedefinedTable => TomlParseError::RedefinedTable,
        .ExtendedInlineTable => TomlParseError::ExtendedInlineTable,
        .ExtendedDottedTable => TomlParseError::ExtendedDottedTable,
        .NotATable => TomlParseError::NotATable,
        .NotATableArray => TomlParseError::NotATableArray,
        .BadValue => TomlParseError::BadValue(stopped.scalar),
        .BadText => TomlParseError::BadText,
        .TooDeep => TomlParseError::TooDeep,
        .OutOfMemory => TomlParseError::OutOfMemory,
        // A parser that has not stopped has no failure; callers reach this only after asking whether it did.
        .None => TomlParseError::OutOfMemory
    };
    return TomlParseFailure {
        reason: reason, offset: stopped.offset, line: stopped.line, column: stopped.column
    };
}

/// A parser over a document.
///
/// @see https://rux-lang.dev/docs/api/toml/parser
pub struct TomlParser {
    /// Where tokens come from.
    lexer: TomlLexer;
    /// Where values are built.
    allocator: Allocator;
    /// What to accept.
    limits: TomlLimits;
    /// The whole document, which token spans point into.
    input: char8[..];
    /// The token about to be read.
    ahead: TomlToken;
    /// How deep the current value is nested.
    depth: uint;
    /// Why parsing stopped.
    outcome: TomlStopped;
}

extend TomlParser {
    /// A parser over `input` under `limits`.
    ///
    /// @param allocator where the storage comes from
    /// @param input the text to read
    /// @param limits the bounds the parse refuses to exceed
    /// @returns a parser ready to read the input
    /// @see https://rux-lang.dev/docs/api/toml/parser/new
    pub func TomlParser(allocator: Allocator, input: char8[..], limits: TomlLimits) -> TomlParser {
        var lexer = TomlLexer(input);
        let first = lexer.Next();
        return TomlParser {
            lexer: lexer,
            allocator: allocator,
            limits: limits,
            input: input,
            ahead: first,
            depth: 0,
            outcome: TomlStopped {
                stop: TomlStop::None,
                lexical: TomlLexError::None,
                scalar: TomlScalarError::Malformed(0u),
                offset: 0,
                line: 1,
                column: 1
            }
        };
    }

    /// Why parsing stopped, positioned, or `None` while nothing has gone wrong.
    ///
    /// A caller using `Parse` never needs this: the failure comes back in the result.
    ///
    /// @returns the failure, or `None`
    /// @see https://rux-lang.dev/docs/api/toml/parser/failure
    pub func Failure(self: &TomlParser) -> Option<TomlParseFailure> {
        if self.outcome.stop == TomlStop::None { return Option::None<TomlParseFailure>(); }
        return Option::Some<TomlParseFailure>(BuiltFailure(self.outcome));
    }

    /// Whether parsing has failed.
    ///
    /// @returns whether the parse stopped on a failure
    /// @see https://rux-lang.dev/docs/api/toml/parser/failed
    pub func Failed(self: &TomlParser) -> bool {
        return self.outcome.stop != TomlStop::None;
    }

    // Records the first failure and where it happened; later ones are noise, since everything after a refusal is
    // parsed from a position the document never meant.
    func Stop(self: &var TomlParser, reason: TomlStop) {
        if self.outcome.stop != TomlStop::None { return; }
        self.outcome.stop = reason;
        self.outcome.offset = self.ahead.start;
        self.outcome.line = self.ahead.line;
        self.outcome.column = self.ahead.column;
        if reason == TomlStop::Lexical {
            self.outcome.lexical = self.ahead.error;
        }
    }

    // A scalar failure knows where it is inside the scalar's own text; the token knows where the scalar is in the
    // document. This is the one place the two are added, so a caller reading the line and column is pointed at the
    // character rather than at the value that contains it.
    //
    // The position is the *token's*, not the lookahead's. `Stop` uses the lookahead because that is where a
    // structural refusal is found, but a scalar has already been consumed by the time its text is read, so
    // reporting through `Stop` alone put every bad number at the position of whatever followed it.
    func RefuseScalar(self: &var TomlParser, token: TomlToken, reason: TomlScalarError) -> TomlValue {
        if self.outcome.stop == TomlStop::None {
            self.outcome.stop = TomlStop::BadValue;
            self.outcome.scalar = reason;
            self.outcome.offset = token.start + reason.Offset();
            self.outcome.line = token.line;
            // A scalar token is one line, so the offset moves the column and nothing else.
            self.outcome.column = token.column + reason.Offset();
        }
        return TomlValue::Table(self.allocator);
    }

    // Whichever of the four shapes the text turned out to be, as the value that shape names.
    func MomentValue(self: &var TomlParser, moment: TomlDateTime) -> TomlValue {
        if moment.shape == TomlDateTimeShape::Offset {
            return TomlValue::OffsetDateTime(self.allocator, moment.date, moment.time, moment.offset);
        }
        if moment.shape == TomlDateTimeShape::Local {
            return TomlValue::LocalDateTime(self.allocator, moment.date, moment.time);
        }
        if moment.shape == TomlDateTimeShape::DateOnly { return TomlValue::LocalDate(self.allocator, moment.date); }
        return TomlValue::LocalTime(self.allocator, moment.time);
    }

    func Advance(self: &var TomlParser) -> TomlToken {
        let current = self.ahead;
        if current.kind != TomlTokenKind::End {
            self.ahead = self.lexer.Next();
        }
        return current;
    }

    func SkipNewlines(self: &var TomlParser) {
        while self.ahead.kind == TomlTokenKind::Newline {
            self.Advance();
        }
    }
}

extend TomlParser {
    // One value, whichever kind the token announces. A scalar's text is read here rather than in the lexer,
    // because only here is it known which of the two number kinds or four date kinds was meant.
    func ParseValue(self: &var TomlParser) -> TomlValue {
        let token = self.ahead;
        if token.kind == TomlTokenKind::Error {
            self.Stop(TomlStop::Lexical);
            return TomlValue::Table(self.allocator);
        }
        if token.kind == TomlTokenKind::LeftBracket { return self.ParseArray(); }
        if token.kind == TomlTokenKind::LeftBrace { return self.ParseInlineTable(); }
        self.Advance();
        let span = self.lexer.TextOf(token);
        if token.kind == TomlTokenKind::Text {
            var textError = TextError::None;
            var bad = false;
            var decoded = TomlDecodeText(self.allocator, span, token.form, @textError, @bad);
            if bad {
                self.Stop(TomlStop::BadText);
            }
            return TomlValue::FromString(self.allocator, decoded);
        }
        if token.kind == TomlTokenKind::Boolean { return TomlValue::Boolean(self.allocator, span.length == 4u); }
        if token.kind == TomlTokenKind::Integer {
            return match TomlParseInteger(span) {
                .Success(value) => TomlValue::Integer(self.allocator, value),
                .Error(reason) => self.RefuseScalar(token, reason)
            };
        }
        if token.kind == TomlTokenKind::Float {
            return match TomlParseFloat(span) {
                .Success(value) => TomlValue::Float(self.allocator, value),
                .Error(reason) => self.RefuseScalar(token, reason)
            };
        }
        if token.kind == TomlTokenKind::DateTime {
            return match TomlParseDateTime(span) {
                .Success(moment) => self.MomentValue(moment),
                .Error(reason) => self.RefuseScalar(token, reason)
            };
        }
        if token.kind == TomlTokenKind::End {
            self.Stop(TomlStop::Truncated);
            return TomlValue::Table(self.allocator);
        }
        // A bare word where a value belongs is the shape of a string someone forgot to quote, which is worth
        // reporting as a misplaced token rather than as an unknown keyword.
        self.Stop(TomlStop::Unexpected);
        return TomlValue::Table(self.allocator);
    }

    // An array. Newlines and a trailing comma are allowed inside one, which they have been since TOML 1.0.
    func ParseArray(self: &var TomlParser) -> TomlValue {
        if self.depth >= self.limits.maximumDepth {
            self.Stop(TomlStop::TooDeep);
            return TomlValue::Table(self.allocator);
        }
        self.depth = self.depth + 1u;
        self.Advance();
        var array = TomlValue::Array(self.allocator);
        while true {
            self.SkipNewlines();
            if self.ahead.kind == TomlTokenKind::RightBracket {
                self.Advance();
                break;
            }
            if self.ahead.kind == TomlTokenKind::End {
                self.Stop(TomlStop::Truncated);
                break;
            }
            var element = self.ParseValue();
            if self.Failed() { break; }
            if !array.Push(<-element) {
                self.Stop(TomlStop::OutOfMemory);
                break;
            }
            self.SkipNewlines();
            if self.ahead.kind == TomlTokenKind::Comma {
                self.Advance();
                continue;
            }
            if self.ahead.kind == TomlTokenKind::RightBracket {
                self.Advance();
                break;
            }
            if self.ahead.kind == TomlTokenKind::End {
                self.Stop(TomlStop::Truncated);
                break;
            }
            self.Stop(TomlStop::Unexpected);
            break;
        }
        self.depth = self.depth - 1u;
        return <-array;
    }
}

extend TomlParser {
    // An inline table. TOML 1.1 allows newlines and a trailing comma inside one, which 1.0 did not; a document
    // using either is refused by an older reader, and that is worth knowing before writing one.
    func ParseInlineTable(self: &var TomlParser) -> TomlValue {
        if self.depth >= self.limits.maximumDepth {
            self.Stop(TomlStop::TooDeep);
            return TomlValue::Table(self.allocator);
        }
        self.depth = self.depth + 1u;
        self.Advance();
        var table = TomlValue::Table(self.allocator);
        table.defined = true;
        table.inlined = true;
        while true {
            self.SkipNewlines();
            if self.ahead.kind == TomlTokenKind::RightBrace {
                self.Advance();
                break;
            }
            if self.ahead.kind == TomlTokenKind::End {
                self.Stop(TomlStop::Truncated);
                break;
            }
            self.ParseKeyValue(@table);
            if self.Failed() { break; }
            self.SkipNewlines();
            if self.ahead.kind == TomlTokenKind::Comma {
                self.Advance();
                continue;
            }
            if self.ahead.kind == TomlTokenKind::RightBrace {
                self.Advance();
                break;
            }
            if self.ahead.kind == TomlTokenKind::End {
                self.Stop(TomlStop::Truncated);
                break;
            }
            self.Stop(TomlStop::Unexpected);
            break;
        }
        self.depth = self.depth - 1u;
        return <-table;
    }

    // One key part: a bare key, or a quoted one in either single-line string form. A multi-line string is not a
    // key, which is the one place TOML's two quoting systems do not line up.
    func ParseKeyPart(self: &var TomlParser, into: &var String) -> bool {
        let token = self.ahead;
        if token.kind == TomlTokenKind::Error {
            self.Stop(TomlStop::Lexical);
            return false;
        }
        if token.kind != TomlTokenKind::BareKey && token.kind != TomlTokenKind::Text &&
            token.kind != TomlTokenKind::Integer && token.kind != TomlTokenKind::Boolean {
            self.Stop(TomlStop::Unexpected);
            return false;
        }
        if token.kind == TomlTokenKind::Text &&
            (token.form == TomlTextForm::MultiLineBasic || token.form == TomlTextForm::MultiLineLiteral) {
            self.Stop(TomlStop::Unexpected);
            return false;
        }
        self.Advance();
        let span = self.lexer.TextOf(token);
        var textError = TextError::None;
        var bad = false;
        // A key made of digits — `1234 = "x"` — lexes as an integer and is a perfectly good bare key, so the
        // form for anything that is not a quoted string is the one that copies the bytes unchanged.
        let form = token.kind == TomlTokenKind::Text ? token.form : TomlTextForm::Bare;
        into.ReplaceWith(TomlDecodeText(self.allocator, span, form, @textError, @bad));
        if bad {
            self.Stop(TomlStop::BadText);
            return false;
        }
        return true;
    }

    // A dotted key path, collected into `parts`.
    func ParseKeyPath(self: &var TomlParser, parts: &var Vector<String>) -> bool {
        while true {
            var part = String(self.allocator);
            if !self.ParseKeyPart(part) {
                part.Clear();
                return false;
            }
            if parts.Push(part) != CollectionError::None {
                self.Stop(TomlStop::OutOfMemory);
                return false;
            }
            if self.ahead.kind != TomlTokenKind::Dot { return true; }
            self.Advance();
        }
        return true;
    }
}

extend TomlParser {
    // A key and its value, written into `into`. A dotted key creates the tables it passes through, and those
    // tables are closed when the line ends — which is why they are marked as dotted rather than merely made.
    func ParseKeyValue(self: &var TomlParser, into: *var TomlValue) {
        var parts = Vector<String>(self.allocator);
        if !self.ParseKeyPath(parts) {
            parts.Clear();
            return;
        }
        if self.ahead.kind != TomlTokenKind::Equals {
            self.Stop(TomlStop::Unexpected);
            parts.Clear();
            return;
        }
        self.Advance();
        var value = self.ParseValue();
        if self.Failed() {
            parts.Clear();
            return;
        }
        var target = into;
        var index: uint = 0;
        while index + 1u < parts.Length() && target != null {
            let name = parts.AsSlice().data[index].View();
            target = self.DescendDotted(target, name, parts.AsSlice().data[index].View());
            index = index + 1u;
        }
        if target == null {
            parts.Clear();
            return;
        }
        let last = parts.Length() - 1u;
        let finalName = parts.AsSlice().data[last].View();
        if (*target).Find(finalName) != null {
            self.Stop(TomlStop::DuplicateKey);
            parts.Clear();
            return;
        }
        var textError = TextError::None;
        var owned = String::FromView(self.allocator, finalName, @textError);
        if !(*target).Insert(owned, <-value) {
            self.Stop(TomlStop::OutOfMemory);
        }
        parts.Clear();
    }

    // The table a dotted key passes through, made if it is not there and checked if it is.
    func DescendDotted(self: &var TomlParser, target: *var TomlValue, name: StringView,
                       copy: StringView) -> *var TomlValue {
        var existing = (*target).FindMutable(name);
        if existing == null {
            var fresh = TomlValue::Table(self.allocator);
            fresh.dotted = true;
            var textError = TextError::None;
            var owned = String::FromView(self.allocator, copy, @textError);
            if !(*target).Insert(owned, <-fresh) {
                self.Stop(TomlStop::OutOfMemory);
                return null;
            }
            return (*target).FindMutable(name);
        }
        if existing.kind != TomlKind::Table {
            self.Stop(TomlStop::NotATable);
            return null;
        }
        if existing.inlined {
            // An inline table is finished when its brace shuts. Adding to it later is the mistake that reads as
            // harmless and is not: the value would depend on which line the reader had got to.
            self.Stop(TomlStop::ExtendedInlineTable);
            return null;
        }
        if existing.defined && !existing.dotted {
            self.Stop(TomlStop::RedefinedTable);
            return null;
        }
        return existing;
    }
}

extend TomlParser {
    // A `[name]` or `[[name]]` header, returning the table that the lines after it belong to.
    func ParseHeader(self: &var TomlParser, root: *var TomlValue) -> *var TomlValue {
        self.Advance();
        var array = false;
        if self.ahead.kind == TomlTokenKind::LeftBracket {
            array = true;
            self.Advance();
        }
        var parts = Vector<String>(self.allocator);
        if !self.ParseKeyPath(parts) {
            parts.Clear();
            return null;
        }
        if parts.Length() == 0u {
            self.Stop(TomlStop::Unexpected);
            parts.Clear();
            return null;
        }
        if self.ahead.kind != TomlTokenKind::RightBracket {
            self.Stop(TomlStop::Unexpected);
            parts.Clear();
            return null;
        }
        self.Advance();
        if array {
            if self.ahead.kind != TomlTokenKind::RightBracket {
                self.Stop(TomlStop::Unexpected);
                parts.Clear();
                return null;
            }
            self.Advance();
        }
        if self.ahead.kind != TomlTokenKind::Newline && self.ahead.kind != TomlTokenKind::End {
            self.Stop(TomlStop::Unexpected);
            parts.Clear();
            return null;
        }
        var target = root;
        var index: uint = 0;
        while index + 1u < parts.Length() && target != null {
            target = self.DescendHeader(target, parts.AsSlice().data[index].View());
            index = index + 1u;
        }
        if target == null {
            parts.Clear();
            return null;
        }
        let last = parts.Length() - 1u;
        var opened = array ? self.OpenTableArray(target, parts.AsSlice().data[last].View())
                           : self.OpenTable(target, parts.AsSlice().data[last].View());
        parts.Clear();
        return opened;
    }

    // A table a header path passes through: made implicitly if absent, followed into its last element if it is
    // an array of tables, and refused if it was closed by an inline brace or a dotted key.
    func DescendHeader(self: &var TomlParser, target: *var TomlValue, name: StringView) -> *var TomlValue {
        var existing = (*target).FindMutable(name);
        if existing == null {
            var fresh = TomlValue::Table(self.allocator);
            var textError = TextError::None;
            var owned = String::FromView(self.allocator, name, @textError);
            if !(*target).Insert(owned, <-fresh) {
                self.Stop(TomlStop::OutOfMemory);
                return null;
            }
            return (*target).FindMutable(name);
        }
        if existing.kind == TomlKind::Array {
            if !existing.tableArray || (*existing).Length() == 0u {
                self.Stop(TomlStop::NotATableArray);
                return null;
            }
            // A path through an array of tables means its most recent element, which is the one still being
            // written; the earlier ones are finished.
            return (*existing).AtMutable((*existing).Length() - 1u);
        }
        if existing.kind != TomlKind::Table {
            self.Stop(TomlStop::NotATable);
            return null;
        }
        if existing.inlined {
            self.Stop(TomlStop::ExtendedInlineTable);
            return null;
        }
        if existing.dotted {
            self.Stop(TomlStop::ExtendedDottedTable);
            return null;
        }
        return existing;
    }

    // The table a `[name]` header opens.
    func OpenTable(self: &var TomlParser, target: *var TomlValue, name: StringView) -> *var TomlValue {
        var existing = (*target).FindMutable(name);
        if existing == null {
            var fresh = TomlValue::Table(self.allocator);
            fresh.defined = true;
            var textError = TextError::None;
            var owned = String::FromView(self.allocator, name, @textError);
            if !(*target).Insert(owned, <-fresh) {
                self.Stop(TomlStop::OutOfMemory);
                return null;
            }
            return (*target).FindMutable(name);
        }
        if existing.kind != TomlKind::Table {
            self.Stop(TomlStop::NotATable);
            return null;
        }
        if existing.inlined {
            self.Stop(TomlStop::ExtendedInlineTable);
            return null;
        }
        if existing.dotted {
            self.Stop(TomlStop::ExtendedDottedTable);
            return null;
        }
        if existing.defined {
            self.Stop(TomlStop::RedefinedTable);
            return null;
        }
        // A table that only existed because a longer header passed through it is now written out, which TOML
        // allows in either order: `[a.b]` before `[a]` is fine, and `[a]` twice is not.
        existing.defined = true;
        return existing;
    }

    // The table a `[[name]]` header appends.
    func OpenTableArray(self: &var TomlParser, target: *var TomlValue, name: StringView) -> *var TomlValue {
        var existing = (*target).FindMutable(name);
        if existing == null {
            var fresh = TomlValue::Array(self.allocator);
            fresh.tableArray = true;
            var textError = TextError::None;
            var owned = String::FromView(self.allocator, name, @textError);
            if !(*target).Insert(owned, <-fresh) {
                self.Stop(TomlStop::OutOfMemory);
                return null;
            }
            existing = (*target).FindMutable(name);
        }
        else if existing.kind != TomlKind::Array || !existing.tableArray {
            // A static array is a value, not a place to put tables; the two are spelled differently and mean
            // different things.
            self.Stop(TomlStop::NotATableArray);
            return null;
        }
        var element = TomlValue::Table(self.allocator);
        element.defined = true;
        if !(*existing).Push(<-element) {
            self.Stop(TomlStop::OutOfMemory);
            return null;
        }
        return (*existing).AtMutable((*existing).Length() - 1u);
    }
}

extend TomlParser {
    /// Reads the whole document into a table.
    ///
    /// On failure the table holds whatever had been read before the refusal, and `Outcome` says what stopped it
    /// and where. A partial document is not a usable one; it is returned rather than discarded so a caller can
    /// show what was understood before the line that was not.
    ///
    /// What comes back is the values and nothing else. Comments never reach the parser, and neither does the
    /// blank line someone put between two sections or the fact that a number was written in hexadecimal. This
    /// reads configuration; it does not edit files.
    ///
    /// @returns the document, or the failure and where it was found
    /// @see https://rux-lang.dev/docs/api/toml/parser/parse
    pub func Parse(self: &var TomlParser) -> Result<TomlValue, TomlParseFailure> {
        var root = TomlValue::Table(self.allocator);
        root.defined = true;
        var current = @root;
        while true {
            self.SkipNewlines();
            if self.ahead.kind == TomlTokenKind::End { break; }
            if self.ahead.kind == TomlTokenKind::Error {
                self.Stop(TomlStop::Lexical);
                break;
            }
            if self.ahead.kind == TomlTokenKind::LeftBracket {
                current = self.ParseHeader(@root);
                if current == null { break; }
                continue;
            }
            self.ParseKeyValue(current);
            if self.Failed() { break; }
            if self.ahead.kind != TomlTokenKind::Newline && self.ahead.kind != TomlTokenKind::End {
                // Two key-value pairs on one line is the shape of a missing newline, and TOML has no separator
                // that would make it mean anything else.
                self.Stop(TomlStop::Unexpected);
                break;
            }
        }
        if self.outcome.stop != TomlStop::None {
            // Whatever was read before the refusal goes here, at the end of this scope. A configuration read from
            // half a file is worse than none of it: a program started from it runs with some settings applied and
            // some defaulted, which is a state nobody wrote down and nobody tested.
            return Result::Error<TomlValue, TomlParseFailure>(BuiltFailure(self.outcome));
        }
        return Result::Success<TomlValue, TomlParseFailure>(<-root);
    }
}

/// Reads `input` into a table, or says why it could not and where.
///
/// A refusal gives back no document at all. Whatever had been read when the parser stopped is released here,
/// which is the only place it can be done once — and handing it back would be worse than useless, because a
/// program configured from half a file runs with some settings applied and some defaulted.
///
/// # Failures
/// Every case of `TomlParseError`, positioned at the byte, line and column where parsing stopped.
///
/// @param allocator where the document is built
/// @param input the document, as UTF-8 bytes
/// @returns the document, or the failure that stopped it
/// @see https://rux-lang.dev/docs/api/toml/parse
pub func TomlParse(allocator: Allocator, input: char8[..]) -> Result<TomlValue, TomlParseFailure> {
    var parser = TomlParser(allocator, input, TomlLimits::Default());
    return parser.Parse();
}
