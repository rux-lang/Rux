// Reading a document as a stream of events, without building a tree.
//
// A tree is convenient and it is also what makes a large document expensive. Streaming trades random access for
// constant memory: events arrive in document order, once, and the caller keeps only what it wants. A program
// reading one setting out of a large configuration file never allocates for the rest of it.
//
// What a streaming reader cannot do is notice that a table was defined twice, because knowing that requires
// remembering every table already seen — which is the tree it was trying not to build. So this checks syntax
// and structure and nothing else, and a caller that needs TOML's redefinition rules enforced wants the parser.
// Saying so here is better than a reader that quietly accepts a document the parser would refuse.
//
// Text is left as it was written, escapes and all. Resolving them costs an allocation, and a caller skipping a
// field should not pay for the field it is skipping; `TomlDecodeText` is there for the ones it keeps.


/// What just happened in the document.
///
/// @see https://rux-lang.dev/docs/api/toml/event
pub enum TomlEvent: int32 {
    /// The document is finished.
    End = 0,
    /// Something went wrong; the reason is on the reader.
    Error = 1,
    /// A `[name]` or `[[name]]` header opened; `IsTableArray` says which, and the key parts follow.
    HeaderStart = 2,
    /// The header's key path is complete.
    HeaderEnd = 3,
    /// A key-value pair began; the key parts follow, and then the value.
    KeyStart = 4,
    /// One part of a key path, whose span is the key as written.
    KeyPart = 5,
    /// A string value, still escaped as it was written.
    Text = 6,
    /// An integer, as written.
    Integer = 7,
    /// A float, as written.
    Float = 8,
    /// `true` or `false`.
    Boolean = 9,
    /// A date-time in any of the four forms, as written.
    DateTime = 10,
    /// An array opened.
    ArrayStart = 11,
    /// An array closed.
    ArrayEnd = 12,
    /// An inline table opened.
    InlineTableStart = 13,
    /// An inline table closed.
    InlineTableEnd = 14
}

// What the reader is in the middle of. The states are what let one call to `Next` return exactly one event
// while consuming the punctuation between them.
enum TomlEventState: int32 {
    Document = 0,
    HeaderKey = 1,
    PairKey = 2,
    Value = 3,
    AfterValue = 4,
    InlineKey = 5,
    Finished = 6
}

/// Reads a document as events, in order, without building a tree.
///
/// @see https://rux-lang.dev/docs/api/toml/event-reader
pub struct TomlEventReader {
    /// Where tokens come from.
    lexer: TomlLexer;
    /// The whole document, which spans point into.
    input: char8[..];
    /// The token about to be read.
    ahead: TomlToken;
    /// The token the current event came from.
    current: TomlToken;
    /// What the reader is in the middle of.
    state: TomlEventState;
    /// Whether the header being read is a `[[name]]` one.
    tableArray: bool;
    /// Whether the header being read has named anything yet, since `[]` names nothing.
    namedSomething: bool;
    /// The open containers, one bit each: set for an inline table, clear for an array.
    containers: uint64;
    /// How many of those bits are in use.
    depth: uint;
    /// Why reading stopped, as its parts. The public failure is built from them in `Failure`, the same way the
    /// tree parser builds its own, so the two report a refusal identically.
    stop: TomlStop;
    /// The lexer's reason, when `stop` is `Lexical`.
    lexical: TomlLexError;
}

extend TomlEventReader {
    /// A reader over `input`.
    ///
    /// @param input the text to read
    /// @returns a reader positioned before the first event
    /// @see https://rux-lang.dev/docs/api/toml/event-reader/new
    pub func TomlEventReader(input: char8[..]) -> TomlEventReader {
        var lexer = TomlLexer(input);
        let first = lexer.Next();
        return TomlEventReader {
            lexer: lexer,
            input: input,
            ahead: first,
            current: first,
            state: TomlEventState::Document,
            tableArray: false,
            namedSomething: false,
            containers: 0u64,
            depth: 0,
            stop: TomlStop::None,
            lexical: TomlLexError::None
        };
    }

    /// Why reading stopped, positioned, or `None` while nothing has gone wrong.
    ///
    /// This is what a caller asks after `Next` reports `Error`. A lexical refusal carries the lexer's own reason
    /// inside it rather than in a second call, so a caller holding the failure is holding all of it — and it is
    /// the same `TomlParseFailure` the tree parser answers, so the two ways of reading a document report a
    /// refusal in one vocabulary rather than two.
    ///
    /// @returns the failure, positioned at the token the reader stopped on, or `None`
    /// @see https://rux-lang.dev/docs/api/toml/event-reader/failure
    pub func Failure(self: &TomlEventReader) -> Option<TomlParseFailure> {
        if self.stop == TomlStop::None { return Option::None<TomlParseFailure>(); }
        let stopped = TomlStopped {
            stop: self.stop,
            lexical: self.lexical,
            scalar: TomlScalarError::Malformed(0u),
            offset: self.current.start,
            line: self.current.line,
            column: self.current.column
        };
        return Option::Some<TomlParseFailure>(BuiltFailure(stopped));
    }

    /// The bytes the current event's token spans, as written: a string is still escaped and a number is still
    /// text.
    ///
    /// @returns the raw text the current event covers, borrowed from the input
    /// @see https://rux-lang.dev/docs/api/toml/event-reader/span
    pub func Span(self: &TomlEventReader) -> char8[..] {
        return (self.input.data + self.current.start)[..self.current.end - self.current.start];
    }

    /// Which string form the current text event was written in, which decoding it needs.
    ///
    /// @returns which quoting form the current text was written in
    /// @see https://rux-lang.dev/docs/api/toml/event-reader/form
    pub func Form(self: &TomlEventReader) -> TomlTextForm {
        return self.current.form;
    }

    /// Which line the current event is on, counting from one.
    ///
    /// @returns the current event's line, counting from one
    /// @see https://rux-lang.dev/docs/api/toml/event-reader/line
    pub func Line(self: &TomlEventReader) -> uint {
        return self.current.line;
    }

    /// Which column the current event is at, counting from one, in bytes.
    ///
    /// @returns the current event's column, counting from one
    /// @see https://rux-lang.dev/docs/api/toml/event-reader/column
    pub func Column(self: &TomlEventReader) -> uint {
        return self.current.column;
    }

    /// Whether the header being read was written `[[name]]` rather than `[name]`.
    ///
    /// @returns whether the current header opens an array of tables rather than a table
    /// @see https://rux-lang.dev/docs/api/toml/event-reader/is-table-array
    pub func IsTableArray(self: &TomlEventReader) -> bool {
        return self.tableArray;
    }

    /// How deep inside arrays and inline tables the reader is.
    ///
    /// @returns how many tables are currently open
    /// @see https://rux-lang.dev/docs/api/toml/event-reader/depth
    pub func Depth(self: &TomlEventReader) -> uint {
        return self.depth;
    }
}

extend TomlEventReader {
    func Advance(self: &var TomlEventReader) -> TomlToken {
        let token = self.ahead;
        if token.kind != TomlTokenKind::End {
            self.ahead = self.lexer.Next();
        }
        return token;
    }

    func Fail(self: &var TomlEventReader, reason: TomlStop) -> TomlEvent {
        if self.stop == TomlStop::None {
            self.stop = reason;
            self.current = self.ahead;
            if reason == TomlStop::Lexical {
                self.lexical = self.ahead.error;
            }
        }
        self.state = TomlEventState::Finished;
        return TomlEvent::Error;
    }

    func SkipNewlines(self: &var TomlEventReader) {
        while self.ahead.kind == TomlTokenKind::Newline {
            self.Advance();
        }
    }

    // Whether the innermost open container is an inline table. The stack is a single word, one bit per
    // container, which is also why the depth limit here is sixty-four.
    func InsideInlineTable(self: &TomlEventReader) -> bool {
        if self.depth == 0u { return false; }
        return (self.containers >> ((self.depth - 1u) as uint64) & 1u64) == 1u64;
    }

    func OpenContainer(self: &var TomlEventReader, inlineTable: bool) -> bool {
        if self.depth >= 64u { return false; }
        if inlineTable {
            self.containers = self.containers | (1u64 << (self.depth as uint64));
        }
        else {
            self.containers = self.containers & ~(1u64 << (self.depth as uint64));
        }
        self.depth = self.depth + 1u;
        return true;
    }

    func CloseContainer(self: &var TomlEventReader) {
        if self.depth > 0u {
            self.depth = self.depth - 1u;
        }
    }

    // A key part, which is a bare key, a quoted key, or something that lexed as a number and is a perfectly good
    // key: `1979 = "x"` is a key of four digits.
    func TakeKeyPart(self: &var TomlEventReader) -> bool {
        let token = self.ahead;
        if token.kind == TomlTokenKind::Error {
            self.Fail(TomlStop::Lexical);
            return false;
        }
        if token.kind != TomlTokenKind::BareKey && token.kind != TomlTokenKind::Text &&
            token.kind != TomlTokenKind::Integer && token.kind != TomlTokenKind::Boolean {
            self.Fail(TomlStop::Unexpected);
            return false;
        }
        if token.kind == TomlTokenKind::Text &&
            (token.form == TomlTextForm::MultiLineBasic || token.form == TomlTextForm::MultiLineLiteral) {
            self.Fail(TomlStop::Unexpected);
            return false;
        }
        self.current = self.Advance();
        return true;
    }
}

extend TomlEventReader {
    /// The next event, or `End` when the document is finished.
    ///
    /// After an `Error` every later call returns `End`: everything past a refusal would be read from a position
    /// the document never meant.
    ///
    /// @returns the next event, or the end-of-input event
    /// @see https://rux-lang.dev/docs/api/toml/event-reader/next
    pub func Next(self: &var TomlEventReader) -> TomlEvent {
        if self.state == TomlEventState::Finished { return TomlEvent::End; }
        if self.state == TomlEventState::Document { return self.NextAtDocument(); }
        if self.state == TomlEventState::HeaderKey { return self.NextHeaderKey(); }
        if self.state == TomlEventState::PairKey { return self.NextPairKey(); }
        if self.state == TomlEventState::Value { return self.NextValue(); }
        if self.state == TomlEventState::InlineKey { return self.NextInlineKey(); }
        return self.NextAfterValue();
    }

    func NextAtDocument(self: &var TomlEventReader) -> TomlEvent {
        self.SkipNewlines();
        if self.ahead.kind == TomlTokenKind::Error { return self.Fail(TomlStop::Lexical); }
        if self.ahead.kind == TomlTokenKind::End {
            self.current = self.ahead;
            self.state = TomlEventState::Finished;
            return TomlEvent::End;
        }
        if self.ahead.kind == TomlTokenKind::LeftBracket {
            self.current = self.Advance();
            self.tableArray = false;
            self.namedSomething = false;
            if self.ahead.kind == TomlTokenKind::LeftBracket {
                self.tableArray = true;
                self.Advance();
            }
            self.state = TomlEventState::HeaderKey;
            return TomlEvent::HeaderStart;
        }
        self.current = self.ahead;
        self.state = TomlEventState::PairKey;
        return TomlEvent::KeyStart;
    }

    func NextHeaderKey(self: &var TomlEventReader) -> TomlEvent {
        if self.ahead.kind == TomlTokenKind::RightBracket {
            // `[]` names no table, and a header that names nothing is not a header.
            if !self.namedSomething { return self.Fail(TomlStop::Unexpected); }
            self.current = self.Advance();
            if self.tableArray {
                if self.ahead.kind != TomlTokenKind::RightBracket { return self.Fail(TomlStop::Unexpected); }
                self.Advance();
            }
            if self.ahead.kind != TomlTokenKind::Newline && self.ahead.kind != TomlTokenKind::End {
                return self.Fail(TomlStop::Unexpected);
            }
            self.state = TomlEventState::Document;
            return TomlEvent::HeaderEnd;
        }
        if !self.TakeKeyPart() { return TomlEvent::Error; }
        self.namedSomething = true;
        if self.ahead.kind == TomlTokenKind::Dot {
            self.Advance();
        }
        else if self.ahead.kind != TomlTokenKind::RightBracket {
            return self.Fail(TomlStop::Unexpected);
        }
        return TomlEvent::KeyPart;
    }

    func NextPairKey(self: &var TomlEventReader) -> TomlEvent {
        if !self.TakeKeyPart() { return TomlEvent::Error; }
        if self.ahead.kind == TomlTokenKind::Dot {
            self.Advance();
            return TomlEvent::KeyPart;
        }
        if self.ahead.kind != TomlTokenKind::Equals { return self.Fail(TomlStop::Unexpected); }
        self.Advance();
        self.state = TomlEventState::Value;
        return TomlEvent::KeyPart;
    }
}

extend TomlEventReader {
    func NextValue(self: &var TomlEventReader) -> TomlEvent {
        if self.depth > 0u {
            self.SkipNewlines();
        }
        if self.ahead.kind == TomlTokenKind::Error { return self.Fail(TomlStop::Lexical); }
        if self.ahead.kind == TomlTokenKind::End { return self.Fail(TomlStop::Truncated); }
        // An empty array, or one whose last element was followed by a comma.
        if self.ahead.kind == TomlTokenKind::RightBracket && self.depth > 0u && !self.InsideInlineTable() {
            self.current = self.Advance();
            self.CloseContainer();
            self.state = TomlEventState::AfterValue;
            return TomlEvent::ArrayEnd;
        }
        if self.ahead.kind == TomlTokenKind::LeftBracket {
            self.current = self.Advance();
            if !self.OpenContainer(false) { return self.Fail(TomlStop::TooDeep); }
            return TomlEvent::ArrayStart;
        }
        if self.ahead.kind == TomlTokenKind::LeftBrace {
            self.current = self.Advance();
            if !self.OpenContainer(true) { return self.Fail(TomlStop::TooDeep); }
            self.state = TomlEventState::InlineKey;
            return TomlEvent::InlineTableStart;
        }
        let token = self.ahead;
        if token.kind == TomlTokenKind::Text || token.kind == TomlTokenKind::Integer ||
            token.kind == TomlTokenKind::Float || token.kind == TomlTokenKind::Boolean ||
            token.kind == TomlTokenKind::DateTime {
            self.current = self.Advance();
            self.state = TomlEventState::AfterValue;
            if token.kind == TomlTokenKind::Text { return TomlEvent::Text; }
            if token.kind == TomlTokenKind::Integer { return TomlEvent::Integer; }
            if token.kind == TomlTokenKind::Float { return TomlEvent::Float; }
            if token.kind == TomlTokenKind::Boolean { return TomlEvent::Boolean; }
            return TomlEvent::DateTime;
        }
        return self.Fail(TomlStop::Unexpected);
    }

    func NextInlineKey(self: &var TomlEventReader) -> TomlEvent {
        self.SkipNewlines();
        if self.ahead.kind == TomlTokenKind::RightBrace {
            self.current = self.Advance();
            self.CloseContainer();
            self.state = TomlEventState::AfterValue;
            return TomlEvent::InlineTableEnd;
        }
        if self.ahead.kind == TomlTokenKind::End { return self.Fail(TomlStop::Truncated); }
        self.current = self.ahead;
        self.state = TomlEventState::PairKey;
        return TomlEvent::KeyStart;
    }

    func NextAfterValue(self: &var TomlEventReader) -> TomlEvent {
        // At the top level a value ends its line, and nothing else may share it.
        if self.depth == 0u {
            if self.ahead.kind != TomlTokenKind::Newline && self.ahead.kind != TomlTokenKind::End {
                return self.Fail(TomlStop::Unexpected);
            }
            self.state = TomlEventState::Document;
            return self.NextAtDocument();
        }
        self.SkipNewlines();
        let inlineTable = self.InsideInlineTable();
        if self.ahead.kind == TomlTokenKind::Comma {
            self.Advance();
            self.state = inlineTable ? TomlEventState::InlineKey : TomlEventState::Value;
            return self.Next();
        }
        if inlineTable {
            if self.ahead.kind != TomlTokenKind::RightBrace {
                if self.ahead.kind == TomlTokenKind::End { return self.Fail(TomlStop::Truncated); }
                return self.Fail(TomlStop::Unexpected);
            }
            self.current = self.Advance();
            self.CloseContainer();
            return TomlEvent::InlineTableEnd;
        }
        if self.ahead.kind != TomlTokenKind::RightBracket {
            if self.ahead.kind == TomlTokenKind::End { return self.Fail(TomlStop::Truncated); }
            return self.Fail(TomlStop::Unexpected);
        }
        self.current = self.Advance();
        self.CloseContainer();
        return TomlEvent::ArrayEnd;
    }
}
