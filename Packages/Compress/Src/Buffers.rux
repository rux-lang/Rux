// Compressing and decompressing whole buffers, for data already in memory.
// Both run the streaming reader and writer over a source that reads a slice and a sink that appends to storage this
// function owns. An interface value holds its own copy of what it was made from, so the sink writes through the
// storage's address, and the function collects the bytes from there when the stream is done.

import Allocator::{ Allocator, Layout };
import Collections::Vector;
import Io::{ IoError, IoErrorKind, Reader, Writer };
import Memory::Copy;
import Compress::{ CompressWriter, DecompressReader, Format, Level };

// A reader over a slice of bytes.
struct SliceSource {
    data: char8[..];
    at: uint;
}

extend SliceSource : Reader {
    func Read(&var self, into: var char8[..]) -> uint throws IoError {
        if self.at == self.data.length { throw IoError::Of(IoErrorKind::EndOfStream); }
        var count = self.data.length - self.at;
        if count > into.length { count = into.length; }
        var index: uint = 0;
        while index < count {
            into[index] = self.data[self.at + index];
            index = index + 1;
        }
        self.at = self.at + count;
        return count;
    }
}

// Storage the sink appends to, owned by the function that made the sink.
struct Gathered {
    data: *var uint8;
    length: uint;
    capacity: uint;
    allocator: Allocator;
}

// A writer that appends to gathered storage.
struct GatherSink {
    target: *var Gathered;
}

extend GatherSink : Writer {
    func Write(&var self, bytes: char8[..]) -> uint throws IoError {
        // Safety: `self.target` addresses the `Gathered` local of the function that made this sink, which outlives
        // the stream; `bytes` is readable for its length, and `char8` and `uint8` are both single bytes.
        unsafe { try AppendGathered(self.target, bytes.data as *uint8, bytes.length); }
        return bytes.length;
    }

    func Flush(&var self) throws IoError {}
}

// Appends `count` bytes to the storage, growing it as needed.
// Safety: `target` must address live gathered storage whose `data` is null with `capacity` zero, or a block of
// `capacity` bytes from `allocator` with the first `length` in use; `bytes` must be readable for `count` bytes and
// lie outside that block.
unsafe func AppendGathered(target: *var Gathered, bytes: *uint8, count: uint) throws IoError {
    if target.length + count > target.capacity {
        var capacity = if target.capacity == 0u { 4096u } else { target.capacity * 2u };
        while capacity < target.length + count { capacity = capacity * 2u; }
        var allocator = target.allocator;
        let block = try allocator.Allocate(Layout::Of(capacity, 1) ?? throw IoError::Of(IoErrorKind::LimitExceeded))
            catch { _ => throw IoError::Of(IoErrorKind::LimitExceeded) };
        if target.data != null {
            Copy(block, target.data as *opaque, target.length);
            let layout = Layout::Of(target.capacity, 1) ?? Layout::ForValue<uint8>();
            try allocator.Deallocate(target.data as *var opaque, layout) catch { _ => {} };
        }
        target.data = block as *var uint8;
        target.capacity = capacity;
    }
    Copy((target.data + target.length) as *var opaque, bytes as *opaque, count);
    target.length = target.length + count;
}

// Moves gathered bytes into a vector and releases the storage.
// Safety: `gathered` must address live gathered storage, as `AppendGathered` requires.
unsafe func Collect(allocator: Allocator, gathered: *var Gathered) -> Vector<byte> throws IoError {
    var result = Vector<byte>(allocator);
    if gathered.length > 0u {
        result.PushSlice((gathered.data as *byte)[..gathered.length]);
    }
    Release(gathered);
    return move result;
}

// Gives the gathered block back to its allocator.
// Safety: `gathered` must address live gathered storage, as `AppendGathered` requires.
unsafe func Release(gathered: *var Gathered) {
    if gathered.data == null { return; }
    var allocator = gathered.allocator;
    let layout = Layout::Of(gathered.capacity, 1) ?? Layout::ForValue<uint8>();
    try allocator.Deallocate(gathered.data as *var opaque, layout) catch { _ => {} };
    gathered.data = null;
}

/// Compresses `data` in `format` at `level`.
/// @param allocator what the result and the compressor's buffers are kept in
/// @param data the data
/// @param format the container to write
/// @param level how hard to compress
/// @returns the compressed bytes, or fails when the allocator refused
/// @see https://rux-lang.dev/docs/api/compress/buffers#compress
pub func Compress(allocator: Allocator, data: byte[..], format: Format, level: Level = Level::Default)
    -> Vector<byte> throws IoError {
    var gathered = Gathered { data: null, length: 0, capacity: 0, allocator };
    var writer = try CompressWriter(allocator, GatherSink { target: @gathered }, format, level);
    var written: uint = 0;
    // Safety: `data` is readable for its length, and `byte` and `char8` are both single bytes.
    let text = unsafe { (data.data as *char8)[..data.length] };
    while written < text.length {
        written = try written + writer.Write(text[written..]);
    }
    try writer.Finish();
    // Safety: `gathered` is the local above, which only the sink has appended to.
    return try unsafe { Collect(allocator, @gathered) };
}

/// Compresses text in `format` at `level`: its UTF-8 bytes, as the Io streams carry them, so text needs no cast to
/// bytes first.
/// @param allocator what the result and the compressor's buffers are kept in
/// @param data the text
/// @param format the container to write
/// @param level how hard to compress
/// @returns the compressed bytes, or fails when the allocator refused
/// @see https://rux-lang.dev/docs/api/compress/buffers#compress
pub func Compress(allocator: Allocator, data: char8[..], format: Format, level: Level = Level::Default)
    -> Vector<byte> throws IoError {
    // Safety: `data` is readable for its length, and `char8` and `byte` are both single bytes.
    return try Compress(allocator, unsafe { (data.data as *byte)[..data.length] }, format, level);
}

/// Decompresses `data`, a whole stream in `format`.
/// @param allocator what the result and the decompressor's buffers are kept in
/// @param data the compressed stream
/// @param format the container it is in
/// @returns the data, or fails with `InvalidInput` for damaged or truncated input
/// @see https://rux-lang.dev/docs/api/compress/buffers#decompress
pub func Decompress(allocator: Allocator, data: byte[..], format: Format) -> Vector<byte> throws IoError {
    var gathered = Gathered { data: null, length: 0, capacity: 0, allocator };
    // Safety: `data` is readable for its length, and `byte` and `char8` are both single bytes.
    let text = unsafe { (data.data as *char8)[..data.length] };
    var reader = try DecompressReader(allocator, SliceSource { data: text, at: 0 }, format);
    var chunk: char8[4096] = ['\0'; 4096];
    while true {
        let count = try reader.Read(chunk[..]) catch {
            error => {
                if error.kind == IoErrorKind::EndOfStream { break; }
                // Safety: `gathered` is the local above, holding only what `AppendGathered` put there.
                unsafe { Release(@gathered); }
                throw error;
            },
        };
        // Safety: `gathered` is the local above, and `chunk[..count]` is a checked slice of the local chunk,
        // which lies outside the gathered block.
        unsafe {
            try AppendGathered(@gathered, chunk[..count].data as *uint8, count) catch {
                error => {
                    Release(@gathered);
                    throw error;
                },
            };
        }
    }
    // Safety: `gathered` is the local above, holding only what `AppendGathered` put there.
    return try unsafe { Collect(allocator, @gathered) };
}

/// Decompresses `data`, a whole stream in `format` held as `char8` units, such as bytes read from an Io stream.
/// @param allocator what the result and the decompressor's buffers are kept in
/// @param data the compressed stream
/// @param format the container it is in
/// @returns the data, or fails with `InvalidInput` for damaged or truncated input
/// @see https://rux-lang.dev/docs/api/compress/buffers#decompress
pub func Decompress(allocator: Allocator, data: char8[..], format: Format) -> Vector<byte> throws IoError {
    // Safety: `data` is readable for its length, and `char8` and `byte` are both single bytes.
    return try Decompress(allocator, unsafe { (data.data as *byte)[..data.length] }, format);
}
