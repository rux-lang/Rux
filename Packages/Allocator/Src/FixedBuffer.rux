// An allocator that hands out storage from a buffer the caller already has, and never asks anyone for more.
// This is the arena's shape without the arena's appetite: allocation is an addition and a bounds check, everything
// is reclaimed at once, and when the buffer runs out the answer is `OutOfMemory` rather than another block. That
// makes it the allocator for the places where allocation must not happen — a fixed working set, a signal-safe path,
// an embedded target with no allocator underneath at all.
// It owns nothing, so it has no destructor and the buffer's life is entirely the caller's business. What it does
// have is mutable state, and an allocator that is copied while it is being used would hand out the same storage
// twice — so it prohibits copying, and `Handle` gives the `Allocator` handle a container keeps, exactly as for the
// arena.

import Allocator::{ AllocError, Allocator, EmptyBlockAddress, IsEmptyBlock, Layout };
import Memory::{ AlignUp, Copy };

/// An allocator that advances a pointer through storage it does not own.
/// Owns no storage and has no destructor, but prohibits copying because duplicated bump state could hand the same
/// bytes to two callers. Use `Handle` when a stored `Allocator` handle is needed.
/// @see https://rux-lang.dev/docs/api/allocator/fixed-buffer
#NoCopy
pub struct FixedBuffer {
    /// The first byte of the storage, or null for a buffer with no storage at all.
    start: uint;
    /// How many bytes the storage holds.
    capacity: uint;
    /// How many bytes have been handed out, including alignment padding.
    used: uint;
    /// The address the most recent allocation returned, or zero. Kept so releasing or growing it can rewind.
    lastAllocation: uint;
}

extend FixedBuffer {
    /// An allocator over `capacity` bytes at `storage`.
    /// `storage` is borrowed and kept; nothing is copied and nothing is taken ownership of. A `capacity` of zero, or
    /// a null `storage`, gives an allocator that refuses every request with `OutOfMemory` — which is a usable
    /// allocator rather than an error, and is what a caller testing exhaustion wants.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// Safety: the storage must stay valid and untouched by anything else for as long as this allocator or any handle
    /// to it is used. Nothing here tracks that.
    /// @param storage the caller's bytes to hand out of
    /// @param capacity how many bytes `storage` holds
    /// @returns the buffer, having handed out nothing
    /// @see https://rux-lang.dev/docs/api/allocator/fixed-buffer#new
    pub unsafe func FixedBuffer(storage: *var opaque, capacity: uint) -> Self {
        let base = if storage == null { 0u } else { storage as uint };
        return Self {
            start: base,
            capacity: if base == 0 { 0 } else { capacity },
            used: 0,
            lastAllocation: 0
        };
    }

    /// An `Allocator` handle addressing this buffer, for a container to keep.
    /// `self` stays the caller's. Everything allocated through the handle advances this allocator's state rather
    /// than a copy of it.
    /// Safety: the handle addresses the buffer and must not outlive it or survive it being moved, and nothing may
    /// `Reset` the buffer while an allocation made through the handle is still in use. Nothing here tracks that.
    /// @returns a copyable handle addressing this buffer
    /// @see https://rux-lang.dev/docs/api/allocator/fixed-buffer#handle
    pub unsafe func Handle(*var self) -> Allocator {
        return self as Allocator;
    }

    /// Rewinds every allocation, making the whole buffer available again.
    /// `self` is borrowed mutably. Every pointer this allocator handed out becomes invalid.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// Nothing may be read from or written to any earlier allocation afterwards.
    /// @see https://rux-lang.dev/docs/api/allocator/fixed-buffer#reset
    pub func Reset(&var self) {
        self.used = 0;
        self.lastAllocation = 0;
    }

    /// How many bytes have been handed out, including alignment padding.
    /// `self` is borrowed.
    /// @returns how many bytes have been handed out
    /// @see https://rux-lang.dev/docs/api/allocator/fixed-buffer#bytes-used
    pub func BytesUsed(&self) -> uint {
        return self.used;
    }

    /// How many bytes remain, before any alignment padding the next request needs.
    /// `self` is borrowed. A request of exactly this size succeeds only when it needs no padding.
    /// @returns how many bytes are left to hand out
    /// @see https://rux-lang.dev/docs/api/allocator/fixed-buffer#bytes-remaining
    pub func BytesRemaining(&self) -> uint {
        return self.capacity - self.used;
    }

    // Takes storage matching a non-zero-sized `layout`, or reports `OutOfMemory` when what remains cannot hold it.
    func Take(&var self, layout: Layout) -> *var opaque throws AllocError {
        if self.start == 0 { throw .OutOfMemory; }

        let unaligned = self.start + self.used;
        let aligned = AlignUp(unaligned, layout.alignment);
        if aligned < unaligned { throw .OutOfMemory; }
        let padding = aligned - unaligned;
        if padding > self.capacity - self.used { throw .OutOfMemory; }
        let remaining = self.capacity - self.used - padding;
        if layout.size > remaining { throw .OutOfMemory; }

        self.used = self.used + padding + layout.size;
        self.lastAllocation = aligned;
        return aligned as *var opaque;
    }

    // Rewinds the allocation at `address`, `size` bytes long, when it is the most recent one; leaves anything else.
    func Rewind(&var self, address: uint, size: uint) {
        if address == self.lastAllocation {
            let offset = address - self.start;
            if offset + size <= self.used {
                self.used = offset;
                self.lastAllocation = 0;
            }
        }
    }

    // Resizes the allocation at `address` from `oldSize` to `newSize` bytes without moving it, when it is the most
    // recent one and the buffer has room, and reports whether it did.
    func ResizeInPlace(&var self, address: uint, oldSize: uint, newSize: uint) -> bool {
        if address != 0 && address == self.lastAllocation {
            let offset = address - self.start;
            if offset + oldSize == self.used {
                if newSize <= oldSize {
                    self.used = offset + newSize;
                    return true;
                }
                let extra = newSize - oldSize;
                if extra <= self.capacity - self.used {
                    self.used = self.used + extra;
                    return true;
                }
            }
        }
        return false;
    }
}

extend FixedBuffer : Allocator {
    /// Takes storage matching `layout` from the buffer.
    /// `result` receives the address when this reports `None`. A zero-sized layout gives the shared empty block and
    /// consumes nothing.
    /// Reports `OutOfMemory` when what remains cannot hold the request, counting the padding its alignment needs --
    /// so a request the size of `BytesRemaining` can still fail when it has to be aligned first.
    /// Runs in constant time and allocates nothing beyond the buffer.
    /// The storage lives until the allocator is reset, and no longer.
    /// @param layout the size and alignment wanted
    /// @returns the address of the storage, or why none was taken
    /// @see https://rux-lang.dev/docs/api/allocator/fixed-buffer#allocate
    pub func Allocate(&var self, layout: Layout) -> *var opaque throws AllocError {
        if layout.size == 0 {
            return EmptyBlockAddress();
        }
        return try self.Take(layout);
    }

    /// Accepts a release and rewinds only the most recent allocation.
    /// Everything else is reclaimed by `Reset` rather than one block at a time, so an ordinary release reports
    /// `None` having done nothing. Accepting rather than refusing lets this allocator stand in for any other in
    /// generic code that releases what it takes.
    /// @param block an address this allocator returned
    /// @param layout the layout it was allocated with
    /// @returns nothing when the release was accepted, or why it was refused
    /// @see https://rux-lang.dev/docs/api/allocator/fixed-buffer#deallocate
    pub func Deallocate(&var self, block: *var opaque, layout: Layout) throws AllocError {
        if layout.size == 0 { if !IsEmptyBlock(block) { throw .InvalidBlock; } return; }
        if block == null { throw .InvalidBlock; }
        self.Rewind(block as uint, layout.size);
    }

    /// Grows or shrinks a block, extending the most recent allocation in place where the buffer has room.
    /// The two layouts must share an alignment. Anything that is not the most recent allocation takes new storage
    /// and copies, leaving the old space behind until the next reset.
    /// Shrinking to a zero-sized layout releases the block and reports the shared empty address rather than the one
    /// it rewound off of, so the result is releasable with the layout it was asked for.
    /// @param block the existing allocation's address
    /// @param oldLayout the layout `block` was allocated with
    /// @param newLayout the layout wanted, which must have the same alignment
    /// @returns the address the block is at afterwards, or why it was not resized
    /// @see https://rux-lang.dev/docs/api/allocator/fixed-buffer#reallocate
    pub func Reallocate(&var self, block: *var opaque, oldLayout: Layout, newLayout: Layout)
        -> *var opaque throws AllocError {
        if oldLayout.alignment != newLayout.alignment { throw .Unsupported; }
        if oldLayout.size == newLayout.size {
            return block;
        }
        // Shrinking to nothing has to give the shared empty address, not the address it is rewinding off of. Every
        // allocator here answers a zero-sized layout with `EmptyBlockAddress`, and `Deallocate` refuses a
        // zero-sized release that arrives with anything else — so returning the real address would hand the caller
        // a block it cannot release. Releasing the old block first is what rewinds the bump pointer.
        if newLayout.size == 0 {
            try self.Deallocate(block, oldLayout);
            return EmptyBlockAddress();
        }

        if self.ResizeInPlace(block as uint, oldLayout.size, newLayout.size) {
            return block;
        }

        let fresh = try self.Allocate(newLayout);
        let keep = if oldLayout.size < newLayout.size { oldLayout.size } else { newLayout.size };
        // Safety: `fresh` was just allocated with `newLayout.size` bytes and the `Allocator` contract makes `block` a
        // distinct live allocation of `oldLayout.size` bytes, so both hold `keep` bytes and do not overlap.
        unsafe { Copy(fresh, block as *opaque, keep); }
        return fresh;
    }
}
