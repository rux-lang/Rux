// One value on the heap, shared by every copy of a handle and destroyed when the last copy goes.
// `Rc<T>` counts its copies with plain arithmetic, for values that stay on one thread; `Arc<T>` counts them with
// atomic operations, so copies can be handed to other threads and dropped there. Copying either handle copies the
// pointer and adds to the count, which is why both have a copy operator of their own rather than a prohibition: a
// shared value is meant to be copied. The value itself is only ever read through a shared handle, except through
// `GetMutable` while exactly one handle exists, since a write through one copy would change what every other copy
// sees.
// There are no weak handles: a cycle of shared handles is never freed, so a structure that needs back-pointers keeps
// them as raw pointers or indices.

import Allocator::{ AllocError, Allocator, Layout };
import Core::{ AtomicFetchAdd, AtomicFetchSub, AtomicLoad, Fence, MemoryOrder };

// The count of handles and the value they share, in one allocation.
struct SharedBlock<T> {
    count: uint;
    value: T;
}

// Destroys the block's value by moving it out, before its storage is released. The count needs no destruction.
func DestroySharedValue<T>(value: *var T) {
    let taken <- value[0];
}

/// A shared, counted handle to one value, for use on one thread. Copying a handle shares the value.
/// Its count is not atomic, so a handle is not `Sendable`: a thread's context cannot hold one.
/// @typeParam T the value's type
/// @see https://rux-lang.dev/docs/api/allocator/shared#rc
#Unsendable()
pub struct Rc<T> {
    block: *var SharedBlock<T>;
    allocator: Allocator;
}

extend Rc<T> {
    /// Another handle to the same value, adding one to the count.
    /// @param other the handle to copy
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-copy
    pub func =(self: &var Rc<T>, other: &Rc<T>) {
        self.block = other.block;
        self.allocator = other.allocator;
        if self.block != null { self.block.count = self.block.count + 1; }
    }

    /// The first handle to `value`, moved onto the heap.
    /// @param allocator where the storage comes from
    /// @param value the value to share
    /// @returns the handle, or why there was no storage; the value is destroyed then
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-create
    pub func Create(allocator: Allocator, value: T) -> Rc<T> ! AllocError {
        let block = allocator.Allocate(Layout::ForValue<SharedBlock<T>>())? as *var SharedBlock<T>;
        *block <- SharedBlock<T> { count: 1, value: <-value };
        return Rc<T> { block: block, allocator: allocator };
    }

    /// The shared value, for reading.
    /// @returns a pointer to it, valid while any handle exists
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-get
    pub func Get(self: &Rc<T>) -> *T {
        return (@self.block.value) as *T;
    }

    /// The value for writing, while this is the only handle to it.
    /// @returns a pointer to it, or `none` while other handles share it
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-get-mutable
    pub func GetMutable(self: &var Rc<T>) -> (*var T)? {
        if self.block.count != 1 { return none; }
        return @self.block.value;
    }

    /// How many handles share the value.
    /// @returns the count
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-count
    pub func Count(self: &Rc<T>) -> uint {
        return self.block.count;
    }

    /// Whether `other` shares the same value, rather than an equal one.
    /// @param other the other handle
    /// @returns whether both point at one value
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-same-as
    pub func SameAs(self: &Rc<T>, other: &Rc<T>) -> bool {
        return self.block == other.block;
    }

    func ~Rc(self: &var Rc<T>) {
        let block = self.block;
        if block == null { return; }
        self.block = null;
        block.count = block.count - 1;
        if block.count != 0 { return; }
        DestroySharedValue<T>(@block.value);
        self.allocator.Deallocate(block as *var opaque, Layout::ForValue<SharedBlock<T>>()) catch { else => {} };
    }
}

/// A shared, counted handle to one value whose copies may live on different threads. Copying a handle shares the
/// value, and the count is kept with atomic operations.
/// The value is only read through it, so a value that changes while shared needs its own synchronization, such as a
/// `Sync::Mutex`.
/// @typeParam T the value's type
/// @see https://rux-lang.dev/docs/api/allocator/shared#arc
pub struct Arc<T> {
    block: *var SharedBlock<T>;
    allocator: Allocator;
}

extend Arc<T> {
    /// Another handle to the same value, adding one to the count atomically.
    /// @param other the handle to copy
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-copy
    pub func =(self: &var Arc<T>, other: &Arc<T>) {
        self.block = other.block;
        self.allocator = other.allocator;
        if self.block != null { AtomicFetchAdd<uint>(@self.block.count, 1, MemoryOrder::Relaxed); }
    }

    /// The first handle to `value`, moved onto the heap.
    /// @param allocator where the storage comes from, which must be usable from every thread a copy reaches
    /// @param value the value to share
    /// @returns the handle, or why there was no storage; the value is destroyed then
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-create
    pub func Create(allocator: Allocator, value: T) -> Arc<T> ! AllocError {
        let block = allocator.Allocate(Layout::ForValue<SharedBlock<T>>())? as *var SharedBlock<T>;
        *block <- SharedBlock<T> { count: 1, value: <-value };
        return Arc<T> { block: block, allocator: allocator };
    }

    /// The shared value, for reading.
    /// @returns a pointer to it, valid while any handle exists
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-get
    pub func Get(self: &Arc<T>) -> *T {
        return (@self.block.value) as *T;
    }

    /// The value for writing, while this is the only handle to it.
    /// @returns a pointer to it, or `none` while other handles share it
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-get-mutable
    pub func GetMutable(self: &var Arc<T>) -> (*var T)? {
        if AtomicLoad<uint>(@self.block.count, MemoryOrder::Acquire) != 1 { return none; }
        return @self.block.value;
    }

    /// How many handles share the value, at some moment while this one existed; another thread may change it.
    /// @returns the count
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-count
    pub func Count(self: &Arc<T>) -> uint {
        return AtomicLoad<uint>(@self.block.count, MemoryOrder::Relaxed);
    }

    /// Whether `other` shares the same value, rather than an equal one.
    /// @param other the other handle
    /// @returns whether both point at one value
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-same-as
    pub func SameAs(self: &Arc<T>, other: &Arc<T>) -> bool {
        return self.block == other.block;
    }

    func ~Arc(self: &var Arc<T>) {
        let block = self.block;
        if block == null { return; }
        self.block = null;
        // Releasing: every write this thread made to the value happens before the last handle destroys it.
        if AtomicFetchSub<uint>(@block.count, 1, MemoryOrder::Release) != 1 { return; }
        Fence(MemoryOrder::Acquire);
        DestroySharedValue<T>(@block.value);
        self.allocator.Deallocate(block as *var opaque, Layout::ForValue<SharedBlock<T>>()) catch { else => {} };
    }
}
