// One value on the heap, shared by every handle to it and destroyed when the last handle goes.
// `Rc<T>` counts its handles with plain arithmetic, for values that stay on one thread; `Arc<T>` counts them with
// atomic operations, so handles can be handed to other threads and dropped there. A handle owns one count, so it is
// move-only like every owning type: `Clone` copies the pointer and adds to the count, and is the only way to make
// another handle. The value itself is only ever read through a shared handle, except through `GetMutable` while
// exactly one handle exists, since a write through one handle would change what every other handle sees.
// There are no weak handles: a cycle of shared handles is never freed, so a structure that needs back-pointers keeps
// them as raw pointers or indices.

import Allocator::{ AllocError, AllocationFailed, Allocator, Layout };
import Core::{ AtomicFetchAdd, AtomicFetchSub, AtomicLoad, Cloneable, Fence, MemoryOrder };

// The count of handles and the value they share, in one allocation.
struct SharedBlock<T> {
    count: uint;
    value: T;
}

// Destroys the block's value by moving it out, before its storage is released. The count needs no destruction.
// Safety: `value` must address a live `T` that nothing reads or destroys afterwards.
unsafe func DestroySharedValue<T>(value: *var T) {
    let taken = move value[0];
}

/// A shared, counted handle to one value, for use on one thread. A handle is move-only; `Clone` makes another handle
/// to the same value.
/// Its count is not atomic, so a handle is not `Sendable`: a thread's context cannot hold one.
/// @typeParam T the value's type
/// @see https://rux-lang.dev/docs/api/allocator/shared#rc
#Unsendable
pub struct Rc<T> {
    block: *var SharedBlock<T>;
    allocator: Allocator;
}

extend Rc<T> {
    /// The first handle to `value`, moved onto the heap.
    /// Terminates the program when the allocator refuses; `TryCreate` reports the refusal instead.
    /// @param allocator where the storage comes from
    /// @param value the value to share
    /// @returns the handle
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-create
    pub func Create(allocator: Allocator, value: T) -> Self {
        return try Rc::TryCreate<T>(allocator, move value) catch { error => AllocationFailed(error) };
    }

    /// The first handle to `value`, moved onto the heap, or why there was no storage.
    /// @param allocator where the storage comes from
    /// @param value the value to share
    /// @returns the handle, or throws why there was no storage; the value is destroyed then
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-try-create
    pub func TryCreate(allocator: Allocator, value: T) -> Self throws AllocError {
        let storage = try allocator.Allocate(Layout::ForValue<SharedBlock<T>>());
        // Safety: `storage` was just allocated with the layout of a `SharedBlock<T>`, so it is aligned and large enough
        // for one, and nothing else holds it or has written to it.
        let block = unsafe { storage as *var SharedBlock<T> };
        // Safety: as above, `block` addresses fresh storage for one block with nothing in it to overwrite.
        unsafe { *block = SharedBlock<T> { count: 1, value: move value }; }
        return Self { block, allocator };
    }

    /// The shared value, borrowed for reading.
    /// `self` stays borrowed while the reference is in use, so this handle, and with it the value, outlives it.
    /// @returns a reference to the value
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-get
    pub func Get(&self) -> &T {
        // Safety: the handle invariant: a live handle's `block` is the shared block, which lives while any handle does.
        unsafe { return self.block.value; }
    }

    /// The value borrowed for writing, while this is the only handle to it.
    /// `self` stays borrowed exclusively while the reference is in use, so no other handle can be made from it.
    /// @returns a writable reference to the value, or `none` while other handles share it
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-get-mutable
    pub func GetMutable(&var self) -> &var T? {
        // Safety: the handle invariant: a live handle's `block` is the shared block, which lives while any handle does.
        if unsafe { self.block.count } != 1 { return none; }
        // Safety: the handle invariant: a live handle's `block` is the shared block, which lives while any handle does.
        unsafe { return self.block.value; }
    }

    /// How many handles share the value.
    /// @returns the count
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-count
    pub func Count(&self) -> uint {
        // Safety: the handle invariant: a live handle's `block` is the shared block, which lives while any handle does.
        return unsafe { self.block.count };
    }

    /// Whether `other` shares the same value, rather than an equal one.
    /// @param other the other handle
    /// @returns whether both point at one value
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-same-as
    pub func SameAs(&self, other: &Self) -> bool {
        return self.block == other.block;
    }

    func ~Rc(&var self) {
        let block = self.block;
        if block == null { return; }
        self.block = null;
        // Safety: `block` is the shared block this handle counted in, not null as checked above, and an `Rc` stays on
        // one thread, so the plain decrement races with nothing.
        let remaining = unsafe {
            block.count = block.count - 1;
            block.count
        };
        if remaining != 0 { return; }
        // Safety: this was the last handle, so nothing else reaches `block.value`, which is destroyed only here.
        unsafe { DestroySharedValue<T>(@block.value); }
        try self.allocator.Deallocate(block as *var opaque, Layout::ForValue<SharedBlock<T>>()) catch { _ => {} };
    }
}

extend Rc<T> : Cloneable {
    /// Another handle to the same value, adding one to the count.
    /// Borrows this handle and allocates nothing; the value lives until the last handle is destroyed.
    /// @returns a new handle sharing the value
    /// @see https://rux-lang.dev/docs/api/allocator/shared#rc-clone
    pub func Clone(&self) -> Self {
        // Safety: a non-null `block` is the live shared block, and an `Rc` stays on one thread, so the plain increment
        // races with nothing.
        if self.block != null { unsafe { self.block.count = self.block.count + 1; } }
        return Self { block: self.block, allocator: self.allocator };
    }
}

/// A shared, counted handle to one value whose handles may live on different threads. A handle is move-only; `Clone`
/// makes another handle to the same value, and the count is kept with atomic operations.
/// The value is only read through it, so a value that changes while shared needs its own synchronization, such as a
/// `Sync::Mutex`.
/// @typeParam T the value's type
/// @see https://rux-lang.dev/docs/api/allocator/shared#arc
pub struct Arc<T> {
    block: *var SharedBlock<T>;
    allocator: Allocator;
}

extend Arc<T> {
    /// The first handle to `value`, moved onto the heap.
    /// Terminates the program when the allocator refuses; `TryCreate` reports the refusal instead.
    /// @param allocator where the storage comes from, which must be usable from every thread a handle reaches
    /// @param value the value to share
    /// @returns the handle
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-create
    pub func Create(allocator: Allocator, value: T) -> Self {
        return try Arc::TryCreate<T>(allocator, move value) catch { error => AllocationFailed(error) };
    }

    /// The first handle to `value`, moved onto the heap, or why there was no storage.
    /// @param allocator where the storage comes from, which must be usable from every thread a handle reaches
    /// @param value the value to share
    /// @returns the handle, or throws why there was no storage; the value is destroyed then
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-try-create
    pub func TryCreate(allocator: Allocator, value: T) -> Self throws AllocError {
        let storage = try allocator.Allocate(Layout::ForValue<SharedBlock<T>>());
        // Safety: `storage` was just allocated with the layout of a `SharedBlock<T>`, so it is aligned and large enough
        // for one, and nothing else holds it or has written to it.
        let block = unsafe { storage as *var SharedBlock<T> };
        // Safety: as above, `block` addresses fresh storage for one block with nothing in it to overwrite.
        unsafe { *block = SharedBlock<T> { count: 1, value: move value }; }
        return Self { block, allocator };
    }

    /// The shared value, borrowed for reading.
    /// `self` stays borrowed while the reference is in use, so this handle, and with it the value, outlives it.
    /// @returns a reference to the value
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-get
    pub func Get(&self) -> &T {
        // Safety: the handle invariant: a live handle's `block` is the shared block, which lives while any handle does.
        unsafe { return self.block.value; }
    }

    /// The value borrowed for writing, while this is the only handle to it.
    /// `self` stays borrowed exclusively while the reference is in use, so no other handle can be made from it.
    /// @returns a writable reference to the value, or `none` while other handles share it
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-get-mutable
    pub func GetMutable(&var self) -> &var T? {
        // Safety: the handle invariant: a live handle's `block` is the shared block, which lives while any handle does;
        // its count is aligned and only ever reached atomically.
        if unsafe { AtomicLoad<uint>(@self.block.count, MemoryOrder::Acquire) } != 1 { return none; }
        // Safety: the handle invariant: a live handle's `block` is the shared block, which lives while any handle does.
        unsafe { return self.block.value; }
    }

    /// How many handles share the value, at some moment while this one existed; another thread may change it.
    /// @returns the count
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-count
    pub func Count(&self) -> uint {
        // Safety: the handle invariant: a live handle's `block` is the shared block, which lives while any handle does;
        // its count is aligned and only ever reached atomically.
        return unsafe { AtomicLoad<uint>(@self.block.count, MemoryOrder::Relaxed) };
    }

    /// Whether `other` shares the same value, rather than an equal one.
    /// @param other the other handle
    /// @returns whether both point at one value
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-same-as
    pub func SameAs(&self, other: &Self) -> bool {
        return self.block == other.block;
    }

    func ~Arc(&var self) {
        let block = self.block;
        if block == null { return; }
        self.block = null;
        // Releasing: every write this thread made to the value happens before the last handle destroys it.
        // Safety: `block` is the shared block this handle counted in, not null as checked above; its count is aligned
        // and only ever reached atomically.
        if unsafe { AtomicFetchSub<uint>(@block.count, 1, MemoryOrder::Release) } != 1 { return; }
        Fence(MemoryOrder::Acquire);
        // Safety: this was the last handle, so nothing else reaches `block.value`, which is destroyed only here.
        unsafe { DestroySharedValue<T>(@block.value); }
        try self.allocator.Deallocate(block as *var opaque, Layout::ForValue<SharedBlock<T>>()) catch { _ => {} };
    }
}

extend Arc<T> : Cloneable {
    /// Another handle to the same value, adding one to the count atomically.
    /// Borrows this handle and allocates nothing; the new handle may move to another thread, and the value lives
    /// until the last handle on any thread is destroyed.
    /// @returns a new handle sharing the value
    /// @see https://rux-lang.dev/docs/api/allocator/shared#arc-clone
    pub func Clone(&self) -> Self {
        // Safety: a non-null `block` is the live shared block, whose count is aligned and only ever reached
        // atomically.
        if self.block != null { unsafe { AtomicFetchAdd<uint>(@self.block.count, 1, MemoryOrder::Relaxed); } }
        return Self { block: self.block, allocator: self.allocator };
    }
}
