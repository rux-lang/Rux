// A growable run of plain values, owned through an allocator: the units of a command line, the bytes a child wrote.
// Only plain values — units, bytes, addresses — go in one, so growing it copies bytes and destroying it only gives
// the storage back.

import Allocator::{ Allocator, Layout };
import Io::{ IoError, IoErrorKind };
import Memory::Copy;

struct Buffer<T> {
    data: *var T;
    length: uint;
    capacity: uint;
    allocator: Allocator;
}

extend Buffer<T> {
    func Buffer(allocator: Allocator) -> Self {
        return Self { data: null, length: 0, capacity: 0, allocator };
    }

    // Makes room for `extra` more values, reporting an allocation the allocator refused.
    func Reserve(&var self, extra: uint) -> ! IoError {
        if self.length + extra <= self.capacity { return; }
        var capacity = if self.capacity == 0 { 16u } else { self.capacity * 2u };
        while capacity < self.length + extra {
            capacity = capacity * 2u;
        }
        let wanted = Layout::ForArray<T>(capacity);
        if wanted == none { fail IoError::Of(IoErrorKind::LimitExceeded); }
        var allocator = self.allocator;
        let block = allocator.Allocate(wanted ?? Layout::ForValue<T>()) catch {
            _ => fail IoError::Of(IoErrorKind::LimitExceeded)
        };
        if self.data != null {
            // Safety: `block` has room for `capacity` values, more than `length`, and `self.data` holds `length`
            // values in a separate allocation.
            unsafe { Copy(block, self.data as *opaque, self.length * sizeof(T)); }
            allocator.Deallocate(self.data as *var opaque, Layout::ForArray<T>(self.capacity) ?? Layout::ForValue<T>())
                catch { _ => {} };
        }
        // Safety: `block` comes from the allocator with the layout of `capacity` values of `T`.
        self.data = unsafe { block as *var T };
        self.capacity = capacity;
    }

    func Push(&var self, value: T) -> ! IoError {
        self.Reserve(1)?;
        // Safety: `Reserve` made room for one value past `length` in `self.data`.
        unsafe { self.data[self.length] = value; }
        self.length = self.length + 1;
    }

    func PushAll(&var self, values: T[..]) -> ! IoError {
        self.Reserve(values.length)?;
        var index: uint = 0;
        while index < values.length {
            // Safety: `Reserve` made room for `values.length` values past `length`, and `index` is below that.
            unsafe { self.data[self.length + index] = values[index]; }
            index = index + 1;
        }
        self.length = self.length + values.length;
    }

    func View(&self) -> T[..] {
        // Safety: an empty range reads nothing, even from a null `data`.
        if self.length == 0 { return unsafe { self.data[..0] }; }
        // Safety: `self.data` holds `length` values written by `Push` and `PushAll`.
        return unsafe { self.data[..self.length] };
    }

    func Clear(&var self) {
        self.length = 0;
    }

    func ~Buffer(&var self) {
        if self.data == null { return; }
        var allocator = self.allocator;
        allocator.Deallocate(self.data as *var opaque, Layout::ForArray<T>(self.capacity) ?? Layout::ForValue<T>())
            catch { _ => {} };
        self.data = null;
    }
}
