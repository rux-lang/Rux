// Streams over memory: a reader of bytes the caller already has, and a writer that gathers what is written into a
// growing block of its own.
// They are what `Reader` and `Writer` code is tested against, and what turns a function that writes to a stream into
// one that produces bytes in memory. Both seek, within what they hold.

import Allocator::{ Allocator, Layout };
import Memory::Copy;

/// A reader of a slice of bytes, from its start. `Copy`.
/// Borrows the bytes, which must outlive it.
/// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-reader
pub struct ByteReader {
    bytes: char8[..];
    position: uint;
}

extend ByteReader {
    /// A reader of `bytes`, at their start.
    /// @param bytes the bytes to read, which must outlive the reader
    /// @returns the reader
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-reader-new
    pub func New(bytes: char8[..]) -> Self {
        return Self { bytes, position: 0 };
    }

    /// How many bytes have been read or skipped.
    /// @returns the position
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-reader-position
    pub func Position(&self) -> uint {
        return self.position;
    }

    /// The bytes not yet read.
    /// @returns them
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-reader-remaining
    pub func Remaining(&self) -> char8[..] {
        return self.bytes[self.position..self.bytes.length];
    }
}

extend ByteReader : Reader {
    /// Copies the next bytes into `into`, as many as fit.
    /// @param into where the bytes go
    /// @returns how many were copied, or fails with `EndOfStream` once every byte has been read
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-reader-read
    pub func Read(&var self, into: var char8[..]) -> uint throws IoError {
        if into.length == 0 { return 0; }
        let left = self.bytes.length - self.position;
        if left == 0 { throw IoError::Of(IoErrorKind::EndOfStream); }
        let count = if left < into.length { left } else { into.length };
        // Safety: `count` is at most both `into.length` and the `left` bytes from `position`, and the caller's
        // slice is not the bytes being read.
        unsafe { Copy(into.data as *var opaque, @self.bytes[self.position] as *opaque, count); }
        self.position = self.position + count;
        return count;
    }
}

// Where a seek from `origin` by `offset` lands in a stream of `length` bytes at `position`, or none when it would be
// before the start or past the end.
func SeekTarget(origin: SeekFrom, offset: int64, position: uint, length: uint) -> uint? {
    var base: int64 = 0;
    match origin {
        SeekFrom::Start => base = 0,
        SeekFrom::Current => base = position as int64,
        SeekFrom::End => base = length as int64
    }
    let target = base + offset;
    if target < 0 || target > length as int64 { return none; }
    return target as uint;
}

extend ByteReader : Seeker {
    /// Moves the position, anywhere from the start to the end of the bytes.
    /// @param origin what `offset` counts from
    /// @param offset how far, which may be negative
    /// @returns the new position, or fails with `InvalidInput` for one before the start or past the end
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-reader-seek
    pub func Seek(&var self, origin: SeekFrom, offset: int64) -> uint64 throws IoError {
        let target = SeekTarget(origin, offset, self.position, self.bytes.length) ??
                     throw IoError::Of(IoErrorKind::InvalidInput);
        self.position = target;
        return target as uint64;
    }
}

/// A writer that keeps what is written in a growing block of memory. Not copied.
/// Writing at a position before the end, after a seek, overwrites what is there and extends past it.
/// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-writer
pub struct ByteWriter {
    allocator: Allocator;
    data: *var char8;
    length: uint;
    capacity: uint;
    position: uint;
}

extend ByteWriter {
    /// An empty writer that takes its storage from `allocator` as it grows.
    /// @param allocator where the storage comes from
    /// @returns the writer
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-writer-new
    pub func New(allocator: Allocator) -> Self {
        return Self { allocator, data: null, length: 0, capacity: 0, position: 0 };
    }

    /// Everything written so far. The view lasts until the next write, `Clear` or `Release`.
    /// @returns the bytes
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-writer-bytes
    pub func Bytes(&self) -> char8[..] {
        if self.data == null { return ""; }
        // Safety: `data` is non-null, checked above, and holds `capacity` bytes, of which `length` are written.
        return unsafe { self.data[..self.length] };
    }

    /// How many bytes have been written.
    /// @returns the length
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-writer-length
    pub func Length(&self) -> uint {
        return self.length;
    }

    /// Forgets what was written, keeping the storage for what comes next.
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-writer-clear
    pub func Clear(&var self) {
        self.length = 0;
        self.position = 0;
    }

    /// Gives the storage back and empties the writer.
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-writer-release
    pub func Release(&var self) {
        if self.data != null {
            var borrowed = self.allocator;
            try borrowed.Deallocate(self.data as *var opaque, Layout { size: self.capacity, alignment: 1 }) catch {
                _ => {}
            };
        }
        self.data = null;
        self.length = 0;
        self.capacity = 0;
        self.position = 0;
    }

    // Makes room for at least `needed` bytes, doubling so that a run of small writes costs linear time.
    func Grow(&var self, needed: uint) throws IoError {
        if needed <= self.capacity { return; }
        var wanted = if self.capacity < 64u { 64u } else { self.capacity };
        while wanted < needed {
            if wanted > 0x7FFFFFFFFFFFFFFFu { throw IoError::Of(IoErrorKind::LimitExceeded); }
            wanted = wanted * 2;
        }
        var borrowed = self.allocator;
        let block = try borrowed.Allocate(Layout { size: wanted, alignment: 1 }) catch {
            _ => throw IoError::Of(IoErrorKind::LimitExceeded)
        };
        if self.data != null {
            // Safety: `block` is a fresh allocation of `wanted` bytes, more than the `length` bytes `data` holds.
            unsafe { Copy(block, self.data as *opaque, self.length); }
            try borrowed.Deallocate(self.data as *var opaque, Layout { size: self.capacity, alignment: 1 }) catch {
                _ => {}
            };
        }
        // Safety: `block` is a fresh allocation of `wanted` bytes at alignment 1, so it holds `wanted` `char8`s.
        self.data = unsafe { block as *var char8 };
        self.capacity = wanted;
    }

    func ~ByteWriter(&var self) {
        self.Release();
    }
}

extend ByteWriter : Writer {
    /// Writes all of `bytes` at the position, growing the storage as needed.
    /// @param bytes the bytes to write
    /// @returns how many were written, which is all of them, or fails with `LimitExceeded` when storage runs out
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-writer-write
    pub func Write(&var self, bytes: char8[..]) -> uint throws IoError {
        if bytes.length == 0 { return 0; }
        let end = self.position + bytes.length;
        try self.Grow(end);
        // Safety: `Grow` made `capacity` at least `end`, so `data` has room from `position` for all of `bytes`,
        // which is the caller's slice rather than this storage.
        unsafe { Copy(@self.data[self.position] as *var opaque, bytes.data as *opaque, bytes.length); }
        self.position = end;
        if end > self.length { self.length = end; }
        return bytes.length;
    }

    /// Does nothing: the bytes are already where they go.
    /// @returns nothing
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-writer-flush
    pub func Flush(&var self) throws IoError {}
}

extend ByteWriter : Seeker {
    /// Moves the position at which the next write lands, anywhere from the start to the end of what was written.
    /// @param origin what `offset` counts from
    /// @param offset how far, which may be negative
    /// @returns the new position, or fails with `InvalidInput` for one before the start or past the end
    /// @see https://rux-lang.dev/docs/api/io/memory-stream#byte-writer-seek
    pub func Seek(&var self, origin: SeekFrom, offset: int64) -> uint64 throws IoError {
        let target = SeekTarget(origin, offset, self.position, self.length) ??
                     throw IoError::Of(IoErrorKind::InvalidInput);
        self.position = target;
        return target as uint64;
    }
}
