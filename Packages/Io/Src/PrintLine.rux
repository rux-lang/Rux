// The line-ending variants: the value, then a newline, with the first failure returned.

import Format::Display;
import Text::{ String, StringView };

/// Writes a newline to standard output.
///
/// https://rux-lang.dev/docs/api/io/print-line
pub func PrintLine() -> IoError {
    return PrintBytes(c8"\n");
}

/// Provides the public `PrintLine` operation.
///
/// https://rux-lang.dev/docs/api/io/print-line
pub func PrintLine(value: String) -> IoError {
    let first = Print(value);
    let second = PrintLine();
    return first.IsError() ? first : second;
}

/// Provides the public `PrintLine` operation.
///
/// https://rux-lang.dev/docs/api/io/print-line
pub func PrintLine(value: Slice<char8>) -> IoError {
    let first = Print(value);
    let second = PrintLine();
    return first.IsError() ? first : second;
}

/// Provides the public `PrintLine` operation.
///
/// https://rux-lang.dev/docs/api/io/print-line
pub func PrintLine(value: string) -> IoError {
    let first = Print(value);
    let second = PrintLine();
    return first.IsError() ? first : second;
}

