// Binary values on a byte stream, with the byte order named rather than assumed.
//
// A file format or a wire protocol fixes its byte order once, in its specification, and every machine that reads
// it honors that choice regardless of its own. So every function here takes the order as an argument: the caller
// names the format's choice, and the code assembles values arithmetically -- shift and or, never a reinterpreted
// memory read -- so the host's own order never enters into it.
//
// One pair of word functions does the actual work at every width, accumulating in the widest integer there is;
// the typed functions are the surface, one per primitive width, so a format description reads as what it stores.
// Floats travel as the IEEE 754 bit patterns of their width, moved between integer and float representation
// without conversion.

import Core::{ MutableSlice, Slice };
import Memory::Copy;

/// A byte order: which end of a multi-byte value comes first.
///
/// https://rux-lang.dev/docs/api/io/endian
pub enum Endian: int32 {
    /// The least significant byte first: x86-64, AArch64, and most formats born on them.
    Little = 0,
    /// The most significant byte first: network order, and the older big machines.
    Big = 1
}

/// Reads a `width`-byte unsigned word in the given order, into the low bytes of `value`.
///
/// The word functions are the one implementation the typed surface below stands on; call those unless the width
/// itself is a runtime quantity.
///
/// https://rux-lang.dev/docs/api/io/read-word
pub func ReadWord(reader: &var Reader, endian: Endian, width: uint, value: *var uint512) -> IoError {
    var bytes: char8[64];
    let outcome = ReadExact(reader, MutableSlice::From<char8>(@bytes[0], width));
    if outcome.IsError() {
        return outcome;
    }
    var word = 0u512;
    var index: uint = 0;
    while index < width {
        // Most significant first into the accumulator, so each step is one shift -- which byte that is
        // is the only place the order matters.
        let at = endian == Endian::Big ? index : width - 1 - index;
        word = (word << 8u512) | ((bytes[at] as uint8) as uint512);
        index = index + 1;
    }
    *value = word;
    return IoError::Ok();
}

/// Writes the low `width` bytes of `value` in the given order.
///
/// https://rux-lang.dev/docs/api/io/write-word
pub func WriteWord(writer: &var Writer, endian: Endian, width: uint, value: uint512) -> IoError {
    var bytes: char8[64];
    var word = value;
    var index: uint = 0;
    while index < width {
        // Least significant out of the accumulator, placed at whichever end the order says it lives.
        let at = endian == Endian::Little ? index : width - 1 - index;
        bytes[at] = ((word & 0xFFu512) as uint8) as char8;
        word = word >> 8u512;
        index = index + 1;
    }
    return WriteAll(writer, bytes[0..width]);
}

/// Reads a `uint8` in the given order.
///
/// https://rux-lang.dev/docs/api/io/read-uint8
pub func ReadUint8(reader: &var Reader, endian: Endian, value: *var uint8) -> IoError {
    var word = 0u512;
    let outcome = ReadWord(reader, endian, 1, @word);
    if outcome.IsError() {
        return outcome;
    }
    *value = word as uint8;
    return IoError::Ok();
}

/// Writes a `uint8` in the given order.
///
/// https://rux-lang.dev/docs/api/io/write-uint8
pub func WriteUint8(writer: &var Writer, endian: Endian, value: uint8) -> IoError {
    return WriteWord(writer, endian, 1, value as uint512);
}

/// Reads an `int8`: the unsigned bytes, reinterpreted in two's complement.
///
/// https://rux-lang.dev/docs/api/io/read-int8
pub func ReadInt8(reader: &var Reader, endian: Endian, value: *var int8) -> IoError {
    var word = 0u8;
    let outcome = ReadUint8(reader, endian, @word);
    if outcome.IsError() {
        return outcome;
    }
    *value = word as int8;
    return IoError::Ok();
}

/// Writes an `int8`: its two's-complement bytes, unchanged.
///
/// https://rux-lang.dev/docs/api/io/write-int8
pub func WriteInt8(writer: &var Writer, endian: Endian, value: int8) -> IoError {
    return WriteUint8(writer, endian, value as uint8);
}

