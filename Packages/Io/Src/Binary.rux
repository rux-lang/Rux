pub func ReadUint512(reader: &var Reader, endian: Endian, value: *var uint512) -> IoError {
    var word = 0u512;
    let outcome = ReadWord(reader, endian, 64, @word);
    if outcome.IsError() {
        return outcome;
    }
    *value = word as uint512;
    return IoError::Ok();
}

/// Writes a `uint512` in the given order.
