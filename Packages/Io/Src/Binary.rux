}

/// Reads a `float32` as the IEEE 754 bit pattern of its width.
///
/// @param reader where the bytes come from
/// @param endian which byte order the value is stored in
/// @returns the value read; `IsEnd` when the stream ended first
/// @see https://rux-lang.dev/docs/api/io/read-float32
pub func ReadFloat32(reader: &var Reader, endian: Endian) -> float32 ! IoError {
    var bits = ReadUint32(reader, endian)?;
    var value = 0.0f32;
    Copy(@value as *var opaque, @bits as *opaque, 4);
    return value;
}

/// Writes a `float32` as the IEEE 754 bit pattern of its width.
///
/// @param writer the destination
/// @param endian which byte order the value is stored in
/// @param value the value to write
/// @returns success when the whole value was written
/// @see https://rux-lang.dev/docs/api/io/write-float32
pub func WriteFloat32(writer: &var Writer, endian: Endian, value: float32) -> ! IoError {
    var bits: uint32 = 0;
    var held = value;
    Copy(@bits as *var opaque, @held as *opaque, 4);
    return WriteUint32(writer, endian, bits);
}

/// Reads a `float64` as the IEEE 754 bit pattern of its width.
///
/// @param reader where the bytes come from
/// @param endian which byte order the value is stored in
/// @returns the value read; `IsEnd` when the stream ended first
/// @see https://rux-lang.dev/docs/api/io/read-float64
pub func ReadFloat64(reader: &var Reader, endian: Endian) -> float64 ! IoError {
    var bits = ReadUint64(reader, endian)?;
    var value = 0.0f64;
    Copy(@value as *var opaque, @bits as *opaque, 8);
    return value;
}

/// Writes a `float64` as the IEEE 754 bit pattern of its width.
///
/// @param writer the destination
/// @param endian which byte order the value is stored in
/// @param value the value to write
/// @returns success when the whole value was written
/// @see https://rux-lang.dev/docs/api/io/write-float64
pub func WriteFloat64(writer: &var Writer, endian: Endian, value: float64) -> ! IoError {
    var bits: uint64 = 0;
    var held = value;
    Copy(@bits as *var opaque, @held as *opaque, 8);
    return WriteUint64(writer, endian, bits);
}
