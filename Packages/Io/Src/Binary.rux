}

/// Reads a `float32` as the IEEE 754 bit pattern of its width.
///
/// https://rux-lang.dev/docs/api/io/read-float32
pub func ReadFloat32(reader: &var Reader, endian: Endian, value: *var float32) -> IoError {
    var bits = 0u32;
    let outcome = ReadUint32(reader, endian, @bits);
    if outcome.IsError() {
        return outcome;
    }
    Copy(value as *var opaque, @bits as *opaque, 4);
    return IoError::Ok();
}

/// Writes a `float32` as the IEEE 754 bit pattern of its width.
///
/// https://rux-lang.dev/docs/api/io/write-float32
pub func WriteFloat32(writer: &var Writer, endian: Endian, value: float32) -> IoError {
    var bits = 0u32;
    var held = value;
    Copy(@bits as *var opaque, @held as *opaque, 4);
    return WriteUint32(writer, endian, bits);
}

/// Reads a `float64` as the IEEE 754 bit pattern of its width.
///
/// https://rux-lang.dev/docs/api/io/read-float64
pub func ReadFloat64(reader: &var Reader, endian: Endian, value: *var float64) -> IoError {
    var bits = 0u64;
    let outcome = ReadUint64(reader, endian, @bits);
    if outcome.IsError() {
        return outcome;
    }
    Copy(value as *var opaque, @bits as *opaque, 8);
    return IoError::Ok();
}

/// Writes a `float64` as the IEEE 754 bit pattern of its width.
///
/// https://rux-lang.dev/docs/api/io/write-float64
pub func WriteFloat64(writer: &var Writer, endian: Endian, value: float64) -> IoError {
    var bits = 0u64;
    var held = value;
    Copy(@bits as *var opaque, @held as *opaque, 8);
    return WriteUint64(writer, endian, bits);
}
