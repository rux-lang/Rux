import Format::{ Display, FormatSpec, WriteFormat, TextWriter };
import Memory::{ Alloc, Free };
import Core::{ #target };
import Text::{ String, StringView, TextError };

when #target.os {
    .FreeBSD => import FreeBSD::{ StdOut, Write },
    .Linux => import Linux::{ StdOut, Write },
    .macOS => import macOS::{ StdOut, Write },
    .Windows => import Windows::{
        CodePage,
        GetConsoleMode,
        GetStdHandle,
        MultiByteToWideChar,
        StdOutputHandle,
        WriteConsoleW,
        WriteFile
    }
}

when #target.os == .Windows {
    // Write raw bytes to a redirected stdout (a file or pipe), where the UTF-8
    // encoding of `data` is already exactly what should land on disk.
    func WriteBytes(handle: *opaque, data: *char8, length: uint) {
        const MaxWriteLength: uint = 4096;
        var offset: uint = 0;
        while offset < length {
            var written: uint32 = 0;
            let remaining = length - offset;
            let count = remaining > MaxWriteLength ? MaxWriteLength : remaining;
            let ok = WriteFile(
                handle,
                (data + offset) as *opaque,
                count as uint32,
                @written,
                null
            );
            if !ok || written == 0 { return; }
            offset += written as uint;
        }
    }

    // Write UTF-16 code units to a console. WriteConsoleW hands the characters
    // to the console as Unicode, so they render correctly no matter what the
    // console's output code page is.
    func WriteWide(handle: *opaque, data: *char16, length: uint) {
        var offset: uint = 0;
        while offset < length {
            var written: uint32 = 0;
            let ok = WriteConsoleW(
                handle,
                data + offset,
                (length - offset) as uint32,
                @written,
                null
            );
            if !ok || written == 0 { return; }
            offset += written as uint;
        }
    }
}

func Print(data: *char8, length: uint) {
    if length == 0 { return; }

    when #target.os == .Windows {
        let handle = GetStdHandle(StdOutputHandle);
        // Only a console needs the UTF-16 path. GetConsoleMode succeeds for a
        // console handle and fails when stdout is redirected to a file or pipe,
        // where the raw UTF-8 bytes are the correct output. Writing UTF-8 bytes
        // to a console would instead be decoded with its code page and turn any
        // non-ASCII text (such as "Привіт світ!") into mojibake.
        var mode: uint32 = 0;
        if !GetConsoleMode(handle, @mode) {
            WriteBytes(handle, data, length);
            return;
        }
        // A UTF-8 sequence never expands to more UTF-16 code units than it has
        // bytes, so `length` units is a safe upper bound for the buffer.
        let wide = Alloc(length * 2) as *char16;
        if wide == null {
            WriteBytes(handle, data, length);
            return;
        }
        let wideLength = MultiByteToWideChar(CodePage::Utf8 as uint32,
            0, data, length as int32, wide, length as int32);
        if wideLength > 0 {
            WriteWide(handle, wide, wideLength as uint);
        }
        Free(wide as *opaque);
    } else {
        var offset: uint = 0;
        while offset < length {
            let written = Write(
                StdOut,
                (data + offset) as *opaque,
                length - offset
            );
            // EINTR means no bytes were written and the operation can be
            // retried without advancing the buffer.
            if written == -4 { continue; }
            if written <= 0 { return; }
            offset += written as uint;
        }
    }
}

/// A writer that sends its bytes to standard output.
///
/// Holds nothing, because standard output is not a thing this package owns: every write goes to the same place
/// however many writers there are. It is still a `TextWriter` rather than a free function, so that anything formatting
/// into a builder can format into the console instead without knowing the difference.
///
/// https://rux-lang.dev/docs/api/io/console-writer
struct ConsoleWriter {
    /// Nothing. The console is where it is.
    reserved: uint8;
}

extend ConsoleWriter {
    /// A writer over standard output.
    ///
    /// https://rux-lang.dev/docs/api/io/console-writer/new
    func New() -> ConsoleWriter {
        return ConsoleWriter { reserved: 0 };
    }
}

extend ConsoleWriter : TextWriter {
    /// Writes `bytes` to standard output.
    ///
    /// Reports `None` whatever the console did: a write to a closed or full stream is not something a caller
    /// formatting a number can do anything about, and the alternative is every `Print` in a program returning a
    /// value nobody reads.
    ///
    /// https://rux-lang.dev/docs/api/io/console-writer/write
    func Write(self: *var ConsoleWriter, bytes: Slice<char8>) -> TextError {
        Print(bytes.data, bytes.length);
        return TextError::None;
    }
}

/// Writes a value's text to standard output.
///
/// Nothing is allocated: the value writes itself straight to the console, where it used to be rendered into a
/// string first and the string thrown away.
///
/// https://rux-lang.dev/docs/api/io/print-value
func PrintValue(value: Display) {
    let writer: TextWriter = ConsoleWriter::New();
    value.Format(writer, FormatSpec::Plain());
}

/// Writes a value's text to standard output, then a newline.
///
/// https://rux-lang.dev/docs/api/io/print-value-line
func PrintValueLine(value: Display) {
    PrintValue(value);
    PrintLine();
}

func Print(value: String) {
    Print(value.data, value.length);
}

func Print(value: StringView) {
    let bytes = value.Bytes();
    Print(bytes.data, bytes.length);
}

func Print(value: Slice<char8>) {
    Print(value.data, value.length);
}

/// Writes `format` to standard output with each `{}` replaced by the next argument.
///
/// Allocates nothing: the arguments write themselves to the console as they are reached.
///
/// https://rux-lang.dev/docs/api/io/print-format
func Print(format: Slice<char8>, args: Display...) {
    let writer: TextWriter = ConsoleWriter::New();
    WriteFormat(writer, format, args...);
}

func Print(value: bool8) {
    let shown: Display = value;
    PrintValue(shown);
}

func Print(value: bool16) {
    let shown: Display = value;
    PrintValue(shown);
}

func Print(value: bool32) {
    let shown: Display = value;
    PrintValue(shown);
}

func Print(value: char8) {
    let shown: Display = value;
    PrintValue(shown);
}

func Print(value: char16) {
    let shown: Display = value;
    PrintValue(shown);
}

func Print(value: char32) {
