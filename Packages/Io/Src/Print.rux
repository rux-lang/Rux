
// Printing, with the failure a caller can act on returned rather than swallowed.
//
// Every overload returns the `IoError` of the write it made. Most call sites will keep ignoring it, and that is
// now their decision rather than this module's: a program logging to a terminal loses nothing by not looking,
// while one whose output feeds a closed pipe finally has something to look at. The bytes go through the standard
// output handle, so the console-versus-redirection encoding is decided where it always is, not re-decided here.

import Core::{ Result, Unit };
import Format::WriteFormat;
import Text::{ Display, FormatError, FormatOk, FormatSpec, String, StringView, TextWriter };

// The one write under everything here.
func PrintBytes(bytes: char8[..]) -> IoError {
    var out = StandardOut::Acquire();
    return WriteAll(out, bytes);
}

/// A `TextWriter` over standard output that records the stream's failure where the caller can see it.
///
/// The protocol has one case for a destination failing, `WriterFailure`, and deliberately no room for the details:
/// Text has no vocabulary for a broken pipe and does not pretend to. So this adapter keeps both halves. It reports
/// `WriterFailure` to the formatter, which stops the write, and records the original `IoError` in the slot it was
/// built over, which is what the caller reads afterwards. Nothing about the stream failure is lost, and nothing
/// about it leaks into a package that could not interpret it.
///
/// # Safety
/// The slot must outlive the writer. It is a stored address, so nothing here tracks that.
///
/// @see https://rux-lang.dev/docs/api/io/console-writer
pub struct ConsoleWriter {
    /// Where the first stream failure is recorded.
    failure: *var IoError;
}

extend ConsoleWriter {
    /// A writer over standard output, recording into `failure`.
    ///
    /// https://rux-lang.dev/docs/api/io/console-writer/new
    pub func ConsoleWriter(failure: *var IoError) -> ConsoleWriter {
        return ConsoleWriter { failure: failure };
    }

}

extend ConsoleWriter : TextWriter {
    /// Writes `bytes` to standard output.
    ///
    /// # Failures
    /// Reports `WriterFailure` when the stream refuses, having recorded the original `IoError` in the slot. Once a
    /// failure has been recorded every later write is refused without touching the stream, so a value that is
    /// part-way through rendering does not go on writing into a handle that has already failed, and a trailing
    /// newline is not emitted after a failed line. This is the only case this writer can produce: the bytes are not
    /// revalidated, and standard output is not a bounded destination.
    ///
    /// @param bytes the UTF-8 run to write
    /// @returns success when the stream accepted the whole run
    /// @see https://rux-lang.dev/docs/api/io/console-writer/write
    pub func Write(self: &var ConsoleWriter, bytes: char8[..]) -> Result<Unit, FormatError> {
        if (*self.failure).IsError() {
            return Result::Error<Unit, FormatError>(FormatError::WriterFailure);
        }
        let outcome = PrintBytes(bytes);
        if outcome.IsError() {
            *self.failure = outcome;
            return Result::Error<Unit, FormatError>(FormatError::WriterFailure);
        }
        return FormatOk();
    }
}

// A formatting failure on a healthy stream, carried in the one error type this surface returns. A stream failure
// never reaches here: the adapter records it in the slot, which is checked first, so anything left is a fault of
// the request or the value rather than of the destination.
func OfFormatFailure() -> IoError {
    return IoError { kind: IoErrorKind::InvalidText, raw: 0i32 };
}

/// Writes a value's text to standard output.
///
/// Nothing is allocated: the value writes itself straight to the stream. A stream failure is returned; a
/// formatting failure on a healthy stream comes back as `InvalidText` with the `TextError` in `raw`.
///
/// https://rux-lang.dev/docs/api/io/print-value
pub func PrintValue(value: Display) -> IoError {
    var failure = IoError::Ok();
    var sink = ConsoleWriter(@failure);
    let writer: &var TextWriter = sink;
    let formatted = value.WriteDisplay(writer, FormatSpec::Plain());
    if failure.IsError() { return failure; }
    if formatted.IsError() { return OfFormatFailure(); }
    return IoError::Ok();
}

/// Writes a value's text to standard output, then a newline.
///
/// https://rux-lang.dev/docs/api/io/print-value-line
pub func PrintValueLine(value: Display) -> IoError {
    let first = PrintValue(value);
    let second = PrintLine();
    return first.IsError() ? first : second;
}

/// Writes a string to standard output.
///
/// https://rux-lang.dev/docs/api/io/print
pub func Print(value: String) -> IoError {
    return PrintBytes((value.data)[..value.length]);
}

/// Provides the public `Print` operation.
///
/// https://rux-lang.dev/docs/api/io/print
pub func Print(value: StringView) -> IoError {
    return PrintBytes(value.Bytes());
}

/// Writes text to standard output.
///
/// https://rux-lang.dev/docs/api/io/print
pub func Print(value: char8[..]) -> IoError {
    return PrintBytes(value);
}

/// Writes `format` to standard output with each `{}` replaced by the next argument.
///
/// Allocates nothing: the arguments write themselves to the stream as they are reached. Failures report as
/// `PrintValue`'s do.
///
/// https://rux-lang.dev/docs/api/io/print-format
pub func Print(format: char8[..], args: Display...) -> IoError {
    var failure = IoError::Ok();
    var sink = ConsoleWriter(@failure);
    let writer: &var TextWriter = sink;
    let formatted = WriteFormat(writer, format, args...);
    if failure.IsError() { return failure; }
    if formatted.IsError() { return OfFormatFailure(); }
    return IoError::Ok();
}

/// Provides the public `Print` operation.
///
/// https://rux-lang.dev/docs/api/io/print
pub func Print(value: bool8) -> IoError {
    let shown: Display = value;
    return PrintValue(shown);
}

