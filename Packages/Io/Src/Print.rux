// Printing, with the failure a caller can act on returned rather than swallowed.
//
// Every overload returns the `IoError` of the write it made, or `none` when there was nothing to report. Most call
// sites will keep ignoring it, and that is their decision rather than this module's: a program logging to a terminal
// loses nothing by not looking, while one whose output feeds a closed pipe has something to look at. That is why the
// result is an optional failure rather than a fallible, which a statement could not leave unread. The bytes go
// through the standard output handle, so the console-versus-redirection encoding is decided where it always is, not
// re-decided here.

import Format::WriteFormat;
import Text::{ Display, FormatError, FormatSpec, String, StringView, TextWriter };

// The one write under everything here.
func PrintBytes(bytes: char8[..]) -> ! IoError {
    var out = StandardOut::Acquire();
    return WriteAll(out, bytes);
}

// The failure a write reported, as the optional every printing call returns.
func FailureOf(outcome: ! IoError) -> IoError? {
    outcome catch { error => return error };
    return none;
}

// What one printing call reports, given the slot the adapter recorded into and what the formatter said.
//
// The slot is read first, because a stream failure is the more specific answer: the formatter saw `WriterFailure`
// and can say nothing about what a broken pipe was, while the slot holds the failure itself. Only once the stream
// is known to be healthy is the formatter's own failure worth translating, and by then it can only be a fault of
// the request or of the value.
func Reported(failure: IoError?, formatted: ! FormatError) -> IoError? {
    if failure is IoError { return failure; }
    formatted catch { reason => return ToIoError(reason) };
    return none;
}

/// Writes a value's text to standard output.
///
/// Nothing is allocated: the value writes itself straight to the stream.
///
/// The value arrives as an interface value, which copies it — or takes it, for a type that prohibits copying.
/// `WriteValueLine` is the borrowing form, and takes any destination, so a value that must not be given up goes
/// through a `ConsoleWriter` and that instead.
///
/// # Failures
/// A stream failure is returned as the stream reported it. A formatting failure on a healthy stream is translated
/// by `ToIoError`, so a request that was wrong arrives as `InvalidInput` and stays distinguishable from anything
/// the destination did. Which formatting failure it was does not survive that translation, since `IoError` has no
/// room for one; a caller who needs it builds a `ConsoleWriter` and calls `Text::WriteValue` themselves.
///
/// @param value the value to write
/// @returns what the stream reported, or the translated formatting failure on a healthy stream, or `none`
/// @see https://rux-lang.dev/docs/api/io/print-value
pub func PrintValue(value: Display) -> IoError? {
    var failure: IoError? = none;
    var sink = ConsoleWriter(@failure);
    let writer: &var TextWriter = sink;
    let formatted = value.WriteDisplay(writer, FormatSpec::Plain());
    return Reported(failure, formatted);
}

/// Writes a value's text to standard output, then a newline.
///
/// @param value the value to write
/// @returns the failure, or `none` when the whole value was written
/// @see https://rux-lang.dev/docs/api/io/print-value-line
pub func PrintValueLine(value: Display) -> IoError? {
    return Terminate(PrintValue(value));
}

/// Writes a string to standard output.
///
/// @param value the value to write
/// @returns the failure, or `none` when the whole value was written
/// @see https://rux-lang.dev/docs/api/io/print
pub func Print(value: String) -> IoError? {
    return FailureOf(PrintBytes((value.data)[..value.length]));
}

/// Provides the public `Print` operation.
///
/// @param value the value to write
/// @returns the failure, or `none` when the whole value was written
/// @see https://rux-lang.dev/docs/api/io/print
pub func Print(value: StringView) -> IoError? {
    return FailureOf(PrintBytes(value.Bytes()));
}

/// Writes text to standard output.
///
/// @param value the value to write
/// @returns the failure, or `none` when the whole value was written
/// @see https://rux-lang.dev/docs/api/io/print
pub func Print(value: char8[..]) -> IoError? {
    return FailureOf(PrintBytes(value));
}

/// Writes `format` to standard output with each `{}` replaced by the next argument.
///
/// Allocates nothing: the arguments write themselves to the stream as they are reached. Failures report as
/// `PrintValue`'s do.
///
/// @param format the format string, with `{}` for each argument
/// @returns the failure, or `none` when the whole value was written
/// @see https://rux-lang.dev/docs/api/io/print-format
pub func Print(format: char8[..], args: Display...) -> IoError? {
    var failure: IoError? = none;
    var sink = ConsoleWriter(@failure);
    let writer: &var TextWriter = sink;
    let formatted = WriteFormat(writer, format, args...);
    return Reported(failure, formatted);
}

/// Provides the public `Print` operation.
///
/// @param value the value to write
/// @returns the failure, or `none` when the whole value was written
/// @see https://rux-lang.dev/docs/api/io/print
pub func Print(value: bool8) -> IoError? {
    let shown: Display = value;
    return PrintValue(shown);
}

