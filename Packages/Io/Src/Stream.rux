// The three things a stream can be asked, and the helpers every asker shares.
//
// A `Reader` fills what it can of a buffer and says how much; a `Writer` takes what it can and says how much; a
// `Seeker` moves the position. Partial progress is the interfaces' honest unit -- a socket hands over what has
// arrived, a pipe takes what fits -- and the all-or-nothing shapes callers usually want are the shared helpers,
// written once: `ReadExact` and `WriteAll` loop over partial progress, retry the transient reports, and refuse to
// spin on a stream that makes none.
//
// Call-time streams are borrowed as interface references, so concrete readers and writers can be used directly
// without copying their state or manufacturing an adapter. An interface value is still useful when a stream must
// be stored, because references deliberately cannot escape into fields.

import Core::{ MutableSlice, Slice };

/// Somewhere bytes come from.
///
/// https://rux-lang.dev/docs/api/io/reader
interface Reader {
    /// Fills what it can of `into` and reports how much through `filled`.
    ///
    /// Zero with `Ok` does not happen: the end of the stream is `EndOfStream`, so a caller never mistakes silence
    /// for data.
    func Read(into: MutableSlice<char8>, filled: *var uint) -> IoError;
}

/// Somewhere bytes go.
///
/// https://rux-lang.dev/docs/api/io/writer
interface Writer {
    /// Takes what it can of `bytes` and reports how much through `taken`.
    func Write(bytes: Slice<char8>, taken: *var uint) -> IoError;

    /// Pushes whatever is held toward the destination.
    func Flush() -> IoError;
}

/// Where a seek starts counting from.
///
/// https://rux-lang.dev/docs/api/io/seek-from
enum SeekFrom: int32 {
    /// The start of the stream; the offset must not be negative.
    Start = 0,
    /// The current position.
    Current = 1,
    /// The end of the stream.
    End = 2
}

/// A stream whose position can be moved.
///
/// https://rux-lang.dev/docs/api/io/seeker
interface Seeker {
    /// Moves the position `offset` bytes from `origin` and reports where it landed through `position`.
    func Seek(origin: SeekFrom, offset: int64, position: *var uint64) -> IoError;
}

/// How many consecutive zero-progress rounds the looping helpers tolerate before refusing.
///
/// A transient report is retried without counting; this counts only rounds where the stream reported success and
/// moved nothing, which is a stream that will never finish the job.
///
/// https://rux-lang.dev/docs/api/io/zero-progress-limit
const ZeroProgressLimit: uint = 3;

/// Fills all of `into`, looping over partial reads, or says why it could not.
///
/// Transient reports are retried; the end of the stream before the buffer fills is `EndOfStream` with the buffer
/// partly written -- how much is not reported, because a caller who needs the count reads incrementally.
///
/// https://rux-lang.dev/docs/api/io/read-exact
func ReadExact(reader: &var Reader, into: MutableSlice<char8>) -> IoError {
    var at: uint = 0;
    while at < into.length {
        let rest = MutableSlice<char8> { data: @into.data[at], length: into.length - at };
        var filled: uint = 0;
        let outcome = reader.Read(rest, @filled);
        if outcome.IsError() {
            if outcome.IsTransient() {
                continue;
            }
            return outcome;
        }
        if filled == 0 {
            // The contract says a successful read moved something; a reader breaking it must not hang the caller.
            return IoError::Of(IoErrorKind::EndOfStream);
        }
        at = at + filled;
    }
    return IoError::Ok();
}

/// Writes all of `bytes`, looping over partial writes, or says why it could not.
///
/// A writer that accepts nothing while reporting success is refused with `WriteZero` after a few rounds: a loop
/// that spins on it would hang the caller on a stream that will never take the rest.
///
/// https://rux-lang.dev/docs/api/io/write-all
func WriteAll(writer: &var Writer, bytes: Slice<char8>) -> IoError {
    var at: uint = 0;
    var stalled: uint = 0;
    while at < bytes.length {
        let rest = Slice<char8> { data: @bytes.data[at], length: bytes.length - at };
        var taken: uint = 0;
        let outcome = writer.Write(rest, @taken);
        if outcome.IsError() {
            if outcome.IsTransient() {
                continue;
            }
            return outcome;
        }
        if taken == 0 {
            stalled = stalled + 1;
            if stalled >= ZeroProgressLimit {
                return IoError::Of(IoErrorKind::WriteZero);
            }
        }
        else {
            stalled = 0;
            at = at + taken;
        }
    }
    return IoError::Ok();
}
