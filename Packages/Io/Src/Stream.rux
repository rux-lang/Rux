// The three things a stream can be asked, and the helpers every asker shares.
// A `Reader` fills what it can of a buffer and succeeds with how much; a `Writer` takes what it can and succeeds with
// how much; a `Seeker` moves the position and succeeds with where it landed. Partial progress is the interfaces'
// honest unit — a socket hands over what has arrived, a pipe takes what fits — and the all-or-nothing shapes callers
// usually want are the shared helpers, written once: `ReadExact` and `WriteAll` loop over partial progress, retry
// interruptions, hand a would-block back to the caller, and refuse to spin on a stream that makes no progress.
// Call-time streams are borrowed as interface references, so concrete readers and writers can be used directly
// without copying their state or manufacturing an adapter. An interface value is still useful when a stream must
// be stored, because references deliberately cannot escape into fields.



/// Somewhere bytes come from.
/// @see https://rux-lang.dev/docs/api/io/reader
pub interface Reader {
    /// Fills what it can of `into` and succeeds with how much.
    /// An implementation reports the end of the stream as the `EndOfStream` failure. Every reading helper in this
    /// package also takes a success of zero for a non-empty buffer as the end, never as a reason to ask again, so a
    /// reader that ends that way is not looped on. A non-blocking stream with nothing ready fails with `WouldBlock`.
    /// @param into receives the bytes
    /// @returns how many bytes were read, which may be fewer than `into` holds; `IsEnd` at the end of the stream
    /// @see https://rux-lang.dev/docs/api/io/reader#read
    func Read(&var self, into: var char8[..]) -> uint throws IoError;
}

/// Somewhere bytes go.
/// @see https://rux-lang.dev/docs/api/io/writer
pub interface Writer {
    /// Takes what it can of `bytes` and succeeds with how much.
    /// @param bytes the bytes to write
    /// @returns how many bytes were taken, which may be fewer than offered
    /// @see https://rux-lang.dev/docs/api/io/writer#write
    func Write(&var self, bytes: char8[..]) -> uint throws IoError;

    /// Pushes whatever is held toward the destination.
    /// @returns success when everything held reached the destination
    /// @see https://rux-lang.dev/docs/api/io/writer#flush
    func Flush(&var self) throws IoError;
}

/// Where a seek starts counting from.
/// @see https://rux-lang.dev/docs/api/io/seeker#seek-from
pub enum SeekFrom: int32 {
    /// The start of the stream; the offset must not be negative.
    Start = 0,
    /// The current position.
    Current = 1,
    /// The end of the stream.
    End = 2
}

/// A stream whose position can be moved.
/// @see https://rux-lang.dev/docs/api/io/seeker
pub interface Seeker {
    /// Moves the position `offset` bytes from `origin` and succeeds with where it landed.
    /// @param origin where the offset is measured from
    /// @param offset how far to move, which may be negative
    /// @returns the resulting offset from the start
    /// @see https://rux-lang.dev/docs/api/io/seeker#seek
    func Seek(&var self, origin: SeekFrom, offset: int64) -> uint64 throws IoError;
}

/// How many consecutive zero-progress rounds `WriteAll` tolerates before refusing.
/// An interruption is retried without counting; this counts only rounds where the stream reported success and
/// moved nothing, which is a stream that will never finish the job.
/// @see https://rux-lang.dev/docs/api/io/reader#zero-progress-limit
pub const ZeroProgressLimit: uint = 3;

/// Fills all of `into`, looping over partial reads, or says why it could not.
/// Interruptions are retried at once. The end of the stream, reported as `EndOfStream` or as a read of zero bytes,
/// is `EndOfStream` when it comes before the first byte, so a caller reading records stops cleanly between them,
/// and `UnexpectedEnd` once part of `into` has been written. Any other failure, `WouldBlock` included, is returned
/// as itself. After a failure `into` may be partly written and how much is not reported: a caller who needs the
/// count, as one reading a non-blocking stream does, reads incrementally with `Read`.
/// @param reader where the bytes come from
/// @param into receives the bytes
/// @returns success only when `into` was filled; `IsEnd` if the stream ended first, `UnexpectedEnd` if partway
/// @see https://rux-lang.dev/docs/api/io/reader#read-exact
pub func ReadExact(reader: &var Reader, into: var char8[..]) throws IoError {
    var at: uint = 0;
    while at < into.length {
        let rest = into[at..into.length];
        let filled = try reader.Read(rest) catch {
            error if error.IsInterrupted() => continue,
            error if error.IsEnd() => 0,
            error => throw error
        };
        if filled == 0 {
            // The end, however the reader said it. A read of zero is taken as the end rather than asked again, so a
            // reader that never moves anything cannot hang the caller.
            throw IoError::Of(if at == 0 { IoErrorKind::EndOfStream } else { IoErrorKind::UnexpectedEnd });
        }
        at = at + filled;
    }
}

/// Writes all of `bytes`, looping over partial writes, or says why it could not.
/// Interruptions are retried at once. A writer that accepts nothing while reporting success is refused with
/// `WriteZero` after `ZeroProgressLimit` rounds: a loop that spins on it would hang the caller on a stream that will
/// never take the rest. Any other failure, `WouldBlock` included, is returned as itself, with some of `bytes`
/// possibly written and how much not reported: a caller writing to a non-blocking stream writes incrementally with
/// `Write`.
/// @param writer the destination
/// @param bytes the bytes to write
/// @returns success only when every byte was written, looping over short writes
/// @see https://rux-lang.dev/docs/api/io/writer#write-all
pub func WriteAll(writer: &var Writer, bytes: char8[..]) throws IoError {
    var at: uint = 0;
    var stalled: uint = 0;
    while at < bytes.length {
        let rest = bytes[at..bytes.length];
        let taken = try writer.Write(rest) catch {
            error if error.IsInterrupted() => continue,
            error => throw error
        };
        if taken == 0 {
            stalled = stalled + 1;
            if stalled >= ZeroProgressLimit { throw IoError::Of(IoErrorKind::WriteZero); }
        }
        else {
            stalled = 0;
            at = at + taken;
        }
    }
}
