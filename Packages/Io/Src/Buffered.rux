// Buffering: fewer, larger conversations with the machine.
// A system call costs the same for one byte as for four thousand, so a program that reads or writes in small
// pieces pays the call's price per piece. The buffered reader and writer stand between, turning many small
// operations into few large ones — and both step aside for operations already larger than the buffer, where
// copying through it would only add work. They keep interface values because their streams must be stored;
// call-time helpers elsewhere take borrowed interface references instead.
// The close contracts differ, and the difference is the design. A reader abandoned mid-buffer loses nothing
// anybody asked for. A writer abandoned mid-buffer holds bytes the caller believes are written, so its destructor
// flushes — but a destructor has nowhere to report failure, so the flush's outcome is discarded there. The
// explicit `Flush` is where errors are seen, and a caller who cares calls it; the destructor is the safety net,
// not the contract.

import Allocator::{ AllocError, Allocator, Layout };

import Memory::Copy;

/// The room a buffered stream takes when the caller expresses no preference.
/// @see https://rux-lang.dev/docs/api/io/default-buffer-capacity
pub const DefaultBufferCapacity: uint = 8192;

/// A reader that fills a buffer in large reads and serves small ones from it.
/// Move-only: it owns its buffer. The reader it wraps is borrowed through the interface value and must outlive it.
/// @see https://rux-lang.dev/docs/api/io/buffered-reader
pub struct BufferedReader {
    /// Where bytes come from when the buffer runs out.
    source: Reader;
    /// The buffer, or null once it has been given back.
    data: *var char8;
    /// How much the buffer holds.
    capacity: uint;
    /// Where the unread bytes start.
    start: uint;
    /// Where they end.
    end: uint;
    /// Where the buffer came from.
    allocator: Allocator;
}

extend BufferedReader {
    /// Copying a buffered reader would give two owners of its allocation.
    func =(self: &var BufferedReader, other: &BufferedReader);

    /// A buffered reader over `source` with `capacity` bytes of buffer.
    /// @param allocator where the storage comes from
    /// @param source where the bytes come from
    /// @param capacity how many bytes the buffer holds
    /// @returns the buffered stream; `Other` when the allocator refused the buffer
    /// @see https://rux-lang.dev/docs/api/io/buffered-reader/new
    pub func New(allocator: Allocator, source: Reader, capacity: uint) -> BufferedReader ! IoError {
        var reader = BufferedReader {
            source: source,
            data: null,
            capacity: 0,
            start: 0,
            end: 0,
            allocator: allocator
        };
        let wanted = capacity == 0 ? DefaultBufferCapacity : capacity;
        let layout = Layout::New(wanted, 1) ?? Layout { size: wanted, alignment: 1 };
        var borrowed = allocator;
        let block = borrowed.Allocate(layout) catch { else => fail IoError::Of(IoErrorKind::Other) };
        reader.data = block as *var char8;
        reader.capacity = wanted;
        return <-reader;
    }

    /// How many buffered bytes wait unread.
    /// @returns how many bytes are already buffered and can be taken without a read
    /// @see https://rux-lang.dev/docs/api/io/buffered-reader/available
    pub func Available(self: &BufferedReader) -> uint {
        return self.end - self.start;
    }

    /// The unread bytes, borrowed, without consuming them.
    /// What line reading is built from: look, decide, then `Consume` what was used.
    /// @returns the buffered bytes, borrowed and valid until the next fill
    /// @see https://rux-lang.dev/docs/api/io/buffered-reader/buffered
    pub func Buffered(self: &BufferedReader) -> char8[..] {
        return (@self.data[self.start])[..self.end - self.start];
    }

    /// Marks `count` buffered bytes as read.
    /// @param count how many bytes to consume
    /// @see https://rux-lang.dev/docs/api/io/buffered-reader/consume
    pub func Consume(self: &var BufferedReader, count: uint) {
        self.start = self.start + (count <= self.Available() ? count : self.Available());
    }

    /// Refills an empty buffer from the source, retrying interruptions.
    /// Reports what the source reported; `EndOfStream` when the source is done. A source that reports success
    /// while handing over nothing breaks the `Reader` contract, and is reported as the end rather than looped on.
    /// @returns success when at least one byte is buffered; `IsEnd` at the end of the source
    /// @see https://rux-lang.dev/docs/api/io/buffered-reader/fill
    pub func Fill(self: &var BufferedReader) -> ! IoError {
        if self.Available() > 0 { return; }
        if self.data == null { fail IoError::Of(IoErrorKind::Other); }
        self.start = 0;
        self.end = 0;
        while true {
            let filled = self.source.Read((self.data)[..self.capacity]) catch {
                error if error.IsTransient() => continue,
                error => fail error
            };
            if filled == 0 { fail IoError::Of(IoErrorKind::EndOfStream); }
            self.end = filled;
            return;
        }
    }

    /// Fills what it can of `into`: from the buffer while it has bytes, straight from the source for a request
    /// already larger than the whole buffer.
    /// @param into receives the bytes
    /// @returns how many bytes were read; `IsEnd` at the end of input
    /// @see https://rux-lang.dev/docs/api/io/buffered-reader/read
    pub func Read(self: &var BufferedReader, into: var char8[..]) -> uint ! IoError {
        if into.length == 0 { return 0; }
        if self.Available() == 0 && into.length >= self.capacity {
            // The bypass: copying a buffer-sized read through the buffer would be pure overhead.
            while true {
                let filled = self.source.Read(into) catch {
                    error if error.IsTransient() => continue,
                    error => fail error
                };
                if filled == 0 { fail IoError::Of(IoErrorKind::EndOfStream); }
                return filled;
            }
        }
        self.Fill()?;
        var give = self.Available();
        if give > into.length {
            give = into.length;
        }
        Copy(into.data as *var opaque, @self.data[self.start] as *opaque, give);
        self.Consume(give);
        return give;
    }

    /// Gives the buffer back.
    /// @see https://rux-lang.dev/docs/api/io/buffered-reader/release
    pub func Release(self: &var BufferedReader) {
        if self.data != null {
            let layout = Layout::New(self.capacity, 1);
            var borrowed = self.allocator;
            borrowed.Deallocate(self.data as *var opaque, (layout ?? Layout { size: self.capacity, alignment: 1 })) catch { else => {} };
        }
        self.data = null;
        self.capacity = 0;
        self.start = 0;
        self.end = 0;
    }

    /// Gives the buffer back. Unread buffered bytes are abandoned, which loses nothing anybody asked for.
    /// @see https://rux-lang.dev/docs/api/io/buffered-reader/destructor
    func ~BufferedReader(self: &var BufferedReader) {
        self.Release();
    }
}

/// A writer that gathers small writes into a buffer and sends it in one piece.
/// Move-only: it owns its buffer. Its destructor flushes as a safety net and discards the outcome, because a
/// destructor has nowhere to report; the explicit `Flush` is where errors are seen, and the caller who cares
/// calls it before letting go.
/// @see https://rux-lang.dev/docs/api/io/buffered-writer
pub struct BufferedWriter {
    /// Where the gathered bytes go.
    sink: Writer;
    /// The buffer, or null once it has been given back.
    data: *var char8;
    /// How much the buffer holds.
    capacity: uint;
    /// How much of it is gathered.
    length: uint;
    /// Where the buffer came from.
    allocator: Allocator;
}

extend BufferedWriter {
    /// Copying a buffered writer would give two owners of its allocation and duplicate pending output.
    func =(self: &var BufferedWriter, other: &BufferedWriter);

    /// A buffered writer over `sink` with `capacity` bytes of buffer.
    /// @param allocator where the storage comes from
    /// @param sink where the bytes go
    /// @param capacity how many bytes the buffer holds
    /// @returns the buffered stream; `Other` when the allocator refused the buffer
    /// @see https://rux-lang.dev/docs/api/io/buffered-writer/new
    pub func New(allocator: Allocator, sink: Writer, capacity: uint) -> BufferedWriter ! IoError {
        var writer = BufferedWriter { sink: sink, data: null, capacity: 0, length: 0, allocator: allocator };
        let wanted = capacity == 0 ? DefaultBufferCapacity : capacity;
        let layout = Layout::New(wanted, 1) ?? Layout { size: wanted, alignment: 1 };
        var borrowed = allocator;
        let block = borrowed.Allocate(layout) catch { else => fail IoError::Of(IoErrorKind::Other) };
        writer.data = block as *var char8;
        writer.capacity = wanted;
        return <-writer;
    }

    /// How many bytes wait unsent.
    /// @returns how many bytes are written but not yet flushed
    /// @see https://rux-lang.dev/docs/api/io/buffered-writer/pending
    pub func Pending(self: &BufferedWriter) -> uint {
        return self.length;
    }

    /// Sends everything gathered, then asks the sink to flush too.
    /// @returns success when everything buffered reached the sink
    /// @see https://rux-lang.dev/docs/api/io/buffered-writer/flush
    pub func Flush(self: &var BufferedWriter) -> ! IoError {
        self.SendHeld()?;
        return self.sink.Flush();
    }

    // Sends whatever is gathered, so that the bytes written after it keep their order.
    func SendHeld(self: &var BufferedWriter) -> ! IoError {
        if self.length == 0 { return; }
        let held = (self.data)[..self.length];
        WriteAll(self.sink, held)?;
        self.length = 0;
    }

    /// Takes `bytes`: into the buffer while they fit, around it in one piece when they never would.
    /// @param bytes the bytes to write
    /// @returns how many bytes were taken, which is all of them
    /// @see https://rux-lang.dev/docs/api/io/buffered-writer/write
    pub func Write(self: &var BufferedWriter, bytes: char8[..]) -> uint ! IoError {
        if bytes.length == 0 { return 0; }
        if self.data == null || bytes.length >= self.capacity {
            // The bypass, after clearing what order requires: bytes gathered earlier go first.
            self.SendHeld()?;
            WriteAll(self.sink, bytes)?;
            return bytes.length;
        }
        if self.length + bytes.length > self.capacity {
            self.SendHeld()?;
        }
        Copy(@self.data[self.length] as *var opaque, bytes.data as *opaque, bytes.length);
        self.length = self.length + bytes.length;
        return bytes.length;
    }

    /// Gives the buffer back without sending what it holds.
    /// For the caller who has decided the bytes must not go — the one case where losing them is the point.
    /// @see https://rux-lang.dev/docs/api/io/buffered-writer/abandon
    pub func Abandon(self: &var BufferedWriter) {
        if self.data != null {
            let layout = Layout::New(self.capacity, 1);
            let fallback = Layout { size: self.capacity, alignment: 1 };
            var borrowed = self.allocator;
            borrowed.Deallocate(self.data as *var opaque, (layout ?? fallback)) catch { else => {} };
        }
        self.data = null;
        self.capacity = 0;
        self.length = 0;
    }

    /// Flushes as a safety net — the outcome has nowhere to go, so a caller who cares flushed already — then
    /// gives the buffer back.
    /// @see https://rux-lang.dev/docs/api/io/buffered-writer/destructor
    func ~BufferedWriter(self: &var BufferedWriter) {
        self.Flush() catch { else => {} };
        self.Abandon();
    }
}
