// MD5 and SHA-1, kept only for the formats and protocols that will not change.
// **Both are broken and neither should be chosen for anything new.** MD5 collisions can be produced in seconds
// on a laptop, and have been used to forge certificates; SHA-1 collisions were demonstrated in 2017 and cost far
// less now. Neither offers collision resistance, so neither can be used for a signature, a content address, a
// deduplication key, or anything else where two different inputs producing one output is a problem.
// What they remain usable for is reading what already exists: a legacy file format, a protocol handshake that
// cannot be renegotiated, a checksum in a system nobody will update. The names carry `Legacy` so that reaching
// for one is a decision a reader can see, and so that a search for "Sha1" in a codebase finds every place the
// decision was made.
// Neither is a `Digest` implementation, deliberately. A generic function taking any digest should not silently
// accept these, and code that wants one must name it.



// MD5's round constants: the integer parts of the absolute sines of one through sixty-four, scaled.
const Md5Constants: uint32[64] = [
    0xD76AA478, 0xE8C7B756, 0x242070DB, 0xC1BDCEEE,
    0xF57C0FAF, 0x4787C62A, 0xA8304613, 0xFD469501,
    0x698098D8, 0x8B44F7AF, 0xFFFF5BB1, 0x895CD7BE,
    0x6B901122, 0xFD987193, 0xA679438E, 0x49B40821,
    0xF61E2562, 0xC040B340, 0x265E5A51, 0xE9B6C7AA,
    0xD62F105D, 0x02441453, 0xD8A1E681, 0xE7D3FBC8,
    0x21E1CDE6, 0xC33707D6, 0xF4D50D87, 0x455A14ED,
    0xA9E3E905, 0xFCEFA3F8, 0x676F02D9, 0x8D2A4C8A,
    0xFFFA3942, 0x8771F681, 0x6D9D6122, 0xFDE5380C,
    0xA4BEEA44, 0x4BDECFA9, 0xF6BB4B60, 0xBEBFBC70,
    0x289B7EC6, 0xEAA127FA, 0xD4EF3085, 0x04881D05,
    0xD9D4D039, 0xE6DB99E5, 0x1FA27CF8, 0xC4AC5665,
    0xF4292244, 0x432AFF97, 0xAB9423A7, 0xFC93A039,
    0x655B59C3, 0x8F0CCC92, 0xFFEFF47D, 0x85845DD1,
    0x6FA87E4F, 0xFE2CE6E0, 0xA3014314, 0x4E0811A1,
    0xF7537E82, 0xBD3AF235, 0x2AD7D2BB, 0xEB86D391
];
// The per-round rotation amounts.
const Md5Shifts: uint32[64] = [
    7, 12, 17, 22, 7, 12, 17, 22,
    7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20,
    5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23,
    4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21,
    6, 10, 15, 21, 6, 10, 15, 21
];

func Md5Rotate(value: uint32, amount: uint32) -> uint32 {
    return (value << amount) | (value >> (32 - amount));
}

/// An incremental MD5. **Broken; see the note at the top of this file.**
/// Structural `Copy`; copying takes an independent snapshot of the digest state.
/// @see https://rux-lang.dev/docs/api/crypto/legacy-md5
pub struct LegacyMd5 {
    /// The four working words.
    state: uint32[4];
    /// Bytes not yet part of a full block.
    buffer: char8[64];
    /// How many of them there are.
    buffered: uint;
    /// The message length in bytes.
    length: uint64;
}

extend LegacyMd5 {
    /// An MD5 state.
    /// @returns an MD5 hasher, which is broken and is here only to read what already exists
    /// @see https://rux-lang.dev/docs/api/crypto/legacy-md5#new
    pub func LegacyMd5() -> LegacyMd5 {
        var buffer: char8[64];
        var index: uint = 0;
        while index < 64 {
            buffer[index] = 0u8 as char8;
            index = index + 1;
        }
        return LegacyMd5 {
            state: [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476],
            buffer: buffer,
            buffered: 0,
            length: 0
        };
    }

    func Compress(self: &var LegacyMd5, block: *char8) {
        // MD5 reads its words little-endian, where the SHA family reads big-endian.
        var words: uint32[16];
        var index: uint = 0;
        while index < 16 {
            var word: uint32 = 0;
            var part: uint = 0;
            while part < 4 {
                word = word | ((block[index * 4 + part] as uint8 as uint32) << ((part * 8) as uint32));
                part = part + 1;
            }
            words[index] = word;
            index = index + 1;
        }

        var a = self.state[0];
        var b = self.state[1];
        var c = self.state[2];
        var d = self.state[3];

        index = 0;
        while index < 64 {
            var mixed: uint32 = 0;
            var which: uint = 0;
            if index < 16 {
                mixed = (b & c) | ((~b) & d);
                which = index;
            }
            else if index < 32 {
                mixed = (d & b) | ((~d) & c);
                which = (5 * index + 1) % 16;
            }
            else if index < 48 {
                mixed = b ^ c ^ d;
                which = (3 * index + 5) % 16;
            }
            else {
                mixed = c ^ (b | (~d));
                which = (7 * index) % 16;
            }
            let temp = d;
            d = c;
            c = b;
            let sum = a + mixed + Md5Constants[index] + words[which];
            b = b + Md5Rotate(sum, Md5Shifts[index]);
            a = temp;
            index = index + 1;
        }

        self.state[0] = self.state[0] + a;
        self.state[1] = self.state[1] + b;
        self.state[2] = self.state[2] + c;
        self.state[3] = self.state[3] + d;
    }

    /// Adds `bytes` to the message.
    /// @param bytes the bytes to absorb
    /// @see https://rux-lang.dev/docs/api/crypto/legacy-md5#update
    pub func Update(self: &var LegacyMd5, bytes: char8[..]) {
        self.length = self.length + (bytes.length as uint64);
        var index: uint = 0;
        while index < bytes.length {
            self.buffer[self.buffered] = bytes[index];
            self.buffered = self.buffered + 1;
            if self.buffered == 64 {
                self.Compress(@self.buffer[0]);
                self.buffered = 0;
            }
            index = index + 1;
        }
    }

    /// Writes the sixteen-byte digest into `into`.
    /// The length is appended little-endian, unlike the SHA family's big-endian count.
    /// @param into receives the output
    /// @see https://rux-lang.dev/docs/api/crypto/legacy-md5#finish
    pub func Finish(self: &var LegacyMd5, into: var char8[..]) {
        let bitLength = self.length * 8;
        self.buffer[self.buffered] = 0x80u8 as char8;
        self.buffered = self.buffered + 1;
        if self.buffered > 56 {
            while self.buffered < 64 {
                self.buffer[self.buffered] = 0u8 as char8;
                self.buffered = self.buffered + 1;
            }
            self.Compress(@self.buffer[0]);
            self.buffered = 0;
        }
        while self.buffered < 56 {
            self.buffer[self.buffered] = 0u8 as char8;
            self.buffered = self.buffered + 1;
        }
        var shift: uint = 0;
        while shift < 8 {
            self.buffer[56 + shift] = ((bitLength >> ((shift * 8) as uint64)) & 0xFF) as uint8 as char8;
            shift = shift + 1;
        }
        self.Compress(@self.buffer[0]);

        var index: uint = 0;
        while index < 16 && index < into.length {
            let word = self.state[index / 4];
            into[index] = ((word >> (((index % 4) * 8) as uint32)) & 0xFF) as uint8 as char8;
            index = index + 1;
        }
        self.buffered = 0;
    }
}

/// The MD5 digest of `bytes`. **Broken; see the note at the top of this file.**
/// @param bytes the bytes to absorb
/// @param into receives the output
/// @see https://rux-lang.dev/docs/api/crypto/legacy-md5#legacy-md5-of
pub func LegacyMd5Of(bytes: char8[..], into: var char8[..]) {
    var digest = LegacyMd5();
    digest.Update(bytes);
    digest.Finish(into);
}

/// An incremental SHA-1. **Broken for collision resistance; see the note at the top of this file.**
/// Structural `Copy`; copying takes an independent snapshot of the digest state.
/// @see https://rux-lang.dev/docs/api/crypto/legacy-sha1
pub struct LegacySha1 {
    /// The five working words.
    state: uint32[5];
    /// Bytes not yet part of a full block.
    buffer: char8[64];
    /// How many of them there are.
    buffered: uint;
    /// The message length in bytes.
    length: uint64;
}

extend LegacySha1 {
    /// A SHA-1 state.
    /// @returns a SHA-1 hasher, which is broken and is here only to read what already exists
    /// @see https://rux-lang.dev/docs/api/crypto/legacy-sha1#new
    pub func LegacySha1() -> LegacySha1 {
        var buffer: char8[64];
        var index: uint = 0;
        while index < 64 {
            buffer[index] = 0u8 as char8;
            index = index + 1;
        }
        return LegacySha1 {
            state: [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0],
            buffer: buffer,
            buffered: 0,
            length: 0
        };
    }

    func Compress(self: &var LegacySha1, block: *char8) {
        var schedule: uint32[80];
        var index: uint = 0;
        while index < 16 {
            schedule[index] = ((block[index * 4] as uint8 as uint32) << 24) |
                              ((block[index * 4 + 1] as uint8 as uint32) << 16) |
                              ((block[index * 4 + 2] as uint8 as uint32) << 8) |
                              (block[index * 4 + 3] as uint8 as uint32);
            index = index + 1;
        }
        while index < 80 {
            let mixed = schedule[index - 3] ^ schedule[index - 8] ^ schedule[index - 14] ^ schedule[index - 16];
            // The rotation here is the one difference from SHA-0, and the only reason SHA-1 outlived it.
            schedule[index] = Md5Rotate(mixed, 1);
            index = index + 1;
        }

        var a = self.state[0];
        var b = self.state[1];
        var c = self.state[2];
        var d = self.state[3];
        var e = self.state[4];

        index = 0;
        while index < 80 {
            var mixed: uint32 = 0;
            var constant: uint32 = 0;
            if index < 20 {
                mixed = (b & c) | ((~b) & d);
                constant = 0x5A827999;
            }
            else if index < 40 {
                mixed = b ^ c ^ d;
                constant = 0x6ED9EBA1;
            }
            else if index < 60 {
                mixed = (b & c) | (b & d) | (c & d);
                constant = 0x8F1BBCDC;
            }
            else {
                mixed = b ^ c ^ d;
                constant = 0xCA62C1D6;
            }
            let temp = Md5Rotate(a, 5) + mixed + e + constant + schedule[index];
            e = d;
            d = c;
            c = Md5Rotate(b, 30);
            b = a;
            a = temp;
            index = index + 1;
        }

        self.state[0] = self.state[0] + a;
        self.state[1] = self.state[1] + b;
        self.state[2] = self.state[2] + c;
        self.state[3] = self.state[3] + d;
        self.state[4] = self.state[4] + e;
    }

    /// Adds `bytes` to the message.
    /// @param bytes the bytes to absorb
    /// @see https://rux-lang.dev/docs/api/crypto/legacy-sha1#update
    pub func Update(self: &var LegacySha1, bytes: char8[..]) {
        self.length = self.length + (bytes.length as uint64);
        var index: uint = 0;
        while index < bytes.length {
            self.buffer[self.buffered] = bytes[index];
            self.buffered = self.buffered + 1;
            if self.buffered == 64 {
                self.Compress(@self.buffer[0]);
                self.buffered = 0;
            }
            index = index + 1;
        }
    }

    /// Writes the twenty-byte digest into `into`.
    /// @param into receives the output
    /// @see https://rux-lang.dev/docs/api/crypto/legacy-sha1#finish
    pub func Finish(self: &var LegacySha1, into: var char8[..]) {
        let bitLength = self.length * 8;
        self.buffer[self.buffered] = 0x80u8 as char8;
        self.buffered = self.buffered + 1;
        if self.buffered > 56 {
            while self.buffered < 64 {
                self.buffer[self.buffered] = 0u8 as char8;
                self.buffered = self.buffered + 1;
            }
            self.Compress(@self.buffer[0]);
            self.buffered = 0;
        }
        while self.buffered < 56 {
            self.buffer[self.buffered] = 0u8 as char8;
            self.buffered = self.buffered + 1;
        }
        var shift: uint = 0;
        while shift < 8 {
            self.buffer[56 + shift] = ((bitLength >> ((56 - shift * 8) as uint64)) & 0xFF) as uint8 as char8;
            shift = shift + 1;
        }
        self.Compress(@self.buffer[0]);

        var index: uint = 0;
        while index < 20 && index < into.length {
            let word = self.state[index / 4];
            let byteShift = ((3u - (index % 4)) * 8) as uint32;
            into[index] = ((word >> byteShift) & 0xFF) as uint8 as char8;
            index = index + 1;
        }
        self.buffered = 0;
    }
}

/// The SHA-1 digest of `bytes`. **Broken for collision resistance; see the note at the top of this file.**
/// @param bytes the bytes to absorb
/// @param into receives the output
/// @see https://rux-lang.dev/docs/api/crypto/legacy-sha1#legacy-sha1-of
pub func LegacySha1Of(bytes: char8[..], into: var char8[..]) {
    var digest = LegacySha1();
    digest.Update(bytes);
    digest.Finish(into);
}
