// Keccak-f[1600] and the four SHA-3 hashes built on it.
//
// SHA-3 is not a Merkle-Damgard hash like SHA-2. There is no compression function taking a chaining value and a
// block: there is a permutation over a fixed 1600-bit state, and a message is absorbed into part of that state a
// rate at a time and then squeezed back out. The part that is never touched directly by the message is the
// capacity, and it is what the security level is set by -- which is why the four hashes differ only in how much
// of the state they expose, not in their permutation.
//
// That structure makes SHA-3 immune to the length-extension attack SHA-2 permits, because the output squeezed
// out is a window onto a state the attacker cannot complete. It is the reason to reach for SHA-3 over SHA-2 when
// a raw hash is used where a MAC belongs.

import Core::{ MutableSlice, Slice };

// The twenty-four round constants, generated by the linear feedback shift register the specification defines.
const KeccakRoundConstants: uint64[24] = [
    0x0000000000000001u64, 0x0000000000008082u64, 0x800000000000808Au64,
    0x8000000080008000u64, 0x000000000000808Bu64, 0x0000000080000001u64,
    0x8000000080008081u64, 0x8000000000008009u64, 0x000000000000008Au64,
    0x0000000000000088u64, 0x0000000080008009u64, 0x000000008000000Au64,
    0x000000008000808Bu64, 0x800000000000008Bu64, 0x8000000000008089u64,
    0x8000000000008003u64, 0x8000000000008002u64, 0x8000000000000080u64,
    0x000000000000800Au64, 0x800000008000000Au64, 0x8000000080008081u64,
    0x8000000000008080u64, 0x0000000080000001u64, 0x8000000080008008u64
];

// The rotation offset for each lane, indexed as `x + 5 * y`. These are the triangular numbers taken modulo the
// lane width, which is why they look arbitrary and are not.
const KeccakRotations: uint64[25] = [
    0u64, 1u64, 62u64, 28u64, 27u64,
    36u64, 44u64, 6u64, 55u64, 20u64,
    3u64, 10u64, 43u64, 25u64, 39u64,
    41u64, 45u64, 15u64, 21u64, 8u64,
    18u64, 2u64, 61u64, 56u64, 14u64
];

func RotateLeftLane(value: uint64, amount: uint64) -> uint64 {
    if amount == 0u64 {
        return value;
    }
    return (value << amount) | (value >> (64u64 - amount));
}

/// The Keccak-f[1600] permutation, applied in place to twenty-five lanes.
///
/// Twenty-four rounds of five steps: theta mixes each column into its neighbours, rho rotates each lane by its
/// own offset, pi moves the lanes around, chi is the only non-linear step, and iota breaks the symmetry that
/// would otherwise make every round identical.
///
/// https://rux-lang.dev/docs/api/crypto/keccak-permute
func KeccakPermute(lanes: *var uint64) {
    var round: uint = 0;
    while round < 24u {
        // Theta: exclusive-or each column together, then mix each with the rotated neighbouring column.
        var parity: uint64[5];
        var x: uint = 0;
        while x < 5u {
            parity[x] = lanes[x] ^ lanes[x + 5u] ^ lanes[x + 10u] ^ lanes[x + 15u] ^ lanes[x + 20u];
            x = x + 1;
        }
        var mixed: uint64[5];
        x = 0;
        while x < 5u {
            mixed[x] = parity[(x + 4u) % 5u] ^ RotateLeftLane(parity[(x + 1u) % 5u], 1u64);
            x = x + 1;
        }
        var index: uint = 0;
        while index < 25u {
            lanes[index] = lanes[index] ^ mixed[index % 5u];
            index = index + 1;
        }

        // Rho and pi together: each lane is rotated by its offset and moved to its new position.
        var moved: uint64[25];
        var y: uint = 0;
        while y < 5u {
            x = 0;
            while x < 5u {
                let source = x + 5u * y;
                let target = y + 5u * ((2u * x + 3u * y) % 5u);
                moved[target] = RotateLeftLane(lanes[source], KeccakRotations[source]);
                x = x + 1;
            }
            y = y + 1;
        }

        // Chi: the only non-linear step, applied along each row.
        y = 0;
        while y < 5u {
            x = 0;
            while x < 5u {
                let a = moved[x + 5u * y];
                let b = moved[(x + 1u) % 5u + 5u * y];
                let c = moved[(x + 2u) % 5u + 5u * y];
                lanes[x + 5u * y] = a ^ ((~b) & c);
                x = x + 1;
            }
            y = y + 1;
        }

        // Iota: one lane takes the round constant, which is what makes the rounds differ from one another.
        lanes[0] = lanes[0] ^ KeccakRoundConstants[round];
        round = round + 1;
    }
}

/// An incremental SHA-3 hash at any of its four sizes.
///
/// Structural `Copy`; copying takes an independent snapshot of the sponge state.
///
/// https://rux-lang.dev/docs/api/crypto/sha3
struct Sha3 {
    /// The state, as twenty-five sixty-four bit lanes.
    lanes: uint64[25];
    /// How many bytes of the state the message is absorbed into before the permutation runs.
    rate: uint;
    /// How far into the current rate the absorption has reached.
    absorbed: uint;
    /// How many bytes `Finish` writes.
    outputLength: uint;
    /// The byte appended to the message before the padding, which separates SHA-3 from SHAKE.
    domain: uint8;
}

extend Sha3 {
    func Start(outputLength: uint, domain: uint8) -> Sha3 {
        var digest: Sha3;
        var index: uint = 0;
        while index < 25u {
            digest.lanes[index] = 0u64;
            index = index + 1;
        }
        // The capacity is twice the digest length, which is what sets the security level; the rate is whatever
        // of the 1600-bit state is left over.
        digest.rate = 200u - 2u * outputLength;
        digest.absorbed = 0;
        digest.outputLength = outputLength;
        digest.domain = domain;
        return digest;
    }

    /// A SHA3-224 state.
    ///
    /// https://rux-lang.dev/docs/api/crypto/sha3/new-224
    func New224() -> Sha3 {
        return Sha3::Start(28u, 0x06u8);
    }

    /// A SHA3-256 state.
    ///
    /// https://rux-lang.dev/docs/api/crypto/sha3/new-256
    func New256() -> Sha3 {
        return Sha3::Start(32u, 0x06u8);
    }

    /// A SHA3-384 state.
    ///
    /// https://rux-lang.dev/docs/api/crypto/sha3/new-384
    func New384() -> Sha3 {
        return Sha3::Start(48u, 0x06u8);
    }

    /// A SHA3-512 state.
    ///
    /// https://rux-lang.dev/docs/api/crypto/sha3/new-512
    func New512() -> Sha3 {
        return Sha3::Start(64u, 0x06u8);
    }

    // Exclusive-ors one byte into the state at the given position, which is how absorption works: the message
    // is mixed into the state rather than replacing any of it.
    func AbsorbByte(self: &var Sha3, position: uint, value: uint8) {
        let lane = position / 8u;
        let shift = ((position % 8u) * 8u) as uint64;
        self.lanes[lane] = self.lanes[lane] ^ ((value as uint64) << shift);
    }
}

extend Sha3 : Digest {
    /// Absorbs `bytes` into the state.
    ///
    /// https://rux-lang.dev/docs/api/crypto/sha3/update
    func Update(self: &var Sha3, bytes: Slice<char8>) {
        var index: uint = 0;
        while index < bytes.length {
            self.AbsorbByte(self.absorbed, bytes.data[index] as uint8);
            self.absorbed = self.absorbed + 1u;
            if self.absorbed == self.rate {
                KeccakPermute(@self.lanes[0]);
                self.absorbed = 0;
            }
            index = index + 1;
        }
    }

    /// Pads, permutes once more, and squeezes the digest out.
    ///
    /// The padding is the domain byte, then zeros, then a final bit at the top of the rate -- so a rate with
    /// only one byte free receives both in the same byte, which is the case that separates a correct padding
    /// from one that works at every other length.
    ///
    /// https://rux-lang.dev/docs/api/crypto/sha3/finish
    func Finish(self: &var Sha3, into: MutableSlice<char8>) {
        self.AbsorbByte(self.absorbed, self.domain);
        self.AbsorbByte(self.rate - 1u, 0x80u8);
        KeccakPermute(@self.lanes[0]);

        var written: uint = 0;
        while written < self.outputLength {
            if written > 0u && written % self.rate == 0u {
                // A digest longer than the rate would need more squeezing. None of the four SHA-3 sizes does,
                // but the loop is written so it would be right if one did.
                KeccakPermute(@self.lanes[0]);
            }
            let position = written % self.rate;
            let lane = self.lanes[position / 8u];
            let shift = ((position % 8u) * 8u) as uint64;
            if written < into.length {
                into.data[written] = ((lane >> shift) & 0xFFu64) as uint8 as char8;
            }
            written = written + 1u;
        }
        self.absorbed = 0;
    }

    /// Twenty-eight, thirty-two, forty-eight or sixty-four bytes.
    ///
    /// https://rux-lang.dev/docs/api/crypto/sha3/digest-length
    func DigestLength(self: &Sha3) -> uint {
        return self.outputLength;
    }

    /// The rate, which differs per size -- unlike the SHA-2 family, whose block is fixed.
    ///
    /// https://rux-lang.dev/docs/api/crypto/sha3/block-length
    func BlockLength(self: &Sha3) -> uint {
        return self.rate;
    }
}

/// The SHA3-224 digest of `bytes`, in one call.
///
/// https://rux-lang.dev/docs/api/crypto/sha3-of-224
func Sha3Of224(bytes: Slice<char8>, into: MutableSlice<char8>) {
    var digest = Sha3::New224();
    digest.Update(bytes);
    digest.Finish(into);
}

/// The SHA3-256 digest of `bytes`, in one call.
///
/// https://rux-lang.dev/docs/api/crypto/sha3-of-256
func Sha3Of256(bytes: Slice<char8>, into: MutableSlice<char8>) {
    var digest = Sha3::New256();
    digest.Update(bytes);
    digest.Finish(into);
}

/// The SHA3-384 digest of `bytes`, in one call.
///
/// https://rux-lang.dev/docs/api/crypto/sha3-of-384
func Sha3Of384(bytes: Slice<char8>, into: MutableSlice<char8>) {
    var digest = Sha3::New384();
    digest.Update(bytes);
    digest.Finish(into);
}

/// The SHA3-512 digest of `bytes`, in one call.
///
/// https://rux-lang.dev/docs/api/crypto/sha3-of-512
func Sha3Of512(bytes: Slice<char8>, into: MutableSlice<char8>) {
    var digest = Sha3::New512();
    digest.Update(bytes);
    digest.Finish(into);
}
