/**
    Computes the hyperbolic tangent of `x`. The result lies in `[-1, 1]`. A signed zero returns itself, infinities map
    to the matching endpoint, and a NaN remains a NaN.
    @param x Hyperbolic angle.
    @returns The hyperbolic tangent of `x`.
    @see https://rux-lang.dev/docs/api/math/tanh
*/
pub func Tanh(x: float64) -> float64 {
    if IsNan(x) { return x; }
    let negative = SignBit(x);
    let ax = Abs(x);
    if ax == 0.0 { return x; }
    if ax >= 22.0 { return negative ? -1.0 : 1.0; }
    var y = 0.0;
    if ax < 1.0 {
        let t = Expm1(-2.0 * ax);
        y = -t / (t + 2.0);
    } else {
        let t = Expm1(2.0 * ax);
        y = 1.0 - 2.0 / (t + 2.0);
    }
    return negative ? -y : y;
}

/**
    Computes the hyperbolic tangent of `x` at `float32` precision.
    @param x Hyperbolic angle.
    @returns The hyperbolic tangent of `x`.
    @see https://rux-lang.dev/docs/api/math/tanh
*/
pub func Tanh(x: float32) -> float32 {
    return Tanh(x as float64) as float32;
}
