/// Converts an angle from degrees to radians.
///
/// The conversion scales by the nearest `float64` to `Pi / 180`, making `DegToRad(180.0)` exactly `Pi`.
/// A signed zero keeps its sign, infinities keep their sign, and a NaN remains a NaN.
///
/// @param x Angle in degrees.
/// @returns The equivalent angle in radians.
/// @see https://rux-lang.dev/docs/api/math/degtorad
pub func DegToRad(x: float64) -> float64 {
    return x * RadPerDeg;
}

/// Converts an angle from degrees to radians at `float32` precision.
///
/// The input widens exactly to `float64`; the wide conversion is then rounded back to `float32`.
///
/// @param x Angle in degrees.
/// @returns The equivalent angle in radians.
/// @see https://rux-lang.dev/docs/api/math/degtorad
pub func DegToRad(x: float32) -> float32 {
    return DegToRad(x as float64) as float32;
}

/// Converts an angle from radians to degrees.
///
/// The conversion scales by the nearest `float64` to `180 / Pi`, making `RadToDeg(Pi)` exactly `180.0`.
/// A signed zero keeps its sign, infinities keep their sign, and a NaN remains a NaN.
///
/// @param x Angle in radians.
/// @returns The equivalent angle in degrees.
/// @see https://rux-lang.dev/docs/api/math/radtodeg
pub func RadToDeg(x: float64) -> float64 {
    return x * DegPerRad;
}

/// Converts an angle from radians to degrees at `float32` precision.
///
/// The input widens exactly to `float64`; the wide conversion is then rounded back to `float32`.
///
/// @param x Angle in radians.
/// @returns The equivalent angle in degrees.
/// @see https://rux-lang.dev/docs/api/math/radtodeg
pub func RadToDeg(x: float32) -> float32 {
    return RadToDeg(x as float64) as float32;
}
