/**
    Computes the hyperbolic cotangent of `x`. A signed zero maps to an infinity with the same sign, infinities map to
    `-1` or `1`, and a NaN remains a NaN.
    @param x Hyperbolic angle.
    @returns The hyperbolic cotangent of `x`.
    @see https://rux-lang.dev/docs/api/math/cotanh
*/
pub func Cotanh(x: float64) -> float64 {
    if IsNan(x) { return x; }
    let negative = SignBit(x);
    let ax = Abs(x);
    if ax == 0.0 { return 1.0 / x; }
    if ax < 3.725290298461914e-9 { return 1.0 / x; }
    if ax >= 22.0 { return negative ? -1.0 : 1.0; }
    let t = Expm1(2.0 * ax);
    let y = 1.0 + 2.0 / t;
    return negative ? -y : y;
}

/**
    Computes the hyperbolic cotangent of `x` at `float32` precision.
    @param x Hyperbolic angle.
    @returns The hyperbolic cotangent of `x`.
    @see https://rux-lang.dev/docs/api/math/cotanh
*/
pub func Cotanh(x: float32) -> float32 {
    return Cotanh(x as float64) as float32;
}
