// log(1 + x), computed without ever forming that sum.
//
// **Accuracy: error at most 1 ulp, and the relative error stays that small as the argument approaches zero.**
// That last property is the reason this exists at all, and `Log(1.0 + x)` cannot have it at any accuracy: for a
// small `x` the sum `1 + x` rounds away every bit of `x` below the fifty-third, so the logarithm is handed an
// argument that has already lost the answer. This is the mirror of `Expm1`, and the two are inverses across the
// range where both matter.
//
// The method is fdlibm's: for a small argument the series in `f/(2+f)` is applied directly to `x`, and for a
// large one the sum is formed deliberately, its rounding error recovered exactly, and that error folded back in
// as a correction. The exactness of the recovery is what keeps the boundary between the two paths invisible.

/// `log(1 + x)`, accurate all the way down to zero.
///
/// `Log1p(0.0)` is zero with the argument's sign, `Log1p(-1.0)` is negative infinity, and an argument below -1
/// has no real logarithm and gives a NaN.
///
/// https://rux-lang.dev/docs/api/math/log1p
pub func Log1p(x: float64) -> float64 {
    let ln2Hi = 6.93147180369123816490e-01;
    let ln2Lo = 1.90821492927058770002e-10;

    var zero = 0.0;
    let bits = FloatBits(x);
    let magnitude = bits & 0x7FFFFFFFFFFFFFFFu64;

    // A NaN, or +Inf, passes straight through: log1p(+Inf) is +Inf.
    if magnitude >= 0x7FF0000000000000u64 {
        return x + x;
    }
    if x == -1.0 {
        return -1.0 / zero;
    }
    if x < -1.0 {
        return (x - x) / zero;
    }
    // Below 2^-54 the answer is the argument to every bit the type holds, and returning it keeps the sign of a
    // zero as well.
    if magnitude < 0x3C90000000000000u64 {
        return x;
    }

    var correction = 0.0;
    var reduced = x;
    var k = 0i64;

    // For an argument near zero the sum 1 + x would lose bits, so the series runs on x itself.
    if x > -0.2928932188134525 && x < 0.4142135623730951 {
        k = 0i64;
        reduced = x;
    }
    else {
        let sum = 1.0 + x;
        let red = LogNormalize(sum);
        k = red.k;
        // The rounding error of `1 + x`, recovered exactly: for a large argument the one was rounded away, and
        // for a small one the argument was. Either way this is the part the sum dropped.
        let dropped = x > 1.0 ? 1.0 - (sum - x) : x - (sum - 1.0);
        correction = dropped / sum;
        reduced = red.m - 1.0;
    }

    let hfsq = 0.5 * reduced * reduced;
    let r = LogPoly(reduced);
    let dk = k as float64;
    if k == 0i64 {
        return reduced - (hfsq - r);
    }
    return dk * ln2Hi - ((hfsq - (r + (dk * ln2Lo + correction))) - reduced);
}

/// `log(1 + x)` at the narrow width.
///
/// https://rux-lang.dev/docs/api/math/log1p-32
pub func Log1p(x: float32) -> float32 {
    return Log1p(x as float64) as float32;
}
