// The square root, computed by the hardware instruction.
//
// Correctly rounded — error at most half an ulp — which is not a claim about this code but about the
// instruction: IEEE 754 requires it to return the nearest representable value to the true root at every
// argument, and every architecture here has one that does, with the special cases already right. The argument
// arrives in the register the result is returned in under every convention involved, so the whole body is the
// instruction and no ABI override is needed.

import Core::{ #target, #Error };

when #target.arch {
    .X86_64 => {
        // Both the Win64 and System V ABIs pass the first float argument in xmm0 and return the result there.
        /**
            Computes the correctly rounded square root of `x` at `float32` precision. A signed zero, positive infinity,
            or NaN passes through; a negative finite value returns a NaN.
            @param x Value whose square root is computed.
            @returns The non-negative square root of `x`, or a NaN when `x` is negative.
            @see https://rux-lang.dev/docs/api/math/sqrt
        */
        pub asm func Sqrt(x: float32) -> float32 {
            sqrtss xmm0, xmm0
            ret
        }

        /**
            Computes the correctly rounded square root of `x`. A signed zero, positive infinity, or NaN passes through;
            a negative finite value returns a NaN.
            @param x Value whose square root is computed.
            @returns The non-negative square root of `x`, or a NaN when `x` is negative.
            @see https://rux-lang.dev/docs/api/math/sqrt
        */
        pub asm func Sqrt(x: float64) -> float64 {
            sqrtsd xmm0, xmm0
            ret
        }
    },
    .AArch64 => {
        // AAPCS64 passes the first float argument in v0 and returns the result there, under the S view for float32 and
        // the D view for float64.
        /**
            Computes the correctly rounded square root of `x` at `float32` precision. A signed zero, positive infinity,
            or NaN passes through; a negative finite value returns a NaN.
            @param x Value whose square root is computed.
            @returns The non-negative square root of `x`, or a NaN when `x` is negative.
            @see https://rux-lang.dev/docs/api/math/sqrt
        */
        pub asm func Sqrt(x: float32) -> float32 {
            fsqrt s0, s0
            ret
        }

        /**
            Computes the correctly rounded square root of `x`. A signed zero, positive infinity, or NaN passes through;
            a negative finite value returns a NaN.
            @param x Value whose square root is computed.
            @returns The non-negative square root of `x`, or a NaN when `x` is negative.
            @see https://rux-lang.dev/docs/api/math/sqrt
        */
        pub asm func Sqrt(x: float64) -> float64 {
            fsqrt d0, d0
            ret
        }
    },
    else => #Error("Unsupported architecture")
}
