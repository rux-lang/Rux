import Core::{ #target, #Error };

// Square root, computed by the hardware instruction.
// Accuracy: correctly rounded, error at most 0.5 ulp. Not a claim about this code but about
// the instruction, which IEEE 754 requires to return the nearest representable value to the true root
// at every argument. Every architecture here has one that is correctly rounded and already produces
// the IEEE-754 results for the special cases: Sqrt(NaN) = NaN, Sqrt(+Inf) = +Inf, Sqrt(-0.0) = -0.0,
// Sqrt(x < 0) = NaN. The argument arrives in the register the result is returned in under every convention
// involved, so no #Abi override is needed and the whole body is the instruction itself.
when #target.arch {
    .X86_64 => {
        // Both the Win64 and System V ABIs pass the first float argument in
        // xmm0 and return the result there.
        /// Computes the correctly rounded square root of `x` at `float32` precision.
        ///
        /// A signed zero, positive infinity, or NaN passes through; a negative finite value returns a NaN.
        ///
        /// @param x Value whose square root is computed.
        /// @returns The non-negative square root of `x`, or a NaN when `x` is negative.
        /// @see https://rux-lang.dev/docs/api/math/sqrt
        pub asm func Sqrt(x: float32) -> float32 {
            sqrtss xmm0, xmm0
            ret
        }

        /// Computes the correctly rounded square root of `x`.
        ///
        /// A signed zero, positive infinity, or NaN passes through; a negative finite value returns a NaN.
        ///
        /// @param x Value whose square root is computed.
        /// @returns The non-negative square root of `x`, or a NaN when `x` is negative.
        /// @see https://rux-lang.dev/docs/api/math/sqrt
        pub asm func Sqrt(x: float64) -> float64 {
            sqrtsd xmm0, xmm0
            ret
        }
    },
    .AArch64 => {
        // AAPCS64 passes the first float argument in v0 and returns the result
        // there, under the S view for float32 and the D view for float64.
        /// Computes the correctly rounded square root of `x` at `float32` precision.
        ///
        /// A signed zero, positive infinity, or NaN passes through; a negative finite value returns a NaN.
        ///
        /// @param x Value whose square root is computed.
        /// @returns The non-negative square root of `x`, or a NaN when `x` is negative.
        /// @see https://rux-lang.dev/docs/api/math/sqrt
        pub asm func Sqrt(x: float32) -> float32 {
            fsqrt s0, s0
            ret
        }

        /// Computes the correctly rounded square root of `x`.
        ///
        /// A signed zero, positive infinity, or NaN passes through; a negative finite value returns a NaN.
        ///
        /// @param x Value whose square root is computed.
        /// @returns The non-negative square root of `x`, or a NaN when `x` is negative.
        /// @see https://rux-lang.dev/docs/api/math/sqrt
        pub asm func Sqrt(x: float64) -> float64 {
            fsqrt d0, d0
            ret
        }
    },
    else => #Error("Unsupported architecture")
}
