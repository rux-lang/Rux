// Integer arithmetic with a mathematical flavour: magnitude, ordering, and the number-theory pair.
//
// Everything here is generic over the integer type in the same way `Core`'s checked arithmetic is, and for the
// same reason: an integer's zero, its signedness and its two limits all follow from one operand, so `int8` and
// `uint512` run the same code and no width can be forgotten. Nothing here is written per width.
//
// The operations that can fail say so by returning `true`, matching `AddChecked` and its family exactly. That
// convention reads backwards the first time -- `true` means the answer is not the true one -- but a family that
// disagrees with itself about which way the flag points is far worse than one that is uniformly surprising.
//
// Where an operation can fail, it is because the two's-complement range is not symmetric: the most negative
// value of every signed width has no positive counterpart, so its magnitude, its negation and its greatest
// common divisor with zero are all unrepresentable. That one asymmetry is behind nearly every edge case below.

import Core::{ MaximumOf, MinimumOf, MulChecked };

/// The magnitude of `value`, reporting whether it is representable.
///
/// `result` receives the magnitude the machine produced, which is the true one when this returns `false` and the
/// wrapped one when it returns `true`. Only one input can overflow: the most negative value of a signed type,
/// whose magnitude is one larger than the maximum. An unsigned type never overflows here, since it is already
/// its own magnitude.
///
/// Runs in constant time and allocates nothing.
///
/// # Safety
///
/// `result` must be non-null and writable.
///
/// https://rux-lang.dev/docs/api/math/abs-checked
pub func AbsChecked<T>(value: T, result: *var T) -> bool {
    let zero = value - value;
    if value < zero {
        // Negating the most negative value wraps back to itself, which is exactly the overflow to report.
        let negated = zero - value;
        *result = negated;
        return negated < zero;
    }
    *result = value;
    return false;
}

/// The magnitude of `value`, wrapping where it is not representable.
///
/// The most negative value of a signed type comes back unchanged, which is what the machine's own negation does.
/// Use `AbsChecked` where that matters.
///
/// Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/math/abs-wrapping
pub func AbsWrapping<T>(value: T) -> T {
    var magnitude = value;
    AbsChecked<T>(value, @magnitude);
    return magnitude;
}

/// The smaller of two integers.
///
/// Total and exact: integers have no NaN, so unlike the floating-point `Min` there is no case to decide.
///
/// https://rux-lang.dev/docs/api/math/minimum
pub func Minimum<T>(left: T, right: T) -> T {
    return left < right ? left : right;
}

/// The larger of two integers.
///
/// https://rux-lang.dev/docs/api/math/maximum
pub func Maximum<T>(left: T, right: T) -> T {
    return left < right ? right : left;
}

/// `value` brought into `[low, high]`.
///
/// A contradictory pair -- `low` above `high` -- has no correct answer, and this returns `low` rather than
/// pretending otherwise. The behavior is stated so it is at least deterministic; callers who cannot rule the
/// case out should check the bounds themselves.
///
/// https://rux-lang.dev/docs/api/math/clamp
pub func Clamp<T>(value: T, low: T, high: T) -> T {
    if value < low { return low; }
    if high < value { return high; }
    return value;
}

/// The greatest common divisor of `left` and `right`, reporting whether it is representable.
///
/// Defined on magnitudes, so signs do not matter and the answer is never negative. `Gcd(0, 0)` is zero, which is
/// the conventional answer and the only one that keeps `Gcd(x, 0) == |x|` true everywhere. The single overflow
/// is a divisor equal to the magnitude of the most negative value -- reachable only as `Gcd(min, 0)` and
/// `Gcd(min, min)` -- which no signed type can express.
///
/// Runs in time proportional to the number of bits and allocates nothing.
///
/// # Safety
///
/// `result` must be non-null and writable.
///
/// https://rux-lang.dev/docs/api/math/gcd-checked
pub func GcdChecked<T>(left: T, right: T, result: *var T) -> bool {
    let zero = left - left;
    // Euclid on magnitudes. The magnitudes are taken with the wrapping form on purpose: the most negative value
    // comes back as itself, whose remainder arithmetic below is still correct on the bit pattern, and only the
    // final answer can be unrepresentable -- which is exactly what the checked magnitude at the end reports.
    var a = AbsWrapping<T>(left);
    var b = AbsWrapping<T>(right);
    while b != zero {
        let rest = a % b;
        a = b;
        b = rest;
    }
    // `a` is a magnitude, except in the one case where it is the most negative value standing in for a magnitude
    // one larger than the type can hold.
    if a < zero {
        *result = a;
        return true;
    }
    *result = a;
    return false;
}

/// The least common multiple of `left` and `right`, reporting whether it is representable.
///
/// Zero with anything is zero, which keeps the identity `Gcd(a, b) * Lcm(a, b) == |a * b|` true. Everything else
/// overflows readily -- two coprime values multiply -- so the flag is the usual case rather than the exception,
/// and the division is done before the multiplication so a representable answer is not lost to an intermediate
/// that is not.
///
/// # Safety
///
/// `result` must be non-null and writable.
///
/// https://rux-lang.dev/docs/api/math/lcm-checked
pub func LcmChecked<T>(left: T, right: T, result: *var T) -> bool {
    let zero = left - left;
    *result = zero;
    if left == zero || right == zero { return false; }
    var divisor = zero;
    if GcdChecked<T>(left, right, @divisor) { return true; }
    var magnitude = zero;
    if AbsChecked<T>(left, @magnitude) { return true; }
    // `magnitude / divisor` is exact, and doing it first keeps `Lcm(a, b)` in range whenever the answer itself
    // is, where multiplying first would overflow for perfectly representable results.
    let reduced = magnitude / divisor;
    var other = zero;
    if AbsChecked<T>(right, @other) { return true; }
    return MulChecked<T>(reduced, other, result);
}

/// `base` raised to `exponent`, reporting whether the true power is representable.
///
/// The exponent is a plain `uint` because a negative exponent has no integer answer. Anything to the zeroth
/// power is one, including zero: the empty product is one, and every identity that matters depends on it.
///
/// `result` receives the wrapped power when this returns `true`, so a caller who wants modular arithmetic can
/// use it directly. Runs in time proportional to the number of bits in `exponent`.
///
/// # Safety
///
/// `result` must be non-null and writable.
///
/// https://rux-lang.dev/docs/api/math/pow-checked
pub func PowChecked<T>(base: T, exponent: uint, result: *var T) -> bool {
    let zero = base - base;
    let one = zero + 1;
    var accumulated = one;
    var factor = base;
    var remaining = exponent;
    var overflowed = false;
    while remaining > 0u {
        if (remaining & 1u) != 0u {
            var product = zero;
            if MulChecked<T>(accumulated, factor, @product) {
                overflowed = true;
            }
            accumulated = product;
        }
        remaining = remaining >> 1u;
        if remaining > 0u {
            // Squaring on the last round would be wasted work, and worse, a wrapped square there would be
            // reported as an overflow that never reached the answer. With bits still to come the square is
            // always used, so an overflow in it is always real.
            var squared = zero;
            if MulChecked<T>(factor, factor, @squared) {
                overflowed = true;
            }
            factor = squared;
        }
    }
    *result = accumulated;
    return overflowed;
}
