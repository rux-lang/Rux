/// Computes the hyperbolic cosine of `x`.
///
/// The result is at least one. Either infinity returns positive infinity, and a NaN remains a NaN.
///
/// @param x Hyperbolic angle.
/// @returns The hyperbolic cosine of `x`.
/// @see https://rux-lang.dev/docs/api/math/cosh
pub func Cosh(x: float64) -> float64 {
    let halfLn2 = 0.5 * Ln2;
    let overflow = 710.4758600739439; // ln(2 * maxfloat)
    if IsNan(x) { return x; }
    let ax = Abs(x);
    if ax == 1.0 / 0.0 { return ax; }
    if ax > overflow {
        let huge = 1.0e300;
        return huge * huge;
    }
    if ax < halfLn2 {
        let t = Expm1(ax);
        return 1.0 + (t * t) / (2.0 * (1.0 + t));
    }
    if ax < 22.0 {
        let t = Exp(ax);
        return 0.5 * (t + 1.0 / t);
    }
    return Exp(ax - Ln2);
}

/// Computes the hyperbolic cosine of `x` at `float32` precision.
///
/// @param x Hyperbolic angle.
/// @returns The hyperbolic cosine of `x`.
/// @see https://rux-lang.dev/docs/api/math/cosh
pub func Cosh(x: float32) -> float32 {
    return Cosh(x as float64) as float32;
}
