/// Rounds `x` toward zero to an integral value.
///
/// The sign of zero is preserved, so `Trunc(-0.4)` is `-0.0`. A NaN or infinity passes through unchanged.
///
/// @param x Value to truncate.
/// @returns The integral part of `x`.
/// @see https://rux-lang.dev/docs/api/math/trunc
pub func Trunc(x: float64) -> float64 {
    let bits = FloatBits(x);
    let e = (((bits >> 52) & 0x7FF) as int64) - 1023;
    // An exponent of 52 or more leaves no fractional bits at all. The
    // infinities and the NaNs have an exponent of 1024 and land here too.
    if e >= 52 { return x; }
    // |x| < 1, so nothing survives but the sign.
    if e < 0 { return FromBits(bits & 0x8000000000000000); }
    let fractionMask: uint64 = 0xFFFFFFFFFFFFF;
    let mask = fractionMask >> (e as uint64);
    if (bits & mask) == 0 { return x; }
    return FromBits(bits & ~mask);
}

/// Rounds `x` toward zero to an integral value at `float32` precision.
///
/// The wide result is exactly representable at the input width, so narrowing it back to `float32` loses nothing.
///
/// @param x Value to truncate.
/// @returns The integral part of `x`.
/// @see https://rux-lang.dev/docs/api/math/trunc
pub func Trunc(x: float32) -> float32 {
    return Trunc(x as float64) as float32;
}
