/// Computes the hyperbolic sine of `x`.
///
/// A signed zero or infinity returns itself, and a NaN remains a NaN.
///
/// @param x Hyperbolic angle.
/// @returns The hyperbolic sine of `x`.
/// @see https://rux-lang.dev/docs/api/math/sinh
pub func Sinh(x: float64) -> float64 {
    let overflow = 710.4758600739439; // ln(2 * maxfloat)
    if IsNan(x) { return x; }
    let negative = SignBit(x);
    let ax = Abs(x);
    if ax == 0.0 { return x; }
    if ax > overflow {
        if ax == 1.0 / 0.0 { return x; }
        let huge = 1.0e300;
        return negative ? -huge * huge : huge * huge;
    }
    var y = 0.0;
    if ax < 1.0 {
        let t = Expm1(ax);
        y = 0.5 * (2.0 * t - t * t / (t + 1.0));
    } else if ax < 22.0 {
        let t = Expm1(ax);
        y = 0.5 * (t + t / (t + 1.0));
    } else {
        y = Exp(ax - Ln2);
    }
    return negative ? -y : y;
}

/// Computes the hyperbolic sine of `x` at `float32` precision.
///
/// @param x Hyperbolic angle.
/// @returns The hyperbolic sine of `x`.
/// @see https://rux-lang.dev/docs/api/math/sinh
pub func Sinh(x: float32) -> float32 {
    return Sinh(x as float64) as float32;
}
