/**
    Computes two raised to `x`. The error is at most one ulp, and an in-range integer exponent is exact. Positive
    infinity returns positive infinity, negative infinity returns zero, and a NaN remains a NaN.
    @param x Binary exponent.
    @returns Two raised to `x`.
    @see https://rux-lang.dev/docs/api/math/exp2
*/
pub func Exp2(x: float64) -> float64 {
    if IsNan(x) { return x; }
    // 2^1024 overflows, and 2^-1075 sits exactly halfway to zero, so it and everything below it round to zero. Both
    // tests also swallow an infinity.
    if x >= 1024.0 {
        let huge = 1.0e300;
        return huge * huge;
    }
    if x < -1075.0 { return 0.0; }
    // x = k + r with |r| <= 0.5, so 2^x = 2^k * exp(r*ln2) and the reduced argument |r*ln2| never leaves the
    // exponential kernel's range.
    let k = Round(x);
    let r = x - k; // exact: k is an integer within one of x
    // r*ln2 has to be carried to twice double precision. The rounded product alone is short by up to half an ulp of
    // the reduced argument, which is a whole ulp of the answer once it comes back through the exponential. Dekker's
    // splitting recovers the dropped bits exactly.
    let ln2Tail = 2.3190468138462996e-17; // ln(2) - its nearest float64
    let split = 134217729.0; // 2^27 + 1
    let p = r * Ln2;
    let ra = r * split;
    let rHi = ra - (ra - r);
    let rLo = r - rHi;
    let la = Ln2 * split;
    let lHi = la - (la - Ln2);
    let lLo = Ln2 - lHi;
    let pError = ((rHi * lHi - p) + rHi * lLo + rLo * lHi) + rLo * lLo;
    let tail = pError + r * ln2Tail;
    // ExpScaled reads its argument as hi - lo, so the tail goes in negated.
    return ExpScaled(p, -tail, k as int64);
}

/**
    Computes two raised to `x` at `float32` precision.
    @param x Binary exponent.
    @returns Two raised to `x`.
    @see https://rux-lang.dev/docs/api/math/exp2
*/
pub func Exp2(x: float32) -> float32 {
    return Exp2(x as float64) as float32;
}
