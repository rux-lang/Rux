/**
    Computes the base-ten logarithm of `x`. The error is at most one ulp, and an exact power of ten returns its exact
    exponent. Either signed zero returns negative infinity, a negative value returns a NaN, positive infinity returns
    itself, and a NaN remains a NaN.
    @param x Positive value whose logarithm is computed.
    @returns The base-ten logarithm of `x`.
    @see https://rux-lang.dev/docs/api/math/log10
*/
pub func Log10(x: float64) -> float64 {
    let ivln10Hi = 4.34294481878168880939e-01;
    let ivln10Lo = 2.50829467116452752298e-11;
    let log10Of2Hi = 3.01029995663611771306e-01;
    let log10Of2Lo = 3.69423907715893089906e-13;
    if IsZero(x) { return -float64::Infinity; }
    if IsNan(x) { return x; }
    if x < 0.0 { return float64::NaN; }
    if IsInfinite(x) { return x; }
    let red = LogNormalize(x);
    let f = red.m - 1.0;
    let hfsq = 0.5 * f * f;
    let r = LogPoly(f);
    // As in Log2: f - hfsq nearly cancels near sqrt(2), so it is split, and clearing the low bits of hi makes
    // hi*ivln10Hi exact. Both the reciprocal of ln(10) and log10(2) need their own low halves.
    let hi = TruncLow(f - hfsq);
    let lo = (f - hi) - hfsq + r;
    let y = red.k as float64;
    var valHi = hi * ivln10Hi;
    let y2 = y * log10Of2Hi;
    var valLo = y * log10Of2Lo + (lo + hi) * ivln10Lo + lo * ivln10Hi;
    let w = y2 + valHi;
    valLo += (y2 - w) + valHi;
    valHi = w;
    return valLo + valHi;
}

/**
    Computes the base-ten logarithm of `x` at `float32` precision.
    @param x Positive value whose logarithm is computed.
    @returns The base-ten logarithm of `x`.
    @see https://rux-lang.dev/docs/api/math/log10
*/
pub func Log10(x: float32) -> float32 {
    return Log10(x as float64) as float32;
}
