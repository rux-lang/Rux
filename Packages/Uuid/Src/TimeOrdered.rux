// Version 7: a UUID whose leading bits are a timestamp, so sorting the identifiers sorts the events.
//
// The reason this version exists is databases. A version 4 UUID as a primary key scatters inserts across the
// whole of a B-tree, so every insert dirties a different page and the index never stays in cache; a version 7
// key appends, because its first six bytes are milliseconds since the Unix epoch, big-endian. The remaining
// bits are random, which is what keeps it unguessable between milliseconds.
//
// Within one millisecond the ordering is not guaranteed by the format — two UUIDs made in the same millisecond
// have random tails and could sort either way. `MonotonicUuid` fixes that for a caller who needs it, by
// remembering the last value it produced and stepping the random part forward when the clock has not moved. It
// is a value the caller owns rather than a global, for the reason the random package gives at length: shared
// mutable state makes results depend on who else is running.

import Core::Ordering;
import Entropy::{ EntropyError, Fill };
import Time::Timestamp;

/// A version 7 UUID: the current time in its leading bits, entropy in the rest.
///
/// Fails with why entropy was unavailable rather than producing a timestamp-shaped value with no randomness — which
/// would be guessable and would look fine.
///
/// @returns a version 7 value carrying the current time, or why entropy was unavailable
/// @see https://rux-lang.dev/docs/api/uuid/time-ordered
pub func TimeOrdered() -> Uuid ! EntropyError {
    let now = Timestamp::Now();
    let milliseconds = (now.UnixSeconds() as uint64) * 1000 + ((now.SubsecondNanoseconds() / 1000000) as uint64);
    return TimeOrderedAt(milliseconds);
}

/// A version 7 UUID for a given millisecond, with entropy in the rest.
///
/// For reproducing an identifier from a recorded time, and for testing.
///
/// @param milliseconds the timestamp to embed, in milliseconds since the Unix epoch
/// @returns a version 7 value carrying `milliseconds`, or why entropy was unavailable
/// @see https://rux-lang.dev/docs/api/uuid/time-ordered-at
pub func TimeOrderedAt(milliseconds: uint64) -> Uuid ! EntropyError {
    var bytes: byte[16];
    Fill(@bytes[0] as *var opaque, 16)?;
    var value = Uuid::FromBytes((@bytes[0])[..16]);
    // Six bytes of milliseconds, most significant first — which is what makes byte order equal time order.
    var index: uint = 0;
    while index < 6 {
        let shift = ((5u - index) * 8) as uint64;
        value.bytes[index] = ((milliseconds >> shift) & 0xFF) as byte;
        index = index + 1;
    }
    value.bytes[6] = (value.bytes[6] & 0x0F) | 0x70;
    value.bytes[8] = (value.bytes[8] & 0x3F) | 0x80;
    return value;
}

/// The millisecond a version 7 UUID carries.
///
/// Meaningless for any other version, which is why the version should be checked first.
///
/// @param value the value to act on
/// @returns the timestamp a version 7 value carries; meaningless for any other version
/// @see https://rux-lang.dev/docs/api/uuid/millisecond-of
pub func MillisecondOf(value: &Uuid) -> uint64 {
    var milliseconds: uint64 = 0;
    var index: uint = 0;
    while index < 6 {
        milliseconds = (milliseconds << 8) | (value.bytes[index] as uint64);
        index = index + 1;
    }
    return milliseconds;
}

/// A generator of version 7 UUIDs that are strictly increasing, even within one millisecond.
///
/// The format guarantees ordering only between milliseconds; two UUIDs made in the same one have random tails
/// and may sort either way. This closes that by remembering the last value it produced: when the clock has not
/// advanced, it increments the previous UUID instead of drawing a fresh one, so every value it returns is
/// strictly greater than the last.
///
/// A caller owns one of these rather than sharing a global, so two components generating identifiers do not
/// serialize against each other or interleave into one sequence.
///
/// @see https://rux-lang.dev/docs/api/uuid/monotonic-uuid
pub struct MonotonicUuid {
    /// The last value returned, or nil before the first.
    previous: Uuid;
    /// Whether anything has been returned yet.
    started: bool;
}

extend MonotonicUuid {
    /// A generator that has produced nothing yet.
    ///
    /// @returns the generator, which has produced nothing yet
    /// @see https://rux-lang.dev/docs/api/uuid/monotonic-uuid/new
    pub func MonotonicUuid() -> MonotonicUuid {
        return MonotonicUuid { previous: Uuid::Nil(), started: false };
    }

    /// The next identifier, strictly greater than the one before it.
    ///
    /// @returns the next value, which sorts after every value this generator has produced, or why entropy was
    /// unavailable
    /// @see https://rux-lang.dev/docs/api/uuid/monotonic-uuid/next
    pub func Next(self: &var MonotonicUuid) -> Uuid ! EntropyError {
        let candidate = TimeOrdered()?;
        if !self.started {
            self.previous = candidate;
            self.started = true;
            return candidate;
        }
        // A fresh draw is used only if it already sorts above the last one; otherwise the previous value is
        // stepped, which keeps the sequence strictly increasing whatever the clock did — including going
        // backwards, which a clock adjustment can do.
        if candidate.Compare(self.previous) == Ordering::Greater {
            self.previous = candidate;
            return candidate;
        }
        var stepped = self.previous;
        var index: uint = 16;
        while index > 6 {
            index = index - 1;
            let octet = stepped.bytes[index];
            if octet != 0xFF {
                stepped.bytes[index] = octet + 1;
                self.previous = stepped;
                return stepped;
            }
            // This byte wrapped, so the carry continues into the one before it. The version and variant bytes
            // are never touched, so the identifier stays well-formed however far the carry travels.
            stepped.bytes[index] = 0;
        }
        // Every random bit was exhausted within one millisecond, which needs 2^74 identifiers. Returning the
        // previous value is the only answer that does not lie about being greater.
        return self.previous;
    }
}
