
// The text form, parsed strictly and written canonically.
//
// RFC 9562 defines exactly one textual representation: thirty-two hexadecimal digits in five hyphen-separated
// groups of 8-4-4-4-12, optionally prefixed by `urn:uuid:`. Everything else in circulation — the brace-wrapped
// form Windows tools print, the hyphen-free form some databases store, upper case mixed with lower — is
// something a program chose to accept, not something the standard blesses.
//
// This parses strictly on purpose. A lenient parser is pleasant right up to the moment two systems disagree
// about which strings are UUIDs, and then the disagreement is a security boundary: one accepts a string the
// other rejects, or worse, two different strings map to one identifier. Accepting exactly one form means two
// implementations of this cannot drift apart.
//
// Case is the one exception, and it is asymmetric by design: both cases are *read*, because the standard says
// they mean the same thing and rejecting upper case would break interoperation, but only lower case is
// *written*, because RFC 9562 says output should be lower case and a canonical form that varies is not
// canonical.
//
// A refusal says where. The reason alone tells a caller what kind of mistake was made; the offset tells them which
// character to point their own user at, which is the difference between "that is not a UUID" and an underline
// under the character that is wrong. The offsets are into the text as given, so the URN form's digits are numbered
// from the start of the whole string rather than from the start of the value inside it.
//
// Writing refuses a destination too small rather than filling what fits. A truncated UUID is not a shorter UUID; it
// is a different string, and one a strict parser refuses and a lenient one might not. The old writers stopped at
// the end of the buffer and said nothing, so a caller who had miscounted got thirty of the thirty-six characters
// and no way to learn it. Every writer here checks the room it needs before it writes a byte, so a refusal leaves
// the destination exactly as it was and a success is always the complete form.

import Core::{ Result, Unit };
import Text::{ Debug, Display, FormatError, FormatOk, FormatSpec, ParseFailure, StringView, TextWriter, WriteBytes };

/// How long the canonical text form is: thirty-two digits and four hyphens.
///
/// https://rux-lang.dev/docs/api/uuid/text-length
pub const UuidTextLength: uint = 36;

/// How long the URN form is: the canonical form after `urn:uuid:`.
///
/// https://rux-lang.dev/docs/api/uuid/urn-length
pub const UuidUrnLength: uint = 45;

/// Why text could not be read as a UUID.
///
/// Failure-only: every case is a failure, and each carries the zero-based UTF-8 byte offset into the text where it
/// was found. Success is `Result::Success`, so there is no case here meaning nothing went wrong.
///
/// Copy, carrying one offset and owning nothing.
///
/// @see https://rux-lang.dev/docs/api/uuid/parse-error
pub variant UuidParseError {
    /// The text is neither thirty-six characters nor forty-five with the URN prefix. The offset is the text's
    /// length when it is too short, which is where the missing character would have gone, and the first character
    /// the canonical form has no room for when it is too long.
    WrongLength(uint),
    /// A hyphen is missing where the form puts one, or one appears where a digit belongs. The offset is that
    /// character.
    Misplaced(uint),
    /// A character that is not a hexadecimal digit. The offset is that character.
    NotHexadecimal(uint),
    /// The text has the length of the URN form but its `urn:uuid:` prefix is misspelled. The offset is the first
    /// character that does not match.
    BadPrefix(uint)
}

extend UuidParseError : ParseFailure {
    /// Where in the input the failure was found.
    ///
    /// Borrows the error and leaves it untouched. Cannot fail; runs in constant time and allocates nothing.
    ///
    /// @returns the zero-based UTF-8 byte offset, which is the text's length at end of input
    /// @see https://rux-lang.dev/docs/api/uuid/parse-error/offset
    pub func Offset(self: &UuidParseError) -> uint {
        return match self {
            .WrongLength(at) => at,
            .Misplaced(at) => at,
            .NotHexadecimal(at) => at,
            .BadPrefix(at) => at
        };
    }
}

// The value of one hexadecimal digit, or sixteen for anything else.
func HexValue(c: uint8) -> uint8 {
    if c >= 0x30u8 && c <= 0x39u8 { return c - 0x30u8; }
    if c >= 0x61u8 && c <= 0x66u8 { return c - 0x61u8 + 10u8; }
    if c >= 0x41u8 && c <= 0x46u8 { return c - 0x41u8 + 10u8; }
    return 16u8;
}

// Where the four hyphens belong in the canonical form.
func IsHyphenPosition(index: uint) -> bool {
    return index == 8u || index == 13u || index == 18u || index == 23u;
}

/// Reads a UUID from its canonical or URN text form.
///
/// Both cases of the digits are accepted, because the standard says the two mean the same thing; nothing else is.
/// The URN prefix is compared case-insensitively, which is RFC 8141's rule for a scheme name and a different rule
/// from the digits — both are the standard's.
///
/// # Failures
/// Reports `WrongLength` for text that is neither form's length, `BadPrefix` for a misspelled `urn:uuid:`,
/// `Misplaced` for a hyphen that is missing or one that stands where a digit belongs, and `NotHexadecimal` for any
/// other character that is not a digit. Each carries the byte offset into `text` where it was found. A refused
/// parse produces no value at all rather than a half-filled one.
///
/// @param text the text to read
/// @returns the identifier, or why the text is not one
/// @see https://rux-lang.dev/docs/api/uuid/parse
pub func Parse(text: char8[..]) -> Result<Uuid, UuidParseError> {
    var start: uint = 0;
    if text.length == UuidUrnLength {
        let prefix = "urn:uuid:";
        var index: uint = 0;
        while index < 9u {
            var mine = text.data[index] as uint8;
            if mine >= 0x41u8 && mine <= 0x5Au8 {
                mine = mine + 32u8;
            }
            if mine != (prefix.data[index] as uint8) {
                return Result::Error<Uuid, UuidParseError>(UuidParseError::BadPrefix(index));
            }
            index = index + 1;
        }
        start = 9u;
    }
    else if text.length != UuidTextLength {
        // Too short, and the offset is the end of the text, where the character that is missing would go. Too long,
        // and it is the first character past the form, which is the one that has nowhere to be.
        let at = text.length < UuidTextLength ? text.length : UuidTextLength;
        return Result::Error<Uuid, UuidParseError>(UuidParseError::WrongLength(at));
    }

    var value = Uuid::Nil();
    var position: uint = 0;
    var byteIndex: uint = 0;
    var pending = 0u8;
    var haveHigh = false;
    while position < UuidTextLength {
        let at = start + position;
        let c = text.data[at] as uint8;
        if IsHyphenPosition(position) {
            if c != 0x2Du8 {
                return Result::Error<Uuid, UuidParseError>(UuidParseError::Misplaced(at));
            }
        }
        else {
            let digit = HexValue(c);
            if digit == 16u8 {
                // A hyphen where a digit belongs is a misplacement rather than a bad character, which is a more
                // useful thing to be told: the digits are right and the grouping is not.
                if c == 0x2Du8 {
                    return Result::Error<Uuid, UuidParseError>(UuidParseError::Misplaced(at));
                }
                return Result::Error<Uuid, UuidParseError>(UuidParseError::NotHexadecimal(at));
            }
            if haveHigh {
                value.bytes[byteIndex] = ((pending << 4u8) | digit) as char8;
                byteIndex = byteIndex + 1u;
                haveHigh = false;
            }
            else {
                pending = digit;
                haveHigh = true;
            }
        }
        position = position + 1u;
    }
    return Result::Success<Uuid, UuidParseError>(value);
}

/// Reads a UUID from the text a `StringView` borrows.
///
/// The same parser, reached without the caller unwrapping the view first: a `StringView` is already validated
/// UTF-8, and a UUID's text is ASCII, so the bytes it borrows are exactly what the canonical form is made of.
///
/// # Failures
/// The failures the slice form reports, with offsets into the borrowed text.
///
/// @param text the text to read
/// @returns the identifier, or why the text is not one
/// @see https://rux-lang.dev/docs/api/uuid/parse
pub func Parse(text: StringView) -> Result<Uuid, UuidParseError> {
    return Parse(text.Bytes());
}

// Writes the canonical form into the first thirty-six bytes of `into`, which the caller has already checked is
// long enough. Split out so that the buffer writers and the `Display` implementation produce one form from one
// piece of code rather than from two that can drift.
func WriteCanonicalInto(value: &Uuid, into: var char8[..]) {
    let digits = "0123456789abcdef";
    var position: uint = 0;
    var byteIndex: uint = 0;
    while position < UuidTextLength {
        if IsHyphenPosition(position) {
            into.data[position] = 0x2Du8 as char8;
        }
        else {
            let octet = value.bytes[byteIndex / 2u] as uint8;
            let nibble = (byteIndex % 2u) == 0u ? (octet >> 4u8) : (octet & 0x0Fu8);
            into.data[position] = digits.data[nibble as uint];
            byteIndex = byteIndex + 1u;
        }
        position = position + 1u;
    }
}

/// Writes the canonical text form into `into`, in lower case.
///
/// Lower case because RFC 9562 says so, and because a canonical form that varies by case is not canonical — two
/// systems comparing text would disagree about equal UUIDs.
///
/// # Failures
/// Reports `InsufficientCapacity` when `into` is shorter than `UuidTextLength`, leaving it exactly as it was. A
/// short destination is refused rather than filled with what fits, because a truncated UUID is a different string
/// rather than a shorter one. Room past the thirty-six characters is not touched.
///
/// @param value the identifier to write
/// @param into the destination, at least `UuidTextLength` bytes
/// @returns success when the whole form was written
/// @see https://rux-lang.dev/docs/api/uuid/format
pub func Format(value: &Uuid, into: var char8[..]) -> Result<Unit, FormatError> {
    if into.length < UuidTextLength { return Result::Error<Unit, FormatError>(FormatError::InsufficientCapacity); }
    WriteCanonicalInto(value, into);
    return FormatOk();
}

/// Writes the canonical text form into `into`, in upper case.
///
/// Offered because some formats demand it; `Format` is what a program should write when it has the choice.
///
/// # Failures
/// The failure `Format` reports, for the same reason and with the same guarantee.
///
/// @param value the identifier to write
/// @param into the destination, at least `UuidTextLength` bytes
/// @returns success when the whole form was written
/// @see https://rux-lang.dev/docs/api/uuid/format-upper
pub func FormatUpper(value: &Uuid, into: var char8[..]) -> Result<Unit, FormatError> {
    if into.length < UuidTextLength { return Result::Error<Unit, FormatError>(FormatError::InsufficientCapacity); }
    WriteCanonicalInto(value, into);
    var index: uint = 0;
    while index < UuidTextLength {
        let c = into.data[index] as uint8;
        if c >= 0x61u8 && c <= 0x7Au8 {
            into.data[index] = (c - 32u8) as char8;
        }
        index = index + 1;
    }
    return FormatOk();
}

/// Writes the URN form into `into`: the canonical form after `urn:uuid:`.
///
/// # Failures
/// Reports `InsufficientCapacity` when `into` is shorter than `UuidUrnLength`, leaving it exactly as it was. The
/// form is refused whole, so a destination never receives a prefix with nothing after it.
///
/// @param value the identifier to write
/// @param into the destination, at least `UuidUrnLength` bytes
/// @returns success when the whole form was written
/// @see https://rux-lang.dev/docs/api/uuid/format-urn
pub func FormatUrn(value: &Uuid, into: var char8[..]) -> Result<Unit, FormatError> {
    if into.length < UuidUrnLength { return Result::Error<Unit, FormatError>(FormatError::InsufficientCapacity); }
    let prefix = "urn:uuid:";
    var index: uint = 0;
    while index < 9u {
        into.data[index] = prefix.data[index];
        index = index + 1;
    }
    let rest = (@into.data[9])[..UuidTextLength];
    WriteCanonicalInto(value, rest);
    return FormatOk();
}

// The empty style is the canonical form and `hyphenated` names it; `urn` selects the URN form. Nothing else is
// understood, and a precision has nothing to apply itself to on a value of exactly one length.
func AcceptsUuidSpec(spec: FormatSpec) -> Result<Unit, FormatError> {
    if spec.HasPrecision() { return Result::Error<Unit, FormatError>(FormatError::UnsupportedRequest); }
    if !spec.HasStyle() || spec.StyleIs("hyphenated") || spec.StyleIs("urn") { return FormatOk(); }
    return Result::Error<Unit, FormatError>(FormatError::UnsupportedRequest);
}

extend Uuid : Display {
    /// Writes the canonical lower-case form, or the URN form under the `urn` style.
    ///
    /// The default is the hyphenated form RFC 9562 defines, in lower case, because that is the one representation
    /// the standard has and the one every other implementation writes. `hyphenated` names it explicitly and `urn`
    /// selects the `urn:uuid:` form. Upper case is not a style, since a canonical form that varies by case is not
    /// canonical; `FormatUpper` remains for a format that demands it.
    ///
    /// # Failures
    /// Reports whatever the writer reported, and `UnsupportedRequest` for any other style or for a precision, which
    /// a value of exactly one length has nothing to apply.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the whole form was accepted
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/write-display
    pub func WriteDisplay(self: &Uuid, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        AcceptsUuidSpec(spec)?;
        if spec.StyleIs("urn") { WriteBytes(writer, "urn:uuid:")?; }
        var text: char8[36];
        WriteCanonicalInto(self, (@text[0])[..UuidTextLength]);
        return WriteBytes(writer, (@text[0])[..UuidTextLength]);
    }
}

extend Uuid : Debug {
    /// The same text as `Display`: an identifier has one reading, and quoting it would say nothing extra.
    ///
    /// # Failures
    /// The failures `WriteDisplay` reports.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the whole form was accepted
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/write-debug
    pub func WriteDebug(self: &Uuid, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        return self.WriteDisplay(writer, spec);
    }
}
