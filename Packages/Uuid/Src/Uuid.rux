// A UUID: sixteen bytes, and the small amount of structure RFC 9562 gives them.
//
// The bytes are held in the order the standard defines, which is the order they are written in and the order
// they travel in on the wire. That is worth saying because Microsoft's GUID is the same sixteen bytes with the
// first three fields byte-swapped, and a program reading one as the other gets a value that looks entirely
// plausible and is wrong — so the conversion between them is explicit and lives in its own function rather
// than happening implicitly anywhere.
//
// Ordering is by the byte sequence, which for a version 7 UUID means ordering by time, since its timestamp sits
// at the front in big-endian order. That is the whole reason version 7 exists, and it only works if comparison
// never reorders the bytes.

import Core::Ordering;

/// A universally unique identifier: sixteen bytes in the standard's own order.
///
/// @see https://rux-lang.dev/docs/api/uuid/uuid
pub struct Uuid {
    /// The sixteen bytes, most significant first.
    pub bytes: byte[16];
}

/// What layout a UUID's bytes follow.
///
/// @see https://rux-lang.dev/docs/api/uuid/variant
pub enum UuidVariant: int32 {
    /// Apollo NCS, from before the standard — the layout the nil UUID also happens to match.
    NetworkComputingSystem = 0,
    /// The layout RFC 9562 defines, which is what essentially every UUID in use is.
    Standard = 1,
    /// Microsoft's early variant: reserved, and rare.
    Microsoft = 2,
    /// Reserved for the future and never assigned.
    Future = 3
}

extend Uuid {
    /// The nil UUID: sixteen zero bytes.
    ///
    /// A defined value rather than an absence, and worth having as one — the alternative is every caller
    /// inventing a sentinel of their own.
    ///
    /// @returns the all-zero value
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/nil
    pub func Nil() -> Uuid {
        var value = Uuid { bytes: [0; 16] };
        return value;
    }

    /// The max UUID: sixteen bytes of ones, which RFC 9562 defines as nil's counterpart.
    ///
    /// @returns the all-ones value
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/max
    pub func Max() -> Uuid {
        var value = Uuid::Nil();
        var index: uint = 0;
        while index < 16 {
            value.bytes[index] = 0xFF;
            index = index + 1;
        }
        return value;
    }

    /// A UUID from sixteen bytes in the standard's order.
    ///
    /// Fewer than sixteen leaves the rest zero; more are ignored. No structure is imposed — the version and
    /// variant fields are whatever the bytes say, which is what lets this read a UUID from somewhere else.
    ///
    /// @param bytes sixteen bytes to take as the value, in big-endian order
    /// @returns those sixteen bytes as a value, with no field interpreted or corrected
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/from-bytes
    pub func FromBytes(bytes: byte[..]) -> Uuid {
        var value = Uuid::Nil();
        var index: uint = 0;
        while index < 16 && index < bytes.length {
            value.bytes[index] = bytes.data[index];
            index = index + 1;
        }
        return value;
    }

    /// The sixteen bytes, in the standard's order.
    ///
    /// @returns the sixteen bytes, in big-endian order
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/bytes
    pub func Bytes(self: &Uuid) -> byte[..] {
        return (@self.bytes[0])[..16];
    }

    /// Whether this is the nil UUID.
    ///
    /// @returns whether every byte is zero
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/is-nil
    pub func IsNil(self: &Uuid) -> bool {
        var index: uint = 0;
        while index < 16 {
            if self.bytes[index] != 0 { return false; }
            index = index + 1;
        }
        return true;
    }

    /// Whether this is the max UUID.
    ///
    /// @returns whether every byte is one
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/is-max
    pub func IsMax(self: &Uuid) -> bool {
        var index: uint = 0;
        while index < 16 {
            if self.bytes[index] != 0xFF { return false; }
            index = index + 1;
        }
        return true;
    }

    /// The version, from the high nibble of the seventh byte.
    ///
    /// Meaningful only for the standard variant; a nil or max UUID reports a number that means nothing, which
    /// is why `Variant` should be consulted first.
    ///
    /// @returns the version nibble, 0 through 15; a value this package did not make may hold anything
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/version
    pub func Version(self: &Uuid) -> uint8 {
        return (self.bytes[6] >> 4) & 0x0F;
    }

    /// The variant, from the high bits of the ninth byte.
    ///
    /// The encoding is variable-length rather than two fixed bits: a leading zero means the oldest layout, `10`
    /// the standard one, `110` Microsoft's, and `111` the reserved future.
    ///
    /// @returns the variant the layout declares
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/variant
    pub func Variant(self: &Uuid) -> UuidVariant {
        let octet = self.bytes[8];
        if (octet & 0x80) == 0 { return UuidVariant::NetworkComputingSystem; }
        if (octet & 0x40) == 0 { return UuidVariant::Standard; }
        if (octet & 0x20) == 0 { return UuidVariant::Microsoft; }
        return UuidVariant::Future;
    }

    /// Whether two UUIDs are the same.
    ///
    /// @param other the value to compare against
    /// @returns whether all sixteen bytes match
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/equals
    pub func Equals(self: &Uuid, other: &Uuid) -> bool {
        var index: uint = 0;
        while index < 16 {
            if self.bytes[index] != other.bytes[index] { return false; }
            index = index + 1;
        }
        return true;
    }

    /// Orders two UUIDs by their bytes, most significant first.
    ///
    /// For a version 7 UUID this is chronological order, because its timestamp occupies the leading bytes in
    /// big-endian form. Reordering here — to match a platform's GUID layout, say — would destroy that, which
    /// is why the byte order is fixed rather than negotiable.
    ///
    /// @param other the value to compare against
    /// @returns how the two order as sixteen big-endian bytes, which is lexicographic order for the text
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/compare
    pub func Compare(self: &Uuid, other: &Uuid) -> Ordering {
        var index: uint = 0;
        while index < 16 {
            if self.bytes[index] < other.bytes[index] { return Ordering::Less; }
            if self.bytes[index] > other.bytes[index] { return Ordering::Greater; }
            index = index + 1;
        }
        return Ordering::Equal;
    }

    /// A hash of the sixteen bytes, for use as a table key.
    ///
    /// FNV-1a, which is not a cryptographic hash and does not need to be: a UUID is already the output of one,
    /// or of an entropy source, so what a table wants here is speed and an even spread over buckets.
    ///
    /// @returns the value's hash
    /// @see https://rux-lang.dev/docs/api/uuid/uuid/hash
    pub func Hash(self: &Uuid) -> uint64 {
        var accumulated: uint64 = 0xCBF29CE484222325;
        var index: uint = 0;
        while index < 16 {
            accumulated = accumulated ^ (self.bytes[index] as uint64);
            accumulated = accumulated * 0x100000001B3;
            index = index + 1;
        }
        return accumulated;
    }
}
