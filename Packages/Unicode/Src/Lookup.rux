// Binary search over the generated tables.
// Every table is a flat, sorted `uint32` array: pairs of (first, last) for a boolean property, triples of
// (first, last, value) where a range carries one, and (key, offset, length) index triples over an element pool
// where a code point maps to a sequence. Three searches serve all of them, and everything else in the package is
// written against these rather than against the arrays' shapes.


// Whether `cp` falls in any (first, last) pair of `table`.
func InRangePairs(table: uint32[..], cp: uint32) -> bool {
    var low: uint = 0;
    var high = table.length / 2;
    while low < high {
        let middle = (low + high) / 2;
        // Safety: `middle` is below `high`, which never exceeds `table.length / 2`, so the pair's two values at
        // `middle * 2` and `middle * 2 + 1` lie inside `table`.
        let first = unsafe { table.data[middle * 2] };
        // Safety: the same bound, `middle < table.length / 2`, keeps `middle * 2 + 1` inside `table`.
        let last = unsafe { table.data[middle * 2 + 1] };
        if cp < first {
            high = middle;
        }
        else if cp > last {
            low = middle + 1;
        }
        else {
            return true;
        }
    }
    return false;
}

// The value of the (first, last, value) triple holding `cp`, or `fallback`.
func RangeValue(table: uint32[..], cp: uint32, fallback: uint32) -> uint32 {
    var low: uint = 0;
    var high = table.length / 3;
    while low < high {
        let middle = (low + high) / 2;
        // Safety: `middle` is below `high`, which never exceeds `table.length / 3`, so the triple's values at
        // `middle * 3` through `middle * 3 + 2` lie inside `table`.
        let first = unsafe { table.data[middle * 3] };
        // Safety: the same bound, `middle < table.length / 3`, keeps `middle * 3 + 1` inside `table`.
        let last = unsafe { table.data[middle * 3 + 1] };
        if cp < first {
            high = middle;
        }
        else if cp > last {
            low = middle + 1;
        }
        else {
            // Safety: the same bound, `middle < table.length / 3`, keeps `middle * 3 + 2` inside `table`.
            return unsafe { table.data[middle * 3 + 2] };
        }
    }
    return fallback;
}

// Finds `key` in a (key, offset, length) index and reports its pool window, or reports `false` and leaves the
// window untouched. `offset` and `length` must be non-null and writable.
func IndexWindow(table: uint32[..], key: uint32, offset: *var uint, length: *var uint) -> bool {
    var low: uint = 0;
    var high = table.length / 3;
    while low < high {
        let middle = (low + high) / 2;
        // Safety: `middle` is below `high`, which never exceeds `table.length / 3`, so `middle * 3` lies inside
        // `table`.
        let found = unsafe { table.data[middle * 3] };
        if key < found {
            high = middle;
        }
        else if key > found {
            low = middle + 1;
        }
        else {
            // Safety: `middle < table.length / 3` keeps `middle * 3 + 1` and `middle * 3 + 2` inside `table`, and the
            // documented contract makes `offset` and `length` non-null pointers to the caller's writable `uint`s.
            unsafe {
                *offset = table.data[middle * 3 + 1] as uint;
                *length = table.data[middle * 3 + 2] as uint;
            }
            return true;
        }
    }
    return false;
}

// The mapped value of `key` in a (key, value) pair table, or `key` itself: a case table's absence means the point
// maps to itself.
func PairValue(table: uint32[..], key: uint32) -> uint32 {
    var low: uint = 0;
    var high = table.length / 2;
    while low < high {
        let middle = (low + high) / 2;
        // Safety: `middle` is below `high`, which never exceeds `table.length / 2`, so `middle * 2` lies inside
        // `table`.
        let found = unsafe { table.data[middle * 2] };
        if key < found {
            high = middle;
        }
        else if key > found {
            low = middle + 1;
        }
        else {
            // Safety: the same bound, `middle < table.length / 2`, keeps `middle * 2 + 1` inside `table`.
            return unsafe { table.data[middle * 2 + 1] };
        }
    }
    return key;
}
