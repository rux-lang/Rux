import Core::string;
// Where text is assembled.
//
// A `String` is immutable, so building one a piece at a time through `String` alone would allocate and copy on every
// step -- quadratic work to produce a linear result. A builder keeps spare room and doubles it, so a sequence of
// appends costs each byte a constant amount on average, and hands the block over at the end without copying it.
//
// The builder holds well-formed UTF-8 at every moment, not only at the end. That is why it accepts whole characters
// and checked runs of bytes rather than arbitrary ones: a builder that could hold half a character would make
// `View` a lie and `IntoString` a validation pass. Appending an incomplete sequence is refused rather than deferred.
//
// It prohibits copying and `~StringBuilder` gives its block back. `IntoString` transfers the block without copying;
// after it the builder owns nothing and is ready to be used again.

import Allocator::{ AllocError, Allocator, Layout };
import Core::{ MulChecked, MutableSlice, Option, Slice };
import Memory::Copy;

/// The room a builder takes when it first needs any.
///
/// Small enough that a builder for a short string wastes little, large enough that short strings never grow twice.
///
/// https://rux-lang.dev/docs/api/text/minimum-builder-capacity
pub const MinimumBuilderCapacity: uint = 16;

/// A growable buffer of text.
///
/// Move-only: it explicitly prohibits copying and owns its block. Holds well-formed UTF-8 at every moment.
///
/// https://rux-lang.dev/docs/api/text/string-builder
pub struct StringBuilder {
    /// The block, or null when the builder has never needed one.
    data: *var char8;
    /// How many bytes are in use.
    length: uint;
    /// How many bytes the block holds.
    capacity: uint;
    /// Where the block came from, and where it goes back to.
    allocator: Allocator;
}

extend StringBuilder {
    /// Copying a builder would give two owners of one mutable block.
    func =(self: &var StringBuilder, other: &StringBuilder);

    /// A builder that has allocated nothing.
    ///
    /// `allocator` is borrowed for the call and kept.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/new
    pub func StringBuilder(allocator: Allocator) -> StringBuilder {
        return StringBuilder { data: null, length: 0, capacity: 0, allocator: allocator };
    }

    /// A builder with room for `capacity` bytes already taken.
    ///
    /// Worth using when the size is known or can be guessed well: appends that stay within the room never
    /// reallocate. `error` receives `OutOfMemory` when the room cannot be had, and the builder comes back empty.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/with-capacity
    pub func WithCapacity(allocator: Allocator, capacity: uint, error: *var TextError) -> StringBuilder {
        var builder = StringBuilder(allocator);
        *error = builder.Reserve(capacity);
        return <-builder;
    }

    /// How many bytes are in use.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/length
    pub func Length(self: &StringBuilder) -> uint {
        return self.length;
    }

    /// How many bytes the block holds.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/capacity
    pub func Capacity(self: &StringBuilder) -> uint {
        return self.capacity;
    }

    /// Whether nothing has been appended.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/is-empty
    pub func IsEmpty(self: &StringBuilder) -> bool {
        return self.length == 0;
    }

    /// The bytes in use, borrowed.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/bytes
    pub func Bytes(self: &StringBuilder) -> Slice<char8> {
        return Slice<char8> { data: self.data, length: self.length };
    }

    /// A view over what has been appended so far.
    ///
    /// Free, and needs no checking: everything the builder accepts is whole characters, so what it holds is
    /// well-formed at every moment rather than only once it is finished.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/view
    pub func View(self: &StringBuilder) -> StringView {
        return StringView::FromValidated(self.Bytes());
    }

    /// Makes sure there is room for `additional` more bytes.
    ///
    /// Reports `OutOfMemory` when the room cannot be had and `LengthOverflow` when the size needed cannot be
    /// expressed, having in both cases changed nothing: a builder that fails to grow still holds what it held.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/reserve
    pub func Reserve(self: &var StringBuilder, additional: uint) -> TextError {
        return ReserveBuilderStorage(@self.data, self.length, @self.capacity, self.allocator, additional);
    }
}

// Shared by the safe receiver and the deliberately raw stored-writer adapter. Only field addresses cross this
// boundary; the owning builder itself remains non-copyable and all public owner operations use references.
func ReserveBuilderStorage(data: *var *var char8, length: uint, capacity: *var uint, allocator: Allocator,
                           additional: uint) -> TextError {
        if additional == 0 { return TextError::None; }
        if additional > 0xFFFFFFFFFFFFFFFFu - length { return TextError::LengthOverflow; }
        let required = length + additional;
        if required <= *capacity { return TextError::None; }

        // Doubling is what makes a run of appends linear rather than quadratic; asking for exactly what is needed
        // would reallocate on nearly every one. Where doubling is not enough, or would overflow, take the
        // requirement itself.
        var doubled: uint = 0;
        var wanted = required;
        if MulChecked<uint>(*capacity, 2, @doubled) && doubled > required {
            wanted = doubled;
        }
        if wanted < MinimumBuilderCapacity {
            wanted = MinimumBuilderCapacity;
        }

        let layout = Layout::New(wanted, 1);
        if layout.IsNone() { return TextError::LengthOverflow; }
        let want = layout.ValueOr(Layout { size: wanted, alignment: 1 });
        var borrowed = allocator;
        var block: *var opaque = null;
        if *data == null {
            let allocated = borrowed.Allocate(want, @block);
            if allocated != AllocError::None { return FromAllocError(allocated); }
        }
        else {
            let have = Layout::New(*capacity, 1).ValueOr(Layout { size: *capacity, alignment: 1 });
            let moved = borrowed.Reallocate(*data as *var opaque, have, want, @block);
            if moved != AllocError::None { return FromAllocError(moved); }
        }
        *data = block as *var char8;
        *capacity = wanted;
        return TextError::None;
}

extend StringBuilder {
    /// Appends bytes the caller vouches are UTF-8.
    ///
    /// # Safety
    ///
    /// The bytes must be well-formed UTF-8 and must not end part-way through a character. The builder's promise
    /// that it holds text at every moment rests on this, and everything reading from it relies on that promise.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/append-validated
    pub func AppendValidated(self: &var StringBuilder, bytes: Slice<char8>) -> TextError {
        return AppendBuilderStorage(@self.data, @self.length, @self.capacity, self.allocator, bytes);
    }

    /// Appends what `view` spans.
    ///
    /// The view was checked when it was made, so nothing is checked again.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/append
    pub func Append(self: &var StringBuilder, view: StringView) -> TextError {
        return self.AppendValidated(view.bytes);
    }

    /// Appends `text`.
    ///
    /// Text was checked before it existed, so nothing is checked again and nothing can fail but the storage.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/append
    pub func Append(self: &var StringBuilder, text: string) -> TextError {
        return self.AppendValidated(Slice<char8> { data: text.data, length: text.length });
    }

    /// Appends `bytes` when they are UTF-8, and reports `InvalidUtf8` when they are not.
    ///
    /// Costs a pass over the bytes. `Append` of a view costs none, which is the reason views exist.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/append-bytes
    pub func AppendBytes(self: &var StringBuilder, bytes: Slice<char8>) -> TextError {
        var failureIndex: uint = 0;
        if Validate(bytes, @failureIndex).IsError() { return TextError::InvalidUtf8; }
        return self.AppendValidated(bytes);
    }

    /// Appends one character.
    ///
    /// Reports `InvalidUtf8` for a value that is not a scalar value -- a surrogate half, or one past U+10FFFF --
    /// which is what keeps a builder from holding something that is not text.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/append-scalar
    pub func AppendScalar(self: &var StringBuilder, scalar: char32) -> TextError {
        var encoded: char8[4];
        var written: uint = 0;
        let sink = MutableSlice::From<char8>(@encoded[0], 4);
        if Encode(scalar, sink, @written).IsError() { return TextError::InvalidUtf8; }
        return self.AppendValidated(Slice<char8> { data: @encoded[0], length: written });
    }

    /// Appends one ASCII byte.
    ///
    /// Reports `InvalidUtf8` for a byte above 0x7F, since a single byte above that is never a whole character;
    /// `AppendScalar` is what appends one that takes more than a byte.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/append-ascii
    pub func AppendAscii(self: &var StringBuilder, byte: char8) -> TextError {
        if (byte as uint32) > 0x7F { return TextError::InvalidUtf8; }
        var one: char8[1];
        one[0] = byte;
        return self.AppendValidated(Slice<char8> { data: @one[0], length: 1 });
    }

    /// Forgets everything appended, keeping the room.
    ///
    /// The block is kept, so a builder used in a loop allocates once rather than once per pass.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/clear
    pub func Clear(self: &var StringBuilder) {
        self.length = 0;
    }

    /// Gives the block back and leaves a builder that owns nothing.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/release
    pub func Release(self: &var StringBuilder) {
        if self.data != null {
            let layout = Layout::New(self.capacity, 1);
            var borrowed = self.allocator;
            borrowed.Deallocate(self.data as *var opaque,
                                layout.ValueOr(Layout { size: self.capacity, alignment: 1 }));
        }
        self.data = null;
        self.length = 0;
        self.capacity = 0;
    }

    /// A copy of what has been appended, as a string of its own.
    ///
    /// The builder is untouched and may be appended to again. `IntoString` is what hands the block over instead of
    /// copying it, and is what to use when the builder is finished with.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/to-string
    pub func ToString(self: &StringBuilder, error: *var TextError) -> String {
        return String::FromValidated(self.allocator, self.Bytes(), error);
    }

    /// Hands the block over as a string, leaving the builder owning nothing.
    ///
    /// Copies nothing: the string that comes back is the builder's block, which is why the builder must give it up.
    /// The block usually has room to spare, and the string remembers how much so that the allocator gets back the
    /// layout it handed out.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/into-string
    pub func IntoString(self: &var StringBuilder) -> String {
        let taken = String {
            data: self.data,
            length: self.length,
            capacity: self.capacity,
            allocator: self.allocator
        };
        self.data = null;
        self.length = 0;
        self.capacity = 0;
        return <-taken;
    }
}

func AppendBuilderStorage(data: *var *var char8, length: *var uint, capacity: *var uint, allocator: Allocator,
                          bytes: Slice<char8>) -> TextError {
    if bytes.length == 0 { return TextError::None; }
    let room = ReserveBuilderStorage(data, *length, capacity, allocator, bytes.length);
    if room.IsError() { return room; }
    Copy(@(*data)[*length] as *var opaque, bytes.data as *opaque, bytes.length);
    *length = *length + bytes.length;
    return TextError::None;
}

extend StringBuilder {
    /// Gives the block back.
    ///
    /// Runs when the builder dies. A builder whose block was handed over by `IntoString` owns nothing, so this is
    /// then a no-op rather than a second release.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/destructor
    func ~StringBuilder(self: &var StringBuilder) {
        self.Release();
    }
}
