// Where text is assembled.
// A `String` is immutable, so building one a piece at a time through `String` alone would allocate and copy on every
// step — quadratic work to produce a linear result. A builder keeps spare room and doubles it, so a sequence of
// appends costs each byte a constant amount on average, and hands the block over at the end without copying it.
// The builder holds well-formed UTF-8 at every moment, not only at the end. That is why it accepts whole characters
// and checked runs of bytes rather than arbitrary ones: a builder that could hold half a character would make
// `View` a lie and `IntoString` a validation pass. Appending an incomplete sequence is refused rather than deferred.
// It prohibits copying and `~StringBuilder` gives its block back. `IntoString` transfers the block without copying;
// after it the builder owns nothing and is ready to be used again.
// A builder that cannot grow terminates the program. `TryReserve` is for the code that can recover: it throws the
// allocator's `AllocError` and leaves the builder as it was, and once it has succeeded the appends that fit in the
// room it took allocate nothing.

import Allocator::{ AllocError, AllocationFailed, Allocator, Layout };
import Core::MulChecked;
import Memory::Copy;

/// The room a builder takes when it first needs any.
/// Small enough that a builder for a short string wastes little, large enough that short strings never grow twice.
/// @see https://rux-lang.dev/docs/api/text/string-builder#minimum-builder-capacity
pub const MinimumBuilderCapacity: uint = 16;

/// A growable buffer of text.
/// Move-only: it explicitly prohibits copying and owns its block. Holds well-formed UTF-8 at every moment.
/// Storage invariant, which every operation keeps and every `unsafe` block here relies on: `length <= capacity`;
/// `data` is null exactly when `capacity` is zero, and otherwise addresses a block of `capacity` bytes from
/// `allocator` whose first `length` bytes are initialized, well-formed UTF-8.
/// @see https://rux-lang.dev/docs/api/text/string-builder
pub struct StringBuilder {
    /// The block, or null when the builder has never needed one.
    data: *var char8;
    /// How many bytes are in use.
    length: uint;
    /// How many bytes the block holds.
    capacity: uint;
    /// Where the block came from, and where it goes back to.
    allocator: Allocator;
}

extend StringBuilder {
    /// A builder that has allocated nothing.
    /// `allocator` is borrowed for the call and kept.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// @param allocator where the storage comes from
    /// @returns an empty builder that has taken no storage yet
    /// @see https://rux-lang.dev/docs/api/text/string-builder#new
    pub func StringBuilder(allocator: Allocator) -> Self {
        return Self { data: null, length: 0, capacity: 0, allocator };
    }

    /// A builder with room for `capacity` bytes already taken.
    /// Worth using when the size is known or can be guessed well: appends that stay within the room never
    /// reallocate. Terminates the program when the room cannot be had.
    /// @param allocator where the storage comes from
    /// @param capacity how many bytes to reserve up front
    /// @returns an empty builder with room for that many bytes already taken
    /// @see https://rux-lang.dev/docs/api/text/string-builder#with-capacity
    pub func WithCapacity(allocator: Allocator, capacity: uint) -> Self {
        var builder = StringBuilder(allocator);
        builder.Reserve(capacity);
        return move builder;
    }

    /// How many bytes are in use.
    /// @returns how many bytes have been appended
    /// @see https://rux-lang.dev/docs/api/text/string-builder#length
    pub func Length(&self) -> uint {
        return self.length;
    }

    /// How many bytes the block holds.
    /// @returns how many bytes fit before the next growth
    /// @see https://rux-lang.dev/docs/api/text/string-builder#capacity
    pub func Capacity(&self) -> uint {
        return self.capacity;
    }

    /// Whether nothing has been appended.
    /// @returns whether nothing has been appended
    /// @see https://rux-lang.dev/docs/api/text/string-builder#is-empty
    pub func IsEmpty(&self) -> bool {
        return self.length == 0;
    }

    /// The bytes in use, borrowed.
    /// @returns the appended bytes, borrowed
    /// @see https://rux-lang.dev/docs/api/text/string-builder#bytes
    pub func Bytes(&self) -> char8[..] {
        // Safety: the storage invariant: the first `length` bytes at `data` are initialized and owned by this
        // builder.
        return unsafe { (self.data)[..self.length] };
    }

    /// A view over what has been appended so far.
    /// Free, and needs no checking: everything the builder accepts is whole characters, so what it holds is
    /// well-formed at every moment rather than only once it is finished.
    /// @returns a borrowed view of what has been appended
    /// @see https://rux-lang.dev/docs/api/text/string-builder#view
    pub func View(&self) -> StringView {
        return StringView::FromValidated(self.Bytes());
    }

    /// Makes sure there is room for `additional` more bytes.
    /// Terminates the program when the room cannot be had or the size needed cannot be expressed; `TryReserve`
    /// reports both instead.
    /// @param additional how many more bytes to make room for
    /// @see https://rux-lang.dev/docs/api/text/string-builder#reserve
    pub func Reserve(&var self, additional: uint) {
        // Safety: the three addresses are this builder's own fields, which hold the storage invariant.
        unsafe { ReserveBuilderStorage(@self.data, self.length, @self.capacity, self.allocator, additional); }
    }

    /// Makes sure there is room for `additional` more bytes, or throws why there is none.
    /// Throws `Unsupported` when the size needed cannot be expressed, and otherwise whatever the allocator refused
    /// with, having in both cases changed nothing: a builder that fails to grow still holds what it held.
    /// @param additional how many more bytes to make room for
    /// @returns nothing, or throws the allocator's refusal
    /// @see https://rux-lang.dev/docs/api/text/string-builder#try-reserve
    pub func TryReserve(&var self, additional: uint) throws AllocError {
        // Safety: the three addresses are this builder's own fields, which hold the storage invariant.
        unsafe { try TryReserveBuilderStorage(@self.data, self.length, @self.capacity, self.allocator, additional); }
    }

    /// Appends bytes the caller vouches are UTF-8.
    /// The bytes must be well-formed UTF-8 and must not end part-way through a character. The builder's promise
    /// that it holds text at every moment rests on this, and everything reading from it relies on that promise.
    /// Terminates the program when the builder cannot grow.
    /// @param bytes the bytes to act on, taken as valid without checking
    /// @see https://rux-lang.dev/docs/api/text/string-builder#append-validated
    pub func AppendValidated(&var self, bytes: char8[..]) {
        // Safety: the three addresses are this builder's own fields, which hold the storage invariant; `bytes` is
        // readable for its length and cannot borrow this builder's block while `self` is borrowed exclusively.
        unsafe { AppendBuilderStorage(@self.data, @self.length, @self.capacity, self.allocator, bytes); }
    }

    /// Appends what `view` spans.
    /// The view was checked when it was made, so nothing is checked again. Terminates the program when the builder
    /// cannot grow.
    /// @param view the borrowed text to act on
    /// @see https://rux-lang.dev/docs/api/text/string-builder#append
    pub func Append(&var self, view: StringView) {
        self.AppendValidated(view.bytes);
    }

    /// Appends `text`.
    /// Text was checked before it existed, so nothing is checked again. Terminates the program when the builder
    /// cannot grow.
    /// @param text the text to act on
    /// @see https://rux-lang.dev/docs/api/text/string-builder#append
    pub func Append(&var self, text: char8[..]) {
        self.AppendValidated(text);
    }

    /// Appends `bytes` when they are UTF-8, and reports `InvalidUtf8` when they are not.
    /// Costs a pass over the bytes. `Append` of a view costs none, which is the reason views exist.
    /// @param bytes the bytes to act on
    /// @returns nothing when the bytes were appended, after checking they are valid UTF-8, or why not
    /// @see https://rux-lang.dev/docs/api/text/string-builder#append-bytes
    pub func AppendBytes(&var self, bytes: char8[..]) throws TextError {
        try Validate(bytes) catch { _ => throw .InvalidUtf8 };
        self.AppendValidated(bytes);
    }

    /// Appends one character.
    /// Reports `InvalidUtf8` for a value that is not a scalar value — a surrogate half, or one past U+10FFFF --
    /// which is what keeps a builder from holding something that is not text.
    /// @param scalar the Unicode scalar value
    /// @returns nothing when the scalar's encoding was appended, or why not
    /// @see https://rux-lang.dev/docs/api/text/string-builder#append-scalar
    pub func AppendScalar(&var self, scalar: char32) throws TextError {
        var encoded: char8[4];
        var written: uint = 0;
        let sink = encoded[..];
        written = try Encode(scalar, sink) catch { _ => throw .InvalidUtf8 };
        self.AppendValidated(encoded[..written]);
    }

    /// Appends one ASCII byte.
    /// Reports `InvalidUtf8` for a byte above 0x7F, since a single byte above that is never a whole character;
    /// `AppendScalar` is what appends one that takes more than a byte.
    /// @param byte the byte
    /// @returns nothing when the byte was appended, or why not
    /// @see https://rux-lang.dev/docs/api/text/string-builder#append-ascii
    pub func AppendAscii(&var self, byte: char8) throws TextError {
        if (byte as uint32) > 0x7F { throw .InvalidUtf8; }
        var one: char8[1];
        one[0] = byte;
        self.AppendValidated(one[..]);
    }

    /// Forgets everything appended, keeping the room.
    /// The block is kept, so a builder used in a loop allocates once rather than once per pass.
    /// @see https://rux-lang.dev/docs/api/text/string-builder#clear
    pub func Clear(&var self) {
        self.length = 0;
    }

    /// Gives the block back and leaves a builder that owns nothing.
    /// @see https://rux-lang.dev/docs/api/text/string-builder#release
    pub func Release(&var self) {
        if self.data != null {
            let layout = Layout::New(self.capacity, 1);
            var borrowed = self.allocator;
            try borrowed.Deallocate(self.data as *var opaque,
                                (layout ?? Layout { size: self.capacity, alignment: 1 })) catch { _ => {} };
        }
        self.data = null;
        self.length = 0;
        self.capacity = 0;
    }

    /// A copy of what has been appended, as a string of its own.
    /// The builder is untouched and may be appended to again. `IntoString` is what hands the block over instead of
    /// copying it, and is what to use when the builder is finished with. Terminates the program when the copy cannot
    /// be made.
    /// @returns a copy of what has been appended, leaving the builder as it was
    /// @see https://rux-lang.dev/docs/api/text/string-builder#to-string
    pub func ToString(&self) -> String {
        return String::FromValidated(self.allocator, self.Bytes());
    }

    /// Hands the block over as a string, leaving the builder owning nothing.
    /// Copies nothing: the string that comes back is the builder's block, which is why the builder must give it up.
    /// The block usually has room to spare, and the string remembers how much so that the allocator gets back the
    /// layout it handed out.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// @returns what has been appended, taking the builder's storage rather than copying
    /// @see https://rux-lang.dev/docs/api/text/string-builder#into-string
    pub func IntoString(&var self) -> String {
        let taken = String {
            data: self.data,
            length: self.length,
            capacity: self.capacity,
            allocator: self.allocator
        };
        self.data = null;
        self.length = 0;
        self.capacity = 0;
        return move taken;
    }

    /// Gives the block back.
    /// Runs when the builder dies. A builder whose block was handed over by `IntoString` owns nothing, so this is
    /// then a no-op rather than a second release.
    /// @see https://rux-lang.dev/docs/api/text/string-builder#destructor
    func ~StringBuilder(&var self) {
        self.Release();
    }
}

// Shared by the safe receiver and the deliberately raw stored-writer adapter. Only field addresses cross this
// boundary; the owning builder itself remains non-copyable and all public owner operations use references.
// Safety: `data` and `capacity` must address the fields of one live builder whose storage invariant holds with
// `length` as its length.
unsafe func TryReserveBuilderStorage(data: *var *var char8, length: uint, capacity: *var uint, allocator: Allocator,
                           additional: uint) throws AllocError {
        if additional == 0 { return; }
        if additional > 0xFFFFFFFFFFFFFFFF - length { throw .Unsupported; }
        let required = length + additional;
        if required <= *capacity { return; }

        // Doubling is what makes a run of appends linear rather than quadratic; asking for exactly what is needed
        // would reallocate on nearly every one. Where doubling is not enough, or would overflow, take the
        // requirement itself.
        var doubled: uint = 0;
        var wanted = required;
        if !MulChecked<uint>(*capacity, 2, @doubled) && doubled > required {
            wanted = doubled;
        }
        if wanted < MinimumBuilderCapacity {
            wanted = MinimumBuilderCapacity;
        }

        let layout = Layout::New(wanted, 1) ?? throw .Unsupported;
        let want = layout;
        var borrowed = allocator;
        let have = Layout::New(*capacity, 1) ?? Layout { size: *capacity, alignment: 1 };
        let block = try if *data == null {
            borrowed.Allocate(want)
        } else {
            borrowed.Reallocate(*data as *var opaque, have, want)
        };
        *data = block as *var char8;
        *capacity = wanted;
}

// `TryReserveBuilderStorage`, terminating the program when the room cannot be had.
// Safety: as for `TryReserveBuilderStorage`.
unsafe func ReserveBuilderStorage(data: *var *var char8, length: uint, capacity: *var uint, allocator: Allocator,
                           additional: uint) {
    try TryReserveBuilderStorage(data, length, capacity, allocator, additional) catch {
        error => AllocationFailed(error)
    };
}

// Safety: `data`, `length` and `capacity` must address the fields of one live builder whose storage invariant
// holds, and `bytes` must not lie inside that builder's block, which may move when it grows.
unsafe func AppendBuilderStorage(data: *var *var char8, length: *var uint, capacity: *var uint, allocator: Allocator,
                          bytes: char8[..]) {
    if bytes.length == 0 { return; }
    ReserveBuilderStorage(data, *length, capacity, allocator, bytes.length);
    Copy(@(*data)[*length] as *var opaque, bytes.data as *opaque, bytes.length);
    *length = *length + bytes.length;
}
