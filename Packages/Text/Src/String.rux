// Text that owns the bytes it holds.
//
// A `String` owns one block, knows the allocator to give it back to, and never writes to it again. Every operation
// that produces different text produces a different `String`, and leaves the receiver as it was.
//
// Immutability is not a preference here, it is what makes the type safe to hand around: a `String` may be built over
// bytes that came from a literal, and a literal lives on a read-only page. A type that promised mutation would have
// to copy defensively on every write or fault on some of them. `StringBuilder` is where text is assembled; `String`
// is what assembling it produces.
//
// Copying makes an independent block from the same allocator, so strings have value semantics even though each owns
// storage. A fallible caller can use `Clone`; the language copy operation cannot return an error and therefore
// terminates if its allocation fails. `StringView` borrows and copies no bytes; `View` creates one for free.
//
// Every `String` this package produces holds well-formed UTF-8, checked once where the bytes enter. Everything
// downstream may rely on that, which is what makes cutting and indexing cheap.

import Allocator::{ AllocError, Allocator, Layout };
import Core::{ Option, Ordering, Panic };
import Memory::Copy;

/// Text that owns its bytes.
///
/// Copyable with value semantics: each copy owns an independent block and gives it back when it dies.
///
/// @see https://rux-lang.dev/docs/api/text/string
pub struct String {
    /// The bytes, or null for text of no length.
    pub data: *var char8;
    /// How many bytes there are. Not how many characters.
    pub length: uint;
    /// How large the block is. An allocator is given back the layout it handed out, and a string built by handing
    /// a builder's block over gets one with room to spare, so what was allocated and what is used are not always
    /// the same number.
    capacity: uint;
    /// Where the block came from, and where it goes back to.
    allocator: Allocator;
}

extend String {
    /// Deep-copies `other` into independent storage from the same allocator.
    ///
    /// The special copy operation cannot report allocation failure, so it terminates on exhaustion. Use `Clone`
    /// when failure must be handled. The source remains valid and unchanged.
    ///
    /// @param other the value to compare against
    /// @see https://rux-lang.dev/docs/api/text/string/copy
    pub func =(self: &var String, other: &String) {
        self.data = null;
        self.length = other.length;
        self.capacity = other.length;
        self.allocator = other.allocator;
        if other.length == 0 { return; }

        let layout = Layout::New(other.length, 1).ValueOr(Layout { size: other.length, alignment: 1 });
        var block: *var opaque = null;
        var allocator = other.allocator;
        if allocator.Allocate(layout, @block) != AllocError::None { Panic("copying a String requires an allocation"); }
        Copy(block, other.data as *opaque, other.length);
        self.data = block as *var char8;
    }

    /// Text of no length, which has allocated nothing.
    ///
    /// `allocator` is borrowed for the call and kept, so an empty string can still grow into one that allocates.
    ///
    /// Cannot fail. Runs in constant time and allocates nothing.
    ///
    /// @param allocator where the storage comes from
    /// @returns an empty string that has taken no storage yet
    /// @see https://rux-lang.dev/docs/api/text/string/new
    pub func String(allocator: Allocator) -> String {
        return String { data: null, length: 0, capacity: 0, allocator: allocator };
    }

    /// A copy of bytes the caller vouches are UTF-8.
    ///
    /// Skips the pass `FromBytes` makes, which is what to use when the bytes came from something that already
    /// guarantees it — another string, a view, this package's own output.
    ///
    /// `error` receives `OutOfMemory` when the copy cannot be made, and `None` when the string was built.
    ///
    /// # Safety
    ///
    /// The bytes must be well-formed UTF-8. Everything downstream assumes it, so bytes that are not produce wrong
    /// answers rather than errors.
    ///
    /// @param allocator where the storage comes from
    /// @param bytes the bytes to act on
    /// @param error receives why the operation failed, or `None`
    /// @returns a string over those bytes, taken as valid without checking
    /// @see https://rux-lang.dev/docs/api/text/string/from-validated
    pub func FromValidated(allocator: Allocator, bytes: char8[..], error: *var TextError) -> String {
        *error = TextError::None;
        if bytes.length == 0 { return String(allocator); }

        let layout = Layout::New(bytes.length, 1);
        if layout.IsNone() {
            *error = TextError::LengthOverflow;
            return String(allocator);
        }

        var block: *var opaque = null;
        var borrowed = allocator;
        let allocated = borrowed.Allocate(layout.ValueOr(Layout { size: bytes.length, alignment: 1 }), @block);
        if allocated != AllocError::None {
            *error = FromAllocError(allocated);
            return String(allocator);
        }

        Copy(block, bytes.data as *opaque, bytes.length);
        return String {
            data: block as *var char8,
            length: bytes.length,
            capacity: bytes.length,
            allocator: allocator
        };
    }

    /// A copy of `bytes` as text, or text of no length when they are not UTF-8 or cannot be stored.
    ///
    /// `bytes` is borrowed and copied, so what it names stays the caller's. `error` receives `InvalidUtf8` when the
    /// bytes are not text and `OutOfMemory` when the copy cannot be made.
    ///
    /// Runs in time proportional to the length — one pass to check, one to copy — and allocates once.
    ///
    /// @param allocator where the storage comes from
    /// @param bytes the bytes to act on
    /// @param error receives why the operation failed, or `None`
    /// @returns a string over those bytes, or an empty one when they are not valid UTF-8
    /// @see https://rux-lang.dev/docs/api/text/string/from-bytes
    pub func FromBytes(allocator: Allocator, bytes: char8[..], error: *var TextError) -> String {
        var failureIndex: uint = 0;
        if Validate(bytes, @failureIndex).IsError() {
            *error = TextError::InvalidUtf8;
            return String(allocator);
        }
        return String::FromValidated(allocator, bytes, error);
    }

    /// A copy of what `view` spans.
    ///
    /// The view was checked when it was made, so this copies without checking again.
    ///
    /// @param allocator where the storage comes from
    /// @param view the borrowed text to act on
    /// @param error receives why the operation failed, or `None`
    /// @returns a copy of that text this string owns
    /// @see https://rux-lang.dev/docs/api/text/string/from-view
    pub func FromView(allocator: Allocator, view: StringView, error: *var TextError) -> String {
        return String::FromValidated(allocator, view.bytes, error);
    }
}

extend String {
    /// How many bytes the text spans.
    ///
    /// Not how many characters: that is `ScalarCount`, and it costs a pass.
    ///
    /// @returns how many bytes the text occupies
    /// @see https://rux-lang.dev/docs/api/text/string/length
    pub func Length(self: &String) -> uint {
        return self.length;
    }

    /// Whether the text spans no bytes.
    ///
    /// @returns whether the text has no bytes
    /// @see https://rux-lang.dev/docs/api/text/string/is-empty
    pub func IsEmpty(self: &String) -> bool {
        return self.length == 0;
    }

    /// The bytes themselves, borrowed.
    ///
    /// @returns the text's bytes, borrowed
    /// @see https://rux-lang.dev/docs/api/text/string/bytes
    pub func Bytes(self: &String) -> char8[..] {
        return (self.data)[..self.length];
    }

    /// A view over this string, which is what to pass to anything that only reads.
    ///
    /// Copies nothing. The view borrows this string and must not outlive it.
    ///
    /// @returns a borrowed view of the text
    /// @see https://rux-lang.dev/docs/api/text/string/view
    pub func View(self: &String) -> StringView {
        return StringView::FromValidated(self.Bytes());
    }

    /// How many characters the text holds.
    ///
    /// @returns how many Unicode scalar values the text holds, which is not its byte length
    /// @see https://rux-lang.dev/docs/api/text/string/scalar-count
    pub func ScalarCount(self: &String) -> uint {
        return CountScalars(self.Bytes());
    }

    /// Whether `index` is where a character starts, and so a place the text may be cut.
    ///
    /// @param index the byte offset
    /// @returns whether `index` falls between two scalar values rather than inside one
    /// @see https://rux-lang.dev/docs/api/text/string/is-boundary
    pub func IsBoundary(self: &String, index: uint) -> bool {
        return IsBoundary(self.Bytes(), index);
    }

    /// A borrowed view of the part from `start` up to `end`, or `None` when either end is not a boundary.
    ///
    /// Borrows rather than copying, since a part of a string is bytes the string already owns. `Substring` is what
    /// makes an owning copy.
    ///
    /// @param start the first byte offset, inclusive
    /// @param end the byte offset one past the last, exclusive
    /// @returns the text between the two offsets, or `None` when either is not a boundary
    /// @see https://rux-lang.dev/docs/api/text/string/part
    pub func Part(self: &String, start: uint, end: uint) -> Option<StringView> {
        let whole = self.View();
        return whole.Part(start, end);
    }

    /// An owning copy of the part from `start` up to `end`.
    ///
    /// `error` receives `NotABoundary` when either end would cut a character in half.
    ///
    /// @param start the first byte offset, inclusive
    /// @param end the byte offset one past the last, exclusive
    /// @param error receives why the operation failed, or `None`
    /// @returns an owned copy of that range, or an empty string when it is not a valid one
    /// @see https://rux-lang.dev/docs/api/text/string/substring
    pub func Substring(self: &String, start: uint, end: uint, error: *var TextError) -> String {
        let part = self.Part(start, end);
        if part.IsNone() {
            *error = TextError::NotABoundary;
            return String(self.allocator);
        }
        return String::FromView(self.allocator, part.ValueOr(StringView()), error);
    }

    /// An independent copy, with a block of its own from the same allocator.
    ///
    /// @param error receives why the operation failed, or `None`
    /// @returns an independent copy
    /// @see https://rux-lang.dev/docs/api/text/string/clone
    pub func Clone(self: &String, error: *var TextError) -> String {
        return String::FromValidated(self.allocator, self.Bytes(), error);
    }

    /// Whether two strings hold the same bytes.
    ///
    /// @param other the value to compare against
    /// @returns whether both hold the same bytes
    /// @see https://rux-lang.dev/docs/api/text/string/equals
    pub func Equals(self: &String, other: &String) -> bool {
        let mine = self.View();
        let theirs = other.View();
        return mine.Equals(theirs);
    }

    /// How this string orders against `other`, by bytes, which for UTF-8 is also by code point.
    ///
    /// @param other the value to compare against
    /// @returns how the two order byte by byte, which is code-point order for UTF-8
    /// @see https://rux-lang.dev/docs/api/text/string/compare
    pub func Compare(self: &String, other: &String) -> Ordering {
        let mine = self.View();
        let theirs = other.View();
        return mine.Compare(theirs);
    }

    /// Gives the block back and leaves text of no length behind.
    ///
    /// Rarely needed: a string releases itself when it dies. This is for releasing one early, and is safe to call
    /// twice because what it leaves behind owns nothing.
    ///
    /// @see https://rux-lang.dev/docs/api/text/string/clear
    pub func Clear(self: &var String) {
        if self.data != null {
            let layout = Layout::New(self.capacity, 1);
            var borrowed = self.allocator;
            borrowed.Deallocate(self.data as *var opaque,
                                layout.ValueOr(Layout { size: self.capacity, alignment: 1 }));
        }
        self.data = null;
        self.length = 0;
        self.capacity = 0;
    }

    /// Replaces this string with `value`, transferring its block after releasing the old one.
    ///
    /// A fresh value transfers directly. Passing a named string first invokes its deep copy, so the caller keeps an
    /// independent original.
    /// @param value the value to act on
    /// @see https://rux-lang.dev/docs/api/text/string/replace-with
    pub func ReplaceWith(self: &var String, value: String) {
        var owned <- value;
        self.Clear();
        self.data = owned.data;
        self.length = owned.length;
        self.capacity = owned.capacity;
        self.allocator = owned.allocator;
        owned.data = null;
        owned.length = 0;
        owned.capacity = 0;
    }
}

extend String {
    /// Gives the block back.
    ///
    /// Runs when the string dies. Copies have independent blocks, so each destructor releases exactly its own.
    ///
    /// @see https://rux-lang.dev/docs/api/text/string/destructor
    func ~String(self: &var String) {
        self.Clear();
    }
}
