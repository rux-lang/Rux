// Writing a value back out, compactly or for a human.
// Two things here are not negotiable. Strings are escaped exactly as RFC 8259 requires and no more: the quote,
// the backslash and every control character below space, using the short escapes where they exist and a
// four-digit form otherwise. The solidus is *not* escaped, though many writers do it — it is legal either way,
// and escaping it makes output differ from every other writer's for no benefit.
// And a non-finite number cannot be written, because JSON has no way to spell one. A writer that emits `NaN` or
// `Infinity` produces something that is not JSON and that other parsers reject, which turns a computation
// problem into an interoperation problem somewhere far away. Refusing is the only honest answer; a caller who
// has a non-finite value has to decide what it means, and only the caller can.
// Failures are the ones every writer in this workspace reports, which is what lets a JSON document be written
// into anything a `TextWriter` reaches without a translation at the seam. This used to be a status enum of its
// own with one case, `Failed`, standing for everything a destination could say — so a buffer that was simply full
// and a stream that had died arrived identically, and a caller who could have written the document somewhere
// larger had no way to know that was the problem. What the destination said now travels unchanged. A non-finite
// number is `ValueOutOfRange`, which is what that case is for: the value is perfectly good and the requested form
// cannot hold it.

import Text::{ FormatError, TextWriter };

/// How deep a document may nest before the writer refuses.
/// The writer descends recursively, so this bounds its own stack rather than the document's shape. It is far past
/// the parser's default depth, which is what actually decides whether a document of this size can exist: a tree
/// built in memory rather than parsed is the only way to reach this at all.
/// @see https://rux-lang.dev/docs/api/json/write-value#maximum-write-depth
pub const MaximumWriteDepth: uint = 512;

/// How a document should be laid out.
/// @see https://rux-lang.dev/docs/api/json/write-value#json-style
pub struct JsonStyle {
    /// Spaces of indentation per level; zero writes everything on one line.
    indent: uint;
    /// Whether a space follows the colon after a member name. Ignored when indenting, which always adds one.
    spaceAfterColon: bool;
}

extend JsonStyle {
    /// The compact style: no whitespace anywhere. What a document on a wire should be.
    /// @returns a style that writes no whitespace at all
    /// @see https://rux-lang.dev/docs/api/json/write-value#json-style-compact
    pub func Compact() -> Self {
        return Self { indent: 0, spaceAfterColon: false };
    }

    /// The readable style: two spaces per level.
    /// @returns a style that indents and puts each member on its own line
    /// @see https://rux-lang.dev/docs/api/json/write-value#json-style-pretty
    pub func Pretty() -> Self {
        return Self { indent: 2, spaceAfterColon: true };
    }
}

// The sixteen hex digits, lower case, which is what the escape form uses.
const JsonHexDigits: char8[..] = "0123456789abcdef";

/// Writes the escaped form of `text`, including its surrounding quotes.
/// Escapes exactly what the standard requires: the quote, the backslash, and every control character below
/// space. Bytes above that pass through unchanged, so a UTF-8 document stays UTF-8 rather than being expanded
/// into escapes — which is legal but makes output several times larger for no gain.
/// Reports whatever the destination reported, stopping at the first refusal, so a destination that has already
/// refused something is not written to again and a partly written string is not followed by its closing quote.
/// @param writer the destination
/// @param text the UTF-8 bytes to escape and write
/// @returns success when the whole quoted string was accepted
/// @see https://rux-lang.dev/docs/api/json/write-value#write-escaped
pub func WriteEscaped(writer: &var TextWriter, text: char8[..]) throws FormatError {
    let sink = writer;
    var quote: char8[1];
    quote[0] = 0x22u8 as char8;
    try sink.Write(quote[0..1]);
    var index: uint = 0;
    var runStart: uint = 0;
    while index < text.length {
        // Safety: `index` is below `text.length`, checked by the loop.
        let c = unsafe { text.data[index] } as uint8;
        var escape: char8[6];
        var escapeLength: uint = 0;
        if c == 0x22 || c == 0x5C {
            escape[0] = 0x5Cu8 as char8;
            escape[1] = c as char8;
            escapeLength = 2;
        }
        else if c == 0x08 || c == 0x0C || c == 0x0A || c == 0x0D || c == 0x09 {
            escape[0] = 0x5Cu8 as char8;
            var letter: uint8 = 0;
            if c == 0x08 {
                letter = 0x62;
            }
            else if c == 0x0C {
                letter = 0x66;
            }
            else if c == 0x0A {
                letter = 0x6E;
            }
            else if c == 0x0D {
                letter = 0x72;
            }
            else {
                letter = 0x74;
            }
            escape[1] = letter as char8;
            escapeLength = 2;
        }
        else if c < 0x20 {
            // Every other control character has no short form and takes the four-digit one.
            escape[0] = 0x5Cu8 as char8;
            escape[1] = 0x75u8 as char8;
            escape[2] = 0x30u8 as char8;
            escape[3] = 0x30u8 as char8;
            // Safety: both indices are masked to four bits, below the 16 bytes of `JsonHexDigits`.
            unsafe {
                escape[4] = JsonHexDigits.data[((c >> 4) & 0x0F) as uint];
                escape[5] = JsonHexDigits.data[(c & 0x0F) as uint];
            }
            escapeLength = 6;
        }
        if escapeLength > 0 {
            if index > runStart {
                // Safety: `runStart < index < text.length`, so the run lies inside `text`.
                let run = unsafe { (@text.data[runStart])[..index - runStart] };
                try sink.Write(run);
            }
            try sink.Write(escape[0..escapeLength]);
            runStart = index + 1;
        }
        index = index + 1;
    }
    if index > runStart {
        // Safety: `runStart < index`, and the loop ended with `index` equal to `text.length`.
        let run = unsafe { (@text.data[runStart])[..index - runStart] };
        try sink.Write(run);
    }
    return try sink.Write(quote[0..1]);
}

// One run of bytes to the destination, reporting exactly what the destination said. Named apart from Text's
// `WriteBytes` deliberately: a name that shadows an imported one is a name that will be reached for by accident.
func WriteJsonBytes(writer: &var TextWriter, bytes: char8[..]) throws FormatError {
    let sink = writer;
    return try sink.Write(bytes);
}

func WriteNewlineAndIndent(writer: &var TextWriter, style: JsonStyle, level: uint) throws FormatError {
    if style.indent == 0 { return; }
    var newline: char8[1];
    newline[0] = 0x0Au8 as char8;
    try WriteJsonBytes(writer, newline[0..1]);
    var spaces: char8[64];
    var index: uint = 0;
    while index < 64 {
        spaces[index] = 0x20u8 as char8;
        index = index + 1;
    }
    var remaining = style.indent * level;
    while remaining > 0 {
        let step = if remaining < 64 { remaining } else { 64 };
        try WriteJsonBytes(writer, spaces[0..step]);
        remaining = remaining - step;
    }
    return;
}

/// Writes `value` to `writer` in the given style.
/// The value is borrowed and nothing is allocated: the document writes itself into the destination as it is
/// walked. A number is written as the text it was read with, which is what keeps an identifier past 2^53 coming
/// back as itself.
/// Reports whatever the destination reported, unchanged, so a buffer that is merely full stays distinguishable
/// from a stream that has died — and stops at the first refusal rather than writing the rest of a document into a
/// destination that has already said no. Reports `ValueOutOfRange` for a number JSON cannot spell, and for a
/// document nested past `MaximumWriteDepth`.
/// @param writer the destination
/// @param value the document to write, borrowed for the call
/// @param style compact or pretty
/// @returns success when the whole document was accepted
/// @see https://rux-lang.dev/docs/api/json/write-value
pub func WriteValue(writer: &var TextWriter, value: &JsonValue, style: JsonStyle) throws FormatError {
    return try WriteAtLevel(writer, value, style, 0);
}

func WriteAtLevel(writer: &var TextWriter, value: &JsonValue, style: JsonStyle,
                  level: uint) throws FormatError {
    // A document this deep cannot have been parsed — the parser's own limit is far shallower — so it was built in
    // memory, and refusing is better than descending until the stack runs out.
    if level > MaximumWriteDepth { throw FormatError::ValueOutOfRange; }
    let kind = value.Kind();
    if kind == JsonKind::Null { return try WriteJsonBytes(writer, "null"); }
    if kind == JsonKind::Boolean {
        var flag = false;
        value.AsBoolean(@flag);
        return try WriteJsonBytes(writer, if flag { "true" } else { "false" });
    }
    if kind == JsonKind::Number {
        let number = value.AsNumber() ?? throw .ValueOutOfRange;
        let text = number.Text().Bytes();
        // Every way of making a number checks its text against the grammar, but a value whose kind was set by hand
        // can still carry text that is not one, such as none at all. JSON has no way to spell that, so this refuses
        // rather than emitting something other parsers will reject. The value is not wrong; the form asked for
        // cannot hold it, which is exactly what `ValueOutOfRange` says.
        if !IsJsonNumberText(text) {
            throw .ValueOutOfRange;
        }
        return try WriteJsonBytes(writer, text);
    }
    if kind == JsonKind::Text { return try WriteEscaped(writer, value.AsText().Bytes()); }

    let isObject = kind == JsonKind::Object;
    let opening = if isObject { "{" } else { "[" };
    let closing = if isObject { "}" } else { "]" };
    try WriteJsonBytes(writer, opening);
    let count = value.Length();
    if count == 0 {
        // An empty container stays on one line even when indenting, since a line holding only a bracket says
        // nothing a reader needs.
        return try WriteJsonBytes(writer, closing);
    }
    var index: uint = 0;
    while index < count {
        if index > 0 {
            try WriteJsonBytes(writer, ",");
        }
        try WriteNewlineAndIndent(writer, style, level + 1);
        if isObject {
            let member = value.MemberAt(index) ?? break;
            try WriteEscaped(writer, member.name.View().Bytes());
            try WriteJsonBytes(writer, ":");
            if style.indent > 0 || style.spaceAfterColon {
                try WriteJsonBytes(writer, " ");
            }
            try WriteAtLevel(writer, member.value, style, level + 1);
        }
        else {
            let element = value.At(index) ?? break;
            try WriteAtLevel(writer, element, style, level + 1);
        }
        index = index + 1;
    }
    try WriteNewlineAndIndent(writer, style, level);
    return try WriteJsonBytes(writer, closing);
}
