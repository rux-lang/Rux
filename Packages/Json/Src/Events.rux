// Reading a document as a stream of events, without building a tree.
// The tree is convenient and it is also the thing that makes a large document expensive: a gigabyte of JSON
// becomes several gigabytes of nodes, and a program that only wants the third field of each record pays for all
// of it. Streaming trades random access for constant memory — events arrive in document order, once, and the
// caller keeps only what it wants.
// The buffer here grows only as far as the largest single token requires, not as far as the document. An array
// of ten million small numbers streams in a few hundred bytes; only a single enormous string forces the buffer
// up, and the string limit is what bounds that.
// Nesting and separators are tracked so that structural mistakes are still caught — a closing brace against an open
// bracket, a missing or doubled comma, a name without its colon, a second top-level value or text after the first
// are refused here exactly as the tree parser refuses them, because a streaming reader that accepted malformed
// structure would push the problem onto every caller.

import Allocator::{ AllocationFailed, Allocator, Layout };

import Io::{ IoError, Reader };

/// What just happened in the document. The end of the document is `none` from `Next`, and a failure is thrown.
/// @see https://rux-lang.dev/docs/api/json/json-event-reader#json-event
pub enum JsonEvent: int32 {
    /// An object opened.
    ObjectStart = 1,
    /// An object closed.
    ObjectEnd = 2,
    /// An array opened.
    ArrayStart = 3,
    /// An array closed.
    ArrayEnd = 4,
    /// A member name; its text is available until the next event.
    Name = 5,
    /// A string value; its text is available until the next event.
    Text = 6,
    /// A number; its text is available until the next event.
    Number = 7,
    /// `true`.
    True = 8,
    /// `false`.
    False = 9,
    /// `null`.
    Null = 10
}

/// Why a `JsonEventReader` stopped before the end of the document.
/// @see https://rux-lang.dev/docs/api/json/json-event-reader#json-read-error
pub variant JsonReadError {
    /// The document is not JSON. The failure is positioned at the byte of the document the reader stopped on, with
    /// the same cases and offsets the tree parser reports for the same text.
    Malformed(JsonParseError),
    /// The source failed with something other than its end, after this many bytes of the document were read.
    Source(IoError, uint)
}

// Where the reader is in the grammar, which decides what the next token may be.
enum JsonReadState: int32 {
    // Before the top-level value.
    Start = 0,
    // Just inside `[` or `{`, where the container may close at once.
    First = 1,
    // After a comma in an array or a colon in an object, where a value must follow.
    Value = 2,
    // After a comma in an object, where a name must follow.
    Name = 3,
    // After a name, where its colon must follow.
    Colon = 4,
    // After a value inside a container, where a comma or the container's closer must follow.
    Separator = 5,
    // After the top-level value, where only whitespace may follow.
    Done = 6
}

/// Reads a document as events, pulling bytes as it needs them.
/// @see https://rux-lang.dev/docs/api/json/json-event-reader
pub struct JsonEventReader {
    /// Where bytes come from.
    source: Reader;
    /// Bytes read and not yet consumed.
    data: *var char8;
    /// How much room the buffer has.
    capacity: uint;
    /// How much of it holds bytes.
    filled: uint;
    /// How far into it reading has reached.
    position: uint;
    /// How many bytes of the document were consumed and dropped from the buffer before it, so that a failure is
    /// positioned in the document rather than in the buffer.
    consumedBefore: uint;
    /// Whether the source is exhausted.
    exhausted: bool;
    /// Where the buffer came from.
    allocator: Allocator;
    /// What the caller will accept.
    limits: JsonLimits;
    /// Which containers are open, as one bit each: set for an object, clear for an array.
    stack: uint64[16];
    /// How many are open.
    depth: uint;
    /// Where the current token's text starts in the buffer.
    tokenStart: uint;
    /// Where it ends.
    tokenEnd: uint;
    /// Whether that text holds escapes.
    tokenEscaped: bool;
    /// Why reading stopped, as its parts. The public failure is built from these and the position, once, in
    /// `Failure` — a reader that carried the payload around would be copying an offset it already knows.
    stop: JsonStop;
    /// The lexer's reason, when `stop` is `Lexical`.
    lexical: JsonLexError;
    /// What the source reported, when `stop` is `Source`.
    sourceFailure: IoError?;
    /// What the next token may be.
    state: JsonReadState;
}

// How much the buffer starts at, and how far it grows in one step.
const JsonStreamChunk: uint = 4096;

extend JsonEventReader {
    /// A reader over `source` under `limits`.
    /// @param allocator where the storage comes from
    /// @param source the text to read
    /// @param limits the bounds the parse refuses to exceed
    /// Terminates the program when its first buffer cannot be allocated, as every owning buffer does.
    /// @returns a reader positioned before the first event
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader#constructor
    pub func JsonEventReader(allocator: Allocator, source: Reader, limits: JsonLimits) -> Self {
        var reader = Self {
            source, data: null, capacity: 0, filled: 0, position: 0, consumedBefore: 0, exhausted: false,
            allocator, limits, stack: [0; 16],
            depth: 0, tokenStart: 0, tokenEnd: 0, tokenEscaped: false,
            stop: JsonStop::None, lexical: JsonLexError::None, sourceFailure: none, state: JsonReadState::Start
        };
        var borrowed = allocator;
        let chunk = Layout { size: JsonStreamChunk, alignment: 1 };
        let block = try borrowed.Allocate(chunk) catch { error => AllocationFailed(error) };
        // Safety: `block` was just allocated with `JsonStreamChunk` bytes, and `char8` has size and alignment 1.
        reader.data = unsafe { block as *var char8 };
        reader.capacity = JsonStreamChunk;
        return move reader;
    }

    // The error a stopped reader throws, built once from the parts it kept. The offset counts bytes from the start
    // of the document, however many times the buffer has been refilled.
    func Stopped(&self) -> JsonReadError {
        let at = self.consumedBefore + self.position;
        if self.stop == JsonStop::Source && self.sourceFailure is .Some(error) { return .Source(error, at); }
        return .Malformed(BuiltFailure(self.stop, self.lexical, at));
    }

    // Stops the reader for `reason`, which the next call throws as well.
    func Refuse(&var self, reason: JsonStop) -> JsonReadError {
        if self.stop == JsonStop::None {
            self.stop = reason;
        }
        return self.Stopped();
    }

    /// The text of the event just reported, valid until the next call to `Next`.
    /// For a name, a string or a number. The view points into the reader's buffer, which the next call may refill
    /// or grow, so a caller that keeps the text copies it first. Escapes are left as written — resolving them would
    /// mean allocating, and a caller skipping past a field should not pay for its contents.
    /// @returns the current event's text, borrowed from the reader until its next event
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader#text
    pub func Text(&self) -> char8[..] {
        // Safety: `ScanWhile` keeps `tokenStart..tokenEnd` inside the filled part of the live buffer `self.data`, and
        // nothing has refilled it since the event that recorded them.
        return unsafe { (@self.data[self.tokenStart])[..self.tokenEnd - self.tokenStart] };
    }

    /// Whether that text holds escapes a caller must resolve.
    /// @returns whether the text still holds escape sequences a caller must decode
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader#text-is-escaped
    pub func TextIsEscaped(&self) -> bool {
        return self.tokenEscaped;
    }

    /// How deeply nested the reader currently is.
    /// @returns how many arrays and objects are currently open
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader#depth
    pub func Depth(&self) -> uint {
        return self.depth;
    }

    // Drops what has been consumed and pulls more, growing only if the buffer is genuinely full. This is what
    // keeps memory proportional to the largest token rather than to the document.
    func Refill(&var self) -> bool {
        // A reader that has stopped reads nothing more, so the first refusal is the one that stays reported.
        if self.stop != JsonStop::None { return false; }
        if self.position > 0 {
            var moved: uint = 0;
            while self.position + moved < self.filled {
                // Safety: both offsets are below `self.filled`, which never exceeds the `self.capacity` bytes of the
                // live buffer `self.data`.
                unsafe { self.data[moved] = self.data[self.position + moved]; }
                moved = moved + 1;
            }
            self.filled = moved;
            self.consumedBefore = self.consumedBefore + self.position;
            self.position = 0;
        }
        if self.filled == self.capacity {
            let wanted = self.capacity * 2;
            if wanted > self.limits.maximumTextBytes + JsonStreamChunk {
                self.stop = JsonStop::TooManyEntries;
                return false;
            }
            var borrowed = self.allocator;
            let bigger = Layout { size: wanted, alignment: 1 };
            let block = try borrowed.Allocate(bigger) catch { error => AllocationFailed(error) };
            // Safety: `block` was just allocated with `wanted` bytes, and `char8` has size and alignment 1.
            let grown = unsafe { block as *var char8 };
            var copied: uint = 0;
            while copied < self.filled {
                // Safety: `copied` is below `self.filled`, which fits both the old buffer of `self.capacity` bytes
                // and `grown`, which holds twice as many.
                unsafe { grown[copied] = self.data[copied]; }
                copied = copied + 1;
            }
            let previous = Layout { size: self.capacity, alignment: 1 };
            try borrowed.Deallocate(self.data as *var opaque, previous) catch { _ => {} };
            self.data = grown;
            self.capacity = wanted;
        }
        if self.exhausted { return false; }
        // Safety: `self.filled` is at most `self.capacity`, the size of the live buffer `self.data`, so the room after
        // it lies inside the buffer.
        let room = unsafe { (@self.data[self.filled])[..self.capacity - self.filled] };
        let read = try self.source.Read(room) catch {
            error => {
                self.exhausted = true;
                if !error.IsEnd() && self.stop == JsonStop::None {
                    self.stop = JsonStop::Source;
                    self.sourceFailure = .Some(error);
                }
                return false;
            },
        };
        self.filled = self.filled + read;
        return read > 0;
    }

    /// Gives the buffer back.
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader#release
    pub func Release(&var self) {
        if self.data != null {
            var borrowed = self.allocator;
            let held = Layout { size: self.capacity, alignment: 1 };
            try borrowed.Deallocate(self.data as *var opaque, held) catch { _ => {} };
            self.data = null;
            self.capacity = 0;
        }
    }
    /// Releases the buffer.
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader#destructor
    func ~JsonEventReader(&var self) {
        self.Release();
    }

    // Ensures at least one unread byte is available, pulling more if needed.
    func Available(&var self) -> bool {
        while self.position >= self.filled {
            if !self.Refill() { return self.position < self.filled; }
        }
        return true;
    }

    func SkipWhitespace(&var self) {
        while self.Available() {
            // Safety: `Available` returned true, so `self.position` is below `self.filled` in the live buffer.
            let c = unsafe { self.data[self.position] } as uint8;
            if c != 0x20 && c != 0x09 && c != 0x0D && c != 0x0A { return; }
            self.position = self.position + 1;
        }
    }

    // Scans a token that runs to a delimiter, pulling more bytes while it grows. The buffer is only allowed to
    // grow here, which is what bounds memory by the largest token.
    func ScanWhile(&var self, isText: bool) -> bool {
        var start = self.position;
        var index = self.position;
        var escaped = false;
        if isText {
            index = index + 1;
        }
        while true {
            if index >= self.filled {
                // Rewind to the token's start before refilling, so its bytes are kept rather than discarded --
                // and then shift both offsets by however far refilling compacted the buffer, which it does even
                // when nothing more could be read.
                self.position = start;
                let before = self.consumedBefore;
                let refilled = self.Refill();
                let shift = self.consumedBefore - before;
                index = index - shift;
                start = start - shift;
                if !refilled {
                    // A refusal the refill made itself, such as a source that failed, is the one reported.
                    if self.stop != JsonStop::None { return false; }
                    if isText {
                        self.stop = JsonStop::Lexical;
                        self.lexical = JsonLexError::UnterminatedText;
                        return false;
                    }
                    break;
                }
                continue;
            }
            // Safety: `index` is below `self.filled`, checked above, in the live buffer `self.data`.
            let c = unsafe { self.data[index] } as uint8;
            if isText {
                if c == 0x5C {
                    escaped = true;
                    index = index + 2;
                    continue;
                }
                if c == 0x22 {
                    self.tokenStart = start + 1;
                    self.tokenEnd = index;
                    self.tokenEscaped = escaped;
                    self.position = index + 1;
                    if self.tokenEnd - self.tokenStart > self.limits.maximumTextBytes {
                        self.stop = JsonStop::Lexical;
                        self.lexical = JsonLexError::TextTooLong;
                        return false;
                    }
                    return true;
                }
                if c < 0x20 {
                    self.stop = JsonStop::Lexical;
                    self.lexical = JsonLexError::UnescapedControl;
                    return false;
                }
            }
            else {
                let ends = c == 0x2C || c == 0x5D || c == 0x7D || c == 0x20 || c == 0x09 ||
                           c == 0x0D || c == 0x0A;
                if ends { break; }
            }
            index = index + 1;
        }
        self.tokenStart = start;
        self.tokenEnd = index;
        self.tokenEscaped = false;
        self.position = index;
        return true;
    }

    func PushContainer(&var self, isObject: bool) -> bool {
        if self.depth >= self.limits.maximumDepth || self.depth >= 1024 {
            self.stop = JsonStop::TooDeep;
            return false;
        }
        let word = self.depth / 64u;
        let bit = (self.depth % 64u) as uint64;
        if isObject {
            self.stack[word] = self.stack[word] | (1u64 << bit);
        }
        else {
            self.stack[word] = self.stack[word] & ~(1u64 << bit);
        }
        self.depth = self.depth + 1u;
        return true;
    }

    func InObject(&self) -> bool {
        if self.depth == 0 { return false; }
        let index = self.depth - 1u;
        return (self.stack[index / 64u] & (1u64 << ((index % 64u) as uint64))) != 0;
    }

    func Matches(&var self, word: char8[..]) -> bool {
        var index: uint = 0;
        while index < word.length {
            while self.position + index >= self.filled {
                if !self.Refill() { return false; }
            }
            // Safety: the loop above made `self.position + index` lower than `self.filled` in the live buffer, and
            // `index` is below `word.length`.
            if unsafe { self.data[self.position + index] != word.data[index] } { return false; }
            index = index + 1;
        }
        self.position = self.position + word.length;
        return true;
    }

    // The byte at the read position, after whitespace, or `none` at the end of the input or when reading stopped.
    func Peek(&var self) -> uint8? {
        self.SkipWhitespace();
        if !self.Available() { return none; }
        // Safety: `Available` returned true, so `self.position` is below `self.filled` in the live buffer.
        return unsafe { self.data[self.position] } as uint8;
    }

    // The byte a value must start with after a separator; the input ending there is a truncated document.
    func ValueByte(&var self) -> uint8 throws JsonReadError {
        if self.Peek() is .Some(c) { return c; }
        if self.stop != JsonStop::None { throw self.Stopped(); }
        throw self.Refuse(JsonStop::Truncated);
    }

    // The state after a value: a separator inside a container, or the end of the document at the top level.
    func AfterValue(&self) -> JsonReadState {
        return if self.depth == 0 { JsonReadState::Done } else { JsonReadState::Separator };
    }

    /// The next event, or `none` at the end of the document.
    /// Separators are checked and consumed: a caller sees values and structure, not commas and colons, which is the
    /// level a streaming reader is useful at. A document that is not JSON throws `Malformed` with the case and offset
    /// the tree parser would report, and a source that fails throws `Source` with the source's own error; after
    /// either, every later call throws the same error again.
    /// @returns the next event, or `none` once the top-level value and any whitespace after it have been read
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader#next
    pub func Next(&var self) -> JsonEvent? throws JsonReadError {
        if self.stop != JsonStop::None { throw self.Stopped(); }
        if self.state == JsonReadState::Done {
            // Only whitespace may follow the top-level value; anything else is a second value or trailing text.
            if self.Peek() is .Some(_) { throw self.Refuse(JsonStop::TrailingContent); }
            if self.stop != JsonStop::None { throw self.Stopped(); }
            return none;
        }
        var c = try self.ValueByte();
        // The separator due here, which a caller never sees.
        if self.state == JsonReadState::Colon {
            if c != 0x3A { throw self.Refuse(JsonStop::Unexpected); }
            self.position = self.position + 1;
            self.state = JsonReadState::Value;
            c = try self.ValueByte();
        }
        else if self.state == JsonReadState::Separator && c == 0x2C {
            self.position = self.position + 1;
            self.state = if self.InObject() { JsonReadState::Name } else { JsonReadState::Value };
            c = try self.ValueByte();
        }
        if c == 0x7D || c == 0x5D {
            let wantsObject = c == 0x7D;
            let closes = self.state == JsonReadState::First || self.state == JsonReadState::Separator;
            if !closes || self.depth == 0 || self.InObject() != wantsObject {
                // A closer with nothing open, against the other kind, or after a comma.
                throw self.Refuse(JsonStop::Unexpected);
            }
            self.position = self.position + 1;
            self.depth = self.depth - 1;
            self.state = self.AfterValue();
            return if wantsObject { JsonEvent::ObjectEnd } else { JsonEvent::ArrayEnd };
        }
        let wantsName = self.state == JsonReadState::Name || (self.state == JsonReadState::First && self.InObject());
        // A separator where a value or a name belongs is as misplaced as a value where a separator belongs.
        if self.state == JsonReadState::Separator || (wantsName && c != 0x22) || c == 0x2C || c == 0x3A {
            throw self.Refuse(JsonStop::Unexpected);
        }
        if c == 0x22 {
            if !self.ScanWhile(true) { throw self.Stopped(); }
            if wantsName {
                self.state = JsonReadState::Colon;
                return JsonEvent::Name;
            }
            self.state = self.AfterValue();
            return JsonEvent::Text;
        }
        if c == 0x7B || c == 0x5B {
            let isObject = c == 0x7B;
            self.position = self.position + 1;
            if !self.PushContainer(isObject) { throw self.Stopped(); }
            self.state = JsonReadState::First;
            return if isObject { JsonEvent::ObjectStart } else { JsonEvent::ArrayStart };
        }
        if c == 0x2D || (c >= 0x30 && c <= 0x39) {
            if !self.ScanWhile(false) { throw self.Stopped(); }
            if !IsJsonNumberText(self.Text()) {
                // A number is refused where it starts, as the lexer refuses one.
                self.position = self.tokenStart;
                self.lexical = JsonLexError::MalformedNumber;
                throw self.Refuse(JsonStop::Lexical);
            }
            self.state = self.AfterValue();
            return JsonEvent::Number;
        }
        for (word, event) in [("true", JsonEvent::True), ("false", JsonEvent::False), ("null", JsonEvent::Null)] {
            if self.Matches(word) {
                self.state = self.AfterValue();
                return event;
            }
        }
        if self.stop != JsonStop::None { throw self.Stopped(); }
        self.lexical = JsonLexError::UnexpectedByte;
        throw self.Refuse(JsonStop::Lexical);
    }
}
