// Reading a document as a stream of events, without building a tree.
//
// The tree is convenient and it is also the thing that makes a large document expensive: a gigabyte of JSON
// becomes several gigabytes of nodes, and a program that only wants the third field of each record pays for all
// of it. Streaming trades random access for constant memory — events arrive in document order, once, and the
// caller keeps only what it wants.
//
// The buffer here grows only as far as the largest single token requires, not as far as the document. An array
// of ten million small numbers streams in a few hundred bytes; only a single enormous string forces the buffer
// up, and the string limit is what bounds that.
//
// Nesting is tracked so that structural mistakes are still caught — a closing brace against an open bracket is
// refused here exactly as it would be by the tree parser, because a streaming reader that accepted malformed
// structure would push the problem onto every caller.

import Allocator::{ AllocError, Allocator, Layout };

import Io::{ IoError, IoErrorKind, Reader };

/// What just happened in the document.
///
/// @see https://rux-lang.dev/docs/api/json/json-event
pub enum JsonEvent: int32 {
    /// The document is finished.
    End = 0,
    /// An object opened.
    ObjectStart = 1,
    /// An object closed.
    ObjectEnd = 2,
    /// An array opened.
    ArrayStart = 3,
    /// An array closed.
    ArrayEnd = 4,
    /// A member name; its text is available until the next event.
    Name = 5,
    /// A string value; its text is available until the next event.
    Text = 6,
    /// A number; its text is available until the next event.
    Number = 7,
    /// `true`.
    True = 8,
    /// `false`.
    False = 9,
    /// `null`.
    Null = 10,
    /// Something went wrong; the reason is on the reader.
    Error = 11
}

/// Reads a document as events, pulling bytes as it needs them.
///
/// @see https://rux-lang.dev/docs/api/json/json-event-reader
pub struct JsonEventReader {
    /// Where bytes come from.
    source: Reader;
    /// Bytes read and not yet consumed.
    data: *var char8;
    /// How much room the buffer has.
    capacity: uint;
    /// How much of it holds bytes.
    filled: uint;
    /// How far into it reading has reached.
    pub position: uint;
    /// Whether the source is exhausted.
    exhausted: bool;
    /// Where the buffer came from.
    allocator: Allocator;
    /// What the caller will accept.
    limits: JsonLimits;
    /// Which containers are open, as one bit each: set for an object, clear for an array.
    stack: uint64[16];
    /// How many are open.
    depth: uint;
    /// Where the current token's text starts in the buffer.
    tokenStart: uint;
    /// Where it ends.
    tokenEnd: uint;
    /// Whether that text holds escapes.
    tokenEscaped: bool;
    /// Why reading stopped, as its parts. The public failure is built from these and the position, once, in
    /// `Failure` — a reader that carried the payload around would be copying an offset it already knows.
    stop: JsonStop;
    /// The lexer's reason, when `stop` is `Lexical`.
    lexical: JsonLexError;
    /// Whether a value is expected next rather than a name or a separator.
    expectingValue: bool;
}

// How much the buffer starts at, and how far it grows in one step.
const JsonStreamChunk: uint = 4096;

extend JsonEventReader {
    /// The owned stream buffer cannot be duplicated.
    func =(self: &var JsonEventReader, other: &JsonEventReader);

    /// A reader over `source` under `limits`.
    ///
    /// @param allocator where the storage comes from
    /// @param source the text to read
    /// @param limits the bounds the parse refuses to exceed
    /// @returns a reader positioned before the first event; `Other` when its buffer could not be allocated
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader/new
    pub func New(allocator: Allocator, source: Reader, limits: JsonLimits) -> JsonEventReader ! IoError {
        var reader = JsonEventReader {
            source: source, data: null, capacity: 0, filled: 0, position: 0, exhausted: false,
            allocator: allocator, limits: limits, stack: [0; 16],
            depth: 0, tokenStart: 0, tokenEnd: 0, tokenEscaped: false,
            stop: JsonStop::None, lexical: JsonLexError::None, expectingValue: true
        };
        var borrowed = allocator;
        let chunk = Layout { size: JsonStreamChunk, alignment: 1 };
        let block = borrowed.Allocate(chunk) catch { else => fail IoError::Of(IoErrorKind::Other) };
        reader.data = block as *var char8;
        reader.capacity = JsonStreamChunk;
        return <-reader;
    }

    /// Why reading stopped, positioned, or `none` while nothing has gone wrong.
    ///
    /// This is what a caller asks after `Next` reports `Error`. A lexical refusal carries the lexer's own reason
    /// inside it rather than in a second call, so a caller holding the failure is holding all of it.
    ///
    /// @returns the failure, positioned at the byte the reader stopped on, or `none`
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader/failure
    pub func Failure(self: &JsonEventReader) -> JsonParseError? {
        return BuildFailure(self.stop, self.lexical, self.position);
    }

    /// The text of the event just reported, valid until the next one.
    ///
    /// For a name, a string or a number. Escapes are left as written — resolving them would mean allocating,
    /// and a caller skipping past a field should not pay for its contents.
    ///
    /// @returns the current event's text, borrowed from the input
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader/text
    pub func Text(self: &JsonEventReader) -> char8[..] {
        return (@self.data[self.tokenStart])[..self.tokenEnd - self.tokenStart];
    }

    /// Whether that text holds escapes a caller must resolve.
    ///
    /// @returns whether the text still holds escape sequences a caller must decode
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader/text-is-escaped
    pub func TextIsEscaped(self: &JsonEventReader) -> bool {
        return self.tokenEscaped;
    }

    /// How deeply nested the reader currently is.
    ///
    /// @returns how many arrays and objects are currently open
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader/depth
    pub func Depth(self: &JsonEventReader) -> uint {
        return self.depth;
    }

    // Drops what has been consumed and pulls more, growing only if the buffer is genuinely full. This is what
    // keeps memory proportional to the largest token rather than to the document.
    func Refill(self: &var JsonEventReader) -> bool {
        if self.position > 0 {
            var moved: uint = 0;
            while self.position + moved < self.filled {
                self.data[moved] = self.data[self.position + moved];
                moved = moved + 1;
            }
            self.filled = moved;
            self.position = 0;
        }
        if self.filled == self.capacity {
            let wanted = self.capacity * 2;
            if wanted > self.limits.maximumTextBytes + JsonStreamChunk {
                self.stop = JsonStop::TooManyEntries;
                return false;
            }
            var borrowed = self.allocator;
            let bigger = Layout { size: wanted, alignment: 1 };
            let block = borrowed.Allocate(bigger) catch {
                else => {
                    self.stop = JsonStop::OutOfMemory;
                    return false;
                }
            };
            let grown = block as *var char8;
            var copied: uint = 0;
            while copied < self.filled {
                grown[copied] = self.data[copied];
                copied = copied + 1;
            }
            let previous = Layout { size: self.capacity, alignment: 1 };
            borrowed.Deallocate(self.data as *var opaque, previous) catch { else => {} };
            self.data = grown;
            self.capacity = wanted;
        }
        if self.exhausted { return false; }
        let room = (@self.data[self.filled])[..self.capacity - self.filled];
        let read = self.source.Read(room) catch {
            error => {
                self.exhausted = true;
                if !error.IsEnd() {
                    self.stop = JsonStop::Lexical;
                    self.lexical = JsonLexError::UnexpectedByte;
                }
                return false;
            }
        };
        self.filled = self.filled + read;
        return read > 0;
    }

    /// Gives the buffer back.
    ///
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader/release
    pub func Release(self: &var JsonEventReader) {
        if self.data != null {
            var borrowed = self.allocator;
            let held = Layout { size: self.capacity, alignment: 1 };
            borrowed.Deallocate(self.data as *var opaque, held) catch { else => {} };
            self.data = null;
            self.capacity = 0;
        }
    }
    /// Releases the buffer.
    ///
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader/destructor
    func ~JsonEventReader(self: &var JsonEventReader) {
        self.Release();
    }

    // Ensures at least one unread byte is available, pulling more if needed.
    func Available(self: &var JsonEventReader) -> bool {
        while self.position >= self.filled {
            if !self.Refill() { return self.position < self.filled; }
        }
        return true;
    }

    func SkipWhitespace(self: &var JsonEventReader) {
        while self.Available() {
            let c = self.data[self.position] as uint8;
            if c != 0x20 && c != 0x09 && c != 0x0D && c != 0x0A { return; }
            self.position = self.position + 1;
        }
    }

    // Scans a token that runs to a delimiter, pulling more bytes while it grows. The buffer is only allowed to
    // grow here, which is what bounds memory by the largest token.
    func ScanWhile(self: &var JsonEventReader, isText: bool) -> bool {
        var start = self.position;
        var index = self.position;
        var escaped = false;
        if isText {
            index = index + 1;
        }
        while true {
            if index >= self.filled {
                // Rewind to the token's start before refilling, so its bytes are kept rather than discarded --
                // and then shift both offsets, because refilling compacts the buffer down to zero.
                self.position = start;
                let shift = start;
                if !self.Refill() {
                    if isText {
                        self.stop = JsonStop::Lexical;
                        self.lexical = JsonLexError::UnterminatedText;
                        return false;
                    }
                    break;
                }
                index = index - shift;
                start = 0;
                continue;
            }
            let c = self.data[index] as uint8;
            if isText {
                if c == 0x5C {
                    escaped = true;
                    index = index + 2;
                    continue;
                }
                if c == 0x22 {
                    self.tokenStart = start + 1;
                    self.tokenEnd = index;
                    self.tokenEscaped = escaped;
                    self.position = index + 1;
                    if self.tokenEnd - self.tokenStart > self.limits.maximumTextBytes {
                        self.stop = JsonStop::Lexical;
                        self.lexical = JsonLexError::TextTooLong;
                        return false;
                    }
                    return true;
                }
                if c < 0x20 {
                    self.stop = JsonStop::Lexical;
                    self.lexical = JsonLexError::UnescapedControl;
                    return false;
                }
            }
            else {
                let ends = c == 0x2C || c == 0x5D || c == 0x7D || c == 0x20 || c == 0x09 ||
                           c == 0x0D || c == 0x0A;
                if ends { break; }
            }
            index = index + 1;
        }
        self.tokenStart = start;
        self.tokenEnd = index;
        self.tokenEscaped = false;
        self.position = index;
        return true;
    }

    func PushContainer(self: &var JsonEventReader, isObject: bool) -> bool {
        if self.depth >= self.limits.maximumDepth || self.depth >= 1024 {
            self.stop = JsonStop::TooDeep;
            return false;
        }
        let word = self.depth / 64u;
        let bit = (self.depth % 64u) as uint64;
        if isObject {
            self.stack[word] = self.stack[word] | (1u64 << bit);
        }
        else {
            self.stack[word] = self.stack[word] & ~(1u64 << bit);
        }
        self.depth = self.depth + 1u;
        return true;
    }

    func InObject(self: &JsonEventReader) -> bool {
        if self.depth == 0 { return false; }
        let index = self.depth - 1u;
        return (self.stack[index / 64u] & (1u64 << ((index % 64u) as uint64))) != 0;
    }

    func Matches(self: &var JsonEventReader, word: char8[..]) -> bool {
        var index: uint = 0;
        while index < word.length {
            while self.position + index >= self.filled {
                if !self.Refill() { return false; }
            }
            if self.data[self.position + index] != word.data[index] { return false; }
            index = index + 1;
        }
        self.position = self.position + word.length;
        return true;
    }

    /// The next event.
    ///
    /// Separators are consumed silently: a caller sees values and structure, not commas and colons, which is
    /// the level a streaming reader is useful at.
    ///
    /// @returns the next event, or the end-of-input event
    /// @see https://rux-lang.dev/docs/api/json/json-event-reader/next
    pub func Next(self: &var JsonEventReader) -> JsonEvent {
        if self.stop != JsonStop::None { return JsonEvent::Error; }
        self.SkipWhitespace();
        // Skip a separator, whichever kind is due here.
        while self.position < self.filled {
            let c = self.data[self.position] as uint8;
            if c != 0x2C && c != 0x3A { break; }
            self.position = self.position + 1;
            self.SkipWhitespace();
        }
        if !self.Available() {
            if self.depth > 0 {
                self.stop = JsonStop::Truncated;
                return JsonEvent::Error;
            }
            return JsonEvent::End;
        }
        let c = self.data[self.position] as uint8;
        if c == 0x7B {
            self.position = self.position + 1;
            if !self.PushContainer(true) { return JsonEvent::Error; }
            self.expectingValue = false;
            return JsonEvent::ObjectStart;
        }
        if c == 0x5B {
            self.position = self.position + 1;
            if !self.PushContainer(false) { return JsonEvent::Error; }
            self.expectingValue = true;
            return JsonEvent::ArrayStart;
        }
        if c == 0x7D || c == 0x5D {
            let wantsObject = c == 0x7D;
            if self.depth == 0 || self.InObject() != wantsObject {
                // A brace closing a bracket, or a closer with nothing open. A streaming reader that let this
                // through would push the problem onto every caller.
                self.stop = JsonStop::Unexpected;
                return JsonEvent::Error;
            }
            self.position = self.position + 1;
            self.depth = self.depth - 1;
            self.expectingValue = !self.InObject();
            return wantsObject ? JsonEvent::ObjectEnd : JsonEvent::ArrayEnd;
        }
        if c == 0x22 {
            let isName = self.InObject() && !self.expectingValue;
            if !self.ScanWhile(true) { return JsonEvent::Error; }
            if isName {
                self.expectingValue = true;
                return JsonEvent::Name;
            }
            self.expectingValue = !self.InObject();
            return JsonEvent::Text;
        }
        self.expectingValue = !self.InObject();
        if c == 0x2D || (c >= 0x30 && c <= 0x39) {
            if !self.ScanWhile(false) { return JsonEvent::Error; }
            return JsonEvent::Number;
        }
        if self.Matches("true") { return JsonEvent::True; }
        if self.Matches("false") { return JsonEvent::False; }
        if self.Matches("null") { return JsonEvent::Null; }
        self.stop = JsonStop::Lexical;
        self.lexical = JsonLexError::UnexpectedByte;
        return JsonEvent::Error;
    }
}
