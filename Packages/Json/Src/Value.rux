// What a JSON value is, and the one part of it the specification refuses to pin down.
// RFC 8259 says a number is a sequence of digits with an optional fraction and exponent, and then says
// implementations may set whatever limits they like on range and precision. That is the whole of it: JSON has no
// integer type, no float type, and no stated precision, so every parser decides for itself and they disagree.
// A parser that turns everything into a double silently corrupts an identifier past 2^53 — which is how a
// Twitter status id became a different status id in a great deal of software.
// So a number here keeps its text, and answers questions about itself from that. It reports whether it fits an
// integer, whether it fits a float, and what it is exactly; a caller asks for the shape it needs and is told if
// the value does not fit rather than being handed something close. The text is also what makes round-tripping
// exact: a document read and written back keeps its numbers as they were written. That text is always one the
// grammar allows: a number built by hand is checked when it is made, and one the lexer read was checked there.

import Allocator::Allocator;
import Collections::Vector;
import Core::Ordering;
import Format::{ ParseFloat64, ParseInt64, ParseUint64 };
import Text::{ String, StringView, TextError };

/// Why a JSON value could not be built.
/// Running out of memory is not one of the reasons: a value whose storage cannot be had terminates the program.
/// @see https://rux-lang.dev/docs/api/json/json-value#json-error
pub enum JsonError: int32 {
    /// Text that JSON's number grammar does not allow, such as `01`, `+1`, `.5`, `1e` or `NaN`.
    MalformedNumber = 2
}

// Whether `text` is a whole number as RFC 8259 spells it: an optional minus, an integer part that is a lone zero or
// starts with a nonzero digit, an optional fraction of at least one digit, and an optional exponent with an optional
// sign and at least one digit. A plus sign, a leading zero, a bare `.5` or `5.`, `NaN`, `Infinity` and anything
// around the number are JavaScript or worse, and none of them is JSON.
func IsJsonNumberText(text: char8[..]) -> bool {
    var at: uint = 0;
    // Safety: the read happens only when `at` is below `text.length`, tested first.
    if at < text.length && (unsafe { text.data[at] } as uint8) == 0x2D {
        at = at + 1;
    }
    if at >= text.length { return false; }
    // Safety: `at` is below `text.length`, checked just above.
    let first = unsafe { text.data[at] } as uint8;
    if first == 0x30 {
        at = at + 1;
    }
    else if first >= 0x31 && first <= 0x39 {
        at = DigitRunEnd(text, at);
    }
    else {
        return false;
    }
    // Safety: the read happens only when `at` is below `text.length`, tested first.
    if at < text.length && (unsafe { text.data[at] } as uint8) == 0x2E {
        let fractionEnd = DigitRunEnd(text, at + 1);
        if fractionEnd == at + 1 { return false; }
        at = fractionEnd;
    }
    // Safety: the reads happen only when `at` is below `text.length`, tested first.
    if at < text.length && unsafe { (text.data[at] as uint8) == 0x65 || (text.data[at] as uint8) == 0x45 } {
        at = at + 1;
        // Safety: the reads happen only when `at` is below `text.length`, tested first.
        if at < text.length && unsafe { (text.data[at] as uint8) == 0x2B || (text.data[at] as uint8) == 0x2D } {
            at = at + 1;
        }
        let exponentEnd = DigitRunEnd(text, at);
        if exponentEnd == at { return false; }
        at = exponentEnd;
    }
    return at == text.length;
}

// Where the run of ASCII digits starting at `at` ends, which is `at` itself when there is none.
func DigitRunEnd(text: char8[..], at: uint) -> uint {
    var index = at;
    while index < text.length {
        // Safety: `index` is below `text.length`, checked by the loop.
        let c = unsafe { text.data[index] } as uint8;
        if c < 0x30 || c > 0x39 { break; }
        index = index + 1;
    }
    return index;
}

/// Which kind of JSON value this is.
/// @see https://rux-lang.dev/docs/api/json/json-value#json-kind
pub enum JsonKind: int32 {
    /// The literal `null`.
    Null = 0,
    /// `true` or `false`.
    Boolean = 1,
    /// A number, whose precision JSON does not define.
    Number = 2,
    /// A string.
    Text = 3,
    /// An ordered sequence of values.
    Array = 4,
    /// A collection of name-value members.
    Object = 5
}

/// A JSON number, held as the text it was written with.
/// JSON does not say what precision a number has, so nothing here decides on the caller's behalf. Ask for the
/// shape wanted — `AsInt64`, `AsUint64`, `AsFloat64` — and each reports whether the value fits. Keeping the
/// text is also what lets a document round-trip exactly, which a parser converting to a double cannot do.
/// @see https://rux-lang.dev/docs/api/json/json-number
pub struct JsonNumber {
    /// The number exactly as it was written.
    text: String;
}

extend JsonNumber {
    /// A number from its text, which is checked against JSON's number grammar and copied.
    /// The text must be the whole number as RFC 8259 spells it: an optional minus, an integer part with no leading
    /// zero, and an optional fraction and exponent, each with at least one digit. Anything else, such as `01`, `+1`,
    /// `.5`, `5.`, `1e`, `NaN` or an empty text, is refused with `MalformedNumber` before anything is allocated, so a
    /// number that exists is one every JSON reader accepts. Terminates the program when the copy cannot be made.
    /// @param allocator where the storage comes from
    /// @param text the number's text, borrowed for the call
    /// @returns the number, holding a copy of the text; `MalformedNumber` when the text is not a JSON number
    /// @see https://rux-lang.dev/docs/api/json/json-number#new
    pub func New(allocator: Allocator, text: char8[..]) -> Self ! JsonError {
        if !IsJsonNumberText(text) { fail JsonError::MalformedNumber; }
        return Self::Lexed(allocator, text);
    }

    // A number from text the lexer has already held to the grammar, so it is not checked a second time. The bytes
    // of such a text are ASCII, and so already UTF-8.
    func Lexed(allocator: Allocator, text: char8[..]) -> Self {
        return Self { text: String::FromValidated(allocator, text) };
    }

    /// The number exactly as written.
    /// @returns the number's text, exactly as the input spelled it
    /// @see https://rux-lang.dev/docs/api/json/json-number#text
    pub func Text(&self) -> StringView {
        return self.text.View();
    }

    /// The value as a signed integer, or `false` if it does not fit one.
    /// A number with a fraction or an exponent does not fit, even when its value happens to be whole: `1.0` is
    /// not an integer in JSON's grammar and pretending otherwise loses the distinction a document was making.
    /// @param result receives the value when this reports true
    /// @returns whether the text is an integer that fits
    /// @see https://rux-lang.dev/docs/api/json/json-number#as-int64
    pub func AsInt64(&self, result: *var int64) -> bool {
        let value = ParseInt64(self.text.View().Bytes()) catch { _ => return false };
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `int64`.
        unsafe { *result = value; }
        return true;
    }

    /// The value as an unsigned integer, or `false` if it does not fit one.
    /// @param result receives the value when this reports true
    /// @returns whether the text is a non-negative integer that fits
    /// @see https://rux-lang.dev/docs/api/json/json-number#as-uint64
    pub func AsUint64(&self, result: *var uint64) -> bool {
        let value = ParseUint64(self.text.View().Bytes()) catch { _ => return false };
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `uint64`.
        unsafe { *result = value; }
        return true;
    }

    /// The value as a float, or `false` if the text is not a number at all.
    /// Succeeds for values a float cannot hold exactly, since that is what a float is for; a caller who needs
    /// exactness should ask for an integer or read the text.
    /// @param result receives the value when this reports true
    /// @returns whether the text converted; the value is the nearest representable one
    /// @see https://rux-lang.dev/docs/api/json/json-number#as-float64
    pub func AsFloat64(&self, result: *var float64) -> bool {
        let value = ParseFloat64(self.text.View().Bytes()) catch { _ => return false };
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `float64`.
        unsafe { *result = value; }
        return true;
    }

    /// Whether the text has no fraction and no exponent, so it denotes an integer.
    /// @returns whether the text has no fraction and no exponent
    /// @see https://rux-lang.dev/docs/api/json/json-number#is-integral
    pub func IsIntegral(&self) -> bool {
        let bytes = self.text.View().Bytes();
        var index: uint = 0;
        while index < bytes.length {
            // Safety: `index` is below `bytes.length`, checked by the loop.
            let c = unsafe { bytes.data[index] } as uint8;
            if c == 0x2E || c == 0x65 || c == 0x45 { return false; }
            index = index + 1;
        }
        return bytes.length > 0;
    }

    /// Gives the text back.
    /// @see https://rux-lang.dev/docs/api/json/json-number#release
    pub func Release(&var self) {
        self.text.Clear();
    }
}

/// A name-value pair inside an object.
/// @see https://rux-lang.dev/docs/api/json/json-value#json-member
pub struct JsonMember {
    /// The member's name.
    pub name: String;
    /// The member's value.
    pub value: JsonValue;
}

/// A JSON value: one of the six kinds, owning whatever it holds.
/// Move-only, because it owns strings and nested values. The allocator it was built with is carried along, so a
/// subtree can be released without the caller having to remember where it came from — which is what makes a
/// document assembled from several sources safe to take apart.
/// The tag is inspected with `Kind` and the payload read with the matching accessor; asking for the wrong one
/// reports failure rather than reinterpreting the bytes.
/// @see https://rux-lang.dev/docs/api/json/json-value
pub struct JsonValue {
    /// Which of the six kinds this is.
    pub kind: JsonKind;
    /// The payload of a `Boolean`.
    boolean: bool;
    /// The payload of a `Number`.
    number: JsonNumber;
    /// The payload of a `Text`.
    text: String;
    /// The elements of an `Array`.
    elements: Vector<JsonValue>;
    /// The members of an `Object`, in the order they were seen.
    members: Vector<JsonMember>;
    /// Where everything above came from.
    allocator: Allocator;
}

extend JsonValue {
    /// The literal `null`.
    /// @param allocator where the storage comes from
    /// @returns the null value
    /// @see https://rux-lang.dev/docs/api/json/json-value#null
    pub func Null(allocator: Allocator) -> Self {
        return Self {
            kind: JsonKind::Null,
            boolean: false,
            number: JsonNumber { text: String(allocator) },
            text: String(allocator),
            elements: Vector<Self>(allocator),
            members: Vector<JsonMember>(allocator),
            allocator
        };
    }

    /// A boolean value.
    /// @param allocator where the storage comes from
    /// @param value the value to act on
    /// @returns that boolean as a value
    /// @see https://rux-lang.dev/docs/api/json/json-value#boolean
    pub func Boolean(allocator: Allocator, value: bool) -> Self {
        var held = Self::Null(allocator);
        held.kind = JsonKind::Boolean;
        held.boolean = value;
        return move held;
    }

    /// A number, from the text it is written with, checked against JSON's number grammar as `JsonNumber::New` does.
    /// Text the grammar refuses, such as `01`, `1e` or `NaN`, is `MalformedNumber`, and no value is made.
    /// @param allocator where the storage comes from
    /// @param text the number's text, borrowed for the call
    /// @returns that text as a number value; `MalformedNumber` when the text is not a JSON number
    /// @see https://rux-lang.dev/docs/api/json/json-value#number
    pub func Number(allocator: Allocator, text: char8[..]) -> Self ! JsonError {
        var held = Self::Null(allocator);
        held.kind = JsonKind::Number;
        held.number = JsonNumber::New(allocator, text)?;
        return move held;
    }

    // A number value from a token the lexer has already held to the grammar, which the parser builds its numbers
    // with so that each is checked once.
    func LexedNumber(allocator: Allocator, text: char8[..]) -> Self {
        var held = Self::Null(allocator);
        held.kind = JsonKind::Number;
        held.number = JsonNumber::Lexed(allocator, text);
        return move held;
    }

    /// A string value.
    /// @param allocator where the storage comes from
    /// @param value the value to act on
    /// @returns that text as a string value, or `InvalidUtf8` when it is not text
    /// @see https://rux-lang.dev/docs/api/json/json-value#text
    pub func Text(allocator: Allocator, value: char8[..]) -> Self ! TextError {
        var held = Self::Null(allocator);
        held.kind = JsonKind::Text;
        held.text = String::FromBytes(allocator, value)?;
        return move held;
    }

    /// An empty array.
    /// @param allocator where the storage comes from
    /// @returns an empty array
    /// @see https://rux-lang.dev/docs/api/json/json-value#array
    pub func Array(allocator: Allocator) -> Self {
        var held = Self::Null(allocator);
        held.kind = JsonKind::Array;
        return move held;
    }

    /// An empty object.
    /// @param allocator where the storage comes from
    /// @returns an empty object
    /// @see https://rux-lang.dev/docs/api/json/json-value#object
    pub func Object(allocator: Allocator) -> Self {
        var held = Self::Null(allocator);
        held.kind = JsonKind::Object;
        return move held;
    }

    /// Which kind this value is.
    /// @returns which of the six JSON kinds this is
    /// @see https://rux-lang.dev/docs/api/json/json-value#kind
    pub func Kind(&self) -> JsonKind {
        return self.kind;
    }

    /// Whether this is `null`.
    /// @returns whether this is the null value
    /// @see https://rux-lang.dev/docs/api/json/json-value#is-null
    pub func IsNull(&self) -> bool {
        return self.kind == JsonKind::Null;
    }

    /// The boolean payload, or `false` when this is not a boolean — which `Kind` distinguishes from a genuine
    /// `false`.
    /// @param result receives the value when this reports true
    /// @returns whether this is a boolean
    /// @see https://rux-lang.dev/docs/api/json/json-value#as-boolean
    pub func AsBoolean(&self, result: *var bool) -> bool {
        if self.kind != JsonKind::Boolean { return false; }
        // Safety: the documented contract makes `result` a non-null pointer to the caller's writable `bool`.
        unsafe { *result = self.boolean; }
        return true;
    }

    /// The number payload, borrowed, or `none` when this is not a number.
    /// @returns the number, or `none` when this is not one
    /// @see https://rux-lang.dev/docs/api/json/json-value#as-number
    pub func AsNumber(&self) -> &JsonNumber? {
        if self.kind != JsonKind::Number { return none; }
        return self.number;
    }

    /// The string payload, or an empty view when this is not a string.
    /// @returns the string, or an empty view when this is not one
    /// @see https://rux-lang.dev/docs/api/json/json-value#as-text
    pub func AsText(&self) -> StringView {
        if self.kind != JsonKind::Text { return StringView(); }
        return self.text.View();
    }

    /// How many elements an array holds, or members an object holds; zero for anything else.
    /// @returns how many elements or members this holds; zero for anything else
    /// @see https://rux-lang.dev/docs/api/json/json-value#length
    pub func Length(&self) -> uint {
        if self.kind == JsonKind::Array { return self.elements.Length(); }
        if self.kind == JsonKind::Object { return self.members.Length(); }
        return 0;
    }

    /// Appends `value` to an array, taking ownership of it.
    /// Reports `false` when this is not an array; `value` is consumed either way, so
    /// a caller does not have to decide who owns it on failure.
    /// @param value the value to act on
    /// @returns whether the element was appended
    /// @see https://rux-lang.dev/docs/api/json/json-value#push
    pub func Push(&var self, value: Self) -> bool {
        if self.kind != JsonKind::Array { return false; }
        self.elements.Push(move value);
        return true;
    }

    /// Appends a member to an object, taking ownership of both name and value.
    /// The order members are added in is the order they are kept and written, which is what makes a document
    /// round-trip recognisably. Nothing here rejects a duplicate name — that policy lives in the parser, where
    /// the caller can choose it.
    /// @param name the member's name
    /// @param value the value to act on
    /// @returns whether the member was added
    /// @see https://rux-lang.dev/docs/api/json/json-value#insert
    pub func Insert(&var self, name: String, value: Self) -> bool {
        if self.kind != JsonKind::Object { return false; }
        var member = JsonMember { name: move name, value: move value };
        self.members.Push(move member);
        return true;
    }

    /// The element at `index`, borrowed, or `none` when there is none.
    /// `self` stays borrowed while the reference is in use.
    /// @param index which one, counting from zero
    /// @returns the element at `index`, or `none` when there is none
    /// @see https://rux-lang.dev/docs/api/json/json-value#at
    pub func At(&self, index: uint) -> &Self? {
        if self.kind != JsonKind::Array { return none; }
        return self.elements.At(index);
    }

    /// The value of the member named `name`, borrowed, or `none` when there is none.
    /// With duplicate names present — which only a permissive parser policy allows — this finds the first,
    /// since that is the one a reader encounters.
    /// @param name the member's name
    /// @returns the first member with that name, or `none` when there is none
    /// @see https://rux-lang.dev/docs/api/json/json-value#find
    pub func Find(&self, name: StringView) -> &Self? {
        if self.kind != JsonKind::Object { return none; }
        var index: uint = 0;
        while index < self.members.Length() {
            var held = name;
            if self.members.At(index) is .Some(member) && member.name.View().Equals(held) { return member.value; }
            index = index + 1;
        }
        return none;
    }

    /// The member at `index`, borrowed, or `none` when there is none.
    /// @param index which one, counting from zero
    /// @returns the member at `index`, or `none` when there is none
    /// @see https://rux-lang.dev/docs/api/json/json-value#member-at
    pub func MemberAt(&self, index: uint) -> &JsonMember? {
        if self.kind != JsonKind::Object { return none; }
        return self.members.At(index);
    }

    /// Removes the first member named `name`, if there is one.
    /// Used by the duplicate-name policy that keeps the last occurrence: dropping the earlier one is what keeps
    /// the object a map rather than a list that happens to repeat itself.
    /// The members after it are popped and pushed back rather than shifted, because shifting would move
    /// owning values around inside the vector, and a move out of a container is the one thing the ownership
    /// rules will not allow silently. Duplicates are rare enough that the cost never matters.
    /// @param name the member's name
    /// @returns whether a member with that name was removed
    /// @see https://rux-lang.dev/docs/api/json/json-value#remove-first
    pub func RemoveFirst(&var self, name: StringView) -> bool {
        if self.kind != JsonKind::Object { return false; }
        var target = self.members.Length();
        let slice = self.members.AsSlice();
        var index: uint = 0;
        while index < slice.length {
            var held = name;
            // Safety: `index` is below `slice.length`, checked by the loop.
            if unsafe { slice.data[index].name.View().Equals(held) } {
                target = index;
                index = slice.length;
            }
            else {
                index = index + 1;
            }
        }
        // The member taken out dies here, taking its name and value with it.
        return self.members.RemoveAt(target) is .Some(_);
    }

    /// Releases everything this value owns.
    /// Written out rather than left to the compiler, because a value owns its strings and its children own
    /// theirs: the recursion here is the shape of the document, and stating it makes the ownership of a nested
    /// tree something a reader can check.
    /// @see https://rux-lang.dev/docs/api/json/json-value#destructor
    func ~JsonValue(&var self) {
        self.number.text.Clear();
        self.text.Clear();
        self.elements.Clear();
        self.members.Clear();
    }
}

extend JsonMember {
    /// Releases the member's name and value.
    /// @see https://rux-lang.dev/docs/api/json/json-value#json-member-destructor
    func ~JsonMember(&var self) {
        self.name.Clear();
    }
}
