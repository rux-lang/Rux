// What a JSON value is, and the one part of it the specification refuses to pin down.
//
// RFC 8259 says a number is a sequence of digits with an optional fraction and exponent, and then says
// implementations may set whatever limits they like on range and precision. That is the whole of it: JSON has no
// integer type, no float type, and no stated precision, so every parser decides for itself and they disagree.
// A parser that turns everything into a double silently corrupts an identifier past 2^53 -- which is how a
// Twitter status id became a different status id in a great deal of software.
//
// So a number here keeps its text, and answers questions about itself from that. It reports whether it fits an
// integer, whether it fits a float, and what it is exactly; a caller asks for the shape it needs and is told if
// the value does not fit rather than being handed something close. The text is also what makes round-tripping
// exact: a document read and written back keeps its numbers as they were written.

import Allocator::Allocator;
import Collections::{ CollectionError, Vector };
import Core::{ Drop, Ordering, Slice };
import Format::{ ParseFloat64, ParseInt64, ParseUint64 };
import Text::{ String, StringView, TextError };

/// Which kind of JSON value this is.
///
/// https://rux-lang.dev/docs/api/json/value-kind
enum JsonKind: int32 {
    /// The literal `null`.
    Null = 0,
    /// `true` or `false`.
    Boolean = 1,
    /// A number, whose precision JSON does not define.
    Number = 2,
    /// A string.
    Text = 3,
    /// An ordered sequence of values.
    Array = 4,
    /// A collection of name-value members.
    Object = 5
}

/// A JSON number, held as the text it was written with.
///
/// JSON does not say what precision a number has, so nothing here decides on the caller's behalf. Ask for the
/// shape wanted -- `AsInt64`, `AsUint64`, `AsFloat64` -- and each reports whether the value fits. Keeping the
/// text is also what lets a document round-trip exactly, which a parser converting to a double cannot do.
///
/// https://rux-lang.dev/docs/api/json/json-number
struct JsonNumber {
    /// The number exactly as it was written.
    text: String;
}

extend JsonNumber {
    /// A number from its text, which is copied.
    ///
    /// https://rux-lang.dev/docs/api/json/json-number/new
    func New(allocator: Allocator, text: Slice<char8>, error: *var TextError) -> JsonNumber {
        // The bytes of a number are always ASCII, so the validated constructor is sound here and cheaper than
        // re-checking them.
        var held = String::FromBytes(allocator, text, error);
        return JsonNumber { text: held };
    }

    /// The number exactly as written.
    ///
    /// https://rux-lang.dev/docs/api/json/json-number/text
    func Text(self: &JsonNumber) -> StringView {
        return self.text.View();
    }

    /// The value as a signed integer, or `false` if it does not fit one.
    ///
    /// A number with a fraction or an exponent does not fit, even when its value happens to be whole: `1.0` is
    /// not an integer in JSON's grammar and pretending otherwise loses the distinction a document was making.
    ///
    /// https://rux-lang.dev/docs/api/json/json-number/as-int64
    func AsInt64(self: &JsonNumber, result: *var int64) -> bool {
        let parsed = ParseInt64(self.text.View().Bytes());
        if parsed.IsError() {
            return false;
        }
        *result = parsed.ValueOr(0i64);
        return true;
    }

    /// The value as an unsigned integer, or `false` if it does not fit one.
    ///
    /// https://rux-lang.dev/docs/api/json/json-number/as-uint64
    func AsUint64(self: &JsonNumber, result: *var uint64) -> bool {
        let parsed = ParseUint64(self.text.View().Bytes());
        if parsed.IsError() {
            return false;
        }
        *result = parsed.ValueOr(0u64);
        return true;
    }

    /// The value as a float, or `false` if the text is not a number at all.
    ///
    /// Succeeds for values a float cannot hold exactly, since that is what a float is for; a caller who needs
    /// exactness should ask for an integer or read the text.
    ///
    /// https://rux-lang.dev/docs/api/json/json-number/as-float64
    func AsFloat64(self: &JsonNumber, result: *var float64) -> bool {
        let parsed = ParseFloat64(self.text.View().Bytes());
        if parsed.IsError() {
            return false;
        }
        *result = parsed.ValueOr(0.0);
        return true;
    }

    /// Whether the text has no fraction and no exponent, so it denotes an integer.
    ///
    /// https://rux-lang.dev/docs/api/json/json-number/is-integral
    func IsIntegral(self: &JsonNumber) -> bool {
        let bytes = self.text.View().Bytes();
        var index: uint = 0;
        while index < bytes.length {
            let c = bytes.data[index] as uint8;
            if c == 0x2Eu8 || c == 0x65u8 || c == 0x45u8 {
                return false;
            }
            index = index + 1;
        }
        return bytes.length > 0u;
    }

    /// Gives the text back.
    ///
    /// https://rux-lang.dev/docs/api/json/json-number/release
    func Release(self: &var JsonNumber) {
        self.text.Clear();
    }
}

/// A name-value pair inside an object.
///
/// https://rux-lang.dev/docs/api/json/json-member
struct JsonMember {
    /// The member's name.
    name: String;
    /// The member's value.
    value: JsonValue;
}

/// A JSON value: one of the six kinds, owning whatever it holds.
///
/// Move-only, because it owns strings and nested values. The allocator it was built with is carried along, so a
/// subtree can be released without the caller having to remember where it came from -- which is what makes a
/// document assembled from several sources safe to take apart.
///
/// The tag is inspected with `Kind` and the payload read with the matching accessor; asking for the wrong one
/// reports failure rather than reinterpreting the bytes.
///
/// https://rux-lang.dev/docs/api/json/json-value
struct JsonValue {
    /// Which of the six kinds this is.
    kind: JsonKind;
    /// The payload of a `Boolean`.
    boolean: bool;
    /// The payload of a `Number`.
    number: JsonNumber;
    /// The payload of a `Text`.
    text: String;
    /// The elements of an `Array`.
    elements: Vector<JsonValue>;
    /// The members of an `Object`, in the order they were seen.
    members: Vector<JsonMember>;
    /// Where everything above came from.
    allocator: Allocator;
}

extend JsonValue {
    /// A recursive document tree cannot be duplicated implicitly.
    func =(self: &var JsonValue, other: &JsonValue);

    /// The literal `null`.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/null
    func Null(allocator: Allocator) -> JsonValue {
        var textError = TextError::None;
        return JsonValue {
            kind: JsonKind::Null,
            boolean: false,
            number: JsonNumber { text: String(allocator) },
            text: String(allocator),
            elements: Vector<JsonValue>(allocator),
            members: Vector<JsonMember>(allocator),
            allocator: allocator
        };
    }

    /// A boolean value.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/boolean
    func Boolean(allocator: Allocator, value: bool) -> JsonValue {
        var held = JsonValue::Null(allocator);
        held.kind = JsonKind::Boolean;
        held.boolean = value;
        return <-held;
    }

    /// A number, from the text it was written with.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/number
    func Number(allocator: Allocator, text: Slice<char8>, error: *var TextError) -> JsonValue {
        var held = JsonValue::Null(allocator);
        held.kind = JsonKind::Number;
        held.number = JsonNumber::New(allocator, text, error);
        return <-held;
    }

    /// A string value.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/text
    func Text(allocator: Allocator, value: Slice<char8>, error: *var TextError) -> JsonValue {
        var held = JsonValue::Null(allocator);
        held.kind = JsonKind::Text;
        held.text = String::FromBytes(allocator, value, error);
        return <-held;
    }

    /// An empty array.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/array
    func Array(allocator: Allocator) -> JsonValue {
        var held = JsonValue::Null(allocator);
        held.kind = JsonKind::Array;
        return <-held;
    }

    /// An empty object.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/object
    func Object(allocator: Allocator) -> JsonValue {
        var held = JsonValue::Null(allocator);
        held.kind = JsonKind::Object;
        return <-held;
    }

    /// Which kind this value is.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/kind
    func Kind(self: &JsonValue) -> JsonKind {
        return self.kind;
    }

    /// Whether this is `null`.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/is-null
    func IsNull(self: &JsonValue) -> bool {
        return self.kind == JsonKind::Null;
    }

    /// The boolean payload, or `false` when this is not a boolean -- which `Kind` distinguishes from a genuine
    /// `false`.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/as-boolean
    func AsBoolean(self: &JsonValue, result: *var bool) -> bool {
        if self.kind != JsonKind::Boolean {
            return false;
        }
        *result = self.boolean;
        return true;
    }

    /// The number payload, borrowed.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/as-number
    func AsNumber(self: &JsonValue) -> *JsonNumber {
        return @self.number;
    }

    /// The string payload, or an empty view when this is not a string.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/as-text
    func AsText(self: &JsonValue) -> StringView {
        if self.kind != JsonKind::Text {
            return StringView();
        }
        return self.text.View();
    }

    /// How many elements an array holds, or members an object holds; zero for anything else.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/length
    func Length(self: &JsonValue) -> uint {
        if self.kind == JsonKind::Array {
            return self.elements.Length();
        }
        if self.kind == JsonKind::Object {
            return self.members.Length();
        }
        return 0u;
    }
}

extend JsonValue {
    /// Appends `value` to an array, taking ownership of it.
    ///
    /// Reports `false` when this is not an array or the allocator refused; `value` is consumed either way, so
    /// a caller does not have to decide who owns it on failure.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/push
    func Push(self: &var JsonValue, value: JsonValue) -> bool {
        if self.kind != JsonKind::Array {
            return false;
        }
        return self.elements.Push(<-value) == CollectionError::None;
    }

    /// Appends a member to an object, taking ownership of both name and value.
    ///
    /// The order members are added in is the order they are kept and written, which is what makes a document
    /// round-trip recognisably. Nothing here rejects a duplicate name -- that policy lives in the parser, where
    /// the caller can choose it.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/insert
    func Insert(self: &var JsonValue, name: String, value: JsonValue) -> bool {
        if self.kind != JsonKind::Object {
            return false;
        }
        var member = JsonMember { name: name, value: <-value };
        return self.members.Push(<-member) == CollectionError::None;
    }

    /// The element at `index`, borrowed, or null when there is none.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/at
    func At(self: &JsonValue, index: uint) -> *JsonValue {
        if self.kind != JsonKind::Array || index >= self.elements.Length() {
            return null;
        }
        let slice = self.elements.AsSlice();
        return @slice.data[index];
    }

    /// The value of the member named `name`, borrowed, or null when there is none.
    ///
    /// With duplicate names present -- which only a permissive parser policy allows -- this finds the first,
    /// since that is the one a reader encounters.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/find
    func Find(self: &JsonValue, name: StringView) -> *JsonValue {
        if self.kind != JsonKind::Object {
            return null;
        }
        let slice = self.members.AsSlice();
        var index: uint = 0;
        while index < slice.length {
            var held = name;
            if slice.data[index].name.View().Equals(held) {
                return @slice.data[index].value;
            }
            index = index + 1;
        }
        return null;
    }

    /// The member at `index`, borrowed, or null when there is none.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/member-at
    func MemberAt(self: &JsonValue, index: uint) -> *JsonMember {
        if self.kind != JsonKind::Object || index >= self.members.Length() {
            return null;
        }
        let slice = self.members.AsSlice();
        return @slice.data[index];
    }
}

extend JsonValue {
    /// Removes the first member named `name`, if there is one.
    ///
    /// Used by the duplicate-name policy that keeps the last occurrence: dropping the earlier one is what keeps
    /// the object a map rather than a list that happens to repeat itself.
    ///
    /// The members after it are popped and pushed back rather than shifted, because shifting would move
    /// owning values around inside the vector, and a move out of a container is the one thing the ownership
    /// rules will not allow silently. Duplicates are rare enough that the cost never matters.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/remove-first
    func RemoveFirst(self: &var JsonValue, name: StringView) -> bool {
        if self.kind != JsonKind::Object {
            return false;
        }
        var target = self.members.Length();
        let slice = self.members.AsSlice();
        var index: uint = 0;
        while index < slice.length {
            var held = name;
            if slice.data[index].name.View().Equals(held) {
                target = index;
                index = slice.length;
            }
            else {
                index = index + 1;
            }
        }
        if target >= self.members.Length() {
            return false;
        }
        var tail = Vector<JsonMember>(self.allocator);
        while self.members.Length() > target + 1u {
            var moved = JsonMember { name: String(self.allocator), value: JsonValue::Null(self.allocator) };
            if !self.members.TryPop(@moved) {
                break;
            }
            tail.Push(<-moved);
        }
        var discarded = JsonMember { name: String(self.allocator), value: JsonValue::Null(self.allocator) };
        self.members.TryPop(@discarded);
        // `discarded` dies here, taking its name and value with it.
        while tail.Length() > 0u {
            var restored = JsonMember { name: String(self.allocator), value: JsonValue::Null(self.allocator) };
            if !tail.TryPop(@restored) {
                break;
            }
            self.members.Push(<-restored);
        }
        return true;
    }
}

extend JsonValue {
    /// Releases everything this value owns.
    ///
    /// Written out rather than left to the compiler, because a value owns its strings and its children own
    /// theirs: the recursion here is the shape of the document, and stating it makes the ownership of a nested
    /// tree something a reader can check.
    ///
    /// https://rux-lang.dev/docs/api/json/json-value/destructor
    func ~JsonValue(self: &var JsonValue) {
        self.number.text.Clear();
        self.text.Clear();
        self.elements.Clear();
        self.members.Clear();
    }
}

extend JsonMember {
    /// A member owns its recursive value and cannot be duplicated implicitly.
    func =(self: &var JsonMember, other: &JsonMember);

    /// Releases the member's name and value.
    ///
    /// https://rux-lang.dev/docs/api/json/json-member/destructor
    func ~JsonMember(self: &var JsonMember) {
        self.name.Clear();
    }
}

// Temporary recursive-capability compatibility. Destruction is owned by the `~Type` methods above; these
// markers disappear at the compatibility cutover once recursive generated moves resolve without `Drop`.
extend JsonValue : Drop {
    func Drop(self: &var JsonValue) {}
}

extend JsonMember : Drop {
    func Drop(self: &var JsonMember) {}
}
