// A queue that threads send values into and receive values out of, with room for a fixed number of them.
// The values sit in a ring under one lock. A sender waits while the ring is full and a receiver while it is empty,
// each on its own sequence word that the other side advances and wakes. Closing the channel wakes everyone: senders
// then fail and get their value back, and receivers take what is left and then learn that nothing more will come.

import Core::{ AtomicFetchAdd, AtomicLoad, MemoryOrder, Panic };
import Memory::{ Alloc, Free };
import Sync::{
    AllocateBlock, DestroyBlock, DiscardValue, LockWord, LockWordContended, ReleaseBlock, RetainBlock, UnlockWord,
    WaitWhile, WakeAll, WakeOne
};

struct ChannelBlock<T> {
    references: uint32;
    word: uint32;
    // Advanced when a value arrives or the channel closes; receivers sleep on it.
    arrivals: uint32;
    // Advanced when a value leaves or the channel closes; senders sleep on it.
    departures: uint32;
    closed: bool;
    head: uint;
    length: uint;
    capacity: uint;
    slots: *var T;
}

/// A bounded queue of values passed between threads, any number of which may send and receive.
/// Values arrive in the order they were sent. `Clone` gives another handle to the same channel; the values still in
/// it are destroyed when the last handle is gone. A handle is not copied.
/// @typeParam T the type of the values
/// @see https://rux-lang.dev/docs/api/sync/channel#channel
pub struct Channel<T> {
    block: *var ChannelBlock<T>;
}

extend Channel<T> {
    /// A channel with room for `capacity` values. Zero capacity is a program error, as is running out of memory.
    /// @param capacity how many values may wait in the channel at once
    /// @returns the first handle to it
    /// @see https://rux-lang.dev/docs/api/sync/channel#channel-new
    pub func Channel(capacity: uint) -> Self {
        if capacity == 0u { Panic("a channel needs room for at least one value"); }
        // Safety: `Alloc` returns memory aligned for any type, and this retyping only names the `capacity` slots it
        // asked for.
        let slots = unsafe { Alloc(capacity * sizeof(T)) as *var T };
        if slots == null { Panic("out of memory for a channel"); }
        return Self {
            block: AllocateBlock(ChannelBlock<T> {
                references: 1, word: 0, arrivals: 0, departures: 0, closed: false, head: 0, length: 0,
                capacity, slots
            })
        };
    }

    /// Another handle to the same channel.
    /// @returns the handle
    /// @see https://rux-lang.dev/docs/api/sync/channel#clone
    pub func Clone(&self) -> Self {
        // Safety: this handle holds a count on `self.block`, so the block is live, and its count word is reached only
        // atomically.
        unsafe { RetainBlock(@self.block.references); }
        return Self { block: self.block };
    }

    /// Sends `value`, waiting while the channel is full.
    /// @param value the value to send
    /// @returns nothing, or fails with the value when the channel is closed
    /// @see https://rux-lang.dev/docs/api/sync/channel#send
    pub func Send(&self, value: T) throws T {
        let block = self.block;
        // Safety: this handle holds a count on `block`, so the block is live, and its lock word is reached only
        // atomically.
        unsafe { LockWord(@block.word); }
        // Safety: this thread holds the lock on `block`, a live block this handle counts in, so its fields are steady.
        while unsafe { block.length == block.capacity && !block.closed } {
            // Safety: this thread holds the lock on `block`, a live block this handle counts in; the word waited on is
            // its `departures`, which outlives the wait for the same reason, and every thread reaches it atomically.
            unsafe {
                let departures = AtomicLoad(@block.departures, MemoryOrder::Relaxed);
                UnlockWord(@block.word);
                WaitWhile(@block.departures, departures, -1);
                LockWordContended(@block.word);
            }
        }
        // Safety: this thread holds the lock on `block`, a live block this handle counts in, so its fields are steady.
        if unsafe { block.closed } {
            // Safety: this thread holds the lock on `block`, a live block this handle counts in.
            unsafe { UnlockWord(@block.word); }
            throw value;
        }
        // Safety: this thread holds the lock on `block`, which `Push` releases, and the ring has room, checked above.
        unsafe { self.Push(move value); }
    }

    /// Sends `value` if there is room, without waiting.
    /// @param value the value to send
    /// @returns nothing, or fails with the value when the channel is full or closed
    /// @see https://rux-lang.dev/docs/api/sync/channel#try-send
    pub func TrySend(&self, value: T) throws T {
        let block = self.block;
        // Safety: this handle holds a count on `block`, so the block is live, and its lock word is reached only
        // atomically.
        unsafe { LockWord(@block.word); }
        // Safety: this thread holds the lock on `block`, a live block this handle counts in, so its fields are steady.
        if unsafe { block.closed || block.length == block.capacity } {
            // Safety: this thread holds the lock on `block`, a live block this handle counts in.
            unsafe { UnlockWord(@block.word); }
            throw value;
        }
        // Safety: this thread holds the lock on `block`, which `Push` releases, and the ring has room, checked above.
        unsafe { self.Push(move value); }
    }

    /// Receives the oldest value, waiting while the channel is empty.
    /// @returns the value, or none once the channel is closed and empty
    /// @see https://rux-lang.dev/docs/api/sync/channel#receive
    pub func Receive(&self) -> T? {
        let block = self.block;
        // Safety: this handle holds a count on `block`, so the block is live, and its lock word is reached only
        // atomically.
        unsafe { LockWord(@block.word); }
        // Safety: this thread holds the lock on `block`, a live block this handle counts in, so its fields are steady.
        while unsafe { block.length == 0u && !block.closed } {
            // Safety: this thread holds the lock on `block`, a live block this handle counts in; the word waited on is
            // its `arrivals`, which outlives the wait for the same reason, and every thread reaches it atomically.
            unsafe {
                let arrivals = AtomicLoad(@block.arrivals, MemoryOrder::Relaxed);
                UnlockWord(@block.word);
                WaitWhile(@block.arrivals, arrivals, -1);
                LockWordContended(@block.word);
            }
        }
        // Safety: this thread holds the lock on `block`, a live block this handle counts in, so its fields are steady.
        if unsafe { block.length == 0u } {
            // Safety: this thread holds the lock on `block`, a live block this handle counts in.
            unsafe { UnlockWord(@block.word); }
            return none;
        }
        // Safety: this thread holds the lock on `block`, which `Pop` releases, and the ring holds a value, checked
        // above.
        return unsafe { self.Pop() };
    }

    /// Receives the oldest value if there is one, without waiting.
    /// @returns the value, or none when the channel is empty
    /// @see https://rux-lang.dev/docs/api/sync/channel#try-receive
    pub func TryReceive(&self) -> T? {
        let block = self.block;
        // Safety: this handle holds a count on `block`, so the block is live, and its lock word is reached only
        // atomically.
        unsafe { LockWord(@block.word); }
        // Safety: this thread holds the lock on `block`, a live block this handle counts in, so its fields are steady.
        if unsafe { block.length == 0u } {
            // Safety: this thread holds the lock on `block`, a live block this handle counts in.
            unsafe { UnlockWord(@block.word); }
            return none;
        }
        // Safety: this thread holds the lock on `block`, which `Pop` releases, and the ring holds a value, checked
        // above.
        return unsafe { self.Pop() };
    }

    /// Closes the channel: sends fail from now on, and receivers take what is left and then get none. Closing a
    /// closed channel does nothing.
    /// @see https://rux-lang.dev/docs/api/sync/channel#close
    pub func Close(&self) {
        let block = self.block;
        // Safety: this handle holds a count on `block`, so the block is live, and its lock word is reached only
        // atomically.
        unsafe { LockWord(@block.word); }
        // Safety: this thread holds the lock on `block`, a live block this handle counts in, and its sequence words are
        // reached only atomically.
        unsafe {
            block.closed = true;
            AtomicFetchAdd(@block.arrivals, 1u32, MemoryOrder::Relaxed);
            AtomicFetchAdd(@block.departures, 1u32, MemoryOrder::Relaxed);
            UnlockWord(@block.word);
            WakeAll(@block.arrivals);
            WakeAll(@block.departures);
        }
    }

    /// Whether the channel was closed.
    /// @returns true once `Close` was called on any handle
    /// @see https://rux-lang.dev/docs/api/sync/channel#is-closed
    pub func IsClosed(&self) -> bool {
        let block = self.block;
        // Safety: this handle holds a count on `block`, so the block is live, and its lock word is reached only
        // atomically.
        unsafe { LockWord(@block.word); }
        // Safety: this thread holds the lock on `block`, a live block this handle counts in, so the field is steady.
        let closed = unsafe { block.closed };
        // Safety: this thread holds the lock on `block`, a live block this handle counts in.
        unsafe { UnlockWord(@block.word); }
        return closed;
    }

    /// How many values wait in the channel right now, which other threads may change at any moment.
    /// @returns the number of values
    /// @see https://rux-lang.dev/docs/api/sync/channel#length
    pub func Length(&self) -> uint {
        let block = self.block;
        // Safety: this handle holds a count on `block`, so the block is live, and its lock word is reached only
        // atomically.
        unsafe { LockWord(@block.word); }
        // Safety: this thread holds the lock on `block`, a live block this handle counts in, so the field is steady.
        let length = unsafe { block.length };
        // Safety: this thread holds the lock on `block`, a live block this handle counts in.
        unsafe { UnlockWord(@block.word); }
        return length;
    }

    // Appends a value under the lock, releases it and wakes a receiver.
    // Safety: the calling thread must hold the lock on `self.block`, and the ring must have room for one more value.
    unsafe func Push(&self, value: T) {
        let block = self.block;
        Slot<T>(block, (block.head + block.length) % block.capacity)[0] = move value;
        block.length = block.length + 1u;
        AtomicFetchAdd(@block.arrivals, 1u32, MemoryOrder::Relaxed);
        UnlockWord(@block.word);
        WakeOne(@block.arrivals);
    }

    // Takes the oldest value under the lock, releases it and wakes a sender.
    // Safety: the calling thread must hold the lock on `self.block`, and the ring must hold at least one value.
    unsafe func Pop(&self) -> T? {
        let block = self.block;
        let value = move Slot<T>(block, block.head)[0];
        block.head = (block.head + 1u) % block.capacity;
        block.length = block.length - 1u;
        AtomicFetchAdd(@block.departures, 1u32, MemoryOrder::Relaxed);
        UnlockWord(@block.word);
        WakeOne(@block.departures);
        return move value;
    }

    func ~Channel(&var self) {
        let block = self.block;
        // Safety: this handle holds a count on `block`, so the block is live, and its count word is reached only
        // atomically.
        if !unsafe { ReleaseBlock(@block.references) } { return; }
        // Safety: this handle let go of the last count, so no other thread reaches `block`; the ring invariant holds:
        // `head` is below `capacity` and the `length` slots from it hold live values in `slots`, from `Alloc`.
        unsafe {
            while block.length != 0u {
                DiscardValue<T>(Slot<T>(block, block.head));
                block.head = (block.head + 1u) % block.capacity;
                block.length = block.length - 1u;
            }
            Free(block.slots as *opaque);
            DestroyBlock<ChannelBlock<T>>(block);
        }
    }
}

// The slot at `index` in the ring.
// Safety: `block` must be a live channel block and `index` must be below its `capacity`.
unsafe func Slot<T>(block: *var ChannelBlock<T>, index: uint) -> *var T {
    return ((block.slots as uint) + index * sizeof(T)) as *var T;
}
