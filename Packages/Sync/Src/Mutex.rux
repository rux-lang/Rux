import Sync::SpinLock;

/// An RAII guard that provides access to the protected data
/// and automatically releases the lock when dropped.
///
/// https://rux-lang.dev/docs/api/sync/mutex-guard
struct MutexGuard<T> {
    lock: *var SpinLock;
    data: *var T;
}

extend MutexGuard<T> {
    /// Obtains a pointer to the protected data.
    func Data(self: &MutexGuard<T>) -> *var T {
        return self.data;
    }

    /// Releases the mutex lock when the guard is dropped.
    func ~MutexGuard(self: &var MutexGuard<T>) {
        (*self.lock).Unlock();
    }
}

/// A mutual exclusion primitive useful for protecting shared data.
///
/// https://rux-lang.dev/docs/api/sync/mutex
struct Mutex<T> {
    lock: SpinLock;
    data: T;
}

extend Mutex<T> {
    /// Creates a new `Mutex` in an unlocked state ready for use.
    func Mutex(data: T) -> Mutex<T> {
        return Mutex<T> {
            lock: SpinLock(),
            data: data
        };
    }

    /// Acquires the mutex, spinning until available.
    /// Returns an RAII `MutexGuard` that releases the mutex on drop.
    func Lock(self: &var Mutex<T>) -> MutexGuard<T> {
        self.lock.Lock();
        return MutexGuard<T> {
            lock: @self.lock,
            data: @self.data
        };
    }

    /// Consumes the mutex, returning the underlying data.
    func IntoInner(self: Mutex<T>) -> T {
        return self.data;
    }
}
