import Sync::{ AtomicUint32, MemoryOrder, SpinLoopHint };

/// A synchronization primitive for thread-safe one-time initialization.
///
/// https://rux-lang.dev/docs/api/sync/once
pub struct Once {
    pub state: AtomicUint32;
}

extend Once {
    /// Creates a new unexecuted `Once` cell.
    pub func Once() -> Once {
        return Once {
            state: AtomicUint32(0u32)
        };
    }

    /// Returns `true` if the one-time operation has completed.
    pub func IsCompleted(self: &Once) -> bool {
        return self.state.Load(MemoryOrder::Acquire) == 2u32;
    }
}
