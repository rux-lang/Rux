// Sockets: endpoints of network connections and datagrams, reached through the system calls that make and use them.
// Addresses are passed as the `sockaddr` bytes the kernel reads, built by the caller, so these wrappers stay as thin
// as the rest of the package. Name resolution is not a system call and lives in `Rux/Net`.

import macOS::{ FileDescriptor, Normalize, SystemLib };

/// `AF_INET`: the IPv4 address family.
/// @see https://rux-lang.dev/docs/api/macos/socket#af-inet
#Allow("naming.const")
pub const AF_INET: int32 = 2;

/// `AF_INET6`: the IPv6 address family.
/// @see https://rux-lang.dev/docs/api/macos/socket#af-inet6
#Allow("naming.const")
pub const AF_INET6: int32 = 30;

/// `SOCK_STREAM`: a connected byte stream.
/// @see https://rux-lang.dev/docs/api/macos/socket#sock-stream
#Allow("naming.const")
pub const SOCK_STREAM: int32 = 1;

/// `SOCK_DGRAM`: individual datagrams.
/// @see https://rux-lang.dev/docs/api/macos/socket#sock-dgram
#Allow("naming.const")
pub const SOCK_DGRAM: int32 = 2;

/// `SOL_SOCKET`: the level of the options every socket has.
/// @see https://rux-lang.dev/docs/api/macos/socket#sol-socket
#Allow("naming.const")
pub const SOL_SOCKET: int32 = 0xffff;

/// `SO_REUSEADDR`: let a listening address be bound again while old connections to it wind down.
/// @see https://rux-lang.dev/docs/api/macos/socket#so-reuseaddr
#Allow("naming.const")
pub const SO_REUSEADDR: int32 = 4;

/// `SO_RCVTIMEO`: how long a receive waits.
/// @see https://rux-lang.dev/docs/api/macos/socket#so-rcvtimeo
#Allow("naming.const")
pub const SO_RCVTIMEO: int32 = 0x1006;

/// `SO_SNDTIMEO`: how long a send waits.
/// @see https://rux-lang.dev/docs/api/macos/socket#so-sndtimeo
#Allow("naming.const")
pub const SO_SNDTIMEO: int32 = 0x1005;

/// `IPPROTO_TCP`: the level of TCP's options.
/// @see https://rux-lang.dev/docs/api/macos/socket#ipproto-tcp
#Allow("naming.const")
pub const IPPROTO_TCP: int32 = 6;

/// `TCP_NODELAY`: send small writes at once rather than gathering them.
/// @see https://rux-lang.dev/docs/api/macos/socket#tcp-nodelay
#Allow("naming.const")
pub const TCP_NODELAY: int32 = 1;

/// `IPPROTO_IPV6`: the level of IPv6's options.
/// @see https://rux-lang.dev/docs/api/macos/socket#ipproto-ipv6
#Allow("naming.const")
pub const IPPROTO_IPV6: int32 = 41;

/// `IPV6_V6ONLY`: accept only IPv6 on an IPv6 socket.
/// @see https://rux-lang.dev/docs/api/macos/socket#ipv6-v6only
#Allow("naming.const")
pub const IPV6_V6ONLY: int32 = 27;

/// `SO_NOSIGPIPE`: report a closed peer as an error rather than with `SIGPIPE`.
/// @see https://rux-lang.dev/docs/api/macos/socket#so-nosigpipe
#Allow("naming.const")
pub const SO_NOSIGPIPE: int32 = 0x1022;

#Link(SystemLib)
extern {
    func socket(domain: int32, kind: int32, protocol: int32) -> int32;
    func connect(fd: int32, address: *opaque, length: uint32) -> int32;
    func bind(fd: int32, address: *opaque, length: uint32) -> int32;
    func listen(fd: int32, backlog: int32) -> int32;
    func sendto(fd: int32, buffer: *opaque, count: uint, flags: int32, address: *opaque, length: uint32) -> int64;
    func recvfrom(fd: int32, buffer: *var opaque, count: uint, flags: int32, address: *var opaque, length: *var uint32) -> int64;
    func shutdown(fd: int32, how: int32) -> int32;
    func setsockopt(fd: int32, level: int32, name: int32, value: *opaque, length: uint32) -> int32;
    func getsockname(fd: int32, address: *var opaque, length: *var uint32) -> int32;
    func getpeername(fd: int32, address: *var opaque, length: *var uint32) -> int32;
    func accept(fd: int32, address: *var opaque, length: *var uint32) -> int32;
}

/// Opens a socket.
/// @param domain the address family, such as `AF_INET`
/// @param kind the socket type, such as `SOCK_STREAM`, combined with `SOCK_CLOEXEC`
/// @param protocol the protocol, or zero for the family's default
/// @returns the new descriptor, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#socket
/// @see https://keith.github.io/xcode-man-pages/socket.2.html
pub func Socket(domain: int32, kind: int32, protocol: int32) -> int64 {
    return Normalize(socket(domain, kind, protocol) as int64);
}

/// Connects a socket to `address`, waiting for a stream connection to be made.
/// @param fd the socket
/// @param address the address, a `sockaddr`
/// @param length the address's size in bytes
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#connect
/// @see https://keith.github.io/xcode-man-pages/connect.2.html
pub func Connect(fd: FileDescriptor, address: *opaque, length: uint32) -> int64 {
    return Normalize(connect(fd, address, length) as int64);
}

/// Gives a socket its local address.
/// @param fd the socket
/// @param address the address, a `sockaddr`
/// @param length the address's size in bytes
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#bind
/// @see https://keith.github.io/xcode-man-pages/bind.2.html
pub func Bind(fd: FileDescriptor, address: *opaque, length: uint32) -> int64 {
    return Normalize(bind(fd, address, length) as int64);
}

/// Makes a bound stream socket accept connections.
/// @param fd the socket
/// @param backlog how many connections may wait to be accepted
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#listen
/// @see https://keith.github.io/xcode-man-pages/listen.2.html
pub func Listen(fd: FileDescriptor, backlog: int32) -> int64 {
    return Normalize(listen(fd, backlog) as int64);
}

/// Accepts a waiting connection as a new socket.
/// @param fd the listening socket
/// @param address receives the peer's address, or null
/// @param length the address buffer's size, then the address's, or null
/// @param flags ignored: macOS has no `accept4`, and the new socket is closed on exec by the caller if wanted
/// @returns the new descriptor, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#accept4
/// @see https://keith.github.io/xcode-man-pages/accept.2.html
pub func Accept4(fd: FileDescriptor, address: *var opaque, length: *var uint32, flags: int32) -> int64 {
    return Normalize(accept(fd, address, length) as int64);
}

/// Sends bytes on a socket, to `address` when it is not connected.
/// @param fd the socket
/// @param buffer the bytes
/// @param count how many
/// @param flags flags such as `MSG_NOSIGNAL`
/// @param address the destination, or null for a connected socket
/// @param length the destination's size
/// @returns the bytes sent, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#sendto
/// @see https://keith.github.io/xcode-man-pages/sendto.2.html
pub func SendTo(fd: FileDescriptor, buffer: *opaque, count: uint, flags: int32, address: *opaque, length: uint32) -> int64 {
    return Normalize(sendto(fd, buffer, count, flags, address, length) as int64);
}

/// Receives bytes from a socket, and where they came from.
/// @param fd the socket
/// @param buffer receives the bytes
/// @param count how many fit
/// @param flags flags, or zero
/// @param address receives the sender's address, or null
/// @param length the address buffer's size, then the address's, or null
/// @returns the bytes received, zero once a stream's peer closed it, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#receivefrom
/// @see https://keith.github.io/xcode-man-pages/recvfrom.2.html
pub func ReceiveFrom(fd: FileDescriptor, buffer: *var opaque, count: uint, flags: int32, address: *var opaque, length: *var uint32) -> int64 {
    return Normalize(recvfrom(fd, buffer, count, flags, address, length) as int64);
}

/// Ends one or both directions of a connection.
/// @param fd the socket
/// @param how `SHUT_RD`, `SHUT_WR` or `SHUT_RDWR`
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#shutdown
/// @see https://keith.github.io/xcode-man-pages/shutdown.2.html
pub func Shutdown(fd: FileDescriptor, how: int32) -> int64 {
    return Normalize(shutdown(fd, how) as int64);
}

/// Sets a socket option.
/// @param fd the socket
/// @param level the option's level, such as `SOL_SOCKET`
/// @param name the option
/// @param value the option's value
/// @param length the value's size in bytes
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#setsocketoption
/// @see https://keith.github.io/xcode-man-pages/setsockopt.2.html
pub func SetSocketOption(fd: FileDescriptor, level: int32, name: int32, value: *opaque, length: uint32) -> int64 {
    return Normalize(setsockopt(fd, level, name, value, length) as int64);
}

/// Reads a socket's local address.
/// @param fd the socket
/// @param address receives the address
/// @param length the buffer's size, then the address's
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#getsocketname
/// @see https://keith.github.io/xcode-man-pages/getsockname.2.html
pub func GetSocketName(fd: FileDescriptor, address: *var opaque, length: *var uint32) -> int64 {
    return Normalize(getsockname(fd, address, length) as int64);
}

/// Reads the address of a connected socket's peer.
/// @param fd the socket
/// @param address receives the address
/// @param length the buffer's size, then the address's
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/macos/socket#getpeername
/// @see https://keith.github.io/xcode-man-pages/getpeername.2.html
pub func GetPeerName(fd: FileDescriptor, address: *var opaque, length: *var uint32) -> int64 {
    return Normalize(getpeername(fd, address, length) as int64);
}

/// The C library's `addrinfo`: one result of `getaddrinfo`, linked to the next.
/// @see https://rux-lang.dev/docs/api/macos/resolve#address-info
pub struct AddressInfo {
    /// Flags such as `AI_PASSIVE`.
    pub flags: int32;
    /// The address family, or zero for any.
    pub family: int32;
    /// The socket type, or zero for any.
    pub socketType: int32;
    /// The protocol, or zero for any.
    pub protocol: int32;
    /// The size of `address` in bytes.
    pub addressLength: uint32;
    /// The host's canonical name, or null.
    pub canonicalName: *char8;
    /// The address, a `sockaddr`.
    pub address: *opaque;
    /// The next result, or null after the last.
    pub next: *var AddressInfo;
}

#Link(SystemLib)
extern {
    /// Looks up the addresses of a host and service.
    /// @param node the host name or numeric address, NUL-terminated, or null
    /// @param service the service name or port number, NUL-terminated, or null
    /// @param hints what kind of results are wanted, or null for every kind
    /// @param result receives the first result, freed with `freeaddrinfo`
    /// @returns zero, or an `EAI_*` code
    /// @see https://rux-lang.dev/docs/api/macos/resolve#getaddrinfo
    /// @see https://keith.github.io/xcode-man-pages/getaddrinfo.3.html
    pub func getaddrinfo(node: *char8, service: *char8, hints: *AddressInfo, result: *var *var AddressInfo) -> int32;

    /// Frees the results of `getaddrinfo`.
    /// @param info the first result
    /// @see https://rux-lang.dev/docs/api/macos/resolve#freeaddrinfo
    /// @see https://keith.github.io/xcode-man-pages/freeaddrinfo.3.html
    pub func freeaddrinfo(info: *var AddressInfo);
}
