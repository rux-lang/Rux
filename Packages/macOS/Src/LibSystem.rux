import Core::{ #target };

// The Darwin ABI: libSystem's own entry points, under the symbols it exports.
//
// **Apple does not support calling the kernel directly.** The trap numbers are private, they have changed between
// releases, and a binary that issues its own `syscall` or `svc` is not a binary Apple undertakes to keep running --
// on Apple Silicon the trap interface is not reachable from ordinary code at all. libSystem is the ABI, and this
// package binds it. That is the difference between this package and the Linux and FreeBSD ones, which do call the
// kernel directly because those kernels publish a stable numbering.
//
// Every declaration here reports failure the way C does: `-1` and a positive `errno`. The wrappers elsewhere in this
// package fold that into one value with `Errors::Normalize`, so nothing above them has to look in two places.

/// The library every Darwin interface is reached through.
///
/// A single dynamic library re-exporting libc, libm, libpthread and the rest; there is no separate `libc.dylib` to
/// link on Apple platforms.
///
/// https://rux-lang.dev/docs/api/macos/system-lib
const SystemLib = "libSystem.B.dylib";

#Link(SystemLib)
extern {
    // Returns the address of the calling thread's errno
    //
    // Darwin has no errno variable: the storage is per thread and reached only through this accessor.
    // https://keith.github.io/xcode-man-pages/intro.2.html
    func __error() -> *var int32;

    // Reads up to count bytes from a descriptor into a buffer; returns the count read, or -1
    // https://keith.github.io/xcode-man-pages/read.2.html
    func read(fd: int32, buffer: *var opaque, count: uint) -> int64;

    // Writes up to count bytes from a buffer to a descriptor; returns the count written, or -1
    // https://keith.github.io/xcode-man-pages/write.2.html
    func write(fd: int32, buffer: *opaque, count: uint) -> int64;

    // Closes a descriptor; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/close.2.html
    func close(fd: int32) -> int32;

    // Opens a path relative to a directory descriptor; returns a descriptor, or -1
    // https://keith.github.io/xcode-man-pages/open.2.html
    func openat(directoryFd: int32, path: *char8, flags: int32, mode: uint32) -> int32;

    // Moves a descriptor's file offset; returns the resulting offset, or -1
    // https://keith.github.io/xcode-man-pages/lseek.2.html
    func lseek(fd: int32, offset: int64, whence: int32) -> int64;

    // Flushes a descriptor's writes toward the device; returns zero, or -1
    //
    // On Darwin this does not guarantee the device has written the data. F_FULLFSYNC through fcntl is what does,
    // which is a difference from every other supported system and the reason a durable write needs more here.
    // https://keith.github.io/xcode-man-pages/fsync.2.html
    func fsync(fd: int32) -> int32;

    // Sets the length of the file behind a descriptor; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/ftruncate.2.html
    func ftruncate(fd: int32, length: int64) -> int32;

    // Removes a name from a directory; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/unlink.2.html
    func unlinkat(directoryFd: int32, path: *char8, flags: int32) -> int32;

    // Creates a directory; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/mkdir.2.html
    func mkdirat(directoryFd: int32, path: *char8, mode: uint16) -> int32;

    // Renames a path; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/rename.2.html
    func renameat(oldDirectoryFd: int32, oldPath: *char8, newDirectoryFd: int32, newPath: *char8) -> int32;

    // Duplicates a descriptor onto another; returns the new descriptor, or -1
    // https://keith.github.io/xcode-man-pages/dup2.2.html
    func dup2(oldFd: int32, newFd: int32) -> int32;

    // Creates a pipe and writes its two descriptors; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/pipe.2.html
    func pipe(descriptors: *var int32) -> int32;

    // Creates a hard link relative to directory descriptors; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/link.2.html
    func linkat(oldDirectoryFd: int32, oldPath: *char8, newDirectoryFd: int32, newPath: *char8,
                flags: int32) -> int32;

    // Creates a symbolic link relative to a directory descriptor; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/symlink.2.html
    func symlinkat(target: *char8, newDirectoryFd: int32, linkPath: *char8) -> int32;

    // Writes the current working directory into a buffer; returns the buffer, or null
    // https://keith.github.io/xcode-man-pages/getcwd.3.html
    func getcwd(buffer: *var char8, size: uint) -> *var char8;

    // Makes a path the process's working directory; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/chdir.2.html
    func chdir(path: *char8) -> int32;

    // Reads the text a symbolic link holds; returns the byte count, or -1
    // https://keith.github.io/xcode-man-pages/readlink.2.html
    func readlinkat(directoryFd: int32, path: *char8, buffer: *var char8, size: uint) -> int64;

    // Sets a file's permission bits relative to a directory descriptor; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/chmod.2.html
    func fchmodat(directoryFd: int32, path: *char8, mode: uint16, flags: int32) -> int32;

    // Sets a file's access and modification times relative to a directory descriptor; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/utimensat.2.html
    func utimensat(directoryFd: int32, path: *char8, times: *opaque, flags: int32) -> int32;

    // Reads directory entries in the 64-bit-inode layout; returns the bytes filled, zero at the end, or -1
    //
    // The plain readdir symbol on x86-64 resolves to the 32-bit-inode variant with a different record layout, so
    // this is the one entry point whose records are the same on both architectures.
    // https://keith.github.io/xcode-man-pages/getdirentries.2.html
    func __getdirentries64(fd: int32, buffer: *var opaque, byteCount: uint, position: *var int64) -> int64;

    // Creates a memory mapping; returns its address, or MAP_FAILED
    // https://keith.github.io/xcode-man-pages/mmap.2.html
    func mmap(address: *opaque, length: uint, protection: int32, flags: int32, fd: int32,
              offset: int64) -> *var opaque;

    // Releases a memory mapping; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/munmap.2.html
    func munmap(address: *opaque, length: uint) -> int32;

    // Changes what may be done with a range of pages; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/mprotect.2.html
    func mprotect(address: *opaque, length: uint, protection: int32) -> int32;

    // Advises the kernel how a range of pages is about to be used; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/madvise.2.html
    func madvise(address: *opaque, length: uint, advice: int32) -> int32;

    // Ends the process; does not return
    //
    // An extern block does not take a #NoReturn() attribute, so this is declared as an ordinary call that happens
    // never to come back.
    // https://keith.github.io/xcode-man-pages/exit.3.html
    func _exit(status: int32);

    // Reports the system page size; cannot fail
    //
    // Darwin's page size is not the same on every machine: Apple Silicon uses 16 KiB where x86-64 uses 4 KiB, which
    // is why this is asked rather than assumed.
    // https://keith.github.io/xcode-man-pages/getpagesize.3.html
    func getpagesize() -> int32;

    // Returns the calling process's identifier; cannot fail
    // https://keith.github.io/xcode-man-pages/getpid.2.html
    func getpid() -> int32;

    // Reads a clock into a timespec; returns zero, or -1
    //
    // Available since macOS 10.12. Earlier releases have only gettimeofday and the mach clock.
    // https://keith.github.io/xcode-man-pages/clock_gettime.3.html
    func clock_gettime(clockId: int32, time: &var Timespec) -> int32;

    // Reads the wall clock into a timeval; returns zero, or -1
    // https://keith.github.io/xcode-man-pages/gettimeofday.2.html
    func gettimeofday(time: &var Timeval, timezone: *var opaque) -> int32;

    // Suspends the caller for a duration; returns zero, or -1 with EINTR
    // https://keith.github.io/xcode-man-pages/nanosleep.2.html
    func nanosleep(request: &Timespec, remaining: *var Timespec) -> int32;

    // Fills a buffer with unpredictable bytes; cannot fail
    //
    // Darwin's generator is always seeded and this call never blocks and never reports failure, which is why it
    // returns nothing.
    // https://keith.github.io/xcode-man-pages/arc4random.3.html
    func arc4random_buf(buffer: *var opaque, length: uint);

    // Loads a shared object and returns a handle, or null
    // https://keith.github.io/xcode-man-pages/dlopen.3.html
    func dlopen(filename: *char8, flags: int32) -> *var opaque;

    // Finds a symbol in a loaded object and returns its address, or null
    // https://keith.github.io/xcode-man-pages/dlsym.3.html
    func dlsym(handle: *var opaque, symbol: *char8) -> *var opaque;

    // Drops one reference to a loaded object; returns zero on success
    // https://keith.github.io/xcode-man-pages/dlclose.3.html
    func dlclose(handle: *var opaque) -> int32;

    // Reports the most recent loader error and clears it, or returns null
    // https://keith.github.io/xcode-man-pages/dlerror.3.html
    func dlerror() -> *char8;
}

// `fstatat` is the one entry point whose symbol depends on the architecture. Darwin grew a 64-bit `ino_t` after
// x86-64 shipped, so on that architecture the modern layout lives behind a decorated symbol and the plain name
// still answers with the older, narrower `struct stat`; Apple Silicon, which has never had the old layout, exports
// only the plain name. Binding the wrong one does not fail to link -- it fills a differently shaped buffer -- so
// the architecture picks the symbol here, once, and everything above reads one layout.
when #target.arch {
    .X86_64 => {
        #Library("libSystem.B.dylib")
        #Symbol("fstatat$INODE64")
        extern func fstatat(directoryFd: int32, path: *char8, statBuffer: *var opaque, flags: int32) -> int32;

        #Library("libSystem.B.dylib")
        #Symbol("fstat$INODE64")
        extern func fstat(fd: int32, statBuffer: *var opaque) -> int32;
    },
    else => {
        #Library("libSystem.B.dylib")
        extern func fstatat(directoryFd: int32, path: *char8, statBuffer: *var opaque, flags: int32) -> int32;

        #Library("libSystem.B.dylib")
        extern func fstat(fd: int32, statBuffer: *var opaque) -> int32;
    }
}
