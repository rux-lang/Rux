// How a libSystem call reports failure, and the numbers it reports.
//
// Darwin reports the way C does: the call returns `-1` and leaves a positive number in the thread's `errno`, which
// is reached through the `__error` accessor rather than as a variable. That is two different things for a caller to
// look at, so `Normalize` folds them into the one convention the Linux and FreeBSD packages already use -- a value,
// or a small negative error number -- and `IsError` and `Errno` then read the result the same way on all three.
//
// The names keep the system's own spelling. The values are Darwin's, which agree with FreeBSD's more often than with
// Linux's but match neither completely.

/// `EPERM`: the operation is not permitted to this caller.
///
/// https://rux-lang.dev/docs/api/macos/eperm
#Allow("naming.const")
const EPERM: int64 = 1;

/// `ENOENT`: no such file or directory.
///
/// https://rux-lang.dev/docs/api/macos/enoent
#Allow("naming.const")
const ENOENT: int64 = 2;

/// `EINTR`: the call was interrupted by a signal before it did anything.
///
/// https://rux-lang.dev/docs/api/macos/eintr
#Allow("naming.const")
const EINTR: int64 = 4;

/// `EIO`: a low-level input or output error.
///
/// https://rux-lang.dev/docs/api/macos/eio
#Allow("naming.const")
const EIO: int64 = 5;

/// `EBADF`: the file descriptor is not open, or is not open for what was asked.
///
/// https://rux-lang.dev/docs/api/macos/ebadf
#Allow("naming.const")
const EBADF: int64 = 9;

/// `ENOMEM`: not enough memory to satisfy the request.
///
/// https://rux-lang.dev/docs/api/macos/enomem
#Allow("naming.const")
const ENOMEM: int64 = 12;

/// `EACCES`: permission denied.
///
/// https://rux-lang.dev/docs/api/macos/eacces
#Allow("naming.const")
const EACCES: int64 = 13;

/// `EFAULT`: an address the call was given is outside the caller's address space.
///
/// https://rux-lang.dev/docs/api/macos/efault
#Allow("naming.const")
const EFAULT: int64 = 14;

/// `EEXIST`: the file already exists.
///
/// https://rux-lang.dev/docs/api/macos/eexist
#Allow("naming.const")
const EEXIST: int64 = 17;

/// `EXDEV`: the two paths are on different file systems.
///
/// https://rux-lang.dev/docs/api/macos/exdev
#Allow("naming.const")
const EXDEV: int64 = 18;

/// `ENOTDIR`: a path component that had to be a directory is not one.
///
/// https://rux-lang.dev/docs/api/macos/enotdir
#Allow("naming.const")
const ENOTDIR: int64 = 20;

/// `EISDIR`: the target is a directory and the operation is not one a directory accepts.
///
/// https://rux-lang.dev/docs/api/macos/eisdir
#Allow("naming.const")
const EISDIR: int64 = 21;

/// `EINVAL`: an argument is not valid.
///
/// https://rux-lang.dev/docs/api/macos/einval
#Allow("naming.const")
const EINVAL: int64 = 22;

/// `EMFILE`: this process has too many descriptors open.
///
/// https://rux-lang.dev/docs/api/macos/emfile
#Allow("naming.const")
const EMFILE: int64 = 24;

/// `ENOSPC`: the device has no room left.
///
/// https://rux-lang.dev/docs/api/macos/enospc
#Allow("naming.const")
const ENOSPC: int64 = 28;

/// `ESPIPE`: the descriptor is a pipe or socket and cannot be seeked.
///
/// https://rux-lang.dev/docs/api/macos/espipe
#Allow("naming.const")
const ESPIPE: int64 = 29;

/// `EROFS`: the file system is mounted read-only.
///
/// https://rux-lang.dev/docs/api/macos/erofs
#Allow("naming.const")
const EROFS: int64 = 30;

/// `EPIPE`: the reading end of the pipe is closed.
///
/// https://rux-lang.dev/docs/api/macos/epipe
#Allow("naming.const")
const EPIPE: int64 = 32;

/// `EAGAIN`: the operation would block, and the descriptor was set not to.
///
/// https://rux-lang.dev/docs/api/macos/eagain
#Allow("naming.const")
const EAGAIN: int64 = 35;

/// `ELOOP`: too many symbolic links were followed resolving the path.
///
/// https://rux-lang.dev/docs/api/macos/eloop
#Allow("naming.const")
const ELOOP: int64 = 62;

/// `ENAMETOOLONG`: the path or a component of it is too long.
///
/// https://rux-lang.dev/docs/api/macos/enametoolong
#Allow("naming.const")
const ENAMETOOLONG: int64 = 63;

/// `ENOSYS`: the system does not implement this call.
///
/// https://rux-lang.dev/docs/api/macos/enosys
#Allow("naming.const")
const ENOSYS: int64 = 78;

/// `EOVERFLOW`: a value is too large for the type the call reports it in.
///
/// https://rux-lang.dev/docs/api/macos/eoverflow
#Allow("naming.const")
const EOVERFLOW: int64 = 84;

/// `ETIMEDOUT`: the operation timed out.
///
/// https://rux-lang.dev/docs/api/macos/etimedout
#Allow("naming.const")
const ETIMEDOUT: int64 = 60;

/// The largest error number the normalized error range holds.
///
/// https://rux-lang.dev/docs/api/macos/maximum-errno
const MaximumErrno: int64 = 4095;

/// The calling thread's current `errno` value.
///
/// Takes nothing and returns the value by copy. Meaningful only immediately after a call that failed: nothing on
/// Darwin clears it on success, so a value left over from an earlier failure is still there.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/macos/current-errno
func CurrentErrno() -> int64 {
    return *__error() as int64;
}

/// Folds a libSystem result and the thread's `errno` into one value.
///
/// `result` is read by value. A result of `-1` becomes the negative of whatever `errno` holds; anything else is
/// returned unchanged. That is what makes every wrapper in this package report the way the Linux and FreeBSD ones
/// do, so a caller reads all three with `IsError` and `Errno`.
///
/// A call that legitimately returns `-1` would be misread, which is why nothing here wraps one.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/macos/normalize
func Normalize(result: int64) -> int64 {
    if result != -1 {
        return result;
    }
    let number = CurrentErrno();
    return number == 0 ? -1 : -number;
}

/// Whether a normalized result is one of the reserved error values.
///
/// `result` is read by value. True for `-4095` through `-1`.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/macos/is-error
func IsError(result: int64) -> bool {
    return result < 0 && result >= -MaximumErrno;
}

/// The error number a normalized result carries, or zero when it carries none.
///
/// `result` is read by value; the number is returned positive, as a man page names it.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/macos/errno
func Errno(result: int64) -> int64 {
    return IsError(result) ? -result : 0;
}
