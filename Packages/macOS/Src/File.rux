// Reading and writing through a file descriptor, and the three descriptors a process starts with.
//
// Each wrapper folds libSystem's `-1`-and-`errno` reporting into the one normalized value the Linux and FreeBSD
// packages already use, so a caller reads all three the same way. A short count is not an error and not an end of
// file -- only a zero-length read means the source has ended.
//
// The descriptor constants are annotated `int32` rather than `FileDescriptor`, because a `const` cannot name a type
// alias declared in another file of the package.

import macOS::{ FileDescriptor, FileMode, FileOffset, Normalize, __getdirentries64, close, dup2, fsync, ftruncate,
                chdir, fchmodat, fstat, fstatat, getcwd, linkat, lseek, mkdirat, openat, pipe, read, renameat, symlinkat,
                readlinkat, unlinkat, utimensat, write };

/// The descriptor a process reads its input from, unless something reassigned it.
///
/// https://rux-lang.dev/docs/api/macos/std-in
pub const StdIn: int32 = 0;

/// The descriptor a process writes its output to.
///
/// https://rux-lang.dev/docs/api/macos/std-out
pub const StdOut: int32 = 1;

/// The descriptor a process writes its diagnostics to.
///
/// https://rux-lang.dev/docs/api/macos/std-err
pub const StdErr: int32 = 2;

/// `AT_FDCWD`: resolve a relative path against the current directory rather than a descriptor.
///
/// Darwin spells this `-2`, where Linux and FreeBSD both use `-100`. Carrying the value between packages produces a
/// descriptor number, not an error.
///
/// https://rux-lang.dev/docs/api/macos/at-fd-cwd
pub const AtFdCwd: int32 = -2;

/// `O_RDONLY`: open for reading only.
///
/// https://rux-lang.dev/docs/api/macos/open-read-only
pub const OpenReadOnly: int32 = 0x0000;

/// `O_WRONLY`: open for writing only.
///
/// https://rux-lang.dev/docs/api/macos/open-write-only
pub const OpenWriteOnly: int32 = 0x0001;

/// `O_RDWR`: open for both reading and writing.
///
/// https://rux-lang.dev/docs/api/macos/open-read-write
pub const OpenReadWrite: int32 = 0x0002;

/// `O_CREAT`: create the file when it does not exist, which is when the mode argument is read.
///
/// https://rux-lang.dev/docs/api/macos/open-create
pub const OpenCreate: int32 = 0x0200;

/// `O_EXCL`: with `OpenCreate`, fail rather than open a file that already exists.
///
/// https://rux-lang.dev/docs/api/macos/open-exclusive
pub const OpenExclusive: int32 = 0x0800;

/// `O_TRUNC`: truncate the file to nothing when opening it for writing.
///
/// https://rux-lang.dev/docs/api/macos/open-truncate
pub const OpenTruncate: int32 = 0x0400;

/// `O_APPEND`: every write goes to the end.
///
/// https://rux-lang.dev/docs/api/macos/open-append
pub const OpenAppend: int32 = 0x0008;

/// `O_NONBLOCK`: reads and writes report `EAGAIN` rather than waiting.
///
/// https://rux-lang.dev/docs/api/macos/open-non-blocking
pub const OpenNonBlocking: int32 = 0x0004;

/// `O_CLOEXEC`: close this descriptor automatically when the process executes a new program.
///
/// https://rux-lang.dev/docs/api/macos/open-close-on-exec
pub const OpenCloseOnExec: int32 = 0x01000000;

/// `O_DIRECTORY`: fail unless the target is a directory.
///
/// https://rux-lang.dev/docs/api/macos/open-directory
pub const OpenDirectory: int32 = 0x00100000;

/// `SEEK_SET`: measure the new offset from the start of the file.
///
/// https://rux-lang.dev/docs/api/macos/seek-set
pub const SeekSet: int32 = 0;

/// `SEEK_CUR`: measure the new offset from the current one.
///
/// https://rux-lang.dev/docs/api/macos/seek-current
pub const SeekCurrent: int32 = 1;

/// `SEEK_END`: measure the new offset from the end of the file.
///
/// https://rux-lang.dev/docs/api/macos/seek-end
pub const SeekEnd: int32 = 2;

/// `AT_REMOVEDIR`: make `UnlinkAt` remove a directory rather than a file.
///
/// https://rux-lang.dev/docs/api/macos/remove-directory
pub const RemoveDirectory: int32 = 0x0080;

/// Reads up to `count` bytes from `fd` into `buffer`.
///
/// `buffer` is borrowed and written. Returns the number of bytes read, zero at end of file, or a negative error
/// number. A short count is ordinary.
///
/// # Safety
///
/// `buffer` must be writable for `count` bytes.
///
/// https://rux-lang.dev/docs/api/macos/read
pub func Read(fd: FileDescriptor, buffer: *var opaque, count: uint) -> int64 {
    return Normalize(read(fd, buffer, count));
}

/// Writes up to `count` bytes from `buffer` to `fd`.
///
/// `buffer` is borrowed and read. Returns the number of bytes written, or a negative error number. A short count is
/// ordinary and the rest has to be written by calling again.
///
/// # Safety
///
/// `buffer` must be readable for `count` bytes.
///
/// https://rux-lang.dev/docs/api/macos/write
pub func Write(fd: FileDescriptor, buffer: *opaque, count: uint) -> int64 {
    return Normalize(write(fd, buffer, count));
}

/// Closes `fd` and releases what the kernel held for it.
///
/// Returns zero, or a negative error number. A failure does not mean the descriptor is still open.
///
/// https://rux-lang.dev/docs/api/macos/close
pub func Close(fd: FileDescriptor) -> int64 {
    return Normalize(close(fd) as int64);
}

/// Opens `path` relative to `directoryFd` and returns a descriptor, or a negative error number.
///
/// `directoryFd` is `AtFdCwd` for an ordinary path. `mode` is read only when `OpenCreate` is set.
///
/// # Safety
///
/// `path` must be non-null and terminated. The mode is masked by the process umask.
///
/// https://rux-lang.dev/docs/api/macos/open-at
pub func OpenAt(directoryFd: FileDescriptor, path: *char8, flags: int32, mode: FileMode) -> int64 {
    return Normalize(openat(directoryFd, path, flags, mode as uint32) as int64);
}

/// Moves the file offset of `fd` and returns where it ended up, or a negative error number.
///
/// https://rux-lang.dev/docs/api/macos/lseek
pub func Lseek(fd: FileDescriptor, offset: FileOffset, whence: int32) -> int64 {
    return Normalize(lseek(fd, offset, whence));
}

/// Writes the current working directory's absolute path into `buffer`, NUL-terminated.
///
/// Returns zero, or a negative error number. `ERANGE` where the buffer is too small for the answer.
///
/// # Safety
///
/// `buffer` must be writable for `size` bytes.
///
/// https://rux-lang.dev/docs/api/macos/getcwd
pub func Getcwd(buffer: *var char8, size: uint) -> int64 {
    if getcwd(buffer, size) == null {
        return 0i64 - (*__error() as int64);
    }
    return 0;
}

/// Makes `path` the process's working directory.
///
/// Returns zero, or a negative error number. The change is process-wide and immediately visible to every thread.
///
/// https://rux-lang.dev/docs/api/macos/chdir
pub func Chdir(path: *char8) -> int64 {
    return Normalize(chdir(path) as int64);
}

/// Reads the text a symbolic link holds into `buffer`.
///
/// `directoryFd` is `AtFdCwd` for an ordinary path. Returns the number of bytes written, or a negative error
/// number. The text is **not** NUL-terminated, and is silently truncated where it does not fit.
///
/// https://rux-lang.dev/docs/api/macos/readlink-at
pub func ReadlinkAt(directoryFd: FileDescriptor, path: *char8, buffer: *var char8, size: uint) -> int64 {
    return Normalize(readlinkat(directoryFd, path, buffer, size));
}

/// `AT_SYMLINK_NOFOLLOW`: act on a symbolic link itself rather than on what it points at.
///
/// https://rux-lang.dev/docs/api/macos/symlink-no-follow
pub const SymlinkNoFollow: int32 = 0x0020;

/// Fills `statBuffer` with what the kernel knows about the file behind `fd`.
///
/// Returns zero, or a negative error number.
///
/// # Safety
///
/// `statBuffer` must be writable for the whole of the 64-bit-inode `struct stat`, which is 144 bytes.
///
/// https://rux-lang.dev/docs/api/macos/fstat
pub func Fstat(fd: FileDescriptor, statBuffer: *var opaque) -> int64 {
    return Normalize(fstat(fd, statBuffer) as int64);
}

/// Fills `statBuffer` with what the kernel knows about the file `path` names.
///
/// `directoryFd` is `AtFdCwd` for an ordinary path. `flags` is zero to follow a symbolic link at the end of the
/// path, or `SymlinkNoFollow` to describe the link itself. Returns zero, or a negative error number.
///
/// # Safety
///
/// `statBuffer` must be writable for the whole of the 64-bit-inode `struct stat`, which is 144 bytes and whose
/// layout this package does not model.
///
/// https://rux-lang.dev/docs/api/macos/fstat-at
pub func FstatAt(directoryFd: FileDescriptor, path: *char8, statBuffer: *var opaque, flags: int32) -> int64 {
    return Normalize(fstatat(directoryFd, path, statBuffer, flags) as int64);
}

/// Sets the permission bits of the file `path` names.
///
/// `directoryFd` is `AtFdCwd` for an ordinary path. `flags` may carry `SymlinkNoFollow`. Returns zero, or a
/// negative error number.
///
/// https://rux-lang.dev/docs/api/macos/fchmod-at
pub func FchmodAt(directoryFd: FileDescriptor, path: *char8, mode: FileMode, flags: int32) -> int64 {
    return Normalize(fchmodat(directoryFd, path, mode, flags) as int64);
}

/// Sets the access and modification times of the file `path` names.
///
/// `times` is borrowed and holds two `timespec` values -- access first, then modification -- each a whole-second
/// count and a nanosecond fraction, both 8 bytes. A null `times` sets both to now. `flags` may carry
/// `SymlinkNoFollow`. Returns zero, or a negative error number.
///
/// https://rux-lang.dev/docs/api/macos/utimens-at
pub func UtimensAt(directoryFd: FileDescriptor, path: *char8, times: *opaque, flags: int32) -> int64 {
    return Normalize(utimensat(directoryFd, path, times, flags) as int64);
}

/// Creates a hard link: `newPath` becomes a second name for the file `oldPath` names.
///
/// Returns zero, or a negative error number. `flags` is zero to leave a symbolic link at `oldPath` unfollowed,
/// or `FollowSymlinks` to link what it points at.
///
/// https://rux-lang.dev/docs/api/macos/linkat
pub func LinkAt(oldDirectoryFd: FileDescriptor, oldPath: *char8, newDirectoryFd: FileDescriptor, newPath: *char8,
            flags: int32) -> int64 {
    return Normalize(linkat(oldDirectoryFd, oldPath, newDirectoryFd, newPath, flags) as int64);
}

/// `AT_SYMLINK_FOLLOW`: make `LinkAt` link a symbolic link's target rather than the link.
///
/// https://rux-lang.dev/docs/api/macos/follow-symlinks
pub const FollowSymlinks: int32 = 0x0040;

/// Creates a symbolic link at `linkPath` holding `target` as its text.
///
/// Returns zero, or a negative error number. The target is stored, not checked: a dangling link is created as
/// readily as a good one, which is a property callers rely on.
///
/// https://rux-lang.dev/docs/api/macos/symlinkat
pub func SymlinkAt(target: *char8, newDirectoryFd: FileDescriptor, linkPath: *char8) -> int64 {
    return Normalize(symlinkat(target, newDirectoryFd, linkPath) as int64);
}

/// Reads directory entries from `fd` into `buffer`, and returns the bytes filled, zero at the end, or a negative
/// error number.
///
/// The buffer holds packed 64-bit-inode `dirent` records: the inode at offset 0 (8 bytes), a seek cookie at 8
/// (8 bytes), the record's length at 16 (2 bytes), the name's length at 18 (2 bytes), the entry type at 20
/// (1 byte), and the name from 21. The kernel writes as many whole records as fit.
///
/// https://rux-lang.dev/docs/api/macos/getdirentries64
pub func Getdirentries64(fd: FileDescriptor, buffer: *var opaque, count: uint, position: *var int64) -> int64 {
    return Normalize(__getdirentries64(fd, buffer, count, position));
}

/// Flushes everything written to `fd` toward the storage device.
///
/// Returns zero, or a negative error number.
///
/// # Safety
///
/// This is weaker on Darwin than everywhere else: it hands the data to the device without waiting for the device to
/// commit it, so a power failure can still lose a write this reported as flushed. `F_FULLFSYNC` through `fcntl` is
/// what actually waits, and this package does not wrap it.
///
/// https://rux-lang.dev/docs/api/macos/fsync
pub func Fsync(fd: FileDescriptor) -> int64 {
    return Normalize(fsync(fd) as int64);
}

/// Sets the length of the file behind `fd` to `length`.
///
/// Growing creates a hole rather than allocating, so a later write into it can still fail with `ENOSPC`.
///
/// https://rux-lang.dev/docs/api/macos/ftruncate
pub func Ftruncate(fd: FileDescriptor, length: FileOffset) -> int64 {
    return Normalize(ftruncate(fd, length) as int64);
}

/// Removes the name `path` from its directory.
///
/// `flags` is zero for a file or `RemoveDirectory` for an empty directory. Removing a name does not free the file.
///
/// # Safety
///
/// `path` must be non-null and terminated.
///
/// https://rux-lang.dev/docs/api/macos/unlink-at
pub func UnlinkAt(directoryFd: FileDescriptor, path: *char8, flags: int32) -> int64 {
    return Normalize(unlinkat(directoryFd, path, flags) as int64);
}

/// Creates a directory named `path` with permission bits `mode`.
///
/// Reports `EEXIST` when the name is taken.
///
/// # Safety
///
/// `path` must be non-null and terminated.
///
/// https://rux-lang.dev/docs/api/macos/mkdir-at
pub func MkdirAt(directoryFd: FileDescriptor, path: *char8, mode: FileMode) -> int64 {
    return Normalize(mkdirat(directoryFd, path, mode) as int64);
}

/// Renames `oldPath` to `newPath`, each resolved against its own directory descriptor.
///
/// Within one file system this replaces any existing `newPath` atomically. Across file systems it reports `EXDEV`.
///
/// # Safety
///
/// Both paths must be non-null and terminated.
///
/// https://rux-lang.dev/docs/api/macos/rename-at
pub func RenameAt(oldDirectoryFd: FileDescriptor, oldPath: *char8, newDirectoryFd: FileDescriptor,
              newPath: *char8) -> int64 {
    return Normalize(renameat(oldDirectoryFd, oldPath, newDirectoryFd, newPath) as int64);
}

/// Makes `newFd` a copy of `oldFd`, closing whatever `newFd` was.
///
/// Returns `newFd`, or a negative error number.
///
/// https://rux-lang.dev/docs/api/macos/dup2
pub func Dup2(oldFd: FileDescriptor, newFd: FileDescriptor) -> int64 {
    return Normalize(dup2(oldFd, newFd) as int64);
}

/// Creates a pipe and writes its two descriptors into `descriptors`.
///
/// The reading end lands at index zero and the writing end at index one. Darwin has no `pipe2`, so close-on-exec has
/// to be set afterwards through `fcntl` -- which leaves a window another thread can execute through.
///
/// # Safety
///
/// `descriptors` must be writable for two `int32` values.
///
/// https://rux-lang.dev/docs/api/macos/pipe
pub func Pipe(descriptors: *var int32) -> int64 {
    return Normalize(pipe(descriptors) as int64);
}
