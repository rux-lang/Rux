// The Darwin ABI's own types: what a libSystem call takes and gives back.
//
// These follow the LP64 data model every supported Apple target uses, so a `long` is 64 bits and the widths below do
// not vary by architecture.

/// A process identifier, as `getpid` reports one.
///
/// https://rux-lang.dev/docs/api/macos/process-id
pub type ProcessId = int32;

/// A file descriptor, as the kernel numbers one.
///
/// https://rux-lang.dev/docs/api/macos/file-descriptor
pub type FileDescriptor = int32;

/// A byte offset within a file, 64 bits on every supported Apple target.
///
/// https://rux-lang.dev/docs/api/macos/file-offset
pub type FileOffset = int64;

/// A file's type and permission bits.
///
/// https://rux-lang.dev/docs/api/macos/file-mode
pub type FileMode = uint16;

/// A duration or an instant, as seconds and nanoseconds.
///
/// https://rux-lang.dev/docs/api/macos/timespec
pub struct Timespec {
    /// Whole seconds.
    seconds: int64;
    /// Nanoseconds within the second, in `[0, 999999999]`.
    nanoseconds: int64;
}

/// A duration or an instant, as seconds and microseconds.
///
/// Darwin's x86-64 layout is an eight-byte `time_t` followed by a four-byte `suseconds_t`, and four bytes of trailing
/// padding. The padding is why this is not two 64-bit fields, and why writing it as though it were corrupts nothing
/// but reads back a microsecond count that is half stale.
///
/// https://rux-lang.dev/docs/api/macos/timeval
pub struct Timeval {
    /// Whole seconds.
    seconds: int64;
    /// Microseconds within the second, in `[0, 999999]`.
    microseconds: int32;
}
