// PCG64-DXSM, a generator with a 128-bit linear congruential state and a strong output function.
//
// The state advances by an ordinary multiply-and-add in 128 bits, which is trivially predictable on its own;
// everything that makes the output good happens in the output function, which folds the high half through two
// multiplications and finishes by multiplying by the low half. DXSM is the "double xorshift multiply" variant
// that replaced the original PCG64 output after the latter was shown to have a weakness at extreme sample
// sizes, and it is what NumPy adopted as its default.
//
// The period is 2^128 per stream, and the increment selects the stream: two generators with different odd
// increments walk different orbits of the same size, which is what makes independent parallel streams possible
// without any coordination between them.
//
// **Not suitable for anything that must resist an adversary.** The output function is not invertible in one
// step, but nothing here is designed against an attacker who is trying.

/// The multiplier used by both the state step and the output function.
///
/// PCG's "cheap" 64-bit multiplier, which the DXSM variant uses in the 128-bit step as well.
///
/// https://rux-lang.dev/docs/api/random/pcg-multiplier
const PcgMultiplier: uint64 = 0xDA942042E4DD58B5;

/// A PCG64-DXSM generator.
///
/// https://rux-lang.dev/docs/api/random/pcg64-dxsm
struct Pcg64Dxsm {
    /// The 128-bit linear congruential state.
    state: uint128;
    /// The stream selector, always odd.
    increment: uint128;
}

extend Pcg64Dxsm {
    /// A generator seeded by spreading `seed` through `SplitMix64`, on the default stream.
    ///
    /// https://rux-lang.dev/docs/api/random/pcg64-dxsm/new
    func Pcg64Dxsm(seed: uint64) -> Pcg64Dxsm {
        return Pcg64Dxsm::WithStream(seed, 0u64);
    }

    /// Temporary compatibility spelling for `Pcg64Dxsm(seed)`.
    func New(seed: uint64) -> Pcg64Dxsm {
        return Pcg64Dxsm(seed);
    }

    /// A generator on the stream `stream` selects.
    ///
    /// Two generators with the same seed and different streams produce unrelated sequences of the same period,
    /// which is how independent parallel streams are made without the workers having to agree on anything but
    /// their own index.
    ///
    /// https://rux-lang.dev/docs/api/random/pcg64-dxsm/with-stream
    func WithStream(seed: uint64, stream: uint64) -> Pcg64Dxsm {
        var mixer = SplitMix64(seed);
        let stateHigh = mixer.NextUint64() as uint128;
        let stateLow = mixer.NextUint64() as uint128;
        var streamMixer = SplitMix64(stream);
        let incrementHigh = streamMixer.NextUint64() as uint128;
        let incrementLow = streamMixer.NextUint64() as uint128;
        var generator = Pcg64Dxsm {
            state: 0u128,
            // The increment must be odd for the state to reach its full period, and forcing the low bit is the
            // standard way to say so: it halves the number of distinct streams and costs nothing else.
            increment: (((incrementHigh << 64u128) | incrementLow) << 1u128) | 1u128
        };
        // The published initialization: start at the increment, take one step, add the seed, take another.
        generator.state = generator.increment;
        generator.Step();
        generator.state = generator.state + ((stateHigh << 64u128) | stateLow);
        generator.Step();
        return generator;
    }

    // One state advance: the linear congruential step in 128 bits, wrapping as it must.
    func Step(self: &var Pcg64Dxsm) {
        self.state = self.state * (PcgMultiplier as uint128) + self.increment;
    }
}

extend Pcg64Dxsm : RandomGenerator {
    /// The next word.
    ///
    /// The output is computed from the state before it advances. The high half is folded twice and then
    /// multiplied by the low half forced odd -- an odd multiplier is invertible, so that last step permutes the
    /// value rather than collapsing any of it.
    ///
    /// https://rux-lang.dev/docs/api/random/pcg64-dxsm/next-uint64
    func NextUint64(self: &var Pcg64Dxsm) -> uint64 {
        var high = (self.state >> 64u128) as uint64;
        let low = ((self.state as uint64) | 1u64);
        high = high ^ (high >> 32u64);
        high = high * PcgMultiplier;
        high = high ^ (high >> 48u64);
        high = high * low;
        self.Step();
        return high;
    }
}
