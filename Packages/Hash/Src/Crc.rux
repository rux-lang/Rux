// CRC-32, the checksum that answers "did these bytes arrive intact?" — and its Castagnoli variant, which answers it
// better and is what modern formats and hardware use.
// A cyclic redundancy check is division: treat the message as a polynomial over GF(2), divide by a fixed generator,
// and keep the remainder. What that buys over a sum is a guarantee rather than a hope — a 32-bit CRC detects every
// burst error up to 32 bits long, every single-bit and double-bit error, and every error of odd weight, which no
// general-purpose hash promises about anything.
// Both forms here are the reflected, table-driven ones every implementation uses: bits enter least significant end
// first, the state starts at all ones, and the answer is the state complemented. Those three conventions are not
// arbitrary — the initial ones make leading zero bytes change the answer, and the final complement makes trailing
// ones do the same, so a message padded at either end is not mistaken for the message itself.
// The two differ only in the generator. CRC-32 uses the IEEE 802.3 polynomial that gzip, PNG and zip all use.
// CRC-32C uses Castagnoli's, which detects more of the double-bit errors that matter at the lengths storage systems
// care about, and which x86-64 and AArch64 both implement in hardware — iSCSI, ext4, Btrfs and SCTP all chose it.
// This implementation is the table, not the instruction: correct everywhere, and about a byte per cycle.
// A CRC is a checksum, not a hash and emphatically not a digest. It detects accident, never intent: given any
// message and any target value, producing a message with that CRC is arithmetic a beginner can do. It implements
// `Hasher` because feeding it bytes has the same shape, not because it is a substitute for one.
// https://datatracker.ietf.org/doc/html/rfc3385

import Hash::Hasher;

/// The reflected IEEE 802.3 generator polynomial, which is what gzip, PNG and zip mean by "CRC-32".
/// @see https://rux-lang.dev/docs/api/hash/crc32#crc32-polynomial
pub const Crc32Polynomial: uint32 = 0xEDB88320;

/// The reflected Castagnoli generator polynomial, which is what iSCSI, ext4, Btrfs and SCTP mean by "CRC-32C".
/// @see https://rux-lang.dev/docs/api/hash/crc32c#crc32c-polynomial
pub const Crc32cPolynomial: uint32 = 0x82F63B78;

/// The value a CRC register starts at, and the value the finished register is complemented against.
/// Both ends are all ones, which is what makes a message padded with zeroes at either end give a different answer
/// from the message itself.
/// @see https://rux-lang.dev/docs/api/hash/crc32#crc32-initial
pub const Crc32Initial: uint32 = 0xFFFFFFFF;

/// One byte of division by `Crc32Polynomial`, precomputed for every possible byte.
/// Entry `i` is `i` divided by the generator, so a whole byte of the message advances the register in one indexed
/// lookup and one shift rather than eight conditional shifts. The compiler computes the table from the polynomial.
/// @see https://rux-lang.dev/docs/api/hash/crc32#crc32-table
pub const Crc32Table: uint32[256] = DivisionTable(Crc32Polynomial);

/// One byte of division by `Crc32cPolynomial`, precomputed for every possible byte.
/// The compiler computes the table from the polynomial.
/// @see https://rux-lang.dev/docs/api/hash/crc32c#crc32c-table
pub const Crc32cTable: uint32[256] = DivisionTable(Crc32cPolynomial);

/// Every byte divided by the reflected generator `polynomial`: entry `i` is the register after `i` is shifted out of
/// it least significant bit first, the generator subtracted after each bit that was set.
/// Called only to compute the tables above, which is why it is private: the tables are the interface.
/// @param polynomial the reflected generator
/// @returns the 256 remainders, indexed by the byte they divide
func DivisionTable(polynomial: uint32) -> uint32[256] {
    var table: uint32[256] = [0u32; 256];
    var index: uint = 0;
    while index < 256 {
        var register = index as uint32;
        var step = 0;
        while step < 8 {
            register = if (register & 1) != 0 { (register >> 1) ^ polynomial } else { register >> 1 };
            step++;
        }
        table[index] = register;
        index++;
    }
    return table;
}

/// The CRC-32 of a message, computed a byte at a time.
/// Copy, and holding only the register, so passing one by value takes a snapshot of the checksum so far.
/// @see https://rux-lang.dev/docs/api/hash/crc32
pub struct Crc32 {
    /// The register, before the final complement. Starts at `Crc32Initial`.
    register: uint32;
}

extend Crc32 {
    /// Constructs a checksum with nothing written into it yet.
    /// @returns a hasher with nothing written to it yet
    /// @see https://rux-lang.dev/docs/api/hash/crc32#new
    pub func Crc32() -> Self {
        return Self { register: Crc32Initial };
    }

    /// Puts the checksum back to where `Crc32()` leaves one.
    /// `self` is borrowed mutably. Everything written so far is forgotten.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// @see https://rux-lang.dev/docs/api/hash/crc32#reset
    pub func Reset(&var self) {
        self.register = Crc32Initial;
    }

    /// The checksum of everything written so far.
    /// `self` is borrowed. This is the register complemented, which is the value every other implementation reports;
    /// the register itself stays as it was, so writing more continues rather than starting over.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// @returns the checksum of everything written so far
    /// @see https://rux-lang.dev/docs/api/hash/crc32#value
    pub func Value(&self) -> uint32 {
        return self.register ^ Crc32Initial;
    }
}

extend Crc32 : Hasher {
    /// Adds `length` bytes at `bytes` to the checksum.
    /// `bytes` is borrowed and read; `length` is read by value. A zero length changes nothing and is the one case in
    /// which `bytes` may be null. Splitting a message across several writes gives the same answer as one write.
    /// Runs in time proportional to `length` and allocates nothing.
    /// `bytes` must be readable for `length` bytes.
    /// @param bytes the bytes to absorb
    /// @param length how many bytes; zero absorbs nothing
    /// @see https://rux-lang.dev/docs/api/hash/crc32#write
    pub func Write(&var self, bytes: *byte, length: uint) {
        if length == 0 { return; }
        var index: uint = 0;
        while index < length {
            // Safety: `index` is below `length`, and the `Hasher` contract requires `bytes` to be readable for `length`
            // bytes.
            let slot = ((self.register ^ (unsafe { *(bytes + index) } as uint32)) & 0xFF) as uint;
            self.register = Crc32Table[slot] ^ (self.register >> 8);
            index++;
        }
    }

    /// The checksum of everything written so far, widened to 64 bits.
    /// `self` is borrowed. The upper 32 bits are always zero: a CRC-32 is 32 bits wide however it is reported, and
    /// `Value` is the call to make when that width is what is wanted.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// @returns the hash of everything written since the last reset
    /// @see https://rux-lang.dev/docs/api/hash/crc32#finish
    pub func Finish(&var self) -> uint64 {
        return self.Value() as uint64;
    }
}

/// The CRC-32C of a message, computed a byte at a time.
/// The variant to prefer for new work: it detects more of the double-bit errors that appear at storage-record
/// lengths, and it is the one both supported architectures implement in hardware. Choose `Crc32` only when an
/// existing format requires it.
/// Structural `Copy`; copying takes an independent snapshot of the register.
/// @see https://rux-lang.dev/docs/api/hash/crc32c
pub struct Crc32c {
    /// The register, before the final complement. Starts at `Crc32Initial`.
    register: uint32;
}

extend Crc32c {
    /// Constructs a checksum with nothing written into it yet.
    /// @returns a hasher with nothing written to it yet
    /// @see https://rux-lang.dev/docs/api/hash/crc32c#new
    pub func Crc32c() -> Self {
        return Self { register: Crc32Initial };
    }

    /// Puts the checksum back to where `Crc32c()` leaves one.
    /// `self` is borrowed mutably. Everything written so far is forgotten.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// @see https://rux-lang.dev/docs/api/hash/crc32c#reset
    pub func Reset(&var self) {
        self.register = Crc32Initial;
    }

    /// The checksum of everything written so far.
    /// `self` is borrowed. The register complemented, which is the value every other implementation reports.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// @returns the checksum of everything written so far
    /// @see https://rux-lang.dev/docs/api/hash/crc32c#value
    pub func Value(&self) -> uint32 {
        return self.register ^ Crc32Initial;
    }
}

extend Crc32c : Hasher {
    /// Adds `length` bytes at `bytes` to the checksum.
    /// `bytes` is borrowed and read; `length` is read by value. A zero length changes nothing and is the one case in
    /// which `bytes` may be null. Splitting a message across several writes gives the same answer as one write.
    /// Runs in time proportional to `length` and allocates nothing.
    /// `bytes` must be readable for `length` bytes.
    /// @param bytes the bytes to absorb
    /// @param length how many bytes; zero absorbs nothing
    /// @see https://rux-lang.dev/docs/api/hash/crc32c#write
    pub func Write(&var self, bytes: *byte, length: uint) {
        if length == 0 { return; }
        var index: uint = 0;
        while index < length {
            // Safety: `index` is below `length`, and the `Hasher` contract requires `bytes` to be readable for `length`
            // bytes.
            let slot = ((self.register ^ (unsafe { *(bytes + index) } as uint32)) & 0xFF) as uint;
            self.register = Crc32cTable[slot] ^ (self.register >> 8);
            index++;
        }
    }

    /// The checksum of everything written so far, widened to 64 bits.
    /// `self` is borrowed. The upper 32 bits are always zero.
    /// Cannot fail. Runs in constant time and allocates nothing.
    /// @returns the hash of everything written since the last reset
    /// @see https://rux-lang.dev/docs/api/hash/crc32c#finish
    pub func Finish(&var self) -> uint64 {
        return self.Value() as uint64;
    }
}

/// The CRC-32 of `length` bytes at `bytes`.
/// `bytes` is borrowed and read; `length` is read by value. A zero length gives zero, the CRC of the empty message,
/// and is the one case in which `bytes` may be null.
/// Cannot fail. Runs in time proportional to `length` and allocates nothing.
/// Safety: `bytes` must be readable for `length` bytes.
/// @param bytes the bytes to hash
/// @param length how many bytes
/// @returns their CRC-32 checksum
/// @see https://rux-lang.dev/docs/api/hash/crc32#crc32-of
pub unsafe func Crc32Of(bytes: *byte, length: uint) -> uint32 {
    var checksum = Crc32();
    checksum.Write(bytes, length);
    return checksum.Value();
}

/// The CRC-32C of `length` bytes at `bytes`.
/// `bytes` is borrowed and read; `length` is read by value. A zero length gives zero, and is the one case in which
/// `bytes` may be null.
/// Cannot fail. Runs in time proportional to `length` and allocates nothing.
/// Safety: `bytes` must be readable for `length` bytes.
/// @param bytes the bytes to hash
/// @param length how many bytes
/// @returns their CRC-32C checksum
/// @see https://rux-lang.dev/docs/api/hash/crc32c#crc32c-of
pub unsafe func Crc32cOf(bytes: *byte, length: uint) -> uint32 {
    var checksum = Crc32c();
    checksum.Write(bytes, length);
    return checksum.Value();
}
