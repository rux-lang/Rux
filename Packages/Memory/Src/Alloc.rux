import Core::{ #target, #Error };

when #target.os {
    .FreeBSD => import FreeBSD::{
        IsError, Mmap, MapAnonymous, MapPrivate, ProtectionRead, ProtectionWrite
    },
    .Linux => import Linux::{
        IsError, Mmap, MapAnonymous, MapPrivate, ProtectionRead, ProtectionWrite
    },
    .macOS => import macOS::{
        IsError, Mmap, MapAnonymous, MapPrivate, ProtectionRead, ProtectionWrite
    },
    .Windows => import Windows::{
        GetProcessHeap, HeapAlloc
    }
}

/// Allocates `size` uninitialized bytes.
///
/// Returns the base address, or null when the size overflows the platform bookkeeping or the system cannot satisfy
/// the request. A zero size is permitted, but the returned address is platform-dependent and must not be touched.
///
/// The allocation is owned by the caller until `Free` releases it or `Realloc` replaces it. The address is aligned
/// to at least 16 bytes on every supported target.
///
/// # Safety
///
/// The bytes are uninitialized. Reading any byte before writing it, accessing beyond `size`, or using the address
/// after it is released is invalid.
///
/// https://rux-lang.dev/docs/api/memory/alloc
pub func Alloc(size: uint) -> *var opaque {
    when #target.os {
        .FreeBSD, .Linux, .macOS => {
            // Two machine words keep the returned address aligned to 16 bytes.
            const HeaderSize: uint = 16;
            let total = size + HeaderSize;
            if total < size { return null; }
            let mapping = Mmap(null, total, ProtectionRead | ProtectionWrite,
                MapPrivate | MapAnonymous, -1, 0);
            if IsError(mapping) { return null; }
            let header = mapping as *var uint;
            *header = size;
            return (header + 2) as *var opaque;
        },
        .Windows => {
            let heap = GetProcessHeap();
            return HeapAlloc(heap, 0, size);
        },
        else => #Error("Unsupported operating system")
    }
}
