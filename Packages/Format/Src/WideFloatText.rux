// Rendering a wide float the way `float64` renders, at any width.
// The spelling is the narrow one exactly: `NaN`, `Inf`, a signed zero as `0.0`, fixed notation while the exponent
// stays within what the digits can fill and scientific past it, and `{:.N}` as that many digits after the point.
// A reader who knows what a `float64` looks like in text knows what these look like, which is the whole of the
// design.
// What differs is that the digits come from exact integer arithmetic rather than from a scaled double, so they
// are the shortest that read back as the same bits at every width — and that the arithmetic needs an allocator,
// because the numbers it works on are as large as the exponent makes them.

import Allocator::{ AllocError, AllocationFailed, Allocator, Layout };

import Text::{ Debug, Display, FormatError, FormatSpec, TextWriter, WriteAligned };

// Which formatting failure a digit generator's stop is. An allocator that refused terminates the program, as every
// allocation in the text packages does; a buffer too small for the digits is a value that cannot be written in the
// form asked for, which will go the same way every time.
func FailureOf(reason: WideDigitFailure) -> FormatError {
    if reason == WideDigitFailure::OutOfMemory { AllocationFailed(AllocError::OutOfMemory); }
    return FormatError::ValueOutOfRange;
}

/// Writes `bits`, read under `layout`, as text under `spec`.
/// @param allocator where the working storage comes from
/// @param writer the destination
/// @param spec what the placeholder asked for
/// @param bits the value's bit pattern
/// @param layout which wide floating-point format the bits are in
/// @returns success when the whole rendering was accepted
/// @see https://rux-lang.dev/docs/api/format/float-layout#write-wide-float
pub func WriteWideFloat(allocator: Allocator, writer: &var TextWriter, spec: FormatSpec, bits: uint512,
                    layout: &FloatLayout) -> ! FormatError {
    let value = UnpackWide(bits, layout);
    if value.class == WideClass::NaN { return WriteAligned(writer, spec, "NaN", true); }
    if value.class == WideClass::Infinity { return WriteAligned(writer, spec, if value.negative {
        "-Inf"
    } else {
        "Inf"
    }, true); }
    if spec.HasPrecision() { return WriteWidePrecision(allocator, writer, spec, value, layout); }
    var storage: char8[256];
    var digits: char8[160];
    var cursor = ByteCursor(storage[2..256]);
    if value.class == WideClass::Zero {
        if value.negative {
            cursor.Push(c8'-');
        }
        cursor.PushBytes("0.0");
    }
    else {
        var count: uint = 0;
        var exponent10: int = 0;
        let room = digits[..];
        var reason = WideDigitFailure::None;
        if !ShortestWideDigits(allocator, value, layout, room, @count, @exponent10, @reason) {
            fail FailureOf(reason);
        }
        if value.negative {
            cursor.Push(c8'-');
        }
        let produced = digits[..count];
        if exponent10 < -4 || exponent10 >= layout.DecimalDigits() as int {
            WriteScientific(cursor, produced, count, exponent10);
        }
        else {
            WriteFixed(cursor, produced, count, exponent10);
        }
    }
    var rendered = cursor.Written();
    if spec.ShowsSign() && rendered.length > 0 && rendered[0] != c8'-' {
        storage[1] = c8'+';
        rendered = storage[1..rendered.length + 2];
    }
    return WriteAligned(writer, spec, rendered, true);
}

// Fixed notation with exactly the requested precision in digits after the point. The text can be as long as the
// exponent is large, so it is built in storage from the allocator rather than on the stack.
func WriteWidePrecision(allocator: Allocator, writer: &var TextWriter, spec: FormatSpec, value: &UnpackedWide,
                        layout: &FloatLayout) -> ! FormatError {
    let fraction = spec.Precision();
    let integerRoom = ((layout.bias as uint) * 30103u) / 100000u + 4u;
    let digitRoom = integerRoom + fraction + 4u;
    let textRoom = digitRoom + fraction + 8u;
    let empty = Layout { size: 0, alignment: 1 };
    let blockLayout = Layout::New(digitRoom + textRoom, 1u) ?? (empty);
    if blockLayout.size == 0 { AllocationFailed(AllocError::Unsupported); }
    let block = try allocator.Allocate(blockLayout) catch { error => AllocationFailed(error) };
    // Safety: `block` came from `Allocate` above with `digitRoom + textRoom` bytes at alignment one, every bit
    // pattern is a valid `char8`, and the block stays live until the `Deallocate` at the end; the first `digitRoom`
    // bytes hold the digits.
    let digits = unsafe { (block as *var char8)[..digitRoom] };
    // Safety: the same live block; the `textRoom` bytes after the first `digitRoom` are the rest of it.
    let text = unsafe { ((block as *var char8) + digitRoom)[..textRoom] };
    var count: uint = 0;
    var exponent10: int = 0;
    // A block was allocated above and must be released on every path, so failure is accumulated and returned at
    // the end rather than propagated with `?`, which would leave the block behind.
    var failure: ! FormatError = .Success(());
    if value.class != WideClass::Zero {
        let room = digits;
        var reason = WideDigitFailure::None;
        if !FixedWideDigits(allocator, value, layout, fraction, room, @count, @exponent10, @reason) {
            failure = .Failure(FailureOf(reason));
        }
    }
    let succeeded = match failure {
        .Success(_) => true,
        .Failure(_) => false
    };
    if succeeded {
        var cursor = ByteCursor(text[1u..textRoom]);
        if value.negative && value.class != WideClass::Zero {
            cursor.Push(c8'-');
        }
        // The digits before the point, or a lone zero when there are none.
        if count == 0 || exponent10 < 0 {
            cursor.Push(c8'0');
        }
        else {
            var index: uint = 0;
            while index <= exponent10 as uint {
                cursor.Push(if index < count { digits[index] } else { c8'0' });
                index = index + 1u;
            }
        }
        if fraction > 0 {
            cursor.Push(c8'.');
            var place: uint = 0;
            while place < fraction {
                let position = exponent10 + 1 + place as int;
                if count == 0 || position < 0 || position >= count as int {
                    cursor.Push(c8'0');
                }
                else {
                    cursor.Push(digits[position as uint]);
                }
                place = place + 1u;
            }
        }
        var rendered = cursor.Written();
        if spec.ShowsSign() && rendered.length > 0 && rendered[0] != c8'-' {
            text[0] = c8'+';
            rendered = text[..rendered.length + 1u];
        }
        if cursor.Overran() {
            failure = .Failure(FormatError::ValueOutOfRange);
        }
        else {
            failure = WriteAligned(writer, spec, rendered, true);
        }
    }
    allocator.Deallocate(block, blockLayout) catch { _ => {} };
    return failure;
}
