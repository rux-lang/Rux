// A `bool32` is the word `true` or the word `false`.
//
// Lower case, unquoted, and the same for `Debug`: there is no second way to read a boolean.

import Text::TextError;

extend bool32 : Display {
    /// Writes `true` or `false`.
    ///
    /// https://rux-lang.dev/docs/api/format/bool32/format
    func Format(self: *bool32, writer: Writer, spec: FormatSpec) -> TextError {
        return WriteAligned(writer, spec, *self ? "true" : "false", false);
    }
}

extend bool32 : Debug {
    /// The same two words.
    ///
    /// https://rux-lang.dev/docs/api/format/bool32/format-debug
    func FormatDebug(self: *bool32, writer: Writer, spec: FormatSpec) -> TextError {
        return self.Format(writer, spec);
    }
}
