// The decimal text of a `uint`.

// `uint` is a type of its own rather than a name for `uint64`, as `int` is for `int64`.

import Text::{ Debug, Display, FormatError, FormatSpec, TextWriter };

extend uint : Display {
    /// Writes this value's digits.
    /// Allocates nothing: the digits go into a buffer on the stack and reach the writer in one call.
    /// Reports whatever the writer reported, stopping at the first refusal.
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/integer-text#uint-write-display
    pub func WriteDisplay(&self, writer: &var TextWriter, spec: FormatSpec) throws FormatError {
        return try WriteIntegerSpec(writer, spec, self as uint64, false);
    }
}

extend uint : Debug {
    /// The same digits.
    /// Reports whatever the writer reported, stopping at the first refusal.
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/integer-text#uint-write-debug
    pub func WriteDebug(&self, writer: &var TextWriter, spec: FormatSpec) throws FormatError {
        return try self.WriteDisplay(writer, spec);
    }
}
