import Core::Slice;
import Text::TextError;

// The largest finite float32, held here as the float64 it widens to exactly.
const MaxFinite32 = 3.4028234663852886e38;

// How many significant digits a float32 is printed to. A float32 widens to a
// float64 exactly, but what it widens to is the full binary value -- 0.1f is
// 0.100000001490116119384765625 -- so printing it to the fifteen digits a
// float64 earns would print noise the float32 never carried. Seven is what
// it does carry, and it renders 0.1f as 0.1.
const Digits32 = 7u;

// Whether the value is a NaN, on the same terms as the float64 overload: a
// NaN is the only value not equal to itself.
func IsNan(value: float32) -> bool {
    return value != value;
}

// Whether the value is one of the two infinities.
func IsInfinite(value: float32) -> bool {
    return value as float64 > MaxFinite32 || (value as float64) < -MaxFinite32;
}

// Whether the value is an ordinary number: neither a NaN nor an infinity.
func IsFinite(value: float32) -> bool {
    return value as float64 >= -MaxFinite32 && value as float64 <= MaxFinite32;
}

extend float32 : Display {
    /// Writes this value's decimal text.
    ///
    /// Allocates nothing: the digits go into a buffer on the stack and reach the writer in one call. Fifty bytes is
    /// more than the longest rendering -- sign, digits, point and exponent -- can need.
    ///
    /// https://rux-lang.dev/docs/api/format/float32/format
    func Format(self: *float32, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        var storage: char8[52];
        var cursor = ByteCursor(MutableSlice::From<char8>(@storage[2], 50));
        // Precision means digits after the point, honoured where the arithmetic can honour it: a value too large
        // to scale into a word renders shortest instead of pretending.
        if spec.hasPrecision && FitsPrecision(*self as float64, spec.precision) {
            WriteFixedPrecision(cursor, *self as float64, spec.precision);
        }
        else {
            WriteFloat(cursor, *self);
        }
        var rendered = cursor.Written();
        // A requested sign goes in front of a value that has none of its own; a NaN carries no sign to show.
        if spec.showSign && rendered.length > 0 && rendered.data[0] != c8'-' && rendered.data[0] != c8'N' {
            storage[1] = c8'+';
            rendered = Slice<char8> { data: @storage[1], length: rendered.length + 1 };
        }
        return WriteAligned(writer, spec, rendered, true);
    }
}

extend float32 : Debug {
    /// The same text.
    ///
    /// https://rux-lang.dev/docs/api/format/float32/format-debug
    func FormatDebug(self: *float32, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return self.Format(writer, spec);
    }
}

// Appends the text of a float32 to a builder. The conversion runs in float64,
// which the value reaches exactly, and only the digit count says which type
// it came from.
func WriteFloat(cursor: &var ByteCursor, value: float32) {
    if IsNan(value) {
        cursor.PushBytes("NaN");
        return;
    }
    if IsInfinite(value) {
        if value < 0.0 {
            cursor.PushBytes("-Inf");
        } else {
            cursor.PushBytes("Inf");
        }
        return;
    }
    if value == 0.0 {
        if 1.0 / (value as float64) < 0.0 {
            cursor.Push(c8'-');
        }
        cursor.PushBytes("0.0");
        return;
    }
    WriteDecimal(cursor, value as float64, Digits32);
}
