// The text of a `float32`.
//
// The shortest decimal that reads back as the same value, which is what a reader almost always wants: 0.1 prints as
// "0.1" rather than as the seventeen digits its binary value really is. A precision in the placeholder asks for
// fixed notation instead, and is honoured exactly when the value has that many digits to give.


import Core::{ Result, Unit };
import Text::{ Debug, Display, FormatError, FormatSpec, RejectStyle, TextWriter };

// The largest finite float32, held here as the float64 it widens to exactly.
const MaxFinite32 = 3.4028234663852886e38;

// The decimal exponent at or above which a float32 renders in scientific notation. Nine is the digit count at
// which every float32 is distinguishable from every other, so a value needing that many places in fixed
// notation is one whose fixed form is all trailing zeros.
const ScientificFrom32 = 9;

// Whether the value is a NaN, on the same terms as the float64 overload: a
// NaN is the only value not equal to itself.
/// Provides the public `IsNan` operation.
///
/// @param value the value to act on
/// @returns whether the value is a NaN
/// @see https://rux-lang.dev/docs/api/format/is-nan
pub func IsNan(value: float32) -> bool {
    return value != value;
}

// Whether the value is one of the two infinities.
/// Provides the public `IsInfinite` operation.
///
/// @param value the value to act on
/// @returns whether the value is either infinity
/// @see https://rux-lang.dev/docs/api/format/is-infinite
pub func IsInfinite(value: float32) -> bool {
    return value as float64 > MaxFinite32 || (value as float64) < -MaxFinite32;
}

// Whether the value is an ordinary number: neither a NaN nor an infinity.
/// Provides the public `IsFinite` operation.
///
/// @param value the value to act on
/// @returns whether the value is neither infinite nor a NaN
/// @see https://rux-lang.dev/docs/api/format/is-finite
pub func IsFinite(value: float32) -> bool {
    return value as float64 >= -MaxFinite32 && value as float64 <= MaxFinite32;
}

extend float32 : Display {
    /// Writes this value's decimal text.
    ///
    /// Allocates nothing: the digits go into a buffer on the stack and reach the writer in one call. Fifty bytes is
    /// more than the longest rendering — sign, digits, point and exponent — can need.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/float32/write-display
    pub func WriteDisplay(self: *float32, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        RejectStyle(spec)?;
        // Two bytes of head room in front, so that a requested sign can be put where the rendering starts
        // without moving it.
        var storage: char8[52];
        var cursor = ByteCursor((@storage[2])[..50]);
        // Precision means digits after the decimal point, exactly, with ties to even. A request past the
        // supported bound is refused rather than clamped or answered with a different rendering: falling back
        // would answer a question nobody asked, and quietly.
        if spec.HasPrecision() {
            return WritePrecision(writer, spec, DecomposeFloat32(*self));
        }
        WriteFloat(cursor, *self);
        var rendered = cursor.Written();
        // A requested sign goes in front of a value that has none of its own; a NaN carries no sign to show.
        if spec.ShowsSign() && rendered.length > 0 && rendered.data[0] != c8'-' && rendered.data[0] != c8'N' {
            storage[1] = c8'+';
            rendered = (@storage[1])[..rendered.length + 1];
        }
        return WriteAligned(writer, spec, rendered, true);
    }
}

extend float32 : Debug {
    /// The same text.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/float32/write-debug
    pub func WriteDebug(self: *float32, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        return self.WriteDisplay(writer, spec);
    }
}

// Appends the text of a float32 to a builder. The conversion runs in float64,
// which the value reaches exactly, and only the digit count says which type
// it came from.
func WriteFloat(cursor: &var ByteCursor, value: float32) {
    if IsNan(value) {
        cursor.PushBytes("NaN");
        return;
    }
    if IsInfinite(value) {
        if value < 0.0 {
            cursor.PushBytes("-Inf");
        } else {
            cursor.PushBytes("Inf");
        }
        return;
    }
    // The exact shortest form, at this width's own neighbours: converting to float64 first and rendering that
    // would give the shortest decimal for the wider value, which is a different and longer number.
    let parts = DecomposeFloat32(value);
    if !WriteShortestFloat(cursor, parts, ScientificFrom32) {
        WriteDecimal(cursor, value as float64, 9u);
    }
}
