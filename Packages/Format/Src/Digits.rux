// The digit loop, written once.
//
// Every signed integer widens to `int64` on the way in and every unsigned one to `uint64`, neither of which loses
// anything, so there is one loop rather than one per width.
//
// The digits go into a cursor over a stack buffer rather than into anything that allocates: a `uint64` is at most
// twenty digits, which is known before the loop starts, so there is nothing to grow and nothing that can fail.

/// The most digits a `uint64` ever needs, for 18446744073709551615.
///
/// https://rux-lang.dev/docs/api/format/max-decimal-digits
pub const MaxDecimalDigits: uint = 20;

/// Writes the decimal digits of an unsigned value.
///
/// A division loop produces them least significant first, so they land in a small buffer and go back reversed.
///
/// https://rux-lang.dev/docs/api/format/write-uint
pub func WriteUint(cursor: &var ByteCursor, value: uint64) {
    if value == 0u64 {
        cursor.Push(c8'0');
        return;
    }

    var digits: char8[20];
    var length: uint = 0;
    var rest = value;
    while rest > 0u64 {
        digits[length] = (rest % 10u64 + 48u64) as char8;
        length++;
        rest /= 10u64;
    }

    var index = length;
    while index > 0 {
        index--;
        cursor.Push(digits[index]);
    }
}

/// Writes the sign, then the magnitude.
///
/// The magnitude is taken in `uint64` rather than by negating within `int64`, because the most negative `int64` has
/// no positive counterpart there: negating it overflows straight back to itself. Two's complement gives the right
/// answer for that value and for every other one.
///
/// https://rux-lang.dev/docs/api/format/write-int
pub func WriteInt(cursor: &var ByteCursor, value: int64) {
    if value < 0i64 {
        cursor.Push(c8'-');
        WriteUint(cursor, ~(value as uint64) + 1u64);
        return;
    }
    WriteUint(cursor, value as uint64);
}
