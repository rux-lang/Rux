// A `char8` is one byte of UTF-8, which is not the same thing as one character.
//
// A byte below 0x80 is a whole character and is written as it stands. A byte above that is one piece of a character
// spread over several, and a writer takes whole characters -- so what is written for one is the replacement
// character, U+FFFD, which is what "there was something here and it could not be represented" looks like in text.
// Writing the byte on its own would produce something that is not UTF-8, and the promise that it is holds every
// reader of the result together.

import Core::Slice;
import Text::TextError;

/// The character written in place of anything that is not one.
///
/// https://rux-lang.dev/docs/api/format/replacement-character
pub const ReplacementCharacter: char32 = 0xFFFDu32 as char32;

extend char8 : Display {
    /// Writes this byte, or the replacement character when it is not a whole one.
    ///
    /// https://rux-lang.dev/docs/api/format/char8/format
    pub func Format(self: *char8, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        if (*self as uint32) > 0x7F { return FormatScalar(writer, spec, ReplacementCharacter); }
        var one: char8[1];
        one[0] = *self;
        return WriteAligned(writer, spec, Slice<char8> { data: @one[0], length: 1 }, false);
    }
}

extend char8 : Debug {
    /// The same byte, quoted, as a character literal is written.
    ///
    /// https://rux-lang.dev/docs/api/format/char8/format-debug
    pub func FormatDebug(self: *char8, writer: &var TextWriter) -> TextError {
        let opening = WriteAscii(writer, c8'\'');
        if opening.IsError() { return opening; }
        let body = self.Format(writer, FormatSpec::Plain());
        if body.IsError() { return body; }
        return WriteAscii(writer, c8'\'');
    }
}

extend Slice<char8> : Display {
    /// Writes these bytes.
    ///
    /// # Safety
    ///
    /// The bytes must be well-formed UTF-8; a slice is not checked, which is what `StringView` is for.
    ///
    /// https://rux-lang.dev/docs/api/format/slice-char8/format
    pub func Format(self: Slice<char8>, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return WriteAligned(writer, spec, self, false);
    }
}
