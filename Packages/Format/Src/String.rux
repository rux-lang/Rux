// Text rendering itself is the text it already is.
//
// A `String` and a `StringView` write their bytes straight through, with no conversion: they are UTF-8 by
// construction, which is exactly what a writer takes. Nothing is copied and nothing is allocated, which is the
// difference from the old shape, where rendering a string produced a second string.
//
// `Debug` is where the two part company. A string shown to a reader is its characters; a string shown to somebody
// looking at a program is quoted, so that where it starts and stops is visible and an empty one is not invisible.

import Core::Slice;
import Text::{ DecodeAt, String, StringView, TextError };

extend String : Display {
    /// Writes this string's bytes.
    ///
    /// https://rux-lang.dev/docs/api/format/string/format
    pub func Format(self: &String, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        let view = self.View();
        return view.Format(writer, spec);
    }
}

extend String : Debug {
    /// Writes this string quoted.
    ///
    /// https://rux-lang.dev/docs/api/format/string/format-debug
    pub func FormatDebug(self: &String, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        let view = self.View();
        return view.FormatDebug(writer, spec);
    }
}

extend StringView : Display {
    /// Writes what this view spans.
    ///
    /// https://rux-lang.dev/docs/api/format/string-view/format
    pub func Format(self: &StringView, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return WriteAligned(writer, spec, Truncated(self, spec), false);
    }
}

extend StringView : Debug {
    /// Writes what this view spans, quoted.
    ///
    /// The quotes are all that is added, and they sit outside the precision: what is kept is text, and the quotes
    /// say where it stops. Escaping the characters between them is a question about which of them need it, which
    /// is a Unicode question and belongs where the Unicode tables are.
    ///
    /// https://rux-lang.dev/docs/api/format/string-view/format-debug
    pub func FormatDebug(self: &StringView, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        let opening = WriteAscii(writer, c8'"');
        if opening.IsError() {
            return opening;
        }
        let body = WriteBytes(writer, Truncated(self, spec));
        if body.IsError() {
            return body;
        }
        return WriteAscii(writer, c8'"');
    }
}

// The front of `view` holding at most the spec's precision in characters, or all of it. A cut lands on a character
// boundary by construction: it walks whole characters and stops.
func Truncated(view: &StringView, spec: FormatSpec) -> Slice<char8> {
    let bytes = view.Bytes();
    if !spec.hasPrecision {
        return bytes;
    }
    var kept: uint = 0;
    var index: uint = 0;
    while index < bytes.length && kept < spec.precision {
        var scalar = 0u32 as char32;
        var width: uint = 0;
        if DecodeAt(bytes, index, @scalar, @width).IsError() {
            return Slice<char8> { data: bytes.data, length: index };
        }
        index = index + width;
        kept = kept + 1;
    }
    return Slice<char8> { data: bytes.data, length: index };
}
