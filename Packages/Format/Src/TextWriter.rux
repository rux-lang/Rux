import Core::string;
// Where formatted text goes.
//
// Formatting used to answer with a `String`, which meant every value rendered allocated a block, had its bytes
// copied somewhere else, and released the block again. Printing a line of six values allocated six times to produce
// text that went straight to a file descriptor.
//
// A writer is the other way round: a value writes its bytes into whatever the caller supplies, and what that is --
// a builder, a file, a fixed buffer -- is the caller's business. Rendering a value into a string is then one
// particular writer rather than the only shape available, and printing one allocates nothing at all.
//
// What is written must be well-formed UTF-8, and must not stop part-way through a character. Every writer here
// relies on that; a builder's promise that it holds text at every moment is exactly this promise passed along.

import Core::{ MutableSlice, Slice };
import Text::{ Encode, StringBuilder, TextError };

/// Somewhere formatted text can be written.
///
/// Implementations hold their state behind a pointer, as an allocator does, because an interface value is copied
/// when it is passed and a writer that lost its position each time would write everything at the start.
///
/// https://rux-lang.dev/docs/api/format/writer
pub interface TextWriter {
    /// Writes `bytes`, reporting what stopped it.
    ///
    /// The bytes must be well-formed UTF-8 and must not end part-way through a character.
    func Write(bytes: Slice<char8>) -> TextError;
}

/// Writes `bytes` to `writer`.
///
/// The writer is borrowed mutably for the call, so position changes remain visible to its owner.
///
/// https://rux-lang.dev/docs/api/format/write-bytes
pub func WriteBytes(writer: &var TextWriter, bytes: Slice<char8>) -> TextError {
    return writer.Write(bytes);
}

/// Provides the public `WriteBytes` operation.
///
/// https://rux-lang.dev/docs/api/format/write-bytes
pub func WriteBytes(writer: &var TextWriter, text: string) -> TextError {
    return WriteBytes(writer, Slice<char8> { data: text.data, length: text.length });
}

/// Writes one ASCII byte.
///
/// Reports `InvalidUtf8` for a byte above 0x7F: a single byte above that is never a whole character, and a writer
/// takes whole characters. `WriteScalar` is what writes one that takes more than a byte.
///
/// https://rux-lang.dev/docs/api/format/write-ascii
pub func WriteAscii(writer: &var TextWriter, byte: char8) -> TextError {
    if (byte as uint32) > 0x7F { return TextError::InvalidUtf8; }
    var one: char8[1];
    one[0] = byte;
    return WriteBytes(writer, Slice<char8> { data: @one[0], length: 1 });
}

/// Writes one character, encoded as UTF-8.
///
/// Reports `InvalidUtf8` for a value that is not a scalar value.
///
/// https://rux-lang.dev/docs/api/format/write-scalar
pub func WriteScalar(writer: &var TextWriter, scalar: char32) -> TextError {
    var encoded: char8[4];
    var written: uint = 0;
    let sink = MutableSlice::From<char8>(@encoded[0], 4);
    if Encode(scalar, sink, @written).IsError() { return TextError::InvalidUtf8; }
    return WriteBytes(writer, Slice<char8> { data: @encoded[0], length: written });
}

extend StringBuilder : TextWriter {
    /// Appends `bytes` to the builder.
    ///
    /// Reports `OutOfMemory` when the builder cannot make room, having appended nothing.
    ///
    /// https://rux-lang.dev/docs/api/text/string-builder/write
    pub func Write(self: &var StringBuilder, bytes: Slice<char8>) -> TextError {
        return self.AppendValidated(bytes);
    }
}

extend ByteCursor : TextWriter {
    /// Writes `bytes` into the buffer, reporting `LengthOverflow` when they do not fit.
    ///
    /// https://rux-lang.dev/docs/api/format/byte-cursor/write
    pub func Write(self: &var ByteCursor, bytes: Slice<char8>) -> TextError {
        self.PushBytes(bytes);
        return self.Overran() ? TextError::LengthOverflow : TextError::None;
    }
}
