// A `char32` holds one Unicode scalar value, which is one to four bytes of UTF-8.
//
// A `char32` is checked when it is made, so a value that is not a scalar value cannot ordinarily be in one. It is
// still checked here, because a cast can produce one and the writer's promise is worth more than the check costs.

import Text::{ IsScalarValue, TextError };

extend char32 : Display {
    /// Writes this character, or the replacement character when the value is not one.
    ///
    /// https://rux-lang.dev/docs/api/format/char32/format
    func Format(self: *char32, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        let value = *self as uint32;
        if !IsScalarValue(value) {
            return FormatScalar(writer, spec, ReplacementCharacter);
        }
        return FormatScalar(writer, spec, value as char32);
    }
}

extend char32 : Debug {
    /// The same character, quoted.
    ///
    /// https://rux-lang.dev/docs/api/format/char32/format-debug
    func FormatDebug(self: *char32, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        let opening = WriteAscii(writer, c8'\'');
        if opening.IsError() {
            return opening;
        }
        let body = self.Format(writer, FormatSpec::Plain());
        if body.IsError() {
            return body;
        }
        return WriteAscii(writer, c8'\'');
    }
}
