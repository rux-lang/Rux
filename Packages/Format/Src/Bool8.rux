// A `bool8` is the word `true` or the word `false`.
//
// Lower case, unquoted, and the same for `Debug`: there is no second way to read a boolean.

import Core::{ Result, Unit };
import Text::{ Debug, Display, FormatError, FormatSpec, RejectStyle, TextWriter };

extend bool8 : Display {
    /// Writes `true` or `false`.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/bool8/write-display
    pub func WriteDisplay(self: &bool8, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        RejectStyle(spec)?;
        return WriteAligned(writer, spec, self ? "true" : "false", false);
    }
}

extend bool8 : Debug {
    /// The same two words.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/bool8/write-debug
    pub func WriteDebug(self: &bool8, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        return self.WriteDisplay(writer, spec);
    }
}
