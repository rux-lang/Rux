// A `bool8` is the word `true` or the word `false`.
//
// Lower case, unquoted, and the same for `Debug`: there is no second way to read a boolean.

import Text::TextError;

extend bool8 : Display {
    /// Writes `true` or `false`.
    ///
    /// https://rux-lang.dev/docs/api/format/bool8/format
    pub func Format(self: *bool8, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return WriteAligned(writer, spec, *self ? s8"true" : s8"false", false);
    }
}

extend bool8 : Debug {
    /// The same two words.
    ///
    /// https://rux-lang.dev/docs/api/format/bool8/format-debug
    pub func FormatDebug(self: *bool8, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return self.Format(writer, spec);
    }
}
