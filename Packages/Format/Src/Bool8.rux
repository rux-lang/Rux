// A `bool8` is the word `true` or the word `false`.
// Lower case, unquoted, and the same for `Debug`: there is no second way to read a boolean.

import Text::{ Debug, Display, FormatError, FormatSpec, RejectStyle, TextWriter, WriteAligned };

extend bool8 : Display {
    /// Writes `true` or `false`.
    /// Reports whatever the writer reported, stopping at the first refusal.
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/character-text#bool8-write-display
    pub func WriteDisplay(&self, writer: &var TextWriter, spec: FormatSpec) throws FormatError {
        try RejectStyle(spec);
        return try WriteAligned(writer, spec, if self { "true" } else { "false" }, false);
    }
}

extend bool8 : Debug {
    /// The same two words.
    /// Reports whatever the writer reported, stopping at the first refusal.
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/character-text#bool8-write-debug
    pub func WriteDebug(&self, writer: &var TextWriter, spec: FormatSpec) throws FormatError {
        return try self.WriteDisplay(writer, spec);
    }
}
