// The decimal text of a `uint8`.

import Text::TextError;

extend uint8 : Display {
    /// Writes this value's digits.
    ///
    /// Allocates nothing: the digits go into a buffer on the stack and reach the writer in one call.
    ///
    /// https://rux-lang.dev/docs/api/format/uint8/format
    func Format(self: *uint8, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return WriteIntegerSpec(writer, spec, *self as uint64, false);
    }
}

extend uint8 : Debug {
    /// The same digits.
    ///
    /// https://rux-lang.dev/docs/api/format/uint8/format-debug
    func FormatDebug(self: *uint8, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return self.Format(writer, spec);
    }
}
