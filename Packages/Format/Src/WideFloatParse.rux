import Core::string;
// Reading decimal text into a wide float, exactly.
//
// The grammar is the one `ParseFloat64` accepts, so what one width reads the others read. The conversion is not
// the narrow one: every digit of the input is kept as an integer, the value is formed as a ratio of two integers
// -- the digits against a power of ten -- and the quotient is taken to three bits past the precision with a
// sticky bit for whatever remains. That is enough to round to nearest with ties to even without ever being wrong,
// at any width, for any length of input.

import Allocator::Allocator;
import Core::{ Result, Slice };

/// Reads `str` as a value under `layout`, rounding to nearest with ties to even, and reports the bits.
///
/// Overflow is refused rather than rounded to infinity, as `ParseFloat64` refuses it; a value too small for the
/// format becomes the signed zero. `NaN`, `Inf` and `-Inf` are read exactly as formatting writes them.
///
/// https://rux-lang.dev/docs/api/format/parse-wide-float
pub func ParseWideFloat(allocator: Allocator, str: Slice<char8>, layout: &FloatLayout) -> Result<uint512, ParseError> {
    if str.length == 0u { return Result::Error<uint512, ParseError>(ParseError::Empty); }
    var index: uint = 0;
    var negative = false;
    if str[index] == c8'+' || str[index] == c8'-' {
        negative = str[index] == c8'-';
        index = index + 1u;
        if index == str.length { return Result::Error<uint512, ParseError>(ParseError::InvalidCharacter(index - 1u)); }
    }
    if index + 3u == str.length && str[index] == c8'N' && str[index + 1u] == c8'a' && str[index + 2u] == c8'N' {
        return Result::Success<uint512, ParseError>(NanBits(layout));
    }
    if index + 3u == str.length && str[index] == c8'I' && str[index + 1u] == c8'n' && str[index + 2u] == c8'f' {
        return Result::Success<uint512, ParseError>(InfinityBits(negative, layout));
    }

    var digits = BigNat(allocator);
    var significant: uint = 0;
    var decimalExponent: int = 0;
    var digitCount: uint = 0;
    var afterPoint = false;
    while index < str.length {
        let ch = str[index];
        if ch >= c8'0' && ch <= c8'9' {
            let digit = ((ch as uint) - (c8'0' as uint)) as uint64;
            digitCount = digitCount + 1u;
            if afterPoint {
                decimalExponent = decimalExponent - 1;
            }
            if digit != 0u64 || significant > 0u {
                if !digits.MultiplySmall(10u64) || !digits.AddSmall(digit) {
                    return Result::Error<uint512, ParseError>(ParseError::Overflow);
                }
                significant = significant + 1u;
            }
            index = index + 1u;
            continue;
        }
        if ch == c8'.' && !afterPoint {
            afterPoint = true;
            index = index + 1u;
            continue;
        }
        break;
    }
    if digitCount == 0u { return Result::Error<uint512, ParseError>(ParseError::InvalidCharacter(index)); }
    if index < str.length && (str[index] == c8'e' || str[index] == c8'E') {
        let marker = index;
        index = index + 1u;
        var exponentNegative = false;
        if index < str.length && (str[index] == c8'+' || str[index] == c8'-') {
            exponentNegative = str[index] == c8'-';
            index = index + 1u;
        }
        if index == str.length || str[index] < c8'0' || str[index] > c8'9' {
            return Result::Error<uint512, ParseError>(ParseError::InvalidCharacter(marker));
        }
        var exponent: int = 0;
        while index < str.length && str[index] >= c8'0' && str[index] <= c8'9' {
            let digit = ((str[index] as uint) - (c8'0' as uint)) as int;
            // Past a hundred million the value is out of every range there is; stopping the count keeps the
            // arithmetic below in bounds without changing the answer.
            if exponent < 100000000 {
                exponent = exponent * 10 + digit;
            }
            index = index + 1u;
        }
        decimalExponent = exponentNegative ? decimalExponent - exponent : decimalExponent + exponent;
    }
    if index != str.length { return Result::Error<uint512, ParseError>(ParseError::InvalidCharacter(index)); }
    if digits.IsZero() { return Result::Success<uint512, ParseError>(PackWide(negative, 0u512, 0, layout)); }

    // The value is at least ten to the magnitude less one and below ten to the magnitude; anything clearly past
    // the format is answered without building the numbers that would say so exactly.
    let magnitude = (significant as int) + decimalExponent;
    let largest = ((layout.bias as int64 * 30103i64) / 100000i64) as int + 2;
    let smallest = 0 - ((((layout.bias + layout.precision as int) as int64 * 30103i64) / 100000i64) as int + 3);
    if magnitude > largest { return Result::Error<uint512, ParseError>(ParseError::Overflow); }
    if magnitude < smallest { return Result::Success<uint512, ParseError>(PackWide(negative, 0u512, 0, layout)); }
    return RoundRatio(allocator, digits, decimalExponent, negative, layout);
}

// The bits nearest to `digits` times ten to `decimalExponent`, found by exact division.
func RoundRatio(allocator: Allocator, digits: &var BigNat, decimalExponent: int, negative: bool,
                layout: &FloatLayout) -> Result<uint512, ParseError> {
    var numerator = BigNat(allocator);
    var denominator = BigNat(allocator);
    var power = BigNat(allocator);
    var base = BigNat(allocator);
    var scratch = BigNat(allocator);
    if !denominator.SetSmall(1u64) { return Result::Error<uint512, ParseError>(ParseError::Overflow); }
    if decimalExponent >= 0 {
        if !SetPowerOfTen(power, decimalExponent as uint, base, scratch) || !numerator.SetProduct(digits, power) {
            return Result::Error<uint512, ParseError>(ParseError::Overflow);
        }
    }
    else {
        if !numerator.Assign(digits) ||
            !SetPowerOfTen(denominator, (0 - decimalExponent) as uint, base, scratch) {
            return Result::Error<uint512, ParseError>(ParseError::Overflow);
        }
    }

    // The binade: two to the exponent is at most the ratio, which is below two to the exponent plus one.
    var exponent = numerator.BitLength() as int - denominator.BitLength() as int;
    if exponent >= 0 {
        if !scratch.Assign(denominator) || !scratch.ShiftLeft(exponent as uint) {
            return Result::Error<uint512, ParseError>(ParseError::Overflow);
        }
        if numerator.Compare(scratch) < 0i32 {
            exponent = exponent - 1;
        }
    }
    else {
        if !scratch.Assign(numerator) || !scratch.ShiftLeft((0 - exponent) as uint) {
            return Result::Error<uint512, ParseError>(ParseError::Overflow);
        }
        if scratch.Compare(denominator) < 0i32 {
            exponent = exponent - 1;
        }
    }
    let precision = layout.precision;
    if exponent > layout.bias { return Result::Error<uint512, ParseError>(ParseError::Overflow); }
    // Below the normal range the quotient is taken at fewer bits, so that what is rounded is the subnormal's own
    // last place and not a position it cannot store.
    var wanted = precision + 3u;
    let lowest = 1 - layout.bias;
    if exponent < lowest {
        let lost = (lowest - exponent) as uint;
        if lost >= wanted { return Result::Success<uint512, ParseError>(PackWide(negative, 0u512, 0, layout)); }
        wanted = wanted - lost;
    }

    // Long division to `wanted` bits, the leading one first, with whatever is left folded into the last.
    var remainder = BigNat(allocator);
    var divisor = BigNat(allocator);
    if exponent >= 0 {
        if !remainder.Assign(numerator) || !divisor.Assign(denominator) || !divisor.ShiftLeft(exponent as uint) {
            return Result::Error<uint512, ParseError>(ParseError::Overflow);
        }
    }
    else if !remainder.Assign(numerator) || !remainder.ShiftLeft((0 - exponent) as uint) ||
             !divisor.Assign(denominator) {
        return Result::Error<uint512, ParseError>(ParseError::Overflow);
    }
    var quotient = 0u512;
    var position = wanted;
    while position > 0u {
        position = position - 1u;
        if remainder.Compare(divisor) >= 0i32 {
            quotient = quotient | (1u512 << position);
            remainder.Subtract(divisor);
        }
        if position > 0u && !remainder.ShiftLeft(1u) {
            return Result::Error<uint512, ParseError>(ParseError::Overflow);
        }
    }
    if !remainder.IsZero() {
        quotient = quotient | 1u512;
    }

    // Round to nearest, ties to even, on the three low bits.
    var significand = quotient >> 3u;
    let low = quotient & 7u512;
    if low > 4u512 || (low == 4u512 && (significand & 1u512) == 1u512) {
        significand = significand + 1u512;
    }
    if exponent < lowest {
        if significand == (1u512 << (precision - 1u)) {
            // Rounding carried the subnormal up into the smallest normal, which the packer spells by itself.
            return Result::Success<uint512, ParseError>(PackWide(negative, significand, layout.MinimumExponent(),
                                                                  layout));
        }
        return Result::Success<uint512, ParseError>(PackWide(negative, significand, layout.MinimumExponent(),
                                                              layout));
    }
    if significand == (1u512 << precision) {
        significand = significand >> 1u;
        exponent = exponent + 1;
        if exponent > layout.bias { return Result::Error<uint512, ParseError>(ParseError::Overflow); }
    }
    return Result::Success<uint512, ParseError>(PackWide(negative, significand, exponent - (precision as int - 1),
                                                          layout));
}

/// Reads `str` as an x87 extended value.
///
/// https://rux-lang.dev/docs/api/format/parse-float80
pub func ParseFloat80(allocator: Allocator, str: Slice<char8>) -> Result<Float80, ParseError> {
    let layout = FloatLayout::Extended80();
    let parsed = ParseWideFloat(allocator, str, layout);
    var failure = ParseError::Empty;
    if parsed.TryIntoError(@failure) { return Result::Error<Float80, ParseError>(failure); }
    return Result::Success<Float80, ParseError>(Float80::FromBits(parsed.ValueOr(0u512) as uint128));
}

/// Provides the public `ParseFloat80` operation for text.
///
/// https://rux-lang.dev/docs/api/format/parse-float80
pub func ParseFloat80(allocator: Allocator, str: string) -> Result<Float80, ParseError> {
    return ParseFloat80(allocator, Slice<char8> { data: str.data, length: str.length });
}

/// Reads `str` as a binary128 value.
///
/// https://rux-lang.dev/docs/api/format/parse-float128
pub func ParseFloat128(allocator: Allocator, str: Slice<char8>) -> Result<Float128, ParseError> {
    let layout = FloatLayout::Binary128();
    let parsed = ParseWideFloat(allocator, str, layout);
    var failure = ParseError::Empty;
    if parsed.TryIntoError(@failure) { return Result::Error<Float128, ParseError>(failure); }
    return Result::Success<Float128, ParseError>(Float128::FromBits(parsed.ValueOr(0u512) as uint128));
}

/// Provides the public `ParseFloat128` operation for text.
///
/// https://rux-lang.dev/docs/api/format/parse-float128
pub func ParseFloat128(allocator: Allocator, str: string) -> Result<Float128, ParseError> {
    return ParseFloat128(allocator, Slice<char8> { data: str.data, length: str.length });
}

/// Reads `str` as a binary256 value.
///
/// https://rux-lang.dev/docs/api/format/parse-float256
pub func ParseFloat256(allocator: Allocator, str: Slice<char8>) -> Result<Float256, ParseError> {
    let layout = FloatLayout::Binary256();
    let parsed = ParseWideFloat(allocator, str, layout);
    var failure = ParseError::Empty;
    if parsed.TryIntoError(@failure) { return Result::Error<Float256, ParseError>(failure); }
    return Result::Success<Float256, ParseError>(Float256::FromBits(parsed.ValueOr(0u512) as uint256));
}

/// Provides the public `ParseFloat256` operation for text.
///
/// https://rux-lang.dev/docs/api/format/parse-float256
pub func ParseFloat256(allocator: Allocator, str: string) -> Result<Float256, ParseError> {
    return ParseFloat256(allocator, Slice<char8> { data: str.data, length: str.length });
}

/// Reads `str` as a binary512 value.
///
/// https://rux-lang.dev/docs/api/format/parse-float512
pub func ParseFloat512(allocator: Allocator, str: Slice<char8>) -> Result<Float512, ParseError> {
    let layout = FloatLayout::Binary512();
    let parsed = ParseWideFloat(allocator, str, layout);
    var failure = ParseError::Empty;
    if parsed.TryIntoError(@failure) { return Result::Error<Float512, ParseError>(failure); }
    return Result::Success<Float512, ParseError>(Float512::FromBits(parsed.ValueOr(0u512) as uint512));
}

/// Provides the public `ParseFloat512` operation for text.
///
/// https://rux-lang.dev/docs/api/format/parse-float512
pub func ParseFloat512(allocator: Allocator, str: string) -> Result<Float512, ParseError> {
    return ParseFloat512(allocator, Slice<char8> { data: str.data, length: str.length });
}
