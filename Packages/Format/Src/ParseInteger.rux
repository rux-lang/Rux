/// @see https://rux-lang.dev/docs/api/format/parse-int512
pub func ParseInt512(str: char8[..]) -> int512 ! ParseError {
    var magnitude: uint512 = 0;
    var negative = false;
    ParseIntegerMagnitude(str, @magnitude, @negative)?;
    let limit = negative ? 6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042048u512 : 6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042047u512;
    if magnitude > limit { fail ParseError::Overflow(str.length); }
    if negative { return ~((magnitude as uint512) - 1) as int512; }
    return magnitude as int512;
