/// Parses an `int512`: an optional sign, an optional base prefix, and digits.
/// The negative bound is one larger than the positive one, because the most negative value has no positive
/// counterpart: the value one past the largest positive fits only with its sign.
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse#parse-int512
pub func ParseInt512(str: char8[..]) -> int512 throws ParseError {
    var magnitude: uint512 = 0;
    var negative = false;
    try ParseIntegerMagnitude(str, @magnitude, @negative);
    let limit = if negative {
        6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042048u512
    } else {
        6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042047u512
    };
    if magnitude > limit { throw ParseError::Overflow(str.length); }
    if negative { return (~((magnitude as uint512) -% 1)).Truncate<int512>(); }
    return magnitude as int512;
}

/// The same grammar for a view, which is what a caller holding text has.
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse#parse-uint8
pub func ParseUint8(str: StringView) -> uint8 throws ParseError {
    return try ParseUint8(str.Bytes());
}

/// The same grammar for a view, which is what a caller holding text has.
