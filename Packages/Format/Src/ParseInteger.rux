// Parsing an integer of any width, in any of the four bases.
// One grammar serves every width: an optional sign, an optional base prefix — `0x`, `0o`, `0b`, exactly the
// prefixes formatting writes under `#` — and digits of that base. The magnitude accumulates in `uint512`, the
// widest integer there is, so one loop serves every width and overflow within the loop is impossible for any
// narrower target; the width's own bound is checked once at the end, where the error can say which width refused.
// The bound is one larger for a negative value, because the most negative value of every signed width has no
// positive counterpart: `-128` fits an `int8` whose largest value is `127`.

import Text::StringView;

// What the sign and prefix left behind: where the digits start, which base they are in, and whether the value is
// negated. An empty run of digits after a prefix is the error the prefix's index reports.
func ParseIntegerMagnitude(str: char8[..], magnitude: *var uint512,
                           negative: *var bool) -> bool ! ParseError {
    if str.length == 0 { fail ParseError::Empty; }

    var index: uint = 0;
    *negative = false;
    if str[index] == c8'+' || str[index] == c8'-' {
        *negative = str[index] == c8'-';
        index++;
        if index == str.length { fail ParseError::InvalidCharacter(index - 1); }
    }

    var radix: uint512 = 10;
    if index + 1 < str.length && str[index] == c8'0' {
        let mark = str[index + 1];
        if mark == c8'x' || mark == c8'X' {
            radix = 16;
            index += 2;
        }
        else if mark == c8'o' || mark == c8'O' {
            radix = 8;
            index += 2;
        }
        else if mark == c8'b' || mark == c8'B' {
            radix = 2;
            index += 2;
        }
        if radix != 10 && index == str.length {
            fail ParseError::InvalidCharacter(index - 1);
        }
    }

    let limit: uint512 = 13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095;
    *magnitude = 0;
    while index < str.length {
        let ch = str[index];
        var digit: uint512 = 0;
        if ch >= c8'0' && ch <= c8'9' {
            digit = ((ch as uint) - 0x30) as uint512;
        }
        else if ch >= c8'a' && ch <= c8'f' {
            digit = ((ch as uint) - 0x57) as uint512;
        }
        else if ch >= c8'A' && ch <= c8'F' {
            digit = ((ch as uint) - 0x37) as uint512;
        }
        else {
            fail ParseError::InvalidCharacter(index);
        }
        if digit >= radix { fail ParseError::InvalidCharacter(index); }
        if *magnitude > (limit - digit) / radix {
            // Past what the widest integer holds, so the digit that did it is the offset. A value
            // that merely overruns the target width is caught later, where the width is known.
            fail ParseError::Overflow(index);
        }
        *magnitude = *magnitude * radix + digit;
        index++;
    }
    return true;
}

/// Parses a `uint8`: an optional `+`, an optional base prefix, and digits.
/// Reports `Overflow` for a value the width cannot hold, `InvalidCharacter` at the first byte that is not
/// part of the grammar — a `-` included, since no unsigned value is negative.
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse-uint8
pub func ParseUint8(str: char8[..]) -> uint8 ! ParseError {
    var magnitude: uint512 = 0;
    var negative = false;
    ParseIntegerMagnitude(str, @magnitude, @negative)?;
    if negative { fail ParseError::InvalidCharacter(0); }
    if magnitude > 255 { fail ParseError::Overflow(str.length); }
    return magnitude as uint8;
}

/// Parses an `int8`: an optional sign, an optional base prefix, and digits.
/// The negative bound is one larger than the positive one, because the most negative value has no positive
/// counterpart: the value one past the largest positive fits only with its sign.
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse-int8
pub func ParseInt8(str: char8[..]) -> int8 ! ParseError {
    var magnitude: uint512 = 0;
    var negative = false;
    ParseIntegerMagnitude(str, @magnitude, @negative)?;
    let limit = negative ? 128u512 : 127u512;
    if magnitude > limit { fail ParseError::Overflow(str.length); }
    if negative { return ~((magnitude as uint8) - 1) as int8; }
    return magnitude as int8;
}

