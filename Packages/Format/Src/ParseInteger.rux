/// The same grammar for a view, which is what a caller holding text has.
///
/// https://rux-lang.dev/docs/api/format/parse-uint8-view
func ParseUint8(str: StringView) -> Result<uint8, ParseError> {
    return ParseUint8(str.Bytes());
}

/// The same grammar for a view, which is what a caller holding text has.
///
/// https://rux-lang.dev/docs/api/format/parse-int8-view
func ParseInt8(str: StringView) -> Result<int8, ParseError> {
    return ParseInt8(str.Bytes());
}

