// An arbitrary-size natural number, for the two conversions that have to be exact.
// Turning a float into its shortest decimal, or a decimal into the nearest float, is a question about where the
// exact value sits between two neighbours, and answering it with floating-point arithmetic loses the very bits the
// answer depends on. The classic way out is integer arithmetic on the exact value: a float is an integer times a
// power of two, a decimal is an integer times a power of ten, and comparing the two needs nothing more than big
// integers that can be multiplied, shifted and compared. That is everything this type does, and nothing more.
// The sizes involved are why this cannot be a fixed width. A float512 reaches 2^4194303, and the exact decimal
// conversion of a value near that limit works on numbers of that many bits. They come from an allocator because
// nothing else can hold them; the narrow widths never get near that, and a float80 never needs more than a few
// hundred words.

import Allocator::{ AllocError, Allocator, Layout };

/// A natural number of any size, held as little-endian 64-bit limbs.
/// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat
struct BigNat {
    /// Where the limbs live.
    allocator: Allocator;
    /// The limbs, least significant first.
    limbs: *var uint64;
    /// How many limbs the block holds.
    capacity: uint;
    /// How many limbs carry the value; the top one is never zero, and zero itself has none.
    length: uint;
}

extend BigNat {
    /// Copying would give two owners of the same limb block.
    func =(self: &var BigNat, other: &BigNat);

    /// Zero, holding no storage yet.
    /// @param allocator where the working storage comes from
    /// @returns a zero that has taken no storage yet
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-new
    func BigNat(allocator: Allocator) -> BigNat {
        return BigNat { allocator: allocator, limbs: null, capacity: 0, length: 0 };
    }

    /// Makes room for `count` limbs, keeping the value. Reports `false` when the allocator refuses.
    /// @param count how many digits there are
    /// @returns true when the allocator refused, leaving the value unusable
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-reserve
    func Reserve(self: &var BigNat, count: uint) -> bool {
        if count <= self.capacity { return true; }
        // Growing by halves keeps repeated multiplication linear in allocations rather than quadratic.
        var wanted = self.capacity + self.capacity / 2 + 8;
        if wanted < count {
            wanted = count;
        }
        let empty = Layout { size: 0, alignment: 1 };
        let layout = Layout::New(wanted * 8, 8) ?? (empty);
        if layout.size == 0 { return false; }
        let block = self.allocator.Allocate(layout) catch { else => return false };
        let fresh = block as *var uint64;
        var index: uint = 0;
        while index < self.length {
            fresh[index] = self.limbs[index];
            index = index + 1;
        }
        // The old block goes back by hand rather than through Release, which also forgets the length — and the
        // whole point of growing is to keep the value.
        if self.limbs != null {
            let old = Layout::New(self.capacity * 8, 8) ?? (empty);
            self.allocator.Deallocate(self.limbs as *var opaque, old) catch { else => {} };
        }
        self.limbs = fresh;
        self.capacity = wanted;
        return true;
    }

    func Release(self: &var BigNat) {
        if self.limbs != null {
            let empty = Layout { size: 0, alignment: 1 };
            let layout = Layout::New(self.capacity * 8, 8) ?? (empty);
            self.allocator.Deallocate(self.limbs as *var opaque, layout) catch { else => {} };
            self.limbs = null;
            self.capacity = 0;
        }
        self.length = 0;
    }

    // Drops leading zero limbs so that `length` is canonical, which every comparison relies on.
    func Trim(self: &var BigNat) {
        while self.length > 0 && self.limbs[self.length - 1] == 0 {
            self.length = self.length - 1;
        }
    }

    /// Whether this is zero.
    /// @returns whether the value is zero
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-is-zero
    func IsZero(self: &BigNat) -> bool {
        return self.length == 0;
    }

    /// Sets this to a small value.
    /// @param value the value to act on
    /// @returns true when the allocator refused, leaving the value unusable
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-set-small
    func SetSmall(self: &var BigNat, value: uint64) -> bool {
        if !self.Reserve(1) { return false; }
        self.limbs[0] = value;
        self.length = value == 0 ? 0 : 1;
        return true;
    }

    /// Sets this to a 512-bit value.
    /// @param value the value to act on
    /// @returns true when the allocator refused, leaving the value unusable
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-set-wide
    func SetWide(self: &var BigNat, value: uint512) -> bool {
        if !self.Reserve(8) { return false; }
        var index: uint = 0;
        while index < 8 {
            self.limbs[index] = (value >> (index * 64)) as uint64;
            index = index + 1;
        }
        self.length = 8;
        self.Trim();
        return true;
    }

    /// Copies `other` into this.
    /// @param other the value to operate against
    /// @returns true when the allocator refused, leaving the value unusable
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-assign
    func Assign(self: &var BigNat, other: &BigNat) -> bool {
        if !self.Reserve(other.length) { return false; }
        var index: uint = 0;
        while index < other.length {
            self.limbs[index] = other.limbs[index];
            index = index + 1;
        }
        self.length = other.length;
        return true;
    }

    /// How many bits the value needs; zero for zero.
    /// @returns how many bits the value occupies, zero for zero
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-bit-length
    func BitLength(self: &BigNat) -> uint {
        if self.length == 0 { return 0; }
        var top = self.limbs[self.length - 1];
        var bits: uint = 0;
        while top != 0 {
            top = top >> 1;
            bits = bits + 1;
        }
        return (self.length - 1) * 64 + bits;
    }

    /// Orders this against `other`: negative, zero or positive.
    /// @param other the value to operate against
    /// @returns negative, zero or positive as this value orders against `other`
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-compare
    func Compare(self: &BigNat, other: &BigNat) -> int32 {
        if self.length != other.length { return self.length < other.length ? -1 : 1; }
        var index = self.length;
        while index > 0 {
            index = index - 1;
            if self.limbs[index] != other.limbs[index] { return self.limbs[index] < other.limbs[index] ? -1 : 1; }
        }
        return 0;
    }

    /// Multiplies this by 2^`bits` in place.
    /// @param bits the value's bit pattern
    /// @returns true when the allocator refused, leaving the value unusable
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-shift-left
    func ShiftLeft(self: &var BigNat, bits: uint) -> bool {
        if self.length == 0 || bits == 0 { return true; }
        let limbShift = bits / 64;
        let bitShift = bits % 64;
        let newLength = self.length + limbShift + 1;
        if !self.Reserve(newLength) { return false; }
        // From the top down, so nothing is overwritten before it has been read.
        self.limbs[newLength - 1] = 0;
        var index = self.length;
        while index > 0 {
            index = index - 1;
            let limb = self.limbs[index];
            if bitShift == 0 {
                self.limbs[index + limbShift] = limb;
            }
            else {
                self.limbs[index + limbShift + 1] = self.limbs[index + limbShift + 1] | (limb >> (64 - bitShift));
                self.limbs[index + limbShift] = limb << bitShift;
            }
        }
        index = 0;
        while index < limbShift {
            self.limbs[index] = 0;
            index = index + 1;
        }
        self.length = newLength;
        self.Trim();
        return true;
    }

    /// Multiplies this by a small factor in place.
    /// @param factor what to multiply by
    /// @returns true when the allocator refused, leaving the value unusable
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-multiply-small
    func MultiplySmall(self: &var BigNat, factor: uint64) -> bool {
        if factor == 0 {
            self.length = 0;
            return true;
        }
        if !self.Reserve(self.length + 1) { return false; }
        var carry: uint64 = 0;
        var index: uint = 0;
        while index < self.length {
            let product = (self.limbs[index] as uint128) * (factor as uint128) + (carry as uint128);
            self.limbs[index] = product as uint64;
            carry = (product >> 64) as uint64;
            index = index + 1;
        }
        if carry != 0 {
            self.limbs[self.length] = carry;
            self.length = self.length + 1;
        }
        return true;
    }

    /// Adds a small value in place.
    /// @param value the value to act on
    /// @returns true when the allocator refused, leaving the value unusable
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-add-small
    func AddSmall(self: &var BigNat, value: uint64) -> bool {
        if !self.Reserve(self.length + 1) { return false; }
        var carry = value;
        var index: uint = 0;
        while carry != 0 && index < self.length {
            let sum = (self.limbs[index] as uint128) + (carry as uint128);
            self.limbs[index] = sum as uint64;
            carry = (sum >> 64) as uint64;
            index = index + 1;
        }
        if carry != 0 {
            self.limbs[self.length] = carry;
            self.length = self.length + 1;
        }
        return true;
    }

    /// Adds `other` in place.
    /// @param other the value to operate against
    /// @returns true when the allocator refused, leaving the value unusable
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-add
    func Add(self: &var BigNat, other: &BigNat) -> bool {
        let longest = self.length > other.length ? self.length : other.length;
        if !self.Reserve(longest + 1) { return false; }
        var carry: uint64 = 0;
        var index: uint = 0;
        while index < longest {
            let left = index < self.length ? self.limbs[index] : 0;
            let right = index < other.length ? other.limbs[index] : 0;
            let sum = (left as uint128) + (right as uint128) + (carry as uint128);
            self.limbs[index] = sum as uint64;
            carry = (sum >> 64) as uint64;
            index = index + 1;
        }
        self.length = longest;
        if carry != 0 {
            self.limbs[self.length] = carry;
            self.length = self.length + 1;
        }
        return true;
    }

    /// Subtracts `other` in place. It must not exceed this, which every caller compares for first.
    /// @param other the value to operate against
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-subtract
    func Subtract(self: &var BigNat, other: &BigNat) {
        var borrow: uint64 = 0;
        var index: uint = 0;
        while index < self.length {
            let right = index < other.length ? other.limbs[index] : 0u64;
            let left = self.limbs[index];
            let taken = (right as uint128) + (borrow as uint128);
            if (left as uint128) >= taken {
                self.limbs[index] = ((left as uint128) - taken) as uint64;
                borrow = 0;
            }
            else {
                self.limbs[index] = (((left as uint128) + (1u128 << 64)) - taken) as uint64;
                borrow = 1;
            }
            index = index + 1u;
        }
        self.Trim();
    }

    /// Sets this to `left` times `right`. Neither operand may be this.
    /// @param left one factor
    /// @param right the other
    /// @returns true when the allocator refused, leaving the value unusable
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-set-product
    func SetProduct(self: &var BigNat, left: &BigNat, right: &BigNat) -> bool {
        let total = left.length + right.length;
        if !self.Reserve(total + 1) { return false; }
        // The recursion works in one block taken here, so a product of any size asks the allocator twice, however
        // deep the split goes; asking at every level was most of the time at the widest float.
        var work = BigNat(self.allocator);
        let room = ProductWork(left.length, right.length);
        if room > 0 && !work.Reserve(room) { return false; }
        MultiplyLimbs(self.limbs, left.limbs, left.length, right.limbs, right.length, work.limbs);
        self.length = total;
        self.Trim();
        return true;
    }

    /// The quotient of this by `divisor` when it is below ten, removing that many divisors from this.
    /// The digit loops only ever ask for one decimal digit at a time, so a count of subtractions is the whole of
    /// the division they need.
    /// @param divisor the value to divide by, which must be at most ten times this one
    /// @returns the leading decimal digit, with that multiple of `divisor` subtracted from this value
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-take-digit
    func TakeDigit(self: &var BigNat, divisor: &BigNat) -> uint {
        var digit: uint = 0;
        while digit < 9 && self.Compare(divisor) >= 0 {
            self.Subtract(divisor);
            digit = digit + 1;
        }
        return digit;
    }

    /// Gives the limbs back.
    /// @see https://rux-lang.dev/docs/api/format/float-layout#big-nat-destructor
    func ~BigNat(self: &var BigNat) {
        self.Release();
    }
}

// Below this many limbs the schoolbook product beats splitting.
const KaratsubaLimbs: uint = 32;

// The working room `KaratsubaProduct` needs for two `count`-limb factors: four limbs per level for the two sums and
// their product, at a size that halves.
func KaratsubaWork(count: uint) -> uint {
    var total: uint = 0;
    var size = count;
    while size >= KaratsubaLimbs {
        let upper = size - size / 2 + 1;
        total = total + 4 * upper;
        size = upper;
    }
    return total;
}

// The working room `MultiplyLimbs` needs for factors of these lengths.
func ProductWork(leftCount: uint, rightCount: uint) -> uint {
    let long = leftCount > rightCount ? leftCount : rightCount;
    let short = leftCount > rightCount ? rightCount : leftCount;
    if short < KaratsubaLimbs { return 0; }
    if long == short { return KaratsubaWork(short); }
    let rest = long % short;
    let whole = KaratsubaWork(short);
    let tail = rest == 0 ? 0u : ProductWork(short, rest);
    return 2 * short + (whole > tail ? whole : tail);
}

// out[0, l + r) = left[0, l) * right[0, r), one row at a time.
func SchoolbookProduct(out: *var uint64, left: *uint64, leftCount: uint, right: *uint64, rightCount: uint) {
    var index: uint = 0;
    while index < leftCount + rightCount {
        out[index] = 0;
        index = index + 1;
    }
    var i: uint = 0;
    while i < leftCount {
        var carry: uint64 = 0;
        var j: uint = 0;
        while j < rightCount {
            let product = (left[i] as uint128) * (right[j] as uint128) + (out[i + j] as uint128) + (carry as uint128);
            out[i + j] = product as uint64;
            carry = (product >> 64) as uint64;
            j = j + 1;
        }
        out[i + rightCount] = carry;
        i = i + 1;
    }
}

// Adds `count` limbs of `value` into `out` from `offset` on, carrying as far as `end`.
func AddLimbsAt(out: *var uint64, end: uint, offset: uint, value: *uint64, count: uint) {
    var carry: uint64 = 0;
    var index: uint = 0;
    while index < count || (carry != 0 && offset + index < end) {
        let addend = index < count ? value[index] : 0u64;
        let sum = (out[offset + index] as uint128) + (addend as uint128) + (carry as uint128);
        out[offset + index] = sum as uint64;
        carry = (sum >> 64) as uint64;
        index = index + 1;
    }
}

// Subtracts `count` limbs of `value` from the `length` limbs of `out`, which is never the smaller.
func SubtractLimbs(out: *var uint64, length: uint, value: *uint64, count: uint) {
    var borrow: uint64 = 0;
    var index: uint = 0;
    while index < length {
        let right = ((index < count ? value[index] : 0u64) as uint128) + (borrow as uint128);
        let left = out[index] as uint128;
        if left >= right {
            out[index] = (left - right) as uint64;
            borrow = 0;
        }
        else {
            out[index] = (left + (1u128 << 64) - right) as uint64;
            borrow = 1;
        }
        index = index + 1;
    }
}

// Sets sum[0, upper + 1) to low[0, lower) + high[0, upper), where lower is at most upper.
func SumHalves(sum: *var uint64, low: *uint64, lower: uint, high: *uint64, upper: uint) {
    var carry: uint64 = 0;
    var index: uint = 0;
    while index < upper {
        let addend = index < lower ? low[index] : 0u64;
        let total = (high[index] as uint128) + (addend as uint128) + (carry as uint128);
        sum[index] = total as uint64;
        carry = (total >> 64) as uint64;
        index = index + 1;
    }
    sum[upper] = carry;
}

// Karatsuba on two `count`-limb factors into out[0, 2 count): (a0 + a1 B)(b0 + b1 B) needs three half-size
// products, not four, and B is a whole number of limbs, so recombining is additions at limb offsets. Every level
// takes its room from `work` rather than from an allocator.
func KaratsubaProduct(out: *var uint64, left: *uint64, right: *uint64, count: uint, work: *var uint64) {
    if count < KaratsubaLimbs {
        SchoolbookProduct(out, left, count, right, count);
        return;
    }
    let lower = count / 2;
    let upper = count - lower;
    let size = upper + 1;
    // a0 b0 goes to the bottom of `out` and a1 b1 to the top, filling it exactly.
    KaratsubaProduct(out, left, right, lower, work);
    KaratsubaProduct(@out[2 * lower], @left[lower], @right[lower], upper, work);
    let leftSum = work;
    let rightSum = @work[size];
    let middle = @work[2 * size];
    SumHalves(leftSum, left, lower, @left[lower], upper);
    SumHalves(rightSum, right, lower, @right[lower], upper);
    KaratsubaProduct(middle, leftSum, rightSum, size, @work[4 * size]);
    SubtractLimbs(middle, 2 * size, out, 2 * lower);
    SubtractLimbs(middle, 2 * size, @out[2 * lower], 2 * upper);
    AddLimbsAt(out, 2 * count, lower, middle, 2 * size);
}

// out[0, l + r) = left[0, l) * right[0, r), with room in `work` as `ProductWork` measures it. Factors of equal
// length split; a long one against a short one goes a piece of the short one's length at a time, so each piece
// splits too rather than costing the product of both lengths in the schoolbook loop.
func MultiplyLimbs(out: *var uint64, left: *uint64, leftCount: uint, right: *uint64, rightCount: uint,
                   work: *var uint64) {
    if leftCount < rightCount {
        MultiplyLimbs(out, right, rightCount, left, leftCount, work);
        return;
    }
    if rightCount < KaratsubaLimbs {
        SchoolbookProduct(out, left, leftCount, right, rightCount);
        return;
    }
    if leftCount == rightCount {
        KaratsubaProduct(out, left, right, leftCount, work);
        return;
    }
    let total = leftCount + rightCount;
    var index: uint = 0;
    while index < total {
        out[index] = 0;
        index = index + 1;
    }
    let piece = work;
    var offset: uint = 0;
    while offset < leftCount {
        let count = leftCount - offset < rightCount ? leftCount - offset : rightCount;
        MultiplyLimbs(piece, @left[offset], count, right, rightCount, @work[2 * rightCount]);
        AddLimbsAt(out, total, offset, piece, count + rightCount);
        offset = offset + rightCount;
    }
}

/// Sets `target` to 10^`power`, using `base` and `scratch` as working room.
/// Ten to the power is five to the power shifted, and five has fewer bits to carry through the squarings: the
/// intermediate numbers are a third shorter, which is the difference between a tolerable and an intolerable wait at
/// the widths where the exponent runs to millions.
/// @param target receives ten raised to `power`
/// @param power the power of ten
/// @param base working storage the computation borrows
/// @param scratch further working storage the computation borrows
/// @returns true when the allocator refused, leaving the value unusable
/// @see https://rux-lang.dev/docs/api/format/float-layout#set-power-of-ten
func SetPowerOfTen(target: &var BigNat, power: uint, base: &var BigNat, scratch: &var BigNat) -> bool {
    if !target.SetSmall(1) || !base.SetSmall(5) { return false; }
    var remaining = power;
    while remaining > 0 {
        if (remaining & 1) == 1 {
            if !scratch.SetProduct(target, base) || !target.Assign(scratch) { return false; }
        }
        remaining = remaining >> 1;
        if remaining > 0 {
            if !scratch.SetProduct(base, base) || !base.Assign(scratch) { return false; }
        }
    }
    return target.ShiftLeft(power);
}
