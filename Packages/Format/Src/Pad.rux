// Applying a spec's width, fill and alignment to text that is already rendered.
//
// Padding is the one part of a spec every type applies the same way, so it is written once: measure the rendering,
// and if the width asks for more columns, write fill where the alignment says. Zero-padding is deliberately not
// here -- its zeros go inside the number, between sign and digits, so the numeric writer owns them.

import Core::Slice;
import Core::MutableSlice;
import Text::{ CountScalars, Encode, TextError };

/// Writes `rendered` into `writer` under `spec`'s width, fill and alignment.
///
/// `numeric` picks the default alignment: numbers sit to the right and text to the left, which is what makes a
/// column of numbers line up its units and a column of names line up its first letters. Width is measured in
/// characters rather than bytes, so a name with an accent pads the same as one without.
///
/// https://rux-lang.dev/docs/api/format/write-aligned
pub func WriteAligned(writer: &var TextWriter, spec: FormatSpec, rendered: Slice<char8>, numeric: bool) -> TextError {
    let occupied = CountScalars(rendered);
    if spec.width <= occupied {
        return WriteBytes(writer, rendered);
    }
    let missing = spec.width - occupied;

    var align = spec.align;
    if align == FormatAlign::Default {
        align = numeric ? FormatAlign::Right : FormatAlign::Left;
    }
    var before: uint = 0;
    if align == FormatAlign::Right {
        before = missing;
    }
    else if align == FormatAlign::Center {
        before = missing / 2;
    }

    var written: uint = 0;
    while written < before {
        let filled = WriteAscii(writer, spec.fill);
        if filled.IsError() {
            return filled;
        }
        written = written + 1;
    }
    let body = WriteBytes(writer, rendered);
    if body.IsError() {
        return body;
    }
    while written < missing {
        let filled = WriteAscii(writer, spec.fill);
        if filled.IsError() {
            return filled;
        }
        written = written + 1;
    }
    return TextError::None;
}

/// How many fill bytes go on each side of a rendering that occupies `occupied` columns.
///
/// https://rux-lang.dev/docs/api/format/padding-around
pub func PaddingAround(spec: FormatSpec, occupied: uint, numeric: bool, before: *var uint, after: *var uint) {
    *before = 0;
    *after = 0;
    if spec.width <= occupied {
        return;
    }
    let missing = spec.width - occupied;
    var align = spec.align;
    if align == FormatAlign::Default {
        align = numeric ? FormatAlign::Right : FormatAlign::Left;
    }
    if align == FormatAlign::Right {
        *before = missing;
    }
    else if align == FormatAlign::Center {
        *before = missing / 2;
    }
    *after = missing - *before;
}

/// Writes `count` copies of the spec's fill byte.
///
/// https://rux-lang.dev/docs/api/format/write-fill
pub func WriteFill(writer: &var TextWriter, spec: FormatSpec, count: uint) -> TextError {
    var written: uint = 0;
    while written < count {
        let filled = WriteAscii(writer, spec.fill);
        if filled.IsError() {
            return filled;
        }
        written = written + 1;
    }
    return TextError::None;
}

/// Writes an integer whose digits are already produced, applying sign, prefix, zero-padding and alignment.
///
/// `digits` holds the digits least significant first, which is the order a division loop makes them; `count` says
/// how many. Zero-padding puts its zeros between the sign and the digits -- `-7` at width four is `-007`, not
/// `00-7` -- and wins over alignment when both are asked for. Nothing here allocates or copies the digits: each
/// piece goes to the writer as it is reached, so the widest integer costs no more room than its own digit buffer.
///
/// https://rux-lang.dev/docs/api/format/write-integer-digits
pub func WriteIntegerDigits(writer: &var TextWriter, spec: FormatSpec, digits: Slice<char8>, count: uint,
                        negative: bool) -> TextError {
    var lead: uint = 0;
    if negative || spec.showSign {
        lead = 1;
    }
    if spec.alternate && spec.base != FormatBase::Decimal {
        lead = lead + 2;
    }
    var zeros: uint = 0;
    if spec.zeroPad && spec.width > lead + count {
        zeros = spec.width - lead - count;
    }

    var before: uint = 0;
    var after: uint = 0;
    PaddingAround(spec, lead + zeros + count, true, @before, @after);
    let opened = WriteFill(writer, spec, before);
    if opened.IsError() {
        return opened;
    }
    if negative {
        let sign = WriteAscii(writer, c8'-');
        if sign.IsError() {
            return sign;
        }
    }
    else if spec.showSign {
        let sign = WriteAscii(writer, c8'+');
        if sign.IsError() {
            return sign;
        }
    }
    if spec.alternate && spec.base != FormatBase::Decimal {
        let zero = WriteAscii(writer, c8'0');
        if zero.IsError() {
            return zero;
        }
        let mark = spec.base == FormatBase::Binary ? c8'b' : (spec.base == FormatBase::Octal ? c8'o' : c8'x');
        let letter = WriteAscii(writer, mark);
        if letter.IsError() {
            return letter;
        }
    }
    var padded: uint = 0;
    while padded < zeros {
        let zero = WriteAscii(writer, c8'0');
        if zero.IsError() {
            return zero;
        }
        padded = padded + 1;
    }
    var index = count;
    while index > 0 {
        index = index - 1;
        let digit = WriteAscii(writer, digits.data[index]);
        if digit.IsError() {
            return digit;
        }
    }
    return WriteFill(writer, spec, after);
}

/// Writes an integer under the whole of `spec`: base, sign, alternate prefix, zero-padding and alignment.
///
/// `magnitude` is the absolute value and `negative` its sign, kept apart because the most negative value of a
/// signed width has no positive counterpart to negate into.
///
/// https://rux-lang.dev/docs/api/format/write-integer-spec
pub func WriteIntegerSpec(writer: &var TextWriter, spec: FormatSpec, magnitude: uint64, negative: bool) -> TextError {
    var digits: char8[64];
    var count: uint = 0;
    var radix: uint64 = 10;
    if spec.base == FormatBase::Binary {
        radix = 2;
    }
    else if spec.base == FormatBase::Octal {
        radix = 8;
    }
    else if spec.base == FormatBase::LowerHex || spec.base == FormatBase::UpperHex {
        radix = 16;
    }
    let letter = spec.base == FormatBase::UpperHex ? 0x37u64 : 0x57u64;
    var rest = magnitude;
    if rest == 0u64 {
        digits[0] = c8'0';
        count = 1;
    }
    while rest > 0u64 {
        let digit = rest % radix;
        digits[count] = (digit < 10u64 ? digit + 0x30u64 : digit + letter) as char8;
        count = count + 1;
        rest = rest / radix;
    }
    return WriteIntegerDigits(writer, spec, Slice<char8> { data: @digits[0], length: count }, count, negative);
}

/// Writes one character under `spec`'s width, fill and alignment.
///
/// https://rux-lang.dev/docs/api/format/format-scalar
pub func FormatScalar(writer: &var TextWriter, spec: FormatSpec, scalar: char32) -> TextError {
    var encoded: char8[4];
    var written: uint = 0;
    let sink = MutableSlice::From<char8>(@encoded[0], 4);
    if Encode(scalar, sink, @written).IsError() {
        return TextError::InvalidUtf8;
    }
    return WriteAligned(writer, spec, Slice<char8> { data: @encoded[0], length: written }, false);
}
