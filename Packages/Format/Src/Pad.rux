// Applying a spec's width, fill and alignment to text that is already rendered.
//
// Padding is the one part of a spec every type applies the same way, so it is written once: measure the rendering,
// and if the width asks for more columns, write fill where the alignment says. Zero-padding is deliberately not
// here -- its zeros go inside the number, between sign and digits, so the numeric writer owns them.

import Core::Slice;
import Core::MutableSlice;
import Text::{ CountScalars, Encode, TextError };

/// Writes `rendered` into `writer` under `spec`'s width, fill and alignment.
///
/// `numeric` picks the default alignment: numbers sit to the right and text to the left, which is what makes a
/// column of numbers line up its units and a column of names line up its first letters. Width is measured in
/// characters rather than bytes, so a name with an accent pads the same as one without.
///
/// https://rux-lang.dev/docs/api/format/write-aligned
func WriteAligned(writer: Writer, spec: FormatSpec, rendered: Slice<char8>, numeric: bool) -> TextError {
    let occupied = CountScalars(rendered);
    if spec.width <= occupied {
        return WriteBytes(writer, rendered);
    }
    let missing = spec.width - occupied;

    var align = spec.align;
    if align == FormatAlign::Default {
        align = numeric ? FormatAlign::Right : FormatAlign::Left;
    }
    var before: uint = 0;
    if align == FormatAlign::Right {
        before = missing;
    }
    else if align == FormatAlign::Center {
        before = missing / 2;
    }

    var written: uint = 0;
    while written < before {
        let filled = WriteAscii(writer, spec.fill);
        if filled.IsError() {
            return filled;
        }
        written = written + 1;
    }
    let body = WriteBytes(writer, rendered);
    if body.IsError() {
        return body;
    }
    while written < missing {
        let filled = WriteAscii(writer, spec.fill);
        if filled.IsError() {
            return filled;
        }
        written = written + 1;
    }
    return TextError::None;
}

/// Writes an integer under the whole of `spec`: base, sign, alternate prefix, zero-padding and alignment.
///
/// `magnitude` is the absolute value and `negative` its sign, kept apart because the most negative value of a
/// signed width has no positive counterpart to negate into. Zero-padding puts its zeros between the sign and the
/// digits -- `-7` at width four is `-007`, not `00-7` -- and wins over alignment when both are asked for.
///
/// Allocates nothing: the longest rendering is sixty-four binary digits behind a sign and a prefix.
///
/// https://rux-lang.dev/docs/api/format/write-integer-spec
func WriteIntegerSpec(writer: Writer, spec: FormatSpec, magnitude: uint64, negative: bool) -> TextError {
    var digits: char8[64];
    var count: uint = 0;
    var radix: uint64 = 10;
    if spec.base == FormatBase::Binary {
        radix = 2;
    }
    else if spec.base == FormatBase::Octal {
        radix = 8;
    }
    else if spec.base == FormatBase::LowerHex || spec.base == FormatBase::UpperHex {
        radix = 16;
    }
    let letter = spec.base == FormatBase::UpperHex ? 0x37u64 : 0x57u64;
    var rest = magnitude;
    if rest == 0u64 {
        digits[0] = c8'0';
        count = 1;
    }
    while rest > 0u64 {
        let digit = rest % radix;
        digits[count] = (digit < 10u64 ? digit + 0x30u64 : digit + letter) as char8;
        count = count + 1;
        rest = rest / radix;
    }

    // Assembled front to back: sign, prefix, zeros, digits. Eighty bytes holds the longest possible -- a sign, two
    // bytes of prefix, and sixty-four binary digits -- with room to spare for zero-padding up to that width.
    var assembled: char8[160];
    var length: uint = 0;
    if negative {
        assembled[length] = c8'-';
        length = length + 1;
    }
    else if spec.showSign {
        assembled[length] = c8'+';
        length = length + 1;
    }
    if spec.alternate && spec.base != FormatBase::Decimal {
        assembled[length] = c8'0';
        assembled[length + 1] = spec.base == FormatBase::Binary ? c8'b' : (spec.base == FormatBase::Octal ? c8'o' : c8'x');
        length = length + 2;
    }
    if spec.zeroPad && spec.width > length + count && spec.width <= 160 {
        var zeros = spec.width - length - count;
        while zeros > 0 {
            assembled[length] = c8'0';
            length = length + 1;
            zeros = zeros - 1;
        }
    }
    var index = count;
    while index > 0 {
        index = index - 1;
        assembled[length] = digits[index];
        length = length + 1;
    }

    return WriteAligned(writer, spec, Slice<char8> { data: @assembled[0], length: length }, true);
}

/// Writes one character under `spec`'s width, fill and alignment.
///
/// https://rux-lang.dev/docs/api/format/format-scalar
func FormatScalar(writer: Writer, spec: FormatSpec, scalar: char32) -> TextError {
    var encoded: char8[4];
    var written: uint = 0;
    let sink = MutableSlice::From<char8>(@encoded[0], 4);
    if Encode(scalar, sink, @written).IsError() {
        return TextError::InvalidUtf8;
    }
    return WriteAligned(writer, spec, Slice<char8> { data: @encoded[0], length: written }, false);
}
