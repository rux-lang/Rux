// Reading a decimal float, and the failure every parser in this package reports.
//
// `ParseError` lives here because this is where it was first needed, and it now serves every width: the integers,
// the booleans, the characters and the wide floats all answer with it. Every case says where it was found, because
// a reason on its own leaves a caller re-reading its own input to guess. "Invalid character" is a different report
// from "invalid character at byte 7", and only the second lets anything underline what is wrong. The offsets are
// into the text as given, so a parser embedded in a larger grammar adds the offset of the token it was handed and
// the positions compose.
//
// `OutOfMemory` is a correction rather than an addition. The wide float parser builds exact big integers to round
// with, and every allocation those need used to be reported as `Overflow` — which told a caller their number was
// too large when the machine had simply run out of room. The two want different responses from a caller, so they
// are different cases.
//
// The grammar this file accepts is `[+-]?(digits[.digits?]?|.digits)([eE][+-]?digits)?`, plus the two special
// spellings `NaN` and `Inf` exactly as formatting writes them, so what one side prints the other reads.

import Core::{ Result, Unit };
import Text::{ ParseFailure, StringView };

/// Why text could not be read as a value.
///
/// Failure-only: every case is a failure, and each says where in the text it was found. Success is
/// `Result::Success` rather than a case here.
///
/// Copy, carrying one offset.
///
/// @see https://rux-lang.dev/docs/api/format/parse-error
pub variant ParseError {
    /// There were no bytes to read. The offset is zero, which is both the start of the text and its length.
    Empty,
    /// A byte that is not part of the grammar, or a well-formed value with something after it. The offset is that
    /// byte, which is the text's length when the value stopped short.
    InvalidCharacter(uint),
    /// The value is well formed and does not fit the width asked for. The offset is the digit that passed the
    /// widest representable magnitude, or the end of the number when the number itself is what does not fit.
    Overflow(uint),
    /// The exact arithmetic a wide float needs could not get the storage for it. This is the machine rather than
    /// the text: the same input on a less busy machine reads fine, which is what tells it apart from `Overflow`.
    /// The offset is where the parser had reached, which is the end of the number.
    OutOfMemory(uint)
}

extend ParseError : ParseFailure {
    /// Where in the input the failure was found.
    ///
    /// Borrows the error and leaves it untouched. Cannot fail; runs in constant time and allocates nothing.
    ///
    /// @returns the zero-based UTF-8 byte offset, which is the text's length at end of input
    /// @see https://rux-lang.dev/docs/api/format/parse-error/offset
    pub func Offset(self: &ParseError) -> uint {
        return match self {
            .Empty => 0u,
            .InvalidCharacter(at) => at,
            .Overflow(at) => at,
            .OutOfMemory(at) => at
        };
    }
}

/// What a decimal spells, before any format decides what to do with it.
///
/// Copy, holding the retained digits and the two flags the rounding needs.
///
/// @see https://rux-lang.dev/docs/api/format/decimal-reading
pub struct DecimalReading {
    /// The retained significant digits, as an integer.
    pub digits: FixedNat;
    /// The power of ten they are scaled by, counting the decimal point and any digits dropped past the bound.
    pub exponent: int;
    /// How many significant digits were retained.
    pub significant: uint;
    /// Whether a nonzero digit was dropped past the retained bound.
    pub truncated: bool;
    /// Whether the value is negative, including a negative zero.
    pub negative: bool;
    /// Zero for an ordinary number, one for `NaN`, two for an infinity.
    pub special: int;
}

/// Reads the decimal grammar out of `str`, without deciding what float it names.
///
/// One scanner for both narrow widths, so what one reads the other reads: the grammar is
/// `[+-]?(digits[.digits?]?|.digits)([eE][+-]?digits)?`, plus the two special spellings `NaN` and `Inf` exactly as
/// formatting writes them. The digits are kept exactly up to `RetainedDecimalDigits`, past which a nonzero one
/// sets `truncated` and moves the exponent instead.
///
/// # Failures
/// Reports `Empty` for no bytes, `InvalidCharacter` at the byte where the shape stopped matching, and
/// `OutOfMemory` where the retained digits would not fit the workspace.
///
/// @param str the text to read
/// @param reading receives what the decimal spells
/// @returns success when the whole text was the grammar
/// @see https://rux-lang.dev/docs/api/format/scan-decimal
pub func ScanDecimal(str: char8[..], reading: *var DecimalReading) -> Result<Unit, ParseError> {
    *reading = DecimalReading {
        digits: FixedNat(),
        exponent: 0,
        significant: 0,
        truncated: false,
        negative: false,
        special: 0
    };
    if str.length == 0 { return Result::Error<Unit, ParseError>(ParseError::Empty); }

    var index: uint = 0;
    if str[index] == c8'+' || str[index] == c8'-' {
        reading.negative = str[index] == c8'-';
        index++;
        if index == str.length { return Result::Error<Unit, ParseError>(ParseError::InvalidCharacter(index - 1)); }
    }

    // The two special spellings. A NaN has no sign to keep — the sign is accepted because formatting never writes
    // one and input may carry one, and there is only one NaN as far as comparison is concerned.
    if index + 3 == str.length && str[index] == c8'N' && str[index + 1] == c8'a' && str[index + 2] == c8'N' {
        reading.special = 1;
        return Result::Success<Unit, ParseError>(Unit());
    }
    if index + 3 == str.length && str[index] == c8'I' && str[index + 1] == c8'n' && str[index + 2] == c8'f' {
        reading.special = 2;
        return Result::Success<Unit, ParseError>(Unit());
    }

    // The significant digits are kept exactly, up to the bound past which a dropped digit can only mean "strictly
    // more than this" — see `RetainedDecimalDigits` for why the bound is where it is.
    var digitCount: uint = 0;
    var afterDecimalPoint = false;
    var significant = false;
    while index < str.length {
        let ch = str[index];
        if ch >= c8'0' && ch <= c8'9' {
            let digit = ((ch as uint) - (c8'0' as uint)) as uint64;
            digitCount++;
            if afterDecimalPoint {
                reading.exponent = reading.exponent - 1;
            }
            if digit != 0u64 || significant {
                significant = true;
                if reading.significant < RetainedDecimalDigits {
                    if !reading.digits.MultiplyAddSmall(10u64, digit) {
                        return Result::Error<Unit, ParseError>(ParseError::OutOfMemory(index));
                    }
                    reading.significant = reading.significant + 1u;
                }
                else {
                    if digit != 0u64 { reading.truncated = true; }
                    reading.exponent = reading.exponent + 1;
                }
            }
            index++;
            continue;
        }
        if ch == c8'.' && !afterDecimalPoint {
            afterDecimalPoint = true;
            index++;
            continue;
        }
        break;
    }
    if digitCount == 0u { return Result::Error<Unit, ParseError>(ParseError::InvalidCharacter(index)); }

    if index < str.length && (str[index] == c8'e' || str[index] == c8'E') {
        index++;
        let exponentMarker = index - 1;
        var exponentNegative = false;
        if index < str.length && (str[index] == c8'+' || str[index] == c8'-') {
            exponentNegative = str[index] == c8'-';
            index++;
        }
        if index == str.length || str[index] < c8'0' || str[index] > c8'9' {
            return Result::Error<Unit, ParseError>(ParseError::InvalidCharacter(exponentMarker));
        }
        var exponent: int = 0;
        while index < str.length && str[index] >= c8'0' && str[index] <= c8'9' {
            let digit = ((str[index] as uint) - (c8'0' as uint)) as int;
            // Ten thousand is past every format's range in both directions, so a longer exponent needs no more
            // arithmetic to be answered.
            if exponent < 10000 {
                exponent = exponent * 10 + digit;
            }
            index++;
        }
        if exponentNegative {
            reading.exponent = reading.exponent - exponent;
        }
        else {
            reading.exponent = reading.exponent + exponent;
        }
    }
    if index != str.length { return Result::Error<Unit, ParseError>(ParseError::InvalidCharacter(index)); }
    return Result::Success<Unit, ParseError>(Unit());
}

/// Reads `str` as the `float64` nearest what it spells, rounding to nearest with ties to even.
///
/// Exact: the value is formed as a ratio of integers and the quotient is taken with a sticky bit, so what comes
/// back is the nearest `float64` and never one step off it. `NaN`, `Inf` and `-Inf` are read exactly as formatting
/// writes them.
///
/// # Failures
/// Reports `Empty`, `InvalidCharacter` and `OutOfMemory` as `ScanDecimal` does, and `Overflow` at the text's
/// length for a value past the largest finite `float64` — refused rather than rounded to an infinity, since that
/// would turn a number the caller wrote into one they did not. A value below the smallest subnormal is the signed
/// zero it rounds to.
///
/// @param str the text to read
/// @returns the value, or why the text is not one
/// @see https://rux-lang.dev/docs/api/format/parse-float64
pub func ParseFloat64(str: char8[..]) -> Result<float64, ParseError> {
    var reading = DecimalReading {
        digits: FixedNat(),
        exponent: 0,
        significant: 0,
        truncated: false,
        negative: false,
        special: 0
    };
    let scanned = ScanDecimal(str, @reading);
    var failure = ParseError::Empty;
    if scanned.TryIntoError(@failure) { return Result::Error<float64, ParseError>(failure); }
    if reading.special == 1 { return Result::Success<float64, ParseError>(0.0 / 0.0); }
    if reading.special == 2 {
        return Result::Success<float64, ParseError>(reading.negative ? -1.0 / 0.0 : 1.0 / 0.0);
    }

    // Anything clearly past the format is answered without building the numbers that would say so exactly: the
    // value is at least ten to the magnitude less one and below ten to the magnitude, and both ends of the range
    // are far outside that.
    if !reading.digits.IsZero() {
        let magnitude = (reading.significant as int) + reading.exponent;
        if magnitude > 310 { return Result::Error<float64, ParseError>(ParseError::Overflow(str.length)); }
        if magnitude < -340 {
            return Result::Success<float64, ParseError>(reading.negative ? -0.0 : 0.0);
        }
    }

    var value = 0.0;
    var overflowed = false;
    if !ExactFloat64(reading.digits, reading.exponent, reading.truncated, reading.negative, @value, @overflowed) {
        if overflowed { return Result::Error<float64, ParseError>(ParseError::Overflow(str.length)); }
        return Result::Error<float64, ParseError>(ParseError::OutOfMemory(str.length));
    }
    return Result::Success<float64, ParseError>(value);
}

// Parses what a view spans, borrowing it. A view is the shape parsing wants: it copies nothing, owns
// nothing, and the bytes are known to be text.
/// Provides the public `ParseFloat64` operation.
///
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse-float64
pub func ParseFloat64(str: StringView) -> Result<float64, ParseError> {
    return ParseFloat64(str.Bytes());
}

/// Reads `str` as the `float32` nearest what it spells, rounding to nearest with ties to even.
///
/// Read at this width's own precision rather than at a `float64`'s and narrowed. Narrowing rounds a second time,
/// and a value that lands on a `float32` boundary can round the wrong way once it has already been rounded to
/// fifty-three bits on the way there.
///
/// # Failures
/// The failures `ParseFloat64` reports, at this width's range: `Overflow` for a value past the largest finite
/// `float32`, and the signed zero for one below the smallest subnormal.
///
/// @param str the text to read
/// @returns the value, or why the text is not one
/// @see https://rux-lang.dev/docs/api/format/parse-float32
pub func ParseFloat32(str: char8[..]) -> Result<float32, ParseError> {
    var reading = DecimalReading {
        digits: FixedNat(),
        exponent: 0,
        significant: 0,
        truncated: false,
        negative: false,
        special: 0
    };
    let scanned = ScanDecimal(str, @reading);
    var failure = ParseError::Empty;
    if scanned.TryIntoError(@failure) { return Result::Error<float32, ParseError>(failure); }
    if reading.special == 1 { return Result::Success<float32, ParseError>(0.0f32 / 0.0f32); }
    if reading.special == 2 {
        return Result::Success<float32, ParseError>(reading.negative ? -1.0f32 / 0.0f32 : 1.0f32 / 0.0f32);
    }

    if !reading.digits.IsZero() {
        let magnitude = (reading.significant as int) + reading.exponent;
        if magnitude > 41 { return Result::Error<float32, ParseError>(ParseError::Overflow(str.length)); }
        if magnitude < -50 {
            return Result::Success<float32, ParseError>(reading.negative ? -0.0f32 : 0.0f32);
        }
    }

    var value = 0.0f32;
    var overflowed = false;
    if !ExactFloat32(reading.digits, reading.exponent, reading.truncated, reading.negative, @value, @overflowed) {
        if overflowed { return Result::Error<float32, ParseError>(ParseError::Overflow(str.length)); }
        return Result::Error<float32, ParseError>(ParseError::OutOfMemory(str.length));
    }
    return Result::Success<float32, ParseError>(value);
}

/// The same grammar for a view.
///
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse-float32-view
pub func ParseFloat32(str: StringView) -> Result<float32, ParseError> {
    return ParseFloat32(str.Bytes());
}
