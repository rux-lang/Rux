import Core::Result;
import Text::StringView;

// Why a decimal string could not be converted to a float64.
/// The `ParseError` values exposed by this package.
///
/// https://rux-lang.dev/docs/api/format/parse-error
pub variant ParseError {
    Empty,
    InvalidCharacter(uint),
    Overflow
}

// Parses a decimal float. The accepted grammar is
// `[+-]?(digits[.digits?]?|.digits)([eE][+-]?digits)?`.
/// Provides the public `ParseFloat64` operation.
///
/// https://rux-lang.dev/docs/api/format/parse-float64
pub func ParseFloat64(str: Slice<char8>) -> Result<float64, ParseError> {
    if str.length == 0 { return Result::Error<float64, ParseError>(ParseError::Empty); }

    var index: uint = 0;
    var negative = false;
    if str[index] == c8'+' || str[index] == c8'-' {
        negative = str[index] == c8'-';
        index++;
        if index == str.length { return Result::Error<float64, ParseError>(ParseError::InvalidCharacter(index - 1)); }
    }

    // The two special spellings, exactly as formatting writes them, so what one side prints the other reads. A NaN
    // has no sign to keep -- the sign is accepted because formatting never writes one and input may carry one, and
    // there is only one NaN as far as comparison is concerned.
    if index + 3 == str.length && str[index] == c8'N' && str[index + 1] == c8'a' && str[index + 2] == c8'N' {
        return Result::Success<float64, ParseError>(0.0 / 0.0);
    }
    if index + 3 == str.length && str[index] == c8'I' && str[index + 1] == c8'n' && str[index + 2] == c8'f' {
        return Result::Success<float64, ParseError>(negative ? -1.0 / 0.0 : 1.0 / 0.0);
    }

    // Keep nineteen significant decimal digits. That is more precision than a
    // float64 can retain, while avoiding an overflowing intermediate value for
    // long input strings. decimalExponent accounts for the decimal point and
    // for significant digits omitted after the nineteenth.
    var value = 0.0;
    var significantDigits: uint = 0;
    var decimalExponent: int = 0;
    var digitCount: uint = 0;
    var afterDecimalPoint = false;
    var significant = false;

    while index < str.length {
        let ch = str[index];
        if ch >= c8'0' && ch <= c8'9' {
            let digit = (ch as uint) - (c8'0' as uint);
            digitCount++;

            if afterDecimalPoint {
                decimalExponent--;
            }
            if digit != 0u || significant {
                significant = true;
                if significantDigits < 19u {
                    value = value * 10.0 + digit as float64;
                    significantDigits++;
                } else {
                    decimalExponent++;
                }
            }
            index++;
            continue;
        }
        if ch == c8'.' && !afterDecimalPoint {
            afterDecimalPoint = true;
            index++;
            continue;
        }
        break;
    }

    if digitCount == 0u { return Result::Error<float64, ParseError>(ParseError::InvalidCharacter(index)); }

    if index < str.length && (str[index] == c8'e' || str[index] == c8'E') {
        index++;
        let exponentMarker = index - 1;
        var exponentNegative = false;
        if index < str.length && (str[index] == c8'+' || str[index] == c8'-') {
            exponentNegative = str[index] == c8'-';
            index++;
        }
        if index == str.length || str[index] < c8'0' || str[index] > c8'9' {
            return Result::Error<float64, ParseError>(ParseError::InvalidCharacter(exponentMarker));
        }

        var exponent: int = 0;
        while index < str.length && str[index] >= c8'0' && str[index] <= c8'9' {
            let digit = ((str[index] as uint) - (c8'0' as uint)) as int;
            if exponent < 10000 {
                exponent = exponent * 10 + digit;
            }
            index++;
        }
        if exponentNegative {
            decimalExponent -= exponent;
        } else {
            decimalExponent += exponent;
        }
    }

    if index != str.length { return Result::Error<float64, ParseError>(ParseError::InvalidCharacter(index)); }

    if value != 0.0 {
        if decimalExponent > 308 { return Result::Error<float64, ParseError>(ParseError::Overflow); }
        if decimalExponent < -400 {
            value = 0.0;
        } else {
            value = ScaleByPow10(value, decimalExponent);
            if IsInfinite(value) { return Result::Error<float64, ParseError>(ParseError::Overflow); }
        }
    }

    if negative {
        value = -value;
    }
    return Result::Success<float64, ParseError>(value);
}

// Parses what a view spans, borrowing it. A view is the shape parsing wants: it copies nothing, owns
// nothing, and the bytes are known to be text.
/// Provides the public `ParseFloat64` operation.
///
/// https://rux-lang.dev/docs/api/format/parse-float64
pub func ParseFloat64(str: StringView) -> Result<float64, ParseError> {
    return ParseFloat64(str.Bytes());
}

// Parses into value and reports only whether conversion succeeded. On failure,
// value is left unchanged. A null output pointer also reports failure.
/// Provides the public `TryParseFloat64` operation.
///
/// https://rux-lang.dev/docs/api/format/try-parse-float64
pub func TryParseFloat64(str: Slice<char8>, value: *var float64) -> bool {
    if value == null { return false; }

    match ParseFloat64(str) {
        .Success(parsed) => {
            *value = parsed;
            return true;
        },
        .Error(_) => {
            return false;
        }
    }
}

// The same for a view.
/// Provides the public `TryParseFloat64` operation.
///
/// https://rux-lang.dev/docs/api/format/try-parse-float64
pub func TryParseFloat64(str: StringView, value: *var float64) -> bool {
    return TryParseFloat64(str.Bytes(), value);
}

/// Parses a `float32` by the same grammar, reporting `Overflow` where the narrower width cannot hold the value.
///
/// The digits are read at `float64` precision and narrowed once at the end, so a value near the edge rounds the
/// way one conversion rounds rather than accumulating error per digit. A value that underflows `float32` comes
/// back as the zero it rounds to, exactly as a tiny value does at the wider width.
///
/// https://rux-lang.dev/docs/api/format/parse-float32
pub func ParseFloat32(str: Slice<char8>) -> Result<float32, ParseError> {
    var wide = 0.0;
    match ParseFloat64(str) {
        .Success(value) => {
            wide = value;
        },
        .Error(fault) => {
            return Result::Error<float32, ParseError>(fault);
        }
    }
    if IsFinite(wide) {
        let magnitude = wide < 0.0 ? -wide : wide;
        if magnitude > MaxFinite32 { return Result::Error<float32, ParseError>(ParseError::Overflow); }
    }
    return Result::Success<float32, ParseError>(wide as float32);
}

/// The same grammar for a view.
///
/// https://rux-lang.dev/docs/api/format/parse-float32-view
pub func ParseFloat32(str: StringView) -> Result<float32, ParseError> {
    return ParseFloat32(str.Bytes());
}
