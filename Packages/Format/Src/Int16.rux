// The decimal text of an `int16`.
//
// A negative value opens with a minus sign; a positive one carries no sign, since a sign that is always there is
// noise and one that is there on request belongs to the placeholder rather than the value.

import Core::{ Result, Unit };
import Text::{ Debug, Display, FormatError, FormatSpec, TextWriter };

extend int16 : Display {
    /// Writes this value's digits.
    ///
    /// Allocates nothing: the digits go into a buffer on the stack and reach the writer in one call.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/int16/write-display
    pub func WriteDisplay(self: *int16, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        let wide = *self as int64;
        // The magnitude is taken in uint64 rather than by negating in int64, because the most negative value has
        // no positive counterpart there.
        let negative = wide < 0i64;
        let magnitude = negative ? ~(wide as uint64) + 1u64 : wide as uint64;
        return WriteIntegerSpec(writer, spec, magnitude, negative);
    }
}

extend int16 : Debug {
    /// The same digits: a number reads the same whoever is looking.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/int16/write-debug
    pub func WriteDebug(self: *int16, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        return self.WriteDisplay(writer, spec);
    }
}
