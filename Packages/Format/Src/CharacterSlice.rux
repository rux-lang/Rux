// Character slices render their bytes directly, without conversion or copying. The caller supplies valid UTF-8
// when the result is intended as text; an arbitrary character slice carries no validity guarantee.
//
// `Debug` is where the two partings show. Text shown to a reader is its characters; text shown to somebody looking
// at a program is quoted, so that where it starts and stops is visible and an empty string is not invisible.
//
// Only `char8[..]` renders. `char16[..]` and `char32[..]` would each need a transcoding printer,
// and nothing yet asks for one.

import Core::{ Result, Unit };
import Text::{ Debug, Display, FormatError, FormatSpec, TextWriter };

extend char8[..] : Display {
    /// Writes this text.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/character-slice/write-display
    pub func WriteDisplay(self: &char8[..], writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        return WriteAligned(writer, spec, (self.data)[..self.length], false);
    }
}

extend char8[..] : Debug {
    /// Writes this text, quoted.
    ///
    /// The quotes are all that is added. Escaping the characters between them is a question about which of them
    /// need it, which is a Unicode question and belongs where the Unicode tables are.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/character-slice/write-debug
    pub func WriteDebug(self: &char8[..], writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        WriteAscii(writer, c8'"')?;
        self.WriteDisplay(writer, spec)?;
        return WriteAscii(writer, c8'"');
    }
}
