// The decimal text of a `uint32`.

import Text::TextError;

extend uint32 : Display {
    /// Writes this value's digits.
    ///
    /// Allocates nothing: the digits go into a buffer on the stack and reach the writer in one call.
    ///
    /// https://rux-lang.dev/docs/api/format/uint32/format
    func Format(self: *uint32, writer: TextWriter, spec: FormatSpec) -> TextError {
        return WriteIntegerSpec(writer, spec, *self as uint64, false);
    }
}

extend uint32 : Debug {
    /// The same digits.
    ///
    /// https://rux-lang.dev/docs/api/format/uint32/format-debug
    func FormatDebug(self: *uint32, writer: TextWriter, spec: FormatSpec) -> TextError {
        return self.Format(writer, spec);
    }
}
