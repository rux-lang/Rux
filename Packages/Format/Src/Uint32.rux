// The decimal text of a `uint32`.

import Text::{ Debug, Display, FormatError, FormatSpec, TextWriter };

extend uint32 : Display {
    /// Writes this value's digits.
    /// Allocates nothing: the digits go into a buffer on the stack and reach the writer in one call.
    /// Reports whatever the writer reported, stopping at the first refusal.
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/integer-text#uint32-write-display
    pub func WriteDisplay(self: &uint32, writer: &var TextWriter, spec: FormatSpec) -> ! FormatError {
        return WriteIntegerSpec(writer, spec, self as uint64, false);
    }
}

extend uint32 : Debug {
    /// The same digits.
    /// Reports whatever the writer reported, stopping at the first refusal.
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/integer-text#uint32-write-debug
    pub func WriteDebug(self: &uint32, writer: &var TextWriter, spec: FormatSpec) -> ! FormatError {
        return self.WriteDisplay(writer, spec);
    }
}
