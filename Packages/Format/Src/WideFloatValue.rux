// The four wide widths as values: the bits, the questions a caller asks of them, and their text.
//
// Each carries its bits in the narrowest integer that holds them, and answers `IsNan`, `IsInfinite`, `IsFinite`
// and `IsNegative` from the fields directly. `Display` and `Debug` render through the exact machinery in
// `WideDecimal`, which needs an allocator; the interface offers none, so those two use the system allocator, and
// `FormatWith` is there for a caller who wants to choose.

import Allocator::{ Allocator, SystemAllocator };
import Text::TextError;

/// An x87 extended-precision value, held as its eighty bits.
///
/// https://rux-lang.dev/docs/api/format/float80
pub struct Float80 {
    /// The bits, in the low eighty of a `uint128`; the top forty-eight are padding and stay zero.
    bits: uint128;
}

extend Float80 {
    /// The value these bits encode.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/from-bits
    pub func FromBits(bits: uint128) -> Float80 {
        return Float80 { bits: bits };
    }

    /// The bits.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/bits
    pub func Bits(self: &Float80) -> uint128 {
        return self.bits;
    }

    /// The format these bits are read under.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/layout
    pub func Layout() -> FloatLayout {
        return FloatLayout::Extended80();
    }

    func Class(self: &Float80) -> WideClass {
        let layout = FloatLayout::Extended80();
        return UnpackWide(self.bits as uint512, layout).class;
    }

    /// Whether this is not a number.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/is-nan
    pub func IsNan(self: &Float80) -> bool {
        return self.Class() == WideClass::NaN;
    }

    /// Whether this is an infinity of either sign.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/is-infinite
    pub func IsInfinite(self: &Float80) -> bool {
        return self.Class() == WideClass::Infinity;
    }

    /// Whether this is an ordinary value: neither a NaN nor an infinity.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/is-finite
    pub func IsFinite(self: &Float80) -> bool {
        let class = self.Class();
        return class != WideClass::NaN && class != WideClass::Infinity;
    }

    /// Whether the sign bit is set, which a negative zero answers yes to.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/is-negative
    pub func IsNegative(self: &Float80) -> bool {
        let layout = FloatLayout::Extended80();
        return UnpackWide(self.bits as uint512, layout).negative;
    }

    /// Writes this value's text under `spec`, taking the working storage from `allocator`.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/format-with
    pub func FormatWith(self: &Float80, allocator: Allocator, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        let layout = FloatLayout::Extended80();
        return WriteWideFloat(allocator, writer, spec, self.bits as uint512, layout);
    }
}

extend Float80 : Display {
    /// Writes this value's decimal text: the shortest that reads back as the same bits, or the digits a precision
    /// asks for.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/format
    pub func Format(self: &Float80, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        var system = SystemAllocator();
        let allocator: Allocator = system;
        return self.FormatWith(allocator, writer, spec);
    }
}

extend Float80 : Debug {
    /// The same text.
    ///
    /// https://rux-lang.dev/docs/api/format/float80/format-debug
    pub func FormatDebug(self: &Float80, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return self.Format(writer, spec);
    }
}

/// An IEEE binary128 value, held as its bits.
///
/// https://rux-lang.dev/docs/api/format/float128
pub struct Float128 {
    /// The bits, all hundred and twenty-eight of them.
    bits: uint128;
}

extend Float128 {
    /// The value these bits encode.
    ///
    /// https://rux-lang.dev/docs/api/format/float128/from-bits
    pub func FromBits(bits: uint128) -> Float128 {
