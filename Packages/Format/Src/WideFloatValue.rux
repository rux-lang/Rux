    /// https://rux-lang.dev/docs/api/format/float128/layout
    pub func Layout() -> FloatLayout {
        return FloatLayout::Binary128();
    }

    func Class(self: &Float128) -> WideClass {
        let layout = FloatLayout::Binary128();
        return UnpackWide(self.bits as uint512, layout).class;
    }

    /// Whether this is not a number.
    ///
    /// https://rux-lang.dev/docs/api/format/float128/is-nan
    pub func IsNan(self: &Float128) -> bool {
        return self.Class() == WideClass::NaN;
    }

    /// Whether this is an infinity of either sign.
