}

extend Float128 : Display {
    /// Writes this value's decimal text: the shortest that reads back as the same bits, or the digits a precision
    /// asks for.
    ///
    /// https://rux-lang.dev/docs/api/format/float128/format
    pub func Format(self: &Float128, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        var system = SystemAllocator();
        let allocator: Allocator = system;
        return self.FormatWith(allocator, writer, spec);
    }
}

extend Float128 : Debug {
    /// The same text.
    ///
    /// https://rux-lang.dev/docs/api/format/float128/format-debug
    pub func FormatDebug(self: &Float128, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return self.Format(writer, spec);
    }
}

