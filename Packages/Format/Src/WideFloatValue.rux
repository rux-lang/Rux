    /// https://rux-lang.dev/docs/api/format/float128/format-with
    pub func FormatWith(self: &Float128, allocator: Allocator, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        let layout = FloatLayout::Binary128();
        return WriteWideFloat(allocator, writer, spec, self.bits as uint512, layout);
