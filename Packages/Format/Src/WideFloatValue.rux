    /// @param bits the value's bit pattern
    /// @returns the value that bit pattern stands for
    /// @see https://rux-lang.dev/docs/api/format/float512/from-bits
    pub func FromBits(bits: uint512) -> Float512 {
        return Float512 { bits: bits };
    }

    /// The bits.
    ///
    /// @returns the value's bit pattern
    /// @see https://rux-lang.dev/docs/api/format/float512/bits
    pub func Bits(self: &Float512) -> uint512 {
        return self.bits;
    }

    /// The format these bits are read under.
    ///
    /// @returns which format the bits are in
    /// @see https://rux-lang.dev/docs/api/format/float512/layout
    pub func Layout() -> FloatLayout {
        return FloatLayout::Binary512();
    }

    func Class(self: &Float512) -> WideClass {
        let layout = FloatLayout::Binary512();
        return UnpackWide(self.bits as uint512, layout).class;
    }

    /// Whether this is not a number.
    ///
    /// @returns whether the value is a NaN
    /// @see https://rux-lang.dev/docs/api/format/float512/is-nan
    pub func IsNan(self: &Float512) -> bool {
        return self.Class() == WideClass::NaN;
    }

    /// Whether this is an infinity of either sign.
