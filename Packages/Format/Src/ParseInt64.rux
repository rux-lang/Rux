import Core::string;
import Core::{ Result, Slice };
import Text::StringView;

// Parses into value and reports only whether conversion succeeded. On failure,
// value is left unchanged. A null output pointer also reports failure.
/// Provides the public `TryParseInt64` operation.
///
/// https://rux-lang.dev/docs/api/format/try-parse-int64
pub func TryParseInt64(str: Slice<char8>, value: *var int64) -> bool {
    if value == null { return false; }

    match ParseInt64(str) {
        .Success(parsed) => {
            *value = parsed;
            return true;
        },
        .Error(_) => {
            return false;
        }
    }
}

// The same for a view, which is what a caller holding text has.
/// Provides the public `TryParseInt64` operation.
///
/// https://rux-lang.dev/docs/api/format/try-parse-int64
pub func TryParseInt64(str: StringView, value: *var int64) -> bool {
    return TryParseInt64(str.Bytes(), value);
}

/// The same grammar for text, which is what a caller holding a string literal has.
///
/// https://rux-lang.dev/docs/api/format/try-parse-int64-text
pub func TryParseInt64(str: string, value: *var int64) -> bool {
    return TryParseInt64(Slice<char8> { data: str.data, length: str.length }, value);
}
