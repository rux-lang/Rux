// Decimal digits for a wide float, exactly.
// The shortest rendering that reads back as the same value is found the way Steele and White, and then Burger and
// Dybvig, described it: keep the exact value as a ratio of big integers, keep the exact distance to each
// neighbouring float beside it, and generate digits until the digits so far sit closer to the value than to either
// neighbour. Nothing is approximated, which is why it is correct at every width the same way, and why the numbers
// involved are as large as the exponent makes them.
// Fixed precision is the same machinery stopped at a chosen digit, with the remainder rounded to nearest and ties
// to the even digit.
// Both generators can fail two ways, and they say which. The allocator can refuse the working storage, which is
// the machine rather than the value and may go differently on a second attempt; or the caller's digit buffer can
// be too small for what the value needs, which will go the same way every time. Reporting both as one used to
// tell a caller they were out of memory when their buffer was short — the same confusion the wide parser had
// between an allocation failure and an overflow, and wrong for the same reason.

import Allocator::Allocator;

// Why a wide digit generator stopped: the allocator refused, or the digits did not fit the buffer it was given.
enum WideDigitFailure: int32 {
    None = 0,
    OutOfMemory = 1,
    BufferTooSmall = 2
}


// The digits of `value`, as few as read back to the same bits, written into `digits`. `exponent10` receives the
// power of ten of the first digit, so the value is d.ddd times ten to it. `failure` says which of the two ways it
// stopped, and nothing is partially written either way. `count`, `exponent10` and `failure` must be non-null and
// writable.
func ShortestWideDigits(allocator: Allocator, value: &UnpackedWide, layout: &FloatLayout, digits: var char8[..],
                        count: *var uint, exponent10: *var int, failure: *var WideDigitFailure) -> bool {
    // Safety: the documented contract makes `failure` a non-null pointer to the caller's writable
    // `WideDigitFailure`.
    unsafe { *failure = WideDigitFailure::OutOfMemory; }
    let f = value.significand;
    let e = value.exponent;
    let leading = 1u512 << (layout.precision - 1);
    // A value at the bottom of its binade has a closer neighbour below than above, so the two margins differ; the
    // doubling keeps every quantity an integer.
    let lonely = f == leading && e > layout.MinimumExponent();
    let even = (f & 1) == 0;

    var r = BigNat(allocator);
    var s = BigNat(allocator);
    var high = BigNat(allocator);
    var low = BigNat(allocator);
    var tmp = BigNat(allocator);
    var base = BigNat(allocator);
    var scratch = BigNat(allocator);
    if !r.SetWide(f) || !high.SetSmall(1) || !low.SetSmall(1) { return false; }
    if e >= 0 {
        let shift = e as uint;
        if !r.ShiftLeft(shift + (if lonely { 2u } else { 1u })) || !s.SetSmall(if lonely { 4u64 } else { 2u64 }) ||
            !high.ShiftLeft(shift + (if lonely { 1u } else { 0u })) || !low.ShiftLeft(shift) {
            return false;
        }
    }
    else {
        let shift = (0 - e) as uint;
        if !r.ShiftLeft(if lonely {
            2u
        } else {
            1u
        }) || !s.SetSmall(1) || !s.ShiftLeft(shift + (if lonely { 2u } else { 1u })) {
            return false;
        }
        if lonely && !high.ShiftLeft(1) { return false; }
    }

    // Where the first digit goes, estimated from the bit length and corrected below in whichever direction the
    // estimate missed.
    let magnitude = (e as int64) + (BitLengthOf(f) as int64) - 1;
    var k = ((magnitude * 30103) / 100000) as int + 1;
    if magnitude < 0 {
        k = k - 1;
    }
    if k >= 0 {
        if !SetPowerOfTen(tmp, k as uint, base, scratch) || !scratch.SetProduct(s, tmp) || !s.Assign(scratch) {
            return false;
        }
    }
    else {
        if !SetPowerOfTen(tmp, (0 - k) as uint, base, scratch) || !scratch.SetProduct(r, tmp) ||
            !r.Assign(scratch) || !scratch.SetProduct(high, tmp) || !high.Assign(scratch) ||
            !scratch.SetProduct(low, tmp) || !low.Assign(scratch) {
            return false;
        }
    }
    // Too low: the upper edge of the rounding interval reaches the next power of ten.
    while true {
        if !tmp.Assign(r) || !tmp.Add(high) { return false; }
        let reaches = if even { tmp.Compare(s) >= 0 } else { tmp.Compare(s) > 0 };
        if !reaches { break; }
        if !s.MultiplySmall(10) { return false; }
        k = k + 1;
    }
    // Too high: even the upper edge falls short of the previous power of ten, so the first digit would be zero.
    while true {
        if !tmp.Assign(r) || !tmp.Add(high) || !tmp.MultiplySmall(10) { return false; }
        let short = if even { tmp.Compare(s) < 0 } else { tmp.Compare(s) <= 0 };
        if !short { break; }
        if !r.MultiplySmall(10) || !high.MultiplySmall(10) || !low.MultiplySmall(10) { return false; }
        k = k - 1;
    }

    var produced: uint = 0;
    while true {
        if produced >= digits.length {
            // Safety: the documented contract makes `failure` a non-null pointer to the caller's writable
            // `WideDigitFailure`.
            unsafe { *failure = WideDigitFailure::BufferTooSmall; }
            return false;
        }
        if !r.MultiplySmall(10) || !high.MultiplySmall(10) || !low.MultiplySmall(10) { return false; }
        var digit = r.TakeDigit(s);
        let withinLow = if even { r.Compare(low) <= 0 } else { r.Compare(low) < 0 };
        if !tmp.Assign(r) || !tmp.Add(high) { return false; }
        let withinHigh = if even { tmp.Compare(s) >= 0 } else { tmp.Compare(s) > 0 };
        if withinLow && withinHigh {
            // Both the digit and the one above read back correctly; the closer one wins, and a dead heat goes
            // to the even digit so that the choice is at least a rule.
            if !tmp.Assign(r) || !tmp.ShiftLeft(1) { return false; }
            let order = tmp.Compare(s);
            if order > 0 || (order == 0 && (digit & 1) == 1) {
                digit = digit + 1;
            }
        }
        else if withinHigh {
            digit = digit + 1;
        }
        // Safety: `produced` is below `digits.length`, checked at the top of the loop.
        unsafe { digits.data[produced] = (digit as uint8 + 0x30) as char8; }
        produced = produced + 1;
        if withinLow || withinHigh { break; }
    }
    // Safety: the documented contract makes `count`, `exponent10` and `failure` non-null pointers to the caller's
    // writable values.
    unsafe {
        *count = produced;
        *exponent10 = k - 1;
        *failure = WideDigitFailure::None;
    }
    return true;
}

// How many bits a 512-bit value needs.
func BitLengthOf(value: uint512) -> uint {
    var rest = value;
    var bits: uint = 0;
    while rest != 0 {
        rest = rest >> 1;
        bits = bits + 1;
    }
    return bits;
}

// The digits of `value` rounded to `fraction` places after the point, integer digits first. `exponent10` receives
// the power of ten of the first digit as for the shortest form; a value that rounds all the way to zero reports
// no digits at all. `failure` says which of the two ways it stopped. `count`, `exponent10` and `failure` must be
// non-null and writable.
func FixedWideDigits(allocator: Allocator, value: &UnpackedWide, layout: &FloatLayout, fraction: uint,
                     digits: var char8[..], count: *var uint, exponent10: *var int,
                     failure: *var WideDigitFailure) -> bool {
    // Safety: the documented contract makes `failure` a non-null pointer to the caller's writable
    // `WideDigitFailure`.
    unsafe { *failure = WideDigitFailure::OutOfMemory; }
    var r = BigNat(allocator);
    var s = BigNat(allocator);
    var tmp = BigNat(allocator);
    var base = BigNat(allocator);
    var scratch = BigNat(allocator);
    if !r.SetWide(value.significand) || !s.SetSmall(1) { return false; }
    if value.exponent >= 0 {
        if !r.ShiftLeft(value.exponent as uint) { return false; }
    }
    else if !s.ShiftLeft((0 - value.exponent) as uint) {
        return false;
    }
    let magnitude = (value.exponent as int64) + (BitLengthOf(value.significand) as int64) - 1;
    var k = ((magnitude * 30103) / 100000) as int + 1;
    if magnitude < 0 {
        k = k - 1;
    }
    if k >= 0 {
        if !SetPowerOfTen(tmp, k as uint, base, scratch) || !scratch.SetProduct(s, tmp) || !s.Assign(scratch) {
            return false;
        }
    }
    else if !SetPowerOfTen(tmp, (0 - k) as uint, base, scratch) || !scratch.SetProduct(r, tmp) ||
             !r.Assign(scratch) {
        return false;
    }
    // Settle on r/s in [1/10, 1), so that the value is 0.d1d2... times ten to the k.
    while r.Compare(s) >= 0 {
        if !s.MultiplySmall(10) { return false; }
        k = k + 1;
    }
    while true {
        if !tmp.Assign(r) || !tmp.MultiplySmall(10) { return false; }
        if tmp.Compare(s) >= 0 { break; }
        if !r.MultiplySmall(10) { return false; }
        k = k - 1;
    }

    let wanted = k + fraction as int;
    // Safety: the documented contract makes `exponent10` a non-null pointer to the caller's writable `int`.
    unsafe { *exponent10 = k - 1; }
    if wanted < 0 {
        // Below half a unit in the last place asked for, so every digit is a zero.
        // Safety: the documented contract makes `count`, `exponent10` and `failure` non-null pointers to the caller's
        // writable values.
        unsafe {
            *count = 0;
            *failure = WideDigitFailure::None;
        }
        return true;
    }
    if wanted == 0 {
        // Between a tenth and one unit in the last place: it is that unit, or nothing.
        if !tmp.Assign(r) || !tmp.ShiftLeft(1) { return false; }
        if tmp.Compare(s) > 0 {
            digits[0] = c8'1';
            // Safety: the documented contract makes `count`, `exponent10` and `failure` non-null pointers to the
            // caller's writable values.
            unsafe {
                *count = 1;
                *exponent10 = 0 - fraction as int;
                *failure = WideDigitFailure::None;
            }
            return true;
        }
        // Safety: the documented contract makes `count`, `exponent10` and `failure` non-null pointers to the caller's
        // writable values.
        unsafe {
            *count = 0;
            *failure = WideDigitFailure::None;
        }
        return true;
    }
    let needed = wanted as uint;
    if needed + 1 > digits.length {
        // Safety: the documented contract makes `failure` a non-null pointer to the caller's writable
        // `WideDigitFailure`.
        unsafe { *failure = WideDigitFailure::BufferTooSmall; }
        return false;
    }
    var produced: uint = 0;
    while produced < needed {
        if !r.MultiplySmall(10) { return false; }
        let digit = (r.TakeDigit(s) as uint8 + 0x30) as char8;
        // Safety: `produced` is below `needed`, the loop condition, and `needed + 1` is at most `digits.length`,
        // checked above.
        unsafe { digits.data[produced] = digit; }
        produced = produced + 1;
    }
    // What is left decides the last digit: over half rounds up, under half rounds down, and exactly half goes to
    // the even digit.
    if !tmp.Assign(r) || !tmp.ShiftLeft(1) { return false; }
    let order = tmp.Compare(s);
    // Safety: `needed` is positive (`wanted` is above zero here) and `needed + 1` is at most `digits.length`.
    let lastOdd = ((unsafe { digits.data[needed - 1] } as uint8) & 1) == 1;
    if order > 0 || (order == 0 && lastOdd) {
        var index = needed;
        var carried = true;
        while carried && index > 0 {
            index = index - 1;
            // Safety: `index` only falls from `needed`, and `needed + 1` is at most `digits.length`, checked above.
            let current = unsafe { digits.data[index] };
            if current == c8'9' {
                // Safety: the same `index`, below `needed`, which is below `digits.length`.
                unsafe { digits.data[index] = c8'0'; }
            }
            else {
                // Safety: the same `index`, below `needed`, which is below `digits.length`.
                unsafe { digits.data[index] = ((current as uint8) + 1) as char8; }
                carried = false;
            }
        }
        if carried {
            // The carry ran off the front: the value became the next power of ten, one digit longer.
            var shift = needed;
            while shift > 0 {
                // Safety: `shift` is at most `needed`, and `needed + 1` is at most `digits.length`, checked above,
                // so both `shift` and `shift - 1` lie inside `digits`.
                unsafe { digits.data[shift] = digits.data[shift - 1]; }
                shift = shift - 1;
            }
            // Safety: `needed + 1` is at most `digits.length`, so `digits` is not empty; the documented contract
            // makes `exponent10` a non-null pointer to the caller's writable `int`.
            unsafe {
                digits.data[0] = c8'1';
                *exponent10 = k;
            }
            produced = produced + 1;
        }
    }
    // Safety: the documented contract makes `count` and `failure` non-null pointers to the caller's writable values.
    unsafe {
        *count = produced;
        *failure = WideDigitFailure::None;
    }
    return true;
}
