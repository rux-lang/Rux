// Parsing the two values whose text is a word or a character rather than digits.
// A boolean is exactly `true` or `false` — not `True`, not `1`, not `yes`. Every widening of that set has to
// choose which spellings count, and the choice differs by language and context; a caller wanting one applies it
// before parsing, where the choice is visible.
// A character is exactly one scalar value's encoding, whole: an empty string is not a character, and neither are
// two of them.

import Text::{ DecodeAt, StringView };

/// Parses `true` or `false`, exactly.
/// Reports `Empty` for no bytes and `InvalidCharacter` at the start for anything else, including a correct word
/// with trailing bytes.
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse#parse-bool
pub func ParseBool(str: char8[..]) -> bool throws ParseError {
    if str.length == 0 { throw ParseError::Empty; }
    let text = StringView::FromValidated(str);
    let yes = StringView::FromValidated("true");
    let no = StringView::FromValidated("false");
    if text.Equals(yes) { return true; }
    if text.Equals(no) { return false; }
    throw ParseError::InvalidCharacter(0);
}

/// The same words for a view.
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse#parse-bool
pub func ParseBool(str: StringView) -> bool throws ParseError {
    return try ParseBool(str.Bytes());
}

/// Parses exactly one character.
/// Reports `Empty` for no bytes, and `InvalidCharacter` for bytes that are not one whole scalar value — ill-formed
/// UTF-8 at zero, a second character at its own index.
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse#parse-char
pub func ParseChar(str: char8[..]) -> char32 throws ParseError {
    if str.length == 0 { throw ParseError::Empty; }
    var scalar = 0u32 as char32;
    var width: uint = 0;
    let decoded = try DecodeAt(str, 0) catch { _ => throw ParseError::InvalidCharacter(0) };
    scalar = decoded.scalar;
    width = decoded.width;
    if width != str.length { throw ParseError::InvalidCharacter(width); }
    return scalar;
}

/// The same single character for a view.
/// @param str the text to parse
/// @returns the value, or the failure and the byte offset it was found at
/// @see https://rux-lang.dev/docs/api/format/parse#parse-char
pub func ParseChar(str: StringView) -> char32 throws ParseError {
    return try ParseChar(str.Bytes());
}
