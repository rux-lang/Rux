// Filling placeholders in a run of text.
//
// `{}` takes the next argument, in the order they are written; `{:spec}` carries a specification, parsed once by
// Text and applied by the value; `{{` and `}}` are how a literal brace is spelled. That is the whole grammar, and
// anything else containing a brace is a mistake in the pattern rather than text to copy through.
//
// Strictness is the decision this file rests on, and it replaces two lenient behaviours that used to live here. A
// placeholder with no argument left used to render as nothing, and a specification that did not parse used to be
// copied through as literal text. Both reported the mistake by printing it, which is the worst of the options: the
// program carries on, the output is wrong in a way that looks deliberate, and the caller finds out from a reader.
// Both are now failures — `ArgumentCountMismatch` and `InvalidSpecification` — and both are found before anything
// is written, so a pattern that is wrong produces no output at all rather than a prefix of one.
//
// Finding them first is why the pattern is walked twice. The first pass validates: it counts the placeholders,
// parses every specification, and rejects a brace that is not part of the grammar, without touching the
// destination. The second pass writes. A pattern is small and the parse is a few comparisons per placeholder, so
// the cost is the price of never emitting half a rendering of a pattern that was never going to work.
//
// Arguments arrive as `Display`, so each one writes itself into the destination directly. Nothing is rendered into
// a string on the way, which is what keeps the allocation count at what the result itself needs.

import Allocator::Allocator;
import Core::{ Result, Unit };
import Text::{ DecodeAt, Display, FormatError, FormatOk, FormatSpec, ParseFormatSpec, String, StringBuilder,
               TextFailureKind, TextFailureOf, TextWriter, Utf8Error, WriteAscii, WriteBytes };

// Where a placeholder's specification begins and ends inside the pattern, and where the placeholder itself does.
//
// `body` is the half-open range of the specification's bytes, empty for a bare `{}`. `after` is the byte just past
// the closing brace, which is where scanning resumes.
struct Placeholder {
    bodyStart: uint;
    bodyEnd: uint;
    after: uint;
}

// Reads the placeholder opening at `at`, where `format[at]` is a `{` that is not part of a `{{`.
func ReadPlaceholder(format: char8[..], at: uint) -> Result<Placeholder, FormatError> {
    var close = at + 1;
    while close < format.length && format[close] != c8'}' {
        close = close + 1;
    }
    if close >= format.length {
        // An opening brace with no closing one. The offset is the brace, which is where the pattern went wrong,
        // not where the scan gave up.
        return Result::Error<Placeholder, FormatError>(FormatError::InvalidSpecification(at));
    }
    if close == at + 1 {
        return Result::Success<Placeholder, FormatError>(Placeholder { bodyStart: close, bodyEnd: close, after: close + 1 });
    }
    if format[at + 1] != c8':' {
        // Anything between the braces has to open with a colon. Positional and named arguments are not part of
        // this grammar, so `{0}` and `{name}` are mistakes rather than requests, and the offset is the first
        // character that is not one.
        return Result::Error<Placeholder, FormatError>(FormatError::InvalidSpecification(at + 1));
    }
    return Result::Success<Placeholder, FormatError>(Placeholder { bodyStart: at + 2, bodyEnd: close, after: close + 1 });
}

// Parses the specification a placeholder carries, translating the parser's offset into an offset into the pattern.
//
// The parser reports where it stopped inside the body it was given; a caller reading the failure is looking at the
// whole pattern, so the body's own start is added. That is the composition rule `ParseFailure` states, applied at
// the one place in this package that embeds another parser.
func ReadSpecification(format: char8[..], found: Placeholder) -> Result<FormatSpec, FormatError> {
    if found.bodyEnd == found.bodyStart {
        return Result::Success<FormatSpec, FormatError>(FormatSpec::Plain());
    }
    let body = (@format.data[found.bodyStart])[..found.bodyEnd - found.bodyStart];
    return match ParseFormatSpec(body) {
        .Success(value) => Result::Success<FormatSpec, FormatError>(value),
        .Error(reason) => Result::Error<FormatSpec, FormatError>(match reason {
            .InvalidSpecification(offset) => FormatError::InvalidSpecification(found.bodyStart + offset),
            else => reason
        })
    };
}

// Walks the pattern without writing, counting its placeholders and rejecting every brace the grammar does not
// allow. This is what lets a failed pattern leave the destination untouched.
func ValidatePattern(format: char8[..]) -> Result<uint, FormatError> {
    var placeholders: uint = 0;
    var index: uint = 0;
    while index < format.length {
        let ch = format[index];
        let paired = index + 1 < format.length;
        if ch == c8'{' && paired && format[index + 1] == c8'{' {
            index = index + 2;
            continue;
        }
        if ch == c8'}' {
            if paired && format[index + 1] == c8'}' {
                index = index + 2;
                continue;
            }
            // A closing brace that no placeholder opened. It is written `}}` when it is meant, so one on its own is
            // as much a mistake as an unterminated `{`.
            return Result::Error<uint, FormatError>(FormatError::InvalidSpecification(index));
        }
        if ch == c8'{' {
            let found = ReadPlaceholder(format, index)?;
            ReadSpecification(format, found)?;
            placeholders = placeholders + 1;
            index = found.after;
            continue;
        }
        index = index + 1;
    }
    return Result::Success<uint, FormatError>(placeholders);
}

/// Writes `format` into `writer`, with each `{}` replaced by the next argument.
///
/// A placeholder is `{}`, or `{:spec}` carrying fill, alignment, sign, width, precision and style — see
/// `ParseFormatSpec` for the grammar. `{{` and `}}` stand for a literal brace, and are the only way to write one.
///
/// The pattern is checked before any of it is written, so a pattern that is wrong produces no output rather than a
/// prefix of one. What is checked is the pattern and the argument count, both of which are known at the call site;
/// a value's own rendering can still fail partway, and what it managed to write stays written.
///
/// # Failures
/// Reports `InvalidSpecification` with the byte offset into `format` for a specification that does not parse, a
/// brace the grammar does not allow, or a placeholder with no closing brace; `ArgumentCountMismatch` with the
/// placeholders counted and the arguments supplied when the two differ; and otherwise whatever the destination or
/// a value's own renderer reported, stopping at the first refusal. The first two are found before anything is
/// written.
///
/// @param writer the destination
/// @param format the pattern to write
/// @returns success when the whole pattern and every argument were accepted
/// @see https://rux-lang.dev/docs/api/format/write-format
pub func WriteFormat(writer: &var TextWriter, format: char8[..], args: Display...) -> Result<Unit, FormatError> {
    let expected = ValidatePattern(format)?;
    if expected != args.length {
        return Result::Error<Unit, FormatError>(FormatError::ArgumentCountMismatch(expected, args.length));
    }

    // The argument the next placeholder takes. Placeholders are filled in the order they are written, so this only
    // ever moves forward, and the validation pass has already established there are exactly enough.
    var next: uint = 0;
    var index: uint = 0;
    while index < format.length {
        let ch = format[index];
        if ch == c8'{' && index + 1 < format.length && format[index + 1] == c8'{' {
            WriteAscii(writer, c8'{')?;
            index = index + 2;
            continue;
        }
        if ch == c8'}' {
            // Validation established that every closing brace here is the first of a `}}`, so there is a second.
            WriteAscii(writer, c8'}')?;
            index = index + 2;
            continue;
        }
        if ch == c8'{' {
            // The two reads cannot fail, since the same walk already succeeded above; the failure paths stay
            // written out rather than discarded, so a future change to one pass cannot silently diverge from the
            // other.
            let found = ReadPlaceholder(format, index)?;
            let spec = ReadSpecification(format, found)?;
            args[next].WriteDisplay(writer, spec)?;
            next = next + 1;
            index = found.after;
            continue;
        }
        if (ch as uint32) < 0x80u32 {
            WriteAscii(writer, ch)?;
            index += 1u;
        } else {
            // Writers accept complete UTF-8 characters. Passing each byte through WriteAscii rejects valid text.
            var scalar: char32 = c32'\0';
            var width = 0u;
            if DecodeAt(format, index, @scalar, @width) != Utf8Error::None {
                return Result::Error<Unit, FormatError>(FormatError::TextFailure(TextFailureKind::InvalidUtf8));
            }
            WriteBytes(writer, (@format.data[index])[..width])?;
            index += width;
        }
    }
    return FormatOk();
}

/// The text `format` becomes with its placeholders filled, as a string of its own.
///
/// This is the allocating entry point, and the only one: every other way of rendering writes into a destination the
/// caller already has. Reserving up front is a guess at the result's size — the literal text plus a little for each
/// argument — so a short call fills in without a reallocation and a long one grows through the builder as usual.
///
/// It is named for what it does rather than for the package, because `Format(allocator, ...)` read as a noun and a
/// namespace at once and said nothing about producing a value.
///
/// # Failures
/// Reports `TextFailure(OutOfMemory)` when the initial reservation fails, and otherwise whatever `WriteFormat`
/// reported. On failure the partially built string is released rather than returned, so a caller never receives
/// half a rendering that looks whole and the allocator gets its block back either way.
///
/// @param allocator what the returned string is built with and will give its block back to
/// @param format the pattern to render
/// @returns the rendered string, or why it could not be produced
/// @see https://rux-lang.dev/docs/api/format/render
pub func Render(allocator: Allocator, format: char8[..], args: Display...) -> Result<String, FormatError> {
    var builder = StringBuilder(allocator);
    let reserved = builder.Reserve(format.length + args.length * 8);
    if reserved.IsError() {
        return Result::Error<String, FormatError>(FormatError::TextFailure(TextFailureOf(reserved)));
    }
    let sink: &var TextWriter = builder;
    WriteFormat(sink, format, args...)?;
    return Result::Success<String, FormatError>(builder.IntoString());
}
