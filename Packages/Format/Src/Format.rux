// Filling placeholders in a run of text.
//
// `{}` takes the next argument, in the order they are written; `{{` and `}}` are how a literal brace is spelled.
// There is nothing else yet: width, alignment, precision and base are a specification inside the braces, which is a
// separate piece of work and belongs to the placeholder rather than to the value.
//
// Arguments arrive as `Display`, so each one writes itself into the builder directly. Nothing is rendered into a
// string on the way, which is the difference from the old shape: formatting six values allocated six blocks and
// copied out of each of them, and now it allocates only what the result itself needs.

import Allocator::Allocator;
import Core::Slice;
import Text::{ String, StringBuilder, TextError };

/// Writes `format` into `writer`, with each `{}` replaced by the next argument.
///
/// A placeholder is `{}`, or `{:spec}` carrying fill, alignment, sign, width, precision and base -- see
/// `ParseFormatSpec` for the grammar. One with no argument left is written as nothing rather than refused, and one
/// whose spec does not parse is literal text, so either mistake shows where it was written instead of failing at
/// the point of printing, which is usually where it can least be handled. `{{` and `}}` stand for a literal brace.
///
/// Reports whatever the writer reported, having written what it managed to first.
///
/// https://rux-lang.dev/docs/api/format/write-format
func WriteFormat(writer: TextWriter, format: Slice<char8>, args: Display...) -> TextError {
    // The argument the next placeholder takes. Placeholders are filled in the order they are written, so this only
    // ever moves forward.
    var next: uint = 0;
    var index: uint = 0;
    while index < format.length {
        let ch = format[index];
        let paired = index + 1 < format.length;
        if ch == c8'{' && paired && format[index + 1] == c8'{' {
            let written = WriteAscii(writer, c8'{');
            if written.IsError() {
                return written;
            }
            index += 2;
            continue;
        }
        if ch == c8'}' && paired && format[index + 1] == c8'}' {
            let written = WriteAscii(writer, c8'}');
            if written.IsError() {
                return written;
            }
            index += 2;
            continue;
        }
        if ch == c8'{' && paired && format[index + 1] != c8'{' {
            // A placeholder runs to the closing brace. `{}` asks for nothing; `{:spec}` asks for what the spec
            // says; anything else -- no closing brace, or a spec that does not parse -- is literal text, so the
            // mistake shows where it was written.
            var close = index + 1;
            while close < format.length && format[close] != c8'}' {
                close++;
            }
            var spec = FormatSpec::Plain();
            var placeholder = close < format.length;
            if placeholder && close > index + 1 {
                if format[index + 1] == c8':' {
                    let body = Slice<char8> { data: @format.data[index + 2], length: close - index - 2 };
                    placeholder = ParseFormatSpec(body, @spec);
                }
                else {
                    placeholder = false;
                }
            }
            if placeholder {
                if next < args.length {
                    let written = args[next].Format(writer, spec);
                    if written.IsError() {
                        return written;
                    }
                    next++;
                }
                index = close + 1;
                continue;
            }
        }
        let written = WriteAscii(writer, ch);
        if written.IsError() {
            return written;
        }
        index++;
    }
    return TextError::None;
}

/// The text `format` becomes with its placeholders filled, as a string of its own.
///
/// `allocator` is what the string is built with and what it will give its block back to. `error` receives what went
/// wrong, and the string comes back holding whatever was written before that.
///
/// https://rux-lang.dev/docs/api/format/format
func Format(allocator: Allocator, format: Slice<char8>, error: *var TextError, args: Display...) -> String {
    var builder = StringBuilder::New(allocator);
    // The literal text, plus a little for each argument. Too small a guess costs a reallocation, which is what the
    // builder is there to absorb; the short calls that most of them are fill in without one.
    *error = builder.Reserve(format.length + args.length * 8);
    if error.IsError() {
        return builder.IntoString();
    }
    let writer: TextWriter = BuilderWriter::Of(@builder);
    *error = WriteFormat(writer, format, args...);
    return builder.IntoString();
}
