// A `bool16` is the word `true` or the word `false`.
//
// Lower case, unquoted, and the same for `Debug`: there is no second way to read a boolean.

import Text::TextError;

extend bool16 : Display {
    /// Writes `true` or `false`.
    ///
    /// https://rux-lang.dev/docs/api/format/bool16/format
    pub func Format(self: *bool16, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return WriteAligned(writer, spec, *self ? "true" : "false", false);
    }
}

extend bool16 : Debug {
    /// The same two words.
    ///
    /// https://rux-lang.dev/docs/api/format/bool16/format-debug
    pub func FormatDebug(self: *bool16, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        return self.Format(writer, spec);
    }
}
