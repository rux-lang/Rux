// A `char16` holds one UTF-16 code unit, which is one to three bytes of UTF-8.
//
// A code unit that is half of a surrogate pair says nothing on its own: the character it belongs to is spread across
// two of them, and one of them is all this sees. So it is written as the replacement character rather than as an
// ill-formed sequence.

import Text::{ IsScalarValue, TextError };

extend char16 : Display {
    /// Writes this code unit's character, or the replacement character when it is half of one.
    ///
    /// https://rux-lang.dev/docs/api/format/char16/format
    func Format(self: *char16, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        let value = *self as uint32;
        if !IsScalarValue(value) {
            return FormatScalar(writer, spec, ReplacementCharacter);
        }
        return FormatScalar(writer, spec, value as char32);
    }
}

extend char16 : Debug {
    /// The same character, quoted.
    ///
    /// https://rux-lang.dev/docs/api/format/char16/format-debug
    func FormatDebug(self: *char16, writer: &var TextWriter, spec: FormatSpec) -> TextError {
        let opening = WriteAscii(writer, c8'\'');
        if opening.IsError() {
            return opening;
        }
        let body = self.Format(writer, FormatSpec::Plain());
        if body.IsError() {
            return body;
        }
        return WriteAscii(writer, c8'\'');
    }
}
