// The text of a `float64`.
//
// The shortest decimal that reads back as the same value, so 0.1 prints as "0.1" rather than as the seventeen
// digits its binary value really is — and it is the shortest one exactly, found by the digit generator in
// ShortestDigits.rux rather than by rounding to a fixed count and hoping. A precision in the placeholder asks for
// fixed notation instead, which is still the older engine until task 24 replaces it.

import Core::{ Result, Unit };
import Text::{ Debug, Display, FormatError, FormatSpec, RejectStyle, TextWriter };

// The largest finite float64. Anything past it is an infinity, which is how
// the tests below classify a value without reading its bits.
const MaxFinite64 = 1.7976931348623157e308;

// The decimal exponent at or above which a float64 renders in scientific notation. Seventeen is the digit count
// at which every float64 is distinguishable from every other, so a value needing that many places in fixed
// notation is one whose fixed form is all trailing zeros.
const ScientificFrom64 = 17;

// Whether the value is a NaN. A NaN is the only value not equal to itself,
// so this needs no bit pattern to recognise one.
/// Provides the public `IsNan` operation.
///
/// @param value the value to act on
/// @returns whether the value is a NaN
/// @see https://rux-lang.dev/docs/api/format/is-nan
pub func IsNan(value: float64) -> bool {
    return value != value;
}

// Whether the value is one of the two infinities. Every comparison against a
// NaN is false, so a NaN answers false here rather than being mistaken for
// an infinity.
/// Provides the public `IsInfinite` operation.
///
/// @param value the value to act on
/// @returns whether the value is either infinity
/// @see https://rux-lang.dev/docs/api/format/is-infinite
pub func IsInfinite(value: float64) -> bool {
    return value > MaxFinite64 || value < -MaxFinite64;
}

// Whether the value is an ordinary number: neither a NaN nor an infinity.
/// Provides the public `IsFinite` operation.
///
/// @param value the value to act on
/// @returns whether the value is neither infinite nor a NaN
/// @see https://rux-lang.dev/docs/api/format/is-finite
pub func IsFinite(value: float64) -> bool {
    return value >= -MaxFinite64 && value <= MaxFinite64;
}

extend float64 : Display {
    /// Writes this value's decimal text.
    ///
    /// Allocates nothing: the digits go into a buffer on the stack and reach the writer in one call. Fifty bytes is
    /// more than the longest rendering — sign, digits, point and exponent — can need.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/float64/write-display
    pub func WriteDisplay(self: *float64, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        RejectStyle(spec)?;
        // Two bytes of head room in front, so that a requested sign can be put where the rendering starts
        // without moving it.
        var storage: char8[52];
        var cursor = ByteCursor((@storage[2])[..50]);
        // Precision means digits after the decimal point, exactly, with ties to even. A request past the
        // supported bound is refused rather than clamped or answered with a different rendering: falling back
        // would answer a question nobody asked, and quietly.
        if spec.HasPrecision() {
            return WritePrecision(writer, spec, DecomposeFloat64(*self));
        }
        WriteFloat(cursor, *self);
        var rendered = cursor.Written();
        // A requested sign goes in front of a value that has none of its own; a NaN carries no sign to show.
        if spec.ShowsSign() && rendered.length > 0 && rendered.data[0] != c8'-' && rendered.data[0] != c8'N' {
            storage[1] = c8'+';
            rendered = (@storage[1])[..rendered.length + 1];
        }
        return WriteAligned(writer, spec, rendered, true);
    }
}

extend float64 : Debug {
    /// The same text.
    ///
    /// # Failures
    /// Reports whatever the writer reported, stopping at the first refusal.
    ///
    /// @param writer the destination
    /// @param spec what the placeholder asked for
    /// @returns success when the complete rendering was accepted
    /// @see https://rux-lang.dev/docs/api/format/float64/write-debug
    pub func WriteDebug(self: *float64, writer: &var TextWriter, spec: FormatSpec) -> Result<Unit, FormatError> {
        return self.WriteDisplay(writer, spec);
    }
}

// Appends the text of a float64 to a builder. This is what ToString is built
// on, and what a caller who is already accumulating should reach for: it
// costs no String of its own.
func WriteFloat(cursor: &var ByteCursor, value: float64) {
    if IsNan(value) {
        cursor.PushBytes("NaN");
        return;
    }
    if IsInfinite(value) {
        if value < 0.0 {
            cursor.PushBytes("-Inf");
        } else {
            cursor.PushBytes("Inf");
        }
        return;
    }
    // The exact shortest form. The workspace bound it runs in is proved not to be reached for any float64, so a
    // false here is a defect rather than a value; the older engine is left as the answer in that case so that the
    // rendering is still a number rather than nothing.
    let parts = DecomposeFloat64(value);
    if !WriteShortestFloat(cursor, parts, ScientificFrom64) {
        WriteDecimal(cursor, value, 17u);
    }
}
