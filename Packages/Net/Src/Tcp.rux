// TCP: a listener that accepts connections, and the connected streams it and `Connect` give.
// A stream is an ordinary `Io` reader and writer. Reading past what the peer sent, once it has closed its side, fails
// with `EndOfStream`; writing after the peer has gone fails with `BrokenPipe` or `ConnectionReset` rather than ending
// the process with a signal. Every socket is closed when its value is dropped.

import Io::{ IoError, IoErrorKind, Reader, Writer };
import Net::{
    AcceptSocket, BindSocket, CloseSocket, ConnectSocket, IpAddress, Ipv4Address, ListenSocket, NoSocket, OpenSocket,
    PollSource, ReceiveSocket, SendSocket, SetIntegerOption, SetSocketNonBlocking, SetTimeout, ShutdownSocket,
    SocketAddress, SocketName
};
import Time::Duration;

/// A socket listening for TCP connections. Not copied.
/// @see https://rux-lang.dev/docs/api/net/tcp#tcp-listener
pub struct TcpListener {
    handle: uint64;
}

/// A connected TCP stream: an `Io::Reader` of what the peer sends and an `Io::Writer` to it. Not copied.
/// @see https://rux-lang.dev/docs/api/net/tcp#tcp-stream
pub struct TcpStream {
    handle: uint64;
}

/// Which directions of a connection `Shutdown` ends. `Copy`.
/// @see https://rux-lang.dev/docs/api/net/tcp#shutdown-direction
pub enum ShutdownDirection: int32 {
    /// Nothing more will be read.
    Read = 0,
    /// Nothing more will be written; the peer reads the end of the stream.
    Write = 1,
    /// Both.
    Both = 2
}

extend TcpListener {
    /// Listens at `address`. Port zero lets the system choose a free port, which `LocalAddress` then gives.
    /// @param address the address to listen at, such as `127.0.0.1:8080`, or `0.0.0.0:8080` for every address
    /// @returns the listener, or fails with `AddressInUse`, `AddressUnavailable` or `PermissionDenied`
    /// @see https://rux-lang.dev/docs/api/net/tcp#bind
    pub func Bind(address: SocketAddress) -> Self throws IoError {
        let handle = try OpenSocket(address, true);
        var listener = Self { handle };
        try BindSocket(handle, address, true);
        try ListenSocket(handle);
        return move listener;
    }

    /// Waits for a connection and accepts it.
    /// @returns the connected stream, whose `PeerAddress` says who connected
    /// @see https://rux-lang.dev/docs/api/net/tcp#accept
    pub func Accept(&self) -> TcpStream throws IoError {
        var peer = SocketAddress { ip: IpAddress::FromIpv4(Ipv4Address::Unspecified()), port: 0 };
        let handle = try AcceptSocket(self.handle, @peer);
        return TcpStream { handle };
    }

    /// The address the listener is bound to, with the port the system chose for port zero.
    /// @returns the address
    /// @see https://rux-lang.dev/docs/api/net/tcp#listener-local-address
    pub func LocalAddress(&self) -> SocketAddress throws IoError {
        return try SocketName(self.handle, false);
    }

    /// Makes calls on the listener fail with `WouldBlock` when they would wait, or wait again.
    /// A non-blocking socket is meant for a `Poller`, which says when a call would not wait. `Accept` then fails with
    /// `WouldBlock` when no connection is waiting; the streams it gives start blocking all the same.
    /// @param enabled whether calls fail rather than wait
    /// @returns success when the mode is set
    /// @see https://rux-lang.dev/docs/api/net/tcp#listener-set-non-blocking
    pub func SetNonBlocking(&self, enabled: bool) throws IoError {
        try SetSocketNonBlocking(self.handle, enabled);
    }

    /// The listener as a `Poller` watches it, valid while the listener is open.
    /// @returns the source to register
    /// @see https://rux-lang.dev/docs/api/net/tcp#listener-poll-source
    pub func PollSource(&self) -> PollSource {
        return PollSource { handle: self.handle };
    }

    func ~TcpListener(&var self) {
        CloseSocket(self.handle);
        self.handle = NoSocket;
    }
}

extend TcpStream {
    /// Connects to `address`, waiting until the connection is made or refused.
    /// @param address where to connect
    /// @returns the stream, or fails with `ConnectionRefused`, `Unreachable` or `TimedOut`
    /// @see https://rux-lang.dev/docs/api/net/tcp#connect
    pub func Connect(address: SocketAddress) -> Self throws IoError {
        let handle = try OpenSocket(address, true);
        var stream = Self { handle };
        try ConnectSocket(handle, address);
        return move stream;
    }

    /// The address of this end of the connection.
    /// @returns the address
    /// @see https://rux-lang.dev/docs/api/net/tcp#local-address
    pub func LocalAddress(&self) -> SocketAddress throws IoError {
        return try SocketName(self.handle, false);
    }

    /// The address of the other end.
    /// @returns the address
    /// @see https://rux-lang.dev/docs/api/net/tcp#peer-address
    pub func PeerAddress(&self) -> SocketAddress throws IoError {
        return try SocketName(self.handle, true);
    }

    /// Ends one or both directions of the connection while the socket stays open.
    /// @param direction what to end
    /// @returns nothing, or fails when the connection is already gone
    /// @see https://rux-lang.dev/docs/api/net/tcp#shutdown
    pub func Shutdown(&self, direction: ShutdownDirection) throws IoError {
        try ShutdownSocket(self.handle, direction as int32);
    }

    /// Sends small writes at once rather than gathering them, which suits request and response exchanges.
    /// @param enabled whether to
    /// @returns nothing, or fails when the system refused
    /// @see https://rux-lang.dev/docs/api/net/tcp#set-no-delay
    pub func SetNoDelay(&self, enabled: bool) throws IoError {
        try SetIntegerOption(self.handle, 6, 1, if enabled { 1 } else { 0 });
    }

    /// How long a read may wait before failing with `TimedOut`, or none to wait without a limit.
    /// @param timeout the limit
    /// @returns nothing, or fails when the system refused
    /// @see https://rux-lang.dev/docs/api/net/tcp#set-read-timeout
    pub func SetReadTimeout(&self, timeout: Duration?) throws IoError {
        try SetTimeout(self.handle, true, Nanoseconds(timeout));
    }

    /// How long a write may wait before failing with `TimedOut`, or none to wait without a limit.
    /// @param timeout the limit
    /// @returns nothing, or fails when the system refused
    /// @see https://rux-lang.dev/docs/api/net/tcp#set-write-timeout
    pub func SetWriteTimeout(&self, timeout: Duration?) throws IoError {
        try SetTimeout(self.handle, false, Nanoseconds(timeout));
    }

    /// Makes calls on the stream fail with `WouldBlock` when they would wait, or wait again.
    /// A non-blocking socket is meant for a `Poller`, which says when a call would not wait.
    /// @param enabled whether calls fail rather than wait
    /// @returns success when the mode is set
    /// @see https://rux-lang.dev/docs/api/net/tcp#set-non-blocking
    pub func SetNonBlocking(&self, enabled: bool) throws IoError {
        try SetSocketNonBlocking(self.handle, enabled);
    }

    /// The stream as a `Poller` watches it, valid while the stream is open.
    /// @returns the source to register
    /// @see https://rux-lang.dev/docs/api/net/tcp#poll-source
    pub func PollSource(&self) -> PollSource {
        return PollSource { handle: self.handle };
    }

    func ~TcpStream(&var self) {
        CloseSocket(self.handle);
        self.handle = NoSocket;
    }
}

// A timeout as nanoseconds, zero for none; a timeout of zero or less is the shortest the system takes.
func Nanoseconds(timeout: Duration?) -> int64 {
    match timeout {
        .Some(span) => {
            let nanoseconds = span.TotalNanoseconds() ?? 0x7FFFFFFFFFFFFFFFi64;
            return if nanoseconds < 1i64 { 1i64 } else { nanoseconds };
        },
        none => return 0
    }
}

extend TcpStream : Reader {
    /// Reads what the peer has sent, waiting while it has sent nothing.
    /// @param into where to put the bytes
    /// @returns how many were read, or fails with `EndOfStream` once the peer closed its side
    /// @see https://rux-lang.dev/docs/api/net/tcp#read
    pub func Read(&var self, into: var char8[..]) -> uint throws IoError {
        if into.length == 0u { return 0; }
        let count = try ReceiveSocket(self.handle, into, null);
        if count == 0u { throw IoError::Of(IoErrorKind::EndOfStream); }
        return count;
    }
}

extend TcpStream : Writer {
    /// Sends some of `bytes`, waiting while the connection's buffer is full.
    /// @param bytes the bytes
    /// @returns how many were sent
    /// @see https://rux-lang.dev/docs/api/net/tcp#write
    pub func Write(&var self, bytes: char8[..]) -> uint throws IoError {
        if bytes.length == 0u { return 0; }
        return try SendSocket(self.handle, bytes, none);
    }

    /// Does nothing: a stream sends what is written to it without holding any back.
    /// @returns nothing
    /// @see https://rux-lang.dev/docs/api/net/tcp#flush
    pub func Flush(&var self) throws IoError {}
}
