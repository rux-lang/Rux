// Sockets as each system makes them, behind one set of operations on a word-sized handle.
// A socket is a descriptor on the Unix systems and a `SOCKET` on Windows; both fit in a word, so nothing above this
// module asks which. Addresses are encoded here into the `sockaddr` bytes the system reads: the BSD systems start them
// with a length byte and a one-byte family, Linux and Windows with a two-byte family, and every system puts the port
// in network order. Errors become `IoError`s with the system's own code kept beside the meaning.

import Core::{ #Error, #target, AtomicCompareExchange, AtomicLoad, AtomicStore, MemoryOrder, SpinHint, uint16 };
import Io::{ IoError, IoErrorKind };
import Net::{ IpAddress, Ipv4Address, Ipv6Address, SocketAddress };

when #target.os {
    .Linux => import Linux::{
        AF_INET, AF_INET6, Accept4, Bind, Close, Connect, F_GETFL, F_SETFL, FcntlInt, GetPeerName, GetSocketName, Listen,
        MSG_NOSIGNAL, O_NONBLOCK, ReceiveFrom, SO_RCVTIMEO, SO_REUSEADDR, SO_SNDTIMEO, SOCK_CLOEXEC, SOL_SOCKET, SendTo,
        SetSocketOption, Shutdown, Socket
    },
    .FreeBSD => import FreeBSD::{
        AF_INET, AF_INET6, Accept4, Bind, Close, Connect, F_GETFL, F_SETFL, FcntlInt, GetPeerName, GetSocketName, Listen,
        MSG_NOSIGNAL, O_NONBLOCK, ReceiveFrom, SO_RCVTIMEO, SO_REUSEADDR, SO_SNDTIMEO, SOCK_CLOEXEC, SOL_SOCKET, SendTo,
        SetSocketOption, Shutdown, Socket
    },
    .macOS => import macOS::{
        AF_INET, AF_INET6, Accept4, Bind, Close, Connect, F_GETFL, F_SETFL, FcntlInt, GetPeerName, GetSocketName, Listen,
        O_NONBLOCK, ReceiveFrom, F_SETFD, FD_CLOEXEC, SO_NOSIGPIPE, SO_RCVTIMEO, SO_REUSEADDR, SO_SNDTIMEO, SOL_SOCKET,
        SendTo, SetSocketOption, Shutdown, Socket, fcntl
    },
    .Windows => import Windows::{
        AF_INET, AF_INET6, FIONBIO, HANDLE_FLAG_INHERIT, INVALID_SOCKET, SO_RCVTIMEO, SO_SNDTIMEO, SOL_SOCKET,
        SetHandleInformation, WSAGetLastError, WSAStartup, WsaData, accept, bind, closesocket, connect, getpeername,
        getsockname, ioctlsocket, listen, recvfrom, sendto, setsockopt, shutdown, socket
    },
    else => #Error("Unsupported operating system")
}

// The handle that is not a socket.
const NoSocket: uint64 = 0xFFFFFFFFFFFFFFFF;

// Room for any `sockaddr` this package uses: `sockaddr_in6` is the largest, at 28 bytes.
struct RawAddress {
    bytes: uint8[32];
    length: uint32;
}

// Winsock's state: 0 before starting, 1 while one thread starts it, 2 once started.
var WinsockState: uint32 = 0;

// Starts Winsock once for the process; nothing to do elsewhere.
func StartNetworking() {
    when #target.os == .Windows {
        // Safety: `WinsockState` is a module variable, live and aligned for the whole process, that every thread
        // reaches only through atomic operations.
        if unsafe { AtomicLoad(@WinsockState, MemoryOrder::Acquire) } == 2u32 { return; }
        // Safety: `WinsockState` is a module variable, live and aligned for the whole process, that every thread
        // reaches only through atomic operations.
        let previous = unsafe {
            AtomicCompareExchange(@WinsockState, 0u32, 1u32, MemoryOrder::Acquire, MemoryOrder::Acquire)
        };
        if previous == 0u32 {
            var data = WsaData();
            // Safety: `data` is a local `WsaData` the call fills in.
            unsafe { WSAStartup(0x0202u16, @data); }
            // Safety: `WinsockState` is a module variable, live and aligned for the whole process, that every thread
        // reaches only through atomic operations.
            unsafe { AtomicStore(@WinsockState, 2u32, MemoryOrder::Release); }
            return;
        }
        // Safety: `WinsockState` is a module variable, live and aligned for the whole process, that every thread
        // reaches only through atomic operations.
        while unsafe { AtomicLoad(@WinsockState, MemoryOrder::Acquire) } != 2u32 { SpinHint(); }
    }
}

// What a system error code means.
func FailureOf(code: int64) -> IoError {
    var kind = IoErrorKind::Other;
    when #target.os == .Windows {
        if code == 10061 { kind = IoErrorKind::ConnectionRefused; }
        else if code == 10054 { kind = IoErrorKind::ConnectionReset; }
        else if code == 10053 { kind = IoErrorKind::ConnectionAborted; }
        else if code == 10057 { kind = IoErrorKind::NotConnected; }
        else if code == 10048 { kind = IoErrorKind::AddressInUse; }
        else if code == 10049 { kind = IoErrorKind::AddressUnavailable; }
        else if code == 10051 || code == 10065 { kind = IoErrorKind::Unreachable; }
        else if code == 10060 { kind = IoErrorKind::TimedOut; }
        else if code == 10035 { kind = IoErrorKind::WouldBlock; }
        else if code == 10058 { kind = IoErrorKind::BrokenPipe; }
        else if code == 10004 { kind = IoErrorKind::Interrupted; }
        else if code == 10013 { kind = IoErrorKind::PermissionDenied; }
        else if code == 10022 { kind = IoErrorKind::InvalidInput; }
        else if code == 10009 || code == 10038 { kind = IoErrorKind::InvalidHandle; }
        else if code == 11001 || code == 11004 { kind = IoErrorKind::NotFound; }
    }
    else when #target.os == .Linux {
        if code == 111 { kind = IoErrorKind::ConnectionRefused; }
        else if code == 104 { kind = IoErrorKind::ConnectionReset; }
        else if code == 103 { kind = IoErrorKind::ConnectionAborted; }
        else if code == 107 { kind = IoErrorKind::NotConnected; }
        else if code == 98 { kind = IoErrorKind::AddressInUse; }
        else if code == 99 { kind = IoErrorKind::AddressUnavailable; }
        else if code == 101 || code == 113 { kind = IoErrorKind::Unreachable; }
        else if code == 110 || code == 11 { kind = IoErrorKind::TimedOut; }
        else if code == 32 { kind = IoErrorKind::BrokenPipe; }
        else if code == 4 { kind = IoErrorKind::Interrupted; }
        else if code == 13 || code == 1 { kind = IoErrorKind::PermissionDenied; }
        else if code == 22 { kind = IoErrorKind::InvalidInput; }
        else if code == 9 || code == 88 { kind = IoErrorKind::InvalidHandle; }
    }
    else {
        if code == 61 { kind = IoErrorKind::ConnectionRefused; }
        else if code == 54 { kind = IoErrorKind::ConnectionReset; }
        else if code == 53 { kind = IoErrorKind::ConnectionAborted; }
        else if code == 57 { kind = IoErrorKind::NotConnected; }
        else if code == 48 { kind = IoErrorKind::AddressInUse; }
        else if code == 49 { kind = IoErrorKind::AddressUnavailable; }
        else if code == 51 || code == 65 { kind = IoErrorKind::Unreachable; }
        else if code == 60 || code == 35 { kind = IoErrorKind::TimedOut; }
        else if code == 32 { kind = IoErrorKind::BrokenPipe; }
        else if code == 4 { kind = IoErrorKind::Interrupted; }
        else if code == 13 || code == 1 { kind = IoErrorKind::PermissionDenied; }
        else if code == 22 { kind = IoErrorKind::InvalidInput; }
        else if code == 9 || code == 38 { kind = IoErrorKind::InvalidHandle; }
    }
    return IoError { kind: kind, raw: code as int32 };
}

// The last error of a Winsock call, or the error a Unix wrapper returned.
func LastFailure(result: int64) -> IoError {
    when #target.os == .Windows {
        // Safety: `WSAGetLastError` takes nothing and only reads the calling thread's last Winsock error.
        return FailureOf(unsafe { WSAGetLastError() } as int64);
    }
    else {
        return FailureOf(-result);
    }
}

// The failure of a call on `handle` that could have waited. On the Unix systems `EAGAIN` means both that a blocking
// socket's timeout ran out and that a non-blocking one was not ready, so the socket's mode says which it was.
func SocketFailure(handle: uint64, failure: IoError) -> IoError {
    when #target.os != .Windows {
        if failure.kind == IoErrorKind::TimedOut && failure.raw != 110i32 && failure.raw != 60i32 {
            // Safety: `F_GETFL` takes an integer argument, not an address.
            let flags = unsafe { FcntlInt(handle as int32, F_GETFL, 0) };
            if flags >= 0i64 && (flags & O_NONBLOCK as int64) != 0i64 {
                return IoError { kind: IoErrorKind::WouldBlock, raw: failure.raw };
            }
        }
    }
    return failure;
}

// Makes calls on `handle` fail with `WouldBlock` rather than wait, or wait again.
func SetSocketNonBlocking(handle: uint64, enabled: bool) -> ! IoError {
    when #target.os == .Windows {
        var mode: uint32 = enabled ? 1u32 : 0u32;
        // Safety: `FIONBIO` reads one `uint32` through its argument, and `mode` is that local.
        if unsafe { ioctlsocket(handle, FIONBIO, @mode) } != 0 { fail LastFailure(0); }
    }
    else {
        // Safety: `F_GETFL` takes an integer argument, not an address.
        let flags = unsafe { FcntlInt(handle as int32, F_GETFL, 0) };
        if flags < 0i64 { fail LastFailure(flags); }
        let updated = enabled ? (flags | O_NONBLOCK as int64) : (flags & ~(O_NONBLOCK as int64));
        if updated != flags {
            // Safety: `F_SETFL` takes an integer argument, not an address.
            let result = unsafe { FcntlInt(handle as int32, F_SETFL, updated) };
            if result < 0i64 { fail LastFailure(result); }
        }
    }
}

// Encodes `address` as a `sockaddr`.
func Encode(address: SocketAddress) -> RawAddress {
    var raw = RawAddress { bytes: [0u8; 32], length: 16 };
    let family = address.ip.IsIpv6() ? AF_INET6 : AF_INET;
    when #target.os == .macOS || #target.os == .FreeBSD {
        raw.bytes[0] = address.ip.IsIpv6() ? 28u8 : 16u8;
        raw.bytes[1] = family.Truncate<uint8>();
    }
    else {
        raw.bytes[0] = family.Truncate<uint8>();
        raw.bytes[1] = (family >> 8).Truncate<uint8>();
    }
    raw.bytes[2] = (address.port >> 8) as uint8;
    raw.bytes[3] = address.port.Truncate<uint8>();
    match address.ip.AsIpv4() {
        .Some(v4) => {
            var index: uint = 0;
            while index < 4u {
                raw.bytes[4u + index] = v4.octets[index];
                index = index + 1;
            }
        },
        none => {
            let v6 = address.ip.AsIpv6() ?? Ipv6Address::Unspecified();
            var index: uint = 0;
            while index < 16u {
                raw.bytes[8u + index] = v6.octets[index];
                index = index + 1;
            }
            raw.length = 28;
        }
    }
    return raw;
}

// Decodes a `sockaddr`, or none for a family this package does not know.
// Safety: `bytes` must address a readable `sockaddr` of at least four bytes whose family tells its true length: 16
// bytes for `AF_INET` and 28 for `AF_INET6`.
unsafe func Decode(bytes: *uint8) -> SocketAddress? {
    var family: int32 = 0;
    when #target.os == .macOS || #target.os == .FreeBSD {
        family = bytes[1] as int32;
    }
    else {
        family = bytes[0] as int32 | (bytes[1] as int32 << 8);
    }
    let port = (bytes[2] as uint16 << 8) | bytes[3] as uint16;
    if family == AF_INET {
        let v4 = Ipv4Address { octets: [bytes[4], bytes[5], bytes[6], bytes[7]] };
        return SocketAddress { ip: IpAddress::FromIpv4(v4), port: port };
    }
    if family == AF_INET6 {
        var octets: uint8[16] = [0u8; 16];
        var index: uint = 0;
        while index < 16u {
            octets[index] = bytes[8u + index];
            index = index + 1;
        }
        return SocketAddress { ip: IpAddress::FromIpv6(Ipv6Address { octets: octets }), port: port };
    }
    return none;
}

// Opens a stream or datagram socket for addresses like `address`.
// Keeps a new socket out of child processes, where the system does not do so as it makes one. On macOS this also
// turns `SIGPIPE` into a `BrokenPipe` failure, as `MSG_NOSIGNAL` does on each send elsewhere.
func KeepFromChildren(handle: uint64) {
    when #target.os == .Windows {
        // Safety: the call reads no memory, and `handle` is the socket its caller just made.
        unsafe { SetHandleInformation(handle as *opaque, HANDLE_FLAG_INHERIT, 0); }
    }
    else when #target.os == .macOS {
        // Safety: `F_SETFD` takes a flag word, not an address.
        unsafe { fcntl(handle as int32, F_SETFD, FD_CLOEXEC); }
        var one: int32 = 1;
        // Safety: `one` is a local `int32`, readable for the 4 bytes passed.
        unsafe { SetSocketOption(handle as int32, SOL_SOCKET, SO_NOSIGPIPE, (@one) as *opaque, 4u32); }
    }
}

func OpenSocket(address: SocketAddress, stream: bool) -> uint64 ! IoError {
    StartNetworking();
    let family = address.ip.IsIpv6() ? AF_INET6 : AF_INET;
    let kind: int32 = stream ? 1 : 2;
    when #target.os == .Windows {
        // Safety: `socket` takes three numbers and reads no memory of the caller's.
        let handle = unsafe { socket(family, kind, 0) };
        if handle == INVALID_SOCKET { fail LastFailure(0); }
        KeepFromChildren(handle);
        return handle;
    }
    else when #target.os == .macOS {
        let result = Socket(family, kind, 0);
        if result < 0 { fail LastFailure(result); }
        KeepFromChildren(result as uint64);
        return result as uint64;
    }
    else {
        let result = Socket(family, kind | SOCK_CLOEXEC, 0);
        if result < 0 { fail LastFailure(result); }
        return result as uint64;
    }
}

func CloseSocket(handle: uint64) {
    if handle == NoSocket { return; }
    when #target.os == .Windows {
        // Safety: the call reads no memory, and `handle` is a socket its caller owns and gives up here.
        unsafe { closesocket(handle); }
    }
    else {
        Close(handle as int32);
    }
}

func BindSocket(handle: uint64, address: SocketAddress, reuse: bool) -> ! IoError {
    when #target.os != .Windows {
        // Lets a server restart on its port while connections from its last run wind down. Windows means something
        // else by the option, letting another socket take the port over, so it is not set there.
        if reuse {
            var one: int32 = 1;
            // Safety: `one` is a local `int32`, readable for the 4 bytes passed.
            unsafe { SetSocketOption(handle as int32, SOL_SOCKET, SO_REUSEADDR, (@one) as *opaque, 4u32); }
        }
    }
    var raw = Encode(address);
    when #target.os == .Windows {
        // Safety: `raw` is a local whose first `raw.length` bytes `Encode` filled with the `sockaddr`.
        if unsafe { bind(handle, (@raw.bytes[0]) as *opaque, raw.length as int32) } != 0 { fail LastFailure(0); }
    }
    else {
        // Safety: `raw` is a local whose first `raw.length` bytes `Encode` filled with the `sockaddr`.
        let result = unsafe { Bind(handle as int32, (@raw.bytes[0]) as *opaque, raw.length) };
        if result < 0 { fail LastFailure(result); }
    }
}

func ListenSocket(handle: uint64) -> ! IoError {
    when #target.os == .Windows {
        // Safety: `listen` takes two numbers and reads no memory of the caller's.
        if unsafe { listen(handle, 128) } != 0 { fail LastFailure(0); }
    }
    else {
        let result = Listen(handle as int32, 128);
        if result < 0 { fail LastFailure(result); }
    }
}

func ConnectSocket(handle: uint64, address: SocketAddress) -> ! IoError {
    var raw = Encode(address);
    when #target.os == .Windows {
        // Safety: `raw` is a local whose first `raw.length` bytes `Encode` filled with the `sockaddr`.
        if unsafe { connect(handle, (@raw.bytes[0]) as *opaque, raw.length as int32) } != 0 { fail LastFailure(0); }
    }
    else {
        while true {
            // Safety: `raw` is a local whose first `raw.length` bytes `Encode` filled with the `sockaddr`.
            let result = unsafe { Connect(handle as int32, (@raw.bytes[0]) as *opaque, raw.length) };
            if result >= 0 { return; }
            let failure = LastFailure(result);
            if failure.kind != IoErrorKind::Interrupted { fail failure; }
        }
    }
}

// Accepts a connection, returning its handle and filling in the peer's address.
func AcceptSocket(handle: uint64, peer: *var SocketAddress) -> uint64 ! IoError {
    var raw = RawAddress { bytes: [0u8; 32], length: 32 };
    when #target.os == .Windows {
        var length: int32 = 32;
        // Safety: `raw` is a local of 32 bytes, the `length` passed, and `length` is a local the call writes.
        let accepted = unsafe { accept(handle, (@raw.bytes[0]) as *var opaque, @length) };
        if accepted == INVALID_SOCKET { fail LastFailure(0); }
        KeepFromChildren(accepted);
        SetSocketNonBlocking(accepted, false) catch { else => {} };
        // Safety: the documented contract makes `peer` a non-null pointer to the caller's writable
        // `SocketAddress`, and `raw` is a 32-byte local the system filled with a `sockaddr`.
        unsafe { *peer = Decode(@raw.bytes[0]) ?? *peer; }
        return accepted;
    }
    else {
        while true {
            var length: uint32 = 32;
            when #target.os == .macOS {
                // Safety: `raw` is a local of 32 bytes, the `length` passed, and `length` is a local the call writes.
                let result = unsafe { Accept4(handle as int32, (@raw.bytes[0]) as *var opaque, @length, 0) };
                if result >= 0 {
                    KeepFromChildren(result as uint64);
                    SetSocketNonBlocking(result as uint64, false) catch { else => {} };
                    // Safety: the documented contract makes `peer` a non-null pointer to the caller's writable
                    // `SocketAddress`, and `raw` is a 32-byte local the system filled with a `sockaddr`.
                    unsafe { *peer = Decode(@raw.bytes[0]) ?? *peer; }
                    return result as uint64;
                }
                let failure = LastFailure(result);
                if failure.kind != IoErrorKind::Interrupted { fail SocketFailure(handle, failure); }
            }
            else {
                // Safety: `raw` is a local of 32 bytes, the `length` passed, and `length` is a local the call writes.
                let result = unsafe {
                    Accept4(handle as int32, (@raw.bytes[0]) as *var opaque, @length, SOCK_CLOEXEC)
                };
                if result >= 0 {
                    when #target.os == .FreeBSD {
                        SetSocketNonBlocking(result as uint64, false) catch { else => {} };
                    }
                    // Safety: the documented contract makes `peer` a non-null pointer to the caller's writable
                    // `SocketAddress`, and `raw` is a 32-byte local the system filled with a `sockaddr`.
                    unsafe { *peer = Decode(@raw.bytes[0]) ?? *peer; }
                    return result as uint64;
                }
                let failure = LastFailure(result);
                if failure.kind != IoErrorKind::Interrupted { fail SocketFailure(handle, failure); }
            }
        }
        fail IoError::Of(IoErrorKind::Other);
    }
}

// Sends bytes, to `target` when one is given.
func SendSocket(handle: uint64, bytes: char8[..], target: SocketAddress?) -> uint ! IoError {
    var raw = RawAddress { bytes: [0u8; 32], length: 0 };
    match target {
        .Some(address) => raw = Encode(address),
        none => {}
    }
    let address: *opaque = raw.length == 0u32 ? null : (@raw.bytes[0]) as *opaque;
    when #target.os == .Windows {
        let count = bytes.length > 0x40000000u ? 0x40000000i32 : bytes.length as int32;
        // Safety: `bytes` is readable for `count` bytes, at most its length, and a non-null `address` is the local
        // `raw`, readable for the `raw.length` bytes `Encode` filled.
        let sent = unsafe { sendto(handle, bytes.data as *opaque, count, 0, address, raw.length as int32) };
        if sent < 0 { fail LastFailure(0); }
        return sent as uint;
    }
    else {
        var flags: int32 = 0;
        when #target.os != .macOS {
            flags = MSG_NOSIGNAL;
        }
        while true {
            // Safety: `bytes` is a slice, readable for `bytes.length` bytes, and a non-null `address` is the local
            // `raw`, readable for the `raw.length` bytes `Encode` filled.
            let result = unsafe {
                SendTo(handle as int32, bytes.data as *opaque, bytes.length, flags, address, raw.length)
            };
            if result >= 0 { return result as uint; }
            let failure = LastFailure(result);
            if failure.kind != IoErrorKind::Interrupted { fail SocketFailure(handle, failure); }
        }
        fail IoError::Of(IoErrorKind::Other);
    }
}

// The Winsock error a receive reports when the datagram was longer than the buffer.
const WsaMessageTooLong: int32 = 10040;

// Receives bytes, filling in where they came from when `source` is given. A datagram longer than `into` is cut to fit.
func ReceiveSocket(handle: uint64, into: var char8[..], source: *var SocketAddress) -> uint ! IoError {
    var raw = RawAddress { bytes: [0u8; 32], length: 32 };
    let address: *var opaque = source == null ? null : (@raw.bytes[0]) as *var opaque;
    when #target.os == .Windows {
        var length: int32 = 32;
        let count = into.length > 0x40000000u ? 0x40000000i32 : into.length as int32;
        // Safety: `into` is writable for `count` bytes, at most its length; `address` and the length pointer are
        // null together, or the 32-byte local `raw` and the local `length` that states its size.
        var received = unsafe {
            recvfrom(handle, into.data as *var opaque, count, 0, address, source == null ? null : @length)
        };
        if received < 0 {
            // A datagram longer than the buffer fills it and the rest is lost, as on the other systems; Windows says so
            // by failing with WSAEMSGSIZE after filling the buffer and the source.
            // Safety: `WSAGetLastError` takes nothing and only reads the calling thread's last Winsock error.
            if unsafe { WSAGetLastError() } != WsaMessageTooLong { fail LastFailure(0); }
            received = count;
        }
        // Safety: a non-null `source` is the caller's writable `SocketAddress`, by the documented contract, and `raw`
        // holds the `sockaddr` the system filled.
        if source != null { unsafe { *source = Decode(@raw.bytes[0]) ?? *source; } }
        return received as uint;
    }
    else {
        while true {
            var length: uint32 = 32;
            // Safety: `into` is a writable slice of `into.length` bytes; `address` and the length pointer are null
            // together, or the 32-byte local `raw` and the local `length` that states its size.
            let result = unsafe {
                ReceiveFrom(handle as int32, into.data as *var opaque, into.length, 0, address,
                            source == null ? null : @length)
            };
            if result >= 0 {
                // Safety: a non-null `source` is the caller's writable `SocketAddress`, by the documented contract,
                // and `raw` holds the `sockaddr` the system filled.
                if source != null { unsafe { *source = Decode(@raw.bytes[0]) ?? *source; } }
                return result as uint;
            }
            let failure = LastFailure(result);
            if failure.kind != IoErrorKind::Interrupted { fail SocketFailure(handle, failure); }
        }
        fail IoError::Of(IoErrorKind::Other);
    }
}

func ShutdownSocket(handle: uint64, how: int32) -> ! IoError {
    when #target.os == .Windows {
        // Safety: `shutdown` takes two numbers and reads no memory of the caller's.
        if unsafe { shutdown(handle, how) } != 0 { fail LastFailure(0); }
    }
    else {
        let result = Shutdown(handle as int32, how);
        if result < 0 { fail LastFailure(result); }
    }
}

// The socket's local address, or its peer's.
func SocketName(handle: uint64, peer: bool) -> SocketAddress ! IoError {
    var raw = RawAddress { bytes: [0u8; 32], length: 32 };
    when #target.os == .Windows {
        var length: int32 = 32;
        // Safety: `raw` is a local of 32 bytes, the `length` passed, and `length` is a local the call writes.
        let result = unsafe {
            peer ? getpeername(handle, (@raw.bytes[0]) as *var opaque, @length)
                 : getsockname(handle, (@raw.bytes[0]) as *var opaque, @length)
        };
        if result != 0 { fail LastFailure(0); }
    }
    else {
        var length: uint32 = 32;
        // Safety: `raw` is a local of 32 bytes, the `length` passed, and `length` is a local the call writes.
        let result = unsafe {
            peer ? GetPeerName(handle as int32, (@raw.bytes[0]) as *var opaque, @length)
                 : GetSocketName(handle as int32, (@raw.bytes[0]) as *var opaque, @length)
        };
        if result < 0 { fail LastFailure(result); }
    }
    // Safety: `raw` is a 32-byte local the system filled with the socket's `sockaddr`.
    return unsafe { Decode(@raw.bytes[0]) } ?? fail IoError::Of(IoErrorKind::Other);
}

func SetIntegerOption(handle: uint64, level: int32, name: int32, value: int32) -> ! IoError {
    var setting = value;
    when #target.os == .Windows {
        // Safety: `setting` is a local `int32`, readable for the 4 bytes passed.
        if unsafe { setsockopt(handle, level, name, (@setting) as *opaque, 4) } != 0 { fail LastFailure(0); }
    }
    else {
        // Safety: `setting` is a local `int32`, readable for the 4 bytes passed.
        let result = unsafe { SetSocketOption(handle as int32, level, name, (@setting) as *opaque, 4u32) };
        if result < 0 { fail LastFailure(result); }
    }
}

// Sets how long a receive, or a send, may wait; zero or less waits without a limit.
func SetTimeout(handle: uint64, receive: bool, nanoseconds: int64) -> ! IoError {
    let name = receive ? SO_RCVTIMEO : SO_SNDTIMEO;
    when #target.os == .Windows {
        var milliseconds: uint32 = 0;
        if nanoseconds > 0i64 {
            let rounded = (nanoseconds + 999999i64) / 1000000i64;
            milliseconds = rounded > 0xFFFFFFFEi64 ? 0xFFFFFFFEu32 : rounded as uint32;
        }
        // Safety: `milliseconds` is a local `uint32`, readable for the 4 bytes passed.
        if unsafe { setsockopt(handle, SOL_SOCKET, name, (@milliseconds) as *opaque, 4) } != 0 { fail LastFailure(0); }
    }
    else {
        // A `timeval`: whole seconds and microseconds, each in a 64-bit field on every system this package supports
        // but macOS, whose 32-bit microseconds sit in the low half of the same place.
        var value: int64[2] = [0i64, 0i64];
        if nanoseconds > 0i64 {
            value[0] = nanoseconds / 1000000000i64;
            value[1] = (nanoseconds % 1000000000i64 + 999i64) / 1000i64;
            if value[1] == 1000000i64 {
                value[0] = value[0] + 1i64;
                value[1] = 0;
            }
        }
        // Safety: `value` is a local array of two `int64`, readable for the 16 bytes passed.
        let result = unsafe { SetSocketOption(handle as int32, SOL_SOCKET, name, (@value[0]) as *opaque, 16u32) };
        if result < 0 { fail LastFailure(result); }
    }
}
