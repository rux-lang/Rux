// Text as the operating system stores it, kept lossless.
//
// A filename is not text. On the Unix systems it is bytes with two exclusions -- no slash, no NUL -- and nothing
// obliges those bytes to be UTF-8. On Windows it is UTF-16 code units, and nothing obliges them to pair: names
// with unpaired surrogates exist on real disks. A path type built on `String` would refuse those names, and a
// program that cannot open a file because of its name is wrong in the way that loses data.
//
// So the native string stores exactly what the system does -- bytes there, code units here -- behind one alias,
// and the conversions are asymmetric on purpose: UTF-8 in always succeeds, since valid text encodes into either
// representation; UTF-8 out is fallible, since the system's names are under no obligation to be text at all.

import Allocator::{ AllocError, Allocator, Layout };
import Core::{ #target, Option, Panic, Slice };
import Memory::Copy;
import Text::{ DecodeAt, FromAllocError, String, StringBuilder, TextError };

when #target.os == .Windows {
    /// The unit a native string is made of: a UTF-16 code unit on Windows.
    ///
    /// https://rux-lang.dev/docs/api/path/os-unit
    pub type OsUnit = uint16;
}
else {
    /// The unit a native string is made of: a byte on the Unix systems.
    ///
    /// https://rux-lang.dev/docs/api/path/os-unit
    pub type OsUnit = char8;
}

/// A borrowed run of native units.
///
/// `Copy`, owning nothing. The units it names must outlive it.
///
/// https://rux-lang.dev/docs/api/path/os-string-view
pub struct OsStringView {
    /// The units, exactly as the system holds them.
    pub units: Slice<OsUnit>;
}

extend OsStringView {
    /// A view over nothing.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string-view/new
    pub func OsStringView() -> OsStringView {
        return OsStringView { units: Slice<OsUnit> { data: null, length: 0 } };
    }

    /// A view over `units` as they stand: no validation, because there is nothing to validate against.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string-view/from-units
    pub func FromUnits(units: Slice<OsUnit>) -> OsStringView {
        return OsStringView { units: units };
    }

    /// How many native units the view spans -- bytes or code units, not characters.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string-view/length
    pub func Length(self: &OsStringView) -> uint {
        return self.units.length;
    }

    /// Whether the view spans nothing.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string-view/is-empty
    pub func IsEmpty(self: &OsStringView) -> bool {
        return self.units.length == 0;
    }

    /// The units themselves.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string-view/units
    pub func Units(self: &OsStringView) -> Slice<OsUnit> {
        return self.units;
    }

    /// Whether two views hold the same units.
    ///
    /// Unit equality and nothing smarter: no case folding, no normalization. Two names the filesystem treats as
    /// one are still two names here, because which names those are is the filesystem's opinion, not the string's.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string-view/equals
    pub func Equals(self: &OsStringView, other: &OsStringView) -> bool {
        if self.units.length != other.units.length { return false; }
        var index: uint = 0;
        while index < self.units.length {
            if self.units.data[index] != other.units.data[index] { return false; }
            index = index + 1;
        }
        return true;
    }
}

/// Native text that owns its units.
///
/// Copyable with value semantics: each copy owns an independent native-unit block.
///
/// https://rux-lang.dev/docs/api/path/os-string
pub struct OsString {
    /// The units, or null for no length.
    data: *var OsUnit;
    /// How many units there are.
    length: uint;
    /// Where the block came from, and where it goes back to.
    allocator: Allocator;
}

extend OsString {
    /// Deep-copies native units into independent storage from the same allocator.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/copy
    pub func =(self: &var OsString, other: &OsString) {
        self.data = null;
        self.length = other.length;
        self.allocator = other.allocator;
        if other.length == 0 { return; }
        let bytes = other.length * (sizeof(OsUnit) as uint);
        let layout = Layout::New(bytes, alignof(OsUnit) as uint).ValueOr(Layout { size: bytes, alignment: 1 });
        var block: *var opaque = null;
        var allocator = other.allocator;
        if allocator.Allocate(layout, @block) != AllocError::None {
            Panic("copying an OsString requires an allocation");
        }
        Copy(block, other.data as *opaque, bytes);
        self.data = block as *var OsUnit;
    }

    /// Native text of no length, which has allocated nothing.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/new
    pub func OsString(allocator: Allocator) -> OsString {
        return OsString { data: null, length: 0, allocator: allocator };
    }

    /// An owning copy of what `view` spans, exactly as it stands.
    ///
    /// This is the lossless direction: whatever the system handed over survives, valid text or not. `error`
    /// receives `OutOfMemory` when the copy cannot be made.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/from-view
    pub func FromView(allocator: Allocator, view: OsStringView, error: *var TextError) -> OsString {
        *error = TextError::None;
        let units = view.Units();
        if units.length == 0 { return OsString(allocator); }
        let bytes = units.length * (sizeof(OsUnit) as uint);
        let layout = Layout::New(bytes, alignof(OsUnit) as uint);
        if layout.IsNone() {
            *error = TextError::LengthOverflow;
            return OsString(allocator);
        }
        var block: *var opaque = null;
        var borrowed = allocator;
        let allocated = borrowed.Allocate(layout.ValueOr(Layout { size: bytes, alignment: 1 }), @block);
        if allocated != AllocError::None {
            *error = FromAllocError(allocated);
            return OsString(allocator);
        }
        Copy(block, units.data as *opaque, bytes);
        return OsString { data: block as *var OsUnit, length: units.length, allocator: allocator };
    }

    /// How many native units the text holds.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/length
    pub func Length(self: &OsString) -> uint {
        return self.length;
    }

    /// Whether the text holds nothing.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/is-empty
    pub func IsEmpty(self: &OsString) -> bool {
        return self.length == 0;
    }

    /// A view over this text, which is what everything read-only takes.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/view
    pub func View(self: &OsString) -> OsStringView {
        return OsStringView { units: Slice<OsUnit> { data: self.data, length: self.length } };
    }

    /// Gives the block back and leaves text of no length.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/clear
    pub func Clear(self: &var OsString) {
        if self.data != null {
            let bytes = self.length * (sizeof(OsUnit) as uint);
            let layout = Layout::New(bytes, alignof(OsUnit) as uint);
            var borrowed = self.allocator;
            borrowed.Deallocate(self.data as *var opaque, layout.ValueOr(Layout { size: bytes, alignment: 1 }));
        }
        self.data = null;
        self.length = 0;
    }
}

extend OsString {
    /// Gives the block back.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/destructor
    func ~OsString(self: &var OsString) {
        self.Clear();
    }
}

extend OsString {
    /// An owning native copy of UTF-8 text.
    ///
    /// The direction that always succeeds: valid text encodes into either representation, byte for byte on the
    /// Unix systems and through UTF-16 on Windows. `error` reports only the allocation.
    ///
    /// # Safety
    ///
    /// The bytes must be well-formed UTF-8, which everything in `Rux/Text` produces and vouches for.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/from-text
    pub func FromText(allocator: Allocator, text: Slice<char8>, error: *var TextError) -> OsString {
        when #target.os == .Windows {
            // Two passes: count the units, then fill them. A scalar below U+10000 is one unit and anything above
            // is a surrogate pair, which is the whole of UTF-16.
            var needed: uint = 0;
            var index: uint = 0;
            while index < text.length {
                var scalar = 0u32 as char32;
                var width: uint = 0;
                if DecodeAt(text, index, @scalar, @width).IsError() {
                    index = text.length;
                }
                else {
                    needed = needed + ((scalar as uint32) >= 0x10000 ? 2u : 1u);
                    index = index + width;
                }
            }

            *error = TextError::None;
            if needed == 0 { return OsString(allocator); }
            let bytes = needed * 2u;
            let layout = Layout::New(bytes, 2);
            var block: *var opaque = null;
            var borrowed = allocator;
            let allocated = borrowed.Allocate(layout.ValueOr(Layout { size: bytes, alignment: 2 }), @block);
            if allocated != AllocError::None {
                *error = FromAllocError(allocated);
                return OsString(allocator);
            }
            let units = block as *var uint16;
            var at: uint = 0;
            index = 0;
            while index < text.length {
                var scalar = 0u32 as char32;
                var width: uint = 0;
                if DecodeAt(text, index, @scalar, @width).IsError() {
                    index = text.length;
                }
                else {
                    let value = scalar as uint32;
                    if value >= 0x10000 {
                        let offset = value - 0x10000;
                        units[at] = (0xD800 + (offset >> 10)) as uint16;
                        units[at + 1] = (0xDC00 + (offset & 0x3FF)) as uint16;
                        at = at + 2;
                    }
                    else {
                        units[at] = value as uint16;
                        at = at + 1;
                    }
                    index = index + width;
                }
            }
            return OsString { data: units, length: needed, allocator: allocator };
        }
        else {
            // Bytes are bytes: the copy is the conversion.
            return OsString::FromView(allocator, OsStringView { units: text }, error);
        }
    }

    /// Provides the public `FromText` operation for text.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string/from-text
    pub func FromText(allocator: Allocator, text: string, error: *var TextError) -> OsString {
        return OsString::FromText(allocator, Slice<char8> { data: text.data, length: text.length }, error);
    }
}

extend OsStringView {
    /// This native text as UTF-8, or nothing where it is not text.
    ///
    /// The fallible direction, and fallible for a different reason per platform: Unix bytes may simply not be
    /// UTF-8, and Windows units may hold an unpaired surrogate, which no UTF-8 sequence can spell. `error` says
    /// `InvalidUtf8` for both, because both mean the same thing to the caller -- this name is not text, and a
    /// program that must show it anyway shows it lossily by its own policy, knowingly.
    ///
    /// https://rux-lang.dev/docs/api/path/os-string-view/to-text
    pub func ToText(self: &OsStringView, allocator: Allocator, error: *var TextError) -> Option<String> {
        when #target.os == .Windows {
            // Two passes: measure the UTF-8, refusing unpaired surrogates on the way, then build through the
            // checked builder so the promise chain stays intact.
            let units = self.units;
            var needed: uint = 0;
            var index: uint = 0;
            while index < units.length {
                var scalar: uint32 = 0;
                var width: uint = 0;
                if !DecodeUnit(units, index, @scalar, @width) {
                    *error = TextError::InvalidUtf8;
                    return Option::None<String>();
                }
                needed = needed + Utf8Width(scalar);
                index = index + width;
            }

            var builder = StringBuilder::WithCapacity(allocator, needed, error);
            if error.IsError() { return Option::None<String>(); }
            index = 0;
            while index < units.length {
                var scalar: uint32 = 0;
                var width: uint = 0;
                if !DecodeUnit(units, index, @scalar, @width) {
                    *error = TextError::InvalidUtf8;
                    return Option::None<String>();
                }
                let appended = builder.AppendScalar(scalar as char32);
                if appended.IsError() {
                    *error = appended;
                    return Option::None<String>();
                }
                index = index + width;
            }
            return Option::Some<String>(builder.IntoString());
        }
        else {
            // Bytes: the check is the conversion.
            let made = String::FromBytes(allocator, self.units, error);
            if error.IsError() { return Option::None<String>(); }
            return Option::Some<String>(made);
        }
    }
}

when #target.os == .Windows {
    // One scalar out of the UTF-16 units at `index`: a lone unit below the surrogates, or a high-low pair.
    // Anything else -- a low half first, a high half with no partner -- is not text.
    func DecodeUnit(units: Slice<uint16>, index: uint, scalar: *var uint32, width: *var uint) -> bool {
        let unit = units.data[index] as uint32;
        if unit < 0xD800 || unit > 0xDFFF {
            *scalar = unit;
            *width = 1;
            return true;
        }
        if unit >= 0xDC00 { return false; }
        if index + 1 >= units.length { return false; }
        let low = units.data[index + 1] as uint32;
        if low < 0xDC00 || low > 0xDFFF { return false; }
        *scalar = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00);
        *width = 2;
        return true;
    }

    // How many UTF-8 bytes a scalar takes; every input here is a valid scalar by construction.
    func Utf8Width(scalar: uint32) -> uint {
        if scalar < 0x80 { return 1; }
        if scalar < 0x800 { return 2; }
        if scalar < 0x10000 { return 3; }
        return 4;
    }
}
