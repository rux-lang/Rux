// A path that owns its units and can grow.
// The growable operation a path needs is exactly one: push a segment, with a separator supplied where one is
// missing. Everything else — parent, filename, joins that produce fresh paths — reads structure and lives with
// it; the buffer is where segments accumulate on the way to a system call.

import Allocator::{ AllocError, Allocator, Layout };
import Memory::Copy;
import Text::{ FromAllocError, TextError };

/// An owning, growable path.
/// Move-only: it prohibits copying and gives its block back with `~PathBuffer`.
/// @see https://rux-lang.dev/docs/api/path/path-buffer
pub struct PathBuffer {
    /// The units, or null before the first push.
    pub data: *var OsUnit;
    /// How many units are in use.
    pub length: uint;
    /// How many units the block holds.
    capacity: uint;
    /// Where the block came from, and where it goes back to.
    pub allocator: Allocator;
}

extend PathBuffer {
    /// Copying a buffer would give two mutable owners of one block.
    func =(self: &var PathBuffer, other: &PathBuffer);

    /// An empty buffer that has allocated nothing.
    /// @param allocator where the storage comes from
    /// @returns an empty buffer that has taken no storage yet
    /// @see https://rux-lang.dev/docs/api/path/path-buffer/new
    pub func PathBuffer(allocator: Allocator) -> PathBuffer {
        return PathBuffer { data: null, length: 0, capacity: 0, allocator: allocator };
    }

    /// A buffer opening with `path`'s units.
    /// @param allocator where the storage comes from
    /// @param path the path to act on
    /// @returns a copy of `path` this buffer owns, or an empty one when the allocator refused
    /// @see https://rux-lang.dev/docs/api/path/path-buffer/from-path
    pub func FromPath(allocator: Allocator, path: Path) -> PathBuffer ! TextError {
        var buffer = PathBuffer(allocator);
        buffer.AppendUnits(path.AsView().Units())?;
        return <-buffer;
    }

    /// How many units the buffer holds.
    /// @returns how many units the buffer holds
    /// @see https://rux-lang.dev/docs/api/path/path-buffer/length
    pub func Length(self: &PathBuffer) -> uint {
        return self.length;
    }

    /// Whether the buffer holds nothing.
    /// @returns whether the buffer holds no units
    /// @see https://rux-lang.dev/docs/api/path/path-buffer/is-empty
    pub func IsEmpty(self: &PathBuffer) -> bool {
        return self.length == 0;
    }

    /// The buffer as a borrowed path, which is what every reading operation takes.
    /// The path borrows the buffer and must not outlive it or survive a push.
    /// @returns a borrowed path over the buffer's units
    /// @see https://rux-lang.dev/docs/api/path/path-buffer/as-path
    pub func AsPath(self: &PathBuffer) -> Path {
        return Path::FromView(OsStringView::FromUnits((self.data)[..self.length]));
    }

    // Room for `additional` more units, by doubling.
    func Reserve(self: &var PathBuffer, additional: uint) -> ! TextError {
        let required = self.length + additional;
        if required <= self.capacity { return; }
        var wanted = self.capacity * 2;
        if wanted < required {
            wanted = required;
        }
        if wanted < 16 {
            wanted = 16;
        }
        let unitSize = sizeof(OsUnit) as uint;
        let layout = Layout::New(wanted * unitSize, alignof(OsUnit) as uint) ?? fail TextError::LengthOverflow;
        var borrowed = self.allocator;
        let block = borrowed.Allocate(layout) catch { allocated => fail FromAllocError(allocated) };
        if self.data != null {
            Copy(block, self.data as *opaque, self.length * unitSize);
            let old = Layout::New(self.capacity * unitSize, alignof(OsUnit) as uint);
            borrowed.Deallocate(self.data as *var opaque,
                                (old ?? Layout { size: self.capacity * unitSize, alignment: 1 })) catch { else => {} };
        }
        self.data = block as *var OsUnit;
        self.capacity = wanted;
    }

    // Appends raw units, structure unexamined.
    func AppendUnits(self: &var PathBuffer, units: OsUnit[..]) -> ! TextError {
        if units.length == 0 { return; }
        self.Reserve(units.length)?;
        var index: uint = 0;
        while index < units.length {
            self.data[self.length + index] = units.data[index];
            index = index + 1;
        }
        self.length = self.length + units.length;
    }

    /// Appends `segment` as one more component, supplying the separator where one is missing.
    /// A segment that is itself absolute — opening with a separator — replaces the buffer instead of extending
    /// it, which is what joining means everywhere paths are joined: `join(a, /b)` is `/b`.
    /// @param segment the component to append
    /// @returns nothing when the component was appended, or why not
    /// @see https://rux-lang.dev/docs/api/path/path-buffer/push
    pub func Push(self: &var PathBuffer, segment: OsStringView) -> ! TextError {
        let units = segment.Units();
        if units.length == 0 { return; }
        if IsSeparator(units.data[0]) {
            self.length = 0;
            return self.AppendUnits(units);
        }
        if self.length > 0 && !IsSeparator(self.data[self.length - 1]) {
            var one: OsUnit[1];
            one[0] = PreferredSeparator();
            self.AppendUnits(one[0..1])?;
        }
        return self.AppendUnits(units);
    }

    /// Gives the block back and leaves an empty buffer.
    /// @see https://rux-lang.dev/docs/api/path/path-buffer/release
    pub func Release(self: &var PathBuffer) {
        if self.data != null {
            let unitSize = sizeof(OsUnit) as uint;
            let layout = Layout::New(self.capacity * unitSize, alignof(OsUnit) as uint);
            var borrowed = self.allocator;
            borrowed.Deallocate(self.data as *var opaque,
                                (layout ?? Layout { size: self.capacity * unitSize, alignment: 1 })) catch { else => {} };
        }
        self.data = null;
        self.length = 0;
        self.capacity = 0;
    }

    /// Gives the block back.
    /// @see https://rux-lang.dev/docs/api/path/path-buffer/destructor
    func ~PathBuffer(self: &var PathBuffer) {
        self.Release();
    }
}

/// A fresh buffer holding `base` with `segment` pushed onto it.
/// The join every path library means: a separator supplied where one is missing, and an absolute `segment`
/// replacing `base` entirely.
/// @param allocator where the storage comes from
/// @param base the path to extend
/// @param segment the component to append
/// @returns `base` with `segment` appended, or why it could not be
/// @see https://rux-lang.dev/docs/api/path/join
pub func Join(allocator: Allocator, base: Path, segment: OsStringView) -> PathBuffer ! TextError {
    var buffer = PathBuffer::FromPath(allocator, base)?;
    buffer.Push(segment)?;
    return <-buffer;
}

/// A fresh buffer holding `path` lexically simplified: separator runs collapsed to the preferred separator, `.`
/// segments dropped, and `..` resolved against the segment before it.
/// Lexically is the load-bearing word. Dropping `x/..` is the truth about directories and a lie about symbolic
/// links — `a/link/..` need not be `a` when `link` points elsewhere — so this is for display, comparison and
/// deduplication, and the filesystem-true answer is canonicalization, which asks the system. A `..` with nothing
/// before it survives in a relative path and vanishes at the root, where there is nowhere further up.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @returns the path with its redundant components resolved, or why it could not be
/// @see https://rux-lang.dev/docs/api/path/normalize
pub func Normalize(allocator: Allocator, path: Path) -> PathBuffer ! TextError {
    var buffer = PathBuffer(allocator);

    let units = path.AsView().Units();
    let absolute = units.length > 0 && IsSeparator(units.data[0]);
    if absolute {
        var one: OsUnit[1];
        one[0] = PreferredSeparator();
        buffer.AppendUnits(one[0..1])?;
    }

    // How many real segments the buffer holds, and where each begins, tracked so `..` can drop the last one
    // without re-walking. A path's depth is bounded by its length, so the starts live on the stack up to a depth
    // no real path exceeds; one deeper falls back to keeping the `..` textual, which is still correct, just less
    // simplified.
    var starts: uint[64];
    var depth: uint = 0;

    var walker = path.Components();
    var walking = true;
    while walking {
        match walker.Next() {
            .Some(segment) => {
                var piece = segment;
                if piece.Length() == 0 {
                    // The root component, already written.
                }
                else if IsDot(piece) {
                    // `.` names where we already are.
                }
                else if IsDoubleDot(piece) {
                    if depth > 0 {
                        // Drop the segment before, and the separator that introduced it.
                        var cut = starts[depth - 1];
                        if cut > 0 && !(absolute && cut == 1) {
                            cut = cut - 1;
                        }
                        buffer.length = cut;
                        depth = depth - 1;
                    }
                    else if !absolute {
                        // Nothing to climb out of: the `..` is the path's meaning and stays.
                        buffer.Push(piece)?;
                    }
                    // At the root, `..` goes nowhere and vanishes.
                }
                else {
                    if depth < 64 {
                        let opening = buffer.Length() +
                                      (buffer.IsEmpty() || IsSeparator(buffer.data[buffer.Length() - 1]) ? 0u : 1u);
                        starts[depth] = opening;
                        depth = depth + 1;
                    }
                    buffer.Push(piece)?;
                }
            },
            none => {
                walking = false;
            }
        }
    }
    return <-buffer;
}

// Whether a segment is exactly `.` or exactly `..`, in native units.
func IsDot(segment: OsStringView) -> bool {
    let units = segment.Units();
    return units.length == 1 && (units.data[0] as uint32) == 0x2E;
}

func IsDoubleDot(segment: OsStringView) -> bool {
    let units = segment.Units();
    return units.length == 2 && (units.data[0] as uint32) == 0x2E && (units.data[1] as uint32) == 0x2E;
}
