// The named parts of a path, and the joins and simplifications that stay lexical.
//
// Everything here reads units and produces views into them or fresh buffers from them; nothing asks the
// filesystem anything. That matters most for `Normalize`: it resolves `..` by dropping the segment before it,
// which is the truth about directories and a lie about symbolic links -- `a/link/..` need not be `a` when `link`
// points elsewhere. The lie is documented, deliberate, and cheap; the truth costs a filesystem and arrives with
// canonicalization in the S tasks.

import Allocator::Allocator;
import Core::{ Option, Slice };
import Text::TextError;

extend Path {
    /// This path without its last component, or `None` where nothing is left to remove.
    ///
    /// The parent of `/a` is `/`, and the root's parent is `None`: the root is not inside anything. The parent of
    /// a bare segment is the empty path, which is what lets a loop walk parents to a fixed end.
    ///
    /// https://rux-lang.dev/docs/api/path/path/parent
    func Parent(self: *Path) -> Option<Path> {
        let units = self.name.Units();
        var end = units.length;
        // Trailing separators say nothing about parenthood.
        while end > 1 && IsSeparator(units.data[end - 1]) {
            end = end - 1;
        }
        if end == 0 {
            return Option::None<Path>();
        }
        if end == 1 && IsSeparator(units.data[0]) {
            return Option::None<Path>();
        }
        // Walk back over the last segment, then over the separators before it -- keeping the one that is the root.
        while end > 0 && !IsSeparator(units.data[end - 1]) {
            end = end - 1;
        }
        while end > 1 && IsSeparator(units.data[end - 1]) {
            end = end - 1;
        }
        let kept = Slice<OsUnit> { data: units.data, length: end };
        return Option::Some<Path>(Path::FromView(OsStringView::FromUnits(kept)));
    }

    /// The last component's name, or `None` for the empty path and the root.
    ///
    /// Trailing separators are ignored: `a/b/` names `b`, because that is what everything from shells to
    /// libraries has always meant by it.
    ///
    /// https://rux-lang.dev/docs/api/path/path/file-name
    func FileName(self: *Path) -> Option<OsStringView> {
        let units = self.name.Units();
        var end = units.length;
        while end > 0 && IsSeparator(units.data[end - 1]) {
            end = end - 1;
        }
        if end == 0 {
            return Option::None<OsStringView>();
        }
        var start = end;
        while start > 0 && !IsSeparator(units.data[start - 1]) {
            start = start - 1;
        }
        let name = Slice<OsUnit> { data: @units.data[start], length: end - start };
        return Option::Some<OsStringView>(OsStringView::FromUnits(name));
    }

    /// The file name before its extension, or `None` where there is no file name.
    ///
    /// A leading dot is part of the name, not an extension marker: the stem of `.bashrc` is `.bashrc`. Of
    /// `a.tar.gz` it is `a.tar` -- one extension comes off, the last.
    ///
    /// https://rux-lang.dev/docs/api/path/path/stem
    func Stem(self: *Path) -> Option<OsStringView> {
        let name = self.FileName();
        if name.IsNone() {
            return Option::None<OsStringView>();
        }
        let whole = name.ValueOr(OsStringView::New());
        let units = whole.Units();
        let cut = LastDot(units);
        if cut == 0 || cut >= units.length {
            return Option::Some<OsStringView>(whole);
        }
        let kept = Slice<OsUnit> { data: units.data, length: cut };
        return Option::Some<OsStringView>(OsStringView::FromUnits(kept));
    }

    /// The extension after the last dot, without the dot, or `None` where there is none.
    ///
    /// `None` for `.bashrc` and for `Makefile` alike: a name that is all extension has none.
    ///
    /// https://rux-lang.dev/docs/api/path/path/extension
    func Extension(self: *Path) -> Option<OsStringView> {
        let name = self.FileName();
        if name.IsNone() {
            return Option::None<OsStringView>();
        }
        let whole = name.ValueOr(OsStringView::New());
        let units = whole.Units();
        let cut = LastDot(units);
        if cut == 0 || cut >= units.length {
            return Option::None<OsStringView>();
        }
        let kept = Slice<OsUnit> { data: @units.data[cut + 1], length: units.length - cut - 1 };
        return Option::Some<OsStringView>(OsStringView::FromUnits(kept));
    }
}

// The index of the last dot that marks an extension: past position zero, so a leading dot is a name. The length
// stands for "no dot".
func LastDot(units: Slice<OsUnit>) -> uint {
    var index = units.length;
    while index > 1 {
        index = index - 1;
        let dot = units.data[index] as uint32;
        if dot == 0x2E {
            return index;
        }
    }
    return units.length;
}

/// A fresh buffer holding `base` with `segment` pushed onto it.
///
/// The join every path library means: a separator supplied where one is missing, and an absolute `segment`
/// replacing `base` entirely.
///
/// https://rux-lang.dev/docs/api/path/join
func Join(allocator: Allocator, base: Path, segment: OsStringView, error: *var TextError) -> PathBuffer {
    var buffer = PathBuffer::FromPath(allocator, base, error);
    if error.IsError() {
        return buffer;
    }
    *error = buffer.Push(segment);
    return buffer;
}

/// A fresh buffer holding `path` lexically simplified: separator runs collapsed to the preferred separator, `.`
/// segments dropped, and `..` resolved against the segment before it.
///
/// Lexically is the load-bearing word. Dropping `x/..` is the truth about directories and a lie about symbolic
/// links -- `a/link/..` need not be `a` when `link` points elsewhere -- so this is for display, comparison and
/// deduplication, and the filesystem-true answer is canonicalization, which asks the system. A `..` with nothing
/// before it survives in a relative path and vanishes at the root, where there is nowhere further up.
///
/// https://rux-lang.dev/docs/api/path/normalize
func Normalize(allocator: Allocator, path: Path, error: *var TextError) -> PathBuffer {
    var buffer = PathBuffer::New(allocator);
    *error = TextError::None;

    let units = path.AsView().Units();
    let absolute = units.length > 0 && IsSeparator(units.data[0]);
    if absolute {
        var one: OsUnit[1];
        one[0] = PreferredSeparator();
        *error = buffer.AppendUnits(one[0..1]);
        if error.IsError() {
            return buffer;
        }
    }

    // How many real segments the buffer holds, and where each begins, tracked so `..` can drop the last one
    // without re-walking. A path's depth is bounded by its length, so the starts live on the stack up to a depth
    // no real path exceeds; one deeper falls back to keeping the `..` textual, which is still correct, just less
    // simplified.
    var starts: uint[64];
    var depth: uint = 0;

    var walker = path.Components();
    var walking = true;
    while walking {
        match walker.Next() {
            .Some(segment) => {
                var piece = segment;
                if piece.Length() == 0 {
                    // The root component, already written.
                }
                else if IsDot(piece) {
                    // `.` names where we already are.
                }
                else if IsDoubleDot(piece) {
                    if depth > 0 {
                        // Drop the segment before, and the separator that introduced it.
                        var cut = starts[depth - 1];
                        if cut > 0 && !(absolute && cut == 1) {
                            cut = cut - 1;
                        }
                        buffer.length = cut;
                        depth = depth - 1;
                    }
                    else if !absolute {
                        // Nothing to climb out of: the `..` is the path's meaning and stays.
                        let pushed = buffer.Push(piece);
                        if pushed.IsError() {
                            *error = pushed;
                            return buffer;
                        }
                    }
                    // At the root, `..` goes nowhere and vanishes.
                }
                else {
                    if depth < 64 {
                        let opening = buffer.Length() +
                                      (buffer.IsEmpty() || IsSeparator(buffer.data[buffer.Length() - 1]) ? 0u : 1u);
                        starts[depth] = opening;
                        depth = depth + 1;
                    }
                    let pushed = buffer.Push(piece);
                    if pushed.IsError() {
                        *error = pushed;
                        return buffer;
                    }
                }
            },
            .None => {
                walking = false;
            }
        }
    }
    return buffer;
}

// Whether a segment is exactly `.` or exactly `..`, in native units.
func IsDot(segment: OsStringView) -> bool {
    let units = segment.Units();
    return units.length == 1 && (units.data[0] as uint32) == 0x2E;
}

func IsDoubleDot(segment: OsStringView) -> bool {
    let units = segment.Units();
    return units.length == 2 && (units.data[0] as uint32) == 0x2E && (units.data[1] as uint32) == 0x2E;
}
