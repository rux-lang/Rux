// Help, usage and version text, written from the same description the arguments are checked against.
// The layout is the conventional one: the summary, a usage line, then the arguments, options and subcommands, each in
// two columns with the descriptions aligned. `--help` and `--version` are listed with the options a command declares,
// unless it declares its own of the same name.

import Text::{ FormatError, TextWriter, WriteAscii, WriteBytes, WriteScalar };

// Writes `count` spaces.
func WriteSpaces(writer: &var TextWriter, count: uint) throws FormatError {
    var written: uint = 0;
    while written < count {
        try WriteAscii(writer, c8' ');
        written = written + 1;
    }
    return;
}

// How wide an option's left column is: `-o, --output <FILE>`, with room for the short form whether there is one.
func OptionWidth(option: &OptionSpec) -> uint {
    var width = 6 + option.name.length;
    if option.value.length > 0 {
        width = width + 3 + option.value.length;
    }
    return width;
}

// Writes an option's left column.
func WriteOptionColumn(writer: &var TextWriter, option: &OptionSpec) throws FormatError {
    if option.short != '\0' {
        try WriteAscii(writer, c8'-');
        try WriteScalar(writer, option.short);
        try WriteBytes(writer, ", --");
    }
    else {
        try WriteBytes(writer, "    --");
    }
    try WriteBytes(writer, option.name);
    if option.value.length > 0 {
        try WriteBytes(writer, " <");
        try WriteBytes(writer, option.value);
        try WriteAscii(writer, c8'>');
    }
    return;
}

// The two built-in options as they are listed, when the command does not declare its own.
func HelpOptionSpec() -> OptionSpec {
    return Flag("help", 'h', "Print this help");
}

func VersionOptionSpec() -> OptionSpec {
    return Flag("version", 'V', "Print the version");
}

// Whether the command declares an option of this long name itself.
func Declares(spec: &CommandSpec, name: char8[..]) -> bool {
    return match OptionIndex(spec, name) {
        .Some(_) => true,
        none => false
    };
}

// How wide a positional is as the usage line writes it.
func PositionalWidth(positional: &PositionalSpec) -> uint {
    return positional.name.length + (if positional.kind == PositionalKind::Remaining { 5 } else { 2 });
}

// How a positional is written in the usage line: `<name>`, `[name]` or `[name...]`.
func WritePositionalUsage(writer: &var TextWriter, positional: &PositionalSpec) throws FormatError {
    match positional.kind {
        .Required => {
            try WriteAscii(writer, c8'<');
            try WriteBytes(writer, positional.name);
            try WriteAscii(writer, c8'>');
        },
        .Optional => {
            try WriteAscii(writer, c8'[');
            try WriteBytes(writer, positional.name);
            try WriteAscii(writer, c8']');
        },
        .Remaining => {
            try WriteAscii(writer, c8'[');
            try WriteBytes(writer, positional.name);
            try WriteBytes(writer, "...]");
        }
    }
    return;
}

/// Writes the usage line, such as `Usage: tool [options] <input> [output]`.
/// `parent` names the command a subcommand belongs to, so that its usage reads `tool build ...`; it is empty for the
/// program itself. Reports whatever the writer reported.
/// @param spec the command
/// @param writer the destination
/// @param parent the name of the command this one is a subcommand of, or empty
/// @returns success when the whole line was accepted
/// @see https://rux-lang.dev/docs/api/commandline/help#write-usage
pub func WriteUsage(spec: &CommandSpec, writer: &var TextWriter, parent: char8[..] = "") throws FormatError {
    try WriteBytes(writer, "Usage: ");
    if parent.length > 0 {
        try WriteBytes(writer, parent);
        try WriteAscii(writer, c8' ');
    }
    try WriteBytes(writer, spec.name);
    try WriteBytes(writer, " [options]");
    for positional in spec.positionals {
        try WriteAscii(writer, c8' ');
        try WritePositionalUsage(writer, positional);
    }
    if spec.commands.length > 0 {
        try WriteBytes(writer, " <command>");
    }
    try WriteAscii(writer, c8'\n');
    return;
}

/// Writes the full help text: the summary, the usage line, and the arguments, options and subcommands with their
/// descriptions aligned.
/// Reports whatever the writer reported. Allocates nothing.
/// @param spec the command
/// @param writer the destination
/// @param parent the name of the command this one is a subcommand of, or empty
/// @returns success when the whole text was accepted
/// @see https://rux-lang.dev/docs/api/commandline/help#write-help
pub func WriteHelp(spec: &CommandSpec, writer: &var TextWriter, parent: char8[..] = "") throws FormatError {
    if spec.summary.length > 0 {
        try WriteBytes(writer, spec.summary);
        try WriteBytes(writer, "\n\n");
    }
    try WriteUsage(spec, writer, parent);

    if spec.positionals.length > 0 {
        var width: uint = 0;
        for positional in spec.positionals {
            width = if PositionalWidth(positional) > width { PositionalWidth(positional) } else { width };
        }
        try WriteBytes(writer, "\nArguments:\n");
        for positional in spec.positionals {
            try WriteBytes(writer, "  ");
            try WritePositionalUsage(writer, positional);
            try WriteSpaces(writer, width - PositionalWidth(positional) + 2);
            try WriteBytes(writer, positional.help);
            try WriteAscii(writer, c8'\n');
        }
    }

    let help = HelpOptionSpec();
    let version = VersionOptionSpec();
    let listsHelp = !Declares(spec, "help");
    let listsVersion = spec.version.length > 0 && !Declares(spec, "version");
    var width: uint = 0;
    for option in spec.options {
        width = if OptionWidth(option) > width { OptionWidth(option) } else { width };
    }
    if listsHelp && OptionWidth(help) > width {
        width = OptionWidth(help);
    }
    if listsVersion && OptionWidth(version) > width {
        width = OptionWidth(version);
    }
    try WriteBytes(writer, "\nOptions:\n");
    for option in spec.options {
        try WriteBytes(writer, "  ");
        try WriteOptionColumn(writer, option);
        try WriteSpaces(writer, width - OptionWidth(option) + 2);
        try WriteBytes(writer, option.help);
        try WriteAscii(writer, c8'\n');
    }
    if listsHelp {
        try WriteBytes(writer, "  ");
        try WriteOptionColumn(writer, help);
        try WriteSpaces(writer, width - OptionWidth(help) + 2);
        try WriteBytes(writer, help.help);
        try WriteAscii(writer, c8'\n');
    }
    if listsVersion {
        try WriteBytes(writer, "  ");
        try WriteOptionColumn(writer, version);
        try WriteSpaces(writer, width - OptionWidth(version) + 2);
        try WriteBytes(writer, version.help);
        try WriteAscii(writer, c8'\n');
    }

    if spec.commands.length > 0 {
        var commandWidth: uint = 0;
        for command in spec.commands {
            commandWidth = if command.name.length > commandWidth { command.name.length } else { commandWidth };
        }
        try WriteBytes(writer, "\nCommands:\n");
        for command in spec.commands {
            try WriteBytes(writer, "  ");
            try WriteBytes(writer, command.name);
            try WriteSpaces(writer, commandWidth - command.name.length + 2);
            try WriteBytes(writer, command.summary);
            try WriteAscii(writer, c8'\n');
        }
    }
    return;
}

/// Writes the version line, such as `tool 1.4.2`.
/// Reports whatever the writer reported.
/// @param spec the command
/// @param writer the destination
/// @returns success when the whole line was accepted
/// @see https://rux-lang.dev/docs/api/commandline/help#write-version
pub func WriteVersion(spec: &CommandSpec, writer: &var TextWriter) throws FormatError {
    try WriteBytes(writer, spec.name);
    if spec.version.length > 0 {
        try WriteAscii(writer, c8' ');
        try WriteBytes(writer, spec.version);
    }
    try WriteAscii(writer, c8'\n');
    return;
}

extend Parsed {
    /// Writes the help text of the command this parse is for, naming its parent in the usage line when it is a
    /// subcommand.
    /// Reports whatever the writer reported.
    /// @param writer the destination
    /// @returns success when the whole text was accepted
    /// @see https://rux-lang.dev/docs/api/commandline/parsed#write-help
    pub func WriteHelp(&self, writer: &var TextWriter) throws FormatError {
        // Safety: `self.parent`, tested for null here, is the `CommandSpec` whose `commands` hold this parse's command,
        // and the documented contract of `Parse` keeps it alive for as long as the `Parsed` result.
        let parent = if self.parent == null { "" } else { unsafe { self.parent.name } };
        let declared = self.Declared();
        return try WriteHelp(declared, writer, parent);
    }
}
