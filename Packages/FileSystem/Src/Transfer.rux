// Moving file content and names around: copy, rename, and the two kinds of link.
// The follow policies are stated rather than inherited. `CopyFile` follows a symbolic link and copies what it
// points at, because copying the pointer would surprise every caller who asked for the bytes. `CreateHardLink`
// does not follow: it links the name given, symbolic link and all, because a caller linking a link said so.
// `DeleteFile` was already documented to remove the name, never the target. `Rename` moves the name whatever it
// names, atomically within a volume, which is what makes it the publishing step of atomic replacement.

import Allocator::{ AllocError, Allocator, Layout };
import Core::{ #target };
import Io::{ IoError, IoErrorKind, WriteAll, Writer };
import Path::{ OsUnit, Path };

when #target.os {
    .FreeBSD => import FreeBSD::{ AtFdCwd, LinkAt, RenameAt, SymlinkAt },
    .Linux => import Linux::{ AtFdCwd, LinkAt, RenameAt, SymlinkAt },
    .macOS => import macOS::{ AtFdCwd, LinkAt, RenameAt, SymlinkAt },
    .Windows => import Windows::{ CopyFileW, CreateHardLinkW, CreateSymbolicLinkW, GetLastError,
                                  MOVEFILE_REPLACE_EXISTING, MoveFileExW, SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE,
                                  SYMBOLIC_LINK_FLAG_DIRECTORY }
}

/// Renames `from` to `to`, moving it between directories if the paths differ there.
/// An existing `to` is replaced, atomically within one volume: a reader sees the old file or the new, never a
/// gap. Across volumes Windows copies and deletes instead — not atomic — and the Unix systems refuse.
/// @param allocator where the storage comes from
/// @param from the path that exists now
/// @param to the path it should have afterwards
/// @returns success when the file is at its new path
/// @see https://rux-lang.dev/docs/api/filesystem/file-operations#rename
pub func Rename(allocator: Allocator, from: Path, to: Path) -> ! IoError {
    let fromNative = NativePath(allocator, from)?;
    defer ReleaseNativePath(allocator, fromNative, from.name.units.length);
    let toNative = NativePath(allocator, to)?;
    defer ReleaseNativePath(allocator, toNative, to.name.units.length);
    when #target.os == .Windows {
        // Safety: `fromNative` and `toNative` are the NUL-terminated UTF-16 copies `NativePath` made above, live until
        // the deferred releases, and a `uint16` unit is a `char16`.
        if unsafe { MoveFileExW(fromNative as *char16, toNative as *char16, MOVEFILE_REPLACE_EXISTING) } == 0 {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            fail TranslateNative(unsafe { GetLastError() } as int32);
        }
    }
    else {
        // Safety: `fromNative` and `toNative` are the NUL-terminated copies `NativePath` made above, live until the
        // deferred releases.
        let result = unsafe { RenameAt(AtFdCwd, fromNative as *char8, AtFdCwd, toNative as *char8) };
        if result < 0 {
            fail TranslateNative((0 - result) as int32);
        }
    }
}

/// Creates `link` as a hard link: a second name for the file `existing` names.
/// The two names are then equals — neither is "the original" — and the content lives until the last name is
/// deleted. A symbolic link at `existing` is not followed: the link is made to the name given. Directories
/// cannot be hard-linked on any supported system.
/// @param allocator where the storage comes from
/// @param existing the file that exists now
/// @param link the link to create
/// @returns success when the new name refers to the same file
/// @see https://rux-lang.dev/docs/api/filesystem/file-operations#create-hard-link
pub func CreateHardLink(allocator: Allocator, existing: Path, link: Path) -> ! IoError {
    let existingNative = NativePath(allocator, existing)?;
    defer ReleaseNativePath(allocator, existingNative, existing.name.units.length);
    let linkNative = NativePath(allocator, link)?;
    defer ReleaseNativePath(allocator, linkNative, link.name.units.length);
    when #target.os == .Windows {
        // Safety: `linkNative` and `existingNative` are the NUL-terminated UTF-16 copies `NativePath` made above,
        // live until the deferred releases, and a `uint16` unit is a `char16`.
        if unsafe { CreateHardLinkW(linkNative as *char16, existingNative as *char16, null) } == 0 {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            fail TranslateNative(unsafe { GetLastError() } as int32);
        }
    }
    else {
        // Safety: `existingNative` and `linkNative` are the NUL-terminated copies `NativePath` made above, live
        // until the deferred releases.
        let result = unsafe { LinkAt(AtFdCwd, existingNative as *char8, AtFdCwd, linkNative as *char8, 0) };
        if result < 0 {
            fail TranslateNative((0 - result) as int32);
        }
    }
}

/// Creates `link` as a symbolic link holding `target` as its text.
/// The target is stored, not checked: a dangling link is created as readily as a good one. `targetIsDirectory`
/// matters only on Windows, which types its links; the Unix systems ignore it. Windows also gates creation
/// behind a privilege unless the machine runs Developer Mode, so `PermissionDenied` here is an environment, not
/// a bug.
/// @param allocator where the storage comes from
/// @param target the path the link will point at, which need not exist
/// @param link the link to create
/// @param targetIsDirectory whether the target is a directory, which Windows must be told in advance
/// @returns success when the link was created; Windows needs a privilege for this
/// @see https://rux-lang.dev/docs/api/filesystem/file-operations#create-symbolic-link
pub func CreateSymbolicLink(allocator: Allocator, target: Path, link: Path, targetIsDirectory: bool) -> ! IoError {
    let targetNative = NativePath(allocator, target)?;
    defer ReleaseNativePath(allocator, targetNative, target.name.units.length);
    let linkNative = NativePath(allocator, link)?;
    defer ReleaseNativePath(allocator, linkNative, link.name.units.length);
    when #target.os == .Windows {
        var flags = SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE;
        if targetIsDirectory {
            flags = flags | SYMBOLIC_LINK_FLAG_DIRECTORY;
        }
        // Safety: `linkNative` and `targetNative` are the NUL-terminated UTF-16 copies `NativePath` made above,
        // live until the deferred releases, and a `uint16` unit is a `char16`.
        if unsafe { CreateSymbolicLinkW(linkNative as *char16, targetNative as *char16, flags) } == 0 {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            fail TranslateNative(unsafe { GetLastError() } as int32);
        }
    }
    else {
        // Safety: `targetNative` and `linkNative` are the NUL-terminated copies `NativePath` made above, live until the
        // deferred releases.
        let result = unsafe { SymlinkAt(targetNative as *char8, AtFdCwd, linkNative as *char8) };
        if result < 0 {
            fail TranslateNative((0 - result) as int32);
        }
    }
}

/// Copies the file `from` names to `to`, following a symbolic link to the bytes it points at.
/// An existing `to` is replaced. The copy is the bytes and nothing else: permissions, timestamps and the rest of
/// the metadata are the destination's own, fresh — carrying them is a policy the metadata work owns.
/// @param allocator where the storage comes from
/// @param from the path that exists now
/// @param to the path it should have afterwards
/// @returns success when the destination holds a copy
/// @see https://rux-lang.dev/docs/api/filesystem/file-operations#copy-file
pub func CopyFile(allocator: Allocator, from: Path, to: Path) -> ! IoError {
    when #target.os == .Windows {
        let fromNative = NativePath(allocator, from)?;
        defer ReleaseNativePath(allocator, fromNative, from.name.units.length);
        let toNative = NativePath(allocator, to)?;
        defer ReleaseNativePath(allocator, toNative, to.name.units.length);
        // Safety: `fromNative` and `toNative` are the NUL-terminated UTF-16 copies `NativePath` made above, live until
        // the deferred releases, and a `uint16` unit is a `char16`.
        if unsafe { CopyFileW(fromNative as *char16, toNative as *char16, 0) } == 0 {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            fail TranslateNative(unsafe { GetLastError() } as int32);
        }
    }
    else {
        // A file opened here and abandoned by a failure is closed by its destructor.
        var source = File::Open(allocator, from, OpenOptions::Reading())?;
        var destination = File::Open(allocator, to, OpenOptions::Writing())?;

        let layout = Layout { size: 65536, alignment: 8 };
        var borrowed = allocator;
        let block = borrowed.Allocate(layout) catch { _ => fail IoError::Of(IoErrorKind::Other) };
        // Safety: `block` is a fresh allocation of `layout`, 65536 bytes, released only after the loop below.
        let buffer = unsafe { (block as *var char8)[..65536] };

        var failure: IoError? = none;
        var copying = true;
        while copying {
            match source.Read(buffer) {
                .Success(filled) => {
                    // A read of zero is the end however the stream says it, rather than a reason to ask again.
                    if filled == 0 {
                        copying = false;
                    }
                    else {
                        let piece = buffer[0..filled];
                        WriteAll(destination, piece) catch {
                            error => {
                                failure = error;
                                copying = false;
                            }
                        };
                    }
                },
                .Failure(error) => {
                    if error.IsEnd() {
                        copying = false;
                    }
                    else if !error.IsInterrupted() {
                        failure = error;
                        copying = false;
                    }
                }
            }
        }

        borrowed.Deallocate(block, layout) catch { _ => {} };
        // Both files close whatever happened; a close failure is reported only when the copy itself went through.
        let closedSource = source.Close();
        let closedDestination = destination.Close();
        match failure {
            .Some(error) => fail error,
            none => {}
        }
        closedSource?;
        closedDestination?;
    }
}
