// The open file as the streams everything else already speaks.
// `File` implements `Reader`, `Writer` and `Seeker`, which is the whole point of those interfaces: the buffered
// pair, line reading, binary values and format writing all stack on a file exactly as they stacked on memory and
// the standard streams, none of them knowing the difference. Reads and writes are one attempt each, partial on
// purpose — the looping belongs to `ReadExact` and `WriteAll`, written once for every stream.
// `Flush` reports nothing gathered, because nothing is: these writes go to the platform as they are made. What a
// caller usually wants after writing is `Sync`, which is a different promise — not "handed to the kernel" but
// "acknowledged by the device", the one that holds through a power failure.

import Core::{ #target };
import Io::{ IoError, IoErrorKind, Reader, SeekFrom, Seeker, Writer };

when #target.os {
    .FreeBSD => import FreeBSD::{ Fsync, Ftruncate, Lseek, Read, SeekCurrent, SeekEnd, SeekSet, Write },
    .Linux => import Linux::{ Fsync, Ftruncate, Lseek, Read, SeekCurrent, SeekEnd, SeekSet, Write },
    .macOS => import macOS::{ Fsync, Ftruncate, Lseek, Read, SeekCurrent, SeekEnd, SeekSet, Write },
    .Windows => import Windows::{ FlushFileBuffers, GetFileSizeEx, GetLastError, ReadFile, SetEndOfFile,
                                  SetFilePointerEx, WriteFile }
}

// The one closed-handle answer, so every operation refuses the same way.
func ClosedFile() -> IoError {
    return IoError::Of(IoErrorKind::InvalidHandle);
}

extend File : Reader {
    /// Reads what one attempt yields into `into`; a short count is not an error and the end is `EndOfStream`.
    /// @param into receives the bytes
    /// @returns how many bytes were read; `IsEnd` at the end of the file
    /// @see https://rux-lang.dev/docs/api/filesystem/file#read
    pub func Read(&var self, into: var char8[..]) -> uint throws IoError {
        if !self.open { throw ClosedFile(); }
        if into.length == 0 { return 0; }
        when #target.os == .Windows {
            let count = if into.length > 0x40000000 { 0x40000000u32 } else { into.length as uint32 };
            var read: uint32 = 0;
            // Safety: `handle` is this file's open handle, `open` was checked above; `into` is writable for
            // `into.length` bytes and `count` is at most that; `read` is a local `uint32`.
            let accepted = unsafe { ReadFile(self.handle, into.data as *var opaque, count, @read, null) };
            if !accepted {
                // Safety: `GetLastError` takes nothing and reads this thread's last error code.
                let raw = unsafe { GetLastError() } as int32;
                // A pipe whose writing end closed reports through a failure; for a reader it is the end.
                if raw == 109 { throw IoError::Of(IoErrorKind::EndOfStream); }
                throw TranslateNative(raw);
            }
            if read == 0 { throw IoError::Of(IoErrorKind::EndOfStream); }
            return read as uint;
        }
        else {
            // Safety: `handle` is this file's open descriptor, `open` was checked above, and `into` is writable for
            // `into.length` bytes.
            let result = unsafe { Read(self.handle, into.data as *var opaque, into.length) };
            if result < 0 { throw TranslateNative((0 - result) as int32); }
            if result == 0 { throw IoError::Of(IoErrorKind::EndOfStream); }
            return result as uint;
        }
    }
}

extend File : Writer {
    /// Writes what one attempt takes of `bytes`; a short count means call again, which `WriteAll` does.
    /// @param bytes the bytes to write
    /// @returns how many bytes were taken, which may be fewer than offered
    /// @see https://rux-lang.dev/docs/api/filesystem/file#write
    pub func Write(&var self, bytes: char8[..]) -> uint throws IoError {
        if !self.open { throw ClosedFile(); }
        if bytes.length == 0 { return 0; }
        when #target.os == .Windows {
            let count = if bytes.length > 0x40000000 { 0x40000000u32 } else { bytes.length as uint32 };
            var written: uint32 = 0;
            // Safety: `handle` is this file's open handle, `open` was checked above; `bytes` is readable for
            // `bytes.length` bytes and `count` is at most that; `written` is a local `uint32`.
            let accepted = unsafe { WriteFile(self.handle, bytes.data as *opaque, count, @written, null) };
            if !accepted {
                // Safety: `GetLastError` takes nothing and reads this thread's last error code.
                throw TranslateNative(unsafe { GetLastError() } as int32);
            }
            return written as uint;
        }
        else {
            // Safety: `handle` is this file's open descriptor, `open` was checked above, and `bytes` is readable
            // for `bytes.length` bytes.
            let result = unsafe { Write(self.handle, bytes.data as *opaque, bytes.length) };
            if result < 0 { throw TranslateNative((0i64 - result) as int32); }
            return result as uint;
        }
    }

    /// Nothing: these writes hold nothing back. Durability is `Sync`, which is a different promise.
    /// @returns success when everything written reached the system
    /// @see https://rux-lang.dev/docs/api/filesystem/file#flush
    pub func Flush(&var self) throws IoError {
        if !self.open { throw ClosedFile(); }
    }
}

extend File : Seeker {
    /// Moves the position `offset` bytes from `origin` and reports where it landed.
    /// A position before the start of the file is refused by the platform; one past the end is allowed, and a
    /// later write there leaves a hole. A handle opened for appending still seeks — but its writes land at the
    /// end regardless, because append is a property of the writes, not of the position.
    /// @param origin where the offset is measured from
    /// @param offset how far to move
    /// @returns the resulting offset from the start
    /// @see https://rux-lang.dev/docs/api/filesystem/file#seek
    pub func Seek(&var self, origin: SeekFrom, offset: int64) -> uint64 throws IoError {
        if !self.open { throw ClosedFile(); }
        when #target.os == .Windows {
            var landed: int64 = 0;
            // Safety: `handle` is this file's open handle, `open` was checked above, and `landed` is a local `int64`.
            let moved = unsafe { SetFilePointerEx(self.handle, offset, @landed, origin as int32 as uint32) };
            if !moved {
                // Safety: `GetLastError` takes nothing and reads this thread's last error code.
                throw TranslateNative(unsafe { GetLastError() } as int32);
            }
            return landed as uint64;
        }
        else {
            var whence = SeekSet;
            if origin == SeekFrom::Current {
                whence = SeekCurrent;
            }
            else if origin == SeekFrom::End {
                whence = SeekEnd;
            }
            let landed = Lseek(self.handle, offset, whence);
            if landed < 0 { throw TranslateNative((0 - landed) as int32); }
            return landed as uint64;
        }
    }
}

extend File {
    /// Forces everything written through to the storage device.
    /// Not "handed to the kernel" but "acknowledged by the device": the promise that holds through a power
    /// failure, and the one a caller who just wrote something they cannot lose actually wants.
    /// @returns success when the system reported the data durable
    /// @see https://rux-lang.dev/docs/api/filesystem/file#sync
    pub func Sync(&var self) throws IoError {
        if !self.open { throw ClosedFile(); }
        when #target.os == .Windows {
            // Safety: `handle` is this file's open handle, `open` was checked above.
            let flushed = unsafe { FlushFileBuffers(self.handle) };
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            if flushed == 0 { throw TranslateNative(unsafe { GetLastError() } as int32); }
        }
        else {
            let result = Fsync(self.handle);
            if result < 0 { throw TranslateNative((0 - result) as int32); }
        }
    }

    /// The file's length in bytes.
    /// On the Unix systems this is measured by seeking to the end and back, which moves the shared kernel
    /// position for a moment; a reader racing this on the same open file may see it. The stat-based answer
    /// arrives with the metadata work.
    /// @returns the file's size in bytes
    /// @see https://rux-lang.dev/docs/api/filesystem/file#size
    pub func Size(&var self) -> uint64 throws IoError {
        if !self.open { throw ClosedFile(); }
        when #target.os == .Windows {
            var reported: int64 = 0;
            // Safety: `handle` is this file's open handle, `open` was checked above, and `reported` is a local `int64`.
            let measured = unsafe { GetFileSizeEx(self.handle, @reported) };
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            if !measured { throw TranslateNative(unsafe { GetLastError() } as int32); }
            return reported as uint64;
        }
        else {
            let held = Lseek(self.handle, 0, SeekCurrent);
            if held < 0 { throw TranslateNative((0 - held) as int32); }
            let end = Lseek(self.handle, 0, SeekEnd);
            if end < 0 { throw TranslateNative((0 - end) as int32); }
            let back = Lseek(self.handle, held, SeekSet);
            if back < 0 { throw TranslateNative((0 - back) as int32); }
            return end as uint64;
        }
    }

    /// Sets the file's length: shrinking discards what was past the new end, growing leaves a hole.
    /// The position does not move. A position past the new end stays where it was, and the next write there
    /// grows the file again — the same rule as seeking past the end.
    /// @param length the size the file should have afterwards
    /// @returns success when the file is that size; extending reads back as zeros
    /// @see https://rux-lang.dev/docs/api/filesystem/file#set-length
    pub func SetLength(&var self, length: uint64) throws IoError {
        if !self.open { throw ClosedFile(); }
        when #target.os == .Windows {
            // SetEndOfFile cuts at the current position, so the position moves there and back.
            var held: int64 = 0;
            // Safety: `handle` is this file's open handle, `open` was checked above, and `held` is a local `int64`.
            let measured = unsafe { SetFilePointerEx(self.handle, 0, @held, 1) };
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            if !measured { throw TranslateNative(unsafe { GetLastError() } as int32); }
            var landed: int64 = 0;
            // Safety: `handle` is this file's open handle, `open` was checked above, and `landed` is a local `int64`.
            let moved = unsafe { SetFilePointerEx(self.handle, length as int64, @landed, 0) };
            if !moved {
                // Safety: `GetLastError` takes nothing and reads this thread's last error code.
                throw TranslateNative(unsafe { GetLastError() } as int32);
            }
            // Safety: `handle` is this file's open handle, `open` was checked above.
            if unsafe { SetEndOfFile(self.handle as *var opaque) } == 0 {
                // Safety: `GetLastError` takes nothing and reads this thread's last error code.
                let raw = unsafe { GetLastError() } as int32;
                // Safety: `handle` is this file's open handle, `open` was checked above, and `landed` is a local
                // `int64`.
                unsafe { SetFilePointerEx(self.handle, held, @landed, 0); }
                throw TranslateNative(raw);
            }
            // Safety: `handle` is this file's open handle, `open` was checked above, and `landed` is a local `int64`.
            let restored = unsafe { SetFilePointerEx(self.handle, held, @landed, 0) };
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            if !restored { throw TranslateNative(unsafe { GetLastError() } as int32); }
        }
        else {
            let result = Ftruncate(self.handle, length as int64);
            if result < 0 { throw TranslateNative((0 - result) as int32); }
        }
    }

    /// A stored borrow of this file, for a value that must keep a stream beyond one call.
    /// For anything that only needs a stream for the duration of a call, borrow the file directly as
    /// `let sink: &var Writer = file;` instead: that is checked, and this is not.
    /// The file must outlive the result and must not be moved while it exists. See `FileStream`.
    /// @returns a stream over this file, holding its address, which is what makes it storable
    /// @see https://rux-lang.dev/docs/api/filesystem/file#stream
    pub func Stream(*var self) -> FileStream {
        return FileStream { file: self };
    }
}

/// A stored borrow of an open file that speaks the stream interfaces.
/// **Reach for this only when a stream has to be kept.** A `File` already implements `Reader`, `Writer` and
/// `Seeker`, so anything taking one for the duration of a call takes the file itself:
/// ```rux
/// let sink: &var Writer = file;
/// WriteAll(sink, contents);
/// ```
/// That borrows, and the file is still the caller's afterwards. What it cannot do is outlive the call, because a
/// reference cannot be stored in a field — so a `BufferedReader`, which keeps its source, needs a value it can
/// hold. Binding the file itself into an interface value would move it, since a `File` owns its handle and
/// prohibits copying, and the caller would no longer have a file to close. This is the value that fills that gap:
/// it holds the file's address rather than the file, so it can be stored, and the file stays where it is.
/// The address is private, and `File::Stream` is the only way to obtain one. That is deliberate: a `FileStream`
/// assembled from an arbitrary pointer would be an unchecked promise about a file that may not exist, and the type
/// is already the least checkable thing in this package without adding a second way to get it wrong.
/// The file must outlive the stream, and must not be moved while one exists — a move relocates the file and
/// leaves the stored address pointing at where it used to be. Nothing here tracks either, which is exactly why
/// this is not the default way to reach a file's streams. A stream over a closed file is not unsafe: every
/// operation refuses with `InvalidHandle`, because the file itself checks.
/// @see https://rux-lang.dev/docs/api/filesystem/file-stream
pub struct FileStream {
    /// The file being borrowed. Private, so `File::Stream` is the only way to make one.
    file: *var File;
}

extend FileStream : Reader {
    /// Reads through the borrowed file.
    /// @param into receives the bytes
    /// @returns how many bytes were read; `IsEnd` at the end of the file
    /// @see https://rux-lang.dev/docs/api/filesystem/file-stream#read
    pub func Read(&var self, into: var char8[..]) -> uint throws IoError {
        // Safety: the `FileStream` contract: the file `File::Stream` was called on outlives the stream and is not
        // moved while it exists.
        return try unsafe { (*self.file).Read(into) };
    }
}

extend FileStream : Writer {
    /// Writes through the borrowed file.
    /// @param bytes the bytes to write
    /// @returns how many bytes were taken, which may be fewer than offered
    /// @see https://rux-lang.dev/docs/api/filesystem/file-stream#write
    pub func Write(&var self, bytes: char8[..]) -> uint throws IoError {
        // Safety: the `FileStream` contract: the file `File::Stream` was called on outlives the stream and is not
        // moved while it exists.
        return try unsafe { (*self.file).Write(bytes) };
    }

    /// Flushes the borrowed file, which holds nothing back.
    /// @returns success when everything written reached the system
    /// @see https://rux-lang.dev/docs/api/filesystem/file-stream#flush
    pub func Flush(&var self) throws IoError {
        // Safety: the `FileStream` contract: the file `File::Stream` was called on outlives the stream and is not
        // moved while it exists.
        return try unsafe { (*self.file).Flush() };
    }
}

extend FileStream : Seeker {
    /// Seeks the borrowed file.
    /// @param origin where the offset is measured from
    /// @param offset how far to move
    /// @returns the resulting offset from the start
    /// @see https://rux-lang.dev/docs/api/filesystem/file-stream#seek
    pub func Seek(&var self, origin: SeekFrom, offset: int64) -> uint64 throws IoError {
        // Safety: the `FileStream` contract: the file `File::Stream` was called on outlives the stream and is not
        // moved while it exists.
        return try unsafe { (*self.file).Seek(origin, offset) };
    }
}
