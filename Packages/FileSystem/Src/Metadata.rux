// What a file is, when it was touched, and who may do what to it.
// The three systems disagree here more than anywhere else in this package, and the disagreement is reported
// rather than papered over. Unix permissions are nine bits of owner/group/other; Windows has access-control
// lists that the portable surface cannot express and one read-only attribute that it can. Rather than invent a
// lowest common denominator and lie about it, `Permissions` carries both spellings, `Capabilities` says which
// of them the running system actually honors, and a caller who cares can ask before it acts.
// Timestamps are read on every system and written where the system allows it. Creation time is the one field
// with no universal answer — Linux's `stat` does not carry it — so it arrives as a presence flag beside the
// value rather than as a zero that pretends to be a date.

import Allocator::Allocator;
import Core::{ #target };
import Io::{ IoError, IoErrorKind };
import Path::{ OsUnit, Path };
import Time::Timestamp;

when #target.os {
    .FreeBSD => import FreeBSD::{ AtFdCwd, FchmodAt, Fstat, FstatAt, SymlinkNoFollow, UtimensAt },
    .Linux => import Linux::{ AtFdCwd, FchmodAt, Fstat, FstatAt, SymlinkNoFollow, UtimensAt },
    .macOS => import macOS::{ AtFdCwd, FchmodAt, Fstat, FstatAt, SymlinkNoFollow, UtimensAt },
    .Windows => import Windows::{ CloseHandle, CreateFileW, CreationDisposition, FILE_ATTRIBUTE_DIRECTORY,
                                  FILE_ATTRIBUTE_NORMAL, FILE_ATTRIBUTE_READONLY, FILE_ATTRIBUTE_REPARSE_POINT,
                                  FILE_FLAG_BACKUP_SEMANTICS, FILE_FLAG_OPEN_REPARSE_POINT, FILE_SHARE_DELETE,
                                  FILE_SHARE_READ, FILE_SHARE_WRITE, FileTime, FileTimeToUnixEpochSeconds,
                                  GetFileAttributesW, GetFileInformationByHandle, GetLastError, INVALID_FILE_ATTRIBUTES,
                                  InvalidHandleValue, SetFileAttributesW, SetFileTime }
}

/// What kind of thing a name refers to.
/// @see https://rux-lang.dev/docs/api/filesystem/metadata#file-kind
pub enum FileKind: int32 {
    /// An ordinary file of bytes.
    File = 0,
    /// A directory.
    Directory = 1,
    /// A symbolic link — only ever reported by a no-follow query, since following one lands on its target.
    SymbolicLink = 2,
    /// A device, socket, pipe, or anything else the filesystem holds that is none of the above.
    Other = 3
}

/// Who may do what to a file, in both spellings the supported systems use.
/// `mode` is the Unix permission bits, the low nine of which are the owner/group/other triple. `readOnly` is
/// Windows' one portable attribute. Both are always filled: on Windows the mode is synthesized from the
/// attribute (`0o444` when read-only, `0o666` otherwise) so a program that reasons in Unix terms is not blocked,
/// and on Unix `readOnly` reports whether the owner-write bit is clear. `Capabilities` says which one is real.
/// @see https://rux-lang.dev/docs/api/filesystem/permissions
pub struct Permissions {
    /// The Unix permission bits.
    pub mode: uint32;
    /// Whether writing is refused.
    readOnly: bool;
}

extend Permissions {
    /// Permissions from Unix mode bits, with `readOnly` derived from the owner-write bit.
    /// @param mode the permission bits
    /// @returns permissions carrying those bits
    /// @see https://rux-lang.dev/docs/api/filesystem/permissions#from-mode
    pub func FromMode(mode: uint32) -> Permissions {
        return Permissions { mode: mode & 0xFFF, readOnly: (mode & 0x80) == 0 };
    }

    /// Permissions from the read-only flag alone, with the mode synthesized from it.
    /// @param readOnly whether the file may only be read
    /// @returns permissions that are writable or not, which is all Windows records
    /// @see https://rux-lang.dev/docs/api/filesystem/permissions#from-read-only
    pub func FromReadOnly(readOnly: bool) -> Permissions {
        return Permissions { mode: readOnly ? 0x124 : 0x1B6, readOnly: readOnly };
    }

    /// Whether the owner may write.
    /// @returns whether the owner may write the file
    /// @see https://rux-lang.dev/docs/api/filesystem/permissions#is-writable
    pub func IsWritable(self: &Permissions) -> bool {
        return !self.readOnly;
    }
}

/// Everything a single query can say about a file.
/// @see https://rux-lang.dev/docs/api/filesystem/metadata
pub struct Metadata {
    /// What the name refers to.
    pub kind: FileKind;
    /// The length in bytes; zero for a directory, whose size means nothing portable.
    pub size: uint64;
    /// How many names the content has. Always one on a system that does not count them.
    pub linkCount: uint64;
    /// Who may do what.
    pub permissions: Permissions;
    /// When the contents were last read.
    pub accessed: Timestamp;
    /// When the contents were last written.
    pub modified: Timestamp;
    /// When the file came into being, where the system records that.
    created: Timestamp;
    /// Whether `created` means anything.
    pub hasCreated: bool;
}

/// What the running system can actually answer, so a caller can ask before it assumes.
/// @see https://rux-lang.dev/docs/api/filesystem/capabilities
pub struct Capabilities {
    /// Whether `Permissions::mode` is the system's own answer rather than one synthesized from a flag.
    pub unixPermissions: bool;
    /// Whether the system records a creation time.
    pub creationTime: bool;
    /// Whether names have a meaningful link count.
    hardLinkCounts: bool;
    /// Whether setting timestamps is supported at all.
    settableTimes: bool;
}

/// What this system can answer.
/// @returns what this system's metadata actually carries, so a caller can tell an absent value from a false one
/// @see https://rux-lang.dev/docs/api/filesystem/capabilities#capabilities-of-system
pub func CapabilitiesOfSystem() -> Capabilities {
    when #target.os == .Windows {
        return Capabilities { unixPermissions: false, creationTime: true, hardLinkCounts: true,
                              settableTimes: true };
    }
    else {
        when #target.os == .Linux {
            // Linux records a creation time in the filesystem but does not report it through `stat`; reaching it
            // needs `statx`, which is a different call with a different structure.
            return Capabilities { unixPermissions: true, creationTime: false, hardLinkCounts: true,
                                  settableTimes: true };
        }
        else {
            return Capabilities { unixPermissions: true, creationTime: true, hardLinkCounts: true,
                                  settableTimes: true };
        }
    }
}

when #target.os != .Windows {
    // The kernel's `struct stat`, read at the offsets the architecture puts its fields at. Nothing models the
    // structure as a type: the layouts differ per system and per architecture, and a wrong declaration would
    // read plausible garbage rather than fail, so the offsets are written down here where the reasoning is
    // visible and each one is named beside the field it belongs to.
    // Linux x86-64 (144 bytes): mode 24, nlink 16, size 48, atime 72, mtime 88, each time's nanoseconds eight
    // bytes past its seconds. Linux AArch64 (128 bytes) moves mode to 16 and nlink to 20 and narrows both to
    // four bytes, keeping size and the times where x86-64 has them. macOS (144 bytes, 64-bit inode) has mode at
    // 4 as two bytes, nlink at 6 as two, the timespecs from 32, birth time at 80, size at 96. FreeBSD (224
    // bytes) has nlink at 16, mode at 24 as two bytes, the timespecs from 48, birth time at 96, size at 112.

    func ReadWordAt(buffer: *char8, offset: uint) -> uint64 {
        var value: uint64 = 0;
        var index: uint = 0;
        while index < 8 {
            value = value | ((buffer[offset + index] as uint8 as uint64) << (8 * index as uint64));
            index = index + 1;
        }
        return value;
    }

    func ReadHalfAt(buffer: *char8, offset: uint) -> uint32 {
        var value: uint32 = 0;
        var index: uint = 0;
        while index < 4 {
            value = value | ((buffer[offset + index] as uint8 as uint32) << (8 * index as uint32));
            index = index + 1;
        }
        return value;
    }

    func ReadShortAt(buffer: *char8, offset: uint) -> uint32 {
        return (buffer[offset] as uint8 as uint32) | ((buffer[offset + 1] as uint8 as uint32) << 8);
    }

    func StatMode(buffer: *char8) -> uint32 {
        when #target.os == .Linux {
            when #target.arch == .X86_64 {
                return ReadHalfAt(buffer, 24);
            }
            else {
                return ReadHalfAt(buffer, 16);
            }
        }
        else {
            when #target.os == .macOS {
                return ReadShortAt(buffer, 4);
            }
            else {
                return ReadShortAt(buffer, 24);
            }
        }
    }

    func StatLinkCount(buffer: *char8) -> uint64 {
        when #target.os == .Linux {
            when #target.arch == .X86_64 {
                return ReadWordAt(buffer, 16);
            }
            else {
                return ReadHalfAt(buffer, 20) as uint64;
            }
        }
        else {
            when #target.os == .macOS {
                return ReadShortAt(buffer, 6) as uint64;
            }
            else {
                return ReadWordAt(buffer, 16);
            }
        }
    }

    func StatSize(buffer: *char8) -> uint64 {
        when #target.os == .Linux {
            return ReadWordAt(buffer, 48);
        }
        else {
            when #target.os == .macOS {
                return ReadWordAt(buffer, 96);
            }
            else {
                return ReadWordAt(buffer, 112);
            }
        }
    }

    // The offset of the access time's seconds; modification follows one whole timespec later on every system.
    func StatAccessTimeOffset() -> uint {
        when #target.os == .Linux {
            return 72;
        }
        else {
            when #target.os == .macOS {
                return 32;
            }
            else {
                return 48;
            }
        }
    }

    func StatTimeAt(buffer: *char8, offset: uint) -> Timestamp {
        let seconds = ReadWordAt(buffer, offset) as int64;
        var fraction = ReadWordAt(buffer, offset + 8);
        if fraction >= 1000000000 {
            // A filesystem that never recorded a fraction can leave the field as anything; a value outside the
            // range would break Timestamp's own invariant, so it is dropped rather than carried inward.
            fraction = 0;
        }
        return Timestamp { seconds: seconds, nanoseconds: fraction as uint32 };
    }

    func KindOfMode(mode: uint32) -> FileKind {
        let masked = mode & 0xF000;
        if masked == 0x8000 { return FileKind::File; }
        if masked == 0x4000 { return FileKind::Directory; }
        if masked == 0xA000 { return FileKind::SymbolicLink; }
        return FileKind::Other;
    }

    func MetadataFromStat(buffer: *char8) -> Metadata {
        let mode = StatMode(buffer);
        let accessOffset = StatAccessTimeOffset();
        var created = Timestamp::Epoch();
        var hasCreated = false;
        when #target.os == .macOS {
            created = StatTimeAt(buffer, 80);
            hasCreated = true;
        }
        else {
            when #target.os == .FreeBSD {
                created = StatTimeAt(buffer, 96);
                hasCreated = true;
            }
        }
        return Metadata {
            kind: KindOfMode(mode),
            size: StatSize(buffer),
            linkCount: StatLinkCount(buffer),
            permissions: Permissions::FromMode(mode),
            accessed: StatTimeAt(buffer, accessOffset),
            modified: StatTimeAt(buffer, accessOffset + 16),
            created: created,
            hasCreated: hasCreated
        };
    }
}

when #target.os == .Windows {
    // BY_HANDLE_FILE_INFORMATION, read at the offsets documented on its declaration: attributes at 0, the
    // creation, access and write FILETIMEs at 4, 12 and 20, the size's high half at 32 and low at 36, and the
    // link count at 40. FILETIME counts hundred-nanosecond ticks from 1601, so the epoch shift and the tick
    // width are the whole conversion — the same one `Time` performs for the clock.
    func ReadDwordAt(buffer: *char8, offset: uint) -> uint32 {
        var value: uint32 = 0;
        var index: uint = 0;
        while index < 4 {
            value = value | ((buffer[offset + index] as uint8 as uint32) << (8 * index as uint32));
            index = index + 1;
        }
        return value;
    }

    func TimestampFromFileTimeAt(buffer: *char8, offset: uint) -> Timestamp {
        let low = ReadDwordAt(buffer, offset) as uint64;
        let high = ReadDwordAt(buffer, offset + 4) as uint64;
        let ticks = (high << 32) | low;
        let seconds = (ticks / 10000000) as int64 - (FileTimeToUnixEpochSeconds as int64);
        let rest = (ticks % 10000000) as uint32;
        return Timestamp { seconds: seconds, nanoseconds: rest * 100 };
    }

    func FileTimeFromTimestamp(moment: Timestamp) -> FileTime {
        let shifted = moment.seconds + (FileTimeToUnixEpochSeconds as int64);
        var ticks: uint64 = 0;
        if shifted > 0 {
            ticks = (shifted as uint64) * 10000000 + (moment.nanoseconds as uint64) / 100;
        }
        return FileTime { lowDateTime: (ticks & 0xFFFFFFFF) as uint32,
                          highDateTime: (ticks >> 32) as uint32 };
    }

    func KindOfAttributes(attributes: uint32) -> FileKind {
        if (attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 { return FileKind::SymbolicLink; }
        if (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0 { return FileKind::Directory; }
        return FileKind::File;
    }

    func MetadataFromHandleInformation(buffer: *char8) -> Metadata {
        let attributes = ReadDwordAt(buffer, 0);
        let high = ReadDwordAt(buffer, 32) as uint64;
        let low = ReadDwordAt(buffer, 36) as uint64;
        return Metadata {
            kind: KindOfAttributes(attributes),
            size: (high << 32) | low,
            linkCount: ReadDwordAt(buffer, 40) as uint64,
            permissions: Permissions::FromReadOnly((attributes & FILE_ATTRIBUTE_READONLY) != 0),
            accessed: TimestampFromFileTimeAt(buffer, 12),
            modified: TimestampFromFileTimeAt(buffer, 20),
            created: TimestampFromFileTimeAt(buffer, 4),
            hasCreated: true
        };
    }

    // A handle good for asking questions: no access rights at all, which is enough for metadata and works on a
    // file whose contents this process may not read. Backup semantics is what lets a directory be opened;
    // the reparse-point flag is what stops the open from following a symbolic link.
    func OpenForQuery(native: *var OsUnit, followLinks: bool) -> *var opaque {
        var flags = FILE_FLAG_BACKUP_SEMANTICS;
        if !followLinks {
            flags = flags | FILE_FLAG_OPEN_REPARSE_POINT;
        }
        return CreateFileW(native as *char16, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, null,
                           CreationDisposition::OpenExisting as uint32, flags, null) as *var opaque;
    }
}

/// Describes the file `path` names.
/// `followLinks` decides what a symbolic link at the end of the path means: following it describes the target,
/// and not following it describes the link, which is the only way `SymbolicLink` is ever reported.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @param followLinks whether a final symbolic link is followed rather than described
/// @returns what the system knows about the path
/// @see https://rux-lang.dev/docs/api/filesystem/metadata#metadata-of
pub func MetadataOf(allocator: Allocator, path: Path, followLinks: bool) -> Metadata ! IoError {
    let native = NativePath(allocator, path)?;
    defer ReleaseNativePath(allocator, native, path.name.units.length);
    var buffer: char8[256];
    when #target.os == .Windows {
        let handle = OpenForQuery(native, followLinks);
        if (handle as uint64) == InvalidHandleValue { fail TranslateNative(GetLastError() as int32); }
        if GetFileInformationByHandle(handle, @buffer[0] as *var opaque) == 0 {
            let raw = GetLastError() as int32;
            CloseHandle(handle);
            fail TranslateNative(raw);
        }
        CloseHandle(handle);
        return MetadataFromHandleInformation(@buffer[0]);
    }
    else {
        let flags = followLinks ? 0i32 : SymlinkNoFollow;
        let outcome = FstatAt(AtFdCwd, native as *char8, @buffer[0] as *var opaque, flags);
        if outcome < 0 { fail TranslateNative((0i64 - outcome) as int32); }
        return MetadataFromStat(@buffer[0]);
    }
}

extend File {
    /// Describes this open file.
    /// Answers about the file the handle holds, so nothing can rename or replace the name out from under the
    /// query the way a path-based one can.
    /// @returns what the system knows about the open file
    /// @see https://rux-lang.dev/docs/api/filesystem/file#metadata
    pub func Metadata(self: &File) -> Metadata ! IoError {
        if !self.open { fail IoError::Of(IoErrorKind::InvalidHandle); }
        var buffer: char8[256];
        when #target.os == .Windows {
            if GetFileInformationByHandle(self.handle, @buffer[0] as *var opaque) == 0 {
                fail TranslateNative(GetLastError() as int32);
            }
            return MetadataFromHandleInformation(@buffer[0]);
        }
        else {
            let outcome = Fstat(self.handle, @buffer[0] as *var opaque);
            if outcome < 0 { fail TranslateNative((0 - outcome) as int32); }
            return MetadataFromStat(@buffer[0]);
        }
    }
}

/// Sets who may do what to the file `path` names.
/// On the Unix systems the mode bits are written as given. On Windows only the read-only attribute exists, so
/// that alone is written and the rest of `permissions` is ignored — ask `CapabilitiesOfSystem` first if the
/// difference matters. A symbolic link is always followed: its own bits mean nothing on any supported system.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @param permissions the permissions to apply
/// @returns success when the permissions were applied
/// @see https://rux-lang.dev/docs/api/filesystem/permissions#set-permissions
pub func SetPermissions(allocator: Allocator, path: Path, permissions: Permissions) -> ! IoError {
    let native = NativePath(allocator, path)?;
    defer ReleaseNativePath(allocator, native, path.name.units.length);
    when #target.os == .Windows {
        let attributes = GetFileAttributesW(native as *char16);
        if attributes == INVALID_FILE_ATTRIBUTES {
            fail TranslateNative(GetLastError() as int32);
        }
        else {
            var wanted = attributes & ~FILE_ATTRIBUTE_READONLY;
            if permissions.readOnly {
                wanted = wanted | FILE_ATTRIBUTE_READONLY;
            }
            if wanted == 0 {
                wanted = FILE_ATTRIBUTE_NORMAL;
            }
            if SetFileAttributesW(native as *char16, wanted) == 0 {
                fail TranslateNative(GetLastError() as int32);
            }
        }
    }
    else {
        let result = FchmodAt(AtFdCwd, native as *char8, (permissions.mode & 0xFFF) as uint16, 0);
        if result < 0 {
            fail TranslateNative((0 - result) as int32);
        }
    }
}

/// Sets the access and modification times of the file `path` names.
/// Creation time is not settable here: Windows would allow it and the Unix systems would not, and an operation
/// that silently means different things on different systems is worse than one that is not offered.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @param accessed the access time to set, or `None` to leave it
/// @param modified the modification time to set, or `None` to leave it
/// @param followLinks whether a final symbolic link is followed rather than described
/// @returns success when the times were applied
/// @see https://rux-lang.dev/docs/api/filesystem/metadata#set-times
pub func SetTimes(allocator: Allocator, path: Path, accessed: Timestamp, modified: Timestamp,
              followLinks: bool) -> ! IoError {
    let native = NativePath(allocator, path)?;
    defer ReleaseNativePath(allocator, native, path.name.units.length);
    when #target.os == .Windows {
        let handle = OpenForQuery(native, followLinks);
        if (handle as uint64) == InvalidHandleValue {
            fail TranslateNative(GetLastError() as int32);
        }
        else {
            // A query handle carries no access rights, and writing times needs one; the handle is reopened with
            // the right to write attributes.
            CloseHandle(handle);
            var flags = FILE_FLAG_BACKUP_SEMANTICS;
            if !followLinks {
                flags = flags | FILE_FLAG_OPEN_REPARSE_POINT;
            }
            let writable = CreateFileW(native as *char16, 0x0100, // FILE_WRITE_ATTRIBUTES
                                       FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, null,
                                       CreationDisposition::OpenExisting as uint32, flags, null);
            if (writable as uint64) == InvalidHandleValue {
                fail TranslateNative(GetLastError() as int32);
            }
            else {
                var accessTime = FileTimeFromTimestamp(accessed);
                var writeTime = FileTimeFromTimestamp(modified);
                if SetFileTime(writable as *var opaque, null, @accessTime, @writeTime) == 0 {
                    let raw = GetLastError() as int32;
                    CloseHandle(writable as *var opaque);
                    fail TranslateNative(raw);
                }
                CloseHandle(writable as *var opaque);
            }
        }
    }
    else {
        // Two timespec values, access then modification, in the layout utimensat reads.
        var times: char8[32];
        WriteTimespec(@times[0], 0, accessed);
        WriteTimespec(@times[0], 16, modified);
        let flags = followLinks ? 0i32 : SymlinkNoFollow;
        let result = UtimensAt(AtFdCwd, native as *char8, @times[0] as *opaque, flags);
        if result < 0 {
            fail TranslateNative((0i64 - result) as int32);
        }
    }
}

when #target.os != .Windows {
    func WriteTimespec(buffer: *var char8, offset: uint, moment: Timestamp) {
        let seconds = moment.seconds as uint64;
        let fraction = moment.nanoseconds as uint64;
        var index: uint = 0;
        while index < 8 {
            buffer[offset + index] = ((seconds >> (8 * index as uint64)) & 0xFF) as uint8 as char8;
            buffer[offset + 8 + index] = ((fraction >> (8 * index as uint64)) & 0xFF) as uint8 as char8;
            index = index + 1;
        }
    }
}
