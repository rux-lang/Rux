// Where the process is, and what a path really refers to.
// Two operations that look alike and are not. `Absolute` is arithmetic: it joins a relative path onto the
// working directory and simplifies the result lexically, touching no filesystem and answering for a path that
// does not exist. `Canonicalize` asks the filesystem: every symbolic link is resolved, every component must
// exist, and the answer is the one true name of an existing file. `Path::Normalize` already documented that its
// `x/..` simplification is a lie in the presence of symbolic links — this is where the truth lives, and the
// difference between the two is the whole reason both are offered.
// The working directory is process-wide state. Reading it is harmless; setting it reaches into every thread at
// once and invalidates every relative path any of them was about to use, so `SetCurrentDirectory` exists for the
// programs that genuinely need it and nothing in this package calls it.

import Allocator::Allocator;
import Core::{ #target };
import Io::{ IoError, IoErrorKind };
import Path::{ IsSeparator, OsString, OsStringView, OsUnit, Path, PathBuffer, PreferredSeparator };
import Path::{ IsAbsolute, Normalize };

when #target.os {
    .FreeBSD => import FreeBSD::{ AtFdCwd, Chdir, Getcwd, ReadlinkAt },
    .Linux => import Linux::{ AtFdCwd, Chdir, Getcwd, ReadlinkAt },
    .macOS => import macOS::{ AtFdCwd, Chdir, Getcwd, ReadlinkAt },
    .Windows => import Windows::{ CloseHandle, GetCurrentDirectoryW, GetFinalPathNameByHandleW, GetLastError,
                                  InvalidHandleValue, SetCurrentDirectoryW }
}

/// How many symbolic links one canonicalization will follow before giving up.
/// A link that points at itself, or at a chain that returns to it, would otherwise be followed forever. The
/// limit is what every system uses for the same reason, and reaching it is reported as `LimitExceeded`.
/// @see https://rux-lang.dev/docs/api/filesystem/location#symbolic-link-limit
pub const SymbolicLinkLimit: uint = 40;

/// The process's working directory, as an absolute path.
/// @param allocator where the storage comes from
/// @returns the working directory
/// @see https://rux-lang.dev/docs/api/filesystem/location#current-directory
pub func CurrentDirectory(allocator: Allocator) -> OsString throws IoError {
    var units: OsUnit[4096];
    when #target.os == .Windows {
        // The length is reported without the terminator, and a length larger than the buffer means the answer
        // did not fit rather than that anything failed.
        // Safety: `units` is a local array of 4096 UTF-16 units, its length is the 4096 passed, and a `uint16`
        // unit is a `char16`.
        let written = unsafe { GetCurrentDirectoryW(4096, @units[0] as *var char16) };
        // Safety: `GetLastError` takes nothing and reads this thread's last error code.
        if written == 0 { throw TranslateNative(unsafe { GetLastError() } as int32); }
        if written > 4096 { throw IoError::Of(IoErrorKind::LimitExceeded); }
        let view = OsStringView::FromUnits(units[0..written as uint]);
        return OsString::FromView(allocator, view);
    }
    else {
        // Safety: `units` is a local array of 4096 units, and 4096 is the length passed.
        let outcome = unsafe { Getcwd(@units[0], 4096) };
        if outcome < 0 { throw TranslateNative((0 - outcome) as int32); }
        var length: uint = 0;
        while length < 4096 && units[length] != (0u8 as char8) {
            length = length + 1;
        }
        let view = OsStringView::FromUnits(units[0..length]);
        return OsString::FromView(allocator, view);
    }
}

/// Makes `path` the process's working directory.
/// Process-wide and immediately visible to every thread, which invalidates every relative path any of them was
/// about to resolve. Nothing in this package calls it.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @returns success when the working directory changed
/// @see https://rux-lang.dev/docs/api/filesystem/location#set-current-directory
pub func SetCurrentDirectory(allocator: Allocator, path: Path) throws IoError {
    let native = try NativePath(allocator, path);
    when #target.os == .Windows {
        // Safety: `native` is the NUL-terminated UTF-16 copy `NativePath` made above, live while it is
        // in scope, and a `uint16` unit is a `char16`.
        if unsafe { SetCurrentDirectoryW(native.Pointer() as *char16) } == 0 {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            throw TranslateNative(unsafe { GetLastError() } as int32);
        }
    }
    else {
        // Safety: `native` is the NUL-terminated copy `NativePath` made above, live while it is in scope.
        let result = unsafe { Chdir(native.Pointer() as *char8) };
        if result < 0 {
            throw TranslateNative((0 - result) as int32);
        }
    }
}

/// `path` made absolute against the working directory and simplified lexically.
/// Arithmetic, not a question for the filesystem: the path need not exist, nothing is opened, and no symbolic
/// link is resolved — so a `..` that crosses one is simplified away as though it did not. `Canonicalize` is the
/// operation that tells the truth about links, at the cost of requiring the file to be there.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @returns the path made absolute without touching the file system
/// @see https://rux-lang.dev/docs/api/filesystem/location#absolute
pub func Absolute(allocator: Allocator, path: Path) -> PathBuffer throws IoError {
    if IsAbsolute(path) {
        return Normalize(allocator, path);
    }
    var here = try CurrentDirectory(allocator);
    var joined = PathBuffer::FromPath(allocator, Path::FromView(here.View()));
    joined.Push(path.name);
    var simplified = Normalize(allocator, joined.AsPath());
    joined.Release();
    return move simplified;
}

when #target.os != .Windows {
    // The text a symbolic link at `path` holds, or `none` when it is not a link at all.
    // A name that is not a link is not an error: `EINVAL` from readlink means "that is an ordinary file", which
    // is the answer the walk below asks for at every component.
    func ReadLinkText(allocator: Allocator, path: Path) -> OsString? throws IoError {
        let native = try NativePath(allocator, path);
        var units: OsUnit[4096];
        // Safety: `native` is the NUL-terminated copy `NativePath` made above, live while it is in scope, and
        // `units` is a local array of 4096 units, the length passed.
        let written = unsafe { ReadlinkAt(AtFdCwd, native.Pointer() as *char8, @units[0], 4096) };
        if written < 0 {
            let raw = (0i64 - written) as int32;
            if raw == 22 {
                // EINVAL: an ordinary file, which is not a failure of this question.
                return none;
            }
            throw TranslateNative(raw);
        }
        if written as uint >= 4096 {
            // readlink truncates silently, so a full buffer cannot be told from a perfect fit.
            throw IoError::Of(IoErrorKind::LimitExceeded);
        }
        let view = OsStringView::FromUnits(units[0..written as uint]);
        var target = OsString::FromView(allocator, view);
        return .Some(move target);
    }

    func SegmentIs(segment: OsStringView, length: uint) -> bool {
        let units = segment.Units();
        if units.length != length { return false; }
        var index: uint = 0;
        while index < length {
            // Safety: `index` is below `length`, which equals `units.length`, checked above.
            if unsafe { units.data[index] } != DotUnit() { return false; }
            index = index + 1;
        }
        return true;
    }

    func DotUnit() -> OsUnit {
        return c8'.';
    }
}

when #target.os != .Windows {
    // Walks `path`, appending each component to `resolved` and following any link it lands on.
    // Recursive, because a link's target is itself a path that must be walked the same way — and bounded by the
    // follow count rather than by the nesting, since it is the link chain that can loop.
    func ResolveInto(allocator: Allocator, path: Path, resolved: &var PathBuffer, followed: *var uint) throws IoError {
        if IsAbsolute(path) {
            // An absolute path abandons whatever was resolved so far and starts again from the root.
            var root: OsUnit[1];
            root[0] = PreferredSeparator();
            // Pushing a segment that opens with a separator replaces what the buffer held.
            resolved.Push(OsStringView::FromUnits(root[0..1]));
        }
        var walk = path.Components();
        var stepping = true;
        while stepping {
            let step = walk.Next();
            if !(step is OsStringView) {
                stepping = false;
            }
            else {
                let segment = step ?? OsStringView();
                if segment.IsEmpty() || SegmentIs(segment, 1) {
                    // The root component and a bare `.` both add nothing.
                }
                else if SegmentIs(segment, 2) {
                    // `..` applies to what the links actually resolved to, which is the whole point of doing
                    // this against the filesystem rather than lexically.
                    resolved.Pop();
                }
                else {
                    resolved.Push(segment);
                    match try ReadLinkText(allocator, resolved.AsPath()) {
                        .Some(target) => {
                            // Safety: `followed` is the address of `Canonicalize`'s local count, which outlives
                            // the whole walk.
                            let count = unsafe {
                                *followed = *followed + 1;
                                *followed
                            };
                            if count > SymbolicLinkLimit { throw IoError::Of(IoErrorKind::LimitExceeded); }
                            // The link's own name is replaced by whatever it holds, resolved in turn.
                            resolved.Pop();
                            try ResolveInto(allocator, Path::FromView(target.View()), resolved, followed);
                        },
                        none => {}
                    }
                }
            }
        }
    }
}

/// The one true name of the existing file `path` refers to.
/// Every symbolic link is resolved, every `.` and `..` is applied against what those links actually mean, and
/// the result is absolute. Unlike `Absolute`, the file must exist: this is a question for the filesystem, and a
/// name with nothing behind it has no true form. A link chain that returns to itself is `LimitExceeded` rather
/// than a hang.
/// On Windows the answer arrives in the verbatim form and spelled as the filesystem stores it — the case the
/// name actually has, short names expanded — because that is what the system reports, and rewriting it would be
/// this package guessing.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @returns the path with every link and relative component resolved, which needs the file system and so can fail
/// @see https://rux-lang.dev/docs/api/filesystem/location#canonicalize
pub func Canonicalize(allocator: Allocator, path: Path) -> PathBuffer throws IoError {
    when #target.os == .Windows {
        // Windows resolves the whole path itself, given a handle to what stands at the end of it. A query handle
        // carries no access rights, which is enough here and works on a file this process may not read.
        let native = try NativePath(allocator, path);
        let handle = OpenForQuery(native, true);
        if (handle as uint64) == InvalidHandleValue {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            throw TranslateNative(unsafe { GetLastError() } as int32);
        }
        var units: OsUnit[4096];
        // Safety: `handle` is the valid query handle opened above, `units` is a local array of 4096 UTF-16 units
        // whose length is passed, and a `uint16` unit is a `char16`.
        let written = unsafe { GetFinalPathNameByHandleW(handle, @units[0] as *var char16, 4096, 0) };
        // Safety: `GetLastError` takes nothing and reads this thread's last error code.
        let raw = unsafe { GetLastError() } as int32;
        // Safety: `handle` is the valid query handle opened above, closed here once and not used afterwards.
        unsafe { CloseHandle(handle); }
        if written == 0 { throw TranslateNative(raw); }
        if written >= 4096 { throw IoError::Of(IoErrorKind::LimitExceeded); }
        let view = OsStringView::FromUnits(units[0..written as uint]);
        return PathBuffer::FromPath(allocator, Path::FromView(view));
    }
    else {
        // No Unix kernel resolves a whole path for a caller — `realpath` is library code over `readlink` — so
        // the walk is done here, component by component, against what each link actually points at.
        var started = try Absolute(allocator, path);
        var resolved = PathBuffer(allocator);
        var followed: uint = 0;
        try ResolveInto(allocator, started.AsPath(), resolved, @followed);
        started.Release();
        // Nothing above confirmed the last component exists: the walk only asked whether each one was a link,
        // and a missing name answers that with "no".
        try MetadataOf(allocator, resolved.AsPath(), true);
        return move resolved;
    }
}
