// Directories: made, deleted, and read entry by entry with nothing lost in the names.
// Enumeration hands back each entry's name as an `OsString` — the units the system actually stores, not a text
// conversion that a hostile or merely foreign name would fail. The `.` and `..` entries are skipped, because no
// caller walking a directory has ever wanted the directory itself twice. Order is whatever the filesystem
// chooses; nothing here sorts, because a sorted walk is a policy and this is a primitive.

import Allocator::Allocator;
import Core::{ #target };
import Io::{ IoError, IoErrorKind };
import Path::{ OsString, OsStringView, OsUnit, Path };

when #target.os {
    .FreeBSD => import FreeBSD::{ AtFdCwd, Close, Getdirentries, MkdirAt, OpenAt, OpenDirectory, OpenReadOnly,
                                  RemoveDirectory, UnlinkAt },
    .Linux => import Linux::{ AtFdCwd, Close, Getdents64, MkdirAt, OpenAt, OpenDirectory, OpenReadOnly, RemoveDirectory,
                              UnlinkAt },
    .macOS => import macOS::{ AtFdCwd, Close, Getdirentries64, MkdirAt, OpenAt, OpenDirectory, OpenReadOnly,
                              RemoveDirectory, UnlinkAt },
    .Windows => import Windows::{ CreateDirectoryW, DeleteFileW, ERROR_NO_MORE_FILES, FindClose, FindFirstFileW,
                                  FindNextFileW, GetLastError, InvalidHandleValue, RemoveDirectoryW }
}

/// Creates the directory `path` names. Its parent must already exist; `AlreadyExists` if the name is taken.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @returns success when the directory now exists
/// @see https://rux-lang.dev/docs/api/filesystem/directories#make-directory
pub func MakeDirectory(allocator: Allocator, path: Path) -> ! IoError {
    let native = NativePath(allocator, path)?;
    defer ReleaseNativePath(allocator, native, path.name.units.length);
    when #target.os == .Windows {
        // Safety: `native` is the NUL-terminated UTF-16 copy `NativePath` made above, live until the deferred
        // release, and a `uint16` unit is a `char16`.
        if unsafe { CreateDirectoryW(native as *char16, null) } == 0 {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            fail TranslateNative(unsafe { GetLastError() } as int32);
        }
    }
    else {
        // Read, write and search for everyone, cut down by the process umask.
        // Safety: `native` is the NUL-terminated copy `NativePath` made above, live until the deferred release.
        let result = unsafe { MkdirAt(AtFdCwd, native as *char8, 511) };
        if result < 0 {
            fail TranslateNative((0 - result) as int32);
        }
    }
}

/// Deletes the empty directory `path` names; a directory with anything still in it is refused.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @returns success when the directory is gone
/// @see https://rux-lang.dev/docs/api/filesystem/directories#delete-directory
pub func DeleteDirectory(allocator: Allocator, path: Path) -> ! IoError {
    let native = NativePath(allocator, path)?;
    defer ReleaseNativePath(allocator, native, path.name.units.length);
    when #target.os == .Windows {
        // Safety: `native` is the NUL-terminated UTF-16 copy `NativePath` made above, live until the deferred
        // release, and a `uint16` unit is a `char16`.
        if unsafe { RemoveDirectoryW(native as *char16) } == 0 {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            fail TranslateNative(unsafe { GetLastError() } as int32);
        }
    }
    else {
        // Safety: `native` is the NUL-terminated copy `NativePath` made above, live until the deferred release.
        let result = unsafe { UnlinkAt(AtFdCwd, native as *char8, RemoveDirectory) };
        if result < 0 {
            fail TranslateNative((0 - result) as int32);
        }
    }
}

/// Deletes the file `path` names. Removing the name does not disturb any handle still open on the file.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @returns success when the file is gone
/// @see https://rux-lang.dev/docs/api/filesystem/file-operations#delete-file
pub func DeleteFile(allocator: Allocator, path: Path) -> ! IoError {
    let native = NativePath(allocator, path)?;
    defer ReleaseNativePath(allocator, native, path.name.units.length);
    when #target.os == .Windows {
        // Safety: `native` is the NUL-terminated UTF-16 copy `NativePath` made above, live until the deferred
        // release, and a `uint16` unit is a `char16`.
        if unsafe { DeleteFileW(native as *char16) } == 0 {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            fail TranslateNative(unsafe { GetLastError() } as int32);
        }
    }
    else {
        // Safety: `native` is the NUL-terminated copy `NativePath` made above, live until the deferred release.
        let result = unsafe { UnlinkAt(AtFdCwd, native as *char8, 0) };
        if result < 0 {
            fail TranslateNative((0 - result) as int32);
        }
    }
}

/// A directory read one entry at a time.
/// Move-only: `Release` (or destruction) gives back the platform handle and the record buffer. `Next` hands each
/// name over as a fresh `OsString` owned by the caller.
/// @see https://rux-lang.dev/docs/api/filesystem/directories#directory-iterator
pub struct DirectoryIterator {
    /// Where the record buffer came from, and where the names come from.
    allocator: Allocator;
    /// The platform's enumeration handle.
    handle: RawFile;
    /// The record buffer.
    data: *var char8;
    /// Its size.
    capacity: uint;
    /// How many bytes of it are records (the Unix systems).
    length: uint;
    /// The parse position within them (the Unix systems).
    offset: uint;
    /// Whether an entry is already waiting in the buffer (Windows).
    pending: bool;
    /// Whether the handle is still this value's to give back.
    open: bool;
}

// The buffer each platform's record needs: one WIN32_FIND_DATAW, or a batch of dirent records.
func DirectoryBufferSize() -> uint {
    when #target.os == .Windows {
        return 592;
    }
    else {
        return 4096;
    }
}

/// Begins enumerating the directory `path` names.
/// @param allocator where the storage comes from
/// @param path the path to act on
/// @returns a cursor over the directory's entries
/// @see https://rux-lang.dev/docs/api/filesystem/directories#read-directory
pub func ReadDirectory(allocator: Allocator, path: Path) -> DirectoryIterator ! IoError {
    var iterator = DirectoryIterator {
        allocator,
        handle: NoFile(),
        data: null,
        capacity: 0,
        length: 0,
        offset: 0,
        pending: false,
        open: false
    };
    let wanted = DirectoryBufferSize();
    let layout = Layout { size: wanted, alignment: 8 };
    var borrowed = allocator;
    let block = borrowed.Allocate(layout) catch { _ => fail IoError::Of(IoErrorKind::Other) };
    // Safety: `block` is a fresh allocation of `wanted` bytes, so it holds `wanted` `char8`s.
    iterator.data = unsafe { block as *var char8 };
    iterator.capacity = wanted;

    when #target.os == .Windows {
        // The search takes a pattern, so the path gets a separator and a star appended.
        let units = path.name.units;
        let patternLayout = Layout { size: (units.length + 3) * 2, alignment: 2 };
        let raw = borrowed.Allocate(patternLayout) catch { _ => fail IoError::Of(IoErrorKind::Other) };
        // Safety: `raw` is a fresh allocation of `patternLayout`: `units.length + 3` units at their alignment.
        let pattern = unsafe { raw as *var uint16 };
        var index: uint = 0;
        var length: uint = 0;
        while index < units.length {
            // Safety: `index` is below `units.length`, the loop condition.
            let unit = unsafe { units.data[index] };
            if (unit as uint32) == 0 {
                borrowed.Deallocate(raw, patternLayout) catch { _ => {} };
                fail IoError::Of(IoErrorKind::InvalidInput);
            }
            // Safety: `length` equals `index`, below `units.length`, and `pattern` holds `units.length + 3` units.
            unsafe { pattern[length] = unit; }
            length = length + 1;
            index = index + 1;
        }
        // Safety: `length` is `units.length` here and `pattern` holds `units.length + 3` units, so the separator,
        // the star and the terminator all fit.
        unsafe {
            if length > 0 && pattern[length - 1] != 0x5C && pattern[length - 1] != 0x2F {
                pattern[length] = 0x5C;
                length = length + 1;
            }
            pattern[length] = 0x2A;
            pattern[length + 1] = 0;
        }
        // Safety: `pattern` was just NUL-terminated and a `uint16` unit is a `char16`; `iterator.data` is the
        // record buffer of `DirectoryBufferSize()` bytes, one `WIN32_FIND_DATAW`.
        let found = unsafe { FindFirstFileW(pattern as *char16, iterator.data as *var opaque) };
        borrowed.Deallocate(raw, patternLayout) catch { _ => {} };
        if (found as uint64) == InvalidHandleValue {
            // Safety: `GetLastError` takes nothing and reads this thread's last error code.
            fail TranslateNative(unsafe { GetLastError() } as int32);
        }
        iterator.handle = found;
        iterator.pending = true;
        iterator.open = true;
        return move iterator;
    }
    else {
        let native = NativePath(allocator, path)?;
        // Safety: `native` is the NUL-terminated copy `NativePath` made above, released only after this call.
        let opened = unsafe { OpenAt(AtFdCwd, native as *char8, OpenReadOnly | OpenDirectory, 0) };
        ReleaseNativePath(allocator, native, path.name.units.length);
        if opened < 0 { fail TranslateNative((0 - opened) as int32); }
        iterator.handle = opened as int32;
        iterator.open = true;
        return move iterator;
    }
}

extend DirectoryIterator {
    /// Hands over the next entry's name, or reports that the directory is done.
    /// Succeeds with a name freshly owned by the caller, or with `none` at the end; a failure says what stopped the
    /// enumeration. The `.` and `..` entries are skipped.
    /// @returns the next entry's name, or `none` when the directory is done
    /// @see https://rux-lang.dev/docs/api/filesystem/directories#directory-iterator-next
    pub func Next(&var self) -> OsString? ! IoError {
        if !self.open { fail IoError::Of(IoErrorKind::InvalidHandle); }
        when #target.os == .Windows {
            while true {
                if !self.pending {
                    // Safety: `handle` is this iterator's open search handle, `open` was checked above, and
                    // `data` is its record buffer of one `WIN32_FIND_DATAW`.
                    if unsafe { FindNextFileW(self.handle, self.data as *var opaque) } == 0 {
                        // Safety: `GetLastError` takes nothing and reads this thread's last error code.
                        let raw = unsafe { GetLastError() };
                        if raw != ERROR_NO_MORE_FILES { fail TranslateNative(raw as int32); }
                        return none;
                    }
                }
                self.pending = false;
                // The UTF-16 name starts at offset 44 of the record and ends at its NUL.
                // Safety: `data` is the 592-byte record buffer, which holds the 260-unit name field at offset 44.
                let start = unsafe { (self.data as uint + 44) as *var uint16 };
                var length: uint = 0;
                // Safety: `length` is below 260, the size of the name field `start` addresses.
                while length < 260 && unsafe { start[length] } != 0 {
                    length = length + 1;
                }
                // Safety: `length` is at most 260, the size of the name field `start` addresses.
                let entry = unsafe { (start)[..length] };
                if !IsDotEntry16(entry) {
                    let view = OsStringView::FromUnits(entry);
                    var name = OsString::FromView(self.allocator, view);
                    return .Some(move name);
                }
            }
        }
        else {
            while true {
                if self.offset >= self.length {
                    var filled: int64 = 0;
                    when #target.os == .Linux {
                        // Safety: `handle` is this iterator's open directory, `open` was checked above, and `data`
                        // is its buffer of `capacity` bytes.
                        filled = unsafe { Getdents64(self.handle, self.data as *var opaque, self.capacity) };
                    }
                    else {
                        when #target.os == .FreeBSD {
                            // Safety: `handle` is this iterator's open directory, `open` was checked above, and
                            // `data` is its buffer of `capacity` bytes; no base position is asked for.
                            filled = unsafe {
                                Getdirentries(self.handle, self.data as *var opaque, self.capacity, null)
                            };
                        }
                        else {
                            var position: int64 = 0;
                            // Safety: `handle` is this iterator's open directory, `open` was checked above, `data`
                            // is its buffer of `capacity` bytes, and `position` is a local `int64`.
                            filled = unsafe {
                                Getdirentries64(self.handle, self.data as *var opaque, self.capacity, @position)
                            };
                        }
                    }
                    if filled < 0 { fail TranslateNative((0 - filled) as int32); }
                    if filled == 0 { return none; }
                    self.length = filled as uint;
                    self.offset = 0;
                }
                // Safety: `offset` is below `length`, so `record` is the start of a whole record the kernel wrote into
                // `data`, and every record begins with a header longer than 18 bytes.
                let record = unsafe { (self.data as uint + self.offset) as *var char8 };
                // Safety: as above, the record's header holds its length at bytes 16 and 17.
                let reclen = unsafe { ((record[16] as uint8 as uint) | ((record[17] as uint8 as uint) << 8)) };
                if reclen == 0 || self.offset + reclen > self.length {
                    // A zero-length record would loop forever; a torn one reaches past the buffer. Either way
                    // the kernel and this code disagree about the layout, which is worth failing loudly over.
                    fail IoError::Of(IoErrorKind::Other);
                }
                self.offset = self.offset + reclen;

                var nameStart: uint = 0;
                var nameLength: uint = 0;
                when #target.os == .Linux {
                    nameStart = 19;
                    // Safety: the read runs only below `reclen`, and the record's `reclen` bytes lie inside the
                    // buffer, checked above.
                    while nameStart + nameLength < reclen && unsafe { record[nameStart + nameLength] } != c8'\0' {
                        nameLength = nameLength + 1;
                    }
                }
                else {
                    when #target.os == .FreeBSD {
                        nameStart = 24;
                        // Safety: the record's `reclen` bytes lie inside the buffer, checked above, and its header
                        // holds the name length at bytes 20 and 21.
                        nameLength = unsafe { (record[20] as uint8 as uint) | ((record[21] as uint8 as uint) << 8) };
                    }
                    else {
                        nameStart = 21;
                        // Safety: the record's `reclen` bytes lie inside the buffer, checked above, and its header
                        // holds the name length at bytes 18 and 19.
                        nameLength = unsafe { (record[18] as uint8 as uint) | ((record[19] as uint8 as uint) << 8) };
                    }
                }
                // Safety: the kernel's record holds its `nameLength`-byte name at `nameStart`, and the record lies
                // inside the buffer, checked above.
                let entry = unsafe { ((record as uint + nameStart) as *var char8)[..nameLength] };
                if !IsDotEntry8(entry) {
                    let view = OsStringView::FromUnits(entry);
                    var name = OsString::FromView(self.allocator, view);
                    return .Some(move name);
                }
            }
        }
        return none;
    }

    /// Gives back the handle and the buffer.
    /// @see https://rux-lang.dev/docs/api/filesystem/directories#directory-iterator-release
    pub func Release(&var self) {
        if self.open {
            self.open = false;
            when #target.os == .Windows {
                // Safety: `handle` is this iterator's open search handle, `open` was checked above and is now
                // cleared, so it is closed once.
                unsafe { FindClose(self.handle); }
            }
            else {
                Close(self.handle);
            }
        }
        if self.data != null {
            var borrowed = self.allocator;
            borrowed.Deallocate(self.data as *var opaque, Layout { size: self.capacity, alignment: 8 }) catch { _ => {} };
            self.data = null;
            self.capacity = 0;
        }
    }

    /// `Release`, as the safety net.
    /// @see https://rux-lang.dev/docs/api/filesystem/directories#directory-iterator-destructor
    func ~DirectoryIterator(&var self) {
        self.Release();
    }
}

func IsDotEntry8(name: char8[..]) -> bool {
    if name.length == 1 { return name[0] == c8'.'; }
    return name.length == 2 && name[0] == c8'.' && name[1] == c8'.';
}

func IsDotEntry16(name: uint16[..]) -> bool {
    if name.length == 1 { return name[0] == 0x2E; }
    return name.length == 2 && name[0] == 0x2E && name[1] == 0x2E;
}
