// Temporary files and directories: unguessable names, and cleanup that is not left to chance.
//
// The name comes from the entropy source rather than from a counter or the process id, because a predictable
// name in a shared directory is the whole of the classic temp-file attack: an attacker who can guess the name
// creates it first, as a symbolic link pointing somewhere it should not, and the program writes through it. The
// name is also *claimed* rather than merely chosen — created with `createNew`, which fails rather than opens if
// anything is already there — so winning the guess is not enough either. A collision is retried, since with 128
// bits it means an attacker, not bad luck.
//
// Cleanup is deterministic: the handle owns both the file and its name, and dropping it deletes both. That is
// stronger than the platform conveniences it replaces — Windows' delete-on-close needs the last handle to go,
// and the Unix trick of unlinking immediately leaves nothing a caller could pass to another process by name.

import Allocator::Allocator;
import Core::{ #target };
import Entropy::NextUint64;
import Io::{ IoError, IoErrorKind };
import Path::{ OsString, OsStringView, OsUnit, Path, PathBuffer };

when #target.os == .Windows {
    import Windows::{ GetLastError, GetTempPathW };
}

/// How many names are tried before a temporary file gives up.
///
/// With 128 bits of name, one collision is already a surprise and three in a row is not chance; failing is the
/// honest response to an entropy source that has stopped being one.
///
/// @see https://rux-lang.dev/docs/api/filesystem/temporary-name-attempts
pub const TemporaryNameAttempts: uint = 4;

/// The directory the system sets aside for temporary files.
///
/// On Windows this is what the platform reports, which consults `TMP`, `TEMP` and `USERPROFILE` in turn. On the
/// Unix systems it is `/tmp`: reading `TMPDIR` needs environment access this package does not have yet, so a
/// caller who must honor it passes the directory to the functions below instead.
///
/// @param allocator where the storage comes from
/// @returns the system's directory for temporary files
/// @see https://rux-lang.dev/docs/api/filesystem/temporary-directory
pub func TemporaryDirectory(allocator: Allocator) -> PathBuffer ! IoError {
    when #target.os == .Windows {
        var units: OsUnit[512];
        let written = GetTempPathW(512, @units[0] as *var char16);
        if written == 0u32 { fail TranslateNative(GetLastError() as int32); }
        if written > 512u32 { fail IoError::Of(IoErrorKind::LimitExceeded); }
        // The reported path ends in a separator; the buffer holds names, so it is dropped here.
        var length = written as uint;
        while length > 1u && IsSeparator(units[length - 1]) {
            length = length - 1;
        }
        let view = OsStringView::FromUnits((@units[0])[..length]);
        return PathBuffer::FromPath(allocator, Path::FromView(view)) catch {
            else => fail IoError::Of(IoErrorKind::Other)
        };
    }
    else {
        var name = OsString::FromText(allocator, "/tmp") catch { else => fail IoError::Of(IoErrorKind::Other) };
        return PathBuffer::FromPath(allocator, Path::FromView(name.View())) catch {
            else => fail IoError::Of(IoErrorKind::Other)
        };
    }
}

// Sixteen hex digits of entropy, appended to `prefix`, as one path segment.
func RandomName(allocator: Allocator, prefix: char8[..]) -> OsString ! IoError {
    // A name without entropy behind it is not a name this package will hand out.
    let bits = NextUint64() catch { else => fail IoError::Of(IoErrorKind::Other) };
    var text: char8[64];
    var length: uint = 0;
    while length < prefix.length && length < 40u {
        text[length] = prefix.data[length];
        length = length + 1;
    }
    var digit: uint = 0;
    while digit < 16u {
        let nibble = ((bits >> ((60u64 - 4u64 * digit as uint64))) & 0xFu64) as uint32;
        text[length] = (nibble < 10u32 ? (0x30u32 + nibble) : (0x57u32 + nibble)) as uint8 as char8;
        length = length + 1;
        digit = digit + 1;
    }
    return OsString::FromText(allocator, text[0..length]) catch { else => fail IoError::Of(IoErrorKind::Other) };
}

/// A temporary file that owns both its contents and its name.
///
/// Move-only. `Close` deletes the file and reports what the deletion said; destruction does the same with the outcome
/// discarded. `Keep` gives up ownership of the name instead, for the caller who has decided the file should
/// outlive this value — which is what a rename into place is built on.
///
/// @see https://rux-lang.dev/docs/api/filesystem/temporary-file
pub struct TemporaryFile {
    /// The open file.
    pub file: File;
    /// Its full path.
    path: PathBuffer;
    /// Whether the name is still this value's to delete.
    owned: bool;
}

extend TemporaryFile {
    /// The owned file and path cannot be duplicated.
    func =(self: &var TemporaryFile, other: &TemporaryFile);

    /// Creates a new temporary file in `directory`, named from `prefix` and sixteen hex digits of entropy.
    ///
    /// The file is opened for reading and writing and is created, never opened: a name that already exists is a
    /// collision, and the next name is tried.
    ///
    /// @param allocator where the storage comes from
    /// @param directory the directory to create it in
    /// @param prefix the text the generated name starts with
    /// @returns the created file, which is removed when closed unless kept
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-file/create
    pub func Create(allocator: Allocator, directory: Path, prefix: char8[..]) -> TemporaryFile ! IoError {
        var options = OpenOptions();
        options.read = true;
        options.write = true;
        options.createNew = true;

        var attempt: uint = 0;
        while attempt < TemporaryNameAttempts {
            var candidate = PathBuffer::FromPath(allocator, directory) catch {
                else => fail IoError::Of(IoErrorKind::Other)
            };
            var name = RandomName(allocator, prefix)?;
            candidate.Push(name.View()) catch { else => fail IoError::Of(IoErrorKind::Other) };
            match File::Open(allocator, candidate.AsPath(), options) {
                .Success(opened) => {
                    return TemporaryFile { file: <-opened, path: <-candidate, owned: true };
                },
                .Failure(error) => {
                    // Anything but a collision is the caller's problem, not something another name would fix.
                    if error.kind != IoErrorKind::AlreadyExists { fail error; }
                }
            }
            candidate.Release();
            attempt = attempt + 1;
        }
        fail IoError::Of(IoErrorKind::AlreadyExists);
    }

    /// The file's path, for handing to something that needs a name.
    ///
    /// @returns the path it was created at
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-file/path
    pub func AsPath(self: &TemporaryFile) -> Path {
        return self.path.AsPath();
    }

    /// Closes the file and deletes it, reporting the first thing that went wrong.
    ///
    /// @param allocator where the storage comes from
    /// @returns success when it was removed
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-file/close
    pub func Close(self: &var TemporaryFile, allocator: Allocator) -> ! IoError {
        let closed = self.file.Close();
        var deleted: ! IoError = .Success(());
        if self.owned {
            self.owned = false;
            deleted = DeleteFile(allocator, self.path.AsPath());
        }
        self.path.Release();
        closed?;
        return deleted;
    }

    /// Closes the file and leaves it where it is, giving up the name.
    ///
    /// @returns success when it will be left in place rather than removed
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-file/keep
    pub func Keep(self: &var TemporaryFile) -> ! IoError {
        self.owned = false;
        return self.file.Close();
    }
}

/// A temporary directory that owns its name.
///
/// Move-only, with the same contract as `TemporaryFile`: `Close` removes it and reports, destruction removes it
/// quietly, `Keep` gives up ownership. Removal is of the directory itself and requires it to be empty — nothing
/// here deletes a tree, because a temporary directory that silently erased whatever a caller put inside it
/// would be a worse surprise than a refusal.
///
/// @see https://rux-lang.dev/docs/api/filesystem/temporary-directory-handle
pub struct TemporaryDirectoryHandle {
    /// The directory's full path.
    path: PathBuffer;
    /// Whether the name is still this value's to remove.
    owned: bool;
}

extend TemporaryDirectoryHandle {
    /// The owned directory path cannot be duplicated.
    func =(self: &var TemporaryDirectoryHandle, other: &TemporaryDirectoryHandle);

    /// Creates a new temporary directory in `directory`, named from `prefix` and sixteen hex digits of entropy.
    ///
    /// @param allocator where the storage comes from
    /// @param directory the directory to create it in
    /// @param prefix the text the generated name starts with
    /// @returns the created directory, which is removed when closed unless kept
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-directory-handle/create
    pub func Create(allocator: Allocator, directory: Path, prefix: char8[..]) -> TemporaryDirectoryHandle ! IoError {
        var attempt: uint = 0;
        while attempt < TemporaryNameAttempts {
            var candidate = PathBuffer::FromPath(allocator, directory) catch {
                else => fail IoError::Of(IoErrorKind::Other)
            };
            var name = RandomName(allocator, prefix)?;
            candidate.Push(name.View()) catch { else => fail IoError::Of(IoErrorKind::Other) };
            // MakeDirectory already refuses a name that is taken, which is the claim this needs.
            match MakeDirectory(allocator, candidate.AsPath()) {
                .Success(_) => {
                    return TemporaryDirectoryHandle { path: <-candidate, owned: true };
                },
                .Failure(error) => {
                    if error.kind != IoErrorKind::AlreadyExists { fail error; }
                }
            }
            candidate.Release();
            attempt = attempt + 1;
        }
        fail IoError::Of(IoErrorKind::AlreadyExists);
    }

    /// The directory's path, for building names inside it.
    ///
    /// @returns the path it was created at
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-directory-handle/path
    pub func AsPath(self: &TemporaryDirectoryHandle) -> Path {
        return self.path.AsPath();
    }

    /// Removes the directory and reports what the removal said.
    ///
    /// @param allocator where the storage comes from
    /// @returns success when it was removed
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-directory-handle/close
    pub func Close(self: &var TemporaryDirectoryHandle, allocator: Allocator) -> ! IoError {
        var removed: ! IoError = .Success(());
        if self.owned {
            self.owned = false;
            removed = DeleteDirectory(allocator, self.path.AsPath());
        }
        self.path.Release();
        return removed;
    }

    /// Leaves the directory where it is, giving up the name.
    ///
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-directory-handle/keep
    pub func Keep(self: &var TemporaryDirectoryHandle) {
        self.owned = false;
    }
}

extend TemporaryFile {
    /// Closes and deletes with the outcome discarded: the safety net, not the contract.
    ///
    /// A destructor has nowhere to report a failed deletion, so a caller who needs to know calls `Close`. What
    /// this guarantees is that a temporary file is never left behind by an early return or a failure path, which
    /// is the reason the type exists.
    ///
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-file/destructor
    func ~TemporaryFile(self: &var TemporaryFile) {
        self.file.Close() catch { else => {} };
        if self.owned {
            self.owned = false;
            DeleteFile(self.path.allocator, self.path.AsPath()) catch { else => {} };
        }
        self.path.Release();
    }
}

extend TemporaryDirectoryHandle {
    /// Removes the directory with the outcome discarded: the safety net, not the contract.
    ///
    /// @see https://rux-lang.dev/docs/api/filesystem/temporary-directory-handle/destructor
    func ~TemporaryDirectoryHandle(self: &var TemporaryDirectoryHandle) {
        if self.owned {
            self.owned = false;
            DeleteDirectory(self.path.allocator, self.path.AsPath()) catch { else => {} };
        }
        self.path.Release();
    }
}
