// The raw system-call entry points, and the numbers that select a call.
//
// Every wrapper elsewhere in this package is one of these seven functions with the arguments named. A caller may use
// them directly for a call this package does not wrap, which is what they are public for.
//
// Unlike Linux, both supported architectures share one numbering: FreeBSD assigns a call its number once, in
// `syscalls.master`, and every architecture uses it. What differs is only where the number and the arguments go.
//
// A raw result from these wrappers is already normalized to Linux's convention -- a value, or a small negative error
// number -- which is what `Errors::IsError` and `Errors::Errno` read.

import Core::{ #target, #Error };

// The call numbers, which both architectures share. FreeBSD assigns a call its number once, in `syscalls.master`,
// and every architecture uses it -- unlike Linux, where the two tables agree on nothing.
const SysExit: uint64 = 1;
const SysRead: uint64 = 3;
const SysWrite: uint64 = 4;
const SysClose: uint64 = 6;
const SysBrk: uint64 = 17;
const SysGetPid: uint64 = 20;

// FreeBSD 14.4's native syscall table. AArch64 and x86-64 share these numbers;
// only the register/trap sequence below is architecture-owned.
const SysMmap: uint64 = 477;
const SysMunmap: uint64 = 73;
const SysClockGetTime: uint64 = 232;
const SysNanosleep: uint64 = 240;
const SysMprotect: uint64 = 74;
const SysMadvise: uint64 = 75;
const SysFsync: uint64 = 95;
const SysClockGetRes: uint64 = 234;
const SysLseek: uint64 = 478;
const SysFtruncate: uint64 = 480;
const SysOpenAt: uint64 = 499;
const SysRenameAt: uint64 = 501;
const SysUnlinkAt: uint64 = 503;
const SysLinkAt: uint64 = 495;
const SysSymlinkAt: uint64 = 502;
const SysFchmodAt: uint64 = 490;
const SysUtimensAt: uint64 = 547;
const SysGetdirentries: uint64 = 554;
const SysFstatAt: uint64 = 552;
const SysChdir: uint64 = 12;
const SysGetcwd: uint64 = 326;
const SysReadlinkAt: uint64 = 500;
const SysMkdirAt: uint64 = 496;
const SysPipe2: uint64 = 542;
const SysFstat: uint64 = 551;
const SysGetRandom: uint64 = 563;
const SysDup2: uint64 = 90;

// The FreeBSD kernel reports an error from every system call the same way on
// both architectures: it sets the carry flag and leaves a positive errno in the
// result register. These wrappers return Linux-style -errno values for parity.
// Where the call number and the arguments go differs, so each architecture
// writes the whole wrapper.
//
// x86-64: Rux functions use the System V ABI, whose first three argument
// registers the `syscall` instruction keeps. The fourth argument moves from rcx
// to r10, and a seventh function argument arrives at [rsp + 8], after the
// return address.
//
// AArch64: Rux functions use AAPCS64, whose first eight argument registers
// cover even the widest wrapper. `svc #0` takes the call number in x8 and the
// arguments in x0 through x5, so each wrapper moves the number aside and then
// shifts the arguments down by one register, lowest first, which is the order
// in which each register has been read before it is written.
when #target.arch {
    .X86_64 => {
        // Executes a raw FreeBSD system call without arguments.
        #Abi(.SysV)
        asm func Syscall0(number: uint64) -> int64 {
            mov rax, rdi
            syscall
            jnc done
            neg rax
        done:
            ret
        }

        // Executes a raw FreeBSD system call with one argument.
        #Abi(.SysV)
        asm func Syscall1(number: uint64, arg0: uint64) -> int64 {
            mov rax, rdi
            mov rdi, rsi
            syscall
            jnc done
            neg rax
        done:
            ret
        }

        // Executes a raw FreeBSD system call with two arguments.
        #Abi(.SysV)
        asm func Syscall2(number: uint64, arg0: uint64, arg1: uint64) -> int64 {
            mov rax, rdi
            mov rdi, rsi
            mov rsi, rdx
            syscall
            jnc done
            neg rax
        done:
            ret
        }

        // Executes a raw FreeBSD system call with three arguments.
        #Abi(.SysV)
        asm func Syscall3(number: uint64, arg0: uint64, arg1: uint64, arg2: uint64) -> int64 {
            mov rax, rdi
            mov rdi, rsi
            mov rsi, rdx
            mov rdx, rcx
            syscall
            jnc done
            neg rax
        done:
            ret
        }

        // Executes a raw FreeBSD system call with four arguments.
        #Abi(.SysV)
        asm func Syscall4(number: uint64, arg0: uint64, arg1: uint64, arg2: uint64, arg3: uint64) -> int64 {
            mov rax, rdi
            mov rdi, rsi
            mov rsi, rdx
            mov rdx, rcx
            mov r10, r8
            syscall
            jnc done
            neg rax
        done:
            ret
        }

        // Executes a raw FreeBSD system call with five arguments.
        #Abi(.SysV)
        asm func Syscall5(number: uint64, arg0: uint64, arg1: uint64, arg2: uint64, arg3: uint64, arg4: uint64) -> int64 {
            mov rax, rdi
            mov rdi, rsi
            mov rsi, rdx
            mov rdx, rcx
            mov r10, r8
            mov r8, r9
            syscall
            jnc done
            neg rax
        done:
            ret
        }

        // Executes a raw FreeBSD system call with six arguments.
        #Abi(.SysV)
        asm func Syscall6(number: uint64, arg0: uint64, arg1: uint64, arg2: uint64, arg3: uint64, arg4: uint64, arg5: uint64) -> int64 {
            mov rax, rdi
            mov rdi, rsi
            mov rsi, rdx
            mov rdx, rcx
            mov r10, r8
            mov r8, r9
            mov r9, qword [rsp + 8]
            syscall
            jnc done
            neg rax
        done:
            ret
        }
    },
    .AArch64 => {
        // Executes a raw FreeBSD system call without arguments.
        asm func Syscall0(number: uint64) -> int64 {
            mov x8, x0
            svc #0
            cneg x0, x0, cs
            ret
        }

        // Executes a raw FreeBSD system call with one argument.
        asm func Syscall1(number: uint64, arg0: uint64) -> int64 {
            mov x8, x0
            mov x0, x1
            svc #0
            cneg x0, x0, cs
            ret
        }

        // Executes a raw FreeBSD system call with two arguments.
        asm func Syscall2(number: uint64, arg0: uint64, arg1: uint64) -> int64 {
            mov x8, x0
            mov x0, x1
            mov x1, x2
            svc #0
            cneg x0, x0, cs
            ret
        }

        // Executes a raw FreeBSD system call with three arguments.
        asm func Syscall3(number: uint64, arg0: uint64, arg1: uint64, arg2: uint64) -> int64 {
            mov x8, x0
            mov x0, x1
            mov x1, x2
            mov x2, x3
            svc #0
            cneg x0, x0, cs
            ret
        }

        // Executes a raw FreeBSD system call with four arguments.
        asm func Syscall4(number: uint64, arg0: uint64, arg1: uint64, arg2: uint64, arg3: uint64) -> int64 {
            mov x8, x0
            mov x0, x1
            mov x1, x2
            mov x2, x3
            mov x3, x4
            svc #0
            cneg x0, x0, cs
            ret
        }

        // Executes a raw FreeBSD system call with five arguments.
        asm func Syscall5(number: uint64, arg0: uint64, arg1: uint64, arg2: uint64, arg3: uint64, arg4: uint64) -> int64 {
            mov x8, x0
            mov x0, x1
            mov x1, x2
            mov x2, x3
            mov x3, x4
            mov x4, x5
            svc #0
            cneg x0, x0, cs
            ret
        }

        // Executes a raw FreeBSD system call with six arguments.
        asm func Syscall6(number: uint64, arg0: uint64, arg1: uint64, arg2: uint64, arg3: uint64, arg4: uint64, arg5: uint64) -> int64 {
            mov x8, x0
            mov x0, x1
            mov x1, x2
            mov x2, x3
            mov x3, x4
            mov x4, x5
            mov x5, x6
            svc #0
            cneg x0, x0, cs
            ret
        }
    },
    else => #Error("Unsupported FreeBSD architecture")
}

/// Widens a file descriptor to the register width a system call takes it in.
///
/// `fd` is read by value; the widened value is returned by copy. Sign extension is what matters: `-1` has to arrive
/// as all ones rather than as a small positive number.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/freebsd/sign-extend-fd
func SignExtendFd(fd: int32) -> uint64 {
    return (fd as int64) as uint64;
}
