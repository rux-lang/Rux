// Reading a clock, and waiting on one.
//
// `ClockMonotonic` counts forward from an arbitrary point and never jumps; `ClockRealtime` tracks wall time and can
// move in either direction. A duration is measured with the first, a timestamp taken from the second.
//
// FreeBSD numbers its clocks differently from Linux -- monotonic is 4 here and 1 there -- which is why an identifier
// must never be carried between the two packages.

import FreeBSD::{ SysClockGetRes, SysClockGetTime, SysNanosleep, Syscall2, Timespec };

/// `CLOCK_REALTIME`: wall-clock time, which can jump when the system clock is set.
///
/// https://rux-lang.dev/docs/api/freebsd/clock-realtime
pub const ClockRealtime: int32 = 0;

/// `CLOCK_MONOTONIC`: time since an unspecified point, which never goes backwards.
///
/// https://rux-lang.dev/docs/api/freebsd/clock-monotonic
pub const ClockMonotonic: int32 = 4;

/// Reads `clockId` into `time`.
///
/// Returns zero, or a negative error number.
///
/// # Safety
///
/// `time` must be non-null and writable.
///
/// https://rux-lang.dev/docs/api/freebsd/clock-get-time
pub func ClockGetTime(clockId: int32, time: *var Timespec) -> int64 {
    return Syscall2(SysClockGetTime, (clockId as int64) as uint64, time as uint64);
}

/// Suspends the caller for the requested duration.
///
/// `remaining` is written when a signal cut the wait short, and may be null. Returns zero, or a negative error
/// number; `EINTR` with the unslept time in `remaining` is how a signal is reported.
///
/// # Safety
///
/// `request` must be non-null, and its nanoseconds must be under one second.
///
/// https://rux-lang.dev/docs/api/freebsd/nanosleep
pub func Nanosleep(request: *Timespec, remaining: *var Timespec) -> int64 {
    return Syscall2(SysNanosleep, request as uint64, remaining as uint64);
}

/// `CLOCK_MONOTONIC_FAST`: like `ClockMonotonic`, read from a cached value rather than the hardware.
///
/// Cheaper and coarser. FreeBSD offers this pairing where Linux offers a coarse clock under a different number.
///
/// https://rux-lang.dev/docs/api/freebsd/clock-monotonic-fast
pub const ClockMonotonicFast: int32 = 12;

/// `CLOCK_REALTIME_FAST`: like `ClockRealtime`, read from a cached value.
///
/// https://rux-lang.dev/docs/api/freebsd/clock-realtime-fast
pub const ClockRealtimeFast: int32 = 10;

/// `CLOCK_PROCESS_CPUTIME_ID`: processor time this process has used.
///
/// https://rux-lang.dev/docs/api/freebsd/clock-process-cpu-time
pub const ClockProcessCpuTime: int32 = 15;

/// Reads the resolution of `clockId` into `resolution`.
///
/// Returns zero, or a negative error number. The resolution is the granularity the clock advances by, not the cost
/// of reading it and not a promise about accuracy.
///
/// # Safety
///
/// `resolution` must be non-null and writable.
///
/// https://rux-lang.dev/docs/api/freebsd/clock-get-resolution
pub func ClockGetResolution(clockId: int32, resolution: *var Timespec) -> int64 {
    return Syscall2(SysClockGetRes, (clockId as int64) as uint64, resolution as uint64);
}
