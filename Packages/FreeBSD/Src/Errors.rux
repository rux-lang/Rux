// How a FreeBSD system call reports failure, and the numbers it reports.
// FreeBSD does not report an error the way Linux does. The kernel sets the carry flag and leaves a *positive* errno
// in the result register, so the raw instruction result cannot be tested for sign. The assembly wrappers in
// `Syscall` normalize that to Linux's convention — a small negative number — so everything above them reads the
// same on both systems, and `IsError` and `Errno` are then the same two functions.
// The names keep the system's own spelling, because `EINVAL` is what a man page names. The values below are
// FreeBSD's, which agree with Linux for the first thirty-four and then diverge.

/// `EPERM`: the operation is not permitted to this caller.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#eperm
#Allow("naming.const")
pub const EPERM: int64 = 1;

/// `ENOENT`: no such file or directory.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#enoent
#Allow("naming.const")
pub const ENOENT: int64 = 2;

/// `ESRCH`: no such process.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#esrch
#Allow("naming.const")
pub const ESRCH: int64 = 3;

/// `EINTR`: the call was interrupted by a signal before it did anything.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#eintr
#Allow("naming.const")
pub const EINTR: int64 = 4;

/// `EIO`: a low-level input or output error.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#eio
#Allow("naming.const")
pub const EIO: int64 = 5;

/// `ENXIO`: no such device or address.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#enxio
#Allow("naming.const")
pub const ENXIO: int64 = 6;

/// `EBADF`: the file descriptor is not open, or is not open for what was asked.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#ebadf
#Allow("naming.const")
pub const EBADF: int64 = 9;

/// `EAGAIN`: the operation would block, and the descriptor was set not to.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#eagain
#Allow("naming.const")
pub const EAGAIN: int64 = 35;

/// `ENOMEM`: not enough memory to satisfy the request.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#enomem
#Allow("naming.const")
pub const ENOMEM: int64 = 12;

/// `EACCES`: permission denied.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#eacces
#Allow("naming.const")
pub const EACCES: int64 = 13;

/// `EFAULT`: an address the call was given is outside the caller's address space.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#efault
#Allow("naming.const")
pub const EFAULT: int64 = 14;

/// `EBUSY`: the resource is in use.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#ebusy
#Allow("naming.const")
pub const EBUSY: int64 = 16;

/// `EEXIST`: the file already exists.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#eexist
#Allow("naming.const")
pub const EEXIST: int64 = 17;

/// `EXDEV`: the two paths are on different file systems.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#exdev
#Allow("naming.const")
pub const EXDEV: int64 = 18;

/// `ENOTDIR`: a path component that had to be a directory is not one.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#enotdir
#Allow("naming.const")
pub const ENOTDIR: int64 = 20;

/// `EISDIR`: the target is a directory and the operation is not one a directory accepts.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#eisdir
#Allow("naming.const")
pub const EISDIR: int64 = 21;

/// `EINVAL`: an argument is not valid.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#einval
#Allow("naming.const")
pub const EINVAL: int64 = 22;

/// `EMFILE`: this process has too many descriptors open.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#emfile
#Allow("naming.const")
pub const EMFILE: int64 = 24;

/// `ENOSPC`: the device has no room left.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#enospc
#Allow("naming.const")
pub const ENOSPC: int64 = 28;

/// `ESPIPE`: the descriptor is a pipe or socket and cannot be seeked.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#espipe
#Allow("naming.const")
pub const ESPIPE: int64 = 29;

/// `EROFS`: the file system is mounted read-only.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#erofs
#Allow("naming.const")
pub const EROFS: int64 = 30;

/// `EPIPE`: the reading end of the pipe is closed.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#epipe
#Allow("naming.const")
pub const EPIPE: int64 = 32;

/// `ENAMETOOLONG`: the path or a component of it is too long.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#enametoolong
#Allow("naming.const")
pub const ENAMETOOLONG: int64 = 63;

/// `ELOOP`: too many symbolic links were followed resolving the path.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#eloop
#Allow("naming.const")
pub const ELOOP: int64 = 62;

/// `ENOSYS`: the kernel does not implement this call.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#enosys
#Allow("naming.const")
pub const ENOSYS: int64 = 78;

/// `EOVERFLOW`: a value is too large for the type the call reports it in.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#eoverflow
#Allow("naming.const")
pub const EOVERFLOW: int64 = 84;

/// `ETIMEDOUT`: the operation timed out.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#etimedout
#Allow("naming.const")
pub const ETIMEDOUT: int64 = 60;

/// The largest error number the normalized error range holds.
/// @see https://rux-lang.dev/docs/api/freebsd/errors#maximum-errno
pub const MaximumErrno: int64 = 4095;

/// Whether a raw system-call result is one of the normalized error values.
/// `result` is read by value. True for `-4095` through `-1`, and false for everything else, including every valid
/// mapping address a memory call returns.
/// Cannot fail. Runs in constant time and allocates nothing.
/// @param result the raw result to test
/// @returns whether it is one of the reserved error values
/// @see https://rux-lang.dev/docs/api/freebsd/errors#is-error
pub func IsError(result: int64) -> bool {
    return result < 0 && result >= -MaximumErrno;
}

/// The error number a raw system-call result carries, or zero when it carries none.
/// `result` is read by value; the number is returned by copy, positive, as a man page names it.
/// Cannot fail. Runs in constant time and allocates nothing.
/// @param result the raw result to read
/// @returns the error number, positive, or zero when the result carries none
/// @see https://rux-lang.dev/docs/api/freebsd/errors#errno
pub func Errno(result: int64) -> int64 {
    return IsError(result) ? -result : 0;
}
