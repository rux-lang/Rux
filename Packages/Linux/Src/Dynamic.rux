// Loading a shared object at run time, and finding a symbol inside it.
// This is the one part of the Linux interface that is not a system call. The kernel knows nothing about `dlopen`:
// resolution, relocation and reference counting are all the dynamic linker's, and the entry points live in libc.
// That is why this module links a library where the rest of the package links nothing.
// The names are the platform's own, lowercase, because they are the symbols the loader exports and what a reader
// porting code will look for.

// glibc moved the dynamic-loading entry points into the main C library in 2.34; a separate `libdl.so.2` still exists
// as a stub for older links. Naming libc is what works on both.
const LoaderLib = "libc.so.6";

/// `RTLD_LAZY`: resolve a function symbol the first time it is called rather than at load.
/// @see https://rux-lang.dev/docs/api/linux/dynamic#rtld-lazy
#Allow("naming.const")
pub const RTLD_LAZY: int32 = 1;

/// `RTLD_NOW`: resolve every symbol before `dlopen` returns, so a missing one is reported there.
/// @see https://rux-lang.dev/docs/api/linux/dynamic#rtld-now
#Allow("naming.const")
pub const RTLD_NOW: int32 = 2;

/// `RTLD_GLOBAL`: make this object's symbols available to objects loaded afterwards.
/// @see https://rux-lang.dev/docs/api/linux/dynamic#rtld-global
#Allow("naming.const")
pub const RTLD_GLOBAL: int32 = 256;

/// `RTLD_LOCAL`: keep this object's symbols to itself, which is the default.
/// @see https://rux-lang.dev/docs/api/linux/dynamic#rtld-local
#Allow("naming.const")
pub const RTLD_LOCAL: int32 = 0;

/// `RTLD_NODELETE`: do not unload the object when its last reference goes, so its storage stays valid.
/// @see https://rux-lang.dev/docs/api/linux/dynamic#rtld-nodelete
#Allow("naming.const")
pub const RTLD_NODELETE: int32 = 4096;

#Link(LoaderLib)
extern {
    /// Loads a shared object and returns a handle to it, or null on failure.
    /// A name without a slash is resolved by the loader's own search rules, and one with a slash as a path. A second
    /// call for an object already loaded returns the same handle and raises its reference count rather than loading
    /// it twice. Failure is reported through `dlerror`, not errno.
    /// @param filename a NUL-terminated name or path, or null for the main program
    /// @param flags `RTLD_LAZY` or `RTLD_NOW`, combined with the other `RTLD_*` flags
    /// @returns a handle for `dlsym` and `dlclose`, or null with the reason in `dlerror`
    /// @see https://rux-lang.dev/docs/api/linux/dynamic#dlopen
    /// @see https://man7.org/linux/man-pages/man3/dlopen.3.html
    pub func dlopen(filename: *char8, flags: int32) -> *var opaque;

    /// Finds a symbol in a loaded object and returns its address, or null.
    /// A null return is ambiguous, since a symbol whose address is legitimately zero exists. Clear `dlerror` by calling
    /// it, then call this, then read `dlerror` again to tell the two apart.
    /// @param handle a handle from `dlopen`
    /// @param symbol the NUL-terminated symbol name
    /// @returns the symbol's address, or null
    /// @see https://rux-lang.dev/docs/api/linux/dynamic#dlsym
    /// @see https://man7.org/linux/man-pages/man3/dlsym.3.html
    pub func dlsym(handle: *var opaque, symbol: *char8) -> *var opaque;

    /// Drops one reference to a loaded object, unloading it when the last one goes.
    /// Every address obtained from the object through `dlsym` becomes invalid once it is actually unloaded, which this
    /// gives no way to observe.
    /// @param handle a handle from `dlopen`
    /// @returns zero on success, and non-zero with the reason in `dlerror`
    /// @see https://rux-lang.dev/docs/api/linux/dynamic#dlclose
    /// @see https://man7.org/linux/man-pages/man3/dlclose.3.html
    pub func dlclose(handle: *var opaque) -> int32;

    /// Reports the most recent loader error and clears it, or returns null when there is none.
    /// The message points at storage the loader owns and a later call may reuse. Reading it clears the error, so two
    /// calls in a row report the second as no error at all.
    /// @returns a NUL-terminated message, or null
    /// @see https://rux-lang.dev/docs/api/linux/dynamic#dlerror
    /// @see https://man7.org/linux/man-pages/man3/dlerror.3.html
    pub func dlerror() -> *char8;
}
