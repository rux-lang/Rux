// Reading and writing through a file descriptor, and the three descriptors a process starts with.
//
// The wrappers here name their arguments and nothing more: each returns the kernel's raw result, which is a byte
// count or a small negative error number. A short count is not an error and not an end of file — a read that returns
// fewer bytes than asked for has to be called again, which is the caller's loop to write.

import Core::{ #target, #Error };
import Linux::{ FileDescriptor, FileMode, FileOffset, SignExtendFd, SysChdir, SysClose, SysDup3, SysFstat,
                SysGetcwd, SysReadlinkAt,
                SysFchmodAt, SysFsync, SysFtruncate, SysGetdents64, SysLinkAt, SysLseek, SysMkdirAt, SysNewFstatAt,
                SysOpenAt, SysPipe2, SysRead,
                SysRenameAt, SysSymlinkAt, SysUnlinkAt, SysUtimensAt, SysWrite, Syscall1, Syscall2, Syscall3, Syscall4,
                Syscall5 };

/// The descriptor a process reads its input from, unless something reassigned it.
///
/// @see https://rux-lang.dev/docs/api/linux/std-in
pub const StdIn: int32 = 0;

/// The descriptor a process writes its output to.
///
/// @see https://rux-lang.dev/docs/api/linux/std-out
pub const StdOut: int32 = 1;

/// The descriptor a process writes its diagnostics to, which is separate so it survives a redirected output.
///
/// @see https://rux-lang.dev/docs/api/linux/std-err
pub const StdErr: int32 = 2;

/// Reads up to `count` bytes from `fd` into `buffer`.
///
/// `fd` and `count` are read by value; `buffer` is borrowed and written. Returns the number of bytes actually read,
/// zero at end of file, or a negative error number.
///
/// A count smaller than `count` is ordinary and is not an end of file: a pipe, a terminal, or a signal can each cut a
/// read short. Only zero means the source has ended.
///
/// # Safety
///
/// `buffer` must be writable for `count` bytes. The kernel checks the address and reports `EFAULT` rather than
/// faulting, but it does not check the length against anything the caller knows.
///
/// @param fd an open descriptor
/// @param buffer receives the bytes
/// @param count how many bytes to ask for
/// @returns the bytes read, zero at end of file, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/read
pub func Read(fd: FileDescriptor, buffer: *var opaque, count: uint) -> int64 {
    return Syscall3(SysRead, SignExtendFd(fd), buffer as uint64, count as uint64);
}

/// Writes up to `count` bytes from `buffer` to `fd`.
///
/// `fd` and `count` are read by value; `buffer` is borrowed and read. Returns the number of bytes actually written,
/// or a negative error number.
///
/// A count smaller than `count` is ordinary, and the rest has to be written by calling again from where this
/// stopped. Writing to a pipe whose reader has closed raises `SIGPIPE` before this can report `EPIPE`.
///
/// # Safety
///
/// `buffer` must be readable for `count` bytes.
///
/// @param fd an open descriptor
/// @param buffer the bytes to write
/// @param count how many bytes to offer
/// @returns the bytes written, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/write
pub func Write(fd: FileDescriptor, buffer: *opaque, count: uint) -> int64 {
    return Syscall3(SysWrite, SignExtendFd(fd), buffer as uint64, count as uint64);
}

/// Closes `fd` and releases what the kernel held for it.
///
/// `fd` is read by value. Returns zero, or a negative error number.
///
/// A failure does not mean the descriptor is still open: on Linux it is released whatever this reports, so retrying
/// a failed close can close a descriptor another thread has since opened under the same number.
///
/// @param fd an open descriptor
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/close
pub func Close(fd: FileDescriptor) -> int64 {
    return Syscall1(SysClose, SignExtendFd(fd));
}

/// `AT_FDCWD`: resolve a relative path against the current directory rather than a descriptor.
///
/// The value every `*at` call takes when the caller means an ordinary path. It is `-100` rather than `-1` so that a
/// stray `-1` from a failed open cannot be mistaken for it.
///
/// @see https://rux-lang.dev/docs/api/linux/at-fd-cwd
pub const AtFdCwd: int32 = -100;

/// `O_RDONLY`: open for reading only.
///
/// @see https://rux-lang.dev/docs/api/linux/open-read-only
pub const OpenReadOnly: int32 = 0;

/// `O_WRONLY`: open for writing only.
///
/// @see https://rux-lang.dev/docs/api/linux/open-write-only
pub const OpenWriteOnly: int32 = 1;

/// `O_RDWR`: open for both reading and writing.
///
/// @see https://rux-lang.dev/docs/api/linux/open-read-write
pub const OpenReadWrite: int32 = 2;

/// `O_CREAT`: create the file when it does not exist, which is when the mode argument is read.
///
/// @see https://rux-lang.dev/docs/api/linux/open-create
pub const OpenCreate: int32 = 64;

/// `O_EXCL`: with `OpenCreate`, fail rather than open a file that already exists.
///
/// The pair is what makes creating a file an atomic claim on the name.
///
/// @see https://rux-lang.dev/docs/api/linux/open-exclusive
pub const OpenExclusive: int32 = 128;

/// `O_TRUNC`: truncate the file to nothing when opening it for writing.
///
/// @see https://rux-lang.dev/docs/api/linux/open-truncate
pub const OpenTruncate: int32 = 512;

/// `O_APPEND`: every write goes to the end, atomically with respect to other appenders.
///
/// @see https://rux-lang.dev/docs/api/linux/open-append
pub const OpenAppend: int32 = 1024;

/// `O_NONBLOCK`: reads and writes report `EAGAIN` rather than waiting.
///
/// @see https://rux-lang.dev/docs/api/linux/open-non-blocking
pub const OpenNonBlocking: int32 = 2048;

/// `O_CLOEXEC`: close this descriptor automatically when the process executes a new program.
///
/// Worth setting on nearly everything: without it a descriptor leaks into every child, which is both a resource and
/// a confidentiality problem.
///
/// @see https://rux-lang.dev/docs/api/linux/open-close-on-exec
pub const OpenCloseOnExec: int32 = 524288;

// `O_DIRECTORY` is the one open flag whose bit the architectures assign differently, so it is declared once per
// architecture and documented on each. Documentation attaches to a declaration, and a `when` block is not one.
when #target.arch {
    .X86_64 => {
        /// `O_DIRECTORY`: fail unless the target is a directory.
        ///
        /// x86-64 kept the number it had before the generic table was drawn up. On AArch64 this same bit means
        /// `O_DIRECT` instead, so a directory opened with the wrong number fails with `EINVAL` rather than opening.
        ///
        /// @see https://rux-lang.dev/docs/api/linux/open-directory
        pub const OpenDirectory: int32 = 65536;
    }
    .AArch64 => {
        /// `O_DIRECTORY`: fail unless the target is a directory.
        ///
        /// AArch64 uses the generic table's number. x86-64 uses a different one, and its bit means `O_DIRECT` here,
        /// so a directory opened with the wrong number fails with `EINVAL` rather than opening.
        ///
        /// @see https://rux-lang.dev/docs/api/linux/open-directory
        pub const OpenDirectory: int32 = 16384;
    }
    else => #Error("Unsupported Linux architecture")
}

/// `SEEK_SET`: measure the new offset from the start of the file.
///
/// @see https://rux-lang.dev/docs/api/linux/seek-set
pub const SeekSet: int32 = 0;

/// `SEEK_CUR`: measure the new offset from the current one.
///
/// @see https://rux-lang.dev/docs/api/linux/seek-current
pub const SeekCurrent: int32 = 1;

/// `SEEK_END`: measure the new offset from the end of the file.
///
/// @see https://rux-lang.dev/docs/api/linux/seek-end
pub const SeekEnd: int32 = 2;

/// Opens `path` relative to `directoryFd` and returns a descriptor, or a negative error number.
///
/// `directoryFd` is a descriptor for the directory a relative path is resolved against, or `AtFdCwd` for the current
/// one; an absolute path ignores it. `path` is borrowed and must be null-terminated. `flags` is one of the three
/// access modes combined with whatever else applies. `mode` is the permission bits a newly created file gets, and is
/// read only when `OpenCreate` is set.
///
/// This is the only open the package offers, because it is the only one AArch64 has.
///
/// # Safety
///
/// `path` must be non-null and terminated. The mode is masked by the process umask, which this cannot see.
///
/// @param directoryFd the directory `path` is relative to, or `AtFdCwd` for an ordinary path
/// @param path the path to open, as a null-terminated byte string
/// @param flags the access mode and the open flags, combined with `|`
/// @param mode the permission bits for a file this creates, ignored otherwise
/// @returns the new descriptor, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/open-at
pub func OpenAt(directoryFd: FileDescriptor, path: *char8, flags: int32, mode: FileMode) -> int64 {
    return Syscall4(SysOpenAt, SignExtendFd(directoryFd), path as uint64, (flags as int64) as uint64,
                    mode as uint64);
}

/// Moves the file offset of `fd` and returns where it ended up, or a negative error number.
///
/// `offset` is measured from whichever origin `whence` names. Returns the resulting absolute offset.
///
/// Seeking past the end is allowed and creates a hole when something is later written there. A pipe or socket has no
/// offset to move and reports `ESPIPE`.
///
/// @param fd an open descriptor
/// @param offset how far to move, interpreted according to `whence`
/// @param whence `SeekSet`, `SeekCurrent` or `SeekEnd`
/// @returns the resulting offset from the start, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/lseek
pub func Lseek(fd: FileDescriptor, offset: FileOffset, whence: int32) -> int64 {
    return Syscall3(SysLseek, SignExtendFd(fd), offset as uint64, (whence as int64) as uint64);
}

/// Reads directory entries from `fd` into `buffer`, and returns the bytes filled, zero at the end, or a negative
/// error number.
///
/// The buffer holds packed `linux_dirent64` records: inode at offset 0 (8 bytes), a seek cookie at 8 (8 bytes),
/// the record's length at 16 (2 bytes), the entry type at 18 (1 byte), and the NUL-terminated name from 19. The
/// kernel writes as many whole records as fit; call again for the rest.
///
/// @param fd an open descriptor
/// @param buffer receives the packed directory records
/// @param count how many bytes `buffer` holds
/// @returns the bytes filled, zero at the end of the directory, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/getdents64
pub func Getdents64(fd: FileDescriptor, buffer: *var opaque, count: uint) -> int64 {
    return Syscall3(SysGetdents64, SignExtendFd(fd), buffer as uint64, count as uint64);
}

/// Creates a hard link: `newPath` becomes a second name for the file `oldPath` names.
///
/// Returns zero, or a negative error number. `flags` is zero to leave a symbolic link at `oldPath` unfollowed,
/// or `FollowSymlinks` to link what it points at.
///
/// @param oldDirectoryFd the directory `oldPath` is relative to
/// @param oldPath the existing name
/// @param newDirectoryFd the directory `newPath` is relative to
/// @param newPath the new name for the same file
/// @param flags zero, or `FollowSymlinks` to link what a final link points at
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/linkat
pub func LinkAt(oldDirectoryFd: FileDescriptor, oldPath: *char8, newDirectoryFd: FileDescriptor, newPath: *char8,
            flags: int32) -> int64 {
    return Syscall5(SysLinkAt, SignExtendFd(oldDirectoryFd), oldPath as uint64, SignExtendFd(newDirectoryFd),
                    newPath as uint64, (flags as int64) as uint64);
}

/// `AT_SYMLINK_FOLLOW`: make `LinkAt` link a symbolic link's target rather than the link.
///
/// @see https://rux-lang.dev/docs/api/linux/follow-symlinks
pub const FollowSymlinks: int32 = 0x0400;

/// Creates a symbolic link at `linkPath` holding `target` as its text.
///
/// Returns zero, or a negative error number. The target is stored, not checked: a dangling link is created as
/// readily as a good one, which is a property callers rely on.
///
/// @param target the text the link will hold, which need not exist
/// @param newDirectoryFd the directory `linkPath` is relative to
/// @param linkPath the link to create
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/symlinkat
pub func SymlinkAt(target: *char8, newDirectoryFd: FileDescriptor, linkPath: *char8) -> int64 {
    return Syscall3(SysSymlinkAt, target as uint64, SignExtendFd(newDirectoryFd), linkPath as uint64);
}

/// `AT_SYMLINK_NOFOLLOW`: act on a symbolic link itself rather than on what it points at.
///
/// @see https://rux-lang.dev/docs/api/linux/symlink-no-follow
pub const SymlinkNoFollow: int32 = 0x0100;

/// Fills `statBuffer` with what the kernel knows about the file `path` names.
///
/// The kernel's own name for this call is `newfstatat`, which `SysNewFstatAt` keeps; the wrapper is spelled the way
/// macOS and FreeBSD spell theirs, so one name reaches the call on all three systems.
///
/// # Safety
///
/// `statBuffer` must be writable for the whole of the architecture's `struct stat`, whose layout this package
/// does not model: 144 bytes on x86-64 and 128 on AArch64, with the fields at different offsets in each.
///
/// @param directoryFd the directory `path` is relative to, or `AtFdCwd` for an ordinary path
/// @param flags zero to follow a symbolic link at the end of the path, or `SymlinkNoFollow` to describe the link
/// @param path the path to describe, as a null-terminated byte string
/// @param statBuffer receives the architecture's `struct stat`
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/fstat-at
pub func FstatAt(directoryFd: FileDescriptor, path: *char8, statBuffer: *var opaque, flags: int32) -> int64 {
    return Syscall4(SysNewFstatAt, SignExtendFd(directoryFd), path as uint64, statBuffer as uint64,
                    (flags as int64) as uint64);
}

/// Sets the permission bits of the file `path` names.
///
/// `directoryFd` is `AtFdCwd` for an ordinary path. Returns zero, or a negative error number. Linux does not
/// support `SymlinkNoFollow` here and reports `EOPNOTSUPP` for it: a symbolic link's own bits mean nothing.
///
/// @param directoryFd the directory `path` is relative to, or `AtFdCwd` for an ordinary path
/// @param path the path whose bits are set
/// @param mode the permission bits to set
/// @param flags zero, or `SymlinkNoFollow` where the system supports it
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/fchmod-at
pub func FchmodAt(directoryFd: FileDescriptor, path: *char8, mode: FileMode, flags: int32) -> int64 {
    return Syscall4(SysFchmodAt, SignExtendFd(directoryFd), path as uint64, (mode as int64) as uint64,
                    (flags as int64) as uint64);
}

/// Sets the access and modification times of the file `path` names.
///
/// `times` is borrowed and holds two `timespec` values — access first, then modification — each a whole-second
/// count and a nanosecond fraction, both 8 bytes. A null `times` sets both to now. `flags` may carry
/// `SymlinkNoFollow`. Returns zero, or a negative error number.
///
/// @param directoryFd the directory `path` is relative to, or `AtFdCwd` for an ordinary path
/// @param path the path whose times are set
/// @param times two `timespec` values, or null for now
/// @param flags zero to follow a final symbolic link, or `SymlinkNoFollow`
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/utimens-at
pub func UtimensAt(directoryFd: FileDescriptor, path: *char8, times: *opaque, flags: int32) -> int64 {
    return Syscall4(SysUtimensAt, SignExtendFd(directoryFd), path as uint64, times as uint64,
                    (flags as int64) as uint64);
}

/// Writes the current working directory's absolute path into `buffer`, NUL-terminated.
///
/// Returns the length written including the terminator, or a negative error number; `ERANGE` where the buffer is
/// too small for the answer.
///
/// # Safety
///
/// `buffer` must be writable for `size` bytes.
///
/// @param buffer receives the working directory as a null-terminated path
/// @param size how many bytes `buffer` holds
/// @returns the bytes written including the terminator, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/getcwd
pub func Getcwd(buffer: *var char8, size: uint) -> int64 {
    return Syscall2(SysGetcwd, buffer as uint64, size as uint64);
}

/// Makes `path` the process's working directory.
///
/// Returns zero, or a negative error number. The change is process-wide and immediately visible to every thread,
/// which is why nothing above this should call it casually.
///
/// @param path the directory to move to
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/chdir
pub func Chdir(path: *char8) -> int64 {
    return Syscall1(SysChdir, path as uint64);
}

/// Reads the text a symbolic link holds into `buffer`.
///
/// `directoryFd` is `AtFdCwd` for an ordinary path. Returns the number of bytes written, or a negative error
/// number. The text is **not** NUL-terminated, and is silently truncated where it does not fit, so a caller that
/// filled the buffer exactly cannot tell truncation from a perfect fit and should retry with more room.
///
/// @param directoryFd the directory `path` is relative to, or `AtFdCwd` for an ordinary path
/// @param path the symbolic link to read
/// @param buffer receives the link's text, without a terminator
/// @param size how many bytes `buffer` holds
/// @returns the bytes written, which equals `size` when the text was truncated, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/readlink-at
pub func ReadlinkAt(directoryFd: FileDescriptor, path: *char8, buffer: *var char8, size: uint) -> int64 {
    return Syscall4(SysReadlinkAt, SignExtendFd(directoryFd), path as uint64, buffer as uint64, size as uint64);
}

/// Flushes everything written to `fd` through to the storage device.
///
/// Returns zero, or a negative error number. Returning only once the device has acknowledged the write is the whole
/// point: without it, data a successful `Write` reported may still be lost to a power failure.
///
/// @param fd an open descriptor
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/fsync
pub func Fsync(fd: FileDescriptor) -> int64 {
    return Syscall1(SysFsync, SignExtendFd(fd));
}

/// Sets the length of the file behind `fd` to `length`.
///
/// Returns zero, or a negative error number. Growing a file this way creates a hole rather than allocating, so a
/// later write into it can still fail with `ENOSPC`. Shrinking discards what was past the new end.
///
/// @param fd an open descriptor
/// @param length the size the file should have afterwards
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/ftruncate
pub func Ftruncate(fd: FileDescriptor, length: FileOffset) -> int64 {
    return Syscall2(SysFtruncate, SignExtendFd(fd), length as uint64);
}

/// Removes the name `path` from its directory.
///
/// `flags` is zero to remove a file, or `RemoveDirectory` to remove an empty directory. Returns zero, or a negative
/// error number.
///
/// Removing a name does not free the file: anything still holding it open keeps reading and writing it, and the
/// storage goes only when the last descriptor closes.
///
/// # Safety
///
/// `path` must be non-null and terminated.
///
/// @param directoryFd the directory `path` is relative to, or `AtFdCwd` for an ordinary path
/// @param path the name to remove
/// @param flags zero for a file, or `RemoveDirectory` for a directory
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/unlink-at
pub func UnlinkAt(directoryFd: FileDescriptor, path: *char8, flags: int32) -> int64 {
    return Syscall3(SysUnlinkAt, SignExtendFd(directoryFd), path as uint64, (flags as int64) as uint64);
}

/// `AT_REMOVEDIR`: make `UnlinkAt` remove a directory rather than a file.
///
/// @see https://rux-lang.dev/docs/api/linux/remove-directory
pub const RemoveDirectory: int32 = 512;

/// Creates a directory named `path` with permission bits `mode`.
///
/// Returns zero, or a negative error number — `EEXIST` when the name is taken, which is how this is used as a lock.
///
/// # Safety
///
/// `path` must be non-null and terminated. The mode is masked by the process umask.
///
/// @param directoryFd the directory `path` is relative to, or `AtFdCwd` for an ordinary path
/// @param path the directory to create
/// @param mode the permission bits for it
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/mkdir-at
pub func MkdirAt(directoryFd: FileDescriptor, path: *char8, mode: FileMode) -> int64 {
    return Syscall3(SysMkdirAt, SignExtendFd(directoryFd), path as uint64, mode as uint64);
}

/// Renames `oldPath` to `newPath`, each resolved against its own directory descriptor.
///
/// Returns zero, or a negative error number. Within one file system this replaces any existing `newPath` atomically,
/// which is what makes it the way to publish a file that was written under a temporary name. Across file systems it
/// reports `EXDEV` rather than copying.
///
/// # Safety
///
/// Both paths must be non-null and terminated.
///
/// @param oldDirectoryFd the directory `oldPath` is relative to
/// @param oldPath the name to move
/// @param newDirectoryFd the directory `newPath` is relative to
/// @param newPath the name to move it to
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/rename-at
pub func RenameAt(oldDirectoryFd: FileDescriptor, oldPath: *char8, newDirectoryFd: FileDescriptor,
              newPath: *char8) -> int64 {
    return Syscall4(SysRenameAt, SignExtendFd(oldDirectoryFd), oldPath as uint64, SignExtendFd(newDirectoryFd),
                    newPath as uint64);
}

/// Fills `statBuffer` with what the kernel knows about the file behind `fd`.
///
/// `statBuffer` is borrowed and written with the kernel's `struct stat`, whose layout this package does not model:
/// it differs by architecture, and reading it needs a declaration that says which. Returns zero, or a negative error
/// number.
///
/// # Safety
///
/// `statBuffer` must be writable for the whole of the architecture's `struct stat`, which is 144 bytes on x86-64 and
/// 128 on AArch64. Nothing here checks that.
///
/// @param fd an open descriptor
/// @param statBuffer receives the architecture's `struct stat`
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/fstat
pub func Fstat(fd: FileDescriptor, statBuffer: *var opaque) -> int64 {
    return Syscall2(SysFstat, SignExtendFd(fd), statBuffer as uint64);
}

/// Makes `newFd` a copy of `oldFd`, closing whatever `newFd` was.
///
/// `flags` may carry `OpenCloseOnExec`, which is the reason this exists rather than `dup2`: setting it afterwards
/// leaves a window in which another thread can execute a new program and leak the descriptor. Returns `newFd`, or a
/// negative error number.
///
/// Duplicating a descriptor onto itself reports `EINVAL` here, where `dup2` returned it unchanged.
///
/// @param oldFd the descriptor to duplicate
/// @param newFd the number the duplicate should have
/// @param flags zero, or `OpenCloseOnExec` for the new descriptor
/// @returns `newFd`, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/dup3
pub func Dup3(oldFd: FileDescriptor, newFd: FileDescriptor, flags: int32) -> int64 {
    return Syscall3(SysDup3, SignExtendFd(oldFd), SignExtendFd(newFd), (flags as int64) as uint64);
}

/// Creates a pipe and writes its two descriptors into `descriptors`.
///
/// `descriptors` is borrowed and receives the reading end at index zero and the writing end at index one. `flags`
/// may carry `OpenCloseOnExec` and `OpenNonBlocking`. Returns zero, or a negative error number.
///
/// # Safety
///
/// `descriptors` must be writable for two `int32` values.
///
/// @param descriptors receives the read end at index zero and the write end at index one
/// @param flags zero, or `OpenCloseOnExec` for both ends
/// @returns zero, or a negative error number
/// @see https://rux-lang.dev/docs/api/linux/pipe2
pub func Pipe2(descriptors: *var int32, flags: int32) -> int64 {
    return Syscall2(SysPipe2, descriptors as uint64, (flags as int64) as uint64);
}
