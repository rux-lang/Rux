// The smallest and largest elements of a sequence, and clamping a value into a range.
//
// Every search here answers with an index rather than a value, because the index is the more useful answer and the
// value is one dereference away. An empty slice has no smallest element, so the answer is `None` rather than a
// sentinel index or a default-constructed value that was never in the sequence.
//
// Ties go to the first: `MinIndex` reports the earliest of several equal smallest elements, and `MaxIndex` the
// earliest of several equal largest ones. That is a promise rather than an accident, and it is what makes a sort
// built on these predictable.
//
// The plain forms need `<` on the element type. The `By` forms take a three-way comparison instead, which is what to
// use when the element has no ordering of its own, or when the wanted order is not its own.

import Core::{ Option, Ordering };

/// The index of the smallest element of `items`.
///
/// `items` is borrowed and read. Reports `None` for an empty slice, and the earliest index when several elements
/// tie.
///
/// Requires `<` on the element type.
///
/// Cannot fail. Runs in time proportional to the length, comparing each element once, and allocates nothing.
///
/// https://rux-lang.dev/docs/api/algorithms/min-index
pub func MinIndex<T>(items: Slice<T>) -> Option<uint> {
    if items.length == 0 { return Option::None<uint>(); }
    var best: uint = 0;
    var index: uint = 1;
    while index < items.length {
        if items.data[index] < items.data[best] {
            best = index;
        }
        index++;
    }
    return Option::Some<uint>(best);
}

/// The index of the largest element of `items`.
///
/// `items` is borrowed and read. Reports `None` for an empty slice, and the earliest index when several elements
/// tie.
///
/// Requires `<` on the element type.
///
/// Cannot fail. Runs in time proportional to the length and allocates nothing.
///
/// https://rux-lang.dev/docs/api/algorithms/max-index
pub func MaxIndex<T>(items: Slice<T>) -> Option<uint> {
    if items.length == 0 { return Option::None<uint>(); }
    var best: uint = 0;
    var index: uint = 1;
    while index < items.length {
        if items.data[best] < items.data[index] {
            best = index;
        }
        index++;
    }
    return Option::Some<uint>(best);
}

/// The index of the smallest element of `items`, with `compare` deciding.
///
/// `items` is borrowed and read; `compare` is called once per element after the first. Reports `None` for an empty
/// slice, and the earliest index when several elements tie.
///
/// Cannot fail. Runs in time proportional to the length and allocates nothing beyond whatever `compare` does.
///
/// https://rux-lang.dev/docs/api/algorithms/min-index-by
pub func MinIndexBy<T>(items: Slice<T>, compare: func(T, T) -> Ordering) -> Option<uint> {
    if items.length == 0 { return Option::None<uint>(); }
    var best: uint = 0;
    var index: uint = 1;
    while index < items.length {
        if compare(items.data[index], items.data[best]).IsLess() {
            best = index;
        }
        index++;
    }
    return Option::Some<uint>(best);
}

/// The index of the largest element of `items`, with `compare` deciding.
///
/// `items` is borrowed and read; `compare` is called once per element after the first. Reports `None` for an empty
/// slice, and the earliest index when several elements tie.
///
/// Cannot fail. Runs in time proportional to the length and allocates nothing beyond whatever `compare` does.
///
/// https://rux-lang.dev/docs/api/algorithms/max-index-by
pub func MaxIndexBy<T>(items: Slice<T>, compare: func(T, T) -> Ordering) -> Option<uint> {
    if items.length == 0 { return Option::None<uint>(); }
    var best: uint = 0;
    var index: uint = 1;
    while index < items.length {
        if compare(items.data[best], items.data[index]).IsLess() {
            best = index;
        }
        index++;
    }
    return Option::Some<uint>(best);
}

/// The indices of the smallest and largest elements of `items`, in one pass.
///
/// `items` is borrowed and read; `smallest` and `largest` are written only when this reports true. Reports false for
/// an empty slice and writes neither. Ties go to the earliest index on both ends, exactly as the single-ended
/// searches promise.
///
/// Two separate passes would compare each element twice; this compares them in pairs and so makes about three
/// comparisons for every two elements.
///
/// Requires `<` on the element type.
///
/// Cannot fail. Runs in time proportional to the length and allocates nothing.
///
/// # Safety
///
/// `smallest` and `largest` must be non-null and writable.
///
/// https://rux-lang.dev/docs/api/algorithms/min-max-index
pub func MinMaxIndex<T>(items: Slice<T>, smallest: *var uint, largest: *var uint) -> bool {
    if items.length == 0 { return false; }
    var low: uint = 0;
    var high: uint = 0;
    var index: uint = 1;
    while index < items.length {
        if items.data[index] < items.data[low] {
            low = index;
        }
        if items.data[high] < items.data[index] {
            high = index;
        }
        index++;
    }
    *smallest = low;
    *largest = high;
    return true;
}

/// The indices of the smallest and largest elements of `items`, in one pass, with `compare` deciding.
///
/// `items` is borrowed and read; `smallest` and `largest` are written only when this reports true. Reports false for
/// an empty slice and writes neither. Ties go to the earliest index on both ends.
///
/// Cannot fail. Runs in time proportional to the length and allocates nothing beyond whatever `compare` does.
///
/// # Safety
///
/// `smallest` and `largest` must be non-null and writable.
///
/// https://rux-lang.dev/docs/api/algorithms/min-max-index-by
pub func MinMaxIndexBy<T>(items: Slice<T>, compare: func(T, T) -> Ordering, smallest: *var uint,
                      largest: *var uint) -> bool {
    if items.length == 0 { return false; }
    var low: uint = 0;
    var high: uint = 0;
    var index: uint = 1;
    while index < items.length {
        if compare(items.data[index], items.data[low]).IsLess() {
            low = index;
        }
        if compare(items.data[high], items.data[index]).IsLess() {
            high = index;
        }
        index++;
    }
    *smallest = low;
    *largest = high;
    return true;
}

/// The smaller of two values, or `left` when neither is smaller.
///
/// Both are read by value and one is returned by copy. Requires `<` on the type.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/algorithms/min
pub func Min<T>(left: T, right: T) -> T {
    if right < left { return right; }
    return left;
}

/// The larger of two values, or `left` when neither is larger.
///
/// Both are read by value and one is returned by copy. Requires `<` on the type.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/algorithms/max
pub func Max<T>(left: T, right: T) -> T {
    if left < right { return right; }
    return left;
}

/// `value` brought into the range `low` to `high`, inclusive at both ends.
///
/// All three are read by value and one is returned by copy. A `low` above `high` is an empty range with no answer
/// that could be right, so `low` is returned -- the caller passed a range it cannot have meant.
///
/// Requires `<` on the type.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/algorithms/clamp
pub func Clamp<T>(value: T, low: T, high: T) -> T {
    if high < low { return low; }
    if value < low { return low; }
    if high < value { return high; }
    return value;
}

/// `value` brought into the range `low` to `high`, with `compare` deciding.
///
/// All three values are read by value and one is returned by copy; `compare` is called at most three times. A `low`
/// above `high` returns `low`, exactly as `Clamp` does.
///
/// Cannot fail. Runs in constant time and allocates nothing beyond whatever `compare` does.
///
/// https://rux-lang.dev/docs/api/algorithms/clamp-by
pub func ClampBy<T>(value: T, low: T, high: T, compare: func(T, T) -> Ordering) -> T {
    if compare(high, low).IsLess() { return low; }
    if compare(value, low).IsLess() { return low; }
    if compare(high, value).IsLess() { return high; }
    return value;
}
