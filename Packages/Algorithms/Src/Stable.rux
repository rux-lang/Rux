// Stable sorting: putting a sequence in order while leaving equal elements in the order they arrived.
//
// `Sort` is faster and needs no storage at all, and for most sequences the difference between equal elements is not
// observable. It becomes observable the moment a second key is involved: sort a table by one column, then by
// another, and only a stable sort leaves the first ordering intact within each group of the second. That is what
// this is for, and it is the only reason to pay for it.
//
// The price is storage. A merge cannot be done in place without either quadratic movement or an amount of index
// arithmetic that no one should maintain, so this asks the caller for scratch storage as long as the sequence and
// merges into it. Asking rather than allocating is deliberate: this package allocates nothing anywhere, which is
// what lets it be used where allocation is not available, and a caller who has a buffer already should not have a
// second one taken behind their back.
//
// The sort is a bottom-up merge: insertion sort over short runs first, then merges of doubling width, alternating
// between the sequence and the scratch so that nothing is copied merely to move it back. An odd number of merge
// passes ends with the answer in the scratch, and only then is it copied home.
//
// Comparisons are O(n log n) for every input -- there is no bad case here at all, unlike a quicksort -- and the
// movement is the same. What it costs over `Sort` is the storage and about a constant factor.

import Core::{ MutableSlice, Ordering };

/// How much scratch storage a stable sort of `length` elements needs.
///
/// `length` is read by value. The answer is `length` itself: a merge writes its output somewhere other than either
/// of the two runs it reads, and the last merge reads the whole sequence.
///
/// Written as a function rather than left to the reader so that a caller sizing a buffer does not have to know that,
/// and so that it stays right if it ever stops being the whole length.
///
/// Cannot fail. Runs in constant time and allocates nothing.
///
/// https://rux-lang.dev/docs/api/algorithms/required-scratch
func RequiredScratch(length: uint) -> uint {
    return length;
}

/// Puts `items` into non-decreasing order, leaving equal elements in the order they were in.
///
/// `items` is borrowed mutably and rewritten; `scratch` is borrowed mutably and used as working storage, and what it
/// holds afterwards is unspecified. Fewer than two elements are already sorted and need no scratch at all.
///
/// Reports false, changing nothing, when `scratch` is shorter than `RequiredScratch(items.length)`. That is the only
/// way this fails.
///
/// Requires `<` on the element type, as a strict weak ordering.
///
/// Makes O(n log n) comparisons and moves for every input -- there is no bad case -- and allocates nothing.
///
/// https://rux-lang.dev/docs/api/algorithms/stable-sort
func StableSort<T>(items: MutableSlice<T>, scratch: MutableSlice<T>) -> bool {
    if items.length < 2 {
        return true;
    }
    if scratch.length < RequiredScratch(items.length) {
        return false;
    }

    var width = StableRunLength;
    var start: uint = 0;
    while start < items.length {
        var end = start + width;
        if end > items.length {
            end = items.length;
        }
        StableInsertionRun<T>(items.data, start, end);
        start = end;
    }

    var source = items.data;
    var target = scratch.data;
    var moved = false;
    while width < items.length {
        var low: uint = 0;
        while low < items.length {
            var middle = low + width;
            if middle > items.length {
                middle = items.length;
            }
            var high = middle + width;
            if high > items.length {
                high = items.length;
            }
            StableMerge<T>(source, target, low, middle, high);
            low = high;
        }
        let held = source;
        source = target;
        target = held;
        moved = !moved;
        width = width * 2;
    }

    if moved {
        var index: uint = 0;
        while index < items.length {
            items.data[index] = source[index];
            index++;
        }
    }
    return true;
}

/// Puts `items` into the order `compare` describes, leaving equivalent elements in the order they were in.
///
/// `items` is borrowed mutably and rewritten; `scratch` is borrowed mutably and used as working storage, and what it
/// holds afterwards is unspecified. `compare` is called O(n log n) times and must be a strict weak ordering.
///
/// Reports false, changing nothing, when `scratch` is shorter than `RequiredScratch(items.length)`.
///
/// Makes O(n log n) comparisons and moves for every input, and allocates nothing.
///
/// https://rux-lang.dev/docs/api/algorithms/stable-sort-by
func StableSortBy<T>(items: MutableSlice<T>, scratch: MutableSlice<T>, compare: func(T, T) -> Ordering) -> bool {
    if items.length < 2 {
        return true;
    }
    if scratch.length < RequiredScratch(items.length) {
        return false;
    }

    var width = StableRunLength;
    var start: uint = 0;
    while start < items.length {
        var end = start + width;
        if end > items.length {
            end = items.length;
        }
        StableInsertionRunBy<T>(items.data, start, end, compare);
        start = end;
    }

    var source = items.data;
    var target = scratch.data;
    var moved = false;
    while width < items.length {
        var low: uint = 0;
        while low < items.length {
            var middle = low + width;
            if middle > items.length {
                middle = items.length;
            }
            var high = middle + width;
            if high > items.length {
                high = items.length;
            }
            StableMergeBy<T>(source, target, low, middle, high, compare);
            low = high;
        }
        let held = source;
        source = target;
        target = held;
        moved = !moved;
        width = width * 2;
    }

    if moved {
        var index: uint = 0;
        while index < items.length {
            items.data[index] = source[index];
            index++;
        }
    }
    return true;
}

// The run length the first pass sorts by insertion. Long enough that the merge passes are few, short enough that
// insertion sort's quadratic behaviour never costs more than the merge it replaces.
const StableRunLength: uint = 16;

// Insertion sort over [low, high), which is stable: an element only moves past one that is strictly greater.
func StableInsertionRun<T>(data: *var T, low: uint, high: uint) {
    var index = low + 1;
    while index < high {
        let key = data[index];
        var position = index;
        while position > low {
            if !(key < data[position - 1]) {
                break;
            }
            data[position] = data[position - 1];
            position = position - 1;
        }
        data[position] = key;
        index++;
    }
}

// The same, with the comparison supplied.
func StableInsertionRunBy<T>(data: *var T, low: uint, high: uint, compare: func(T, T) -> Ordering) {
    var index = low + 1;
    while index < high {
        let key = data[index];
        var position = index;
        while position > low {
            if !compare(key, data[position - 1]).IsLess() {
                break;
            }
            data[position] = data[position - 1];
            position = position - 1;
        }
        data[position] = key;
        index++;
    }
}

// Merges the sorted runs [low, middle) and [middle, high) of `source` into `target` at the same positions. Ties take
// from the left run, which is what makes the whole sort stable: the left run holds whatever arrived earlier.
func StableMerge<T>(source: *T, target: *var T, low: uint, middle: uint, high: uint) {
    var left = low;
    var right = middle;
    var out = low;
    while left < middle && right < high {
        if source[right] < source[left] {
            target[out] = source[right];
            right = right + 1;
        }
        else {
            target[out] = source[left];
            left = left + 1;
        }
        out = out + 1;
    }
    while left < middle {
        target[out] = source[left];
        left = left + 1;
        out = out + 1;
    }
    while right < high {
        target[out] = source[right];
        right = right + 1;
        out = out + 1;
    }
}

// The same, with the comparison supplied.
func StableMergeBy<T>(source: *T, target: *var T, low: uint, middle: uint, high: uint,
                      compare: func(T, T) -> Ordering) {
    var left = low;
    var right = middle;
    var out = low;
    while left < middle && right < high {
        if compare(source[right], source[left]).IsLess() {
            target[out] = source[right];
            right = right + 1;
        }
        else {
            target[out] = source[left];
            left = left + 1;
        }
        out = out + 1;
    }
    while left < middle {
        target[out] = source[left];
        left = left + 1;
        out = out + 1;
    }
    while right < high {
        target[out] = source[right];
        right = right + 1;
        out = out + 1;
    }
}
