# Pinned CI toolchain revision and asset checksums.
#
# This is the only place versions and checksums are recorded. Workflows read it
# through `env`, the setup scripts dot-source it, and every cache key hashes it,
# so bumping TOOLCHAIN_REVISION invalidates exactly the caches that must change.
#
# Format is deliberately flat KEY=VALUE with no quoting or expansion: POSIX sh
# dot-sources it directly and PowerShell parses it with one regex, so no JSON
# parser and no `jq` is required on any runner.
#
# Assets live in rux-lang/Toolchain, published by its `publish` workflow.
# Names are derived by convention, so there is no per-target URL to keep in sync:
#
#   <base>/toolchain-<rev>/rux-toolchain-<target>-<rev>.tar.zst   (.zip on Windows)
#   <base>/toolchain-<rev>/rux-freebsd-<role>-<arch>-<rev>.qcow2.zst.<part>
#
# Replace every TBD below with the SHA-256 the toolchains release publishes.
# The setup scripts refuse to install an asset whose checksum is still TBD.

TOOLCHAIN_REVISION=TBD
TOOLCHAIN_BASE_URL=https://github.com/rux-lang/Toolchain/releases/download

LLVM_VERSION=23.1.0
CMAKE_VERSION=4.4.3
NINJA_VERSION=1.13.2
FREEBSD_VERSION=15.1

CCACHE_MAXSIZE=400M
TEST_JOBS_MAX=4

# Host toolchain bundles: clang/clang++/clang-format/clang-tidy 23, cmake, ninja, ccache.
# FreeBSD has no hosted runner, so its toolchain ships inside the guest image
# below rather than as a host bundle. macOS x86-64 has no bundle either: it is
# cross-built on the AArch64 runner with that runner's bundle, because LLVM
# publishes no macOS 23.1.0 archive and Homebrew has no Intel bottle for macOS 26.
SHA256_TOOLCHAIN_LINUX_X86_64=TBD
SHA256_TOOLCHAIN_LINUX_AARCH64=TBD
SHA256_TOOLCHAIN_MACOS_AARCH64=TBD
SHA256_TOOLCHAIN_WINDOWS_X86_64=TBD
SHA256_TOOLCHAIN_WINDOWS_AARCH64=TBD

# Prepared FreeBSD guest images. `build` carries the toolchain, `runtime` only the
# shared-library closure of rux, and `minimal` deliberately carries no toolchain at
# all so the transferred-artifact acceptance proves something.
SHA256_IMAGE_BUILD_X86_64=TBD
SHA256_IMAGE_BUILD_AARCH64=TBD
SHA256_IMAGE_RUNTIME_X86_64=TBD
SHA256_IMAGE_RUNTIME_AARCH64=TBD
SHA256_IMAGE_MINIMAL_AARCH64=TBD

# FreeBSD AArch64 base sysroot, used only by the cross-build fallback when the
# AArch64 runner exposes no /dev/kvm. Empty disables that path.
SHA256_SYSROOT_FREEBSD_AARCH64=TBD
