# Pinned CI toolchain inputs.
#
# Flat KEY=VALUE: POSIX sh dot-sources it, PowerShell parses it with one regex,
# workflows load it into GITHUB_ENV with one grep, and every toolchain and
# compilation cache key hashes it, so changing a value here invalidates exactly
# the caches that must change. Both setup scripts and every packer refuse a
# manifest containing anything but comments and plain assignments before
# reading it, because it is sourced.
#
# Every checksum comes from the publisher: the GitHub release API's asset
# digest for LLVM and ccache, and the MANIFEST FreeBSD publishes beside its
# distribution sets. Never compute one from a file you downloaded without
# checking, or the pin proves nothing. The packers refuse a mismatch, and no
# value may be TBD: an unpublished input fails the pack rather than fetching
# unverified bytes.
#
# Asset names vary between releases. Verify each against the release page on a
# version bump rather than assuming the previous pattern held.

# Bump to repack every toolchain prefix without changing a pin.
TOOLCHAIN_CACHE_EPOCH=1

CCACHE_MAXSIZE=400M

LLVM_VERSION=23.1.2
CCACHE_VERSION=4.14
FREEBSD_VERSION=15.1

# Linux and Windows: the official LLVM release archives, trimmed by the packers
# to the tools Rux uses. The zstd variants unpack several times faster than xz.
LLVM_BASE_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2
LLVM_ASSET_LINUX_X86_64=LLVM-23.1.2-Linux-X64.tar.zst
LLVM_ASSET_LINUX_AARCH64=LLVM-23.1.2-Linux-ARM64.tar.zst
LLVM_ASSET_WINDOWS_X86_64=clang+llvm-23.1.2-x86_64-pc-windows-msvc.tar.zst
LLVM_ASSET_WINDOWS_AARCH64=clang+llvm-23.1.2-aarch64-pc-windows-msvc.tar.zst
SHA256_LLVM_LINUX_X86_64=6382de1c1a210ce5a5cc49d18bc8444d137742e7cbf9b19f4ae602bb1ab52534
SHA256_LLVM_LINUX_AARCH64=143308c82f8e21707be7fdc135d5e0ddd9a46a377ca9f38befc716fd842cb59b
SHA256_LLVM_WINDOWS_X86_64=ceaee048142fece144752c6f6431cb0905a7a6160f78ab8cf5cf0b6216f99418
SHA256_LLVM_WINDOWS_AARCH64=5a1b014065e0828786d503de408bff6c0ee57d4e7ad70086e57fa729e14bb76c

# macOS: LLVM publishes no macOS archive for this release, so the Homebrew
# formula is pinned by version and the packer refuses anything else. When the
# formula moves to the next major, point BREW_LLVM_FORMULA at llvm@23. The
# x86-64 compiler is cross-built from this prefix on the AArch64 runner and
# tested under Rosetta, so there is no macOS x86-64 toolchain.
BREW_LLVM_FORMULA=llvm
BREW_LLVM_VERSION=23.1.2

# ccache is pinned like everything else rather than taken from the runner. The
# Linux builds are the fully static musl ones, so a prefix carries no glibc
# dependency of its own; macOS ships one universal binary.
CCACHE_BASE_URL=https://github.com/ccache/ccache/releases/download/v4.14
CCACHE_ASSET_LINUX_X86_64=ccache-4.14-linux-x86_64-musl-static.tar.xz
CCACHE_ASSET_LINUX_AARCH64=ccache-4.14-linux-aarch64-musl-static.tar.xz
CCACHE_ASSET_MACOS=ccache-4.14-darwin.tar.gz
CCACHE_ASSET_WINDOWS_X86_64=ccache-4.14-windows-x86_64.zip
CCACHE_ASSET_WINDOWS_AARCH64=ccache-4.14-windows-aarch64.zip
SHA256_CCACHE_LINUX_X86_64=888eaf9697919d6eba77be797e9d9c9e40e734d11d67d25a79b075c3f79f6c77
SHA256_CCACHE_LINUX_AARCH64=40623f11012a97d60c7d90058d7e3c8c70a3802af53a34067b89e6345c89db69
SHA256_CCACHE_MACOS=353a81ea8680d93387102cfde288ebed381a54272cfdc18224f241add6332b39
SHA256_CCACHE_WINDOWS_X86_64=2568347a697e103ca1b073981c704ad76fb2507d066c38dba038dd73399d968f
SHA256_CCACHE_WINDOWS_AARCH64=baa07085f68f75ea033d6f8d8fe6b53b7f353050bd191e299ff27e131cc3d787

# FreeBSD guests install llvm23, cmake, ninja, ccache4 and git from pkg's
# latest branch, the only one that carries llvm23. The AArch64 base system is
# the sysroot the x86-64 guest cross-compiles the AArch64 compiler against.
FREEBSD_PKG_LLVM=llvm23
FREEBSD_BASE_URL=https://download.freebsd.org/releases/arm64/aarch64/15.1-RELEASE
FREEBSD_BASE_ASSET=base.txz
SHA256_FREEBSD_BASE_AARCH64=5b7a46a0abfbe23a1d4454b5600e2efcfce16b705bc7e9c851c37470c035ef98
